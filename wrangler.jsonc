{
  "name": "property-billing",
  "compatibility_date": "2026-09-10",
  // Required for node-postgres (the "pg" package, spec Section 3.2) to run at
  // all in the Workers runtime -- without this it fails on node:net/node:tls.
  "compatibility_flags": ["nodejs_compat"],

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "<production-hyperdrive-id>",
      // Local dev only: wrangler dev/preview needs this to boot without a live
      // Cloudflare account. Matches .env.example DATABASE_URL. Not used in production.
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:54322/postgres",
    },
  ],

  "triggers": {
    "crons": ["15 2 * * *"],
  },
}
