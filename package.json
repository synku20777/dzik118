{
  "name": "property-billing",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "postinstall": "wrangler types",
    "cf-typegen": "wrangler types",
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/postbuild-wire-scheduled.mjs",
    "preview": "astro preview",
    "astro:check": "astro check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "deploy": "npm run build && npm run db:migrate:production && wrangler deploy",
    "deploy:check-secrets": "node scripts/check-worker-secrets.mjs",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:production": "node scripts/migrate-production.mjs",
    "db:seed": "vite-node scripts/seed.ts",
    "db:migrate:fresh": "vite-node scripts/db-migrate-fresh.ts",
    "demo:auth": "vite-node scripts/setup-demo-auth.ts",
    "demo:reset": "vite-node scripts/demo-reset.ts",
    "storage:setup": "vite-node scripts/setup-storage.ts",
    "backfill:dwelling-cases": "vite-node scripts/backfill-dwelling-cases.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/react": "^7.1.9",
    "@cloudflare/puppeteer": "^2.0.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "papaparse": "^5.7.1",
    "pg": "^8.23.1",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/sortablejs": "^1.15.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.2",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.74.0",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.2"
    }
  }
}
