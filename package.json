{
  "name": "property-billing",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "wrangler types",
    "cf-typegen": "wrangler types",
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/postbuild-wire-scheduled.mjs",
    "preview": "astro preview",
    "astro:check": "astro check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "deploy": "npm run build && npm run db:migrate:production && wrangler deploy",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:production": "node scripts/migrate-production.mjs",
    "db:seed": "vite-node scripts/seed.ts",
    "db:migrate:fresh": "vite-node scripts/db-migrate-fresh.ts",
    "demo:auth": "vite-node scripts/setup-demo-auth.ts",
    "demo:reset": "vite-node scripts/demo-reset.ts",
    "storage:setup": "vite-node scripts/setup-storage.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "@cloudflare/puppeteer": "^1.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^7.3.2",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.2",
    "papaparse": "^5.7.0",
    "pg": "^8.23.0",
    "qrcode-generator": "2.0.4",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.13.0",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/sortablejs": "^1.15.9",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.20.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^14.0.0",
    "prettier": "^3.5.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5",
    "wrangler": "^4.125.0"
  }
}
