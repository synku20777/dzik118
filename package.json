{
  "name": "property-billing",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "wrangler types",
    "cf-typegen": "wrangler types",
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/postbuild-wire-scheduled.mjs",
    "preview": "astro preview",
    "astro:check": "astro check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "deploy": "npm run build && npm run db:migrate:production && wrangler deploy",
    "deploy:check-secrets": "node scripts/check-worker-secrets.mjs",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:production": "node scripts/migrate-production.mjs",
    "db:seed": "vite-node scripts/seed.ts",
    "db:migrate:fresh": "vite-node scripts/db-migrate-fresh.ts",
    "demo:auth": "vite-node scripts/setup-demo-auth.ts",
    "demo:reset": "vite-node scripts/demo-reset.ts",
    "storage:setup": "vite-node scripts/setup-storage.ts",
    "backfill:dwelling-cases": "vite-node scripts/backfill-dwelling-cases.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@cloudflare/puppeteer": "^1.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.3",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "qrcode-generator": "2.0.4",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/sortablejs": "^1.15.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0"
  }
}
