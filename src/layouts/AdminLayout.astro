---
import "../styles/global.css";
import AppNavigation from "../components/ui/AppNavigation.astro";
import OrganizationSwitcher from "../components/ui/OrganizationSwitcher.astro";
import { listOrganizations } from "../domain/organizations/organizations";
import BrandMark from "../components/ui/BrandMark.astro";
import LanguageSwitch from "../components/ui/LanguageSwitch.astro";
import ThemeToggle from "../components/ui/ThemeToggle.astro";
import Icon from "../components/ui/Icon.astro";
import MutationStatus from "../components/ui/MutationStatus.astro";
import DevFontPreview from "../components/ui/DevFontPreview.astro";
import { ClientRouter } from "astro:transitions";
import { translate, uiLocale } from "../lib/ui/i18n";
import { countUnreadConversationsForOrganization } from "../domain/messaging/conversations";
import { withRequestDb } from "../lib/db-request";
interface Props {
  title?: string;
  organizationId?: string;
  organizationName?: string;
  // A page that just archived or restored the organization passes the fresh
  // state. Astro.locals.auth was loaded before the action ran.
  archived?: boolean;
}
const {
  title = "Admin - Namkopa",
  organizationId,
  organizationName,
  archived = organizationId
    ? (Astro.locals.auth?.archivedOrganizationIds?.includes(organizationId) ??
      false)
    : false,
} = Astro.props;
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
const previewFontUrl = import.meta.env.DEV
  ? "/src/fonts/MedeoSansVariable.woff2"
  : undefined;
const residentAccess = (Astro.locals.auth?.dwellingIds.length ?? 0) > 0;
const { unreadMessages, switcherOrganizations } = organizationId
  ? await withRequestDb(async (db) => {
      const [unreadMessages, switcherOrganizations] = await Promise.all([
        countUnreadConversationsForOrganization(db, organizationId),
        listOrganizations(db, Astro.locals.auth?.organizationIds ?? []),
      ]);
      return { unreadMessages, switcherOrganizations };
    })
  : { unreadMessages: 0, switcherOrganizations: [] };
---

<!doctype html>
<html lang={locale} transition:name="root" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <ClientRouter fallback="swap" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem("color-scheme");
          if (stored === "dark" || stored === "light") {
            document.documentElement.setAttribute("data-theme", stored);
            const meta = document.querySelector('meta[name="color-scheme"]');
            if (meta) meta.content = stored;
          }
        } catch (e) {
          void e;
        }
      })();
    </script>
    <title>{title}</title>
  </head>
  <body data-working-label={t("Working…")}>
    <a class="skip-link" href="#main-content">
      {t("Skip to content")}
    </a>
    <aside class="admin-sidebar">
      <a class="brand" href="/admin/organizations">
        <BrandMark />
        {t("Namkopa")}
      </a>
      <OrganizationSwitcher
        organizationId={organizationId}
        organizationName={organizationName}
        organizations={switcherOrganizations}
        residentAccess={residentAccess}
      />
      {organizationId && (
        <AppNavigation
          organizationId={organizationId}
          unreadMessages={unreadMessages}
        />
      )}
      <div class="sidebar-account">
        <p class="mb-2 truncate text-muted">{Astro.locals.auth?.email}</p>
        <div class="flex flex-col items-start gap-2">
          <form method="POST" action="/logout">
            <button type="submit">{t("Sign out")}</button>
          </form>
          <div class="flex items-center gap-2">
            <ThemeToggle />
            <LanguageSwitch />
          </div>
        </div>
      </div>
    </aside>
    <header class="admin-mobile">
      <span class="brand">
        <BrandMark />
        {t("Namkopa")}
      </span>
      <button type="button" class="btn-secondary btn-sm" data-open-mobile-nav>
        {t("Menu")} ☰
      </button>
    </header>
    <dialog
      id="mobile-nav-drawer"
      class="context-drawer mobile-nav-drawer"
      aria-labelledby="mobile-nav-drawer-title"
    >
      <header class="context-drawer-header">
        <span class="brand" id="mobile-nav-drawer-title">
          <BrandMark />
          {t("Namkopa")}
        </span>
        <button
          type="button"
          class="context-drawer-close"
          data-close-mobile-nav
          aria-label={t("Close menu")}
        >
          <Icon name="x" size="sm" />
        </button>
      </header>
      <div class="context-drawer-body">
        <OrganizationSwitcher
          organizationId={organizationId}
          organizationName={organizationName}
          organizations={switcherOrganizations}
          residentAccess={residentAccess}
        />
        {organizationId && (
          <AppNavigation
            organizationId={organizationId}
            unreadMessages={unreadMessages}
          />
        )}
        <div class="mt-4 flex flex-wrap items-center gap-5 border-t border-border pt-4 text-sm">
          <form method="POST" action="/logout">
            <button type="submit">{t("Sign out")}</button>
          </form>
          <div class="ml-auto flex items-center gap-2">
            <ThemeToggle />
            <LanguageSwitch />
          </div>
        </div>
      </div>
    </dialog>
    <main id="main-content" tabindex="-1" class="admin-content app-content">
      {archived && (
        <p class="notice notice-danger mb-4" role="status">
          {t(
            "This organization is archived. You can read it but not change it. Residents cannot sign in. Restore it in Settings > Organization."
          )}
        </p>
      )}
      <slot />
    </main>
    <MutationStatus />
    {previewFontUrl && (
      <DevFontPreview
        fontUrl={previewFontUrl}
        italicFontUrl="/src/fonts/MedeoSansVariable-Italic.woff2"
      />
    )}
    <script>
      import "../lib/ui/forms";
      import { onPageLoad } from "../lib/ui/page-lifecycle";
      import { labelStackTables } from "../lib/ui/stack-tables";

      onPageLoad(() => {
        labelStackTables();
        const mobileNavDialog =
          document.querySelector<HTMLDialogElement>("#mobile-nav-drawer");
        if (!mobileNavDialog) return;
        document
          .querySelector("[data-open-mobile-nav]")
          ?.addEventListener("click", () => mobileNavDialog.showModal());
        document
          .querySelector("[data-close-mobile-nav]")
          ?.addEventListener("click", () => mobileNavDialog.close());
        mobileNavDialog.addEventListener("click", (event) => {
          if (event.target === mobileNavDialog) mobileNavDialog.close();
        });
        // Navigating to a link inside the drawer should close it -- without
        // this, a slow page load leaves the previous page's drawer open
        // and dimmed behind whatever loads next.
        mobileNavDialog
          .querySelectorAll("a")
          .forEach((link) =>
            link.addEventListener("click", () => mobileNavDialog.close())
          );
      });
    </script>
  </body>
</html>
