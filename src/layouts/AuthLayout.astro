---
import "../styles/global.css";
import ThemeToggle from "../components/ui/ThemeToggle.astro";
import LanguageSwitch from "../components/ui/LanguageSwitch.astro";
import Tooltips from "../components/ui/Tooltips.astro";
import { translate, uiLocale } from "../lib/ui/i18n";

interface Props {
  title?: string;
}

const { title = "Sign In - Namkopa" } = Astro.props;
const locale = uiLocale(Astro.cookies, Astro.url);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <!-- --color-canvas per theme; theme.ts keeps these in step with a stored theme. -->
    <meta
      name="theme-color"
      content="#eee8de"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0e1517"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script>
      import "../lib/ui/field-errors";
      import { onPageLoad } from "../lib/ui/page-lifecycle";
      // A page that reloads with an error (wrong password, expired link, rate
      // limit) starts keyboard and screen-reader users at that error.
      onPageLoad(() => {
        const error = document.querySelector<HTMLElement>(
          'main .notice-danger[role="alert"]'
        );
        if (!error) return;
        error.tabIndex = -1;
        error.focus();
      });
    </script>
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem("color-scheme");
          if (stored === "dark" || stored === "light") {
            document.documentElement.setAttribute("data-theme", stored);
            const meta = document.querySelector('meta[name="color-scheme"]');
            if (meta) meta.content = stored;
            document
              .querySelectorAll('meta[name="theme-color"]')
              .forEach(function (m) {
                m.content = stored === "dark" ? "#0e1517" : "#eee8de";
              });
          }
        } catch (e) {
          void e;
        }
      })();
    </script>
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-canvas text-foreground antialiased relative">
    <a class="skip-link" href="#main-content">
      {translate(locale, "Skip to content")}
    </a>
    <div class="auth-architecture" aria-hidden="true">
      <svg viewBox="0 0 260 640" fill="none" focusable="false">
        <g stroke="currentColor" stroke-width="1">
          <path d="M30 610 V150 A100 100 0 0 1 230 150 V610 M46 610 V150 A84 84 0 0 1 214 150 V610"></path>
          <path d="M82 610 V156 A48 48 0 0 1 178 156 V610 M130 108 V610 M46 254 H214 M46 262 H214 M46 446 H214 M46 454 H214 M14 610 H246 M14 618 H246"></path>
        </g>
        <path
          class="auth-keystone"
          d="M123 49 L130 37 L137 49 V65 H123 Z"
          fill="currentColor"
        ></path>
      </svg>
    </div>
    <header class="absolute top-4 right-4 z-(--z-sticky) flex items-center gap-2">
      <LanguageSwitch />
      <ThemeToggle />
    </header>
    <main
      id="main-content"
      tabindex="-1"
      class="relative flex min-h-screen items-center justify-center px-4 py-20"
    >
      <slot />
    </main>
    <Tooltips />
  </body>
</html>

<style>
  .auth-architecture {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    color: var(--color-border);
  }
  .auth-architecture svg {
    position: absolute;
    width: clamp(12rem, 22vw, 22rem);
    height: auto;
    top: 50%;
    right: calc(50% + 18rem);
    transform: translateY(-50%);
    opacity: 0.65;
  }
  .auth-keystone {
    color: var(--color-secondary);
  }
  @media (width < 48rem) {
    .auth-architecture {
      display: none;
    }
  }
</style>
