---
import "../styles/global.css";
import "../styles/resident.css";
import LanguageSwitch from "../components/ui/LanguageSwitch.astro";
import ThemeToggle from "../components/ui/ThemeToggle.astro";
import BrandMark from "../components/ui/BrandMark.astro";
import Icon from "../components/ui/Icon.astro";
import Tooltips from "../components/ui/Tooltips.astro";
import { translate, uiLocale } from "../lib/ui/i18n";
import type { IconName } from "../lib/ui/icons";
interface Props {
  title?: string;
}
const { title = "Resident Portal - Namkopa" } = Astro.props;
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
const id = Astro.params.dwellingId ?? Astro.url.searchParams.get("dwellingId");
const auth = Astro.locals.auth;
const dwellingId = id && auth?.dwellingIds.includes(id) ? id : null;
const base = "/portal/dwellings/" + dwellingId;
const path = Astro.url.pathname;
const tabs: [string, string, IconName][] = [
  [base, "Home", "home"],
  [base + "/invoices", "Invoices", "receipt-euro"],
  [base + "/messages", "Contact administrator", "message"],
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem("color-scheme");
          if (stored === "dark" || stored === "light") {
            document.documentElement.setAttribute("data-theme", stored);
            const meta = document.querySelector('meta[name="color-scheme"]');
            if (meta) meta.content = stored;
          }
        } catch (e) {
          void e;
        }
      })();
    </script>
    <title>{title}</title>
  </head>
  <body class="resident-portal" data-working-label={t("Working…")}>
    <a class="skip-link" href="#main-content">
      {t("Skip to content")}
    </a>
    <header class="resident-header">
      <div>
        <a class="brand" href="/portal">
          <BrandMark />
          {t("Namkopa")}
        </a>
        <div class="resident-prefs">
          <ThemeToggle />
          <LanguageSwitch fullNames />
        </div>
        <div class="resident-account">
          {(auth?.organizationIds.length ?? 0) > 0 && (
            <a href="/admin" class="resident-header-link">
              {t("Switch to admin view")}
            </a>
          )}
          <a
            href="/portal/profile"
            class="resident-header-link"
            aria-current={path === "/portal/profile" ? "page" : undefined}
          >
            <Icon name="user" />
            {t("Profile")}
          </a>
          <form method="POST" action="/logout">
            <button type="submit" class="resident-header-link">
              <Icon name="logout" />
              {t("Sign out")}
            </button>
          </form>
        </div>
      </div>
    </header>
    <main id="main-content" tabindex="-1" class="resident-content app-content">
      {dwellingId && (
        <nav class="resident-nav" aria-label={t("Navigation")}>
          {tabs.map(([href, label, icon]) => (
            <a
              href={href}
              aria-current={
                path === href ||
                (label === "Invoices" && path.startsWith("/portal/invoices/"))
                  ? "page"
                  : undefined
              }
            >
              <Icon name={icon} />
              {t(label)}
            </a>
          ))}
        </nav>
      )}
      <slot />
      {dwellingId && (
        <footer class="resident-help">
          <a href={base + "/messages"}>{t("Contact administrator")}</a>
          <a href={base + "/payments"}>{t("Payment history")}</a>
        </footer>
      )}
    </main>
    <Tooltips />
    <script>
      import "../lib/ui/forms";
      import { onPageLoad } from "../lib/ui/page-lifecycle";
      import "../lib/ui/field-errors";
      import { labelStackTables } from "../lib/ui/stack-tables";

      onPageLoad(() => {
        labelStackTables();
      });
    </script>
  </body>
</html>
