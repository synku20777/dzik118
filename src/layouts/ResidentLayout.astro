---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Resident Portal - Property Billing" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-neutral-50 text-neutral-900 antialiased">
    <!-- TODO: Phase I (Resident UX) - Resident portal mobile-first layout shell -->
    <main>
      <slot />
    </main>
  </body>
</html>
