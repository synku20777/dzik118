---
import PageHeader from "./PageHeader.astro";
import SetupSteps, { type Props as StepProps } from "./SetupSteps.astro";

interface Props extends StepProps {
  title: string;
  description?: string;
  headingLevel?: "h1" | "h2" | "h3";
}
const { title, description, headingLevel, ...steps } = Astro.props;
---

<div class="setup-page">
  <PageHeader
    title={title}
    description={description}
    headingLevel={headingLevel}
  />
  <div class="setup-workspace">
    <SetupSteps {...steps} />
    <div class="setup-content space-y-6">
      <slot />
    </div>
  </div>
</div>

<script>
  import { onPageLoad } from "../../lib/ui/page-lifecycle";
  import { linkFieldErrors } from "../../lib/ui/field-errors";
  // Start the user on the first field that has an error.
  onPageLoad(() => {
    // Called without a root, linkFieldErrors searches the whole document.
    linkFieldErrors()[0]?.focus();
  });
</script>

<style is:global>
  .setup-page {
    max-width: var(--width-wizard);
  }
  .setup-page .page-header {
    margin-bottom: 2rem;
  }
  .setup-page .page-actions:empty {
    display: none;
  }
  .setup-page .page-description {
    max-width: 65ch;
  }
  .setup-workspace {
    display: grid;
    grid-template-columns: 13.5rem minmax(0, 1fr);
    align-items: start;
    gap: 2rem;
  }
  .setup-content {
    min-width: 0;
    max-width: 52rem;
  }
  /* A legend heads its section; it never sits on a border. */
  .setup-page legend:not(.sr-only) {
    float: left;
    width: 100%;
    padding: 0;
  }
  .setup-page legend:not(.sr-only) + * {
    clear: both;
  }
  /* Boxed fields already get the shared required dot. */
  .setup-page
    label:not(.field-box > label):is(
      :has(+ :required),
      :has(+ p + :required)
    )::after {
    content: " *";
    color: var(--color-required);
  }
  .setup-page .setup-required-note {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .setup-page input[type="file"]::file-selector-button {
    margin-inline-end: var(--space-3);
    min-height: var(--control-size-md);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    corner-shape: squircle;
    background: var(--color-surface);
    color: var(--color-foreground);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  @media (hover: hover) {
    .setup-page input[type="file"]:not(:disabled)::file-selector-button:hover {
      box-shadow: var(--hover-ring)
        color-mix(in srgb, var(--color-border) 70%, transparent);
    }
  }
  .setup-page input[type="file"]:not(:disabled)::file-selector-button:active {
    background: var(--color-nav-active-bg);
    color: var(--color-primary);
  }
  .setup-page .setup-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1.25rem;
  }
  .setup-page .setup-actions > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .setup-page .setup-preset {
    min-width: 0;
  }
  /* Secondary tasks fold away (.disclosure) so the main one comes first. */
  .setup-fold-body {
    display: grid;
    gap: 1rem;
  }
  .setup-page .setup-preset:has(input[type="checkbox"]:checked) {
    background: var(--color-nav-active-bg);
  }
  .setup-page .setup-preset-fields:disabled {
    opacity: 0.45;
  }
  @media (prefers-reduced-motion: no-preference) {
    .setup-page .setup-preset {
      transition: background-color var(--duration-fast) ease;
    }
    .setup-page .setup-preset-fields {
      transition: opacity var(--duration-normal) var(--ease-standard);
    }
    .setup-content :is([role="status"], [role="alert"]) {
      animation: panel-in var(--duration-panel) var(--ease-standard) both;
    }
  }
  .setup-page .setup-preset-fields {
    border: 0;
    padding: 0;
    margin: 0;
  }
  @media (width < 70rem) {
    .setup-workspace {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
  }
  /* Phones: a reading is one compact row, not a five-line card. */
  @media (width < 40rem) {
    .setup-readings.stack-table tr {
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) 7rem;
      align-items: center;
      column-gap: 0.75rem;
      padding: 0.625rem 0.875rem;
    }
    .setup-readings.stack-table td {
      display: block !important;
      grid-column: 1;
      padding: 0 !important;
      text-align: left;
      overflow-wrap: anywhere;
    }
    .setup-readings.stack-table td::before {
      display: none !important;
    }
    .setup-readings.stack-table td:first-child {
      font-weight: 600;
    }
    .setup-readings.stack-table td:nth-child(3) {
      color: var(--color-muted);
      font-size: var(--text-sm);
    }
    .setup-readings.stack-table td:nth-child(4) {
      grid-column: 2;
      text-align: right;
      color: var(--color-muted);
      font-size: var(--text-sm);
    }
    .setup-readings.stack-table td:nth-child(5) {
      grid-column: 2;
      grid-row: 1 / 3;
    }
    .setup-readings.stack-table td:nth-child(5) input[type="text"] {
      width: 100%;
    }
    /* The input keeps a visible caption: its column name ("Starting
       reading") from the stacked table's data-label. */
    .setup-readings.stack-table td:nth-child(5)::before {
      display: block !important;
      margin-bottom: var(--space-1);
      text-align: left;
    }
  }
  @media (width < 40rem) {
    .setup-page .panel {
      padding: 1rem;
    }
    .setup-page .setup-actions > div {
      display: contents;
    }
    .setup-page .setup-actions .btn-primary {
      order: 1;
      flex: 1 0 100%;
    }
  }
</style>
