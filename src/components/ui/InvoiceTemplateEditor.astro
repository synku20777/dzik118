---
import { actions } from "astro:actions";
import Icon from "./Icon.astro";
import { translate, type Locale } from "../../lib/ui/i18n";
import type { EditorBootstrap } from "../../lib/ui/invoice-template-editor";

interface Props {
  organizationId: string;
  locale: Locale;
  bootstrap: Omit<EditorBootstrap, "strings">;
  periodOptions: Array<{ id: string; label: string }>;
  previewPeriodId?: string;
  preview?: boolean;
}
const {
  organizationId,
  locale,
  bootstrap,
  periodOptions,
  previewPeriodId,
  preview,
} = Astro.props;
const t = (message: string) => translate(locale, message);
const editorBootstrap = {
  ...bootstrap,
  strings: {
    "Template structure": t("Template structure"),
    "Live preview": t("Live preview"),
    "Line items": t("Line items"),
    "Zoom level": t("Zoom level"),
    "Expand section": t("Expand section"),
    "Collapse section": t("Collapse section"),
    "More options": t("More options"),
    "Invoice details": t("Invoice details"),
    "Sender and recipient": t("Sender and recipient"),
    "Charges table": t("Charges table"),
    "Payment details": t("Payment details"),
    "Default note": t("Default note"),
    Footer: t("Footer"),
    "Custom text": t("Custom text"),
    Show: t("Show"),
    Bold: t("Bold"),
    Spacing: t("Spacing"),
    Align: t("Align"),
    "Move up": t("Move up"),
    "Move down": t("Move down"),
    Duplicate: t("Duplicate"),
    Delete: t("Delete"),
    "Save changes": t("Save changes"),
    "Saving…": t("Saving…"),
    Undo: t("Undo"),
    Edit: t("Edit"),
    Preview: t("Preview"),
    None: t("None"),
    Small: t("Small"),
    Medium: t("Medium"),
    Large: t("Large"),
    "Extra large": t("Extra large"),
    Left: t("Left"),
    Center: t("Center"),
    Right: t("Right"),
    "Fit to width": t("Fit to width"),
    "Unsaved changes": t("Unsaved changes"),
    "Discard changes": t("Discard changes"),
    "Template saved.": t("Template saved."),
    "Could not save the template. Your changes are still here.": t(
      "Could not save the template. Your changes are still here."
    ),
    "Could not load the sample charges. Try again.": t(
      "Could not load the sample charges. Try again."
    ),
    "Discard unsaved changes? Your edits have not been saved.": t(
      "Discard unsaved changes? Your edits have not been saved."
    ),
    "Without translation: {n}": t("Without translation: {n}"),
    "An empty field uses the Latvian text.": t(
      "An empty field uses the Latvian text."
    ),
    "Latvian is the main invoice language.": t(
      "Latvian is the main invoice language."
    ),
    "Layout reset to the default.": t("Layout reset to the default."),
    "Reset undone.": t("Reset undone."),
    "This invoice layout has reached the maximum of 30 sections.": t(
      "This invoice layout has reached the maximum of 30 sections."
    ),
  },
};
---

<form
  method={preview ? "dialog" : "POST"}
  action={preview ? undefined : actions.invoiceTemplates.update}
  id="template-editor-form"
>
  <input type="hidden" name="organizationId" value={organizationId} />
  <input type="hidden" name="headerText" />
  <input type="hidden" name="footerText" />
  <input type="hidden" name="paymentInstructions" />
  <input type="hidden" name="defaultNote" />
  <input type="hidden" name="config" />

  <div
    id="template-editor"
    class="tpl-editor"
    data-view="edit"
    data-editor-preview={preview ? "" : undefined}
  >
    <script
      is:inline
      type="application/json"
      id="template-editor-bootstrap"
      set:html={JSON.stringify(editorBootstrap).replace(/</g, "\\u003c")}
    />
    <div class="tpl-toolbar">
      <fieldset class="tpl-lang toggle-tabs">
        <legend class="sr-only">{t("Editing language")}</legend>
        {[
          ["lv", "Latviešu"],
          ["en", "English"],
          ["ru", "Русский"],
        ].map(([code, name]) => (
          <label lang={code}>
            <input
              type="radio"
              name="tpl-locale"
              value={code}
              checked={code === "lv"}
            />
            <span>{name}</span>
            <span class="tpl-lang-missing" data-missing-for={code} hidden />
          </label>
        ))}
      </fieldset>
      <p id="tpl-lang-hint" class="tpl-lang-hint" aria-live="polite"></p>
      <div
        class="tpl-view-switch toggle-tabs"
        role="group"
        aria-label={t("Editor view")}
      >
        <button type="button" data-tpl-view="edit" aria-pressed="true">
          {t("Edit")}
        </button>
        <button type="button" data-tpl-view="preview" aria-pressed="false">
          {t("Preview")}
        </button>
      </div>
    </div>

    <div class="tpl-editor-layout">
      <section class="tpl-editor-column tpl-structure-column">
        <h2 class="tpl-column-title">{t("Template structure")}</h2>

        <div class="tpl-editor-toolbar">
          <button type="button" id="tpl-add-text" class="btn-secondary btn-sm">
            <Icon name="plus" size="sm" />
            <span>{t("Add text block")}</span>
          </button>
          <button
            type="button"
            id="tpl-reset-layout"
            class="btn-secondary btn-sm"
          >
            {t("Reset layout")}
          </button>
        </div>
        <p id="tpl-status" class="tpl-status" role="status" hidden></p>

        <ul
          id="tpl-blocks"
          class="tpl-blocks"
          aria-label={t("Invoice sections")}
        ></ul>
      </section>

      <section class="tpl-editor-column tpl-preview-column">
        <div class="tpl-column-header tpl-preview-header">
          <div>
            <h2 class="tpl-column-title">{t("Live preview")}</h2>
            <p class="tpl-column-subtitle">
              {t("Quantities are illustrative (always 1).")}
            </p>
          </div>
          <div class="tpl-preview-controls">
            {periodOptions.length > 0 ? (
              <label class="tpl-period" for="tpl-preview-period">
                <span>{t("Sample charges for")}</span>
                <select id="tpl-preview-period" class="tpl-zoom-select">
                  {periodOptions.map((p) => (
                    <option value={p.id} selected={p.id === previewPeriodId}>
                      {p.label}
                    </option>
                  ))}
                </select>
              </label>
            ) : null}
            <select
              id="tpl-zoom-select"
              class="tpl-zoom-select"
              aria-label={t("Zoom level")}
            >
              <option value="fit" selected>
                {t("Fit to width")}
              </option>
              <option value="1">100%</option>
              <option value="1.25">125%</option>
            </select>
          </div>
        </div>
        {!preview && periodOptions.length === 0 && (
          <p class="tpl-period-note">
            {t("No billing periods yet — showing tariffs effective today.")}
          </p>
        )}
        <p
          id="tpl-period-error"
          class="notice notice-danger"
          role="alert"
          hidden
        ></p>

        <div id="tpl-preview-container" class="tpl-editor-canvas">
          <div id="tpl-preview-zoom-wrap" class="tpl-preview-zoom-wrap">
            <iframe
              id="tpl-preview"
              class="tpl-preview"
              title={t("Invoice preview")}
            ></iframe>
          </div>
        </div>
      </section>
    </div>

    <div id="tpl-savebar" class="tpl-savebar" hidden>
      <p id="tpl-savebar-text" class="tpl-savebar-text" role="status"></p>
      <button type="button" id="tpl-discard" class="btn-secondary">
        {t("Discard changes")}
      </button>
      <button type="submit" id="tpl-save" class="btn-primary">
        {t("Save changes")}
      </button>
    </div>
  </div>
</form>

<script>
  import "../../lib/ui/invoice-template-editor";
</script>

<style is:global>
  /* The editor builds its .tpl- controls in the browser. */
  .tpl-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-bottom: 1rem;
  }
  /* The language picker is toggle tabs; the fieldset drops its own chrome. */
  .tpl-lang {
    min-width: 0;
    margin: 0;
    border: 0;
  }
  .tpl-lang > label {
    gap: 0.375rem;
  }
  .tpl-lang-missing {
    color: var(--color-muted);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .tpl-lang-hint {
    flex: 1 1 14rem;
    min-width: 0;
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .tpl-view-switch {
    display: none;
  }
  .tpl-editor-layout {
    display: grid;
    grid-template-columns: minmax(0, 24rem) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }
  .tpl-column-header {
    margin-bottom: 0.75rem;
  }
  .tpl-column-title {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-foreground);
  }
  .tpl-structure-column .tpl-column-title {
    margin-bottom: 0.75rem;
  }
  .tpl-column-subtitle {
    margin: 0.25rem 0 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .tpl-preview-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem 1rem;
  }
  .tpl-preview-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }
  .tpl-period {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .tpl-period-note {
    margin: 0 0 0.75rem;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .tpl-zoom-select {
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .tpl-editor-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .tpl-editor-toolbar button {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .tpl-status {
    margin: 0 0 0.75rem;
    font-size: var(--text-sm);
  }
  .tpl-blocks {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tpl-block {
    display: flex;
    flex-direction: column;
    border: var(--panel-border);
    border-radius: var(--radius-panel);
    corner-shape: squircle;
    background: var(--color-surface);
  }
  .tpl-block-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 0.75rem;
    /* The hover fill takes the block's own corners. */
    border-radius: inherit;
    corner-shape: squircle;
    cursor: pointer;
    user-select: none;
  }
  .tpl-block-header:has(+ .tpl-block-detail:not([hidden])) {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }
  .tpl-block-header:hover {
    background: var(--color-hover);
  }
  .tpl-drag-handle {
    flex: 0 0 auto;
    cursor: grab;
    color: var(--color-muted);
    padding: 0.125rem 0.25rem;
    user-select: none;
  }
  .tpl-drag-handle:active {
    cursor: grabbing;
  }
  .tpl-block-num {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-muted);
    flex: 0 0 auto;
  }
  .tpl-block-name {
    flex: 1 1 auto;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-foreground);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tpl-block-header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 0 0 auto;
    margin-left: auto;
  }
  .tpl-accordion-btn {
    flex: 0 0 auto;
  }
  .tpl-chevron-icon {
    transition: transform var(--duration-normal) var(--ease-standard);
  }
  .tpl-accordion-btn[aria-expanded="true"] .tpl-chevron-icon {
    transform: rotate(90deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .tpl-chevron-icon {
      transition: none;
    }
  }
  .tpl-block-detail {
    padding: 0 0.75rem 0.75rem;
    border-top: 1px solid var(--color-border);
  }
  .tpl-block-detail[hidden] {
    display: none !important;
  }
  .tpl-field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 0.75rem;
  }
  .tpl-field label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-foreground);
  }
  .tpl-input,
  .tpl-select {
    width: 100%;
    font: inherit;
    font-size: var(--text-sm);
  }
  .tpl-textarea {
    width: 100%;
    font: inherit;
    font-size: var(--text-sm);
    resize: vertical;
  }
  .tpl-sub-label {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-foreground);
    margin: 0.75rem 0 0.25rem;
  }
  .tpl-block-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-border);
  }
  .tpl-rows {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding: 0;
    list-style: none;
  }
  .tpl-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.625rem;
    border: var(--panel-border);
    border-radius: var(--radius-control);
    background: var(--color-surface);
  }
  .tpl-row-title {
    flex: 1 1 auto;
    font-size: var(--text-sm);
    font-weight: 500;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tpl-row-controls {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex: 0 0 auto;
    margin-left: auto;
  }
  .tpl-control {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .tpl-row-overflow {
    position: relative;
    display: inline-flex;
  }
  .tpl-overflow-btn {
    list-style: none;
  }
  .tpl-overflow-btn::-webkit-details-marker,
  .tpl-overflow-btn::marker {
    display: none;
  }
  .tpl-row-overflow[open] > .tpl-overflow-btn {
    background: var(--color-nav-active-bg);
    color: var(--color-primary);
  }
  .tpl-popover {
    position: absolute;
    right: 0;
    top: calc(100% + 4px);
    z-index: var(--z-overlay);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
    corner-shape: squircle;
    box-shadow: var(--elevation-overlay);
    padding: 0.5rem;
    min-width: 7rem;
  }
  .tpl-popover .tpl-field {
    margin-top: 0;
  }
  /* The preview stays in view beside the editor while the section list
     scrolls with the page; only the invoice itself scrolls inside. */
  .tpl-preview-column {
    position: sticky;
    top: var(--space-4);
    display: flex;
    flex-direction: column;
    min-height: 0;
    max-height: calc(100vh - 2 * var(--space-4));
  }
  .tpl-editor-canvas {
    flex: 1 1 auto;
    min-height: 0;
    padding: 1rem;
    overflow: auto;
    background: var(--color-surface-hover);
    border-radius: var(--radius-panel);
    corner-shape: squircle;
  }
  /* The wrapper takes the iframe's scaled size (set by applyZoom() in the
     editor script): a CSS transform never changes layout size, so without it
     the canvas would scroll the unscaled area. */
  .tpl-preview-zoom-wrap {
    position: relative;
    margin-inline: auto;
  }
  /* Always drawn at true A4 width and scaled to fit, so the invoice looks
     the same at every screen width instead of reflowing narrow. */
  .tpl-preview {
    display: block;
    width: 210mm;
    height: 297mm;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-badge);
    transform-origin: top left;
  }

  @media (prefers-reduced-motion: no-preference) {
    .tpl-preview {
      transition: transform var(--duration-fast) var(--ease-standard);
    }
  }

  /* Unsaved changes: pinned to the bottom of the screen so Save is always in

     reach, however far down the section list you are. */

  .tpl-savebar {
    position: sticky;

    bottom: var(--space-4);

    z-index: var(--z-sticky);

    display: flex;

    flex-wrap: wrap;

    align-items: center;

    gap: 0.75rem;

    margin-top: 1rem;

    padding: 0.75rem 1rem;

    border: 1px solid var(--color-border);

    border-radius: var(--radius-panel);

    corner-shape: squircle;

    background: var(--color-surface-raised);

    box-shadow: var(--elevation-overlay);
  }

  .tpl-savebar[hidden] {
    display: none;
  }

  .tpl-savebar-text {
    flex: 1 1 12rem;

    min-width: 0;

    margin: 0;

    font-size: var(--text-sm);

    font-weight: 600;
  }

  .tpl-savebar[data-state="error"] .tpl-savebar-text {
    color: var(--color-destructive);
  }

  @media (width < 48rem) {
    .tpl-editor-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .tpl-view-switch {
      display: inline-flex;
      margin-left: auto;
    }

    .tpl-editor[data-view="edit"] .tpl-preview-column,
    .tpl-editor[data-view="preview"] .tpl-structure-column {
      display: none;
    }

    .tpl-preview-column {
      position: static;

      max-height: none;
    }
  }

  @media (width < 40rem) {
    .tpl-savebar .btn-secondary,
    .tpl-savebar .btn-primary {
      flex: 1 1 8rem;
    }
  }
</style>
