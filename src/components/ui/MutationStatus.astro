---
import { translate, uiLocale } from "../../lib/ui/i18n";

const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
const strings = {
  allSaved: t("All changes saved"),
  oneSaving: t("1 change saving"),
  manySaving: t("{n} changes saving"),
  oneError: t("1 change needs attention"),
  manyErrors: t("{n} changes need attention"),
  waiting: t("Waiting for server…"),
  applying: t("Applying changes…"),
  saved: t("Saved"),
  recent: t("Recent changes"),
  dismiss: t("Dismiss"),
  retry: t("Retry"),
  refresh: t("Refresh"),
  savedNotUpdated: t("Saved, but the view could not be updated"),
  checkAgain: t("Check again"),
  checking: t("Checking save status…"),
  unknown: t("Outcome not confirmed"),
  committedMissing: t(
    "The original change was saved, but the item is no longer present. The page has been refreshed."
  ),
  messages: {
    "Adding meter…": t("Adding meter…"),
    "Meter added": t("Meter added"),
    "Adding resident…": t("Adding resident…"),
    "Resident added": t("Resident added"),
    "Creating dwelling…": t("Creating dwelling…"),
    "Dwelling created": t("Dwelling created"),
  },
};
---

<div id="mutation-status" data-strings={JSON.stringify(strings)}>
  <span
    class="sr-only"
    data-mutation-announcer
    aria-live="polite"
    aria-atomic="true"
  ></span>
  <div
    class="mutation-toasts"
    data-mutation-toasts
    aria-live="polite"
    aria-atomic="false"
  ></div>
  <details class="mutation-activity" hidden>
    <summary class="mutation-summary">
      <span aria-hidden="true" data-mutation-summary-icon>
        ✓
      </span>
      <span data-mutation-summary>{strings.allSaved}</span>
    </summary>
    <section class="mutation-panel" aria-labelledby="mutation-panel-title">
      <h2 id="mutation-panel-title">{strings.recent}</h2>
      <div data-mutation-list></div>
    </section>
  </details>
</div>

<script>
  import { actions } from "astro:actions";
  import { navigate } from "astro:transitions/client";
  import { onPageLoad } from "../../lib/ui/page-lifecycle";
  import {
    completeMutation,
    confirmMutation,
    dismissMutation,
    failReconciliation,
    hydrateMutations,
    markOutcomeUnknown,
    markReconciling,
    markVerifying,
    mutationCounts,
    retryMutation,
    runMutationRecovery,
    subscribeMutations,
    type UiMutation,
  } from "../../lib/ui/mutations";

  interface Strings {
    allSaved: string;
    oneSaving: string;
    manySaving: string;
    oneError: string;
    manyErrors: string;
    waiting: string;
    applying: string;
    saved: string;
    recent: string;
    dismiss: string;
    retry: string;
    refresh: string;
    savedNotUpdated: string;
    checkAgain: string;
    checking: string;
    unknown: string;
    committedMissing: string;
    messages: Record<string, string>;
  }

  function statusText(mutation: UiMutation, strings: Strings): string {
    if (mutation.status === "pending") return strings.waiting;
    if (mutation.status === "verifying") return strings.checking;
    if (mutation.status === "confirmed" || mutation.status === "reconciling") {
      return strings.applying;
    }
    if (mutation.status === "success") return strings.saved;
    if (mutation.status === "unknown") return strings.unknown;
    return mutation.error ?? "";
  }

  function renderItems(
    container: HTMLElement,
    mutations: readonly UiMutation[],
    strings: Strings
  ): void {
    const existing = new Map(
      [...container.querySelectorAll<HTMLElement>("[data-mutation-id]")].map(
        (element) => [element.dataset.mutationId!, element]
      )
    );

    for (const mutation of mutations) {
      const item =
        existing.get(mutation.id) ?? document.createElement("article");
      existing.delete(mutation.id);
      item.className = "mutation-item";
      item.dataset.mutationId = mutation.id;
      item.dataset.status = mutation.status;
      if (!item.isConnected) {
        item.innerHTML =
          '<span class="mutation-item-icon" aria-hidden="true"></span>' +
          '<span class="mutation-item-copy"><strong></strong><small></small></span>' +
          '<span class="mutation-item-actions">' +
          '<button type="button" class="mutation-retry"></button>' +
          '<button type="button" class="mutation-dismiss"></button>' +
          "</span>";
        container.appendChild(item);
      }
      const icon = item.querySelector<HTMLElement>(".mutation-item-icon")!;
      icon.textContent =
        mutation.status === "success"
          ? "✓"
          : mutation.status === "error"
            ? "!"
            : "◌";
      item.querySelector("strong")!.textContent = mutation.label;
      item.querySelector("small")!.textContent = statusText(mutation, strings);
      const dismiss =
        item.querySelector<HTMLButtonElement>(".mutation-dismiss")!;
      const retry = item.querySelector<HTMLButtonElement>(".mutation-retry")!;
      retry.textContent = mutation.refresh
        ? strings.refresh
        : mutation.status === "unknown"
          ? strings.checkAgain
          : strings.retry;
      retry.hidden =
        !mutation.refresh &&
        (mutation.status !== "error" || !mutation.retry) &&
        (mutation.status !== "unknown" || !mutation.checkAgain);
      retry.onclick = () =>
        mutation.refresh
          ? location.reload()
          : mutation.status === "unknown"
            ? mutation.checkAgain?.()
            : retryMutation(mutation.id);
      dismiss.textContent = strings.dismiss;
      dismiss.hidden = mutation.status !== "error";
      dismiss.onclick = () => dismissMutation(mutation.id);
      item.setAttribute(
        "role",
        mutation.status === "error" || mutation.status === "unknown"
          ? "alert"
          : "status"
      );
    }
    for (const item of existing.values()) item.remove();
  }

  onPageLoad(() => {
    const root = document.querySelector<HTMLElement>("#mutation-status");
    if (!root) return;
    const strings: Strings = JSON.parse(root.dataset.strings ?? "{}");
    const translateMessage = (key: string) => strings.messages[key] ?? key;
    const hydrated = hydrateMutations(translateMessage);

    function recover(mutation: UiMutation) {
      if (!mutation.recovery) return;
      const lookup = async () => {
        const { data, error } = await actions.mutations.lookup({
          organizationId: mutation.recovery!.organizationId,
          clientMutationId: mutation.recovery!.clientMutationId,
        });
        if (error || !data) throw error ?? new Error("Lookup failed");
        return data;
      };
      runMutationRecovery(mutation.id, lookup, {
        committed: async (entity) => {
          confirmMutation(mutation.id);
          markReconciling(mutation.id);
          if (
            `${location.pathname}${location.search}` ===
            mutation.recovery!.originPath
          ) {
            await navigate(mutation.recovery!.originPath).catch(() => {});
          }
          completeMutation(
            mutation.id,
            entity === null
              ? strings.committedMissing
              : translateMessage(mutation.successMessageKey ?? "Saved")
          );
        },
        viewFailed: () =>
          failReconciliation(mutation.id, strings.savedNotUpdated),
        unknown: (checkAgain) => {
          markOutcomeUnknown(mutation.id, () => {
            markVerifying(mutation.id);
            checkAgain();
          });
        },
      });
    }

    for (const mutation of hydrated) {
      if (mutation.status === "verifying") recover(mutation);
      if (mutation.status === "unknown") {
        markOutcomeUnknown(mutation.id, () => {
          markVerifying(mutation.id);
          recover(mutation);
        });
      }
    }
    const summary = root.querySelector<HTMLElement>("[data-mutation-summary]")!;
    const summaryIcon = root.querySelector<HTMLElement>(
      "[data-mutation-summary-icon]"
    )!;
    const toasts = root.querySelector<HTMLElement>("[data-mutation-toasts]")!;
    const list = root.querySelector<HTMLElement>("[data-mutation-list]")!;
    const activity =
      root.querySelector<HTMLDetailsElement>(".mutation-activity")!;
    const announcer = root.querySelector<HTMLElement>(
      "[data-mutation-announcer]"
    )!;
    const controller = new AbortController();
    let previousActive = 0;
    let initialized = false;
    let idle = true;
    let savedUntil = 0;
    let hideTimer: ReturnType<typeof setTimeout> | undefined;
    let fadeTimer: ReturnType<typeof setTimeout> | undefined;
    function showChip() {
      clearTimeout(fadeTimer);
      activity.hidden = false;
      delete activity.dataset.fading;
    }
    function hideWhenIdle() {
      if (activity.hidden) return;
      if (!idle || savedUntil > Date.now()) return;
      if (activity.open || activity.matches(":hover, :focus-within")) return;
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
        activity.hidden = true;
        return;
      }
      activity.dataset.fading = "true";
      clearTimeout(fadeTimer);
      fadeTimer = setTimeout(() => {
        activity.hidden = true;
        delete activity.dataset.fading;
      }, 150);
    }
    activity.addEventListener("pointerenter", showChip, {
      signal: controller.signal,
    });
    for (const event of ["pointerleave", "focusout", "toggle"]) {
      activity.addEventListener(event, () => queueMicrotask(hideWhenIdle), {
        signal: controller.signal,
      });
    }
    activity.addEventListener("focusin", showChip, {
      signal: controller.signal,
    });

    const unsubscribe = subscribeMutations((mutations) => {
      const { active, errors } = mutationCounts(mutations);
      summary.textContent = errors
        ? errors === 1
          ? strings.oneError
          : strings.manyErrors.replace("{n}", String(errors))
        : active
          ? active === 1
            ? strings.oneSaving
            : strings.manySaving.replace("{n}", String(active))
          : strings.allSaved;
      summaryIcon.textContent = errors ? "!" : active ? "◌" : "✓";
      root.dataset.state = errors ? "error" : active ? "pending" : "saved";
      if (
        announcer.textContent !== summary.textContent &&
        (active || errors || initialized)
      ) {
        announcer.textContent = summary.textContent;
      }
      idle = active === 0 && errors === 0;
      if (!idle) {
        clearTimeout(hideTimer);
        savedUntil = 0;
        showChip();
      } else if (initialized && previousActive > 0) {
        showChip();
        savedUntil = Date.now() + 4_000;
        hideTimer = setTimeout(hideWhenIdle, 4_000);
      } else {
        hideWhenIdle();
      }
      previousActive = active;
      initialized = true;
      renderItems(toasts, mutations, strings);
      renderItems(list, mutations, strings);
    });
    return () => {
      unsubscribe();
      controller.abort();
      clearTimeout(hideTimer);
      clearTimeout(fadeTimer);
    };
  });
</script>

<style is:global>
  #mutation-status {
    position: fixed;
    z-index: 90;
    right: 1rem;
    bottom: 1rem;
    display: grid;
    justify-items: end;
    gap: 0.75rem;
    width: min(24rem, calc(100vw - 2rem));
    /* The wrapper is 24rem wide but mostly empty: only real controls take clicks. */
    pointer-events: none;
  }
  #mutation-status .mutation-item,
  #mutation-status .mutation-summary,
  #mutation-status .mutation-panel {
    pointer-events: auto;
  }
  .mutation-toasts {
    display: grid;
    width: 100%;
    gap: 0.5rem;
  }
  .mutation-item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
    background: var(--color-surface-raised);
    box-shadow: var(--elevation-raised);
  }
  .mutation-item[data-status="error"] {
    border-color: var(--color-destructive);
  }
  .mutation-item-icon {
    display: grid;
    width: 1.5rem;
    height: 1.5rem;
    place-items: center;
    color: var(--color-primary);
    font-weight: 700;
  }
  .mutation-item[data-status="pending"] .mutation-item-icon,
  .mutation-item[data-status="confirmed"] .mutation-item-icon,
  .mutation-item[data-status="reconciling"] .mutation-item-icon,
  .mutation-item[data-status="verifying"] .mutation-item-icon {
    animation: mutation-spin 1.2s linear infinite;
  }
  .mutation-item[data-status="error"] .mutation-item-icon,
  .mutation-item[data-status="unknown"] .mutation-item-icon {
    color: var(--color-destructive);
  }
  .mutation-item-copy {
    display: grid;
    min-width: 0;
  }
  .mutation-item-copy strong {
    overflow: hidden;
    font-size: var(--text-sm);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .mutation-item-copy small {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }
  .mutation-dismiss {
    color: var(--color-muted);
    font-size: var(--text-xs);
    text-decoration: underline;
  }
  .mutation-item-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .mutation-retry,
  .mutation-dismiss {
    min-height: 1.5rem;
    padding: 0.25rem 0.5rem;
  }
  @media (pointer: coarse) {
    .mutation-retry,
    .mutation-dismiss {
      min-height: var(--control-size-md);
    }
  }
  .mutation-retry {
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 650;
  }
  .mutation-activity {
    position: relative;
    opacity: 1;
    transition: opacity 150ms ease;
  }
  .mutation-activity[data-fading] {
    opacity: 0;
  }
  .mutation-summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface-raised);
    box-shadow: var(--elevation-raised);
    color: var(--color-foreground);
    font-size: var(--text-sm);
    font-weight: 650;
    list-style: none;
    cursor: pointer;
  }
  .mutation-summary::-webkit-details-marker {
    display: none;
  }
  #mutation-status[data-state="error"] .mutation-summary {
    color: var(--color-destructive);
  }
  .mutation-panel {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.5rem);
    width: min(24rem, calc(100vw - 2rem));
    max-height: min(28rem, 70vh);
    padding: 1rem;
    overflow: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
    background: var(--color-surface-raised);
    box-shadow: var(--elevation-raised);
  }
  .mutation-panel h2 {
    margin-bottom: 0.75rem;
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .mutation-panel [data-mutation-list] {
    display: grid;
    gap: 0.5rem;
  }
  .mutation-panel [data-mutation-list]:empty::after {
    content: "—";
    color: var(--color-muted);
  }
  @keyframes mutation-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mutation-activity {
      transition: none;
    }
    .mutation-item-icon {
      animation: none !important;
    }
  }
</style>
