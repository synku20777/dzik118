---
import Icon from "./Icon.astro";
import { translate, uiLocale } from "../../lib/ui/i18n";

interface Props {
  organizationId?: string;
  organizationName?: string;
  organizations: { id: string; name: string; archivedAt: Date | null }[];
  residentAccess: boolean;
}
const { organizationId, organizationName, organizations, residentAccess } =
  Astro.props;
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
const ordered = [...organizations].sort(
  (a, b) =>
    Number(Boolean(a.archivedAt)) - Number(Boolean(b.archivedAt)) ||
    a.name.localeCompare(b.name, locale)
);
---

<details class="organization-switcher dropdown" name="organization-switcher">
  <summary class="organization-trigger btn-secondary">
    <span class="icon-tile icon-tile-sm" data-tone="info" aria-hidden="true">
      <Icon name="building" size="sm" />
    </span>
    <span class="organization-name">
      {organizationName ?? t("Your organizations")}
    </span>
    <span class="organization-chevron">
      <Icon name="chevron-right" size="xs" />
    </span>
  </summary>
  <nav
    class="organization-menu dropdown-panel"
    aria-label={t("Switch organization")}
  >
    <div class="dropdown-tiles">
      <a class="dropdown-tile" href="/admin/organizations">
        <Icon name="building-community" />
        {t("Your organizations")}
      </a>
      {residentAccess && (
        <a class="dropdown-tile" href="/portal">
          <Icon name="user" />
          {t("Switch to resident view")}
        </a>
      )}
    </div>
    {ordered.length > 0 && (
      <>
        <p class="menu-label">{t("Organizations")}</p>
        <ul class="organization-options menu-list">
          {ordered.map((org) => (
            <li>
              <a
                href={`/admin/o/${org.id}/dashboard`}
                aria-current={org.id === organizationId ? "true" : undefined}
              >
                <span class="organization-option-name">
                  {org.name}
                  {org.archivedAt && (
                    <span class="organization-archived">{t("Archived")}</span>
                  )}
                </span>
                {org.id === organizationId && <Icon name="check" size="sm" />}
              </a>
            </li>
          ))}
        </ul>
      </>
    )}
  </nav>
</details>

<script>
  import { onPageLoad } from "../../lib/ui/page-lifecycle";
  import { bindOrganizationSwitcher } from "../../lib/ui/organization-switcher";
  onPageLoad(() => {
    const cleanups = Array.from(
      document.querySelectorAll<HTMLDetailsElement>(".organization-switcher"),
      bindOrganizationSwitcher
    );
    return () => cleanups.forEach((cleanup) => cleanup());
  });
</script>

<style>
  .organization-switcher {
    position: relative;
    margin: 1.5rem 0 1rem;
  }
  /* A dropdown trigger: a secondary button (global.css gives its border,
     hover ring and pressed fill) laid out as tile, name and chevron. */
  .organization-trigger {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    justify-content: stretch;
    gap: 0.625rem;
    width: 100%;
    min-height: 3.5rem;
    padding: 0.625rem;
    text-align: left;
    cursor: pointer;
    list-style: none;
  }
  .organization-trigger::-webkit-details-marker {
    display: none;
  }
  .organization-name {
    font-size: var(--text-sm);
    line-height: 1.45;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .organization-chevron {
    display: flex;
    transform: rotate(90deg);
    color: var(--color-muted);
  }
  .organization-switcher[open]:not([data-closing]) .organization-chevron {
    transform: rotate(-90deg);
  }
  /* The shared dropdown menu (global.css), placed to float over the
     navigation instead of pushing it down. It spans exactly the trigger's
     width, so the scrolling sidebar or drawer does not clip it. */
  .organization-switcher {
    display: block;
  }
  .organization-menu {
    z-index: var(--z-overlay);
    top: calc(100% + var(--space-2));
    right: 0;
    min-width: 0;
  }
  .organization-options {
    max-height: 16rem;
    overflow-y: auto;
  }
  .organization-options a {
    line-height: 1.45;
  }
  .organization-options a[aria-current] {
    color: var(--color-primary);
  }
  .organization-options a[aria-current] > svg {
    color: currentColor;
  }
  .organization-option-name {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .organization-archived {
    display: block;
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--color-muted);
  }
  /* Motion answers the person's action: the trigger sinks when pressed, the
     chevron turns, and the menu eases in as it opens. */
  @media (prefers-reduced-motion: no-preference) {
    .organization-chevron {
      transition: transform var(--duration-panel) var(--ease-standard);
    }
    /* In: the standard panel ease, no overshoot. Out: quicker, so closing
       never makes the person wait (bindOrganizationSwitcher keeps the menu
       open until this animation ends). */
    .organization-menu {
      transform-origin: top;
      animation: organization-menu-in var(--duration-panel) var(--ease-standard)
        both;
    }
    .organization-switcher[data-closing] .organization-menu {
      animation: organization-menu-out var(--duration-fast) ease-in both;
    }
  }
  @keyframes organization-menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.96);
    }
  }
  @keyframes organization-menu-out {
    to {
      opacity: 0;
      transform: translateY(-6px) scale(0.97);
    }
  }
</style>
