---
import FacadeAccent from "./FacadeAccent.astro";
interface Props {
  title: string;
  headingLevel?: "h1" | "h2" | "h3";
  description?: string;
  eyebrow?: string;
  // Section 4.2's Fraunces display treatment -- opt-in per page, not the
  // default (most page titles stay plain Switzer; see global.css's
  // .page-header h1.font-display comment for which pages this is for).
  display?: boolean;
  accent?: boolean;
}
const {
  title,
  headingLevel: Heading = "h1",
  description,
  eyebrow,
  display = false,
  accent = display,
} = Astro.props;
---

<header class="page-header">
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <Heading class:list={{ "font-display": display }}>{title}</Heading>
    {description && <p class="page-description">{description}</p>}
    {accent && <FacadeAccent />}
  </div>
  <div class="page-actions">
    <slot />
  </div>
</header>
