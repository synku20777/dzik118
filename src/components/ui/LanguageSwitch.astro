---
import { translate, uiLocale, type Locale } from "../../lib/ui/i18n";
interface Props {
  fullNames?: boolean;
}
const { fullNames = false } = Astro.props;
const locale = uiLocale(Astro.cookies, Astro.url);
const names = { en: "English", lv: "Latviešu", ru: "Русский" };

const options: { code: Locale; label: string; ariaLabel: string }[] = [
  { code: "en", label: "EN", ariaLabel: "English" },
  { code: "lv", label: "LV", ariaLabel: "Latviešu valoda" },
  { code: "ru", label: "RU", ariaLabel: "Русский язык" },
];

function hrefFor(code: Locale) {
  const target = new URL(Astro.url);
  target.searchParams.set("lang", code);
  return target.pathname + target.search;
}
---

<span
  class="lang-switch"
  role="group"
  aria-label={translate(locale, "Language")}
>
  {options.map((option) =>
    option.code === locale ? (
      <span aria-current="true" lang={option.code} data-tip={option.ariaLabel}>
        {fullNames ? names[option.code] : option.label}
      </span>
    ) : (
      <a
        href={hrefFor(option.code)}
        lang={option.code}
        aria-label={option.ariaLabel}
        data-tip={option.ariaLabel}
      >
        {fullNames ? names[option.code] : option.label}
      </a>
    )
  )}
</span>
