---
import Icon from "./Icon.astro";
import { actions } from "astro:actions";
import StatusBadge from "./StatusBadge.astro";
import {
  formatDate,
  formatMoney,
  translate,
  type Locale,
} from "../../lib/ui/i18n";

export interface HistoryRow {
  transactionId: string;
  date: string;
  dwellingId: string | null;
  dwellingLabel: string;
  payer: string | null;
  reference: string | null;
  method: "BANK" | "CASH";
  amount: string;
  allocatedAmount?: string;
  currency: string;
  invoiceCurrency?: string;
  invoiceAmountDue?: string;
  status: "CONFIRMED" | "REVERSED" | "REJECTED";
  invoiceId?: string;
  invoiceNumber?: string;
  periodId?: string;
  matchId?: string;
  directReversible?: boolean;
  note?: string;
}

interface Props {
  rows: HistoryRow[];
  organizationId: string;
  locale: Locale;
  preview?: boolean;
}
const { rows, organizationId, locale, preview } = Astro.props;
const t = (message: string) => translate(locale, message);
const money = (value: string, currency: string) =>
  formatMoney(value, currency, locale);
const base = `/admin/o/${organizationId}`;
---

<div class="table-wrap stack-table">
  <table class="history-table w-full text-left text-body-sm">
    <caption class="sr-only">{t("Payment history")}</caption>
    <thead>
      <tr>
        <th scope="col">{t("Date")}</th>
        <th scope="col">{t("Dwelling")}</th>
        <th scope="col">{t("From")}</th>
        <th scope="col" class="text-right">
          {t("Amount")}
        </th>
        <th scope="col">{t("Applied to")}</th>
        <th scope="col">{t("Status")}</th>
        <th scope="col">{t("Actions")}</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr data-status={r.status}>
          <td class="whitespace-nowrap" data-col="date" data-label={t("Date")}>
            {formatDate(r.date, locale)}
          </td>
          <td data-col="dwelling" data-label={t("Dwelling")}>
            {r.dwellingId ? (
              <a
                class="link font-semibold"
                href={
                  preview
                    ? "#payment-history"
                    : `${base}/payments/ledger?dwelling=${r.dwellingId}`
                }
              >
                {r.dwellingLabel}
              </a>
            ) : (
              "—"
            )}
          </td>
          <td data-col="from" data-label={t("From")}>
            <div>{r.payer ?? "—"}</div>
            <small class="text-muted">
              {r.method === "CASH" ? t("Cash") : t("Bank transfer")}
              {r.reference ? ` · ${r.reference}` : ""}
            </small>
          </td>
          <td
            data-col="amount"
            class="text-right whitespace-nowrap font-medium"
            data-label={t("Amount")}
            data-void={r.status !== "CONFIRMED" ? "true" : undefined}
          >
            {money(r.amount, r.currency)}
          </td>
          <td data-col="applied" data-label={t("Applied to")}>
            {r.invoiceId && r.periodId ? (
              <a
                class="link"
                href={
                  preview
                    ? "#payment-history"
                    : `${base}/periods/${r.periodId}/invoices/${r.invoiceId}`
                }
              >
                {r.invoiceNumber}
              </a>
            ) : (
              t("Dwelling account")
            )}
            {r.note && <small class="block text-muted">{r.note}</small>}
          </td>
          <td data-col="status" data-label={t("Status")}>
            <StatusBadge status={r.status} />
          </td>
          <td data-col="actions" data-label={t("Actions")}>
            <div class="row-actions">
              <a
                class="btn-secondary btn-sm"
                href={
                  preview
                    ? "#payment-history"
                    : `${base}/payments/${r.transactionId}`
                }
              >
                {t("Details")}
              </a>
              {r.status === "CONFIRMED" && (
                <details class="reverse">
                  <summary class="btn-secondary btn-sm">
                    {t("Reverse")}
                    <Icon
                      name="chevron-right"
                      size="xs"
                      class="dropdown-chevron"
                    />
                  </summary>
                  <form
                    method={preview ? "dialog" : "POST"}
                    action={
                      preview
                        ? undefined
                        : r.directReversible
                          ? actions.payments.reverseDwellingPayment
                          : actions.payments.reverseMatch
                    }
                    class="mt-2 space-y-2"
                  >
                    <input
                      type="hidden"
                      name="organizationId"
                      value={organizationId}
                    />
                    {r.directReversible ? (
                      <input
                        type="hidden"
                        name="transactionId"
                        value={r.transactionId}
                      />
                    ) : (
                      <input type="hidden" name="matchId" value={r.matchId} />
                    )}
                    <div>
                      <label
                        class="field-label"
                        for={`reverse-reason-${r.matchId ?? r.transactionId}`}
                      >
                        {t("Reason for reversal")}
                      </label>
                      <input
                        type="text"
                        id={`reverse-reason-${r.matchId ?? r.transactionId}`}
                        name="reason"
                        class="mt-1"
                        required
                        maxlength="500"
                      />
                    </div>
                    <button
                      type="submit"
                      class="btn-secondary"
                      data-confirm-tone="danger"
                      data-confirm={
                        r.directReversible
                          ? t(
                              "Reverse this payment? The original payment stays in the history and a cancelling entry is added. The dwelling account goes back to its balance before the payment."
                            )
                          : t(
                              "Reverse this payment? The original payment stays in the history and a cancelling entry is added. The invoice becomes unpaid again."
                            )
                      }
                    >
                      {t("Reverse payment")}
                    </button>
                  </form>
                </details>
              )}
            </div>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  td.text-right,
  th.text-right {
    font-variant-numeric: tabular-nums;
  }
  /* The invoice number stays a text link; keep it a fair tap target. */
  a.link {
    display: inline-block;
    min-width: 1.5rem;
    min-height: 1.5rem;
  }
  .row-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-2);
  }
  .reverse summary {
    list-style: none;
  }
  .reverse summary::-webkit-details-marker {
    display: none;
  }
  /* Phone card for the payment history. The money leads (dwelling and amount),
     then who paid and the status, then what it paid and when; actions close
     the card. Labels are dropped: the content explains itself, except
     "Applied to", which has no unit to say what it is. */
  @media (width < 40rem) {
    .history-table tr[data-status] {
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "dwelling amount"
        "from status"
        "applied date"
        "actions actions";
      align-items: start;
      gap: 0.375rem 0.75rem;
      padding: 0.875rem 1rem !important;
    }
    .history-table td {
      display: block !important;
      width: auto !important;
      padding: 0 !important;
      text-align: left;
    }
    .history-table td::before {
      display: none !important;
    }
    .history-table td[data-col="dwelling"] {
      grid-area: dwelling;
      font-size: var(--text-base);
    }
    /* "Dwelling 4", not a bare 4: the label is the only thing saying what the
       number is. */
    .history-table td[data-col="dwelling"]::before {
      display: inline !important;
      content: attr(data-label) " ";
      font-size: inherit;
      font-weight: 700;
      color: inherit;
    }
    .history-table td[data-col="amount"] {
      grid-area: amount;
      justify-self: end;
      font-size: var(--text-lg);
      font-weight: 700;
    }
    .history-table td[data-col="from"] {
      grid-area: from;
    }
    .history-table td[data-col="status"] {
      grid-area: status;
      justify-self: end;
    }
    .history-table td[data-col="applied"] {
      grid-area: applied;
      color: var(--color-muted);
      font-size: var(--text-sm);
    }
    .history-table td[data-col="applied"]::before {
      display: inline !important;
      content: attr(data-label) " ";
      font-size: inherit;
      font-weight: 400;
    }
    .history-table td[data-col="date"] {
      grid-area: date;
      justify-self: end;
      color: var(--color-muted);
      font-size: var(--text-sm);
    }
    .history-table td[data-col="actions"] {
      grid-area: actions;
      margin-top: 0.25rem;
      padding-top: 0.625rem !important;
      border-top: 1px solid var(--color-border) !important;
    }
  }
</style>
