---
// The Dwellings page's building view: server-side data and translated strings
// for the React editor (components/building/BuildingEditor.tsx), plus its
// styles. Global with a building- prefix: the island renders the markup.
import BuildingEditor from "../building/BuildingEditor";
import { actions } from "astro:actions";
import type { EntranceInput } from "../../domain/organizations/building";
import { BUILDING_LIMITS } from "../../domain/organizations/building";
import { entityLabel, translate, uiLocale } from "../../lib/ui/i18n";
import { invoiceStatusBadge } from "../../lib/ui/invoice-status";
import type { IconName } from "../../lib/ui/icons";

interface Unit {
  id: string;
  number: string;
  type: string;
  stage: string | null;
}
interface Props {
  organizationId: string;
  entrances: EntranceInput[];
  units: Unit[];
  saved: boolean;
}
const { organizationId, entrances, saved } = Astro.props;
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
// Sorted once, here, in the page language: the island keeps this order, so
// the browser renders exactly what the server did.
const units = [...Astro.props.units].sort((a, b) =>
  a.number.localeCompare(b.number, locale, { numeric: true })
);

// A dwelling archived since the layout was saved simply drops out.
const active = new Set(units.map((unit) => unit.id));
const initial = entrances.map((entrance) => ({
  ...entrance,
  placements: entrance.placements.filter((p) => active.has(p.dwellingId)),
}));

const stageKeys = [
  "MISSING_DATA",
  "READY",
  "DRAFT",
  "PREPARED",
  "SENT",
  "OVERDUE",
  "PAID",
];
const stages: Record<string, { label: string; icon: IconName }> = {
  NONE: { label: t("No billing case this month"), icon: "info-circle" },
  ...Object.fromEntries(
    stageKeys.map((stage) => {
      const badge = invoiceStatusBadge(stage);
      return [stage, { label: t(badge.label), icon: badge.icon }];
    })
  ),
};

// What the tile marks mean, for touch screens (no tooltip there). Only the
// stages in this building; Ready and Prepared share an icon by the project's
// icon rule, so together they share a legend entry.
const present = new Set(units.map((unit) => unit.stage ?? "NONE"));
const legend = [
  ["MISSING_DATA"],
  ["DRAFT"],
  ["READY", "PREPARED"],
  ["SENT"],
  ["OVERDUE"],
  ["PAID"],
  ["NONE"],
]
  .map((group) => group.filter((stage) => present.has(stage)))
  .filter((group) => group.length > 0)
  .map((group) => ({
    stage: group[0],
    icon: stages[group[0]].icon,
    label: group.map((stage) => stages[stage].label).join(" / "),
  }));

const stripTypes = ["COMMERCIAL_UNIT", "PARKING", "STORAGE", "OTHER"].map(
  (type) => ({ type, label: entityLabel(type, locale) })
);

const labels = {
  arrange: t("Arrange"),
  done: t("Done"),
  undo: t("Undo"),
  addEntrance: t("Add entrance"),
  reset: t("Reset to number order"),
  resetConfirm: t(
    "Reset the building to number order? Your arrangement is removed."
  ),
  hint: t("Arranged by number. Use Arrange to match the real building."),
  help: t(
    "Drag a dwelling to a place, or select it and choose a place or use the arrow keys. A taken place swaps the two. Changes save on their own; Ctrl+Z undoes."
  ),
  saving: t("Saving…"),
  saved: t("All changes saved"),
  failed: t("The layout could not be saved."),
  retry: t("Retry"),
  discard: t("Discard the changes to the building layout?"),
  selected: t("Dwelling {number} selected. Choose a place."),
  moved: t("Dwelling {number} moved."),
  floor: t("Floor {floor}"),
  empty: t("Empty place: {entrance}, floor {floor}, place {place}"),
  topBusy: t("Move the dwellings off the top floor first."),
  columnBusy: t("Move the dwellings out of the last column first."),
  entranceBusy: t("Move the dwellings out of this entrance first."),
  entrance: t("Entrance"),
  entranceName: t("Entrance name"),
  floors: t("Floors"),
  perFloor: t("Per floor"),
  removeTop: t("Remove the top floor"),
  addFloor: t("Add a floor"),
  removeColumn: t("Remove a place per floor"),
  addColumn: t("Add a place per floor"),
  removeEntrance: t("Remove entrance"),
  notPlaced: t("Not placed"),
  legend: t("Legend"),
  dwelling: t("Dwelling"),
  building: t("Building"),
};
---

<BuildingEditor
  client:load
  organizationId={organizationId}
  initial={initial}
  saved={saved}
  units={units}
  limits={BUILDING_LIMITS}
  hrefBase={`/admin/o/${organizationId}/dwellings/`}
  resetAction={String(actions.dwellings.resetLayout)}
  labels={labels}
  stages={stages}
  stripTypes={stripTypes}
  legend={legend}
/>

<style is:global>
  .building {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .building-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .building-hint,
  .building-help {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .building-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-inline-start: auto;
  }
  /* Arranging needs room to drag: phones only show the building. */
  @media (width < 48rem) {
    .building-arrange-start {
      display: none;
    }
  }
  .building-scroll {
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }
  .building-facade {
    display: flex;
    width: max-content;
    min-width: 100%;
    border-inline: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .building-entrance {
    display: flex;
    flex: 1 0 auto;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 1rem 0;
  }
  .building-entrance + .building-entrance {
    border-inline-start: 1px dashed var(--color-border);
  }
  /* Bottom-aligned: every entrance stands on the same ground line. */
  .building-floors {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .building-floor {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(4.5rem, 6rem));
    gap: 0.5rem;
    justify-content: center;
  }
  .building-slot {
    min-height: 3.25rem;
    border-radius: var(--radius-control);
  }
  /* Phones: narrower tiles, so a four-wide floor fits without scrolling. */
  @media (width < 40rem) {
    .building-entrance {
      padding-inline: 0.5rem;
    }
    .building-floor {
      /* Fixed width: a long number gets its ellipsis instead of widening
         the column. */
      grid-template-columns: repeat(var(--columns), 3.5rem);
      gap: 0.375rem;
    }
  }
  .building[data-arranging] .building-slot:empty {
    border: 1px dashed var(--color-border);
    cursor: pointer;
  }
  .building[data-arranging] .building-slot:focus-visible {
    outline: 2px solid var(--color-focus-ring, var(--color-primary));
    outline-offset: 2px;
  }
  .building-unit {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    min-height: 3.25rem;
    padding: 0.375rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-surface-raised, var(--color-surface));
    min-width: 0;
    color: var(--color-foreground);
    text-decoration: none;
  }
  .building-unit:hover {
    background: var(--color-hover);
  }
  /* Where a dragged or selected tile would land. */
  .building-slot[data-over],
  .building-slot[data-over] > .building-unit,
  .building-tray-units[data-over] {
    background: var(--tone-info-bg);
    box-shadow: inset 0 0 0 1px var(--color-primary);
  }
  .building-tray-units[role="button"]:focus-visible {
    outline: 2px solid var(--color-focus-ring, var(--color-primary));
    outline-offset: 2px;
  }
  .building-status {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .building-status[data-status="error"] {
    color: var(--color-destructive);
  }
  .building-retry {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  /* Calm motion only: colour changes, and the moved tiles' brief tint. The
     glide to a new place is in the island (Web Animations, 180 ms). */
  @media (prefers-reduced-motion: no-preference) {
    .building-unit,
    .building-slot,
    .building-tray-units {
      transition:
        background-color var(--duration-fast) var(--ease-standard),
        border-color var(--duration-fast) var(--ease-standard),
        box-shadow var(--duration-fast) var(--ease-standard);
    }
    .building-unit[data-recent] {
      animation: building-recent 700ms var(--ease-standard);
    }
  }
  @keyframes building-recent {
    from {
      background-color: var(--tone-success-bg);
      border-color: var(--color-success);
    }
  }
  /* A long number is cut with an ellipsis; the tooltip has it whole. */
  .building-unit-number {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: var(--text-sm);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.25rem;
  }
  .building-unit-state {
    display: flex;
    justify-content: center;
    color: var(--color-muted);
    font-weight: 600;
  }
  /* Missing data is an open question; overdue the only warm tile. */
  .building-unit[data-stage="MISSING_DATA"] {
    border-style: dashed;
    border-color: var(--color-warning);
    background: transparent;
  }
  .building-unit[data-stage="MISSING_DATA"] .building-unit-state {
    color: var(--color-warning);
  }
  .building-unit[data-stage="OVERDUE"] {
    border-color: var(--tone-danger-text, var(--color-destructive));
    background: var(--tone-danger-bg);
  }
  .building-unit[data-stage="OVERDUE"] .building-unit-state {
    color: var(--color-destructive);
  }
  .building[data-arranging] .building-unit {
    cursor: grab;
  }
  .building-unit[aria-pressed="true"] {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  .building-door-row {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .building-entrance-name {
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-badge);
    background: var(--tone-info-bg);
    color: var(--tone-info-text);
    font-size: var(--text-xs);
    font-weight: 600;
    white-space: nowrap;
  }
  .building-door {
    width: 2.5rem;
    height: 3rem;
    border: 1px solid var(--color-border);
    border-bottom: 0;
    border-radius: 1.25rem 1.25rem 0 0;
  }
  .building-ground {
    width: max-content;
    min-width: 100%;
    border-top: 2px solid var(--color-foreground);
  }
  .building-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    color: var(--color-muted);
    font-size: var(--text-xs);
  }
  .building-legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
  .building-legend-mark {
    display: inline-flex;
    font-weight: 600;
  }
  .building-legend-mark[data-stage="MISSING_DATA"] {
    color: var(--color-warning);
  }
  .building-legend-mark[data-stage="OVERDUE"] {
    color: var(--color-destructive);
  }
  .building-entrance-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .building-entrance-name-input {
    width: 10rem;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--color-input-border);
    border-radius: var(--radius-control);
    background: var(--color-surface);
    font-size: var(--text-sm);
  }
  .building-stepper {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-muted);
    font-size: var(--text-xs);
  }
  .building-strip,
  .building-unplaced {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
    background: var(--color-surface);
  }
  .building-unplaced {
    flex-direction: column;
    gap: 0.5rem;
  }
  .building[data-arranging] .building-strip,
  .building[data-arranging] .building-unplaced {
    border-style: dashed;
  }
  .building-strip h3,
  .building-unplaced h3 {
    margin-bottom: 0.375rem;
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: 600;
  }
  .building-tray-units {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    min-height: 3.25rem;
  }
  .building-tray-units .building-unit {
    width: 5.5rem;
  }
</style>
