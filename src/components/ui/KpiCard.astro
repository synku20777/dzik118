---
import Icon from "./Icon.astro";
interface Props {
  label: string;
  value: string | number;
  tone?: "neutral" | "success" | "warning" | "danger";
  icon?: "invoice" | "coins" | "clock" | "open" | "lock";
  hint?: string;
}
const { label, value, tone = "neutral", icon, hint } = Astro.props;

// Summary/KPI cards keep their icon-container badge treatment (Tabler
// Icons system) -- unlike table rows, buttons, and status chips, which
// use bare icons with no background.
const ICON_NAMES = {
  invoice: "receipt-euro",
  coins: "coin",
  clock: "clock",
  open: "lock-open",
  lock: "lock",
} as const;
---

<div class="kpi" data-tone={tone}>
  {icon && (
    <span class="kpi-icon" aria-hidden="true">
      <Icon name={ICON_NAMES[icon]} size="lg" />
    </span>
  )}
  <div class="kpi-text">
    <p class="kpi-label">{label}</p>
    <p class="kpi-value">{value}</p>
    {hint && <small class="text-muted">{hint}</small>}
  </div>
  <slot />
</div>
