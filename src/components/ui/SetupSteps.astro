---
import Icon from "./Icon.astro";
import { translate, uiLocale } from "../../lib/ui/i18n";

export interface Props {
  organizationId: string;
  current:
    "organization" | "dwellings" | "period" | "charges" | "meters" | "review";
  steps: {
    organization: boolean;
    dwellings: boolean;
    period: boolean;
    charges: boolean;
    meters: boolean;
  };
}

const { organizationId, current, steps } = Astro.props;
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);

const stepItems = [
  {
    key: "organization" as const,
    path: `/admin/o/${organizationId}/setup/organization`,
    title: t("Organization details"),
  },
  {
    key: "dwellings" as const,
    path: `/admin/o/${organizationId}/setup/dwellings`,
    title: t("Dwellings"),
  },
  {
    key: "period" as const,
    path: `/admin/o/${organizationId}/setup/period`,
    title: t("First billing period"),
  },
  {
    key: "charges" as const,
    path: `/admin/o/${organizationId}/setup/charges`,
    title: t("Charges"),
  },
  {
    key: "meters" as const,
    path: `/admin/o/${organizationId}/setup/meters`,
    title: t("Meters and starting readings"),
  },
  {
    key: "review" as const,
    path: `/admin/o/${organizationId}/setup`,
    title: t("Review"),
  },
];
const completedCount = Object.values(steps).filter(Boolean).length;
---

<nav class="setup-trail" aria-label={t("Setup steps")}>
  <div class="setup-trail-heading text-body-sm">
    <span class="font-medium text-foreground">{t("Setup steps")}</span>
    <span class="text-muted">
      {completedCount} / 5 {t("Done").toLocaleLowerCase(locale)}
    </span>
  </div>
  <progress
    class="setup-progress"
    value={completedCount}
    max="5"
    aria-label={t("Setup complete")}
  ></progress>
  <ol class="setup-steps">
    {stepItems.map((step, index) => {
      const isCurrent = step.key === current;
      const isDone = step.key !== "review" && steps[step.key];
      const stepNum = index + 1;

      return (
        <li class="setup-step-item">
          <a
            href={step.path}
            class:list={["setup-step-link", { "is-done": isDone }]}
            aria-current={isCurrent ? "step" : undefined}
          >
            <span class="step-num" aria-hidden="true">
              {isDone ? <Icon name="check" size="xs" /> : stepNum}
            </span>
            <span class="step-title">{step.title}</span>
            {step.key !== "review" && (
              <span class="sr-only">{isDone ? t("Done") : t("To do")}</span>
            )}
          </a>
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .setup-trail {
    position: sticky;
    top: 1.5rem;
    min-width: 0;
  }
  .setup-trail-heading {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .setup-progress {
    display: block;
    appearance: none;
    width: 100%;
    height: 0.25rem;
    border: 0;
    border-radius: 1rem;
    overflow: hidden;
    margin: 0.875rem 0 1.25rem;
    background: var(--color-border);
    color: var(--color-success);
  }
  .setup-progress::-webkit-progress-bar {
    background: var(--color-border);
  }
  .setup-progress::-webkit-progress-value {
    background: var(--color-success);
  }
  .setup-progress::-moz-progress-bar {
    background: var(--color-success);
  }
  .setup-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.375rem;
  }
  .setup-step-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 0.75rem;
    min-height: 3rem;
    border-radius: var(--radius-control);
    color: var(--color-muted);
    font-size: 0.8125rem;
    line-height: 1.4;
    text-decoration: none;
  }
  .setup-step-link:hover {
    background: var(--color-surface-hover);
    color: var(--color-foreground);
  }
  .setup-step-link[aria-current="step"] {
    background: var(--color-nav-active-bg);
    color: var(--color-primary);
    font-weight: 650;
  }
  .step-num {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--color-badge-neutral-bg);
    color: var(--color-badge-neutral-text);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .setup-step-link.is-done .step-num {
    background: var(--color-badge-success-bg);
    color: var(--color-badge-success-text);
  }
  .setup-step-link[aria-current="step"] .step-num {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }
  @media (max-width: 70rem) {
    .setup-trail {
      position: static;
    }
    .setup-steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .setup-progress {
      margin-bottom: 0.75rem;
    }
  }
  @media (max-width: 35rem) {
    .setup-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .setup-step-link {
      padding: 0.625rem 0.5rem;
      gap: 0.5rem;
    }
  }
</style>
