---
import Icon from "./Icon.astro";
import { translate, uiLocale } from "../../lib/ui/i18n";

export interface Props {
  organizationId: string;
  current:
    "organization" | "dwellings" | "period" | "charges" | "meters" | "review";
  steps: {
    organization: boolean;
    dwellings: boolean;
    period: boolean;
    charges: boolean;
    meters: boolean;
  };
}

const { organizationId, current, steps } = Astro.props;
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);

const stepItems = [
  {
    key: "organization" as const,
    path: `/admin/o/${organizationId}/setup/organization`,
    title: t("Organization details"),
  },
  {
    key: "dwellings" as const,
    path: `/admin/o/${organizationId}/setup/dwellings`,
    title: t("Dwellings"),
  },
  {
    key: "period" as const,
    path: `/admin/o/${organizationId}/setup/period`,
    title: t("First billing period"),
  },
  {
    key: "charges" as const,
    path: `/admin/o/${organizationId}/setup/charges`,
    title: t("Charges"),
  },
  {
    key: "meters" as const,
    path: `/admin/o/${organizationId}/setup/meters`,
    title: t("Meters and starting readings"),
  },
  {
    key: "review" as const,
    path: `/admin/o/${organizationId}/setup`,
    title: t("Review"),
  },
];
const completedCount = Object.values(steps).filter(Boolean).length;
const currentTitle = stepItems.find((step) => step.key === current)?.title;
---

<nav class="setup-trail" aria-label={t("Setup steps")}>
  <div class="setup-trail-heading text-body-sm">
    <span class="setup-trail-label font-medium text-foreground">
      {t("Setup steps")}
    </span>
    <span class="setup-trail-current font-medium text-foreground">
      {currentTitle}
    </span>
    <span class="text-muted">
      {completedCount} / 5 {t("Done").toLocaleLowerCase(locale)}
    </span>
  </div>
  <div
    class="setup-progress"
    role="progressbar"
    aria-label={t("Setup complete")}
    aria-valuemin="0"
    aria-valuemax="5"
    aria-valuenow={completedCount}
    aria-valuetext={`${completedCount} / 5`}
  >
    <span style={`transform: scaleX(${completedCount / 5})`}></span>
  </div>
  <ol class="setup-steps">
    {stepItems.map((step, index) => {
      const isCurrent = step.key === current;
      const isDone = step.key !== "review" && steps[step.key];
      const stepNum = index + 1;

      return (
        <li class="setup-step-item">
          <a
            href={step.path}
            class:list={["setup-step-link", { "is-done": isDone }]}
            aria-current={isCurrent ? "step" : undefined}
          >
            <span class="step-num" aria-hidden="true">
              {isDone ? <Icon name="check" size="xs" /> : stepNum}
            </span>
            <span class="step-title">{step.title}</span>
            {step.key !== "review" && (
              <span class="sr-only">{isDone ? t("Done") : t("To do")}</span>
            )}
          </a>
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .setup-trail {
    position: sticky;
    top: 1.5rem;
    min-width: 0;
  }
  .setup-trail-heading {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .setup-progress {
    height: 0.25rem;
    border-radius: 1rem;
    overflow: hidden;
    margin: 0.875rem 0 1.25rem;
    background: var(--color-border);
  }
  .setup-progress > span {
    display: block;
    height: 100%;
    background: var(--color-success);
    transform-origin: left;
  }
  .setup-trail-current {
    display: none;
  }
  /* The bar fills up to the current value on arrival. */
  @media (prefers-reduced-motion: no-preference) {
    .setup-progress > span {
      animation: setup-fill var(--duration-panel) var(--ease-standard) both;
    }
    .setup-step-link {
      transition:
        background-color var(--duration-fast) ease,
        color var(--duration-fast) ease;
    }
  }
  @keyframes setup-fill {
    from {
      transform: scaleX(0);
    }
  }
  .setup-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.375rem;
  }
  .setup-step-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 0.75rem;
    min-height: 3rem;
    border-radius: var(--radius-control);
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.4;
    text-decoration: none;
  }
  .setup-step-link:hover {
    background: var(--color-hover);
    color: var(--color-foreground);
  }
  .setup-step-link[aria-current="step"] {
    background: var(--color-nav-active-bg);
    color: var(--color-primary);
    font-weight: 650;
  }
  .step-num {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--tone-neutral-bg);
    color: var(--tone-neutral-text);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .setup-step-link.is-done .step-num {
    background: var(--tone-success-bg);
    color: var(--tone-success-text);
  }
  .setup-step-link[aria-current="step"] .step-num {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }
  @media (width < 70rem) {
    .setup-trail {
      position: static;
    }
    .setup-steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .setup-progress {
      margin-bottom: 0.75rem;
    }
  }
  /* Phones: one row of step circles, the current title in the heading. */
  @media (width < 40rem) {
    .setup-trail-label {
      display: none;
    }
    .setup-trail-current {
      display: inline;
    }
    .setup-steps {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 0;
    }
    .setup-step-link {
      justify-content: center;
      min-height: 2.75rem;
      padding: 0.25rem;
    }
    .step-title {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }
</style>
