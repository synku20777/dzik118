---
// The "record a payment" form (ADR 0014), shared by the Payments page and the
// dwelling page. One target select: an open invoice, or a dwelling account that
// has no open invoice. The page wraps it in its own disclosure.
import { actions } from "astro:actions";
import FieldError from "./FieldError.astro";
import { formatMoney, translate, uiLocale } from "../../lib/ui/i18n";

interface Props {
  organizationId: string;
  invoices: Array<{
    id: string;
    invoiceNumber: string;
    dwellingNumber: string;
    currency: string;
    remaining: string;
  }>;
  dwellings: Array<{ id: string; number: string }>;
  today: string;
  error?: unknown;
  idPrefix?: string;
  // Shown with the amount in the confirmation; without it the amount is
  // shown as typed.
  currency?: string;
}

const {
  organizationId,
  invoices,
  dwellings,
  today,
  error,
  idPrefix,
  currency,
} = Astro.props;
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
const id = idPrefix ?? "manual";
const onlyOne = invoices.length + dwellings.length === 1;
// A new id for every rendered form: a second submit of this same form (double
// click, reload after the POST) is refused instead of paying twice.
const submissionId = crypto.randomUUID();
const field =
  "mt-1 w-full rounded-control border border-(--color-input-border) px-3 py-1.5 text-sm";
const label = "field-label";
---

<p class="text-sm text-muted">
  {t(
    "Use this for money that is not in an imported statement: a transfer the statement missed, cash, or a payment for a dwelling that has no open invoice. The payment is applied right away."
  )}
</p>
<form
  method="POST"
  action={actions.payments.recordManual}
  class="mt-4 space-y-3"
  data-payment-form
  data-currency={currency}
>
  <input type="hidden" name="organizationId" value={organizationId} />
  <input type="hidden" name="submissionId" value={submissionId} />
  <div>
    <label class={label} for={`${id}-target`}>
      {t("Apply to")}
    </label>
    <select id={`${id}-target`} name="target" required class={field}>
      {!onlyOne && (
        <option value="" disabled selected>
          {t("Choose where the payment goes")}
        </option>
      )}
      {invoices.length > 0 && (
        <optgroup label={t("Open invoices")}>
          {invoices.map((inv) => (
            <option value={`invoice:${inv.id}`} selected={onlyOne}>
              {`${inv.invoiceNumber} · ${t("Dwelling")} ${inv.dwellingNumber} · ${formatMoney(inv.remaining, inv.currency, locale)}`}
            </option>
          ))}
        </optgroup>
      )}
      {dwellings.length > 0 && (
        <optgroup label={t("Dwelling account (no open invoice)")}>
          {dwellings.map((d) => (
            <option value={`dwelling:${d.id}`} selected={onlyOne}>
              {`${t("Dwelling")} ${d.number}`}
            </option>
          ))}
        </optgroup>
      )}
    </select>
    <FieldError name="target" id={`${id}-target-error`} error={error} />
  </div>
  <div>
    <label class={label} for={`${id}-method`}>
      {t("Method")}
    </label>
    <select id={`${id}-method`} name="method" class={field}>
      <option value="BANK">{t("Bank transfer")}</option>
      <option value="CASH">{t("Cash")}</option>
    </select>
  </div>
  <div>
    <label class={label} for={`${id}-amount`}>
      {t("Amount")}
    </label>
    <input
      id={`${id}-amount`}
      name="amount"
      inputmode="decimal"
      required
      class={field}
    />
    <FieldError name="amount" id={`${id}-amount-error`} error={error} />
  </div>
  <div>
    <label class={label} for={`${id}-date`}>
      {t("Date")}
    </label>
    <input
      id={`${id}-date`}
      name="bookingDate"
      type="date"
      required
      max={today}
      class={field}
    />
    <FieldError name="bookingDate" id={`${id}-date-error`} error={error} />
  </div>
  <div>
    <label class={label} for={`${id}-payer`}>
      {t("Payer")}
    </label>
    <input id={`${id}-payer`} name="payerName" class={field} />
    <FieldError name="payerName" id={`${id}-payer-error`} error={error} />
  </div>
  <div>
    <label class={label} for={`${id}-reference`}>
      {t("Reference")}
    </label>
    <input
      id={`${id}-reference`}
      name="reference"
      maxlength="140"
      aria-describedby={`${id}-reference-hint`}
      class={field}
    />
    <p id={`${id}-reference-hint`} class="field-hint">
      {t(
        "Required for a bank transfer. For cash, a receipt number if you have one."
      )}
    </p>
    <FieldError name="reference" id={`${id}-reference-error`} error={error} />
  </div>
  <div>
    <label class={label} for={`${id}-reason`}>
      {t("Reason")}
    </label>
    <input
      id={`${id}-reason`}
      name="reason"
      required
      maxlength="500"
      class={field}
    />
    <FieldError name="reason" id={`${id}-reason-error`} error={error} />
  </div>
  <div>
    <button
      type="submit"
      class="btn-primary"
      data-confirm={t("Record this payment? It is applied right away.")}
      data-confirm-template={t(
        "Record {amount} for {target}? It is applied right away."
      )}
    >
      {t("Record payment")}
    </button>
  </div>
</form>

<script>
  // The confirmation names the amount and where the payment goes, so a
  // mistyped amount or a wrong invoice is caught before anything is posted.
  // forms.ts reads data-confirm when the form submits; this keeps it current.
  function describe(form: HTMLFormElement) {
    const button = form.querySelector<HTMLButtonElement>(
      "button[data-confirm-template]"
    );
    const amountInput = form.querySelector<HTMLInputElement>(
      'input[name="amount"]'
    );
    // A plain querySelector and a cast: workers-types break the
    // HTMLSelectElement generic (see src/lib/ui/invoice-template-editor.ts).
    const target = form.querySelector(
      'select[name="target"]'
    ) as unknown as HTMLSelectElement | null;
    const option = target?.selectedOptions[0];
    const raw = amountInput?.value.trim() ?? "";
    if (!button || !raw || !option?.value) return;
    const number = Number(raw.replace(/\s/g, "").replace(",", "."));
    const currency = form.dataset.currency;
    const amount =
      currency && Number.isFinite(number)
        ? new Intl.NumberFormat(document.documentElement.lang || undefined, {
            style: "currency",
            currency,
          }).format(number)
        : raw;
    button.dataset.confirm = button.dataset
      .confirmTemplate!.replace("{amount}", amount)
      .replace("{target}", option.textContent?.trim() ?? "");
  }
  for (const type of ["input", "change"])
    document.addEventListener(type, (event) => {
      const form = (event.target as Element | null)?.closest?.(
        "form[data-payment-form]"
      );
      if (form instanceof HTMLFormElement) describe(form);
    });
</script>
