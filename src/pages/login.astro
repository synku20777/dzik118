---
// Phase C (Auth/security) - Login entry (spec Section 9.1, 15.1, 15.2).
import AuthLayout from "../layouts/AuthLayout.astro";

const sent = Astro.url.searchParams.get("sent") === "1";
const adminError = Astro.url.searchParams.get("error") === "1";
// Set by middleware.ts: a valid Supabase session with no matching/enabled
// app_users row (never-provisioned resident, deprovisioned admin, disabled
// account). Shown regardless of which form the visitor used -- neither the
// message nor this page distinguishes which check failed.
const noAccountError = Astro.url.searchParams.get("error") === "2";
---

<AuthLayout title="Sign In - Property Billing">
  <div class="w-full max-w-md space-y-6">
    {
      noAccountError && (
        <p class="rounded-md bg-red-50 p-3 text-sm text-red-800">
          We couldn't find an account for that sign-in. If you believe this
          is a mistake, contact your administrator.
        </p>
      )
    }
    <div class="rounded-xl border border-neutral-200 bg-white p-8 shadow-sm">
      <h1 class="text-xl font-bold text-neutral-900">Resident sign in</h1>
      <p class="mt-1 text-sm text-neutral-600">
        Enter your email and we'll send you a secure sign-in link.
      </p>
      {
        sent && (
          <p class="mt-4 rounded-md bg-green-50 p-3 text-sm text-green-800">
            If that email is registered, a sign-in link is on its way.
          </p>
        )
      }
      <form
        method="POST"
        action="/api/v1/auth/request-link"
        class="mt-4 space-y-3"
      >
        <div>
          <label
            class="block text-sm font-medium text-neutral-700"
            for="resident-email"
          >
            Email
          </label>
          <input
            id="resident-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="mt-1 w-full rounded-md border border-neutral-300 px-3 py-2 text-sm"
          />
        </div>
        <button
          type="submit"
          class="w-full rounded-md bg-neutral-900 px-3 py-2 text-sm font-medium text-white"
        >
          Send sign-in link
        </button>
      </form>
    </div>

    <div class="rounded-xl border border-neutral-200 bg-white p-8 shadow-sm">
      <h2 class="text-lg font-bold text-neutral-900">Admin sign in</h2>
      {
        adminError && (
          <p class="mt-4 rounded-md bg-red-50 p-3 text-sm text-red-800">
            Incorrect email or password.
          </p>
        )
      }
      <form
        id="admin-login-form"
        method="POST"
        action="/api/v1/auth/admin-login"
        class="mt-4 space-y-3"
      >
        <div>
          <label
            class="block text-sm font-medium text-neutral-700"
            for="admin-email"
          >
            Email
          </label>
          <input
            id="admin-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="mt-1 w-full rounded-md border border-neutral-300 px-3 py-2 text-sm"
          />
        </div>
        <div>
          <label
            class="block text-sm font-medium text-neutral-700"
            for="admin-password"
          >
            Password
          </label>
          <input
            id="admin-password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            class="mt-1 w-full rounded-md border border-neutral-300 px-3 py-2 text-sm"
          />
        </div>
        <button
          type="submit"
          class="w-full rounded-md bg-neutral-900 px-3 py-2 text-sm font-medium text-white"
        >
          Sign in
        </button>
      </form>
    </div>
  </div>
</AuthLayout>
