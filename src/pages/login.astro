---
// Phase C (Auth/security) - Login entry (spec Section 9.1, 15.1, 15.2).
import AuthLayout from "../layouts/AuthLayout.astro";
import Ornament from "../components/ui/Ornament.astro";
import { translate, uiLocale } from "../lib/ui/i18n";

const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);

const sent = Astro.url.searchParams.get("sent") === "1";
// Set by set-password.ts after a successful admin password reset.
const passwordReset = Astro.url.searchParams.get("reset") === "1";
// Each code maps to a distinct, specific message rather than one generic
// "sign-in failed" -- each represents a genuinely different remedy (fix
// your password, request a new link, wait and retry, contact an admin),
// so collapsing them would leave the visitor guessing.
const errorCode = Astro.url.searchParams.get("error");
const adminError = errorCode === "1";
// Set by middleware.ts: a valid Supabase session with no matching/enabled
// app_users row (never-provisioned resident, deprovisioned admin, disabled
// account). Shown regardless of which form the visitor used -- neither the
// message nor this page distinguishes which check failed.
const noAccountError = errorCode === "2";
// Set by auth/confirm.ts: the magic-link token is missing, malformed,
// expired, or already used.
const expiredLinkError = errorCode === "3";
// Set by admin-login.ts and auth/confirm.ts's IP rate limiter.
const rateLimitedError = errorCode === "4";
// Set by admin-login.ts's catch-all: a transient failure (e.g. Supabase
// unreachable), not a credential problem -- shown separately so it doesn't
// send the admin chasing a password that was never actually wrong.
const unexpectedError = errorCode === "5";
---

<AuthLayout title={t("Sign in") + " - " + t("Property Billing")}>
  <div class="w-full max-w-md space-y-6">
    <div class="mb-2 space-y-3 text-center">
      <p class="font-display text-2xl font-semibold">{t("Property Billing")}</p>
      <Ornament />
    </div>
    {
      noAccountError && (
        <p class="rounded-control bg-danger-surface p-3 text-sm text-destructive">
          {t(
            "We couldn't find an account for that sign-in. If you believe this is a mistake, contact your administrator."
          )}
        </p>
      )
    }
    {
      rateLimitedError && (
        <p class="rounded-control bg-danger-surface p-3 text-sm text-destructive">
          {t("Too many sign-in attempts. Please wait a minute and try again.")}
        </p>
      )
    }
    <div class="rounded-panel border border-border bg-surface p-8">
      <h1 class="text-xl font-bold text-foreground">{t("Resident sign in")}</h1>
      <p class="mt-1 text-sm text-muted">
        {t("Enter your email and we'll send you a secure sign-in link.")}
      </p>
      {
        sent && (
          <p class="mt-4 rounded-control bg-success-surface p-3 text-sm text-success">
            {t("If that email is registered, a sign-in link is on its way.")}
          </p>
        )
      }
      {
        expiredLinkError && (
          <p class="mt-4 rounded-control bg-danger-surface p-3 text-sm text-destructive">
            {t(
              "This sign-in link is invalid or has expired. Request a new one below."
            )}
          </p>
        )
      }
      <form
        method="POST"
        action="/api/v1/auth/request-link"
        class="mt-4 space-y-3"
      >
        <div>
          <label
            class="block text-sm font-medium text-foreground"
            for="resident-email">{t("Email")}</label
          >
          <input
            id="resident-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="mt-1 w-full rounded-control border border-border px-3 py-2 text-sm"
          />
        </div>
        <button type="submit" class="btn-primary w-full">
          {t("Send sign-in link")}
        </button>
      </form>
    </div>

    <div class="rounded-panel border border-border bg-surface p-8">
      <h2 class="text-lg font-bold text-foreground">{t("Admin sign in")}</h2>
      {
        passwordReset && (
          <p
            class="mt-4 rounded-control bg-success-surface p-3 text-sm text-success"
            role="status"
          >
            {t("Password updated. Sign in with your new password.")}
          </p>
        )
      }
      {
        adminError && (
          <p class="mt-4 rounded-control bg-danger-surface p-3 text-sm text-destructive">
            {t("Incorrect email or password.")}
          </p>
        )
      }
      {
        unexpectedError && (
          <p class="mt-4 rounded-control bg-danger-surface p-3 text-sm text-destructive">
            {t("Something went wrong. Please try again.")}
          </p>
        )
      }
      <form
        id="admin-login-form"
        method="POST"
        action="/api/v1/auth/admin-login"
        class="mt-4 space-y-3"
      >
        <div>
          <label
            class="block text-sm font-medium text-foreground"
            for="admin-email">{t("Email")}</label
          >
          <input
            id="admin-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="mt-1 w-full rounded-control border border-border px-3 py-2 text-sm"
          />
        </div>
        <div>
          <label
            class="block text-sm font-medium text-foreground"
            for="admin-password">{t("Password")}</label
          >
          <input
            id="admin-password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            class="mt-1 w-full rounded-control border border-border px-3 py-2 text-sm"
          />
        </div>
        <button type="submit" class="btn-primary w-full">{t("Sign in")}</button>
        <p class="text-center text-sm">
          <a href="/forgot-password" class="text-muted hover:underline"
            >{t("Forgot password?")}</a
          >
        </p>
      </form>
    </div>
  </div>
</AuthLayout>
