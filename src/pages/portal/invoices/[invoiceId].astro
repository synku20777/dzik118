---
import StatusBadge from "../../../components/ui/StatusBadge.astro";
import Icon from "../../../components/ui/Icon.astro";
import {
  formatMoney,
  formatDate,
  translate,
  uiLocale,
} from "../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
import ResidentLayout from "../../../layouts/ResidentLayout.astro";
import {
  ForbiddenError,
  requireDwellingAccess,
} from "../../../domain/authorization/guards";
import {
  getInvoiceForResident,
  listInvoicesForDwelling,
} from "../../../domain/billing/generation";
import { renderInvoicePreview } from "../../../domain/billing/invoice-html";
import {
  parseInvoiceLocale,
  INVOICE_LOCALES,
} from "../../../domain/billing/invoice-i18n";
import { withRequestDb } from "../../../lib/db-request";
import { rethrowUnexpected } from "../../../domain/errors";
import { readInvoiceSnapshots } from "../../../domain/billing/invoice-snapshots";
import { tryBuildSepaQrSvg } from "../../../domain/billing/sepa-qr";

const invoiceId = Astro.params.invoiceId!;
const dwellingId = Astro.url.searchParams.get("dwellingId");
if (!dwellingId) {
  return Astro.redirect("/portal/dwellings");
}

try {
  requireDwellingAccess(Astro.locals.auth, dwellingId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

let invoice: Awaited<ReturnType<typeof getInvoiceForResident>>["invoice"];
let lines: Awaited<ReturnType<typeof getInvoiceForResident>>["lines"];
let caseStatus: Awaited<ReturnType<typeof getInvoiceForResident>>["caseStatus"];
let paidAmount: Awaited<ReturnType<typeof getInvoiceForResident>>["paidAmount"];
let remainingAmount: Awaited<
  ReturnType<typeof getInvoiceForResident>
>["remainingAmount"];
let latestInvoice:
  Awaited<ReturnType<typeof listInvoicesForDwelling>>[number] | undefined;
try {
  ({ invoice, lines, caseStatus, paidAmount, remainingAmount, latestInvoice } =
    await withRequestDb(async (db) => ({
      ...(await getInvoiceForResident(db, invoiceId, dwellingId)),
      latestInvoice: (await listInvoicesForDwelling(db, dwellingId)).at(-1),
    })));
} catch (err) {
  rethrowUnexpected(err);
  return Astro.redirect(`/portal/dwellings/${dwellingId}/invoices`);
}
const snapshots = readInvoiceSnapshots(invoice);
const issuer = snapshots?.issuer;
const payment = snapshots?.payment;
const isLatestInvoice = latestInvoice?.id === invoice.id;
const needsPayment = isLatestInvoice && remainingAmount !== "0.00";
const transferFields = [
  ["Recipient", issuer?.name ?? ""],
  ["IBAN", payment?.iban ?? ""],
  ["Payment reference", invoice.invoiceNumber],
  ["Amount still due", remainingAmount],
] as const;
const qrSvg =
  needsPayment && snapshots
    ? tryBuildSepaQrSvg({
        beneficiaryName: issuer?.name ?? "",
        iban: payment?.iban ?? "",
        bic: payment?.bic ?? null,
        currency: invoice.currency,
        amountDue: remainingAmount,
        invoiceNumber: invoice.invoiceNumber,
      })
    : null;
const docLocale = parseInvoiceLocale(Astro.url.searchParams.get("docLocale"));
// The payment panel uses the remaining balance; the document keeps its original total.
const invoiceHtml = renderInvoicePreview(invoice, lines, docLocale, t, {
  showPaymentQr: false,
});
const pdfHref =
  `/api/v1/portal/invoices/${invoiceId}/pdf?dwellingId=${dwellingId}` +
  (docLocale === "lv" ? "" : `&locale=${docLocale}`);
const localeNames: Record<(typeof INVOICE_LOCALES)[number], string> = {
  lv: "Latviešu",
  en: "English",
  ru: "Русский",
};
---

<ResidentLayout title={invoice.invoiceNumber}>
  <div>
    <a class="resident-back" href={`/portal/dwellings/${dwellingId}/invoices`}>
      <Icon name="arrow-left" />
      {t("All invoices")}
    </a>
    <header class="resident-title">
      <h1 class="font-display">
        {t(needsPayment ? "Pay by bank transfer" : "Invoice")}
      </h1>
      <p>
        {invoice.invoiceNumber} · {t("Due date")}:{" "}
        {formatDate(invoice.dueDate, locale)}
      </p>
    </header>
    <section class="resident-section" aria-labelledby="invoice-balance">
      <div class="resident-row">
        <h2 id="invoice-balance">
          {t(isLatestInvoice ? "Amount still due" : "Invoice total due")}
        </h2>
        <StatusBadge status={caseStatus} />
      </div>
      <p class="resident-amount">
        {formatMoney(
          isLatestInvoice ? remainingAmount : invoice.amountDue,
          invoice.currency,
          locale
        )}
      </p>
      {!isLatestInvoice && latestInvoice ? (
        <>
          <p class="notice notice-warning">
            {t(
              "A newer bill exists. Do not pay this older bill separately. Check the newest bill for the amount to pay."
            )}
          </p>
          <a
            class="btn-primary"
            href={`/portal/invoices/${latestInvoice.id}?dwellingId=${dwellingId}`}
          >
            {t("Open latest bill")}
          </a>
        </>
      ) : needsPayment && snapshots ? (
        <>
          <p>
            {t(
              "Make the transfer in your bank. Copy these details into your bank's payment form."
            )}
          </p>
          <dl class="resident-payment-fields">
            {transferFields.map(([label, value]) => (
              <div>
                <dt>{t(label)}</dt>
                <dd>
                  {value
                    ? label === "Amount still due"
                      ? formatMoney(value, invoice.currency, locale)
                      : value
                    : t("Not available")}
                </dd>
                {value && (
                  <button
                    type="button"
                    class="btn-secondary"
                    data-copy-value={value}
                    data-copied-label={t("Copied")}
                    aria-label={`${t("Copy")}: ${t(label)}`}
                    hidden
                  >
                    <Icon name="copy" />
                    <span>{t("Copy")}</span>
                  </button>
                )}
              </div>
            ))}
          </dl>
          {(!issuer?.name || !payment?.iban) && (
            <p class="notice notice-warning">
              {t(
                "Bank details are missing. Contact your administrator before paying."
              )}
            </p>
          )}
          <p
            role="status"
            data-copy-status
            data-copied={t("Copied. Paste it into your bank's payment form.")}
            data-copy-failed={t(
              "Could not copy. Select the details and copy them yourself."
            )}
          ></p>
          <p>
            {t(
              "Check the recipient, amount and payment reference in your bank before you confirm. This portal does not make the transfer."
            )}
          </p>
          <p class="resident-line resident-hint">
            <Icon name="info-circle" />
            {t(
              "If you have already paid, do not pay again. Your payment appears after the administrator records it."
            )}
          </p>
          {paidAmount !== "0.00" && (
            <p class="notice notice-warning">
              {t(
                "The invoice document shows the original amount. Pay only the amount still due shown above."
              )}
            </p>
          )}
          {qrSvg && (
            <details class="resident-details">
              <summary>
                {t("Pay with a banking app QR code")}
                <Icon name="chevron-right" size="lg" />
              </summary>
              <div class="resident-details-body">
                <p>
                  {t(
                    "If your banking app supports it, scan this code from another screen. Check the payment details before confirming in your bank."
                  )}
                </p>
                <div
                  class="resident-qr"
                  role="img"
                  aria-label={t("Bank transfer QR code")}
                  set:html={qrSvg}
                />
              </div>
            </details>
          )}
        </>
      ) : !snapshots ? (
        <p class="notice notice-danger" role="alert">
          {t(
            "This invoice cannot be shown because its stored details are damaged."
          )}
        </p>
      ) : (
        <p class="resident-line resident-ok">
          <Icon name="circle-check" size="lg" />
          {t("This bill is paid. No payment is needed.")}
        </p>
      )}
      <dl class="resident-facts">
        <div>
          <dt>{t("Invoice total due")}</dt>
          <dd>{formatMoney(invoice.amountDue, invoice.currency, locale)}</dd>
        </div>
        <div>
          <dt>{t("Paid so far")}</dt>
          <dd>{formatMoney(paidAmount, invoice.currency, locale)}</dd>
        </div>
      </dl>
    </section>
    <section aria-labelledby="invoice-document-heading">
      <div class="resident-row mb-4">
        <h2 id="invoice-document-heading">{t("Invoice document")}</h2>
        <div class="resident-row">
          <button
            type="button"
            class="btn-secondary no-print"
            id="print-invoice"
          >
            {t("Print")}
          </button>
          {invoice.pdfObjectKey && (
            <a href={pdfHref} target="_blank" class="btn-secondary">
              <Icon name="download" />
              {t("Download PDF")}
            </a>
          )}
        </div>
      </div>
      <div class="invoice-doc-locale-bar">
        <p class="resident-muted">
          {t(
            "Latvian is the canonical invoice document. English and Russian are optional translated copies of the same invoice — not separate invoices."
          )}
        </p>
        <form method="GET" class="invoice-doc-locale-form">
          <input type="hidden" name="dwellingId" value={dwellingId} />
          <label for="doc-locale-select" class="text-sm text-muted">
            {t("Document language")}
          </label>
          <select
            id="doc-locale-select"
            name="docLocale"
            class="invoice-doc-locale-select"
          >
            {INVOICE_LOCALES.map((l) => (
              <option value={l} selected={l === docLocale}>
                {localeNames[l]}
              </option>
            ))}
          </select>
          <button type="submit" class="btn-secondary btn-sm">
            {t("Preview")}
          </button>
        </form>
      </div>

      <div class="invoice-preview-frame-wrap">
        <iframe
          id="invoice-preview-frame"
          class="invoice-preview-frame"
          title={t("Invoice")}
          srcdoc={invoiceHtml}
        ></iframe>
      </div>
    </section>
  </div>
</ResidentLayout>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "[data-copy-value]"
  )) {
    if (!navigator.clipboard?.writeText) continue;
    button.hidden = false;
    const label = button.querySelector("span")!;
    const copyLabel = label.textContent;
    let reset: ReturnType<typeof setTimeout> | undefined;
    button.addEventListener("click", async () => {
      const status = document.querySelector<HTMLElement>("[data-copy-status]")!;
      try {
        await navigator.clipboard.writeText(button.dataset.copyValue!);
        status.textContent = status.dataset.copied!;
        // The button itself confirms, next to the value that was copied.
        button.toggleAttribute("data-copied", true);
        label.textContent = button.dataset.copiedLabel!;
        clearTimeout(reset);
        reset = setTimeout(() => {
          button.removeAttribute("data-copied");
          label.textContent = copyLabel;
        }, 2000);
      } catch {
        status.textContent = status.dataset.copyFailed!;
      }
    });
  }
  document.querySelector("#print-invoice")?.addEventListener("click", () => {
    const frame = document.querySelector<HTMLIFrameElement>(
      "#invoice-preview-frame"
    );
    frame?.contentWindow?.print();
  });
</script>

<style>
  .invoice-doc-locale-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .invoice-doc-locale-form {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .invoice-doc-locale-select {
    padding: 0.3rem 0.5rem;
    font-size: var(--text-base);
    border-radius: var(--radius-control);
    background-color: var(--color-surface);
    color: var(--color-foreground);
  }
  .invoice-preview-frame-wrap {
    background: var(--color-surface-hover);
    border-radius: var(--radius-panel);
    padding: 1rem;
  }
  .invoice-preview-frame {
    display: block;
    width: 100%;
    height: 70vh;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
  }
  .invoice-doc-locale-select {
    padding-inline-end: 2.25rem;
  }
</style>
