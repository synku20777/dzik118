---
import StatusBadge from "../../../components/ui/StatusBadge.astro";
import { translate, uiLocale } from "../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
import ResidentLayout from "../../../layouts/ResidentLayout.astro";
import {
  ForbiddenError,
  requireDwellingAccess,
} from "../../../domain/authorization/guards";
import { getInvoiceForResident } from "../../../domain/billing/generation";
import { renderInvoiceHtml } from "../../../domain/billing/invoice-html";
import { withRequestDb } from "../../../lib/db-request";

const invoiceId = Astro.params.invoiceId!;
const dwellingId = Astro.url.searchParams.get("dwellingId");
if (!dwellingId) {
  return Astro.redirect("/portal/dwellings");
}

try {
  requireDwellingAccess(Astro.locals.auth, dwellingId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

let invoice: Awaited<ReturnType<typeof getInvoiceForResident>>["invoice"];
let lines: Awaited<ReturnType<typeof getInvoiceForResident>>["lines"];
let caseStatus: Awaited<ReturnType<typeof getInvoiceForResident>>["caseStatus"];
try {
  ({ invoice, lines, caseStatus } = await withRequestDb((db) =>
    getInvoiceForResident(db, invoiceId, dwellingId)
  ));
} catch {
  return Astro.redirect(`/portal/dwellings/${dwellingId}/invoices`);
}
const invoiceHtml = renderInvoiceHtml(invoice, lines);
---

<ResidentLayout title={invoice.invoiceNumber}>
  <div class="mx-auto max-w-3xl p-6">
    <div class="space-y-6">
      <a
        href={`/portal/dwellings/${dwellingId}/invoices`}
        class="text-sm text-muted hover:underline"
      >
        ← {t("Invoices")}
      </a>

      <div class="flex flex-wrap items-center justify-between gap-4">
        <h1 class="text-xl font-bold text-foreground">
          {invoice.invoiceNumber}
          <span class="ml-2 text-sm font-normal text-muted">
            <StatusBadge status={caseStatus} />
          </span>
        </h1>
        <button type="button" class="btn-secondary no-print" id="print-invoice"
          >{t("Print")}</button
        >
        {
          invoice.pdfObjectKey && (
            <a
              href={`/api/v1/portal/invoices/${invoiceId}/pdf?dwellingId=${dwellingId}`}
              target="_blank"
              class="rounded-control border border-border px-4 py-2 text-sm text-foreground hover:bg-surface-hover"
            >
              {t("Download PDF")}
            </a>
          )
        }
      </div>

      <div class="invoice-preview-frame-wrap">
        <iframe
          id="invoice-preview-frame"
          class="invoice-preview-frame"
          title={t("Invoice")}
          srcdoc={invoiceHtml}></iframe>
      </div>
    </div>
  </div>
</ResidentLayout>

<script>
  document.querySelector("#print-invoice")?.addEventListener("click", () => {
    const frame = document.querySelector<HTMLIFrameElement>(
      "#invoice-preview-frame"
    );
    frame?.contentWindow?.print();
  });
</script>

<style>
  .invoice-preview-frame-wrap {
    background: var(--color-surface-hover);
    border-radius: var(--radius-panel);
    padding: 1rem;
  }
  .invoice-preview-frame {
    display: block;
    width: 100%;
    height: 70vh;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
  }
</style>
