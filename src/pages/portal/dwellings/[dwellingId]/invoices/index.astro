---
import {
  translate,
  uiLocale,
  formatMoney,
  formatDate,
} from "../../../../../lib/ui/i18n";
import StatusBadge from "../../../../../components/ui/StatusBadge.astro";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
import ResidentLayout from "../../../../../layouts/ResidentLayout.astro";
import {
  ForbiddenError,
  requireDwellingAccess,
} from "../../../../../domain/authorization/guards";
import { getDwellingForResident } from "../../../../../domain/organizations/dwellings";
import { listInvoicesForDwelling } from "../../../../../domain/billing/generation";
import { withRequestDb } from "../../../../../lib/db-request";

const dwellingId = Astro.params.dwellingId!;
try {
  requireDwellingAccess(Astro.locals.auth, dwellingId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

let dwelling: Awaited<ReturnType<typeof getDwellingForResident>>;
try {
  dwelling = await withRequestDb((db) =>
    getDwellingForResident(db, dwellingId)
  );
} catch {
  return Astro.redirect("/portal/dwellings");
}

const rawInvoices = await withRequestDb((db) =>
  listInvoicesForDwelling(db, dwellingId)
);
const invoiceList = [...rawInvoices].sort((a, b) =>
  b.issueDate.localeCompare(a.issueDate)
);
---

<ResidentLayout title={`Invoices - Dwelling ${dwelling.number}`}>
  <div class="mx-auto max-w-2xl p-6">
    <div class="space-y-6">
      <a
        href={`/portal/dwellings/${dwellingId}`}
        class="text-sm text-muted hover:underline"
      >
        ← {t("Dashboard")}
      </a>

      <h1 class="text-xl font-bold text-foreground">
        Invoices for dwelling {dwelling.number}
      </h1>

      {
        invoiceList.length === 0 ? (
          <p class="text-sm text-muted">{t("No invoices yet.")}</p>
        ) : (
          <div class="invoice-list">
            {invoiceList.map((invoice) => (
              <a
                href={`/portal/invoices/${invoice.id}?dwellingId=${dwellingId}`}
                class="block rounded-panel border border-border bg-surface p-4 hover:border-muted hover:bg-surface-hover"
              >
                <div class="flex items-center justify-between">
                  <span class="font-medium text-foreground">
                    {invoice.invoiceNumber}
                  </span>
                  <StatusBadge status={invoice.caseStatus} />
                </div>
                <div class="mt-2 flex items-center justify-between text-sm text-muted">
                  <span>
                    {t("Due date")}: {formatDate(invoice.dueDate, locale)}
                  </span>
                  <span class="font-semibold text-foreground">
                    {formatMoney(invoice.amountDue, invoice.currency, locale)}
                  </span>
                </div>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</ResidentLayout>
