---
import StatusBadge from "../../../../../components/ui/StatusBadge.astro";
import { translate, uiLocale, formatDate } from "../../../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
import ResidentLayout from "../../../../../layouts/ResidentLayout.astro";
import { actions } from "astro:actions";
import {
  ForbiddenError,
  requireDwellingAccess,
} from "../../../../../domain/authorization/guards";
import { getDwellingForResident } from "../../../../../domain/organizations/dwellings";
import { listConversationsWithMessagesForDwelling } from "../../../../../domain/messaging/conversations";
import { withRequestDb } from "../../../../../lib/db-request";

const dwellingId = Astro.params.dwellingId!;
try {
  requireDwellingAccess(Astro.locals.auth, dwellingId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const createResult = Astro.getActionResult(actions.messages.createConversation);
const replyResult = Astro.getActionResult(actions.messages.reply);
// Post-redirect-get after a successful mutation: without this, the POST
// response itself is what's rendered, so a browser refresh/resubmit of
// that response would resend the create/reply action a second time.
if (
  (createResult && !createResult.error) ||
  (replyResult && !replyResult.error)
) {
  return Astro.redirect(Astro.url.pathname);
}

let dwelling: Awaited<ReturnType<typeof getDwellingForResident>>;
try {
  dwelling = await withRequestDb((db) =>
    getDwellingForResident(db, dwellingId)
  );
} catch {
  return Astro.redirect("/portal/dwellings");
}

const conversations = await withRequestDb((db) =>
  listConversationsWithMessagesForDwelling(db, dwellingId)
);
---

<ResidentLayout title={`Messages - Dwelling ${dwelling.number}`}>
  <div class="mx-auto max-w-2xl p-6">
    <div class="space-y-6">
      <a
        href={`/portal/dwellings/${dwellingId}`}
        class="text-sm text-muted hover:underline"
      >
        ← {t("Dwelling")}
        {dwelling.number}
      </a>

      <h1 class="text-xl font-bold text-foreground">{t("Messages")}</h1>

      {
        createResult?.error && (
          <p class="rounded-control bg-danger-surface p-3 text-sm text-destructive">
            {createResult.error.message}
          </p>
        )
      }
      {
        replyResult?.error && (
          <p class="rounded-control bg-danger-surface p-3 text-sm text-destructive">
            {replyResult.error.message}
          </p>
        )
      }

      <section class="rounded-panel border border-border bg-surface p-4">
        <h2 class="text-base font-semibold text-foreground">
          {t("New message")}
        </h2>
        <form
          method="POST"
          action={actions.messages.createConversation}
          class="mt-4 space-y-4"
        >
          <input type="hidden" name="dwellingId" value={dwellingId} />
          <div>
            <label
              for="subject"
              class="block text-sm font-medium text-foreground"
            >
              {t("Subject")}
            </label>
            <input
              id="subject"
              name="subject"
              type="text"
              required
              placeholder="What's this about?"
              class="mt-1 w-full rounded-control border border-border px-3 py-2 text-sm"
            />
          </div>
          <div>
            <label for="body" class="block text-sm font-medium text-foreground">
              {t("Message")}
            </label>
            <textarea
              id="body"
              name="body"
              required
              rows="3"
              class="mt-1 w-full rounded-control border border-border px-3 py-2 text-sm"
            ></textarea>
          </div>
          <button type="submit" class="btn-primary w-full sm:w-auto">
            {t("Send")}
          </button>
        </form>
      </section>

      {
        conversations.length === 0 ? (
          <p class="text-sm text-muted">{t("No conversations yet.")}</p>
        ) : (
          conversations.map(({ conversation, messages }) => (
            <section class="rounded-panel border border-border bg-surface p-4">
              <div class="flex items-center justify-between">
                <h3 class="font-medium text-foreground">
                  {conversation.subject}
                </h3>
                <StatusBadge status={conversation.status} />
              </div>

              <div class="mt-3 space-y-2">
                {messages.map((message) => (
                  <div class="rounded-control bg-surface-hover p-3">
                    <p class="whitespace-pre-wrap break-words text-sm text-foreground">
                      {message.body}
                    </p>
                    <p class="mt-1 text-xs text-muted">
                      {formatDate(message.createdAt, locale)}
                    </p>
                  </div>
                ))}
              </div>

              {conversation.status !== "RESOLVED" ? (
                <form
                  method="POST"
                  action={actions.messages.reply}
                  class="mt-3 space-y-2"
                >
                  <input
                    type="hidden"
                    name="conversationId"
                    value={conversation.id}
                  />
                  <textarea
                    aria-label={t("Reply")}
                    name="body"
                    required
                    rows="2"
                    class="mt-1 w-full rounded-control border border-border px-3 py-2 text-sm"
                  />
                  <button type="submit" class="btn-primary w-full sm:w-auto">
                    {t("Reply")}
                  </button>
                </form>
              ) : (
                <p class="mt-2 text-xs text-muted">
                  {t("This conversation is resolved.")}
                </p>
              )}
            </section>
          ))
        )
      }
    </div>
  </div>
</ResidentLayout>
