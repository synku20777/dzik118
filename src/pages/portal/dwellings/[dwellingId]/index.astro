---
import ResidentLayout from "../../../../layouts/ResidentLayout.astro";
import { actions } from "astro:actions";
import {
  ForbiddenError,
  requireDwellingAccess,
} from "../../../../domain/authorization/guards";
import { meterTypeEnum } from "../../../../db/schema/dwellings";
import { getDwellingForResident } from "../../../../domain/organizations/dwellings";
import { getOrganization } from "../../../../domain/organizations/organizations";
import { getCurrentOpenPeriod } from "../../../../domain/periods/periods";
import { orgLocalDateString } from "../../../../lib/org-time";
import {
  listConsumptionHistoryForDwelling,
  listMetersWithReadingForPeriod,
} from "../../../../domain/periods/cases";
import {
  getInvoiceForDwellingPeriod,
  listInvoicesForDwelling,
} from "../../../../domain/billing/generation";
import { withRequestDb } from "../../../../lib/db-request";
import PageHeader from "../../../../components/ui/PageHeader.astro";
import StatusBadge from "../../../../components/ui/StatusBadge.astro";
import EmptyState from "../../../../components/ui/EmptyState.astro";
import {
  translate,
  uiLocale,
  formatMoney,
  formatDate,
  formatNumber,
  formatPeriod,
  entityLabel,
  friendlyActionErrorMessage,
} from "../../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);

const dwellingId = Astro.params.dwellingId!;
try {
  requireDwellingAccess(Astro.locals.auth, dwellingId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

let dwelling: Awaited<ReturnType<typeof getDwellingForResident>>;
try {
  dwelling = await withRequestDb((db) =>
    getDwellingForResident(db, dwellingId)
  );
} catch {
  return Astro.redirect("/portal/dwellings");
}

const {
  period,
  meters,
  currentInvoice,
  groupedHistory,
  recentInvoices,
  timezone,
} = await withRequestDb(async (db) => {
  const { timezone } = await getOrganization(db, dwelling.organizationId);
  const period = await getCurrentOpenPeriod(db, dwelling.organizationId);
  const meters = period
    ? await listMetersWithReadingForPeriod(
        db,
        dwelling.organizationId,
        dwellingId,
        period.id
      )
    : [];
  const currentInvoice = period
    ? await getInvoiceForDwellingPeriod(db, dwellingId, period.id)
    : null;
  const groupedHistory = await listConsumptionHistoryForDwelling(
    db,
    dwellingId
  );
  const allInvoices = await listInvoicesForDwelling(db, dwellingId);
  return {
    period,
    meters,
    currentInvoice,
    groupedHistory,
    recentInvoices: [...allInvoices].reverse().slice(0, 3),
    timezone,
  };
});

const submitResult = Astro.getActionResult(actions.readings.residentSubmit);
// Same rule as the server (readings.ts): the deadline date is inclusive and
// ends at midnight in the organization timezone.
const deadlinePassed = period?.readingDeadline
  ? orgLocalDateString(new Date(), timezone) > period.readingDeadline
  : false;
const activeMeters = meters.filter((m) => !m.archivedAt);
// One column per meter type and unit that has any reading. The rows arrive
// sorted by type, so the columns keep the same order in every period.
const historyColumns = groupedHistory
  .flatMap((row) => row.readings)
  .filter(
    (r, i, all) =>
      all.findIndex((x) => x.meterType === r.meterType && x.unit === r.unit) ===
      i
  )
  .sort(
    (a, b) =>
      meterTypeEnum.enumValues.indexOf(a.meterType) -
        meterTypeEnum.enumValues.indexOf(b.meterType) ||
      a.unit.localeCompare(b.unit)
  );
const base = "/portal/dwellings/" + dwellingId;
---

<ResidentLayout title={t("Dwelling") + " " + dwelling.number}>
  <div class="space-y-7">
    {
      (Astro.locals.auth?.dwellingIds.length ?? 0) > 1 && (
        <a class="text-sm text-primary" href="/portal/dwellings">
          ← {t("Your dwellings")}
        </a>
      )
    }
    <PageHeader
      accent
      title={t("Dwelling") + " " + dwelling.number}
      eyebrow={t("Resident portal")}
      description={dwelling.billingAddress ??
        t("Your billing, readings and messages in one place.")}
    />
    {
      period && (
        <p class="text-sm font-semibold">
          {formatPeriod(period.year, period.month, locale)}
        </p>
      )
    }
    {
      currentInvoice ? (
        <section
          class="current-invoice"
          data-paid={currentInvoice.caseStatus === "PAID" ? "true" : "false"}
        >
          <>
            <div class="flex items-center justify-between gap-3">
              <>
                <h2 class="text-sm text-muted">{t("Current bill")}</h2>
                <StatusBadge status={currentInvoice.caseStatus} />
              </>
            </div>
            <p class="amount mt-4">
              {formatMoney(
                currentInvoice.outstandingAmount,
                currentInvoice.currency,
                locale
              )}
            </p>
            <p class="mt-2 text-sm text-muted">
              {currentInvoice.invoiceNumber}
            </p>
            {currentInvoice.previousOutstanding !== "0.00" && (
              <p class="mt-2 text-sm">
                {t("Previous balance")}:{" "}
                {formatMoney(
                  currentInvoice.previousOutstanding,
                  currentInvoice.currency,
                  locale
                )}
              </p>
            )}
            {currentInvoice.previousCreditApplied !== "0.00" && (
              <p class="mt-2 text-sm">
                {t("Credit applied")}: −
                {formatMoney(
                  currentInvoice.previousCreditApplied,
                  currentInvoice.currency,
                  locale
                )}
              </p>
            )}
            {currentInvoice.lateFeeApplied !== "0.00" && (
              <p class="mt-2 text-sm">
                {t("Late fee")}:{" "}
                {formatMoney(
                  currentInvoice.lateFeeApplied,
                  currentInvoice.currency,
                  locale
                )}
              </p>
            )}
            {currentInvoice.remainingCredit !== "0.00" && (
              <p class="mt-2 text-sm text-success">
                {t("Account credit")}:{" "}
                {formatMoney(
                  currentInvoice.remainingCredit,
                  currentInvoice.currency,
                  locale
                )}
              </p>
            )}
            <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
              <>
                <p class="text-sm">
                  {t("Due date")}:{" "}
                  <strong>{formatDate(currentInvoice.dueDate, locale)}</strong>
                </p>
                <a
                  class={
                    currentInvoice.caseStatus === "PAID"
                      ? "btn-secondary"
                      : "btn-primary"
                  }
                  href={
                    "/portal/invoices/" +
                    currentInvoice.id +
                    "?dwellingId=" +
                    dwellingId
                  }
                >
                  {t("Review invoice")} →
                </a>
              </>
            </div>
          </>
        </section>
      ) : (
        <EmptyState title={t("No current invoice yet.")} />
      )
    }
    {
      period && (
        <section>
          <h2 class="section-title">{t("Meter readings")}</h2>
          {submitResult?.error && (
            <p role="alert" class="notice notice-danger mb-4">
              {friendlyActionErrorMessage(submitResult.error, locale)}
            </p>
          )}
          {submitResult?.data && (
            <p role="status" class="notice mb-4">
              {t("Reading received")}
            </p>
          )}
          {deadlinePassed && (
            <p class="notice notice-warning mb-4">
              {t(
                "The reading deadline has passed. Contact your administrator."
              )}
            </p>
          )}
          <div class="panel divide-y divide-border">
            {activeMeters.map((meter) => (
              <section class="p-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <h3 class="text-sm font-semibold">
                    {meter.label || entityLabel(meter.type, locale)}
                  </h3>
                  {meter.currentValue !== null && (
                    <span class="status-badge" data-tone="success">
                      ✓ {t("Reading received")}
                    </span>
                  )}
                </div>
                {meter.serialNumber && (
                  <p class="mt-1 text-xs text-muted">{meter.serialNumber}</p>
                )}
                {meter.currentValue !== null ? (
                  <p class="mt-3 text-sm">
                    <strong class="tabular-nums">
                      {formatNumber(meter.currentValue, locale)} {meter.unit}
                    </strong>
                    <span class="ml-2 text-muted">
                      · {meter.source && entityLabel(meter.source, locale)}
                    </span>
                  </p>
                ) : (
                  !deadlinePassed && (
                    <form
                      method="POST"
                      action={actions.readings.residentSubmit}
                      class="mt-4"
                    >
                      <input
                        type="hidden"
                        name="dwellingId"
                        value={dwellingId}
                      />
                      <input type="hidden" name="periodId" value={period.id} />
                      <input
                        type="hidden"
                        name="meterId"
                        value={meter.meterId}
                      />
                      <label
                        class="block text-sm font-medium"
                        for={"reading-" + meter.meterId}
                      >
                        {t("Current value")} ({meter.unit})
                      </label>
                      <div class="mt-2 flex flex-col gap-3 sm:flex-row">
                        <input
                          id={"reading-" + meter.meterId}
                          name="currentValue"
                          type="text"
                          inputmode="decimal"
                          pattern="\d+(\.\d{1,3})?"
                          required
                          placeholder="0.000"
                          aria-describedby={"reading-help-" + meter.meterId}
                          class="w-full rounded-control border border-border px-3 py-2 sm:w-48"
                        />
                        <button type="submit" class="btn-primary">
                          {t("Submit reading")}
                        </button>
                      </div>
                      <p
                        id={"reading-help-" + meter.meterId}
                        class="mt-2 text-xs text-muted"
                      >
                        {t(
                          "Use a decimal point and up to three decimal places."
                        )}
                      </p>
                    </form>
                  )
                )}
              </section>
            ))}
          </div>
          {activeMeters.length === 0 && (
            <p class="text-sm text-muted">
              {t("No active meters for this dwelling.")}
            </p>
          )}
        </section>
      )
    }
    <section>
      <h2 class="section-title">{t("Consumption history")}</h2>{
        groupedHistory.length === 0 ? (
          <p class="text-sm text-muted">{t("No consumption history yet.")}</p>
        ) : (
          <div class="table-wrap stack-table">
            <table class="w-full text-sm">
              <caption class="sr-only">{t("Consumption history")}</caption>
              <>
                <thead>
                  <tr>
                    <>
                      <th scope="col" class="text-left">
                        {t("Period")}
                      </th>
                      {historyColumns.map((column) => (
                        <th scope="col" class="text-right">
                          {entityLabel(column.meterType, locale)} ({column.unit}
                          )
                        </th>
                      ))}
                    </>
                  </tr>
                </thead>
                <tbody class="divide-y divide-border">
                  {groupedHistory.map((row) => (
                    <tr>
                      <td>{formatPeriod(row.year, row.month, locale)}</td>
                      {historyColumns.map((column) => {
                        const reading = row.readings.find(
                          (r) =>
                            r.meterType === column.meterType &&
                            r.unit === column.unit
                        );
                        return (
                          <td class="text-right">
                            {reading
                              ? formatNumber(reading.consumption, locale)
                              : "—"}
                          </td>
                        );
                      })}
                    </tr>
                  ))}
                </tbody>
              </>
            </table>
          </div>
        )
      }
    </section>
    <a class="btn-secondary w-full justify-between" href={base + "/payments"}
      >{t("Payment history")} <span aria-hidden="true">→</span></a
    >
    <a class="btn-secondary w-full justify-between" href={base + "/messages"}
      >{t("Contact administrator")} <span aria-hidden="true">→</span></a
    >
    <section>
      <div class="mb-4 flex items-center justify-between">
        <h2 class="font-semibold">{t("Recent invoices")}</h2><a
          class="text-sm text-primary"
          href={base + "/invoices"}>{t("View all")} →</a
        >
      </div>{
        recentInvoices.length === 0 ? (
          <p class="text-sm text-muted">{t("No invoices yet.")}</p>
        ) : (
          <div class="invoice-list">
            {recentInvoices.map((invoice) => (
              <a
                class="block p-4 hover:bg-surface-hover"
                href={
                  "/portal/invoices/" + invoice.id + "?dwellingId=" + dwellingId
                }
              >
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <span class="text-sm font-semibold">
                    {invoice.invoiceNumber}
                  </span>
                  <StatusBadge status={invoice.caseStatus} />
                </div>
                <div class="mt-2 flex flex-wrap justify-between gap-2 text-sm">
                  <span class="text-muted">
                    {t("Due date")}: {formatDate(invoice.dueDate, locale)}
                  </span>
                  <strong>
                    {formatMoney(invoice.amountDue, invoice.currency, locale)}
                  </strong>
                </div>
              </a>
            ))}
          </div>
        )
      }
    </section>
  </div>
</ResidentLayout>
