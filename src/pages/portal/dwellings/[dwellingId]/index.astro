---
import ResidentLayout from "../../../../layouts/ResidentLayout.astro";
import { actions } from "astro:actions";
import {
  ForbiddenError,
  requireDwellingAccess,
} from "../../../../domain/authorization/guards";
import { meterTypeEnum } from "../../../../db/schema/dwellings";
import { getDwellingForResident } from "../../../../domain/organizations/dwellings";
import { getOrganization } from "../../../../domain/organizations/organizations";
import { getCurrentOpenPeriod } from "../../../../domain/periods/periods";
import { orgLocalDateString } from "../../../../lib/org-time";
import {
  listConsumptionHistoryForDwelling,
  listMetersWithReadingForPeriod,
} from "../../../../domain/periods/cases";
import {
  getInvoiceForResident,
  listInvoicesForDwelling,
} from "../../../../domain/billing/generation";
import { withRequestDb } from "../../../../lib/db-request";
import { rethrowUnexpected } from "../../../../domain/errors";
import Icon from "../../../../components/ui/Icon.astro";
import { findPreviousValues } from "../../../../domain/periods/readings";
import readingsSource from "../../../../domain/periods/readings.ts?raw";
import { errorTranslations } from "../../../../lib/ui/error-translations";
import StatusBadge from "../../../../components/ui/StatusBadge.astro";
import InvoiceList from "../../../../components/ui/ResidentInvoiceList.astro";
import { METER_ICONS } from "../../../../lib/ui/icons";
import { unitLabel } from "../../../../lib/ui/units";
import {
  translate,
  uiLocale,
  formatMoney,
  formatDate,
  formatNumber,
  formatPeriod,
  entityLabel,
  friendlyActionErrorMessage,
} from "../../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);

const dwellingId = Astro.params.dwellingId!;
try {
  requireDwellingAccess(Astro.locals.auth, dwellingId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

let dwelling: Awaited<ReturnType<typeof getDwellingForResident>>;
try {
  dwelling = await withRequestDb((db) =>
    getDwellingForResident(db, dwellingId)
  );
} catch (err) {
  rethrowUnexpected(err);
  return Astro.redirect("/portal/dwellings");
}

const {
  period,
  meters,
  latestBill,
  groupedHistory,
  recentInvoices,
  timezone,
  previousValues,
} = await withRequestDb(async (db) => {
  const { timezone } = await getOrganization(db, dwelling.organizationId);
  const period = await getCurrentOpenPeriod(db, dwelling.organizationId);
  const meters = period
    ? await listMetersWithReadingForPeriod(
        db,
        dwelling.organizationId,
        dwellingId,
        period.id
      )
    : [];
  const previousValues = period
    ? await findPreviousValues(
        db,
        meters.map((meter) => meter.meterId),
        period
      )
    : new Map<string, string>();
  const allInvoices = await listInvoicesForDwelling(db, dwellingId);
  const recentInvoices = [...allInvoices].reverse().slice(0, 3);
  const latestBill = recentInvoices[0]
    ? await getInvoiceForResident(db, recentInvoices[0].id, dwellingId)
    : null;
  return {
    period,
    meters,
    latestBill,
    previousValues,
    recentInvoices,
    timezone,
    groupedHistory: (
      await listConsumptionHistoryForDwelling(db, dwellingId)
    ).filter(
      (row) => !period || row.year !== period.year || row.month !== period.month
    ),
  };
});

const submitResult = Astro.getActionResult(actions.readings.residentSubmit);
if (submitResult?.data) return Astro.redirect(Astro.url.pathname + "#readings");
let submitted: FormData | null = null;
if (submitResult?.error) {
  try {
    submitted = await Astro.request.formData();
  } catch {
    submitted = null;
  }
}
const readingErrors = errorTranslations([readingsSource], locale, [
  "Enter a valid meter reading, for example 123.456. Use up to 3 decimal places.",
]);
// Same rule as the server (readings.ts): the deadline date is inclusive and
// ends at midnight in the organization timezone.
const deadlinePassed = period?.readingDeadline
  ? orgLocalDateString(new Date(), timezone) > period.readingDeadline
  : false;
const activeMeters = meters.filter((m) => !m.archivedAt);
const missingReadings = activeMeters.filter(
  (m) => m.currentValue === null
).length;
// One column per meter type and unit that has any reading. The rows arrive
// sorted by type, so the columns keep the same order in every period.
const historyColumns = groupedHistory
  .flatMap((row) => row.readings)
  .filter(
    (r, i, all) =>
      all.findIndex((x) => x.meterType === r.meterType && x.unit === r.unit) ===
      i
  )
  .sort(
    (a, b) =>
      meterTypeEnum.enumValues.indexOf(a.meterType) -
        meterTypeEnum.enumValues.indexOf(b.meterType) ||
      a.unit.localeCompare(b.unit)
  );
const base = "/portal/dwellings/" + dwellingId;
const billPaid = latestBill?.remainingAmount === "0.00";
const canSubmit = !deadlinePassed && missingReadings > 0;
---

<ResidentLayout title={t("Dwelling") + " " + dwelling.number}>
  <div>
    {(Astro.locals.auth?.dwellingIds.length ?? 0) > 1 && (
      <a class="resident-back" href="/portal/dwellings">
        <Icon name="arrow-left" />
        {t("Your dwellings")}
      </a>
    )}
    <header class="resident-title">
      <h1 class="font-display">
        {t("Dwelling")} {dwelling.number}
      </h1>
      <p>{dwelling.billingAddress}</p>
    </header>

    <section class="resident-section" aria-labelledby="bill-heading">
      <div class="resident-row">
        <h2 id="bill-heading">{t("Latest bill")}</h2>
        {latestBill && <StatusBadge status={latestBill.caseStatus} />}
      </div>
      {latestBill ? (
        <>
          <div hidden={billPaid}>
            <p class="resident-amount">
              {formatMoney(
                latestBill.remainingAmount,
                latestBill.invoice.currency,
                locale
              )}
            </p>
            <p>
              {t("Amount still due")} · {t("Due date")}:{" "}
              <strong>{formatDate(latestBill.invoice.dueDate, locale)}</strong>
            </p>
          </div>
          {billPaid && (
            <p class="resident-line resident-ok">
              <Icon name="circle-check" size="lg" />
              {t("This bill is paid. No payment is needed.")}
            </p>
          )}
          <div class="resident-row">
            <a
              class={billPaid ? "btn-secondary" : "btn-primary"}
              href={`/portal/invoices/${latestBill.invoice.id}?dwellingId=${dwellingId}`}
            >
              {t(billPaid ? "View invoice" : "How to pay")}
              <Icon name="arrow-right" />
            </a>
            <p class="resident-muted">{latestBill.invoice.invoiceNumber}</p>
          </div>
        </>
      ) : (
        <p>{t("No current invoice yet.")}</p>
      )}
    </section>

    <section
      id="readings"
      class="resident-section"
      aria-labelledby="readings-heading"
      data-reading-errors={JSON.stringify(readingErrors)}
    >
      <div class="resident-row">
        <h2 id="readings-heading">{t("Meter readings")}</h2>
        {period && (
          <p class="resident-line">
            <Icon name="calendar-month" />
            <strong>{formatPeriod(period.year, period.month, locale)}</strong>
          </p>
        )}
      </div>
      {period ? (
        <>
          {activeMeters.length > 0 && (
            <p
              class="resident-line resident-ok"
              data-all-readings
              hidden={missingReadings > 0}
              role="status"
            >
              <Icon name="circle-check" size="lg" />
              {t("All readings received for this month.")}
            </p>
          )}
          {period.readingDeadline && missingReadings > 0 && (
            <p class="resident-line" data-reading-deadline>
              <Icon name="clock" />
              <span>
                {t("Reading deadline")}:{" "}
                <strong>{formatDate(period.readingDeadline, locale)}</strong>
              </span>
            </p>
          )}
          {deadlinePassed && missingReadings > 0 && (
            <p class="notice notice-warning">
              {t(
                "The reading deadline has passed. Contact your administrator."
              )}
            </p>
          )}
          {submitResult?.error && (
            <p role="alert" class="notice notice-danger">
              {friendlyActionErrorMessage(submitResult.error, locale)}
            </p>
          )}
          {canSubmit && (
            <p id="reading-help" class="resident-line resident-hint">
              <Icon name="info-circle" />
              {t(
                "Enter the full number on the meter, not the amount used. You can use a comma or a decimal point, with up to 3 decimal places."
              )}
            </p>
          )}
          {activeMeters.map((meter) => {
            const name = meter.label || entityLabel(meter.type, locale);
            const unit = unitLabel(meter.unit, locale);
            return (
              <section
                class="resident-meter"
                aria-labelledby={`meter-title-${meter.meterId}`}
              >
                <span class="resident-meter-icon" data-meter={meter.type}>
                  <Icon name={METER_ICONS[meter.type] ?? "tool"} size="lg" />
                </span>
                <div>
                  <h3 id={`meter-title-${meter.meterId}`}>{name}</h3>
                  <p class="resident-meter-facts">
                    {meter.serialNumber && (
                      <span>
                        {t("Serial number")}: {meter.serialNumber}
                      </span>
                    )}
                    {previousValues.has(meter.meterId) && (
                      <span>
                        {t("Previous reading")}:{" "}
                        <strong>
                          {formatNumber(
                            previousValues.get(meter.meterId)!,
                            locale
                          )}{" "}
                          {unit}
                        </strong>
                      </span>
                    )}
                  </p>
                </div>
                <div
                  data-reading-received
                  hidden={meter.currentValue === null}
                  role="status"
                  tabindex="-1"
                >
                  <p class="resident-meter-figure">
                    <strong data-reading-value>
                      {meter.currentValue !== null &&
                        formatNumber(meter.currentValue, locale)}
                    </strong>{" "}
                    <span>{unit}</span>
                  </p>
                  <p class="resident-meter-state">
                    <Icon name="check" size="sm" />
                    {t("Reading received")}
                  </p>
                  {meter.source === "CARRIED_FORWARD" && (
                    <p class="resident-muted">
                      {entityLabel(meter.source, locale)}
                    </p>
                  )}
                </div>
                {meter.currentValue === null && !deadlinePassed && (
                  <form
                    method="POST"
                    action={actions.readings.residentSubmit}
                    data-resident-reading
                    data-saving={t("Saving…")}
                    data-failed={t(
                      "The reading could not be saved. Check your connection and try again."
                    )}
                  >
                    <input type="hidden" name="dwellingId" value={dwellingId} />
                    <input type="hidden" name="periodId" value={period.id} />
                    <input type="hidden" name="meterId" value={meter.meterId} />
                    <label class="field-label" for={`reading-${meter.meterId}`}>
                      {t("Number shown on the meter")} ({unit})
                    </label>
                    <div class="resident-reading-controls">
                      <input
                        id={`reading-${meter.meterId}`}
                        name="currentValue"
                        type="text"
                        inputmode="decimal"
                        pattern="[0-9]{1,11}([.,][0-9]{1,3})?"
                        required
                        autocomplete="off"
                        value={
                          submitted?.get("meterId") === meter.meterId
                            ? String(submitted.get("currentValue") ?? "")
                            : ""
                        }
                        aria-describedby="reading-help"
                      />
                      <button
                        type="submit"
                        class="btn-primary"
                        aria-label={`${t("Submit reading")}: ${name}`}
                      >
                        {t("Submit reading")}
                      </button>
                    </div>
                  </form>
                )}
              </section>
            );
          })}
          {activeMeters.length === 0 && (
            <p>{t("No active meters for this dwelling.")}</p>
          )}
        </>
      ) : (
        <p>
          {t(
            "There is no open reading period. Contact your administrator if you need to submit a reading."
          )}
        </p>
      )}
      <a class="btn-secondary" href={base + "/messages"}>
        <Icon name="help-circle" />
        {t("Help with readings")}
      </a>
    </section>
    <details class="resident-details">
      <summary>
        {t("Consumption history")}
        <Icon name="chevron-right" size="lg" />
      </summary>
      <div class="resident-details-body">
        {groupedHistory.length === 0 ? (
          <p class="resident-muted">{t("No consumption history yet.")}</p>
        ) : (
          <div class="table-wrap stack-table">
            <table class="w-full text-sm">
              <caption class="sr-only">{t("Consumption history")}</caption>
              <>
                <thead>
                  <tr>
                    <>
                      <th scope="col" class="text-left">
                        {t("Period")}
                      </th>
                      {historyColumns.map((column) => (
                        <th scope="col" class="text-right">
                          {entityLabel(column.meterType, locale)} (
                          {unitLabel(column.unit, locale)})
                        </th>
                      ))}
                    </>
                  </tr>
                </thead>
                <tbody class="divide-y divide-border">
                  {groupedHistory.map((row) => (
                    <tr>
                      <td>{formatPeriod(row.year, row.month, locale)}</td>
                      {historyColumns.map((column) => {
                        const reading = row.readings.find(
                          (r) =>
                            r.meterType === column.meterType &&
                            r.unit === column.unit
                        );
                        return (
                          <td class="text-right">
                            {reading
                              ? formatNumber(reading.consumption, locale)
                              : "—"}
                          </td>
                        );
                      })}
                    </tr>
                  ))}
                </tbody>
              </>
            </table>
          </div>
        )}
      </div>
    </details>
    <details class="resident-details">
      <summary>
        {t("Recent invoices")}
        <Icon name="chevron-right" size="lg" />
      </summary>
      <div class="resident-details-body">
        {recentInvoices.length === 0 ? (
          <p class="resident-muted">{t("No invoices yet.")}</p>
        ) : (
          <>
            <InvoiceList
              invoices={recentInvoices}
              dwellingId={dwellingId}
              locale={locale}
            />
            <a class="btn-secondary" href={base + "/invoices"}>
              {t("All invoices")}
              <Icon name="arrow-right" />
            </a>
          </>
        )}
      </div>
    </details>
  </div>
</ResidentLayout>

<script>
  import { actions } from "astro:actions";
  import { bindMutationForm } from "../../../../lib/ui/mutate-form";
  import { onPageLoad } from "../../../../lib/ui/page-lifecycle";

  onPageLoad(() => {
    const errors: Record<string, string> = JSON.parse(
      document.querySelector<HTMLElement>("[data-reading-errors]")?.dataset
        .readingErrors ?? "{}"
    );
    for (const form of document.querySelectorAll<HTMLFormElement>(
      "[data-resident-reading]"
    )) {
      bindMutationForm({
        form,
        action: actions.readings.residentSubmit,
        savingLabel: form.dataset.saving!,
        fallbackErrorMessage: form.dataset.failed!,
        translateError: (message) => errors[message] ?? message,
        onError: () => {
          const input = form.querySelector<HTMLInputElement>(
            '[name="currentValue"]'
          )!;
          const error = form.previousElementSibling;
          if (error?.classList.contains("form-inline-error")) {
            error.id = input.id + "-error";
            input.setAttribute("aria-invalid", "true");
            input.setAttribute("aria-describedby", `reading-help ${error.id}`);
          }
          input.focus();
        },
        onSuccess: (reading) => {
          const receipt = form
            .closest(".resident-meter")!
            .querySelector<HTMLElement>("[data-reading-received]")!;
          // Intl directly: importing i18n.ts would ship the whole dictionary.
          receipt.querySelector("[data-reading-value]")!.textContent =
            new Intl.NumberFormat(document.documentElement.lang, {
              maximumFractionDigits: 3,
            }).format(Number(reading.currentValue));
          form.remove();
          receipt.hidden = false;
          receipt.classList.add("resident-enter");
          receipt.focus();
          if (!document.querySelector("[data-resident-reading]")) {
            document.querySelector<HTMLElement>("[data-all-readings]")!.hidden =
              false;
            document.getElementById("reading-help")?.remove();
            document.querySelector("[data-reading-deadline]")?.remove();
          }
        },
      });
    }
  });
</script>
