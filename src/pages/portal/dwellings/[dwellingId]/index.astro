---
import ResidentLayout from "../../../../layouts/ResidentLayout.astro";
import { actions } from "astro:actions";
import {
  ForbiddenError,
  requireDwellingAccess,
} from "../../../../domain/authorization/guards";
import { getDwellingForResident } from "../../../../domain/organizations/dwellings";
import { getCurrentOpenPeriod } from "../../../../domain/periods/periods";
import {
  listConsumptionHistoryForDwelling,
  listMetersWithReadingForPeriod,
} from "../../../../domain/periods/cases";
import {
  getInvoiceForDwellingPeriod,
  listInvoicesForDwelling,
} from "../../../../domain/billing/generation";
import { withRequestDb } from "../../../../lib/db-request";
import { invoiceStatusBadge } from "../../../../lib/ui/invoice-status";

const dwellingId = Astro.params.dwellingId!;
try {
  requireDwellingAccess(Astro.locals.auth, dwellingId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

let dwelling: Awaited<ReturnType<typeof getDwellingForResident>>;
try {
  dwelling = await withRequestDb((db) =>
    getDwellingForResident(db, dwellingId)
  );
} catch {
  return Astro.redirect("/portal/dwellings");
}

const { period, meters, currentInvoice, groupedHistory, recentInvoices } =
  await withRequestDb(async (db) => {
    const period = await getCurrentOpenPeriod(db, dwelling.organizationId);
    const meters = period
      ? await listMetersWithReadingForPeriod(
          db,
          dwelling.organizationId,
          dwellingId,
          period.id
        )
      : [];
    const currentInvoice = period
      ? await getInvoiceForDwellingPeriod(db, dwellingId, period.id)
      : null;
    const groupedHistory = await listConsumptionHistoryForDwelling(
      db,
      dwellingId
    );
    const allInvoices = await listInvoicesForDwelling(db, dwellingId);
    return {
      period,
      meters,
      currentInvoice,
      groupedHistory,
      recentInvoices: [...allInvoices].reverse().slice(0, 3),
    };
  });

const submitResult = Astro.getActionResult(actions.readings.residentSubmit);
---

<ResidentLayout title={`Dwelling ${dwelling.number} - Property Billing`}>
  <div class="mx-auto max-w-2xl p-6">
    <div class="space-y-6">
      <a
        href="/portal/dwellings"
        class="text-sm text-neutral-600 hover:underline"
      >
        ← Dwellings
      </a>

      <h1 class="text-xl font-bold text-neutral-900">
        Dwelling {dwelling.number}
      </h1>

      {
        dwelling.billingAddress && (
          <p class="text-sm text-neutral-500">{dwelling.billingAddress}</p>
        )
      }

      {
        !period ? (
          <p class="text-sm text-neutral-600">
            No open billing period right now.
          </p>
        ) : (
          <div>
            <h2 class="text-base font-semibold text-neutral-800">
              Period {period.year}-{String(period.month).padStart(2, "0")}
            </h2>

            {currentInvoice && (
              <a
                href={`/portal/invoices/${currentInvoice.id}?dwellingId=${dwellingId}`}
                class="block rounded-xl border border-neutral-200 bg-white p-4 hover:border-neutral-300 hover:bg-neutral-50"
              >
                <div class="flex items-center justify-between">
                  <span class="font-medium text-neutral-900">
                    {currentInvoice.invoiceNumber}
                  </span>
                  <span
                    class={`rounded-full px-2.5 py-0.5 text-xs font-medium ${invoiceStatusBadge(currentInvoice.caseStatus).className}`}
                  >
                    {invoiceStatusBadge(currentInvoice.caseStatus).label}
                  </span>
                </div>
                <div class="mt-2 flex items-center justify-between text-sm text-neutral-600">
                  <span>Due {currentInvoice.dueDate}</span>
                  <span class="font-semibold text-neutral-900">
                    {currentInvoice.total} {currentInvoice.currency}
                  </span>
                </div>
              </a>
            )}

            {submitResult?.error && (
              <p class="mt-3 rounded-md bg-red-50 p-3 text-sm text-red-800">
                {submitResult.error.message}
              </p>
            )}

            <div class="mt-4 space-y-4">
              {meters
                .filter((meter) => !meter.archivedAt)
                .map((meter) => (
                  <section class="rounded-xl border border-neutral-200 bg-white p-4">
                    <div class="font-medium text-neutral-900">
                      {meter.label || meter.type}
                      {meter.serialNumber && (
                        <span class="text-sm font-normal text-neutral-500">
                          {" "}
                          · {meter.serialNumber}
                        </span>
                      )}
                    </div>

                    {meter.currentValue !== null ? (
                      <p class="mt-2 text-sm text-neutral-600">
                        Reading: {meter.currentValue} ({meter.source})
                      </p>
                    ) : (
                      <form
                        method="POST"
                        action={actions.readings.residentSubmit}
                        class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-center"
                      >
                        <input
                          type="hidden"
                          name="dwellingId"
                          value={dwellingId}
                        />
                        <input
                          type="hidden"
                          name="periodId"
                          value={period.id}
                        />
                        <input
                          type="hidden"
                          name="meterId"
                          value={meter.meterId}
                        />
                        <input
                          name="currentValue"
                          type="text"
                          inputmode="decimal"
                          pattern="\d+(\.\d{1,3})?"
                          required
                          placeholder="0.000"
                          class="w-full rounded-md border border-neutral-300 px-3 py-2 text-sm sm:w-40"
                        />
                        <button
                          type="submit"
                          class="w-full rounded-md bg-neutral-900 px-4 py-2 text-sm font-medium text-white sm:w-auto"
                        >
                          Submit reading
                        </button>
                      </form>
                    )}
                  </section>
                ))}

              {meters.filter((meter) => !meter.archivedAt).length === 0 && (
                <p class="text-sm text-neutral-500">
                  No active meters for this dwelling.
                </p>
              )}
            </div>
          </div>
        )
      }

      <section class="space-y-3 mt-6">
        <h2 class="text-base font-bold text-neutral-900">
          Consumption history
        </h2>
        {
          groupedHistory.length === 0 ? (
            <p class="text-sm text-neutral-500">No consumption history yet.</p>
          ) : (
            <div class="overflow-x-auto rounded-lg border border-neutral-200 bg-white">
              <table class="w-full text-left text-sm">
                <thead class="border-b border-neutral-200 bg-neutral-50 text-neutral-600">
                  <tr>
                    <th class="px-4 py-2">Period</th>
                    <th class="px-4 py-2">Cold water</th>
                    <th class="px-4 py-2">Hot water</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-neutral-100">
                  {groupedHistory.map((row) => (
                    <tr>
                      <td class="px-4 py-2 font-medium">
                        {row.year}-{String(row.month).padStart(2, "0")}
                      </td>
                      <td class="px-4 py-2">
                        {row.coldWaterConsumption ?? "—"}
                      </td>
                      <td class="px-4 py-2">
                        {row.hotWaterConsumption ?? "—"}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }
      </section>

      <section class="space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-base font-bold text-neutral-900">Recent invoices</h2>
          <a
            href={`/portal/dwellings/${dwellingId}/invoices`}
            class="text-sm text-neutral-600 hover:underline"
          >
            View all →
          </a>
        </div>
        {
          recentInvoices.length === 0 ? (
            <p class="text-sm text-neutral-500">No invoices yet.</p>
          ) : (
            <div class="space-y-3">
              {recentInvoices.map((invoice) => (
                <a
                  href={`/portal/invoices/${invoice.id}?dwellingId=${dwellingId}`}
                  class="block rounded-xl border border-neutral-200 bg-white p-4 hover:border-neutral-300 hover:bg-neutral-50"
                >
                  <div class="flex items-center justify-between">
                    <span class="font-medium text-neutral-900">
                      {invoice.invoiceNumber}
                    </span>
                    <span
                      class={`rounded-full px-2.5 py-0.5 text-xs font-medium ${invoiceStatusBadge(invoice.caseStatus).className}`}
                    >
                      {invoiceStatusBadge(invoice.caseStatus).label}
                    </span>
                  </div>
                  <div class="mt-2 flex items-center justify-between text-sm text-neutral-600">
                    <span>Due {invoice.dueDate}</span>
                    <span class="font-semibold text-neutral-900">
                      {invoice.total} {invoice.currency}
                    </span>
                  </div>
                </a>
              ))}
            </div>
          )
        }
      </section>
    </div>
  </div>
</ResidentLayout>
