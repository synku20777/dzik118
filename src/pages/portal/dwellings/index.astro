---
import ResidentLayout from "../../../layouts/ResidentLayout.astro";
import {
  ForbiddenError,
  requireResidentRole,
} from "../../../domain/authorization/guards";
import { getDwellingForResident } from "../../../domain/organizations/dwellings";
import { withRequestDb } from "../../../lib/db-request";

const auth = Astro.locals.auth;
try {
  requireResidentRole(auth);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const dwellings = await withRequestDb((db) =>
  Promise.all(auth.dwellingIds.map((id) => getDwellingForResident(db, id)))
);
---

<ResidentLayout title="Your Dwellings - Property Billing">
  <div class="mx-auto max-w-2xl p-6">
    <div class="space-y-8">
      <section>
        <div class="flex items-center justify-between">
          <h1 class="text-xl font-bold text-neutral-900">Your dwellings</h1>
          <a
            href="/logout"
            class="text-sm text-neutral-600 hover:text-neutral-900 hover:underline"
          >
            Sign out
          </a>
        </div>
        {
          dwellings.length === 0 ? (
            <p class="mt-2 text-sm text-neutral-600">
              You don't have access to any dwellings.
            </p>
          ) : (
            <ul class="mt-4 divide-y divide-neutral-200 rounded-lg border border-neutral-200 bg-white">
              {dwellings.map((dwelling) => (
                <li>
                  <a
                    href={`/portal/dwellings/${dwelling.id}`}
                    class="flex items-center justify-between px-4 py-3 hover:bg-neutral-50"
                  >
                    <span class="font-medium text-neutral-900">
                      {dwelling.number}
                    </span>
                    {dwelling.displayName && (
                      <span class="text-sm text-neutral-500">
                        {dwelling.displayName}
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </section>
    </div>
  </div>
</ResidentLayout>
