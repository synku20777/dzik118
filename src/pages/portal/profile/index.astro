---
import { translate, uiLocale } from "../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
import ResidentLayout from "../../../layouts/ResidentLayout.astro";
import Icon from "../../../components/ui/Icon.astro";
import {
  ForbiddenError,
  requireResidentRole,
} from "../../../domain/authorization/guards";
import { actions } from "astro:actions";
import { friendlyActionErrorMessage } from "../../../lib/ui/i18n";
import { listDwellingsForResident } from "../../../domain/organizations/dwellings";
import { getOwnDisplayName } from "../../../domain/privacy/profile";
import { withRequestDb } from "../../../lib/db-request";

const auth = Astro.locals.auth;
try {
  requireResidentRole(auth);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const nameResult = Astro.getActionResult(actions.profile.updateDisplayName);
// One after the other: one connection runs one query at a time.
const [dwellings, displayName] = await withRequestDb(
  async (db) =>
    [
      await listDwellingsForResident(db, auth.dwellingIds),
      await getOwnDisplayName(db, auth.userId),
    ] as const
);
---

<ResidentLayout title={`${t("Profile")} - ${t("Namkopa")}`}>
  <div>
    <a class="resident-back" href="/portal">
      <Icon name="arrow-left" />
      {t(auth.dwellingIds.length === 1 ? "Home" : "Your dwellings")}
    </a>
    <header class="resident-title">
      <h1 class="font-display">{t("Profile")}</h1>
    </header>

    <section class="resident-section" aria-labelledby="account-heading">
      <h2 id="account-heading">{t("Account")}</h2>
      <p class="resident-line">
        <Icon name="user" />
        <span>
          {auth.email}
          <span class="resident-muted block">{t("Resident")}</span>
        </span>
      </p>
      {nameResult?.error && (
        <p class="notice notice-danger" role="alert">
          {friendlyActionErrorMessage(nameResult.error, locale)}
        </p>
      )}
      {nameResult?.data && (
        <p class="resident-line resident-ok resident-enter" role="status">
          <Icon name="circle-check" size="lg" />
          {t("Saved successfully.")}
        </p>
      )}
      <form method="POST" action={actions.profile.updateDisplayName}>
        <label class="field-label" for="displayName">
          {t("Display name")}
        </label>
        <div class="resident-reading-controls">
          <input
            id="displayName"
            name="displayName"
            maxlength="100"
            required
            autocomplete="name"
            value={nameResult?.data?.displayName ?? displayName ?? ""}
          />
          <button type="submit" class="btn-primary">
            {t("Save")}
          </button>
        </div>
      </form>
    </section>

    <section aria-labelledby="access-heading">
      <h2 id="access-heading" class="mb-3">
        {t("Dwelling access")}
      </h2>
      {dwellings.length === 0 ? (
        <p class="resident-section">{t("No dwellings assigned.")}</p>
      ) : (
        <div class="resident-list">
          {dwellings.map((dwelling) => (
            <a href={`/portal/dwellings/${dwelling.id}`}>
              <span class="resident-list-main">
                <strong>
                  {t("Dwelling")} {dwelling.number}
                </strong>
                {dwelling.displayName && <span>{dwelling.displayName}</span>}
              </span>
              <Icon name="chevron-right" />
            </a>
          ))}
        </div>
      )}
    </section>

    <section class="resident-section" aria-labelledby="data-heading">
      <h2 id="data-heading">{t("Your data")}</h2>
      <p class="resident-muted">
        {t(
          "Download a copy of the data this service holds about you, as a JSON file."
        )}
      </p>
      <a href="/api/v1/portal/me/export" download class="btn-secondary">
        <Icon name="download" />
        {t("Download my data")}
      </a>
    </section>
  </div>
</ResidentLayout>
