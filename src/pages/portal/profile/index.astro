---
import { translate, uiLocale } from "../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
import ResidentLayout from "../../../layouts/ResidentLayout.astro";
import {
  ForbiddenError,
  requireResidentRole,
} from "../../../domain/authorization/guards";
import { actions } from "astro:actions";
import { friendlyActionErrorMessage } from "../../../lib/ui/i18n";
import { listDwellingsForResident } from "../../../domain/organizations/dwellings";
import { getOwnDisplayName } from "../../../domain/privacy/profile";
import { withRequestDb } from "../../../lib/db-request";

const auth = Astro.locals.auth;
try {
  requireResidentRole(auth);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const nameResult = Astro.getActionResult(actions.profile.updateDisplayName);
const [dwellings, displayName] = await withRequestDb((db) =>
  Promise.all([
    listDwellingsForResident(db, auth.dwellingIds),
    getOwnDisplayName(db, auth.userId),
  ])
);
---

<ResidentLayout title={`${t("Profile")} - ${t("Property Billing")}`}>
  <div class="mx-auto max-w-2xl p-6">
    <div class="space-y-6">
      <a href="/portal" class="text-body-sm text-muted hover:underline">
        ← {t("Portal")}
      </a>

      <h1 class="text-h2 text-foreground">{t("Profile")}</h1>

      <section class="rounded-panel border border-border bg-surface p-4">
        <h2 class="text-h3 text-foreground">{t("Account")}</h2>
        <p class="mt-2 text-body-sm text-foreground">{auth.email}</p>
        <p class="mt-1 text-body-sm text-muted">{t("Resident")}</p>
        {
          nameResult?.error && (
            <p class="notice notice-danger mt-3" role="alert">
              {friendlyActionErrorMessage(nameResult.error, locale)}
            </p>
          )
        }
        {
          nameResult?.data && (
            <p class="notice mt-3" role="status">
              {t("Saved successfully.")}
            </p>
          )
        }
        <form
          method="POST"
          action={actions.profile.updateDisplayName}
          class="mt-4"
        >
          <label class="block text-sm font-medium" for="displayName"
            >{t("Display name")}</label
          >
          <div class="mt-2 flex flex-col gap-3 sm:flex-row">
            <input
              id="displayName"
              name="displayName"
              maxlength="100"
              required
              value={nameResult?.data?.displayName ?? displayName ?? ""}
              class="w-full rounded-control border border-border px-3 py-2 sm:w-72"
            />
            <button type="submit" class="btn-primary">{t("Save")}</button>
          </div>
        </form>
      </section>

      <section class="rounded-panel border border-border bg-surface p-4">
        <h2 class="text-h3 text-foreground">
          {t("Dwelling access")}
        </h2>
        {
          dwellings.length === 0 ? (
            <p class="mt-2 text-body-sm text-muted">
              {t("No dwellings assigned.")}
            </p>
          ) : (
            <ul class="mt-4 divide-y divide-border rounded-control border border-border bg-surface">
              {dwellings.map((dwelling) => (
                <li>
                  <a
                    href={`/portal/dwellings/${dwelling.id}`}
                    class="flex items-center justify-between px-4 py-3 hover:bg-surface-hover"
                  >
                    <span class="font-medium text-foreground">
                      {dwelling.number}
                    </span>
                    {dwelling.displayName && (
                      <span class="text-body-sm text-muted">
                        {dwelling.displayName}
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </section>
      <section class="rounded-panel border border-border bg-surface p-4">
        <h2 class="text-h3 text-foreground">{t("Your data")}</h2>
        <p class="mt-2 text-body-sm text-muted">
          {
            t(
              "Download a copy of the data this service holds about you, as a JSON file."
            )
          }
        </p>
        <a
          href="/api/v1/portal/me/export"
          download
          class="btn-secondary mt-4 inline-flex"
        >
          {t("Download my data")}
        </a>
      </section>
      <form method="POST" action="/logout">
        <button type="submit" class="btn-secondary">{t("Sign out")}</button>
      </form>
    </div>
  </div>
</ResidentLayout>
