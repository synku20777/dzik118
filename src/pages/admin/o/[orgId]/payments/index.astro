---
// Phase J (Payments) - payments index (spec Section 25, PAY-003).
import PageHeader from "../../../../../components/ui/PageHeader.astro";
import KpiCard from "../../../../../components/ui/KpiCard.astro";
import StatusBadge from "../../../../../components/ui/StatusBadge.astro";
import EmptyState from "../../../../../components/ui/EmptyState.astro";
import FieldError from "../../../../../components/ui/FieldError.astro";
import { listDwellings } from "../../../../../domain/organizations/dwellings";
import {
  translate,
  uiLocale,
  formatMoney,
  formatDate,
  friendlyActionErrorMessage,
} from "../../../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import { actions } from "astro:actions";
import {
  ForbiddenError,
  requireOrganizationAccess,
} from "../../../../../domain/authorization/guards";
import { getOrganization } from "../../../../../domain/organizations/organizations";
import { listBankImports } from "../../../../../domain/payments/bank-import";
import {
  listPaymentMatches,
  listUnmatchedTransactions,
} from "../../../../../domain/payments/matching";
import { listOpenInvoicesForPayment } from "../../../../../domain/payments/manual";
import { parseDateInput } from "../../../../../lib/date-input";
import { orgLocalDateString } from "../../../../../lib/org-time";
import { withRequestDb } from "../../../../../lib/db-request";

const organizationId = Astro.params.orgId!;
try {
  requireOrganizationAccess(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const confirmResult = Astro.getActionResult(actions.payments.confirmMatch);
const rejectResult = Astro.getActionResult(actions.payments.rejectMatch);
const reverseResult = Astro.getActionResult(actions.payments.reverseMatch);
const matchResult = Astro.getActionResult(actions.payments.matchTransaction);
const recordManualResult = Astro.getActionResult(actions.payments.recordManual);

const {
  organization,
  dwellingDirectory,
  rawImports,
  proposedMatches,
  confirmedMatches,
  rejectedMatches,
  reversedMatches,
  unmatchedTransactions,
  openInvoices,
} = await withRequestDb(async (db) => ({
  organization: await getOrganization(db, organizationId),
  dwellingDirectory: await listDwellings(db, organizationId, {
    includeArchived: true,
    limit: 2147483647,
  }),
  rawImports: await listBankImports(db, organizationId),
  proposedMatches: await listPaymentMatches(db, organizationId, "PROPOSED"),
  confirmedMatches: await listPaymentMatches(db, organizationId, "CONFIRMED"),
  rejectedMatches: await listPaymentMatches(db, organizationId, "REJECTED"),
  reversedMatches: await listPaymentMatches(db, organizationId, "REVERSED"),
  unmatchedTransactions: await listUnmatchedTransactions(db, organizationId),
  openInvoices: await listOpenInvoicesForPayment(db, organizationId),
}));

const imports = [...rawImports].reverse();
const views = [
  "PROPOSED",
  "UNMATCHED",
  "CONFIRMED",
  "REJECTED",
  "REVERSED",
] as const;
const requestedView = Astro.url.searchParams.get("view");
const counts = {
  PROPOSED: proposedMatches.length,
  UNMATCHED: unmatchedTransactions.length,
  CONFIRMED: confirmedMatches.length,
  REJECTED: rejectedMatches.length,
  REVERSED: reversedMatches.length,
};
// Without an explicit ?view, open the first tab that has something to act on
// (or, failing that, the confirmed history) instead of an empty Proposed tab.
const view =
  views.find((v) => v === requestedView) ??
  (counts.PROPOSED
    ? "PROPOSED"
    : counts.UNMATCHED
      ? "UNMATCHED"
      : counts.CONFIRMED
        ? "CONFIRMED"
        : "PROPOSED");
const matches =
  view === "CONFIRMED"
    ? confirmedMatches
    : view === "REJECTED"
      ? rejectedMatches
      : view === "REVERSED"
        ? reversedMatches
        : proposedMatches;
// Sums in whole cents; a mixed-currency import shows just the count.
const total = (amounts: { amount: string; currency: string }[]) =>
  amounts.length === 0 ||
  amounts.some((a) => a.currency !== amounts[0].currency)
    ? undefined
    : formatMoney(
        String(
          amounts.reduce(
            (sum, a) => sum + Math.round(Number(a.amount) * 100),
            0
          ) / 100
        ),
        amounts[0].currency,
        locale
      );
const matchTotal = (list: typeof proposedMatches) =>
  total(
    list.map((m) => ({
      amount: m.transactionAmount,
      currency: m.transactionCurrency,
    }))
  );
const labels = {
  PROPOSED: "Proposed",
  UNMATCHED: "Unmatched",
  CONFIRMED: "Confirmed",
  REJECTED: "Rejected",
  REVERSED: "Reversed",
};
const today = orgLocalDateString(new Date(), organization.timezone);
const payer = (name: string | null) => {
  // A bank transaction's payer name is free text from the resident's own
  // bank -- it can never contain our internal dwelling id, but it commonly
  // matches the name registered on the dwelling (occupant or billing name).
  const dwelling =
    name != null &&
    dwellingDirectory.find(
      (d) => d.occupantName === name || d.billingName === name
    );
  return dwelling ? t("Dwelling") + " " + dwelling.number : (name ?? "—");
};

const rawQ = Astro.url.searchParams.get("q")?.trim();
const q = rawQ ? rawQ.slice(0, 100) : undefined;
const from = parseDateInput(Astro.url.searchParams.get("from"));
const to = parseDateInput(Astro.url.searchParams.get("to"));

const shownMatches =
  view === "UNMATCHED"
    ? []
    : matches.filter((m) => {
        if (from && m.transactionBookingDate < from) return false;
        if (to && m.transactionBookingDate > to) return false;
        if (q) {
          const needle = q.toLowerCase();
          const matchesInvoice = m.invoiceNumber.toLowerCase().includes(needle);
          const matchesRef = Boolean(
            m.transactionReference?.toLowerCase().includes(needle)
          );
          const matchesPayer = Boolean(
            m.transactionPayerName?.toLowerCase().includes(needle)
          );
          const matchesAmount = String(m.transactionAmount)
            .toLowerCase()
            .includes(needle);
          const matchesDwelling = payer(m.transactionPayerName)
            .toLowerCase()
            .includes(needle);
          return (
            matchesInvoice ||
            matchesRef ||
            matchesPayer ||
            matchesAmount ||
            matchesDwelling
          );
        }
        return true;
      });

const shownUnmatched =
  view === "UNMATCHED"
    ? unmatchedTransactions.filter((tx) => {
        if (from && tx.bookingDate < from) return false;
        if (to && tx.bookingDate > to) return false;
        if (q) {
          const needle = q.toLowerCase();
          const matchesRef = Boolean(
            tx.reference?.toLowerCase().includes(needle)
          );
          const matchesPayer = Boolean(
            tx.payerName?.toLowerCase().includes(needle)
          );
          const matchesAmount = String(tx.amount)
            .toLowerCase()
            .includes(needle);
          const matchesDwelling = payer(tx.payerName)
            .toLowerCase()
            .includes(needle);
          return matchesRef || matchesPayer || matchesAmount || matchesDwelling;
        }
        return true;
      })
    : [];
const shownCount =
  view === "UNMATCHED" ? shownUnmatched.length : shownMatches.length;
---

<AdminLayout
  title={t("Payments") + " - " + organization.name}
  organizationId={organizationId}
  organizationName={organization.name}
>
  <div class="space-y-6">
    <nav class="breadcrumb" aria-label={t("Breadcrumb")}>
      <a href={`/admin/o/${organizationId}/dashboard`}>{t("Dashboard")}</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{t("Payments")}</span>
    </nav>
    <PageHeader
      title={t("Payments")}
      description={t(
        "Review proposed matches and reconcile incoming payments."
      )}
      display
    >
      <details class="edit-disclosure" open={!!recordManualResult?.error}>
        <summary class="btn-secondary">{t("Record a payment")}</summary>
        <div class="edit-disclosure-panel">
          <p class="text-sm text-muted">
            {
              t(
                "Use this for a bank transfer that is not in an imported statement. The payment is applied right away."
              )
            }
          </p>
          <form
            method="POST"
            action={actions.payments.recordManual}
            class="mt-4 space-y-3"
          >
            <input type="hidden" name="organizationId" value={organizationId} />
            <div>
              <label
                class="block text-sm font-medium text-foreground"
                for="manual-invoice"
              >
                {t("Invoice")}
              </label>
              <select
                id="manual-invoice"
                name="invoiceId"
                required
                class="mt-1 w-full rounded-control border border-border px-3 py-1.5 text-sm"
              >
                <option value="" disabled selected>
                  {t("Choose an invoice")}
                </option>
                {
                  openInvoices.map((inv) => (
                    <option value={inv.id}>
                      {`${inv.invoiceNumber} · ${t("Dwelling")} ${inv.dwellingNumber} · ${formatMoney(inv.remaining, inv.currency, locale)}`}
                    </option>
                  ))
                }
              </select>
              <FieldError name="invoiceId" error={recordManualResult?.error} />
            </div>
            <div>
              <label
                class="block text-sm font-medium text-foreground"
                for="manual-amount"
              >
                {t("Amount")}
              </label>
              <input
                id="manual-amount"
                name="amount"
                inputmode="decimal"
                required
                class="mt-1 w-full rounded-control border border-border px-3 py-1.5 text-sm"
              />
              <FieldError name="amount" error={recordManualResult?.error} />
            </div>
            <div>
              <label
                class="block text-sm font-medium text-foreground"
                for="manual-date"
              >
                {t("Date")}
              </label>
              <input
                id="manual-date"
                name="bookingDate"
                type="date"
                required
                max={today}
                class="mt-1 w-full rounded-control border border-border px-3 py-1.5 text-sm"
              />
              <FieldError
                name="bookingDate"
                error={recordManualResult?.error}
              />
            </div>
            <div>
              <label
                class="block text-sm font-medium text-foreground"
                for="manual-payer"
              >
                {t("Payer")}
              </label>
              <input
                id="manual-payer"
                name="payerName"
                class="mt-1 w-full rounded-control border border-border px-3 py-1.5 text-sm"
              />
              <FieldError name="payerName" error={recordManualResult?.error} />
            </div>
            <div>
              <label
                class="block text-sm font-medium text-foreground"
                for="manual-reference"
              >
                {t("Bank reference")}
              </label>
              <input
                id="manual-reference"
                name="reference"
                required
                class="mt-1 w-full rounded-control border border-border px-3 py-1.5 text-sm"
              />
              <FieldError name="reference" error={recordManualResult?.error} />
            </div>
            <div>
              <label
                class="block text-sm font-medium text-foreground"
                for="manual-reason"
              >
                {t("Reason")}
              </label>
              <input
                id="manual-reason"
                name="reason"
                required
                maxlength="500"
                class="mt-1 w-full rounded-control border border-border px-3 py-1.5 text-sm"
              />
              <FieldError name="reason" error={recordManualResult?.error} />
            </div>
            <div>
              <button
                type="submit"
                class="btn-primary"
                data-confirm={t(
                  "Record this payment? It is applied to the invoice right away."
                )}
              >
                {t("Record payment")}
              </button>
            </div>
          </form>
        </div>
      </details>
      <a
        class="btn-primary"
        href={"/admin/o/" + organizationId + "/payments/import"}
      >
        {t("Import bank statement")}
      </a>
    </PageHeader>
    {
      (confirmResult?.error ||
        rejectResult?.error ||
        reverseResult?.error ||
        matchResult?.error ||
        recordManualResult?.error) && (
        <p role="alert" class="notice notice-danger mb-6">
          {friendlyActionErrorMessage(
            confirmResult?.error ??
              rejectResult?.error ??
              reverseResult?.error ??
              matchResult?.error ??
              recordManualResult?.error,
            locale
          )}
        </p>
      )
    }
    {
      (reverseResult?.data ||
        matchResult?.data ||
        recordManualResult?.data) && (
        <p role="status" class="notice mb-6">
          {reverseResult?.data
            ? t("Payment reversed.")
            : matchResult?.data
              ? t("Payment matched.")
              : t("Payment recorded.")}
        </p>
      )
    }
    <div class="grid grid-cols-2 gap-4 xl:grid-cols-4">
      <KpiCard label={t("Imports")} value={imports.length} /><KpiCard
        label={t("Proposed")}
        value={proposedMatches.length}
        hint={matchTotal(proposedMatches)}
      /><KpiCard
        label={t("Confirmed")}
        tone="success"
        value={confirmedMatches.length}
        hint={matchTotal(confirmedMatches)}
      /><KpiCard
        label={t("Unmatched")}
        tone="warning"
        value={unmatchedTransactions.length}
        hint={total(unmatchedTransactions)}
      />
    </div>
    <section class="mt-8">
      <h2 class="section-title">{t("Reconciliation")}</h2><nav
        class="tabs"
        aria-label={t("Reconciliation")}
      >
        {
          views.map((v) => (
            <a
              href={"?view=" + v}
              aria-current={view === v ? "page" : undefined}
            >
              {t(labels[v])} <span class="ml-1 tabular-nums">{counts[v]}</span>
            </a>
          ))
        }
      </nav>
      <form method="GET" class="flex flex-wrap items-end gap-3">
        <input type="hidden" name="view" value={view} />
        <div>
          <label
            class="block text-sm font-medium text-foreground"
            for="payments-q"
          >
            {t("Search")}
          </label>
          <input
            type="text"
            id="payments-q"
            name="q"
            value={q ?? ""}
            placeholder={t("Invoice, reference or payer")}
            class="mt-1 rounded-control border border-border px-3 py-1.5 text-sm"
          />
        </div>
        <div>
          <label
            class="block text-sm font-medium text-foreground"
            for="payments-from"
          >
            {t("From date")}
          </label>
          <input
            type="date"
            id="payments-from"
            name="from"
            value={from ?? ""}
            class="mt-1 rounded-control border border-border px-3 py-1.5 text-sm"
          />
        </div>
        <div>
          <label
            class="block text-sm font-medium text-foreground"
            for="payments-to"
          >
            {t("To date")}
          </label>
          <input
            type="date"
            id="payments-to"
            name="to"
            value={to ?? ""}
            class="mt-1 rounded-control border border-border px-3 py-1.5 text-sm"
          />
        </div>
        <button type="submit" class="btn-primary">
          {t("Filter")}
        </button>
        {
          (q || from || to) && (
            <a
              href={"?view=" + view}
              class="clear-filters text-sm text-primary hover:underline"
            >
              {t("Clear filters")}
            </a>
          )
        }
      </form>
      {
        counts[view] === 0 ? (
          <EmptyState title={t("No transactions in this view.")}>
            {view !== "CONFIRMED" && counts.CONFIRMED > 0 && (
              <a href="?view=CONFIRMED">
                {t("View confirmed payments")} ({counts.CONFIRMED}) →
              </a>
            )}
          </EmptyState>
        ) : shownCount === 0 ? (
          <p class="text-sm text-muted">
            {t("No payments match these filters.")}
          </p>
        ) : (
          <div class="table-wrap stack-table">
            <table class="w-full text-left text-sm">
              <caption class="sr-only">
                {view === "UNMATCHED"
                  ? t("Unmatched payments")
                  : t("Payment matches")}
              </caption>
              <>
                <thead>
                  <tr>
                    <th scope="col">{t("Invoice")}</th>
                    <th scope="col" class="text-right">
                      {t("Payment")}
                    </th>
                    <th scope="col">{t("Payer")}</th>
                    <th scope="col">{t("Reference")}</th>
                    <th scope="col">{t("Date")}</th>
                    <th scope="col">{t("Status")}</th>
                    {(view === "PROPOSED" ||
                      view === "CONFIRMED" ||
                      view === "UNMATCHED") && (
                      <th scope="col">{t("Actions")}</th>
                    )}
                  </tr>
                </thead>
                <tbody class="divide-y divide-border">
                  {view === "UNMATCHED"
                    ? shownUnmatched.map((tx) => (
                        <tr>
                          <td>—</td>
                          <td class="text-right whitespace-nowrap font-medium">
                            {formatMoney(tx.amount, tx.currency, locale)}
                          </td>
                          <td>{payer(tx.payerName)}</td>
                          <td>{tx.reference ?? "—"}</td>
                          <td class="whitespace-nowrap">
                            {formatDate(tx.bookingDate, locale)}
                          </td>
                          <td>
                            <StatusBadge status="UNMATCHED" />
                          </td>
                          <td data-label={t("Actions")}>
                            <form
                              method="POST"
                              action={actions.payments.matchTransaction}
                              class="flex flex-wrap items-center gap-2"
                            >
                              <input
                                type="hidden"
                                name="organizationId"
                                value={organizationId}
                              />
                              <input
                                type="hidden"
                                name="transactionId"
                                value={tx.id}
                              />
                              <select
                                name="invoiceId"
                                required
                                aria-label={t("Invoice")}
                                class="rounded-control border border-border px-3 py-1.5 text-sm"
                              >
                                <option value="" disabled selected>
                                  {t("Choose an invoice")}
                                </option>
                                {openInvoices
                                  .filter((inv) => inv.currency === tx.currency)
                                  .map((inv) => (
                                    <option value={inv.id}>
                                      {`${inv.invoiceNumber} · ${t("Dwelling")} ${inv.dwellingNumber} · ${formatMoney(inv.remaining, inv.currency, locale)}`}
                                    </option>
                                  ))}
                              </select>
                              <button
                                type="submit"
                                class="btn-primary"
                                data-confirm={t(
                                  "Match this payment to the chosen invoice? The payment is applied right away."
                                )}
                              >
                                {t("Match to invoice")}
                              </button>
                            </form>
                          </td>
                        </tr>
                      ))
                    : shownMatches.map((m) => (
                        <tr>
                          <td class="font-semibold">
                            <div>
                              <a
                                href={`/admin/o/${organizationId}/periods/${m.periodId}/invoices/${m.invoiceId}`}
                                class="text-primary hover:underline"
                              >
                                {m.invoiceNumber}
                              </a>
                            </div>
                            <small class="text-muted">
                              {t("Amount due")}:{" "}
                              {formatMoney(
                                m.amountDue,
                                m.transactionCurrency,
                                locale
                              )}
                            </small>
                            {m.resultType !== "EXACT" && (
                              <small class="block text-muted">
                                {m.resultType === "PARTIAL"
                                  ? t("Remaining after allocation")
                                  : t("Credit created")}
                                :{" "}
                                {formatMoney(
                                  m.resultType === "PARTIAL"
                                    ? m.remainingAfterAllocation
                                    : m.creditCreated,
                                  m.transactionCurrency,
                                  locale
                                )}
                              </small>
                            )}
                          </td>
                          <td class="text-right whitespace-nowrap font-medium">
                            {formatMoney(
                              m.transactionAmount,
                              m.transactionCurrency,
                              locale
                            )}
                          </td>
                          <td>
                            <div>{payer(m.transactionPayerName)}</div>
                            <a
                              href={`/admin/o/${organizationId}/dwellings/${m.dwellingId}`}
                              class="text-xs text-primary hover:underline"
                            >
                              {t("View dwelling")}
                            </a>
                          </td>
                          <td>{m.transactionReference ?? "—"}</td>
                          <td class="whitespace-nowrap">
                            {formatDate(m.transactionBookingDate, locale)}
                          </td>
                          <td>
                            <StatusBadge status={m.status} />
                          </td>
                          {view === "PROPOSED" && (
                            <td data-label={t("Actions")}>
                              <div class="flex gap-2">
                                <form
                                  method="POST"
                                  action={actions.payments.confirmMatch}
                                >
                                  <input
                                    type="hidden"
                                    name="organizationId"
                                    value={organizationId}
                                  />
                                  <input
                                    type="hidden"
                                    name="matchId"
                                    value={m.id}
                                  />
                                  <button
                                    type="submit"
                                    class="btn-primary"
                                    data-confirm={t(
                                      "Confirm this payment? The invoice balance will be updated."
                                    )}
                                  >
                                    {t("Confirm")}
                                  </button>
                                </form>
                                <form
                                  method="POST"
                                  action={actions.payments.rejectMatch}
                                >
                                  <input
                                    type="hidden"
                                    name="organizationId"
                                    value={organizationId}
                                  />
                                  <input
                                    type="hidden"
                                    name="matchId"
                                    value={m.id}
                                  />
                                  <button type="submit" class="btn-secondary">
                                    {t("Reject")}
                                  </button>
                                </form>
                              </div>
                            </td>
                          )}
                          {view === "CONFIRMED" && (
                            <td data-label={t("Actions")}>
                              <details>
                                <summary class="cursor-pointer text-primary hover:underline">
                                  {t("Reverse")}
                                </summary>
                                <form
                                  method="POST"
                                  action={actions.payments.reverseMatch}
                                  class="mt-2 space-y-2"
                                >
                                  <input
                                    type="hidden"
                                    name="organizationId"
                                    value={organizationId}
                                  />
                                  <input
                                    type="hidden"
                                    name="matchId"
                                    value={m.id}
                                  />
                                  <div>
                                    <label
                                      class="block text-sm font-medium text-foreground"
                                      for={`reverse-reason-${m.id}`}
                                    >
                                      {t("Reason for reversal")}
                                    </label>
                                    <input
                                      type="text"
                                      id={`reverse-reason-${m.id}`}
                                      name="reason"
                                      required
                                      maxlength="500"
                                      class="mt-1 rounded-control border border-border px-3 py-1.5 text-sm"
                                    />
                                  </div>
                                  <button
                                    type="submit"
                                    class="btn-secondary"
                                    data-confirm={t(
                                      "Reverse this payment? The original payment stays in the history and a cancelling entry is added. The invoice becomes unpaid again."
                                    )}
                                  >
                                    {t("Reverse payment")}
                                  </button>
                                </form>
                              </details>
                            </td>
                          )}
                        </tr>
                      ))}
                </tbody>
              </>
            </table>
          </div>
        )
      }
    </section>
    <section class="mt-8">
      <h2 class="section-title">{t("Import history")}</h2>{
        imports.length === 0 ? (
          <EmptyState title={t("No imports yet.")} />
        ) : (
          <div class="table-wrap stack-table">
            <table class="w-full text-left text-sm">
              <caption class="sr-only">{t("Import history")}</caption>
              <>
                <thead>
                  <tr>
                    <>
                      <th scope="col">{t("Filename")}</th>
                      <th scope="col">{t("Imported")}</th>
                      <th scope="col" class="text-right">
                        {t("Rows")}
                      </th>
                      <th scope="col">{t("Actions")}</th>
                    </>
                  </tr>
                </thead>
                <tbody class="divide-y divide-border">
                  {imports.map((imp) => (
                    <tr>
                      <td class="font-medium">{imp.originalFilename}</td>
                      <td>
                        {formatDate(
                          imp.importedAt,
                          locale,
                          organization.timezone
                        )}
                      </td>
                      <td class="text-right">{imp.rowCount}</td>
                      <td class="text-right">
                        <a
                          href={
                            "/admin/o/" +
                            organizationId +
                            "/payments/imports/" +
                            imp.id
                          }
                        >
                          {t("View")} →
                        </a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </>
            </table>
          </div>
        )
      }
    </section>
  </div>
</AdminLayout>

