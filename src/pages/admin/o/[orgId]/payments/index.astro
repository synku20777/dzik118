---
// Phase J (Payments) - payments index (spec Section 25, PAY-003).
import PageHeader from "../../../../../components/ui/PageHeader.astro";
import KpiCard from "../../../../../components/ui/KpiCard.astro";
import StatusBadge from "../../../../../components/ui/StatusBadge.astro";
import EmptyState from "../../../../../components/ui/EmptyState.astro";
import { listDwellings } from "../../../../../domain/organizations/dwellings";
import {
  translate,
  uiLocale,
  formatMoney,
  formatDate,
} from "../../../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import { actions } from "astro:actions";
import {
  ForbiddenError,
  requireOrganizationAccess,
} from "../../../../../domain/authorization/guards";
import { getOrganization } from "../../../../../domain/organizations/organizations";
import { listBankImports } from "../../../../../domain/payments/bank-import";
import {
  listPaymentMatches,
  listUnmatchedTransactions,
} from "../../../../../domain/payments/matching";
import { withRequestDb } from "../../../../../lib/db-request";

const organizationId = Astro.params.orgId!;
try {
  requireOrganizationAccess(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const confirmResult = Astro.getActionResult(actions.payments.confirmMatch);
const rejectResult = Astro.getActionResult(actions.payments.rejectMatch);

const {
  organization,
  dwellingDirectory,
  rawImports,
  proposedMatches,
  confirmedMatches,
  rejectedMatches,
  unmatchedTransactions,
} = await withRequestDb(async (db) => ({
  organization: await getOrganization(db, organizationId),
  dwellingDirectory: await listDwellings(db, organizationId, {
    includeArchived: true,
    limit: 2147483647,
  }),
  rawImports: await listBankImports(db, organizationId),
  proposedMatches: await listPaymentMatches(db, organizationId, "PROPOSED"),
  confirmedMatches: await listPaymentMatches(db, organizationId, "CONFIRMED"),
  rejectedMatches: await listPaymentMatches(db, organizationId, "REJECTED"),
  unmatchedTransactions: await listUnmatchedTransactions(db, organizationId),
}));

const imports = [...rawImports].reverse();
const views = ["PROPOSED", "UNMATCHED", "CONFIRMED", "REJECTED"] as const;
const requestedView = Astro.url.searchParams.get("view");
const counts = {
  PROPOSED: proposedMatches.length,
  UNMATCHED: unmatchedTransactions.length,
  CONFIRMED: confirmedMatches.length,
  REJECTED: rejectedMatches.length,
};
// Without an explicit ?view, open the first tab that has something to act on
// (or, failing that, the confirmed history) instead of an empty Proposed tab.
const view =
  views.find((v) => v === requestedView) ??
  (counts.PROPOSED
    ? "PROPOSED"
    : counts.UNMATCHED
      ? "UNMATCHED"
      : counts.CONFIRMED
        ? "CONFIRMED"
        : "PROPOSED");
const matches =
  view === "CONFIRMED"
    ? confirmedMatches
    : view === "REJECTED"
      ? rejectedMatches
      : proposedMatches;
// Sums in whole cents; a mixed-currency import shows just the count.
const total = (amounts: { amount: string; currency: string }[]) =>
  amounts.length === 0 ||
  amounts.some((a) => a.currency !== amounts[0].currency)
    ? undefined
    : formatMoney(
        String(
          amounts.reduce(
            (sum, a) => sum + Math.round(Number(a.amount) * 100),
            0
          ) / 100
        ),
        amounts[0].currency,
        locale
      );
const matchTotal = (list: typeof proposedMatches) =>
  total(
    list.map((m) => ({
      amount: m.transactionAmount,
      currency: m.transactionCurrency,
    }))
  );
const labels = {
  PROPOSED: "Proposed",
  UNMATCHED: "Unmatched",
  CONFIRMED: "Confirmed",
  REJECTED: "Rejected",
};
const payer = (name: string | null) => {
  // A bank transaction's payer name is free text from the resident's own
  // bank -- it can never contain our internal dwelling id, but it commonly
  // matches the name registered on the dwelling (occupant or billing name).
  const dwelling =
    name != null &&
    dwellingDirectory.find(
      (d) => d.occupantName === name || d.billingName === name
    );
  return dwelling ? t("Dwelling") + " " + dwelling.number : (name ?? "—");
};
---

<AdminLayout
  title={t("Payments") + " - " + organization.name}
  organizationId={organizationId}
  organizationName={organization.name}
>
  <div class="space-y-6">
    <nav class="breadcrumb" aria-label={t("Breadcrumb")}>
      <a href={`/admin/o/${organizationId}/dashboard`}>{t("Dashboard")}</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{t("Payments")}</span>
    </nav>
    <PageHeader
      title={t("Payments")}
      description={t(
        "Review proposed matches and reconcile incoming payments."
      )}
      display
      ><a
        class="btn-primary"
        href={"/admin/o/" + organizationId + "/payments/import"}
        >{t("Import bank statement")}</a
      ></PageHeader
    >
    {
      (confirmResult?.error || rejectResult?.error) && (
        <p role="alert" class="notice notice-danger mb-6">
          {confirmResult?.error?.message ?? rejectResult?.error?.message}
        </p>
      )
    }
    <div class="grid grid-cols-2 gap-4 xl:grid-cols-4">
      <KpiCard label={t("Imports")} value={imports.length} /><KpiCard
        label={t("Proposed")}
        value={proposedMatches.length}
        hint={matchTotal(proposedMatches)}
      /><KpiCard
        label={t("Confirmed")}
        tone="success"
        value={confirmedMatches.length}
        hint={matchTotal(confirmedMatches)}
      /><KpiCard
        label={t("Unmatched")}
        tone="warning"
        value={unmatchedTransactions.length}
        hint={total(unmatchedTransactions)}
      />
    </div>
    <section class="mt-8">
      <h2 class="section-title">{t("Reconciliation")}</h2><nav
        class="tabs"
        aria-label={t("Reconciliation")}
      >
        {
          views.map((v) => (
            <a
              href={"?view=" + v}
              aria-current={view === v ? "page" : undefined}
            >
              {t(labels[v])} <span class="ml-1 tabular-nums">{counts[v]}</span>
            </a>
          ))
        }
      </nav>
      {
        counts[view] === 0 ? (
          <EmptyState title={t("No transactions in this view.")}>
            {view !== "CONFIRMED" && counts.CONFIRMED > 0 && (
              <a href="?view=CONFIRMED">
                {t("View confirmed payments")} ({counts.CONFIRMED}) →
              </a>
            )}
          </EmptyState>
        ) : (
          <div class="table-wrap stack-table">
            <table class="w-full text-left text-sm">
              <>
                <thead>
                  <tr>
                    <th>{t("Invoice")}</th>
                    <th class="text-right">{t("Payment")}</th>
                    <th>{t("Payer")}</th>
                    <th>{t("Reference")}</th>
                    <th>{t("Date")}</th>
                    <th>{t("Status")}</th>
                    {view === "PROPOSED" && <th>{t("Actions")}</th>}
                  </tr>
                </thead>
                <tbody class="divide-y divide-border">
                  {view === "UNMATCHED"
                    ? unmatchedTransactions.map((tx) => (
                        <tr>
                          <td>—</td>
                          <td class="text-right whitespace-nowrap font-medium">
                            {formatMoney(tx.amount, tx.currency, locale)}
                          </td>
                          <td>{payer(tx.payerName)}</td>
                          <td>{tx.reference ?? "—"}</td>
                          <td class="whitespace-nowrap">
                            {formatDate(tx.bookingDate, locale)}
                          </td>
                          <td>
                            <StatusBadge status="UNMATCHED" />
                          </td>
                        </tr>
                      ))
                    : matches.map((m) => (
                        <tr>
                          <td class="font-semibold">
                            <div>{m.invoiceNumber}</div>
                            <small class="text-muted">
                              {t("Amount due")}:{" "}
                              {formatMoney(
                                m.amountDue,
                                m.transactionCurrency,
                                locale
                              )}
                            </small>
                            {m.resultType !== "EXACT" && (
                              <small class="block text-muted">
                                {m.resultType === "PARTIAL"
                                  ? t("Remaining after allocation")
                                  : t("Credit created")}
                                :{" "}
                                {formatMoney(
                                  m.resultType === "PARTIAL"
                                    ? m.remainingAfterAllocation
                                    : m.creditCreated,
                                  m.transactionCurrency,
                                  locale
                                )}
                              </small>
                            )}
                          </td>
                          <td class="text-right whitespace-nowrap font-medium">
                            {formatMoney(
                              m.transactionAmount,
                              m.transactionCurrency,
                              locale
                            )}
                          </td>
                          <td>{payer(m.transactionPayerName)}</td>
                          <td>{m.transactionReference ?? "—"}</td>
                          <td class="whitespace-nowrap">
                            {formatDate(m.transactionBookingDate, locale)}
                          </td>
                          <td>
                            <StatusBadge status={m.status} />
                          </td>
                          {view === "PROPOSED" && (
                            <td>
                              <div class="flex gap-2">
                                <form
                                  method="POST"
                                  action={actions.payments.confirmMatch}
                                >
                                  <input
                                    type="hidden"
                                    name="organizationId"
                                    value={organizationId}
                                  />
                                  <input
                                    type="hidden"
                                    name="matchId"
                                    value={m.id}
                                  />
                                  <button
                                    type="submit"
                                    class="btn-primary"
                                    data-confirm={t(
                                      "Confirm this payment? The invoice balance will be updated."
                                    )}
                                  >
                                    {t("Confirm")}
                                  </button>
                                </form>
                                <form
                                  method="POST"
                                  action={actions.payments.rejectMatch}
                                >
                                  <input
                                    type="hidden"
                                    name="organizationId"
                                    value={organizationId}
                                  />
                                  <input
                                    type="hidden"
                                    name="matchId"
                                    value={m.id}
                                  />
                                  <button type="submit" class="btn-secondary">
                                    {t("Reject")}
                                  </button>
                                </form>
                              </div>
                            </td>
                          )}
                        </tr>
                      ))}
                </tbody>
              </>
            </table>
          </div>
        )
      }
    </section>
    <section class="mt-8">
      <h2 class="section-title">{t("Import history")}</h2>{
        imports.length === 0 ? (
          <EmptyState title={t("No imports yet.")} />
        ) : (
          <div class="table-wrap stack-table">
            <table class="w-full text-left text-sm">
              <>
                <thead>
                  <tr>
                    <>
                      <th>{t("Filename")}</th>
                      <th>{t("Imported")}</th>
                      <th class="text-right">{t("Rows")}</th>
                      <th>{t("Actions")}</th>
                    </>
                  </tr>
                </thead>
                <tbody class="divide-y divide-border">
                  {imports.map((imp) => (
                    <tr>
                      <td class="font-medium">{imp.originalFilename}</td>
                      <td>
                        {formatDate(
                          imp.importedAt,
                          locale,
                          organization.timezone
                        )}
                      </td>
                      <td class="text-right">{imp.rowCount}</td>
                      <td class="text-right">
                        <a
                          href={
                            "/admin/o/" +
                            organizationId +
                            "/payments/imports/" +
                            imp.id
                          }
                        >
                          {t("View")} →
                        </a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </>
            </table>
          </div>
        )
      }
    </section>
  </div>
</AdminLayout>
