---
// Phase J (Payments) - payments index (spec Section 25, PAY-003).
import PageHeader from "../../../../../components/ui/PageHeader.astro";
import KpiCard from "../../../../../components/ui/KpiCard.astro";
import StatusBadge from "../../../../../components/ui/StatusBadge.astro";
import EmptyState from "../../../../../components/ui/EmptyState.astro";
import { listDwellings } from "../../../../../domain/organizations/dwellings";
import {
  translate,
  uiLocale,
  formatMoney,
  formatDate,
  friendlyActionErrorMessage,
} from "../../../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import { actions } from "astro:actions";
import {
  ForbiddenError,
  requireOrganizationAccess,
} from "../../../../../domain/authorization/guards";
import { getOrganization } from "../../../../../domain/organizations/organizations";
import { listBankImports } from "../../../../../domain/payments/bank-import";
import {
  listPaymentMatches,
  listUnmatchedTransactions,
} from "../../../../../domain/payments/matching";
import { listOpenInvoicesForPayment } from "../../../../../domain/payments/manual";
import { listDwellingPayments } from "../../../../../domain/payments/direct";
import ManualPaymentForm from "../../../../../components/ui/ManualPaymentForm.astro";
import { parseDateInput } from "../../../../../lib/date-input";
import { orgLocalDateString } from "../../../../../lib/org-time";
import { withRequestDb } from "../../../../../lib/db-request";

const organizationId = Astro.params.orgId!;
try {
  requireOrganizationAccess(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const confirmResult = Astro.getActionResult(actions.payments.confirmMatch);
const rejectResult = Astro.getActionResult(actions.payments.rejectMatch);
const reverseResult = Astro.getActionResult(actions.payments.reverseMatch);
const matchResult = Astro.getActionResult(actions.payments.matchTransaction);
const recordManualResult = Astro.getActionResult(actions.payments.recordManual);
const reverseDwellingResult = Astro.getActionResult(
  actions.payments.reverseDwellingPayment
);
const editResult = Astro.getActionResult(actions.payments.editUnmatched);

const {
  organization,
  dwellingDirectory,
  rawImports,
  proposedMatches,
  confirmedMatches,
  rejectedMatches,
  reversedMatches,
  unmatchedTransactions,
  openInvoices,
  dwellingPayments,
} = await withRequestDb(async (db) => ({
  organization: await getOrganization(db, organizationId),
  dwellingDirectory: await listDwellings(db, organizationId, {
    includeArchived: true,
    limit: 2147483647,
  }),
  rawImports: await listBankImports(db, organizationId),
  proposedMatches: await listPaymentMatches(db, organizationId, "PROPOSED"),
  confirmedMatches: await listPaymentMatches(db, organizationId, "CONFIRMED"),
  rejectedMatches: await listPaymentMatches(db, organizationId, "REJECTED"),
  reversedMatches: await listPaymentMatches(db, organizationId, "REVERSED"),
  unmatchedTransactions: await listUnmatchedTransactions(db, organizationId),
  openInvoices: await listOpenInvoicesForPayment(db, organizationId),
  dwellingPayments: await listDwellingPayments(db, organizationId),
}));

// A dwelling account can take a payment only when the dwelling has no open
// invoice (that invoice froze its balance and takes the payment instead).
const dwellingsWithOpenInvoice = new Set(openInvoices.map((i) => i.dwellingId));
const accountTargets = dwellingDirectory
  .filter((d) => !d.archivedAt && !dwellingsWithOpenInvoice.has(d.id))
  .map((d) => ({ id: d.id, number: d.number }));

const imports = [...rawImports].reverse();
const views = [
  "PROPOSED",
  "UNMATCHED",
  "CONFIRMED",
  "REJECTED",
  "REVERSED",
] as const;
const requestedView = Astro.url.searchParams.get("view");
const counts = {
  PROPOSED: proposedMatches.length,
  UNMATCHED: unmatchedTransactions.length,
  CONFIRMED: confirmedMatches.length,
  REJECTED: rejectedMatches.length,
  REVERSED: reversedMatches.length,
};
// Without an explicit ?view, open the first tab that has something to act on
// (or, failing that, the confirmed history) instead of an empty Proposed tab.
const view =
  views.find((v) => v === requestedView) ??
  (counts.PROPOSED
    ? "PROPOSED"
    : counts.UNMATCHED
      ? "UNMATCHED"
      : counts.CONFIRMED
        ? "CONFIRMED"
        : "PROPOSED");
const matches =
  view === "CONFIRMED"
    ? confirmedMatches
    : view === "REJECTED"
      ? rejectedMatches
      : view === "REVERSED"
        ? reversedMatches
        : proposedMatches;
// Sums in whole cents; a mixed-currency import shows just the count.
const total = (amounts: { amount: string; currency: string }[]) =>
  amounts.length === 0 ||
  amounts.some((a) => a.currency !== amounts[0].currency)
    ? undefined
    : formatMoney(
        String(
          amounts.reduce(
            (sum, a) => sum + Math.round(Number(a.amount) * 100),
            0
          ) / 100
        ),
        amounts[0].currency,
        locale
      );
const matchTotal = (list: typeof proposedMatches) =>
  total(
    list.map((m) => ({
      amount: m.transactionAmount,
      currency: m.transactionCurrency,
    }))
  );
const labels = {
  PROPOSED: "Proposed",
  UNMATCHED: "Unmatched",
  CONFIRMED: "Confirmed",
  REJECTED: "Rejected",
  REVERSED: "Reversed",
};
const today = orgLocalDateString(new Date(), organization.timezone);
const payer = (name: string | null) => {
  // A bank transaction's payer name is free text from the resident's own
  // bank -- it can never contain our internal dwelling id, but it commonly
  // matches the name registered on the dwelling (occupant or billing name).
  const dwelling =
    name != null &&
    dwellingDirectory.find(
      (d) => d.occupantName === name || d.billingName === name
    );
  return dwelling ? t("Dwelling") + " " + dwelling.number : (name ?? "—");
};

const rawQ = Astro.url.searchParams.get("q")?.trim();
const q = rawQ ? rawQ.slice(0, 100) : undefined;
const from = parseDateInput(Astro.url.searchParams.get("from"));
const to = parseDateInput(Astro.url.searchParams.get("to"));

const shownMatches =
  view === "UNMATCHED"
    ? []
    : matches.filter((m) => {
        if (from && m.transactionBookingDate < from) return false;
        if (to && m.transactionBookingDate > to) return false;
        if (q) {
          const needle = q.toLowerCase();
          const matchesInvoice = m.invoiceNumber.toLowerCase().includes(needle);
          const matchesRef = Boolean(
            m.transactionReference?.toLowerCase().includes(needle)
          );
          const matchesPayer = Boolean(
            m.transactionPayerName?.toLowerCase().includes(needle)
          );
          const matchesAmount = String(m.transactionAmount)
            .toLowerCase()
            .includes(needle);
          const matchesDwelling = payer(m.transactionPayerName)
            .toLowerCase()
            .includes(needle);
          return (
            matchesInvoice ||
            matchesRef ||
            matchesPayer ||
            matchesAmount ||
            matchesDwelling
          );
        }
        return true;
      });

const shownUnmatched =
  view === "UNMATCHED"
    ? unmatchedTransactions.filter((tx) => {
        if (from && tx.bookingDate < from) return false;
        if (to && tx.bookingDate > to) return false;
        if (q) {
          const needle = q.toLowerCase();
          const matchesRef = Boolean(
            tx.reference?.toLowerCase().includes(needle)
          );
          const matchesPayer = Boolean(
            tx.payerName?.toLowerCase().includes(needle)
          );
          const matchesAmount = String(tx.amount)
            .toLowerCase()
            .includes(needle);
          const matchesDwelling = payer(tx.payerName)
            .toLowerCase()
            .includes(needle);
          return matchesRef || matchesPayer || matchesAmount || matchesDwelling;
        }
        return true;
      })
    : [];
const shownCount =
  view === "UNMATCHED" ? shownUnmatched.length : shownMatches.length;

// Payments posted straight to a dwelling account (ADR 0014) have no invoice,
// so they sit beside the invoice payments in the Confirmed and Reversed tabs.
const directInView = dwellingPayments.filter((p) =>
  view === "CONFIRMED" ? !p.reversed : view === "REVERSED" ? p.reversed : false
);
const shownDirect = directInView.filter((p) => {
  if (from && p.bookingDate < from) return false;
  if (to && p.bookingDate > to) return false;
  if (!q) return true;
  const needle = q.toLowerCase();
  return [
    p.reference,
    p.payerName,
    p.amount,
    `${t("Dwelling")} ${p.dwellingNumber}`,
  ].some((v) => v?.toLowerCase().includes(needle));
});
---

<AdminLayout
  title={t("Payments") + " - " + organization.name}
  organizationId={organizationId}
  organizationName={organization.name}
>
  <div class="space-y-6">
    <nav class="breadcrumb" aria-label={t("Breadcrumb")}>
      <a href={`/admin/o/${organizationId}/dashboard`}>{t("Dashboard")}</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{t("Payments")}</span>
    </nav>
    <PageHeader
      title={t("Payments")}
      description={t(
        "Review proposed matches and reconcile incoming payments."
      )}
      display
    >
      <details class="edit-disclosure" open={!!recordManualResult?.error}>
        <summary class="btn-secondary">{t("Record a payment")}</summary>
        <div class="edit-disclosure-panel">
          <ManualPaymentForm
            organizationId={organizationId}
            invoices={openInvoices}
            dwellings={accountTargets}
            today={today}
            error={recordManualResult?.error}
          />
        </div>
      </details>
      <a
        class="btn-primary"
        href={"/admin/o/" + organizationId + "/payments/import"}
      >
        {t("Import bank statement")}
      </a>
    </PageHeader>
    {(confirmResult?.error ||
      rejectResult?.error ||
      reverseResult?.error ||
      matchResult?.error ||
      recordManualResult?.error ||
      reverseDwellingResult?.error ||
      editResult?.error) && (
      <p role="alert" class="notice notice-danger mb-6">
        {friendlyActionErrorMessage(
          confirmResult?.error ??
            rejectResult?.error ??
            reverseResult?.error ??
            matchResult?.error ??
            recordManualResult?.error ??
            reverseDwellingResult?.error ??
            editResult?.error,
          locale
        )}
      </p>
    )}
    {(reverseResult?.data ||
      reverseDwellingResult?.data ||
      matchResult?.data ||
      recordManualResult?.data ||
      editResult?.data) && (
      <p role="status" class="notice mb-6">
        {reverseResult?.data || reverseDwellingResult?.data
          ? t("Payment reversed.")
          : matchResult?.data
            ? t("Payment matched.")
            : editResult?.data
              ? t("Payment updated.")
              : t("Payment recorded.")}
      </p>
    )}
    <div class="grid grid-cols-2 gap-4 xl:grid-cols-4">
      <KpiCard label={t("Imports")} value={imports.length} />
      <KpiCard
        label={t("Proposed")}
        value={proposedMatches.length}
        hint={matchTotal(proposedMatches)}
      />
      <KpiCard
        label={t("Confirmed")}
        tone="success"
        value={confirmedMatches.length}
        hint={matchTotal(confirmedMatches)}
      />
      <KpiCard
        label={t("Unmatched")}
        tone="warning"
        value={unmatchedTransactions.length}
        hint={total(unmatchedTransactions)}
      />
    </div>
    <section class="mt-8">
      <h2 class="section-title">{t("Reconciliation")}</h2>
      <nav class="tabs" aria-label={t("Reconciliation")}>
        {views.map((v) => (
          <a href={"?view=" + v} aria-current={view === v ? "page" : undefined}>
            {t(labels[v])} <span class="ml-1 tabular-nums">{counts[v]}</span>
          </a>
        ))}
      </nav>
      <form method="GET" class="mb-6 flex flex-wrap items-end gap-3">
        <input type="hidden" name="view" value={view} />
        <div>
          <label
            class="block text-sm font-medium text-foreground"
            for="payments-q"
          >
            {t("Search")}
          </label>
          <input
            type="text"
            id="payments-q"
            name="q"
            value={q ?? ""}
            placeholder={t("Invoice, reference or payer")}
            class="mt-1 rounded-control border border-border px-3 py-1.5 text-sm"
          />
        </div>
        <div>
          <label
            class="block text-sm font-medium text-foreground"
            for="payments-from"
          >
            {t("From date")}
          </label>
          <input
            type="date"
            id="payments-from"
            name="from"
            value={from ?? ""}
            class="mt-1 rounded-control border border-border px-3 py-1.5 text-sm"
          />
        </div>
        <div>
          <label
            class="block text-sm font-medium text-foreground"
            for="payments-to"
          >
            {t("To date")}
          </label>
          <input
            type="date"
            id="payments-to"
            name="to"
            value={to ?? ""}
            class="mt-1 rounded-control border border-border px-3 py-1.5 text-sm"
          />
        </div>
        <button type="submit" class="btn-primary">
          {t("Filter")}
        </button>
        {(q || from || to) && (
          <a
            href={"?view=" + view}
            class="clear-filters text-sm text-primary hover:underline"
          >
            {t("Clear filters")}
          </a>
        )}
      </form>
      {counts[view] === 0 ? (
        directInView.length === 0 ? (
          <EmptyState title={t("No transactions in this view.")}>
            {view !== "CONFIRMED" && counts.CONFIRMED > 0 && (
              <a href="?view=CONFIRMED">
                {t("View confirmed payments")} ({counts.CONFIRMED}) →
              </a>
            )}
          </EmptyState>
        ) : null
      ) : shownCount === 0 ? (
        shownDirect.length === 0 ? (
          <p class="text-sm text-muted">
            {t("No payments match these filters.")}
          </p>
        ) : null
      ) : (
        <div class="table-wrap stack-table">
          <table class="w-full text-left text-sm">
            <caption class="sr-only">
              {view === "UNMATCHED"
                ? t("Unmatched payments")
                : t("Payment matches")}
            </caption>
            <>
              <thead>
                <tr>
                  <th scope="col">{t("Invoice")}</th>
                  <th scope="col" class="text-right">
                    {t("Payment")}
                  </th>
                  <th scope="col">{t("Payer")}</th>
                  <th scope="col">{t("Reference")}</th>
                  <th scope="col">{t("Date")}</th>
                  <th scope="col">{t("Status")}</th>
                  {(view === "PROPOSED" ||
                    view === "CONFIRMED" ||
                    view === "UNMATCHED") && (
                    <th scope="col">{t("Actions")}</th>
                  )}
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                {view === "UNMATCHED"
                  ? shownUnmatched.map((tx) => (
                      <tr>
                        <td>—</td>
                        <td class="text-right whitespace-nowrap font-medium">
                          {formatMoney(tx.amount, tx.currency, locale)}
                        </td>
                        <td>{payer(tx.payerName)}</td>
                        <td>
                          {tx.reference ?? "—"}
                          {tx.paymentMethod === "CASH" && (
                            <small class="block text-muted">{t("Cash")}</small>
                          )}
                        </td>
                        <td class="whitespace-nowrap">
                          {formatDate(tx.bookingDate, locale)}
                        </td>
                        <td>
                          <StatusBadge status="UNMATCHED" />
                        </td>
                        <td data-label={t("Actions")}>
                          <form
                            method="POST"
                            action={actions.payments.matchTransaction}
                            class="flex flex-wrap items-center gap-2"
                          >
                            <input
                              type="hidden"
                              name="organizationId"
                              value={organizationId}
                            />
                            <input
                              type="hidden"
                              name="transactionId"
                              value={tx.id}
                            />
                            <select
                              name="invoiceId"
                              required
                              aria-label={t("Invoice")}
                              class="rounded-control border border-border px-3 py-1.5 text-sm"
                            >
                              <option value="" disabled selected>
                                {t("Choose an invoice")}
                              </option>
                              {openInvoices
                                .filter((inv) => inv.currency === tx.currency)
                                .map((inv) => (
                                  <option value={inv.id}>
                                    {`${inv.invoiceNumber} · ${t("Dwelling")} ${inv.dwellingNumber} · ${formatMoney(inv.remaining, inv.currency, locale)}`}
                                  </option>
                                ))}
                            </select>
                            <button
                              type="submit"
                              class="btn-primary"
                              data-confirm={t(
                                "Match this payment to the chosen invoice? The payment is applied right away."
                              )}
                            >
                              {t("Match to invoice")}
                            </button>
                          </form>
                          <details class="mt-2">
                            <summary class="cursor-pointer text-primary hover:underline">
                              {t("Edit")}
                            </summary>
                            <p class="mt-2 text-sm text-muted">
                              {t(
                                "Fix a row the statement reader got wrong. The old values stay in the audit history."
                              )}
                            </p>
                            <form
                              method="POST"
                              action={actions.payments.editUnmatched}
                              class="mt-2 grid gap-2 sm:grid-cols-2"
                            >
                              <input
                                type="hidden"
                                name="organizationId"
                                value={organizationId}
                              />
                              <input
                                type="hidden"
                                name="transactionId"
                                value={tx.id}
                              />
                              <div>
                                <label
                                  class="block text-sm font-medium text-foreground"
                                  for={`edit-amount-${tx.id}`}
                                >
                                  {t("Amount")}
                                </label>
                                <input
                                  id={`edit-amount-${tx.id}`}
                                  name="amount"
                                  inputmode="decimal"
                                  required
                                  value={tx.amount}
                                  class="mt-1 w-full rounded-control border border-border px-3 py-1.5 text-sm"
                                />
                              </div>
                              <div>
                                <label
                                  class="block text-sm font-medium text-foreground"
                                  for={`edit-date-${tx.id}`}
                                >
                                  {t("Date")}
                                </label>
                                <input
                                  id={`edit-date-${tx.id}`}
                                  name="bookingDate"
                                  type="date"
                                  required
                                  max={today}
                                  value={tx.bookingDate}
                                  class="mt-1 w-full rounded-control border border-border px-3 py-1.5 text-sm"
                                />
                              </div>
                              <div>
                                <label
                                  class="block text-sm font-medium text-foreground"
                                  for={`edit-payer-${tx.id}`}
                                >
                                  {t("Payer")}
                                </label>
                                <input
                                  id={`edit-payer-${tx.id}`}
                                  name="payerName"
                                  maxlength="140"
                                  value={tx.payerName ?? ""}
                                  class="mt-1 w-full rounded-control border border-border px-3 py-1.5 text-sm"
                                />
                              </div>
                              <div>
                                <label
                                  class="block text-sm font-medium text-foreground"
                                  for={`edit-reference-${tx.id}`}
                                >
                                  {t("Reference")}
                                </label>
                                <input
                                  id={`edit-reference-${tx.id}`}
                                  name="reference"
                                  maxlength="140"
                                  value={tx.reference ?? ""}
                                  class="mt-1 w-full rounded-control border border-border px-3 py-1.5 text-sm"
                                />
                              </div>
                              <div class="sm:col-span-2">
                                <label
                                  class="block text-sm font-medium text-foreground"
                                  for={`edit-reason-${tx.id}`}
                                >
                                  {t("Reason for the change")}
                                </label>
                                <input
                                  id={`edit-reason-${tx.id}`}
                                  name="reason"
                                  required
                                  maxlength="500"
                                  class="mt-1 w-full rounded-control border border-border px-3 py-1.5 text-sm"
                                />
                              </div>
                              <div class="sm:col-span-2">
                                <button type="submit" class="btn-secondary">
                                  {t("Save changes")}
                                </button>
                              </div>
                            </form>
                          </details>
                        </td>
                      </tr>
                    ))
                  : shownMatches.map((m) => (
                      <tr>
                        <td class="font-semibold">
                          <div>
                            <a
                              href={`/admin/o/${organizationId}/periods/${m.periodId}/invoices/${m.invoiceId}`}
                              class="text-primary hover:underline"
                            >
                              {m.invoiceNumber}
                            </a>
                          </div>
                          <small class="text-muted">
                            {t("Amount due")}:{" "}
                            {formatMoney(
                              m.amountDue,
                              m.transactionCurrency,
                              locale
                            )}
                          </small>
                          {m.resultType !== "EXACT" && (
                            <small class="block text-muted">
                              {m.resultType === "PARTIAL"
                                ? t("Remaining after allocation")
                                : t("Credit created")}
                              :{" "}
                              {formatMoney(
                                m.resultType === "PARTIAL"
                                  ? m.remainingAfterAllocation
                                  : m.creditCreated,
                                m.transactionCurrency,
                                locale
                              )}
                            </small>
                          )}
                        </td>
                        <td class="text-right whitespace-nowrap font-medium">
                          {formatMoney(
                            m.transactionAmount,
                            m.transactionCurrency,
                            locale
                          )}
                        </td>
                        <td>
                          <div>{payer(m.transactionPayerName)}</div>
                          <a
                            href={`/admin/o/${organizationId}/dwellings/${m.dwellingId}`}
                            class="text-xs text-primary hover:underline"
                          >
                            {t("View dwelling")}
                          </a>
                        </td>
                        <td>{m.transactionReference ?? "—"}</td>
                        <td class="whitespace-nowrap">
                          {formatDate(m.transactionBookingDate, locale)}
                        </td>
                        <td>
                          <StatusBadge status={m.status} />
                        </td>
                        {view === "PROPOSED" && (
                          <td data-label={t("Actions")}>
                            <div class="flex gap-2">
                              <form
                                method="POST"
                                action={actions.payments.confirmMatch}
                              >
                                <input
                                  type="hidden"
                                  name="organizationId"
                                  value={organizationId}
                                />
                                <input
                                  type="hidden"
                                  name="matchId"
                                  value={m.id}
                                />
                                <button
                                  type="submit"
                                  class="btn-primary"
                                  data-confirm={t(
                                    "Confirm this payment? The invoice balance will be updated."
                                  )}
                                >
                                  {t("Confirm")}
                                </button>
                              </form>
                              <form
                                method="POST"
                                action={actions.payments.rejectMatch}
                              >
                                <input
                                  type="hidden"
                                  name="organizationId"
                                  value={organizationId}
                                />
                                <input
                                  type="hidden"
                                  name="matchId"
                                  value={m.id}
                                />
                                <button type="submit" class="btn-secondary">
                                  {t("Reject")}
                                </button>
                              </form>
                            </div>
                          </td>
                        )}
                        {view === "CONFIRMED" && (
                          <td data-label={t("Actions")}>
                            <details>
                              <summary class="cursor-pointer text-primary hover:underline">
                                {t("Reverse")}
                              </summary>
                              <form
                                method="POST"
                                action={actions.payments.reverseMatch}
                                class="mt-2 space-y-2"
                              >
                                <input
                                  type="hidden"
                                  name="organizationId"
                                  value={organizationId}
                                />
                                <input
                                  type="hidden"
                                  name="matchId"
                                  value={m.id}
                                />
                                <div>
                                  <label
                                    class="block text-sm font-medium text-foreground"
                                    for={`reverse-reason-${m.id}`}
                                  >
                                    {t("Reason for reversal")}
                                  </label>
                                  <input
                                    type="text"
                                    id={`reverse-reason-${m.id}`}
                                    name="reason"
                                    required
                                    maxlength="500"
                                    class="mt-1 rounded-control border border-border px-3 py-1.5 text-sm"
                                  />
                                </div>
                                <button
                                  type="submit"
                                  class="btn-secondary"
                                  data-confirm={t(
                                    "Reverse this payment? The original payment stays in the history and a cancelling entry is added. The invoice becomes unpaid again."
                                  )}
                                >
                                  {t("Reverse payment")}
                                </button>
                              </form>
                            </details>
                          </td>
                        )}
                      </tr>
                    ))}
              </tbody>
            </>
          </table>
        </div>
      )}
      {shownDirect.length > 0 && (
        <div class="mt-6">
          <h3 class="font-semibold">{t("Payments to an account")}</h3>
          <p class="text-sm text-muted">
            {t("Posted to the dwelling account, not to an invoice.")}
          </p>
          <div class="table-wrap stack-table mt-2">
            <table class="w-full text-left text-sm">
              <caption class="sr-only">{t("Payments to an account")}</caption>
              <thead>
                <tr>
                  <th scope="col">{t("Dwelling")}</th>
                  <th scope="col" class="text-right">
                    {t("Payment")}
                  </th>
                  <th scope="col">{t("Payer")}</th>
                  <th scope="col">{t("Reference")}</th>
                  <th scope="col">{t("Method")}</th>
                  <th scope="col">{t("Date")}</th>
                  <th scope="col">{t("Status")}</th>
                  {view === "CONFIRMED" && <th scope="col">{t("Actions")}</th>}
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                {shownDirect.map((p) => (
                  <tr>
                    <td class="font-semibold">
                      <a
                        href={`/admin/o/${organizationId}/dwellings/${p.dwellingId}`}
                        class="text-primary hover:underline"
                      >
                        {p.dwellingNumber}
                      </a>
                    </td>
                    <td class="text-right whitespace-nowrap font-medium">
                      {formatMoney(p.amount, p.currency, locale)}
                    </td>
                    <td>{p.payerName ?? "—"}</td>
                    <td>{p.reference ?? "—"}</td>
                    <td>
                      {p.paymentMethod === "CASH"
                        ? t("Cash")
                        : t("Bank transfer")}
                    </td>
                    <td class="whitespace-nowrap">
                      {formatDate(p.bookingDate, locale)}
                    </td>
                    <td>
                      <StatusBadge
                        status={p.reversed ? "REVERSED" : "CONFIRMED"}
                      />
                    </td>
                    {view === "CONFIRMED" && (
                      <td data-label={t("Actions")}>
                        <details>
                          <summary class="cursor-pointer text-primary hover:underline">
                            {t("Reverse")}
                          </summary>
                          <form
                            method="POST"
                            action={actions.payments.reverseDwellingPayment}
                            class="mt-2 space-y-2"
                          >
                            <input
                              type="hidden"
                              name="organizationId"
                              value={organizationId}
                            />
                            <input
                              type="hidden"
                              name="transactionId"
                              value={p.id}
                            />
                            <div>
                              <label
                                class="block text-sm font-medium text-foreground"
                                for={`reverse-direct-reason-${p.id}`}
                              >
                                {t("Reason for reversal")}
                              </label>
                              <input
                                type="text"
                                id={`reverse-direct-reason-${p.id}`}
                                name="reason"
                                required
                                maxlength="500"
                                class="mt-1 rounded-control border border-border px-3 py-1.5 text-sm"
                              />
                            </div>
                            <button
                              type="submit"
                              class="btn-secondary"
                              data-confirm={t(
                                "Reverse this payment? The original payment stays in the history and a cancelling entry is added. The dwelling account goes back to its balance before the payment."
                              )}
                            >
                              {t("Reverse payment")}
                            </button>
                          </form>
                        </details>
                      </td>
                    )}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}
    </section>
    <section class="mt-8">
      <h2 class="section-title">{t("Import history")}</h2>
      {imports.length === 0 ? (
        <EmptyState title={t("No imports yet.")} />
      ) : (
        <div class="table-wrap stack-table">
          <table class="w-full text-left text-sm">
            <caption class="sr-only">{t("Import history")}</caption>
            <>
              <thead>
                <tr>
                  <>
                    <th scope="col">{t("Filename")}</th>
                    <th scope="col">{t("Imported")}</th>
                    <th scope="col" class="text-right">
                      {t("Rows")}
                    </th>
                    <th scope="col">{t("Actions")}</th>
                  </>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                {imports.map((imp) => (
                  <tr>
                    <td class="font-medium">{imp.originalFilename}</td>
                    <td>
                      {formatDate(
                        imp.importedAt,
                        locale,
                        organization.timezone
                      )}
                    </td>
                    <td class="text-right">{imp.rowCount}</td>
                    <td class="text-right">
                      <a
                        href={
                          "/admin/o/" +
                          organizationId +
                          "/payments/imports/" +
                          imp.id
                        }
                      >
                        {t("View")} →
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </>
          </table>
        </div>
      )}
    </section>
  </div>
</AdminLayout>

<style>
  .edit-disclosure {
    position: relative;
    flex: 0 0 auto;
  }
  .edit-disclosure summary {
    list-style: none;
    cursor: pointer;
  }
  .edit-disclosure summary::-webkit-details-marker {
    display: none;
  }
  .edit-disclosure-panel {
    position: absolute;
    z-index: 15;
    top: calc(100% + 0.5rem);
    right: 0;
    width: min(28rem, 90vw);
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
    background: var(--color-surface);
    box-shadow: var(--shadow-panel);
  }
</style>
