---
import { translate } from "../../../../../../lib/ui/i18n";
const t = (text: string) => translate(locale, text);
// Phase J (Payments) - bank import detail.
import StatusBadge from "../../../../../../components/ui/StatusBadge.astro";
import {
  uiLocale,
  formatDate,
  formatMoney,
} from "../../../../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
import AdminLayout from "../../../../../../layouts/AdminLayout.astro";
import {
  ForbiddenError,
  requireOrganizationAccess,
} from "../../../../../../domain/authorization/guards";
import { getOrganization } from "../../../../../../domain/organizations/organizations";
import {
  getBankImport,
  listTransactionsForImport,
} from "../../../../../../domain/payments/bank-import";
import { withRequestDb } from "../../../../../../lib/db-request";

const organizationId = Astro.params.orgId!;
const importId = Astro.params.importId!;
try {
  requireOrganizationAccess(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

let organization: Awaited<ReturnType<typeof getOrganization>>;
let bankImport: Awaited<ReturnType<typeof getBankImport>>;
let transactions: Awaited<ReturnType<typeof listTransactionsForImport>>;
try {
  ({ organization, bankImport, transactions } = await withRequestDb(
    async (db) => ({
      organization: await getOrganization(db, organizationId),
      bankImport: await getBankImport(db, organizationId, importId),
      transactions: await listTransactionsForImport(
        db,
        organizationId,
        importId
      ),
    })
  ));
} catch {
  return Astro.redirect(`/admin/o/${organizationId}/payments`);
}
---

<AdminLayout
  title={`Import - ${organization.name}`}
  organizationId={organizationId}
  organizationName={organization.name}
>
  <div class="space-y-6">
    <a
      href={`/admin/o/${organizationId}/payments`}
      class="text-sm text-muted hover:underline"
    >
      ← {t("Payments")}
    </a>

    <div>
      <h1 class="text-xl font-bold text-foreground">
        {bankImport.originalFilename}
      </h1>
      <p class="text-sm text-muted">
        Imported {
          formatDate(bankImport.importedAt, locale, organization.timezone)
        } -- {bankImport.rowCount} row(s)
      </p>
    </div>

    <div class="table-wrap">
      <table class="w-full text-left text-sm">
        <thead
          class="border-b border-border bg-surface-hover text-muted"
        >
          <tr>
            <th class="px-4 py-2">{t("Row")}</th>
            <th class="px-4 py-2">{t("Booking date")}</th>
            <th class="px-4 py-2 text-right">{t("Amount")}</th>
            <th class="px-4 py-2">{t("Currency")}</th>
            <th class="px-4 py-2">{t("Payer")}</th>
            <th class="px-4 py-2">{t("Reference")}</th>
            <th class="px-4 py-2">{t("Match status")}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          {
            transactions.map((tx) => {
              return (
                <tr>
                  <td class="px-4 py-2">{tx.rowNumber}</td>
                  <td class="px-4 py-2">
                    {formatDate(tx.bookingDate, locale)}
                  </td>
                  <td class="px-4 py-2">
                    {formatMoney(tx.amount, tx.currency, locale)}
                  </td>
                  <td class="px-4 py-2">{tx.currency}</td>
                  <td class="px-4 py-2">{tx.payerName ?? "—"}</td>
                  <td class="px-4 py-2">{tx.reference ?? "—"}</td>
                  <td class="px-4 py-2">
                    <StatusBadge status={tx.matchStatus ?? "UNMATCHED"} />
                  </td>
                </tr>
              );
            })
          }
          {
            transactions.length === 0 && (
              <tr>
                <td colspan="7" class="px-4 py-8 text-center text-muted">
                  {t("No transactions in this import.")}
                </td>
              </tr>
            )
          }
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>
