---
// Phase K (Messaging) - admin inbox (spec Section 13.19, 35 MSG-001/002).
// This single page replaces the old separate list + [conversationId] pages
// with a two-pane inbox: the list on the left always renders, the right
// pane shows whichever conversation ?conversationId= points at (or the
// first result in the current filter, or a "new message" form when
// ?new=1 is set), all via ordinary GET navigation -- no client JS needed
// to switch panes.
import StatusBadge from "../../../../../components/ui/StatusBadge.astro";
import FieldError from "../../../../../components/ui/FieldError.astro";
import Icon from "../../../../../components/ui/Icon.astro";
import PageHeader from "../../../../../components/ui/PageHeader.astro";
import { invoiceStatusBadge } from "../../../../../lib/ui/invoice-status";
import {
  translate,
  uiLocale,
  formatDate,
  formatDateTime,
  formatNumber,
  entityLabel,
} from "../../../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import { actions } from "astro:actions";
import {
  ForbiddenError,
  requireOrganizationAccess,
} from "../../../../../domain/authorization/guards";
import { getOrganization } from "../../../../../domain/organizations/organizations";
import { listDwellings } from "../../../../../domain/organizations/dwellings";
import {
  listConversationsForOrganization,
  getConversationForAdmin,
  listMessagesForConversation,
  markConversationRead,
} from "../../../../../domain/messaging/conversations";
import { withRequestDb } from "../../../../../lib/db-request";

const organizationId = Astro.params.orgId!;
try {
  requireOrganizationAccess(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const replyResult = Astro.getActionResult(actions.messages.reply);
const resolveResult = Astro.getActionResult(actions.messages.resolve);
const createResult = Astro.getActionResult(
  actions.messages.createConversationAdmin
);

// Post-redirect-get after a successful mutation -- same reason as every
// other action-backed page in this app: a refresh must not resubmit.
if (
  (replyResult && !replyResult.error) ||
  (resolveResult && !resolveResult.error) ||
  (createResult && !createResult.error)
) {
  const redirectUrl = new URL(Astro.url);
  redirectUrl.searchParams.delete("new");
  if (createResult?.data?.id) {
    redirectUrl.searchParams.set("conversationId", createResult.data.id);
  }
  return Astro.redirect(redirectUrl.pathname + redirectUrl.search);
}

const search = Astro.url.searchParams.get("search")?.trim() ?? "";
const rawStatus = Astro.url.searchParams.get("status");
const statusFilter =
  rawStatus === "OPEN" || rawStatus === "RESOLVED" ? rawStatus : undefined;
const unreadOnly = Astro.url.searchParams.get("unread") === "1";
const showNewForm = Astro.url.searchParams.get("new") === "1";
const UUID_PATTERN =
  /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const rawDwellingId = Astro.url.searchParams.get("dwellingId");
const dwellingIdFilter =
  rawDwellingId && UUID_PATTERN.test(rawDwellingId) ? rawDwellingId : undefined;
const rawConversationId = Astro.url.searchParams.get("conversationId");
const requestedConversationId =
  rawConversationId && UUID_PATTERN.test(rawConversationId)
    ? rawConversationId
    : undefined;

// An explicitly requested conversation (a list click, or a redirect right
// after creating one) is marked read before the list below is fetched, so
// the list's unread dot reflects the just-applied read state instead of
// what it was before this request. An auto-selected conversation (no
// conversationId in the URL, just the top result of the current filter)
// can't be marked read until after the list exists to pick it from --
// its own dot lags by one request in that case, same as most inbox UIs.
if (requestedConversationId) {
  await withRequestDb((db) =>
    markConversationRead(db, organizationId, requestedConversationId)
  );
}

const { organization, allConversations, dwellingsForNewMessage } =
  await withRequestDb(async (db) => ({
    organization: await getOrganization(db, organizationId),
    allConversations: await listConversationsForOrganization(
      db,
      organizationId,
      { dwellingId: dwellingIdFilter }
    ),
    dwellingsForNewMessage: showNewForm
      ? await listDwellings(db, organizationId, { limit: 500 })
      : [],
  }));

const filtered = allConversations
  .filter((c) => {
    if (statusFilter === "OPEN") return c.status !== "RESOLVED";
    if (statusFilter === "RESOLVED") return c.status === "RESOLVED";
    return true;
  })
  .filter((c) => !unreadOnly || c.hasUnread)
  .filter((c) => {
    if (!search) return true;
    const needle = search.toLowerCase();
    return (
      c.subject.toLowerCase().includes(needle) ||
      Boolean(c.lastMessage?.body.toLowerCase().includes(needle)) ||
      Boolean(c.occupantName?.toLowerCase().includes(needle))
    );
  });

const allCount = allConversations.length;
const openCount = allConversations.filter(
  (c) => c.status !== "RESOLVED"
).length;
const resolvedCount = allConversations.filter(
  (c) => c.status === "RESOLVED"
).length;

const selectedId =
  requestedConversationId ??
  (showNewForm ? undefined : filtered[0]?.id) ??
  undefined;

let selectedConversation: Awaited<
  ReturnType<typeof getConversationForAdmin>
> | null = null;
let selectedMessages: Awaited<ReturnType<typeof listMessagesForConversation>> =
  [];
if (selectedId) {
  try {
    ({ selectedConversation, selectedMessages } = await withRequestDb(
      async (db) => {
        const conversation = await getConversationForAdmin(
          db,
          organizationId,
          selectedId
        );
        await markConversationRead(db, organizationId, selectedId);
        const msgs = await listMessagesForConversation(db, selectedId);
        return { selectedConversation: conversation, selectedMessages: msgs };
      }
    ));
  } catch {
    selectedConversation = null;
  }
}

function filterHref(overrides: Record<string, string | undefined> = {}) {
  const params = new URLSearchParams();
  if (search) params.set("search", search);
  if (statusFilter) params.set("status", statusFilter);
  if (unreadOnly) params.set("unread", "1");
  if (dwellingIdFilter) params.set("dwellingId", dwellingIdFilter);
  for (const [key, value] of Object.entries(overrides)) {
    if (value === undefined) params.delete(key);
    else params.set(key, value);
  }
  const query = params.toString();
  return query ? `${Astro.url.pathname}?${query}` : Astro.url.pathname;
}

function senderLabel(
  message: { senderRole: string },
  conversation: { occupantName: string | null }
) {
  return message.senderRole === "ADMIN"
    ? t("Admin")
    : (conversation.occupantName ?? t("Resident"));
}

// Handed to the client script as JSON so it can rebuild a <StatusBadge>-
// equivalent element in place when polling picks up a status change,
// without duplicating the label/tone/icon strings in the script itself.
const conversationStatusMap = Object.fromEntries(
  (["NEW", "OPEN", "RESOLVED"] as const).map((status) => {
    const badge = invoiceStatusBadge(status);
    return [
      status,
      {
        label: translate(locale, badge.label),
        tone: badge.tone,
        icon: badge.icon,
      },
    ];
  })
);
---

<AdminLayout
  title={`${t("Messages")} - ${organization.name}`}
  organizationId={organizationId}
  organizationName={organization.name}
>
  <div
    class="messages-page"
    data-organization-id={organizationId}
    data-status-map={JSON.stringify(conversationStatusMap)}
    data-admin-label={t("Admin")}
    data-resident-label={t("Resident")}
  >
    <div class="space-y-6">
      <nav class="breadcrumb" aria-label={t("Breadcrumb")}>
        <a href={`/admin/o/${organizationId}/dashboard`}>{t("Dashboard")}</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{t("Messages")}</span>
      </nav>
      <PageHeader
        title={t("Messages")}
        description={t(
          "Review resident questions, send updates, and keep billing conversations in context."
        )}
        display
      >
        <a href={filterHref({ new: "1" })} class="btn-primary">
          <Icon name="plus" size="sm" />
          {t("New message")}
        </a>
      </PageHeader>
    </div>

    {
      dwellingIdFilter && (
        <p class="notice">
          {t("Showing conversations for one dwelling only.")}{" "}
          <a href={`/admin/o/${organizationId}/messages`} class="clear-filters">
            {t("Clear")}
          </a>
        </p>
      )
    }

    <form method="GET" class="filter-bar" data-instant-filter>
      <div>
        <label class="block text-label text-foreground" for="search"
          >{t("Search")}</label
        >
        <input
          id="search"
          name="search"
          value={search}
          placeholder={t("Search messages by subject or content...")}
          autocomplete="off"
          class="mt-1 rounded-control border border-border px-3 py-1.5 text-body-sm"
        />
      </div>
      <div>
        <label class="block text-label" for="status-filter">{t("Status")}</label
        >
        <select
          id="status-filter"
          name="status"
          class="mt-1 rounded-control border border-border px-3 py-2 text-body-sm"
        >
          <option value="">{t("All statuses")}</option>
          <option value="OPEN" selected={statusFilter === "OPEN"}
            >{t("Open")}</option
          >
          <option value="RESOLVED" selected={statusFilter === "RESOLVED"}
            >{t("Resolved")}</option
          >
        </select>
      </div>
      <label class="flex items-center gap-2 pb-2 text-body-sm text-foreground">
        <input
          id="unread-only"
          type="checkbox"
          name="unread"
          value="1"
          checked={unreadOnly}
        />
        {t("Show unread only")}
      </label>
      {
        (search || statusFilter || unreadOnly) && (
          <a
            href={filterHref({
              search: undefined,
              status: undefined,
              unread: undefined,
            })}
            class="clear-filters"
          >
            {t("Clear filters")}
          </a>
        )
      }
    </form>

    <nav class="messages-tabs" aria-label={t("Filter by status")}>
      <a
        href={filterHref({ status: undefined })}
        aria-current={!statusFilter ? "page" : undefined}
      >
        {t("All")} ({allCount})
      </a>
      <a
        href={filterHref({ status: "OPEN" })}
        aria-current={statusFilter === "OPEN" ? "page" : undefined}
      >
        {t("Open")} ({openCount})
      </a>
      <a
        href={filterHref({ status: "RESOLVED" })}
        aria-current={statusFilter === "RESOLVED" ? "page" : undefined}
      >
        {t("Resolved")} ({resolvedCount})
      </a>
    </nav>

    <div class="messages-split">
      <div class="messages-list-pane">
        {
          filtered.map((c) => (
            <a
              href={filterHref({ conversationId: c.id, new: undefined })}
              class="messages-list-item"
              aria-current={c.id === selectedId ? "true" : undefined}
            >
              <div class="messages-list-item-head">
                <span class="messages-list-item-title">
                  {c.hasUnread && (
                    <span class="unread-dot" aria-hidden="true" />
                  )}
                  <Icon name="building" class="messages-house-icon" />
                  {t("Dwelling")} {c.dwellingNumber}
                </span>
                <StatusBadge status={c.status} />
              </div>
              <p class="messages-list-item-subject">{c.subject}</p>
              {c.occupantName && (
                <p class="messages-list-item-occupant">{c.occupantName}</p>
              )}
              <div class="messages-list-item-foot">
                <span class="messages-list-item-preview">
                  {c.lastMessage?.body}
                </span>
                <span class="messages-list-item-date">
                  {formatDate(c.updatedAt, locale, organization.timezone)}
                </span>
              </div>
            </a>
          ))
        }
        {
          filtered.length === 0 && (
            <p class="messages-empty">
              {t("No conversations match this filter.")}
            </p>
          )
        }
      </div>

      <div class="messages-detail-pane">
        {
          showNewForm ? (
            <div class="messages-new">
              <h2>{t("New message")}</h2>
              {createResult?.error && (
                <p class="notice notice-danger" role="alert">
                  {createResult.error.message}
                </p>
              )}
              <form
                method="POST"
                action={actions.messages.createConversationAdmin}
                class="messages-new-form"
              >
                <input
                  type="hidden"
                  name="organizationId"
                  value={organizationId}
                />
                <div>
                  <label for="new-dwelling">{t("Dwelling")}</label>
                  <select id="new-dwelling" name="dwellingId" required>
                    {dwellingsForNewMessage.map((d) => (
                      <option value={d.id}>
                        {d.number} — {d.occupantName ?? t("No resident")}
                      </option>
                    ))}
                  </select>
                  <FieldError name="dwellingId" error={createResult?.error} />
                </div>
                <div>
                  <label for="new-subject">{t("Subject")}</label>
                  <input
                    id="new-subject"
                    name="subject"
                    required
                    maxlength="200"
                  />
                  <FieldError name="subject" error={createResult?.error} />
                </div>
                <div>
                  <label for="new-body">{t("Message")}</label>
                  <textarea id="new-body" name="body" required rows={5} />
                  <FieldError name="body" error={createResult?.error} />
                </div>
                <div class="messages-reply-actions">
                  <a
                    href={filterHref({ new: undefined })}
                    class="btn-secondary"
                  >
                    {t("Cancel")}
                  </a>
                  <button type="submit" class="btn-primary">
                    {t("Send message")}
                  </button>
                </div>
              </form>
            </div>
          ) : selectedConversation ? (
            <>
              <div class="messages-detail-header">
                <h2>{selectedConversation.subject}</h2>
                <span id="detail-status-badge">
                  <StatusBadge status={selectedConversation.status} />
                </span>
                <details class="row-menu">
                  <summary aria-label={t("More actions")}>•••</summary>
                  <div>
                    <a
                      href={`/admin/o/${organizationId}/dwellings/${selectedConversation.dwellingId}`}
                    >
                      {t("Open dwelling")}
                    </a>
                  </div>
                </details>
              </div>

              <div class="messages-dwelling-card">
                <span class="messages-dwelling-icon" aria-hidden="true">
                  <Icon name="building" />
                </span>
                <div>
                  <p class="messages-dwelling-card-title">
                    {t("Dwelling")} {selectedConversation.dwellingNumber}
                  </p>
                  <p class="messages-dwelling-card-sub">
                    {entityLabel(selectedConversation.dwellingType, locale)}
                    {" · "}
                    {formatNumber(
                      selectedConversation.dwellingAreaM2 ?? 0,
                      locale,
                      2
                    )}{" "}
                    m²
                  </p>
                </div>
                <div>
                  <p
                    id="conversation-occupant-name"
                    class="messages-dwelling-card-title"
                  >
                    {selectedConversation.occupantName ?? t("No resident")}
                  </p>
                  <p class="messages-dwelling-card-sub">
                    {t("Updated")}{" "}
                    {formatDate(
                      selectedConversation.updatedAt,
                      locale,
                      organization.timezone
                    )}
                  </p>
                </div>
              </div>

              <div class="messages-actions">
                <a
                  class="btn-secondary btn-sm"
                  href={`/admin/o/${organizationId}/dwellings/${selectedConversation.dwellingId}`}
                >
                  <span aria-hidden="true">↗</span> {t("Open dwelling")}
                </a>
              </div>

              <p
                id="messages-error"
                class="notice notice-danger"
                role="alert"
                hidden={!(replyResult?.error || resolveResult?.error)}
              >
                {replyResult?.error?.message ?? resolveResult?.error?.message}
              </p>

              <div
                id="message-thread"
                class="messages-thread"
                data-conversation-id={selectedConversation.id}
                data-status={selectedConversation.status}
              >
                {selectedMessages.map((m) => (
                  <div
                    class="message-row"
                    data-message-id={m.id}
                    data-mine={m.senderRole === "ADMIN" ? "true" : "false"}
                  >
                    <span
                      class="message-avatar"
                      data-role={m.senderRole}
                      aria-hidden="true"
                    >
                      {m.senderRole === "ADMIN" ? "A" : "R"}
                    </span>
                    <div class="message-col">
                      <p class="message-meta">
                        <strong>{senderLabel(m, selectedConversation)}</strong>
                        <span>
                          {formatDateTime(
                            m.createdAt,
                            locale,
                            organization.timezone
                          )}
                        </span>
                      </p>
                      <div class="message-bubble">{m.body}</div>
                    </div>
                  </div>
                ))}
              </div>

              <div
                id="reply-section"
                class="messages-reply"
                hidden={selectedConversation.status === "RESOLVED"}
              >
                <h3>{t("Reply")}</h3>
                <form
                  id="reply-form"
                  method="POST"
                  action={actions.messages.reply}
                >
                  <input
                    type="hidden"
                    name="conversationId"
                    value={selectedConversation.id}
                  />
                </form>
                <textarea
                  name="body"
                  form="reply-form"
                  required
                  placeholder={t("Type your reply...")}
                />
                <form
                  id="resolve-form"
                  method="POST"
                  action={actions.messages.resolve}
                >
                  <input
                    type="hidden"
                    name="organizationId"
                    value={organizationId}
                  />
                  <input
                    type="hidden"
                    name="conversationId"
                    value={selectedConversation.id}
                  />
                </form>
                <div class="messages-reply-actions">
                  <button
                    type="submit"
                    form="resolve-form"
                    class="btn-secondary"
                  >
                    {t("Mark resolved")}
                  </button>
                  <button type="submit" form="reply-form" class="btn-primary">
                    {t("Send reply")}
                  </button>
                </div>
              </div>
              <p
                id="resolved-notice"
                class="messages-resolved-notice"
                hidden={selectedConversation.status !== "RESOLVED"}
              >
                {t("This conversation is resolved.")}
              </p>
            </>
          ) : (
            <p class="messages-empty">
              {t("Select a conversation to view it here.")}
            </p>
          )
        }
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { actions, isInputError } from "astro:actions";
  import { ICONS, type IconName } from "../../../../../lib/ui/icons";
  import { onPageLoad } from "../../../../../lib/ui/page-lifecycle";

  // Static, developer-authored path data only (never user input) -- see
  // the equivalent helper in lib/ui/workbench-drawer.ts.
  function iconSvg(name: IconName): SVGSVGElement {
    const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    svg.setAttribute("viewBox", "0 0 24 24");
    svg.setAttribute("fill", "none");
    svg.setAttribute("stroke", "currentColor");
    svg.setAttribute("stroke-width", "1.75");
    svg.setAttribute("stroke-linecap", "round");
    svg.setAttribute("stroke-linejoin", "round");
    svg.innerHTML = ICONS[name];
    return svg;
  }

  onPageLoad(() => {
    if (!document.querySelector(".messages-page")) return;

    const filterForm = document.querySelector<HTMLFormElement>(
      "[data-instant-filter]"
    );
    const searchInput = document.querySelector<HTMLInputElement>("#search");
    const statusSelect = document.querySelector("#status-filter");
    const unreadCheckbox = document.querySelector("#unread-only");
    let searchTimer: number | undefined;
    searchInput?.addEventListener("input", () => {
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(() => filterForm?.requestSubmit(), 300);
    });
    statusSelect?.addEventListener("change", () => filterForm?.requestSubmit());
    unreadCheckbox?.addEventListener("change", () =>
      filterForm?.requestSubmit()
    );

    // Live thread + status updates for the open conversation. Polling (not a
    // websocket/Supabase Realtime subscription) because this app has no
    // realtime infrastructure anywhere else -- a plain JSON action polled on
    // an interval is the lowest-risk way to get "the other side's messages
    // and status changes show up without a reload" on a Cloudflare Worker
    // that doesn't hold long-lived connections.
    const pageEl = document.querySelector<HTMLElement>(".messages-page");
    const threadEl = document.querySelector<HTMLElement>("#message-thread");
    const organizationId = pageEl?.dataset.organizationId;
    const conversationId = threadEl?.dataset.conversationId;
    const statusMap: Record<
      string,
      { label: string; tone: string; icon: IconName }
    > = pageEl?.dataset.statusMap ? JSON.parse(pageEl.dataset.statusMap) : {};
    const adminLabel = pageEl?.dataset.adminLabel ?? "Admin";
    const residentLabel = pageEl?.dataset.residentLabel ?? "Resident";
    const occupantNameEl = document.querySelector<HTMLElement>(
      "#conversation-occupant-name"
    );
    let occupantName = occupantNameEl?.textContent?.trim() || null;
    let knownStatus = threadEl?.dataset.status;
    const knownMessageIds = new Set(
      [...document.querySelectorAll<HTMLElement>("[data-message-id]")].map(
        (el) => el.dataset.messageId!
      )
    );

    function renderStatusBadge(badge: Element, status: string) {
      const info = statusMap[status];
      if (!info) return;
      badge.setAttribute("data-tone", info.tone);
      badge.replaceChildren();
      const icon = document.createElement("span");
      icon.setAttribute("aria-hidden", "true");
      icon.appendChild(iconSvg(info.icon));
      badge.appendChild(icon);
      badge.appendChild(document.createTextNode(info.label));
    }

    function applyStatus(status: string) {
      knownStatus = status;
      if (threadEl) threadEl.dataset.status = status;
      const detailBadge = document.querySelector(
        "#detail-status-badge .status-badge"
      );
      if (detailBadge) renderStatusBadge(detailBadge, status);
      const listBadge = document.querySelector(
        '.messages-list-item[aria-current="true"] .status-badge'
      );
      if (listBadge) renderStatusBadge(listBadge, status);
      const replySection =
        document.querySelector<HTMLElement>("#reply-section");
      if (replySection) replySection.hidden = status === "RESOLVED";
      const resolvedNotice =
        document.querySelector<HTMLElement>("#resolved-notice");
      if (resolvedNotice) resolvedNotice.hidden = status !== "RESOLVED";
    }

    function showError(message: string) {
      const errorEl = document.querySelector<HTMLElement>("#messages-error");
      if (!errorEl) return;
      errorEl.textContent = message;
      errorEl.hidden = false;
    }

    function appendMessage(message: {
      id: string;
      body: string;
      createdAt: string | Date;
      senderRole: string;
    }) {
      if (!threadEl || knownMessageIds.has(message.id)) return;
      knownMessageIds.add(message.id);
      const isAdmin = message.senderRole === "ADMIN";
      const row = document.createElement("div");
      row.className = "message-row";
      row.dataset.messageId = message.id;
      row.dataset.mine = isAdmin ? "true" : "false";
      const avatar = document.createElement("span");
      avatar.className = "message-avatar";
      avatar.dataset.role = message.senderRole;
      avatar.setAttribute("aria-hidden", "true");
      avatar.textContent = isAdmin ? "A" : "R";
      const col = document.createElement("div");
      col.className = "message-col";
      const meta = document.createElement("p");
      meta.className = "message-meta";
      const strong = document.createElement("strong");
      strong.textContent = isAdmin
        ? adminLabel
        : (occupantName ?? residentLabel);
      const time = document.createElement("span");
      time.textContent = new Intl.DateTimeFormat(navigator.language, {
        dateStyle: "medium",
        timeStyle: "short",
      }).format(new Date(message.createdAt));
      meta.appendChild(strong);
      meta.appendChild(time);
      const bubble = document.createElement("div");
      bubble.className = "message-bubble";
      bubble.textContent = message.body;
      col.appendChild(meta);
      col.appendChild(bubble);
      row.appendChild(avatar);
      row.appendChild(col);
      threadEl.appendChild(row);
    }

    async function poll() {
      if (!organizationId || !conversationId || document.hidden) return;
      const { data, error } = await actions.messages.getThread({
        organizationId,
        conversationId,
      });
      if (error || !data) return;
      if (data.occupantName) occupantName = data.occupantName;
      for (const message of data.messages) appendMessage(message);
      if (data.status !== knownStatus) applyStatus(data.status);
    }

    const pollTimer =
      organizationId && conversationId
        ? window.setInterval(poll, 4000)
        : undefined;

    const replyForm = document.querySelector<HTMLFormElement>("#reply-form");
    const replyTextarea = document.querySelector<HTMLTextAreaElement>(
      'textarea[form="reply-form"]'
    );
    const replyButton = document.querySelector<HTMLButtonElement>(
      'button[form="reply-form"]'
    );
    replyForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!replyTextarea?.value.trim()) return;
      const formData = new FormData(replyForm);
      if (replyButton) replyButton.disabled = true;
      const { data, error } = await actions.messages.reply(formData);
      if (replyButton) replyButton.disabled = false;
      if (error) {
        const message = isInputError(error)
          ? (error.fields.body?.join(" ") ?? error.message)
          : error.message;
        showError(message);
        return;
      }
      if (replyTextarea) replyTextarea.value = "";
      appendMessage({ ...data, senderRole: "ADMIN" });
      if (knownStatus === "NEW") applyStatus("OPEN");
    });

    const resolveForm =
      document.querySelector<HTMLFormElement>("#resolve-form");
    const resolveButton = document.querySelector<HTMLButtonElement>(
      'button[form="resolve-form"]'
    );
    resolveForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const formData = new FormData(resolveForm);
      if (resolveButton) resolveButton.disabled = true;
      const { error } = await actions.messages.resolve(formData);
      if (resolveButton) resolveButton.disabled = false;
      if (error) {
        showError(error.message);
        return;
      }
      applyStatus("RESOLVED");
    });
    return () => {
      window.clearTimeout(searchTimer);
      if (pollTimer !== undefined) window.clearInterval(pollTimer);
    };
  });
</script>

