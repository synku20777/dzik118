        <div class="card-header">
          <h2 id="tariffs-title">{t("Recurring tariffs")}</h2>
          <a href={`${base}/settings/rules`} class="btn-secondary">
            {t("View all tariffs")}
          </a>
        </div>
        {currentTariffs.length === 0 ? (
          <EmptyState
            title={t("No recurring tariffs apply to this dwelling.")}
          />
        ) : (
          <Fragment>
            {automaticTariffs.length > 0 && (
              <Fragment>
                <h3 class="tariff-group-heading">
                  {t("Automatically applied")}
                </h3>
                <ul class="item-list tariff-list">
                  {automaticTariffs.map((rule) => (
                    <li>
                      <div class="item-body">
                        <strong>{rule.name}</strong>
                        <span>{tariffPriceSummary(rule)}</span>
                      </div>
                      <a
                        href={`${base}/settings/rules?edit=${rule.id}`}
                        class="item-action"
                      >
                        {t("Edit tariff")}
                      </a>
                    </li>
                  ))}
                </ul>
              </Fragment>
            )}
            {assignedTariffs.length > 0 && (
              <Fragment>
                <h3 class="tariff-group-heading">
                  {t("Assigned specifically")}
                </h3>
                <ul class="item-list tariff-list">
                  {assignedTariffs.map((rule) => (
                    <li>
                      <div class="item-body">
                        <strong>{rule.name}</strong>
                        <span>
                          {tariffPriceSummary(rule)} ·{" "}
                          {tariffScopeReason(rule.applicationScope)}
                        </span>
                      </div>
                      <a
                        href={`${base}/settings/rules?edit=${rule.id}`}
                        class="item-action"
                      >
                        {t("Edit tariff")}
                      </a>
                    </li>
                  ))}
                </ul>
              </Fragment>
            )}
          </Fragment>
        )}
      </section>
    </div>

    <!-- Messages -->
    <div
      class="tab-panel"
      role="tabpanel"
      id="panel-messages"
      aria-labelledby="tab-messages"
      data-tabpanel="messages"
      hidden={activeTab !== "messages"}
    >
      <section id="messages" class="panel p-6" aria-labelledby="messages-title">
        <div class="card-header">
          <h2 id="messages-title">{t("Recent messages")}</h2>
          <a
            class="btn-secondary"
            href={`${base}/messages?dwellingId=${dwellingId}`}
          >
            {t("View all")}
          </a>
        </div>
        {recentMessages.length > 0 ? (
          <ul class="message-preview-list">
            {recentMessages.map((m) => (
              <li>
                <p data-tip-clipped>{m.body}</p>
                <span>
                  {formatDate(m.createdAt, locale, organization.timezone)}
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <EmptyState class="mt-4" title={t("No messages yet")} />
        )}
      </section>
    </div>

    <!-- History: billing periods and recorded changes. -->
    <div
      class="tab-panel history-stack"
      role="tabpanel"
      id="panel-history"
      aria-labelledby="tab-history"
      data-tabpanel="history"
      hidden={activeTab !== "history"}
    >
      <section
        id="period-history"
        class="panel p-6"
        aria-labelledby="period-history-title"
      >
        <h2 id="period-history-title">{t("Period history")}</h2>
        {caseHistory.length > 0 ? (
          <div class="table-wrap stack-table mt-4">
            <table class="w-full text-left text-body-sm">
              <caption class="sr-only">{t("Period history")}</caption>
              <thead>
                <tr>
                  <th scope="col" class="px-4 py-2">
                    {t("Period")}
                  </th>
                  <th scope="col" class="px-4 py-2">
                    {t("Status")}
                  </th>
                  <th scope="col" class="px-4 py-2">
                    {t("Invoice")}
                  </th>
                  <th scope="col" class="px-4 py-2 text-right">
                    {t("Amount due")}
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                {caseHistory.map((c) => (
                  <tr>
                    <td class="px-4 py-2">
                      {c.periodYear}-{String(c.periodMonth).padStart(2, "0")}
                    </td>
                    <td class="px-4 py-2">
                      <StatusBadge status={c.status} />
                    </td>
                    <td class="px-4 py-2">
                      {c.invoiceId ? (
                        <a
                          href={`${base}/periods/${c.periodId}/invoices/${c.invoiceId}`}
                          class="text-primary hover:underline"
                        >
                          {c.invoiceNumber}
                        </a>
                      ) : (
                        <a
                          href={`${base}/periods/${c.periodId}`}
                          class="text-primary hover:underline"
                        >
                          {t("Open workbench")}
                        </a>
                      )}
                    </td>
                    <td class="px-4 py-2 text-right">
                      {c.invoiceAmountDue
                        ? formatMoney(
                            c.invoiceAmountDue,
                            organization.currency,
                            locale
                          )
                        : "—"}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <EmptyState title={t("No billing periods yet.")} />
        )}
      </section>

      <section
        id="audit-history"
        class="panel p-6"
        aria-labelledby="audit-history-title"
      >
        <h2 id="audit-history-title">{t("Audit history")}</h2>
        {auditEntries.length > 0 ? (
          <Fragment>
            <ol class="audit-list">
              {auditEntries.slice(0, AUDIT_VISIBLE).map((log) => (
                <li>
                  <span class="audit-action">
                    {auditActionLabel(log.action)}
                  </span>
                  <span class="audit-meta">
                    {log.actorDisplayName ?? log.actorEmail ?? "—"} ·{" "}
                    <time datetime={log.createdAt.toISOString()}>
                      {formatDate(log.createdAt, locale, organization.timezone)}
                    </time>
                  </span>
                </li>
              ))}
            </ol>
            {auditEntries.length > AUDIT_VISIBLE && (
              <details class="audit-more">
                <summary class="chevron-toggle">
                  {t("Show earlier changes ({count})").replace(
                    "{count}",
                    String(auditEntries.length - AUDIT_VISIBLE)
                  )}
                </summary>
                <ol class="audit-list" start={AUDIT_VISIBLE + 1}>
                  {auditEntries.slice(AUDIT_VISIBLE).map((log) => (
                    <li>
                      <span class="audit-action">
                        {auditActionLabel(log.action)}
                      </span>
                      <span class="audit-meta">
                        {log.actorDisplayName ?? log.actorEmail ?? "—"} ·{" "}
                        <time datetime={log.createdAt.toISOString()}>
                          {formatDate(
                            log.createdAt,
                            locale,
                            organization.timezone
                          )}
                        </time>
                      </span>
                    </li>
                  ))}
                </ol>
              </details>
            )}
          </Fragment>
        ) : (
          <EmptyState title={t("No audit events for this dwelling yet.")} />
        )}
      </section>
    </div>

    {!dwelling.archivedAt && (
      <dialog
        class="lock-dialog"
        id="archive-dialog"
        aria-labelledby="archive-dialog-title"
        aria-describedby="archive-dialog-description"
      >
        <div class="dialog-body">
          <div class="dialog-icon" aria-hidden="true">
            !
          </div>
          <div>
            <h2 id="archive-dialog-title">{t("Archive this dwelling?")}</h2>
            <p id="archive-dialog-description">
              {t(
                "Archiving hides it from new periods and active lists. Past invoices and readings remain intact."
              )}
            </p>
          </div>
        </div>
        <div class="dialog-actions">
          <form method="dialog">
            <button class="btn-secondary" value="cancel">
              {t("Cancel")}
            </button>
          </form>
          <form method="POST" action={actions.dwellings.archive}>
            <input type="hidden" name="organizationId" value={organizationId} />
            <input type="hidden" name="dwellingId" value={dwellingId} />
            <button type="submit" class="btn-danger">
              {t("Archive dwelling")}
            </button>
          </form>
        </div>
      </dialog>
    )}
  </div>
</AdminLayout>

<script>
  import { actions, isInputError, type ActionError } from "astro:actions";
  import {
    bindMutationForm,
    copyAstroScope,
    type MutationDescriptor,
  } from "../../../../../lib/ui/mutate-form";
  import {
    meterListVisibility,
    type MeterFilter,
  } from "../../../../../lib/ui/meter-list";
  import { onPageLoad } from "../../../../../lib/ui/page-lifecycle";

  onPageLoad(() => {
    const page = document.querySelector<HTMLElement>("[data-dwelling-detail]");
    if (!page) return;
    const controller = new AbortController();
    const signal = controller.signal;
    const discardMessage =
      page.dataset.discardMessage ?? "Discard unsaved changes?";
    const errorMap = JSON.parse(
      document.getElementById("dwelling-error-map")?.textContent || "{}"
    ) as Record<string, string>;
    const translateError = (message: string) => errorMap[message] ?? message;
    const plainClick = (event: MouseEvent) =>
      event.button === 0 &&
      !event.metaKey &&
      !event.ctrlKey &&
      !event.shiftKey &&
      !event.altKey;

    // ---- Tabs: one section group each, kept in ?tab= so a reload keeps it.
    const tabs = [...page.querySelectorAll<HTMLAnchorElement>('[role="tab"]')];
    let activeTab =
      tabs.find((tab) => tab.getAttribute("aria-selected") === "true")?.dataset
        .tab ?? "overview";

    function writeUrl() {
      const url = new URL(location.href);
      url.searchParams.delete("edit");
      if (activeTab === "overview") url.searchParams.delete("tab");
      else url.searchParams.set("tab", activeTab);
      history.replaceState(history.state, "", url);
    }

    function selectTab(tab: string, focus = false) {
      activeTab = tab;
      for (const el of tabs) {
        const selected = el.dataset.tab === tab;
        el.setAttribute("aria-selected", selected ? "true" : "false");
        el.tabIndex = selected ? 0 : -1;
        if (selected && focus) el.focus();
      }
      for (const panel of page!.querySelectorAll<HTMLElement>(
        "[data-tabpanel]"
      ))
        panel.hidden = panel.dataset.tabpanel !== tab;
      writeUrl();
    }

    // Without the script every tab link is its own tab stop; with it, one
    // stop and the arrow keys, as a tablist promises.
    for (const tab of tabs)
      tab.tabIndex = tab.dataset.tab === activeTab ? 0 : -1;
    for (const tab of tabs) {
      tab.addEventListener(
        "click",
        (event) => {
          if (!plainClick(event)) return;
          event.preventDefault();
          selectTab(tab.dataset.tab ?? "overview");
        },
        { signal }
      );
      tab.addEventListener(
        "keydown",
        (event) => {
          // The tabs are links (they work without the script); Space
          // activates a tab as it would a button.
          if (event.key === " ") {
            event.preventDefault();
            selectTab(tab.dataset.tab ?? "overview");
            return;
          }
          const last = tabs.length - 1;
          const index = tabs.indexOf(tab);
          const target =
            event.key === "ArrowRight"
              ? tabs[index === last ? 0 : index + 1]
              : event.key === "ArrowLeft"
                ? tabs[index === 0 ? last : index - 1]
                : event.key === "Home"
                  ? tabs[0]
                  : event.key === "End"
                    ? tabs[last]
                    : undefined;
          if (!target) return;
          event.preventDefault();
          selectTab(target.dataset.tab ?? "overview", true);
        },
        { signal }
      );
    }

    // ---- Editors: an Edit or Add control turns its panel (or a row) into
    // its form in place. One at a time; Cancel and Escape put the saved values
    // back and return focus to the control that opened it.
    interface OpenEditor {
      key: string;
      region: HTMLElement;
      snapshot: string;
    }
    let open: OpenEditor | null = null;
    const byKey = (attribute: string, key: string) => [
      ...page.querySelectorAll<HTMLElement>(
        `[${attribute}="${CSS.escape(key)}"]`
      ),
    ];
    const serialize = (region: HTMLElement) =>
      [...region.querySelectorAll("form")]
        .flatMap((form) =>
          [...new FormData(form)].map(([name, value]) => `${name}=${value}`)
        )
        .join("&");
    const isDirty = () =>
      !!open &&
      open.region.isConnected &&
      serialize(open.region) !== open.snapshot;

    // The trigger in the panel, not the copy in the header menu.
    function focusTrigger(key: string) {
      const trigger = byKey("data-editor-open", key).find(
        (el) => !el.closest(".more-menu")
      );
      trigger?.focus();
    }

    function closeEditor(
      options: { restoreFocus?: boolean; reset?: boolean } = {}
    ) {
      if (!open) return;
      const { key, region } = open;
      open = null;
      if (region.isConnected) {
        // Back to the saved values; a closed editor's error is stale.
        if (options.reset !== false)
          region.querySelectorAll("form").forEach((form) => form.reset());
        region
          .querySelectorAll(".notice-danger")
          .forEach((notice) => notice.remove());
        clearInvalid(region);
        region.hidden = true;
      }
      for (const view of byKey("data-editor-view", key)) view.hidden = false;
      for (const trigger of byKey("data-editor-open", key)) {
        trigger.hidden = false;
        trigger.setAttribute("aria-expanded", "false");
      }
      if (options.restoreFocus !== false) focusTrigger(key);
    }

    function showEditor(key: string, region: HTMLElement) {
      region.hidden = false;
      for (const view of byKey("data-editor-view", key)) view.hidden = true;
      for (const trigger of byKey("data-editor-open", key)) {
        trigger.setAttribute("aria-expanded", "true");
        if (!trigger.closest(".more-menu")) trigger.hidden = true;
      }
    }

    function openEditor(key: string): boolean {
      const region = byKey("data-editor", key)[0];
      if (!region) return false;
      // An editor whose section was replaced is no longer the open one.
      if (open && !open.region.isConnected) open = null;
      if (open?.key !== key) {
        if (open) {
          if (isDirty() && !window.confirm(discardMessage)) return true;
          closeEditor({ restoreFocus: false });
        }
        const tab =
          region.closest<HTMLElement>("[data-tabpanel]")?.dataset.tabpanel;
        if (tab && tab !== activeTab) selectTab(tab);
        showEditor(key, region);
        open = { key, region, snapshot: serialize(region) };
      }
      page!.querySelector(".more-menu[open]")?.removeAttribute("open");
      region
        .querySelector<HTMLElement>(
          'input:not([type="hidden"]):not([disabled]), select, textarea'
        )
        ?.focus();
      return true;
    }

    // An editor the server rendered open (?edit=, or a failed save).
    const initiallyOpen = page.querySelector<HTMLElement>(
      "[data-editor]:not([hidden])"
    );
    if (initiallyOpen?.dataset.editor)
      open = {
        key: initiallyOpen.dataset.editor,
        region: initiallyOpen,
        snapshot: serialize(initiallyOpen),
      };

    page.addEventListener(
      "click",
      (event) => {
        const target = event.target as Element;
        const opener = target.closest<HTMLElement>("[data-editor-open]");
        if (opener?.dataset.editorOpen && plainClick(event)) {
          if (openEditor(opener.dataset.editorOpen)) event.preventDefault();
          return;
        }
        const cancel = target.closest<HTMLElement>("[data-editor-cancel]");
        if (cancel && open?.region.contains(cancel) && plainClick(event)) {
          event.preventDefault();
          closeEditor();
        }
      },
      { signal }
    );
    page.addEventListener(
      "keydown",
      (event) => {
        if (event.key !== "Escape" || event.defaultPrevented || !open) return;
        if (!open.region.contains(event.target as Node)) return;
        event.preventDefault();
        if (isDirty() && !window.confirm(discardMessage)) return;
        closeEditor();
      },
      { signal }
    );

    // After a save the form's values are the saved ones, so Cancel or a later
    // reset must come back to them, not to what the page was loaded with.
    function commitDefaults(form: HTMLFormElement) {
      for (const field of form.elements) {
        if (field instanceof HTMLSelectElement)
          for (const option of field.options)
            option.defaultSelected = option.selected;
        else if (
          field instanceof HTMLInputElement &&
          (field.type === "checkbox" || field.type === "radio")
        )
          field.defaultChecked = field.checked;
        else if (
          field instanceof HTMLInputElement ||
          field instanceof HTMLTextAreaElement
        )
          field.defaultValue = field.value;
      }
    }

    // ---- Errors: an input error marks its fields and points them at the
    // message mutate-form placed just above the form.
    function clearInvalid(root: HTMLElement) {
      for (const field of root.querySelectorAll<HTMLElement>(
        "[data-error-for]"
      )) {
        field.removeAttribute("aria-invalid");
        const ids = (field.getAttribute("aria-describedby") ?? "")
          .split(/\s+/)
          .filter((id) => id && id !== field.dataset.errorFor);
        if (ids.length) field.setAttribute("aria-describedby", ids.join(" "));
        else field.removeAttribute("aria-describedby");
        delete field.dataset.errorFor;
      }
    }
    let errorSeq = 0;
    function markInvalid(form: HTMLFormElement, error: ActionError) {
      clearInvalid(form);
      const notice = form.previousElementSibling;
      if (
        !isInputError(error) ||
        !notice?.classList.contains("form-inline-error")
      )
        return;
      notice.id ||= `dwelling-form-error-${++errorSeq}`;
      let first: HTMLElement | null = null;
      for (const name of Object.keys(error.fields)) {
        const field = form.elements.namedItem(name);
        if (!(field instanceof HTMLElement)) continue;
        field.setAttribute("aria-invalid", "true");
        field.setAttribute(
          "aria-describedby",
          [field.getAttribute("aria-describedby"), notice.id]
            .filter(Boolean)
            .join(" ")
        );
        field.dataset.errorFor = notice.id;
        first ??= field;
      }
      first?.focus();
    }
    // An error the server rendered for an earlier submit goes when the form is
    // sent again; mutate-form manages its own message.
    function clearServerError(form: HTMLFormElement) {
      form
        .closest("[data-editor], section")
        ?.querySelectorAll(".notice-danger:not(.form-inline-error)")
        .forEach((notice) => notice.remove());
    }

    function describe(
      source: HTMLElement,
      entity: string,
      operation: string,
      extra: Partial<MutationDescriptor> = {}
    ): MutationDescriptor {
      return {
        entity,
        operation,
        pendingLabel: source.dataset.pendingLabel ?? "Saving…",
        successLabel: source.dataset.successLabel ?? "Changes saved",
        errorLabel: source.dataset.errorLabel ?? "Could not save",
        reconciliationErrorLabel: source.dataset.reconcileError,
        ...extra,
      };
    }
    const generic = (source: HTMLElement | null | undefined) =>
      source?.dataset.genericError ?? "Something went wrong. Please try again.";

    // ---- Section refresh: after an add, remove or money change, only that
    // section (and the summary strip and tab counts) is fetched again, so other
    // editors and the chosen tab are untouched.
    async function refreshSections(ids: string[]) {
      const url = new URL(location.href);
      url.searchParams.delete("edit");
      const response = await fetch(url, {
        headers: { "X-Requested-With": "dwelling-refresh" },
      });
      if (!response.ok) throw new Error(`Refresh failed: ${response.status}`);
      const fresh = new DOMParser().parseFromString(
        await response.text(),
        "text/html"
      );
      // An editor open in a section about to be replaced keeps its draft: its
      // values move to the fresh copy, which opens in its place.
      const carried =
        open && ids.some((id) => open!.region.closest(`#${id}`))
          ? {
              key: open.key,
              focused: open.region.contains(document.activeElement),
              values: [...open.region.querySelectorAll("form")].map((form) => [
                ...new FormData(form),
              ]),
            }
          : null;
      for (const selector of [
        ...ids.map((id) => `#${id}`),
        ".dwelling-summary",
        '[data-tab-count="meters"]',
      ]) {
        const current = page!.querySelector(selector);
        const next = fresh.querySelector(selector);
        if (current && next) current.replaceWith(next);
      }
      for (const id of ids) {
        const root = page!.querySelector<HTMLElement>(`#${id}`);
        if (root) binders[id]?.(root);
      }
      if (carried) {
        const region = byKey("data-editor", carried.key)[0];
        if (!region) {
          open = null; // the item it edited is gone
          return;
        }
        showEditor(carried.key, region);
        // The snapshot is the saved state, so the carried draft is still
        // recognised as unsaved.
        open = { key: carried.key, region, snapshot: serialize(region) };
        region.querySelectorAll("form").forEach((form, index) => {
          for (const [name, value] of carried.values[index] ?? []) {
            const field = form.elements.namedItem(name);
            if (
              field instanceof HTMLInputElement &&
              (field.type === "checkbox" || field.type === "radio")
            )
              field.checked = true;
            else if (
              (field instanceof HTMLInputElement && field.type !== "hidden") ||
              field instanceof HTMLTextAreaElement ||
              field instanceof HTMLSelectElement
            )
              field.value = String(value);
          }
        });
        if (carried.focused)
          region
            .querySelector<HTMLElement>(
              'input:not([type="hidden"]), select, textarea'
            )
            ?.focus();
      }
    }

    // Close the editor that saved, refresh, then hand focus back to its
    // (freshly rendered) trigger.
    async function finishEditor(key: string, sections: string[]) {
      if (open?.key === key) closeEditor({ restoreFocus: false, reset: false });
      await refreshSections(sections);
      focusTrigger(key);
    }

    // ---- Basic information: one editor for every dwelling field. The view
    // takes the values the server returns.
    interface UpdatedDwelling {
      billingName?: string | null;
      occupantName?: string | null;
      billingEmail?: string | null;
      billingAddress?: string | null;
      areaM2?: string | number | null;
      residentCount?: number | null;
      type?: string | null;
      notes?: string | null;
    }
    function bindBasicInfo(root: HTMLElement) {
      const form = root.querySelector<HTMLFormElement>("#basic-info-form");
      if (!form) return;
      const show = (value: unknown) =>
        value === null || value === undefined || String(value).trim() === ""
          ? "—"
          : String(value).trim();
      bindMutationForm<UpdatedDwelling>({
        form,
        action: (fd) => actions.dwellings.update(fd),
        savingLabel: form.dataset.savingLabel ?? "Saving…",
        fallbackErrorMessage: generic(form),
        translateError,
        mutation: () => {
          clearServerError(form);
          return describe(form, "dwelling", "update", {
            messageKey: "Saving dwelling information…",
            successMessageKey: "Changes saved",
          });
        },
        onError: (error) => markInvalid(form, error),
        onSuccess: (dwelling) => {
          // Everything below comes from what the server saved, not from the
          // inputs: the editor may have been cancelled (reset) or edited
          // further while the request was on its way.
          const saved: Record<string, string> = {
            occupantName: dwelling.occupantName?.trim() ?? "",
            billingName: dwelling.billingName?.trim() ?? "",
            billingEmail: dwelling.billingEmail?.trim() ?? "",
            billingAddress: dwelling.billingAddress?.trim() ?? "",
            areaM2: dwelling.areaM2 == null ? "" : String(dwelling.areaM2),
            residentCount:
              dwelling.residentCount == null
                ? ""
                : String(dwelling.residentCount),
            notes: dwelling.notes ?? "",
            type: dwelling.type ?? "",
          };
          for (const [name, value] of Object.entries(saved)) {
            const field = form.elements.namedItem(name);
            if (
              field instanceof HTMLInputElement ||
              field instanceof HTMLTextAreaElement ||
              field instanceof HTMLSelectElement
            )
              field.value = value;
          }
          // A plain querySelector and a cast: workers-types break the
          // HTMLSelectElement generic (see invoice-template-editor.ts).
          const typeOption = (
            form.querySelector(
              'select[name="type"]'
            ) as unknown as HTMLSelectElement | null
          )?.selectedOptions[0];
          const values: Record<string, string> = {
            occupantName: show(dwelling.occupantName),
            billingName: show(dwelling.billingName),
            billingEmail: show(dwelling.billingEmail),
            billingAddress: show(dwelling.billingAddress),
            areaM2: show(dwelling.areaM2),
            residentCount: show(dwelling.residentCount),
            notes: show(dwelling.notes),
            type: typeOption?.textContent?.trim() ?? show(dwelling.type),
          };
          for (const [field, value] of Object.entries(values)) {
            const dd = root.querySelector<HTMLElement>(
              `dd[data-field="${field}"]`
            );
            if (dd) dd.textContent = value;
          }
          const area = page!.querySelector('[data-kpi="area"] p');
          if (area) area.textContent = `${values.areaM2} m²`;
          const count = page!.querySelector('[data-kpi="resident-count"] p');
          if (count) count.textContent = values.residentCount;
          // The delivery panel names the billing email it sends to.
          const delivery = page!.querySelector<HTMLElement>(
            "[data-delivery-form]"
          );
          const destination = delivery?.querySelector<HTMLElement>(
            "[data-email-destination]"
          );
          if (delivery && destination)
            destination.textContent = saved.billingEmail
              ? `${delivery.dataset.sendToLabel ?? "Send invoices to"} ${saved.billingEmail}`
              : (delivery.dataset.noEmailLabel ?? "No billing email on file");
          clearInvalid(form);
          commitDefaults(form);
          if (open?.key === "basic") closeEditor({ reset: false });
        },
      });
    }

    // ---- Invoice delivery: the checkboxes are always live; Save is only
    // active once they differ from the saved state.
    interface UpdatedDeliveryDwelling {
      invoiceByEmail?: boolean;
      invoiceByPaper?: boolean;
    }
    function bindDelivery(root: HTMLElement) {
      const form = root.querySelector<HTMLFormElement>("[data-delivery-form]");
      const save = form?.querySelector<HTMLButtonElement>(
        "[data-delivery-save]"
      );
      if (!form || !save) return;
      const boxes = [
        ...form.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'),
      ];
      let saved = boxes.map((box) => box.checked);
      const update = () => {
        save.disabled = boxes.every((box, i) => box.checked === saved[i]);
      };
      for (const box of boxes)
        box.addEventListener("change", update, { signal });
      update();
      bindMutationForm<UpdatedDeliveryDwelling>({
        form,
        action: (fd) => actions.dwellings.updateInvoiceDelivery(fd),
        savingLabel: form.dataset.savingLabel ?? "Saving…",
        fallbackErrorMessage: generic(form),
        translateError,
        mutation: () => {
          clearServerError(form);
          for (const box of boxes) box.disabled = true;
          return describe(form, "dwelling", "update-invoice-delivery", {
            messageKey: "Saving delivery preferences…",
            successMessageKey: "Delivery preferences saved",
          });
        },
        onSuccess: (dwelling) => {
          const email = boxes.find((box) => box.name === "invoiceByEmail");
          const paper = boxes.find((box) => box.name === "invoiceByPaper");
          if (email && dwelling.invoiceByEmail !== undefined)
            email.checked = Boolean(dwelling.invoiceByEmail);
          if (paper && dwelling.invoiceByPaper !== undefined)
            paper.checked = Boolean(dwelling.invoiceByPaper);
          const methods = [
            dwelling.invoiceByEmail && (form.dataset.emailLabel ?? "Email"),
            dwelling.invoiceByPaper && (form.dataset.paperLabel ?? "Paper"),
          ].filter(Boolean);
          const kpi = page!.querySelector('[data-kpi="invoice-delivery"] p');
          if (kpi)
            kpi.textContent = methods.length
              ? methods.join(", ")
              : (form.dataset.noneLabel ?? "None");
          saved = boxes.map((box) => box.checked);
          commitDefaults(form);
        },
        onSettled: () => {
          for (const box of boxes) box.disabled = false;
          update();
        },
      });
    }

    // ---- Account balance: payment and adjustment. Both confirm with the
    // amount; a success refreshes the balance section and the summary strip.
    function formatAmount(raw: string, currency?: string) {
      const number = Number(raw.replace(/\s/g, "").replace(",", "."));
      return currency && raw && Number.isFinite(number)
        ? new Intl.NumberFormat(document.documentElement.lang || undefined, {
            style: "currency",
            currency,
          }).format(number)
        : raw;
    }
    function bindBalance(root: HTMLElement) {
      const paymentRegion = root.querySelector<HTMLElement>("#editor-payment");
      const paymentForm = paymentRegion?.querySelector<HTMLFormElement>(
        "form[data-payment-form]"
      );
      if (paymentRegion && paymentForm)
        bindMutationForm({
          form: paymentForm,
          action: (fd) => actions.payments.recordManual(fd),
          savingLabel: paymentRegion.dataset.savingLabel ?? "Saving…",
          fallbackErrorMessage: generic(paymentRegion),
          translateError,
          mutation: () => {
            clearServerError(paymentForm);
            return describe(paymentRegion, "payment", "record");
          },
          onError: (error) => markInvalid(paymentForm, error),
          onSuccess: () => finishEditor("payment", ["account-balance"]),
        });

      const adjustment =
        root.querySelector<HTMLFormElement>("#adjustment-form");
      if (!adjustment) return;
      const button = adjustment.querySelector<HTMLButtonElement>(
        "button[data-confirm-template]"
      );
      const describeAdjustment = () => {
        const direction = (
          adjustment.querySelector(
            'select[name="direction"]'
          ) as unknown as HTMLSelectElement | null
        )?.selectedOptions[0];
        const amount = adjustment
          .querySelector<HTMLInputElement>('input[name="amount"]')
          ?.value.trim();
        if (!button || !amount || !direction) return;
        button.dataset.confirm = button.dataset
          .confirmTemplate!.replace(
            "{direction}",
            direction.textContent?.trim() ?? ""
          )
          .replace(
            "{amount}",
            formatAmount(amount, adjustment.dataset.currency)
          );
      };
      for (const type of ["input", "change"])
        adjustment.addEventListener(type, describeAdjustment, { signal });
      // Every adjustment is a new ledger entry with its own key, so the server
      // cannot tell a repeat from a second adjustment. When the outcome is
      // unknown (no response) nothing offers a retry; the message says to
      // check first.
      bindMutationForm({
        form: adjustment,
        action: (fd) => actions.accounts.createAdjustment(fd),
        savingLabel: adjustment.dataset.savingLabel ?? "Saving…",
        fallbackErrorMessage:
          adjustment.dataset.unknownOutcome ?? generic(adjustment),
        translateError,
        mutation: () => {
          clearServerError(adjustment);
          return describe(adjustment, "account-adjustment", "create", {
            retryable: false,
          });
        },
        onError: (error) => markInvalid(adjustment, error),
        onSuccess: () => finishEditor("adjustment", ["account-balance"]),
      });
    }

    // ---- Meters: add (with a marked row until the server confirms), edit in
    // the row, archive in place.
    interface CreatedMeter {
      id: string;
      type: string;
      label: string | null;
      serialNumber: string | null;
      unit: string;
      archivedAt: Date | string | null;
    }

    async function recoverCreate(clientMutationId: string) {
      const organizationId =
        page!.querySelector<HTMLInputElement>('input[name="organizationId"]')
          ?.value ?? "";
      const { data, error } = await actions.mutations.lookup({
        organizationId,
        clientMutationId,
      });
      if (error || !data) throw error ?? new Error("Lookup failed");
      return data;
    }
    function setPendingRowStatus(row: HTMLElement | undefined, text: string) {
      const status = row?.querySelector<HTMLElement>(".optimistic-status");
      if (status) status.textContent = text;
    }

    function bindMeters(root: HTMLElement) {
      const meterForm = root.querySelector<HTMLFormElement>("#meter-form");
      const region = root.querySelector<HTMLElement>("#meters-list-region");
      const list = region?.querySelector<HTMLUListElement>(".item-list");
      const empty = region?.querySelector<HTMLElement>("#meters-empty-state");
      const filterButtons = [
        ...root.querySelectorAll<HTMLButtonElement>("[data-meter-filter]"),
      ];
      let filter: MeterFilter = "active";

      // Counts include only confirmed meters: a row still saving, or whose
      // outcome is unknown, is shown marked but not counted.
      function reconcile() {
        if (!list || !empty) return;
        const rows = [...list.querySelectorAll<HTMLLIElement>(".meter-row")];
        const count = page!.querySelector('[data-tab-count="meters"]');
        if (count)
          count.textContent = String(
            rows.filter(
              (row) => row.dataset.archived !== "true" && !row.dataset.pending
            ).length
          );
        const visibility = meterListVisibility(
          rows.map((row) => row.dataset.archived === "true"),
          filter
        );
        rows.forEach((row, index) => {
          row.hidden = !visibility.rows[index];
        });
        list.hidden = visibility.empty;
        empty.hidden = !visibility.empty;
        const title = empty.querySelector<HTMLElement>(".text-h3");
        if (title)
          title.textContent =
            filter === "archived"
              ? (region?.dataset.emptyArchived ?? "No archived meters.")
              : (region?.dataset.emptyActive ?? "No active meters.");
        for (const button of filterButtons)
          button.setAttribute(
            "aria-pressed",
            button.dataset.meterFilter === filter ? "true" : "false"
          );
      }
      for (const button of filterButtons)
        button.addEventListener(
          "click",
          () => {
            const next = button.dataset.meterFilter;
            if (next === "active" || next === "archived") {
              filter = next;
              reconcile();
            }
          },
          { signal }
        );

      function buildRow(meter: CreatedMeter): HTMLLIElement {
        const option = meterForm?.querySelector<HTMLOptionElement>(
          `option[value="${CSS.escape(meter.type)}"]`
        );
        const typeName = option?.textContent?.trim() ?? meter.type;
        const li = document.createElement("li");
        li.className = "meter-row";
        li.dataset.meterId = meter.id;
        li.dataset.archived = "false";
        li.dataset.pending = "true";
        const icon = document.createElement("div");
        icon.className = "item-icon";
        icon.dataset.meterType = meter.type;
        icon.setAttribute("aria-hidden", "true");
        icon.textContent = meter.unit;
        const body = document.createElement("div");
        body.className = "item-body";
        const strong = document.createElement("strong");
        strong.textContent = meter.label ?? typeName;
        const caption = document.createElement("span");
        caption.textContent = [
          meter.label && meter.label !== typeName ? typeName : null,
          meter.serialNumber,
        ]
          .filter(Boolean)
          .join(" · ");
        const status = document.createElement("span");
        status.className = "optimistic-status";
        status.textContent = meterForm?.dataset.savingLabel ?? "Saving…";
        // appendChild, not a variadic append: workers-types also merge an
        // HTMLRewriter append(content, options) into Element.
        for (const part of [strong, caption, status]) body.appendChild(part);
        li.appendChild(icon);
        li.appendChild(body);
        if (meterForm)
          copyAstroScope(meterForm, li, icon, body, strong, caption, status);
        return li;
      }

      if (meterForm)
        bindMutationForm<CreatedMeter, HTMLLIElement>({
          form: meterForm,
          action: (fd) => actions.meters.create(fd),
          savingLabel: meterForm.dataset.savingLabel ?? "Saving…",
          fallbackErrorMessage: generic(meterForm),
          translateError,
          mutation: () => {
            clearServerError(meterForm);
            return {
              entity: "meter",
              operation: "create",
              idempotentCreate: true,
              messageKey: "Adding meter…",
              successMessageKey: "Meter added",
              pendingLabel: meterForm.dataset.pendingLabel ?? "Adding meter…",
              successLabel: meterForm.dataset.addedMessage ?? "Meter added",
              errorLabel: meterForm.dataset.errorLabel ?? "Could not add meter",
              reconciliationErrorLabel: meterForm.dataset.reconcileError,
              committedMissingLabel: meterForm.dataset.committedMissing,
            };
          },
          recover: recoverCreate,
          onVerifying: (row, unknown) =>
            setPendingRowStatus(
              row,
              unknown
                ? (meterForm.dataset.unknownLabel ?? "Outcome not confirmed")
                : (meterForm.dataset.checkingLabel ?? "Checking save status…")
            ),
          onCommittedMissing: (_form, row) => {
            row?.remove();
            return finishEditor("meter", ["meters"]);
          },
          optimistic: (formData, mutationId) => {
            const row = buildRow({
              id: `client:meter:${mutationId.split(":").at(-1)}`,
              type: String(formData.get("type") ?? "OTHER"),
              label: String(formData.get("label") || "") || null,
              serialNumber: String(formData.get("serialNumber") || "") || null,
              unit: String(formData.get("unit") ?? ""),
              archivedAt: null,
            });
            list?.appendChild(row);
            reconcile();
            return row;
          },
          onError: (error, _form, row) => {
            row?.remove();
            reconcile();
            markInvalid(meterForm, error);
          },
          onSuccess: () => finishEditor("meter", ["meters"]),
        });

      for (const form of root.querySelectorAll<HTMLFormElement>(
        "[data-meter-edit-form]"
      )) {
        const meterId = String(new FormData(form).get("meterId"));
        bindMutationForm({
          form,
          action: (fd) => actions.meters.update(fd),
          savingLabel: meterForm?.dataset.savingLabel ?? "Saving…",
          fallbackErrorMessage: generic(meterForm),
          translateError,
          mutation: () => ({
            entity: "meter",
            operation: "update",
            pendingLabel: meterForm?.dataset.updatingLabel ?? "Saving meter…",
            successLabel: meterForm?.dataset.updatedLabel ?? "Meter saved",
            errorLabel: meterForm?.dataset.couldNotSave ?? "Could not save",
            reconciliationErrorLabel: meterForm?.dataset.reconcileError,
          }),
          onError: (error) => markInvalid(form, error),
          onSuccess: () => finishEditor(`meter-${meterId}`, ["meters"]),
        });
      }

      // Archived in place: the row keeps its place for the Archived filter but
      // loses its controls, as the server renders an archived meter.
      for (const form of root.querySelectorAll<HTMLFormElement>(
        "[data-meter-archive-form]"
      )) {
        const row = form.closest<HTMLLIElement>("li");
        if (!row) continue;
        bindMutationForm<CreatedMeter>({
          form,
          action: (fd) => actions.meters.archive(fd),
          savingLabel: "…",
          fallbackErrorMessage: generic(meterForm),
          translateError,
          mutation: () => ({
            entity: "meter",
            operation: "archive",
            pendingLabel: meterForm?.dataset.archivingLabel ?? "Archiving…",
            successLabel: meterForm?.dataset.archivedLabelText ?? "Archived",
            errorLabel: meterForm?.dataset.couldNotSave ?? "Could not save",
            reconciliationErrorLabel: meterForm?.dataset.reconcileError,
          }),
          onSuccess: (meter) => {
            if (!row.isConnected) return;
            const key = `meter-${row.dataset.meterId}`;
            if (open?.key === key) closeEditor({ restoreFocus: false });
            row.dataset.archived = meter.archivedAt ? "true" : "false";
            const strong = row.querySelector("strong");
            if (strong)
              strong.textContent = `${strong.textContent} (${meterForm?.dataset.archivedLabel ?? "archived"})`;
            row.querySelector("[data-meter-actions]")?.remove();
            row.querySelector(`[data-editor="${CSS.escape(key)}"]`)?.remove();
            reconcile();
            // Focus would be lost with the removed button.
            root
              .querySelector<HTMLElement>('[data-meter-filter="active"]')
              ?.focus();
          },
        });
      }
      reconcile();
    }

    // ---- Portal access: add (marked row until confirmed), enable/disable
    // and remove without a page reload. Resident mutations are serialized so
    // two cannot resolve out of order.
    interface AssignedResident {
      userId: string;
      email: string;
      displayName: string | null;
    }
    let residentsBusy = false;
    async function serialized<T>(
      call: () => Promise<{ data?: T; error?: ActionError }>,
      busyMessage: string
    ): Promise<{ data?: T; error?: ActionError }> {
      if (residentsBusy)
        return { error: { message: busyMessage } as ActionError };
      residentsBusy = true;
      try {
        return await call();
      } finally {
        residentsBusy = false;
      }
    }

    function bindResidents(root: HTMLElement) {
      const addForm = root.querySelector<HTMLFormElement>("#resident-form");
      const region = root.querySelector<HTMLElement>("#residents-list-region");
      const list = region?.querySelector<HTMLUListElement>(".item-list");
      const empty = region?.querySelector<HTMLElement>(
        "#residents-empty-state"
      );
      const busy = generic(addForm);
      const reconcile = () => {
        if (!list || !empty) return;
        list.hidden = list.children.length === 0;
        empty.hidden = list.children.length > 0;
      };

      if (addForm)
        bindMutationForm<AssignedResident, HTMLLIElement>({
          form: addForm,
          action: (fd) =>
            serialized(() => actions.dwellings.assignResident(fd), busy),
          savingLabel: addForm.dataset.savingLabel ?? "Saving…",
          fallbackErrorMessage: busy,
          translateError,
          mutation: () => {
            clearServerError(addForm);
            return {
              entity: "resident-access",
              operation: "create",
              idempotentCreate: true,
              messageKey: "Adding resident…",
              successMessageKey: "Resident added",
              pendingLabel: addForm.dataset.pendingLabel ?? "Adding resident…",
              successLabel: addForm.dataset.addedMessage ?? "Resident added",
              errorLabel:
                addForm.dataset.errorLabel ?? "Could not add resident",
              reconciliationErrorLabel: addForm.dataset.reconcileError,
              committedMissingLabel: addForm.dataset.committedMissing,
            };
          },
          recover: recoverCreate,
          onVerifying: (row, unknown) =>
            setPendingRowStatus(
              row,
              unknown
                ? (addForm.dataset.unknownLabel ?? "Outcome not confirmed")
                : (addForm.dataset.checkingLabel ?? "Checking save status…")
            ),
          onCommittedMissing: (_form, row) => {
            row?.remove();
            return finishEditor("resident", ["portal-access"]);
          },
          optimistic: (formData, mutationId) => {
            const email = String(formData.get("email") ?? "");
            // An address that already has access is confirmed by the server
            // without a second row; do not show one meanwhile either.
            if (
              [...(list?.querySelectorAll("li") ?? [])].some((li) =>
                li.querySelector(".item-body")?.textContent?.includes(email)
              )
            )
              return undefined;
            const li = document.createElement("li");
            li.className = "resident-row";
            li.dataset.userId = `client:resident:${mutationId.split(":").at(-1)}`;
            li.dataset.pending = "true";
            const avatar = document.createElement("div");
            avatar.className = "item-avatar";
            avatar.setAttribute("aria-hidden", "true");
            avatar.textContent = email.charAt(0).toUpperCase();
            const body = document.createElement("div");
            body.className = "item-body";
            const strong = document.createElement("strong");
            strong.textContent = email;
            const status = document.createElement("span");
            status.className = "optimistic-status";
            status.textContent = addForm.dataset.addingLabel ?? "Adding…";
            body.appendChild(strong);
            body.appendChild(status);
            li.appendChild(avatar);
            li.appendChild(body);
            copyAstroScope(addForm, li, avatar, body, strong, status);
            list?.appendChild(li);
            reconcile();
            return li;
          },
          onError: (error, _form, row) => {
            row?.remove();
            reconcile();
            markInvalid(addForm, error);
          },
          onSuccess: () => finishEditor("resident", ["portal-access"]),
        });

      for (const form of root.querySelectorAll<HTMLFormElement>(
        'form[action*="setResidentDisabled"]'
      ))
        bindMutationForm({
          form,
          action: (fd) =>
            serialized(() => actions.dwellings.setResidentDisabled(fd), busy),
          savingLabel: "…",
          fallbackErrorMessage: busy,
          translateError,
          mutation: () => ({
            entity: "resident-access",
            operation: "set-disabled",
            pendingLabel: addForm?.dataset.savingLabel ?? "Saving…",
            successLabel: addForm?.dataset.savedLabel ?? "Changes saved",
            errorLabel: addForm?.dataset.couldNotSave ?? "Could not save",
            reconciliationErrorLabel: addForm?.dataset.reconcileError,
          }),
          onSuccess: async () => {
            const userId = String(new FormData(form).get("userId"));
            await refreshSections(["portal-access"]);
            page!
              .querySelector<HTMLElement>(
                `li[data-user-id="${CSS.escape(userId)}"] form[action*="setResidentDisabled"] button`
              )
              ?.focus();
          },
        });

      for (const form of root.querySelectorAll<HTMLFormElement>(
        "[data-resident-remove-form]"
      )) {
        const row = form.closest<HTMLLIElement>("li");
        if (!row) continue;
        bindMutationForm({
          form,
          action: (fd) =>
            serialized(() => actions.dwellings.removeResident(fd), busy),
          savingLabel: "…",
          fallbackErrorMessage: busy,
          translateError,
          mutation: () => ({
            entity: "resident-access",
            operation: "remove",
            pendingLabel:
              addForm?.dataset.removingLabel ?? "Removing resident…",
            successLabel: addForm?.dataset.removedLabel ?? "Resident removed",
            errorLabel: addForm?.dataset.couldNotSave ?? "Could not save",
            reconciliationErrorLabel: addForm?.dataset.reconcileError,
          }),
          onSuccess: () => {
            if (!row.isConnected) return;
            // Focus moves to the neighbouring resident, or to Add resident.
            const neighbour = (row.nextElementSibling ??
              row.previousElementSibling) as HTMLElement | null;
            row.remove();
            reconcile();
            const next = neighbour?.querySelector<HTMLElement>(".item-action");
            if (next) next.focus();
            else focusTrigger("resident");
          },
        });
      }
      reconcile();
    }

    const binders: Record<string, (root: HTMLElement) => void> = {
      "basic-info": bindBasicInfo,
      "invoice-delivery": bindDelivery,
      "account-balance": bindBalance,
      meters: bindMeters,
      "portal-access": bindResidents,
    };
    for (const [id, bind] of Object.entries(binders)) {
      const root = page.querySelector<HTMLElement>(`#${id}`);
      if (root) bind(root);
    }

    // ---- Archive dwelling
    const archiveDialog =
      document.querySelector<HTMLDialogElement>("#archive-dialog");
    page
      .querySelector<HTMLButtonElement>("[data-open-archive-dialog]")
      ?.addEventListener(
        "click",
        () => {
          page.querySelector(".more-menu")?.removeAttribute("open");
          archiveDialog?.showModal();
        },
        { signal }
      );
    archiveDialog?.addEventListener(
      "click",
      (event) => {
        if (event.target === archiveDialog) archiveDialog.close();
      },
      { signal }
    );

    return () => controller.abort();
  });
</script>

<style>
  [data-dwelling-detail] {
    min-width: 0;
    max-width: 100%;
    /* The overview layout follows the room this area has, not the screen:
       beside the admin sidebar it is 240px narrower. */
    container: dwelling / inline-size;
  }
  [data-dwelling-detail] [hidden] {
    display: none !important;
  }
  .dwelling-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }
  /* A long dwelling number has no spaces. Let it break on a narrow phone
     instead of pushing the status badge off the page. */
  .dwelling-title-row h1 {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .more-menu {
    position: relative;
  }
  .more-menu summary {
    list-style: none;
    cursor: pointer;
  }
  .more-menu summary::-webkit-details-marker {
    display: none;
  }
  .more-menu > div {
    position: absolute;
    z-index: 20;
    top: calc(100% + 0.35rem);
    right: 0;
    display: flex;
    flex-direction: column;
    min-width: 13rem;
    padding: 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-surface-raised);
    box-shadow: var(--elevation-raised);
  }
  .more-menu > div > a,
  .more-menu > div > button {
    display: block;
    width: 100%;
    min-height: 2.25rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-badge);
    color: var(--color-foreground);
    font-size: var(--text-sm);
    text-align: left;
  }
  .more-menu > div > a:hover,
  .more-menu > div > button:hover {
    background: var(--color-hover);
  }
  @media (pointer: coarse) {
    .more-menu > div > a,
    .more-menu > div > button {
      min-height: var(--control-size-md);
    }
  }
  .more-menu .menu-danger {
    color: var(--color-destructive);
  }
  .more-menu .menu-disabled {
    padding: 0.5rem 0.75rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  /* Same single-surface strip as the Current Month finances, so the two
     pages read as one product. The balance leads; the rest is reference. */
  .dwelling-summary {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: var(--panel-border);
    border-radius: var(--radius-panel);
    background: var(--color-surface);
  }
  .summary-stat {
    display: grid;
    align-content: start;
    gap: 0.375rem;
    min-width: 0;
    padding: 1.25rem 1.5rem;
  }
  .summary-stat + .summary-stat {
    border-left: 1px solid var(--color-border);
  }
  .summary-label {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 550;
  }
  .summary-value {
