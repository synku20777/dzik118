                name="serialNumber"
                maxlength="100"
                class="mt-1 w-full"
              />
            </div>
            <div>
              <label class="field-label" for="label">
                {t("Label")}
              </label>
              <input
                id="label"
                name="label"
                maxlength="100"
                class="mt-1 w-full"
              />
