---
// Phase D (Organizations/dwellings) - dwelling detail (spec Section 9.2, 27
// "Dwellings: Detail").
import StatusBadge from "../../../../../components/ui/StatusBadge.astro";
import KpiCard from "../../../../../components/ui/KpiCard.astro";
import Icon from "../../../../../components/ui/Icon.astro";
import EmptyState from "../../../../../components/ui/EmptyState.astro";
import {
  translate,
  uiLocale,
  entityLabel,
  formatDate,
  formatMoney,
  friendlyActionErrorMessage,
} from "../../../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import { actions } from "astro:actions";
import {
  ForbiddenError,
  requireOrganizationAccess,
} from "../../../../../domain/authorization/guards";
import { getOrganization } from "../../../../../domain/organizations/organizations";
import {
  getDwelling,
  listDwellingResidents,
} from "../../../../../domain/organizations/dwellings";
import { listMeters } from "../../../../../domain/organizations/meters";
import { withRequestDb } from "../../../../../lib/db-request";
import {
  getDwellingAccountBalance,
  listDwellingAccountActivity,
} from "../../../../../domain/accounts/ledger";
import { listCasesForDwelling } from "../../../../../domain/periods/cases";
import { getCurrentOpenPeriod } from "../../../../../domain/periods/periods";
import { listAuditLogs } from "../../../../../domain/audit/audit-log";
import { listConversationsWithMessagesForDwelling } from "../../../../../domain/messaging/conversations";

const organizationId = Astro.params.orgId!;
const dwellingId = Astro.params.dwellingId!;
try {
  requireOrganizationAccess(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const updateResult = Astro.getActionResult(actions.dwellings.update);
const additionalInfoResult = updateResult; // shares the same action/form shape
const deliveryResult = Astro.getActionResult(
  actions.dwellings.updateInvoiceDelivery
);
const assignResult = Astro.getActionResult(actions.dwellings.assignResident);
const removeResult = Astro.getActionResult(actions.dwellings.removeResident);
const meterResult =
  Astro.getActionResult(actions.meters.create) ??
  Astro.getActionResult(actions.meters.archive);
const adjustmentResult = Astro.getActionResult(
  actions.accounts.createAdjustment
);
const archiveResult = Astro.getActionResult(actions.dwellings.archive);

let organization,
  dwelling,
  residents,
  meterList,
  accountBalance,
  accountActivity,
  caseHistory,
  currentOpenPeriod,
  auditEntries,
  conversationsWithMessages;
try {
  ({
    organization,
    dwelling,
    residents,
    meterList,
    accountBalance,
    accountActivity,
    caseHistory,
    currentOpenPeriod,
    auditEntries,
    conversationsWithMessages,
  } = await withRequestDb(async (db) => {
    const organization = await getOrganization(db, organizationId);
    return {
      organization,
      dwelling: await getDwelling(db, organizationId, dwellingId),
      residents: await listDwellingResidents(db, dwellingId),
      meterList: await listMeters(db, organizationId, dwellingId),
      accountBalance: await getDwellingAccountBalance(
        db,
        organizationId,
        dwellingId,
        organization.currency
      ),
      accountActivity: await listDwellingAccountActivity(
        db,
        organizationId,
        dwellingId,
        organization.currency
      ),
      caseHistory: await listCasesForDwelling(db, organizationId, dwellingId),
      currentOpenPeriod: await getCurrentOpenPeriod(db, organizationId),
      auditEntries: await listAuditLogs(db, organizationId, {
        entityType: "dwelling",
        entityId: dwellingId,
        limit: 20,
      }),
      conversationsWithMessages: await listConversationsWithMessagesForDwelling(
        db,
        dwellingId
      ),
    };
  }));
} catch {
  return Astro.redirect(`/admin/o/${organizationId}/dwellings`);
}

const dwellingTypeOptions = [
  "APARTMENT",
  "COMMERCIAL_UNIT",
  "PARKING",
  "STORAGE",
  "OTHER",
] as const;
const meterTypeOptions = [
  "COLD_WATER",
  "HOT_WATER",
  "ELECTRICITY",
  "GAS",
  "HEAT",
  "OTHER",
] as const;

const base = `/admin/o/${organizationId}`;
const dwellingStatus = dwelling.archivedAt ? "ARCHIVED" : "ACTIVE";
const subtitle = [organization.addressLine1, entityLabel(dwelling.type, locale)]
  .filter(Boolean)
  .join(" · ");

const isCredit = accountBalance.startsWith("-");
const balanceForDisplay = isCredit ? accountBalance.slice(1) : accountBalance;
const balanceKpiTone =
  isCredit || accountBalance === "0.00" ? "success" : "warning";

const totals = accountActivity.reduce(
  (acc, entry) => ({
    debit: acc.debit + Number(entry.debit),
    credit: acc.credit + Number(entry.credit),
  }),
  { debit: 0, credit: 0 }
);

const deliveryMethods = [
  dwelling.invoiceByEmail && t("Email"),
  dwelling.invoiceByPaper && t("Paper"),
].filter(Boolean) as string[];

const recentMessages = conversationsWithMessages
  .flatMap((c) => c.messages)
  .sort((a, b) => b.createdAt.getTime() - a.createdAt.getTime())
  .slice(0, 4);

const meterTypeIcons: Record<string, string> = {
  COLD_WATER: "💧",
  HOT_WATER: "🔥",
  ELECTRICITY: "⚡",
  GAS: "🔥",
  HEAT: "🌡️",
  OTHER: "⚙️",
};
const activeMeterCount = meterList.filter((meter) => !meter.archivedAt).length;
---

<AdminLayout
  title={`Dwelling ${dwelling.number} - ${organization.name}`}
  organizationId={organizationId}
  organizationName={organization.name}
>
  <div class="space-y-6">
    <a href={`${base}/dwellings`} class="back-link">
      <span aria-hidden="true">←</span>
      {t("Dwellings")}
    </a>

    <header class="page-header">
      <div>
        <div class="dwelling-title-row">
          <h1 class="font-display">{t("Dwelling")} {dwelling.number}</h1>
          <StatusBadge status={dwellingStatus} />
        </div>
        {subtitle && <p class="page-description">{subtitle}</p>}
      </div>
      <div class="page-actions">
        <details class="more-menu">
          <summary class="btn-secondary">
            <span aria-hidden="true">⋮</span>
            {t("More actions")}
          </summary>
          <div>
            {
              currentOpenPeriod ? (
                <a href={`${base}/periods/${currentOpenPeriod.id}`}>
                  {t("View current period")} →
                </a>
              ) : (
                <span class="menu-disabled">{t("No open period")}</span>
              )
            }
            <button type="button" data-goto-panel="account-balance">
              {t("Create adjustment")} →
            </button>
            {
              !dwelling.archivedAt && (
                <button
                  type="button"
                  data-open-archive-dialog
                  class="menu-danger"
                >
                  {t("Archive dwelling")} →
                </button>
              )
            }
          </div>
        </details>
      </div>
    </header>

    {
      archiveResult?.error && (
        <p class="notice notice-danger" role="alert">
          {archiveResult.error.message}
        </p>
      )
    }

    <div class="stat-grid">
      <KpiCard label={t("Area")} value={`${dwelling.areaM2} m²`} />
      <KpiCard label={t("Resident count")} value={dwelling.residentCount} />
      <KpiCard
        label={isCredit ? t("Account credit") : t("Outstanding balance")}
        value={formatMoney(balanceForDisplay, organization.currency, locale)}
        tone={balanceKpiTone}
      />
      <KpiCard
        label={t("Invoice delivery")}
        value={deliveryMethods.length > 0
          ? deliveryMethods.join(", ")
          : t("None")}
      />
    </div>

    <div class="dwelling-tabs" role="tablist" aria-label={t("Sections")}>
      <button
        type="button"
        role="tab"
        data-filter="overview"
        aria-selected="true"
      >
        {t("Overview")}
      </button>
      <button
        type="button"
        role="tab"
        data-filter="account-balance"
        aria-selected="false"
      >
        {t("Account balance")}
      </button>
      <button
        type="button"
        role="tab"
        data-filter="meters"
        aria-selected="false"
      >
        {t("Meters")}
      </button>
      <button
        type="button"
        role="tab"
        data-filter="residents"
        aria-selected="false"
      >
        {t("Residents")}
      </button>
      <button
        type="button"
        role="tab"
        data-filter="messages"
        aria-selected="false"
      >
        {t("Messages")}
      </button>
      <button
        type="button"
        role="tab"
        data-filter="history"
        aria-selected="false"
      >
        {t("History")}
      </button>
    </div>

    <div class="dwelling-grid" data-panel-group>
      <div class="dwelling-main">
        <section class="panel p-6" data-panel="overview">
          <div class="card-header">
            <div>
              <h2>{t("Basic information")}</h2>
              <p class="text-body-sm text-muted">
                {t("Core information about this dwelling.")}
              </p>
            </div>
            <details class="edit-disclosure" open={!!updateResult?.error}>
              <summary class="btn-secondary">
                <Icon name="pencil" size="sm" />
                {t("Edit")}
              </summary>
              <div class="edit-disclosure-panel">
                {
                  updateResult?.error && (
                    <p class="notice notice-danger" role="alert">
                      {updateResult.error.message}
                    </p>
                  )
                }
                <form
                  method="POST"
                  action={actions.dwellings.update}
                  class="mt-4 grid grid-cols-2 gap-3"
                >
                  <input
                    type="hidden"
                    name="organizationId"
                    value={organizationId}
                  />
                  <input type="hidden" name="dwellingId" value={dwellingId} />
                  <div class="col-span-2">
                    <label class="block text-label" for="billingName"
                      >{t("Billing name")}</label
                    >
                    <input
                      id="billingName"
                      name="billingName"
                      value={dwelling.billingName ?? ""}
                      class="mt-1 w-full rounded-control border border-border px-3 py-2 text-body-sm"
                    />
                  </div>
                  <div>
                    <label
                      class="block text-label text-foreground"
                      for="occupantName">{t("Occupant name")}</label
                    >
                    <input
                      id="occupantName"
                      name="occupantName"
                      value={dwelling.occupantName ?? ""}
                      class="mt-1 w-full rounded-control border border-border px-3 py-2 text-body-sm"
                    />
                  </div>
                  <div>
                    <label class="block text-label text-foreground" for="areaM2"
                      >{t("Area (m²)")}</label
                    >
                    <input
                      id="areaM2"
                      name="areaM2"
                      type="number"
                      step="0.01"
                      min="0"
                      value={dwelling.areaM2}
                      class="mt-1 w-full rounded-control border border-border px-3 py-2 text-body-sm"
                    />
                  </div>
                  <div>
                    <label
                      class="block text-label text-foreground"
                      for="residentCount">{t("Resident count")}</label
                    >
                    <input
                      id="residentCount"
                      name="residentCount"
                      type="number"
                      min="0"
                      value={dwelling.residentCount}
                      class="mt-1 w-full rounded-control border border-border px-3 py-2 text-body-sm"
                    />
                  </div>
                  <div>
                    <label
                      class="block text-label text-foreground"
                      for="billingEmail">{t("Billing email")}</label
                    >
                    <input
                      id="billingEmail"
                      name="billingEmail"
                      type="email"
                      value={dwelling.billingEmail ?? ""}
                      class="mt-1 w-full rounded-control border border-border px-3 py-2 text-body-sm"
                    />
                  </div>
                  <div class="col-span-2">
                    <label
                      class="block text-label text-foreground"
                      for="billingAddress">{t("Billing address")}</label
                    >
                    <input
                      id="billingAddress"
                      name="billingAddress"
                      value={dwelling.billingAddress ?? ""}
                      class="mt-1 w-full rounded-control border border-border px-3 py-2 text-body-sm"
                    />
                  </div>
                  <div class="col-span-2 flex gap-2">
                    <button type="submit" class="btn-primary">
                      {t("Save")}
                    </button>
                  </div>
                </form>
              </div>
            </details>
          </div>
          <dl class="detail-list">
            <div>
              <dt>{t("Occupant name")}</dt>
              <dd>{dwelling.occupantName ?? "—"}</dd>
            </div>
            <div>
              <dt>{t("Billing name")}</dt>
              <dd>{dwelling.billingName ?? "—"}</dd>
            </div>
            <div>
              <dt>{t("Billing email")}</dt>
              <dd>{dwelling.billingEmail ?? "—"}</dd>
            </div>
            <div>
              <dt>{t("Billing address")}</dt>
              <dd>{dwelling.billingAddress ?? "—"}</dd>
            </div>
            <div>
              <dt>{t("Area (m²)")}</dt>
              <dd>{dwelling.areaM2}</dd>
            </div>
            <div>
              <dt>{t("Resident count")}</dt>
              <dd>{dwelling.residentCount}</dd>
            </div>
          </dl>
        </section>

        <section
          id="account-balance"
          class="panel p-6"
          data-panel="account-balance"
        >
          <div class="card-header">
            <div>
              <h2>{t("Account balance")}</h2>
              <p class="text-body-sm text-muted">
                {t("All adjustments and balance history.")}
              </p>
            </div>
            <details class="edit-disclosure" open={!!adjustmentResult?.error}>
              <summary class="btn-secondary">
                <Icon name="plus" size="sm" />
                {t("Add adjustment")}
              </summary>
              <div class="edit-disclosure-panel">
                {
                  adjustmentResult?.error && (
                    <p class="notice notice-danger" role="alert">
                      {friendlyActionErrorMessage(
                        adjustmentResult.error,
                        locale
                      )}
                    </p>
                  )
                }
                <form
                  method="POST"
                  action={actions.accounts.createAdjustment}
                  class="mt-4 grid grid-cols-2 gap-3"
                >
                  <input
                    type="hidden"
                    name="organizationId"
                    value={organizationId}
                  />
                  <input type="hidden" name="dwellingId" value={dwellingId} />
                  <input
                    type="hidden"
                    name="currency"
                    value={organization.currency}
                  />
                  <div>
                    <label class="block text-label" for="adjustment-direction"
                      >{t("Type")}</label
                    >
                    <select
                      id="adjustment-direction"
                      name="direction"
                      class="mt-1 w-full"
                    >
                      <option value="CHARGE">{t("Charge adjustment")}</option>
                      <option value="CREDIT">{t("Credit adjustment")}</option>
                    </select>
                  </div>
                  <div>
                    <label class="block text-label" for="adjustment-amount"
                      >{t("Amount")}</label
                    >
                    <input
                      id="adjustment-amount"
                      name="amount"
                      inputmode="decimal"
                      required
                      class="mt-1 w-full"
                    />
                  </div>
                  <div>
                    <label class="block text-label" for="adjustment-date"
                      >{t("Date")}</label
                    >
                    <input
                      id="adjustment-date"
                      name="effectiveDate"
                      type="date"
                      required
                      class="mt-1 w-full"
                    />
                  </div>
                  <div>
                    <label class="block text-label" for="adjustment-reason"
                      >{t("Reason")}</label
                    >
                    <input
                      id="adjustment-reason"
                      name="reason"
                      required
                      class="mt-1 w-full"
                    />
                  </div>
                  <div class="col-span-2">
                    <label class="block text-label" for="adjustment-note"
                      >{t("Note")}</label
                    >
                    <textarea
                      id="adjustment-note"
                      name="note"
                      class="mt-1 w-full"></textarea>
                  </div>
                  <div class="col-span-2">
                    <button class="btn-secondary" type="submit"
                      >{t("Add adjustment")}</button
                    >
                  </div>
                </form>
              </div>
            </details>
          </div>
          <div class="balance-summary">
            <div class="balance-highlight" data-tone={balanceKpiTone}>
              <span>
                {isCredit ? t("Account credit") : t("Outstanding balance")}
              </span>
              <strong>
                {formatMoney(balanceForDisplay, organization.currency, locale)}
              </strong>
            </div>
            <div>
              <span>{t("Total debits")}</span>
              <strong>
                {
                  formatMoney(
                    String(totals.debit),
                    organization.currency,
                    locale
                  )
                }
              </strong>
            </div>
            <div>
              <span>{t("Total credits")}</span>
              <strong>
                {
                  formatMoney(
                    String(totals.credit),
                    organization.currency,
                    locale
                  )
                }
              </strong>
            </div>
          </div>
          {
            accountActivity.length > 0 ? (
              <div
                class="table-wrap mt-4"
                role="region"
                aria-label={t("Account activity")}
                tabindex="0"
              >
                <table class="w-full text-body-sm">
                  <thead>
                    <tr>
                      <th>{t("Date")}</th>
                      <th>{t("Description")}</th>
                      <th class="text-right">{t("Debit")}</th>
                      <th class="text-right">{t("Credit")}</th>
                      <th class="text-right">{t("Balance")}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {accountActivity
                      .slice(-10)
                      .reverse()
                      .map((entry) => (
                        <tr>
                          <td>{formatDate(entry.effectiveDate, locale)}</td>
                          <td>{entry.description ?? entry.type}</td>
                          <td class="text-right">
                            {entry.debit === "0.00"
                              ? "—"
                              : formatMoney(
                                  entry.debit,
                                  organization.currency,
                                  locale
                                )}
                          </td>
                          <td class="text-right">
                            {entry.credit === "0.00"
                              ? "—"
                              : formatMoney(
                                  entry.credit,
                                  organization.currency,
                                  locale
                                )}
                          </td>
                          <td class="text-right">
                            {formatMoney(
                              entry.balance,
                              organization.currency,
                              locale
                            )}
                          </td>
                        </tr>
                      ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <EmptyState
                class="mt-4"
                title={t("No account entries yet")}
                description={t("Adjustments will appear here.")}
              />
            )
          }
        </section>

        <section id="messages" class="panel p-6" data-panel="messages">
          <div class="card-header">
            <div>
              <h2>{t("Recent messages")}</h2>
              <p class="text-body-sm text-muted">
                {t("Latest messages with this dwelling.")}
              </p>
            </div>
            <a
              class="btn-secondary"
              href={`${base}/messages?dwellingId=${dwellingId}`}
            >
              {t("View all")}
            </a>
          </div>
          {
            recentMessages.length > 0 ? (
              <ul class="message-preview-list">
                {recentMessages.map((m) => (
                  <li>
                    <p>{m.body}</p>
                    <span>
                      {formatDate(m.createdAt, locale, organization.timezone)}
                    </span>
                  </li>
                ))}
              </ul>
            ) : (
              <EmptyState
                class="mt-5"
                title={t("No messages yet")}
                description={t(
                  "Conversations with residents will appear here."
                )}
              />
            )
          }
        </section>
      </div>

      <div class="dwelling-sidebar">
        <section class="panel p-6" data-panel="overview">
          <div class="card-header">
            <div>
              <h2>{t("Invoice delivery")}</h2>
              <p class="text-body-sm text-muted">
                {t("How this dwelling receives its invoices.")}
              </p>
            </div>
          </div>
          {
            deliveryResult?.error && (
              <p class="notice notice-danger" role="alert">
                {deliveryResult.error.message}
              </p>
            )
          }
          <form
            method="POST"
            action={actions.dwellings.updateInvoiceDelivery}
            class="delivery-form"
            data-delivery-form
          >
            <input type="hidden" name="organizationId" value={organizationId} />
            <input type="hidden" name="dwellingId" value={dwellingId} />
            <ul class="delivery-list">
              <li>
                <label class="delivery-option">
                  <span class="check-toggle">
                    <input
                      type="checkbox"
                      name="invoiceByEmail"
                      checked={dwelling.invoiceByEmail}
                    />
                    <span class="check-icon" aria-hidden="true">
                      <Icon name="check" size="sm" />
                    </span>
                  </span>
                  <span class="delivery-option-text">
                    <strong>{t("Email")}</strong>
                    <p>
                      {
                        dwelling.billingEmail
                          ? `${t("Send invoices to")} ${dwelling.billingEmail}`
                          : t("No billing email on file")
                      }
                    </p>
                  </span>
                </label>
              </li>
              <li>
                <label class="delivery-option">
                  <span class="check-toggle">
                    <input
                      type="checkbox"
                      name="invoiceByPaper"
                      checked={dwelling.invoiceByPaper}
                    />
                    <span class="check-icon" aria-hidden="true">
                      <Icon name="check" size="sm" />
                    </span>
                  </span>
                  <span class="delivery-option-text">
                    <strong>{t("Paper")}</strong>
                    <p>{t("Send a printed copy by mail")}</p>
                  </span>
                </label>
              </li>
            </ul>
            <div class="pt-2">
              <button
                type="submit"
                class="btn-primary"
                disabled={!deliveryResult?.error}
                data-delivery-save
              >
                {t("Save")}
              </button>
            </div>
          </form>
        </section>

        <section id="residents" class="panel p-6" data-panel="residents">
          <div class="card-header">
            <div>
              <h2>{t("Resident access")}</h2>
              <p class="text-body-sm text-muted">
                {t("People who can access their invoices and messages.")}
              </p>
            </div>
            <details
              class="edit-disclosure"
              id="resident-details"
              open={!!assignResult?.error || !!removeResult?.error}
            >
              <summary class="btn-secondary">
                <Icon name="plus" size="sm" />
                {t("Add resident")}
              </summary>
              <div class="edit-disclosure-panel">
                {
                  (assignResult?.error || removeResult?.error) && (
                    <p class="notice notice-danger" role="alert">
                      {friendlyActionErrorMessage(
                        assignResult?.error ?? removeResult?.error,
                        locale
                      )}
                    </p>
                  )
                }
                <form
                  method="POST"
                  action={actions.dwellings.assignResident}
                  id="resident-form"
                  class="mt-4 flex gap-2"
                  data-saving-label={t("Saving…")}
                  data-added-message={t("Resident added")}
                  data-already-has-access={t(
                    "This resident already has access."
                  )}
                  data-generic-error={t(
                    "Something went wrong. Please try again."
                  )}
                  data-remove-label={t("Remove")}
                >
                  <input
                    type="hidden"
                    name="organizationId"
                    value={organizationId}
                  />
                  <input type="hidden" name="dwellingId" value={dwellingId} />
                  <input
                    aria-label={t("Email")}
                    name="email"
                    type="email"
                    required
                    placeholder="resident@example.com"
                    class="flex-1 rounded-control border border-border px-3 py-2 text-body-sm"
                  />
                  <button type="submit" class="btn-primary">
                    {t("Assign")}
                  </button>
                </form>
              </div>
            </details>
          </div>
          <div
            id="residents-list-region"
            data-empty-title={t("No residents assigned.")}
          >
            <ul class="sidebar-item-list" hidden={residents.length === 0}>
              {
                residents.map((r) => (
                  <li data-user-id={r.userId}>
                    <div class="sidebar-item-avatar" aria-hidden="true">
                      {(r.displayName ?? r.email).charAt(0).toUpperCase()}
                    </div>
                    <div class="sidebar-item-body">
                      <strong>{r.displayName ?? r.email}</strong>
                      <p>{r.email}</p>
                    </div>
                    <form
                      method="POST"
                      action={actions.dwellings.removeResident}
                      data-resident-remove-form
                    >
                      <input
                        type="hidden"
                        name="organizationId"
                        value={organizationId}
                      />
                      <input
                        type="hidden"
                        name="dwellingId"
                        value={dwellingId}
                      />
                      <input type="hidden" name="userId" value={r.userId} />
                      <button type="submit" class="sidebar-item-remove">
                        {t("Remove")}
                      </button>
                    </form>
                  </li>
                ))
              }
            </ul>
            <div id="residents-empty-state" hidden={residents.length > 0}>
              <EmptyState title={t("No residents assigned.")} />
            </div>
          </div>
        </section>

        <section id="meters" class="panel p-6" data-panel="meters">
          <div class="card-header">
            <div>
              <h2>{t("Meters")}</h2>
              <p class="text-body-sm text-muted">
                {t("Water and other utility meters in this dwelling.")}
              </p>
            </div>
            <details
              class="edit-disclosure"
              id="meter-details"
              open={!!meterResult?.error}
            >
              <summary class="btn-secondary">
                <Icon name="plus" size="sm" />
                {t("Add meter")}
              </summary>
              <div class="edit-disclosure-panel">
                {
                  meterResult?.error && (
                    <p class="notice notice-danger" role="alert">
                      {friendlyActionErrorMessage(meterResult.error, locale)}
                    </p>
                  )
                }
                <form
                  method="POST"
                  action={actions.meters.create}
                  id="meter-form"
                  class="mt-4 grid grid-cols-2 gap-3"
                  data-saving-label={t("Saving…")}
                  data-added-message={t("Meter added")}
                  data-generic-error={t(
                    "Something went wrong. Please try again."
                  )}
                  data-archive-label={t("Archive")}
                  data-archived-label={t("archived")}
                >
                  <input
                    type="hidden"
                    name="organizationId"
                    value={organizationId}
                  />
                  <input type="hidden" name="dwellingId" value={dwellingId} />
                  <div>
                    <label class="block text-label text-foreground" for="type"
                      >{t("Type")}</label
                    >
                    <select
                      id="type"
                      name="type"
                      class="mt-1 w-full rounded-control border border-border px-3 py-2 text-body-sm"
                    >
                      {
                        meterTypeOptions.map((mt) => (
                          <option value={mt} data-icon={meterTypeIcons[mt]}>
                            {entityLabel(mt, locale)}
                          </option>
                        ))
                      }
                    </select>
                  </div>
                  <div>
                    <label class="block text-label text-foreground" for="unit"
                      >{t("Unit")}</label
                    >
                    <input
                      id="unit"
                      name="unit"
                      required
                      placeholder="m3"
                      class="mt-1 w-full rounded-control border border-border px-3 py-2 text-body-sm"
                    />
                  </div>
                  <div>
                    <label
                      class="block text-label text-foreground"
                      for="serialNumber">{t("Serial number")}</label
                    >
                    <input
                      id="serialNumber"
                      name="serialNumber"
                      class="mt-1 w-full rounded-control border border-border px-3 py-2 text-body-sm"
                    />
                  </div>
                  <div>
                    <label class="block text-label text-foreground" for="label"
                      >{t("Label")}</label
                    >
                    <input
                      id="label"
                      name="label"
                      class="mt-1 w-full rounded-control border border-border px-3 py-2 text-body-sm"
                    />
                  </div>
                  <div class="col-span-2">
                    <button type="submit" class="btn-primary">
                      {t("Add meter")}
                    </button>
                  </div>
                </form>
              </div>
            </details>
          </div>
          <div
            class="meter-filters"
            role="group"
            aria-label={t("Filter meters")}
          >
            <button
              type="button"
              class="btn-secondary btn-sm"
              data-meter-filter="active"
              aria-pressed="true">{t("Active")}</button
            >
            <button
              type="button"
              class="btn-secondary btn-sm"
              data-meter-filter="archived"
              aria-pressed="false">{t("Archived")}</button
            >
          </div>
          <div
            id="meters-list-region"
            data-empty-active={t("No active meters for this dwelling.")}
            data-empty-archived={t("No archived meters for this dwelling.")}
          >
            <ul class="sidebar-item-list" hidden={activeMeterCount === 0}>
              {
                meterList.map((m) => (
                  <li
                    class="meter-row"
                    data-meter-id={m.id}
                    data-archived={m.archivedAt ? "true" : "false"}
                    hidden={!!m.archivedAt}
                  >
                    <div
                      class="sidebar-item-icon"
                      data-meter-type={m.type}
                      aria-hidden="true"
                    >
                      {meterTypeIcons[m.type] ?? "•"}
                    </div>
                    <div class="sidebar-item-body">
                      <strong>
                        {m.label ?? entityLabel(m.type, locale)}
                        {m.archivedAt && ` (${t("archived")})`}
                      </strong>
                      <p>
                        {m.serialNumber ? `${m.serialNumber} · ` : ""}
                        {m.unit}
                      </p>
                    </div>
                    {!m.archivedAt && (
                      <form
                        method="POST"
                        action={actions.meters.archive}
                        data-meter-archive-form
                      >
                        <input
                          type="hidden"
                          name="organizationId"
                          value={organizationId}
                        />
                        <input type="hidden" name="meterId" value={m.id} />
                        <button type="submit" class="sidebar-item-remove">
                          {t("Archive")}
                        </button>
                      </form>
                    )}
                  </li>
                ))
              }
            </ul>
            <div id="meters-empty-state" hidden={activeMeterCount > 0}>
              <EmptyState title={t("No active meters for this dwelling.")} />
            </div>
          </div>
        </section>
      </div>
    </div>

    <section id="period-history" class="panel p-6" data-panel="history">
      <h2>{t("Period history")}</h2>
      <p class="text-body-sm text-muted">
        {t("This dwelling's billing case in every period it has existed for.")}
      </p>
      {
        caseHistory.length > 0 ? (
          <div class="table-wrap mt-4">
            <table class="w-full text-left text-body-sm">
              <thead class="border-b border-border bg-surface-hover text-muted">
                <tr>
                  <th class="px-4 py-2">{t("Period")}</th>
                  <th class="px-4 py-2">{t("Status")}</th>
                  <th class="px-4 py-2">{t("Invoice")}</th>
                  <th class="px-4 py-2 text-right">{t("Amount due")}</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                {caseHistory.map((c) => (
                  <tr>
                    <td class="px-4 py-2">
                      {c.periodYear}-{String(c.periodMonth).padStart(2, "0")}
                    </td>
                    <td class="px-4 py-2">
                      <StatusBadge status={c.status} />
                    </td>
                    <td class="px-4 py-2">
                      {c.invoiceId ? (
                        <a
                          href={`${base}/periods/${c.periodId}/invoices/${c.invoiceId}`}
                          class="text-primary hover:underline"
                        >
                          {c.invoiceNumber}
                        </a>
                      ) : (
                        "—"
                      )}
                    </td>
                    <td class="px-4 py-2 text-right">
                      {c.invoiceAmountDue
                        ? formatMoney(
                            c.invoiceAmountDue,
                            organization.currency,
                            locale
                          )
                        : "—"}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <EmptyState title={t("No billing periods yet.")} />
        )
      }
    </section>

    <section id="audit-history" class="panel p-6" data-panel="history">
      <h2>{t("Audit history")}</h2>
      <p class="text-body-sm text-muted">
        {t("Changes recorded against this dwelling.")}
      </p>
      {
        auditEntries.length > 0 ? (
          <div class="table-wrap mt-4">
            <table class="w-full text-left text-body-sm">
              <thead class="border-b border-border bg-surface-hover text-muted">
                <tr>
                  <th class="px-4 py-2">{t("Time")}</th>
                  <th class="px-4 py-2">{t("Actor")}</th>
                  <th class="px-4 py-2">{t("Action")}</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                {auditEntries.map((log) => (
                  <tr>
                    <td class="px-4 py-2">
                      {formatDate(log.createdAt, locale, organization.timezone)}
                    </td>
                    <td class="px-4 py-2">
                      {log.actorDisplayName ?? log.actorEmail ?? "—"}
                    </td>
                    <td class="px-4 py-2">{log.action}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <EmptyState title={t("No audit events for this dwelling yet.")} />
        )
      }
    </section>

    <section class="panel p-6" data-panel="overview">
      <div class="card-header">
        <div>
          <h2>{t("Additional information")}</h2>
          <p class="text-body-sm text-muted">
            {t("Internal notes and metadata.")}
          </p>
        </div>
        <details class="edit-disclosure" open={!!additionalInfoResult?.error}>
          <summary class="btn-secondary">
            <Icon name="pencil" size="sm" />
            {t("Edit")}
          </summary>
          <div class="edit-disclosure-panel">
            <form
              method="POST"
              action={actions.dwellings.update}
              class="mt-4 grid grid-cols-2 gap-3"
            >
              <input
                type="hidden"
                name="organizationId"
                value={organizationId}
              />
              <input type="hidden" name="dwellingId" value={dwellingId} />
              <div>
                <label
                  class="block text-label text-foreground"
                  for="dwelling-type">{t("Type")}</label
                >
                <select
                  id="dwelling-type"
                  name="type"
                  class="mt-1 w-full rounded-control border border-border px-3 py-2 text-body-sm"
                >
                  {
                    dwellingTypeOptions.map((dt) => (
                      <option value={dt} selected={dwelling.type === dt}>
                        {entityLabel(dt, locale)}
                      </option>
                    ))
                  }
                </select>
              </div>
              <div class="col-span-2">
                <label class="block text-label text-foreground" for="notes"
                  >{t("Notes")}</label
                >
                <textarea
                  id="notes"
                  name="notes"
                  class="mt-1 w-full rounded-control border border-border px-3 py-2 text-body-sm"
                  >{dwelling.notes ?? ""}</textarea
                >
              </div>
              <div class="col-span-2">
                <button type="submit" class="btn-primary">{t("Save")}</button>
              </div>
            </form>
          </div>
        </details>
      </div>
      <dl class="detail-list">
        <div>
          <dt>{t("Building")}</dt>
          <dd>{organization.name}</dd>
        </div>
        <div>
          <dt>{t("Apartment number")}</dt>
          <dd>{dwelling.number}</dd>
        </div>
        <div>
          <dt>{t("Type")}</dt>
          <dd>{entityLabel(dwelling.type, locale)}</dd>
        </div>
        <div>
          <dt>{t("Status")}</dt>
          <dd><StatusBadge status={dwellingStatus} /></dd>
        </div>
        <div>
          <dt>{t("Notes")}</dt>
          <dd>{dwelling.notes ?? "—"}</dd>
        </div>
        <div>
          <dt>{t("Created")}</dt>
          <dd>
            {formatDate(dwelling.createdAt, locale, organization.timezone)}
          </dd>
        </div>
        <div>
          <dt>{t("Last updated")}</dt>
          <dd>
            {formatDate(dwelling.updatedAt, locale, organization.timezone)}
          </dd>
        </div>
      </dl>
    </section>

    {
      !dwelling.archivedAt && (
        <dialog class="lock-dialog" id="archive-dialog">
          <div class="dialog-body">
            <div class="dialog-icon" aria-hidden="true">
              !
            </div>
            <div>
              <h2>{t("Archive this dwelling?")}</h2>
              <p>
                {t(
                  "Archiving hides it from new periods and active lists. Past invoices and readings remain intact."
                )}
              </p>
            </div>
          </div>
          <div class="dialog-actions">
            <form method="dialog">
              <button class="btn-secondary" value="cancel">
                {t("Cancel")}
              </button>
            </form>
            <form method="POST" action={actions.dwellings.archive}>
              <input
                type="hidden"
                name="organizationId"
                value={organizationId}
              />
              <input type="hidden" name="dwellingId" value={dwellingId} />
              <button type="submit" class="btn-danger">
                {t("Archive dwelling")}
              </button>
            </form>
          </div>
        </dialog>
      )
    }
  </div>
</AdminLayout>

<script>
  import { actions } from "astro:actions";
  import {
    bindMutationForm,
    copyAstroScope,
    showMutationSuccess,
  } from "../../../../../lib/ui/mutate-form";
  import {
    meterListVisibility,
    type MeterFilter,
  } from "../../../../../lib/ui/meter-list";

  const archiveDialog =
    document.querySelector<HTMLDialogElement>("#archive-dialog");
  document
    .querySelector<HTMLButtonElement>("[data-open-archive-dialog]")
    ?.addEventListener("click", () => {
      document.querySelector(".more-menu")?.removeAttribute("open");
      archiveDialog?.showModal();
    });
  archiveDialog?.addEventListener("click", (event) => {
    if (event.target === archiveDialog) archiveDialog.close();
  });

  // Tabs filter which panels are visible -- "overview" (the default) shows
  // every panel; any other tab shows only the one panel that declares a
  // matching data-panel, hiding the rest (including panels like "Basic
  // information"/"Invoice delivery" that only ever appear under Overview,
  // since they have no tab of their own).
  const tabs = [
    ...document.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
  ];
  const panels = [...document.querySelectorAll<HTMLElement>("[data-panel]")];
  const panelGroup = document.querySelector<HTMLElement>("[data-panel-group]");

  function setFilter(filter: string) {
    for (const panel of panels) {
      panel.hidden = filter !== "overview" && panel.dataset.panel !== filter;
    }
    for (const tab of tabs) {
      tab.setAttribute(
        "aria-selected",
        tab.dataset.filter === filter ? "true" : "false"
      );
    }
    panelGroup?.classList.toggle("is-filtered", filter !== "overview");
  }

  for (const tab of tabs) {
    tab.addEventListener("click", () => {
      const filter = tab.dataset.filter;
      if (filter) setFilter(filter);
    });
  }

  document
    .querySelectorAll<HTMLButtonElement>("[data-goto-panel]")
    ?.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.gotoPanel;
        if (!filter) return;
        setFilter(filter);
        document.querySelector(".more-menu")?.removeAttribute("open");
        const reduceMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;
        document
          .querySelector(`[data-panel="${filter}"]`)
          ?.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth" });
      });
    });

  // Invoice delivery: no separate edit mode -- the checkboxes are always
  // live, and Save only becomes active once they actually differ from the
  // saved state (rather than always being submittable).
  const deliveryForm = document.querySelector<HTMLFormElement>(
    "[data-delivery-form]"
  );
  const deliverySave = deliveryForm?.querySelector<HTMLButtonElement>(
    "[data-delivery-save]"
  );
  if (deliveryForm && deliverySave) {
    const deliveryCheckboxes = [
      ...deliveryForm.querySelectorAll<HTMLInputElement>(
        'input[type="checkbox"]'
      ),
    ];
    const initialState = deliveryCheckboxes.map((box) => box.checked);
    const updateSaveState = () => {
      const isDirty = deliveryCheckboxes.some(
        (box, index) => box.checked !== initialState[index]
      );
      deliverySave.disabled = !isDirty;
    };
    for (const box of deliveryCheckboxes) {
      box.addEventListener("change", updateSaveState);
    }
  }

  // ---- Meters: submit once, patch the list from the returned meter, no
  // full-page reload (previously a plain <form method="POST"> with no JS
  // at all -- there was never a duplicate listener here; the fix is a
  // single submit-event binding plus a pending-state guard, see
  // src/lib/ui/mutate-form.ts's header comment). ----
  interface CreatedMeter {
    id: string;
    type: string;
    label: string | null;
    serialNumber: string | null;
    unit: string;
    archivedAt: string | null;
  }

  const meterForm = document.querySelector<HTMLFormElement>("#meter-form");
  const meterDetails =
    document.querySelector<HTMLDetailsElement>("#meter-details");
  const metersListRegion = document.querySelector<HTMLElement>(
    "#meters-list-region"
  );
  const metersList =
    metersListRegion?.querySelector<HTMLUListElement>(".sidebar-item-list");
  const metersEmptyState = metersListRegion?.querySelector<HTMLElement>(
    "#meters-empty-state"
  );
  const meterFilterButtons = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-meter-filter]"),
  ];
  let meterFilter: MeterFilter = "active";

  function reconcileMeterList() {
    if (!metersList || !metersEmptyState) return;
    const rows = [...metersList.querySelectorAll<HTMLLIElement>(".meter-row")];
    const visibility = meterListVisibility(
      rows.map((row) => row.dataset.archived === "true"),
      meterFilter
    );
    rows.forEach((row, index) => {
      row.hidden = !visibility.rows[index];
    });
    metersList.hidden = visibility.empty;
    metersEmptyState.hidden = !visibility.empty;
    const title = metersEmptyState.querySelector<HTMLElement>(".text-h3");
    if (title) {
      title.textContent =
        meterFilter === "archived"
          ? (metersListRegion?.dataset.emptyArchived ?? "No archived meters.")
          : (metersListRegion?.dataset.emptyActive ?? "No active meters.");
    }
    for (const button of meterFilterButtons) {
      button.setAttribute(
        "aria-pressed",
        button.dataset.meterFilter === meterFilter ? "true" : "false"
      );
    }
  }

  for (const button of meterFilterButtons) {
    button.addEventListener("click", () => {
      const nextFilter = button.dataset.meterFilter;
      if (nextFilter === "active" || nextFilter === "archived") {
        meterFilter = nextFilter;
        reconcileMeterList();
      }
    });
  }

  // Keep archived rows in the DOM so the Archived filter can reveal them.
  // Updating metadata, label and controls in place also matches the row SSR
  // renders after a refresh.
  function markMeterRowArchived(
    row: HTMLLIElement,
    form: HTMLFormElement,
    meter: CreatedMeter
  ) {
    row.dataset.archived = meter.archivedAt ? "true" : "false";
    const strong = row.querySelector("strong");
    if (strong) {
      const suffix = meterForm?.dataset.archivedLabel ?? "archived";
      strong.textContent = `${strong.textContent} (${suffix})`;
    }
    form.remove();
    reconcileMeterList();
  }

  function bindMeterArchiveForm(form: HTMLFormElement, row: HTMLLIElement) {
    bindMutationForm({
      form,
      action: (fd) => actions.meters.archive(fd),
      savingLabel: "…",
      fallbackErrorMessage:
        meterForm?.dataset.genericError ??
        "Something went wrong. Please try again.",
      onSuccess: (meter) =>
        markMeterRowArchived(row, form, meter as CreatedMeter),
    });
  }

  function buildMeterRow(meter: CreatedMeter): HTMLLIElement {
    const option = meterForm?.querySelector<HTMLOptionElement>(
      `option[value="${meter.type}"]`
    );
    const li = document.createElement("li");
    li.className = "meter-row";
    li.dataset.meterId = meter.id;
    li.dataset.archived = meter.archivedAt ? "true" : "false";

    const icon = document.createElement("div");
    icon.className = "sidebar-item-icon";
    icon.dataset.meterType = meter.type;
    icon.setAttribute("aria-hidden", "true");
    icon.textContent = option?.dataset.icon ?? "•";

    const body = document.createElement("div");
    body.className = "sidebar-item-body";
    const strong = document.createElement("strong");
    strong.textContent =
      meter.label ?? option?.textContent?.trim() ?? meter.type;
    const unitLine = document.createElement("p");
    unitLine.textContent = meter.serialNumber
      ? `${meter.serialNumber} · ${meter.unit}`
      : meter.unit;
    body.appendChild(strong);
    body.appendChild(unitLine);

    const archiveForm = document.createElement("form");
    archiveForm.method = "POST";
    archiveForm.dataset.meterArchiveForm = "";
    const orgId =
      meterForm?.querySelector<HTMLInputElement>('input[name="organizationId"]')
        ?.value ?? "";
    archiveForm.insertAdjacentHTML(
      "beforeend",
      `<input type="hidden" name="organizationId" value="${orgId}" />
       <input type="hidden" name="meterId" value="${meter.id}" />
       <button type="submit" class="sidebar-item-remove">${
         meterForm?.dataset.archiveLabel ?? "Archive"
       }</button>`
    );
    bindMeterArchiveForm(archiveForm, li);

    li.appendChild(icon);
    li.appendChild(body);
    li.appendChild(archiveForm);
    if (meterForm) {
      copyAstroScope(
        meterForm,
        li,
        icon,
        body,
        strong,
        unitLine,
        archiveForm,
        ...Array.from(archiveForm.children)
      );
    }
    return li;
  }

  if (meterForm) {
    bindMutationForm({
      form: meterForm,
      action: (fd) => actions.meters.create(fd),
      savingLabel: meterForm.dataset.savingLabel ?? "Saving…",
      fallbackErrorMessage:
        meterForm.dataset.genericError ??
        "Something went wrong. Please try again.",
      onSuccess: (meter) => {
        metersList?.appendChild(buildMeterRow(meter as CreatedMeter));
        reconcileMeterList();
        meterForm.reset();
        if (meterDetails) meterDetails.open = false;
        const header = document.querySelector("#meters .card-header");
        if (header) {
          showMutationSuccess(
            header,
            meterForm.dataset.addedMessage ?? "Meter added"
          );
        }
      },
    });
  }

  for (const form of document.querySelectorAll<HTMLFormElement>(
    "[data-meter-archive-form]"
  )) {
    const row = form.closest("li");
    if (row) bindMeterArchiveForm(form, row);
  }

  // ---- Residents: same pattern. A resident who already has access still
  // returns success (existing business rule, see assignResident's
  // onConflictDoNothing) -- guarded here by userId so re-submitting an
  // existing resident's email never duplicates their row. ----
  interface AssignedResident {
    userId: string;
    email: string;
    displayName: string | null;
  }

  const residentForm =
    document.querySelector<HTMLFormElement>("#resident-form");
  const residentDetails =
    document.querySelector<HTMLDetailsElement>("#resident-details");
  const residentsListRegion = document.querySelector<HTMLElement>(
    "#residents-list-region"
  );

  const residentsList =
    residentsListRegion?.querySelector<HTMLUListElement>(".sidebar-item-list");
  const residentsEmptyState = residentsListRegion?.querySelector<HTMLElement>(
    "#residents-empty-state"
  );

  function reconcileResidentList() {
    if (!residentsList || !residentsEmptyState) return;
    const empty = residentsList.children.length === 0;
    residentsList.hidden = empty;
    residentsEmptyState.hidden = !empty;
  }

  // Assign and every remove form share this one flag: two resident
  // mutations for this dwelling can otherwise resolve out of order (e.g.
  // remove resident A, then quickly re-add A before the removal's response
  // arrives) and leave the UI showing the opposite of what the server
  // actually holds. Serializing them here removes that race -- a second
  // resident-section submit while one is still in flight is rejected
  // immediately, client-side, before it ever reaches the server.
  let residentsBusy = false;
  async function guardedResidentAction<T>(
    call: () => Promise<{
      data?: T;
      error?: import("astro:actions").ActionError;
    }>
  ): Promise<{ data?: T; error?: import("astro:actions").ActionError }> {
    if (residentsBusy) {
      return {
        error: {
          message:
            residentForm?.dataset.genericError ??
            "Something went wrong. Please try again.",
        } as import("astro:actions").ActionError,
      };
    }
    residentsBusy = true;
    try {
      return await call();
    } finally {
      residentsBusy = false;
    }
  }

  function bindResidentRemoveForm(form: HTMLFormElement, row: HTMLLIElement) {
    bindMutationForm({
      form,
      action: (fd) =>
        guardedResidentAction(() => actions.dwellings.removeResident(fd)),
      savingLabel: "…",
      fallbackErrorMessage:
        residentForm?.dataset.genericError ??
        "Something went wrong. Please try again.",
      onSuccess: () => {
        row.remove();
        reconcileResidentList();
      },
    });
  }

  function buildResidentRow(resident: AssignedResident): HTMLLIElement {
    const li = document.createElement("li");
    li.dataset.userId = resident.userId;

    const avatar = document.createElement("div");
    avatar.className = "sidebar-item-avatar";
    avatar.setAttribute("aria-hidden", "true");
    avatar.textContent = (resident.displayName ?? resident.email)
      .charAt(0)
      .toUpperCase();

    const body = document.createElement("div");
    body.className = "sidebar-item-body";
    const strong = document.createElement("strong");
    strong.textContent = resident.displayName ?? resident.email;
    const emailLine = document.createElement("p");
    emailLine.textContent = resident.email;
    body.appendChild(strong);
    body.appendChild(emailLine);

    const removeForm = document.createElement("form");
    removeForm.method = "POST";
    removeForm.dataset.residentRemoveForm = "";
    const orgId =
      residentForm?.querySelector<HTMLInputElement>(
        'input[name="organizationId"]'
      )?.value ?? "";
    const dwellingIdValue =
      residentForm?.querySelector<HTMLInputElement>('input[name="dwellingId"]')
        ?.value ?? "";
    removeForm.insertAdjacentHTML(
      "beforeend",
      `<input type="hidden" name="organizationId" value="${orgId}" />
       <input type="hidden" name="dwellingId" value="${dwellingIdValue}" />
       <input type="hidden" name="userId" value="${resident.userId}" />
       <button type="submit" class="sidebar-item-remove">${
         residentForm?.dataset.removeLabel ?? "Remove"
       }</button>`
    );
    bindResidentRemoveForm(removeForm, li);

    li.appendChild(avatar);
    li.appendChild(body);
    li.appendChild(removeForm);
    if (residentForm) {
      copyAstroScope(
        residentForm,
        li,
        avatar,
        body,
        strong,
        emailLine,
        removeForm,
        ...Array.from(removeForm.children)
      );
    }
    return li;
  }

  if (residentForm) {
    bindMutationForm({
      form: residentForm,
      action: (fd) =>
        guardedResidentAction(() => actions.dwellings.assignResident(fd)),
      savingLabel: residentForm.dataset.savingLabel ?? "Saving…",
      fallbackErrorMessage:
        residentForm.dataset.genericError ??
        "Something went wrong. Please try again.",
      onSuccess: (resident) => {
        const { userId, email, displayName } = resident as AssignedResident;
        const header = document.querySelector("#residents .card-header");
        residentForm.reset();
        if (residentDetails) residentDetails.open = false;
        const alreadyPresent = residentsList?.querySelector(
          `[data-user-id="${userId}"]`
        );
        if (alreadyPresent) {
          if (header) {
            showMutationSuccess(
              header,
              residentForm.dataset.alreadyHasAccess ??
                "This resident already has access."
            );
          }
          return;
        }
        residentsList?.appendChild(
          buildResidentRow({ userId, email, displayName })
        );
        reconcileResidentList();
        if (header) {
          showMutationSuccess(
            header,
            residentForm.dataset.addedMessage ?? "Resident added"
          );
        }
      },
    });
  }

  for (const form of document.querySelectorAll<HTMLFormElement>(
    "[data-resident-remove-form]"
  )) {
    const row = form.closest("li");
    if (row) bindResidentRemoveForm(form, row);
  }
</script>

