                        type="hidden"
                        name="organizationId"
                        value={organizationId}
                      />
                      <input type="hidden" name="userId" value={r.userId} />
                      <input
                        type="hidden"
                        name="disabled"
                        value={r.disabledAt ? "false" : "true"}
                      />
                      <button
                        type="submit"
                        class="item-action"
                        data-confirm={
                          r.disabledAt
                            ? undefined
                            : fill(
                                t(
                                  "Disable {email}? They cannot sign in until the account is enabled again."
