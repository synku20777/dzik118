---
// Phase D (Organizations/dwellings) - dwelling detail (spec Section 9.2, 27
// "Dwellings: Detail").
import StatusBadge from "../../../../../components/ui/StatusBadge.astro";
import Icon from "../../../../../components/ui/Icon.astro";
import EmptyState from "../../../../../components/ui/EmptyState.astro";
import {
  translate,
  uiLocale,
  entityLabel,
  fill,
  formatDate,
  formatMoney,
  friendlyActionErrorMessage,
} from "../../../../../lib/ui/i18n";
import { ledgerDescriptionText } from "../../../../../lib/ui/ledger-description";
import { errorTranslations } from "../../../../../lib/ui/error-translations";
// The modules whose messages this page's client-side saves can show; see
// error-translations.ts.
import dwellingsDomain from "../../../../../domain/organizations/dwellings.ts?raw";
import metersDomain from "../../../../../domain/organizations/meters.ts?raw";
import adjustmentsDomain from "../../../../../domain/accounts/adjustments.ts?raw";
import manualPaymentsDomain from "../../../../../domain/payments/manual.ts?raw";
import directPaymentsDomain from "../../../../../domain/payments/direct.ts?raw";
import guardsDomain from "../../../../../domain/authorization/guards.ts?raw";
import accountsActions from "../../../../../actions/accounts.ts?raw";
import paymentsActions from "../../../../../actions/payments.ts?raw";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import { actions } from "astro:actions";
import {
  ForbiddenError,
  requireOrganizationAccess,
} from "../../../../../domain/authorization/guards";
import { getOrganization } from "../../../../../domain/organizations/organizations";
import {
  getDwelling,
  listDwellingResidents,
} from "../../../../../domain/organizations/dwellings";
import { listMeters } from "../../../../../domain/organizations/meters";
import { withRequestDb } from "../../../../../lib/db-request";
import { rethrowUnexpected } from "../../../../../domain/errors";
import {
  getDwellingAccountBalance,
  listDwellingAccountActivity,
} from "../../../../../domain/accounts/ledger";
import { listCasesForDwelling } from "../../../../../domain/periods/cases";
import { getCurrentOpenPeriod } from "../../../../../domain/periods/periods";
import { listAuditLogs } from "../../../../../domain/audit/audit-log";
import { listConversationsWithMessagesForDwelling } from "../../../../../domain/messaging/conversations";
import { listCurrentApplicableRulesForDwelling } from "../../../../../domain/billing/rules";
import { listOpenInvoicesForPayment } from "../../../../../domain/payments/manual";
import { orgLocalDateString } from "../../../../../lib/org-time";
import ManualPaymentForm from "../../../../../components/ui/ManualPaymentForm.astro";

const organizationId = Astro.params.orgId!;
const dwellingId = Astro.params.dwellingId!;
try {
  requireOrganizationAccess(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const updateResult = Astro.getActionResult(actions.dwellings.update);
const deliveryResult = Astro.getActionResult(
  actions.dwellings.updateInvoiceDelivery
);
const assignResult = Astro.getActionResult(actions.dwellings.assignResident);
const removeResult = Astro.getActionResult(actions.dwellings.removeResident);
const residentDisabledResult = Astro.getActionResult(
  actions.dwellings.setResidentDisabled
);
const meterCreateResult = Astro.getActionResult(actions.meters.create);
const meterArchiveResult = Astro.getActionResult(actions.meters.archive);
const meterUpdateResult = Astro.getActionResult(actions.meters.update);
const adjustmentResult = Astro.getActionResult(
  actions.accounts.createAdjustment
);
const archiveResult = Astro.getActionResult(actions.dwellings.archive);
const recordPaymentResult = Astro.getActionResult(
  actions.payments.recordManual
);

let organization: Awaited<ReturnType<typeof getOrganization>>,
  dwelling,
  residents,
  meterList,
  accountBalance,
  accountActivity,
  openInvoices,
  caseHistory,
  currentOpenPeriod,
  auditEntries,
  conversationsWithMessages,
  currentTariffs: Awaited<
    ReturnType<typeof listCurrentApplicableRulesForDwelling>
  >;
try {
  ({
    organization,
    dwelling,
    residents,
    meterList,
    accountBalance,
    accountActivity,
    openInvoices,
    caseHistory,
    currentOpenPeriod,
    auditEntries,
    conversationsWithMessages,
    currentTariffs,
  } = await withRequestDb(async (db) => {
    const organization = await getOrganization(db, organizationId);
    return {
      organization,
      dwelling: await getDwelling(db, organizationId, dwellingId),
      residents: await listDwellingResidents(db, dwellingId),
      meterList: await listMeters(db, organizationId, dwellingId),
      accountBalance: await getDwellingAccountBalance(
        db,
        organizationId,
        dwellingId,
        organization.currency
      ),
      accountActivity: await listDwellingAccountActivity(
        db,
        organizationId,
        dwellingId,
        organization.currency
      ),
      openInvoices: await listOpenInvoicesForPayment(
        db,
        organizationId,
        dwellingId
      ),
      caseHistory: await listCasesForDwelling(db, organizationId, dwellingId),
      currentOpenPeriod: await getCurrentOpenPeriod(db, organizationId),
      auditEntries: await listAuditLogs(db, organizationId, {
        scopeDwellingId: dwellingId,
        limit: 20,
      }),
      conversationsWithMessages: await listConversationsWithMessagesForDwelling(
        db,
        dwellingId
      ),
      // "Recurring tariffs" (spec: ONE editing surface -- Tariffs & Rules.
      // This page only ever DISPLAYS which live tariffs currently apply
      // here and links to the tariff editor; it never mutates assignment.
      currentTariffs: await listCurrentApplicableRulesForDwelling(
        db,
        organizationId,
        dwellingId,
        organization.timezone
      ),
    };
  }));
} catch (err) {
  rethrowUnexpected(err);
  return Astro.redirect(`/admin/o/${organizationId}/dwellings`);
}

const automaticTariffs = currentTariffs.filter(
  (r) => r.applicationScope === "ONE_TO_ALL"
);
const assignedTariffs = currentTariffs.filter(
  (r) => r.applicationScope !== "ONE_TO_ALL"
);

// MANUAL_AMOUNT has no fixed per-unit price (validateRuleShape allows a
// null unitPrice for it -- the actual amount is entered per period, not
// configured on the rule) -- showing `rule.unitPrice ?? "0"` there would
// misleadingly claim it's always free. Every other calculation type
// requires a non-blank unitPrice, so it's always safe to format directly.
function tariffPriceSummary(rule: {
  calculationType: string;
  unitPrice: string | null;
  unit: string;
}): string {
  if (rule.calculationType === "MANUAL_AMOUNT") {
    return t("Amount set per period");
  }
  return `${formatMoney(rule.unitPrice ?? "0", organization.currency, locale)} / ${rule.unit}`;
}

function tariffScopeReason(scope: string): string {
  if (scope === "ONE_TO_ALL")
    return t("All dwellings") + " · " + t("automatic");
  if (scope === "ONE_TO_ONE")
    return t("One dwelling") + " · " + t("this dwelling");
  return t("Selected dwellings") + " · " + t("assigned here");
}

const dwellingTypeOptions = [
  "APARTMENT",
  "COMMERCIAL_UNIT",
  "PARKING",
  "STORAGE",
  "OTHER",
] as const;
const meterTypeOptions = [
  "COLD_WATER",
  "HOT_WATER",
  "ELECTRICITY",
  "GAS",
  "HEAT",
  "OTHER",
] as const;

const base = `/admin/o/${organizationId}`;
const todayInOrg = orgLocalDateString(new Date(), organization.timezone);
// An open invoice takes the payment itself; the account takes it only when
// there is none (ADR 0014).
const paymentAccountTargets =
  openInvoices.length === 0 && !dwelling.archivedAt
    ? [{ id: dwellingId, number: dwelling.number }]
    : [];
const dwellingStatus = dwelling.archivedAt ? "ARCHIVED" : "ACTIVE";
const subtitle = [organization.addressLine1, entityLabel(dwelling.type, locale)]
  .filter(Boolean)
  .join(" · ");

const isCredit = accountBalance.startsWith("-");
const balanceForDisplay = isCredit ? accountBalance.slice(1) : accountBalance;
const balanceKpiTone =
  isCredit || accountBalance === "0.00" ? "success" : "warning";

const totals = accountActivity.reduce(
  (acc, entry) => ({
    debit: acc.debit + Number(entry.debit),
    credit: acc.credit + Number(entry.credit),
  }),
  { debit: 0, credit: 0 }
);

const deliveryMethods = [
  dwelling.invoiceByEmail && t("Email"),
  dwelling.invoiceByPaper && t("Paper"),
].filter(Boolean) as string[];

// Tabs and editors live in the URL (?tab=, ?edit=), so a reload keeps the tab
// and every Edit control is a plain link that also works without the script,
// which opens the editor in place instead.
const TABS = [
  "overview",
  "account-balance",
  "meters",
  "tariffs",
  "messages",
  "history",
] as const;
type Tab = (typeof TABS)[number];
const activeMeterIds = new Set(
  meterList.filter((meter) => !meter.archivedAt).map((meter) => meter.id)
);
// A Map, not an object literal: `?edit=toString` must not find an inherited
// property and hide every panel.
const EDITOR_TABS = new Map<string, Tab>([
  ["basic", "overview"],
  ["resident", "overview"],
  ["payment", "account-balance"],
  ["adjustment", "account-balance"],
  ["meter", "meters"],
]);
function editorTab(key: string | null): Tab | undefined {
  if (!key) return undefined;
  if (key.startsWith("meter-"))
    return activeMeterIds.has(key.slice(6)) ? "meters" : undefined;
  return EDITOR_TABS.get(key);
}
// A failed save comes back with its editor open and the error inside it.
const failedEditor = updateResult?.error
  ? "basic"
  : recordPaymentResult?.error
    ? "payment"
    : adjustmentResult?.error
      ? "adjustment"
      : assignResult?.error
        ? "resident"
        : meterCreateResult?.error
          ? "meter"
          : null;
const requestedEditor = Astro.url.searchParams.get("edit");
const openEditor =
  failedEditor ?? (editorTab(requestedEditor) ? requestedEditor : null);
const requestedTab = Astro.url.searchParams.get("tab");
const activeTab: Tab =
  editorTab(openEditor) ??
  (meterUpdateResult?.error || meterArchiveResult?.error
    ? "meters"
    : (TABS as readonly string[]).includes(requestedTab ?? "")
      ? (requestedTab as Tab)
      : "overview");
const tabHref = (tab: Tab) =>
  tab === "overview" ? Astro.url.pathname : `?tab=${tab}`;
const editHref = (key: string) => `?tab=${editorTab(key)}&edit=${key}`;
const isOpen = (key: string) => openEditor === key;

// English domain messages a client-side save can show, in this language.
// `<` is escaped so the JSON cannot close its script element.
const errorMapJson = JSON.stringify(
  errorTranslations(
    [
      dwellingsDomain,
      metersDomain,
      adjustmentsDomain,
      manualPaymentsDomain,
      directPaymentsDomain,
      guardsDomain,
      accountsActions,
      paymentsActions,
    ],
    locale,
    // Zod's message for the billing and resident email fields. Lengths are
    // capped by maxlength on the inputs, so their messages cannot occur.
    ["Invalid email address"]
  )
).replace(/</g, "\\u003c");

const recentMessages = conversationsWithMessages
  .flatMap((c) => c.messages)
  .sort((a, b) => b.createdAt.getTime() - a.createdAt.getTime())
  .slice(0, 4);

const activeMeterCount = meterList.filter((meter) => !meter.archivedAt).length;

// "METER_ARCHIVED" -> "Meter archived". Unknown codes still read as a
// sentence, and the translation table can supply the localized form.
function auditActionLabel(action: string): string {
  const words = action.toLowerCase().replaceAll("_", " ");
  return t(words.charAt(0).toUpperCase() + words.slice(1));
}
const AUDIT_VISIBLE = 6;

// The title is the label, or the type when there is no label. The caption
// adds the type only when a custom label hides it (two "Kitchen" meters),
// plus the serial number -- never the same words twice.
function meterCaption(
  label: string | null,
  typeName: string,
  serialNumber: string | null
): string {
  return [label && label !== typeName ? typeName : null, serialNumber]
    .filter(Boolean)
    .join(" · ");
}
---

<AdminLayout
  title={`${t("Dwelling")} ${dwelling.number} - ${organization.name}`}
  organizationId={organizationId}
  organizationName={organization.name}
  breadcrumbs={[
    { label: t("Dwellings"), href: `${base}/dwellings` },
    { label: `${t("Dwelling")} ${dwelling.number}` },
  ]}
>
  <div
    class="space-y-6"
    data-dwelling-detail
    data-discard-message={t("Discard unsaved changes?")}
  >
    <script
      type="application/json"
      id="dwelling-error-map"
      set:html={errorMapJson}
    />
    <header class="page-header">
      <div>
        <div class="dwelling-title-row">
          <h1 class="font-display">
            {t("Dwelling")} {dwelling.number}
          </h1>
          <StatusBadge status={dwellingStatus} />
        </div>
        {subtitle && <p class="page-description">{subtitle}</p>}
      </div>
      <div class="page-actions">
        <details class="more-menu" data-dismiss>
          <summary class="btn-secondary">
            <Icon name="dots" size="sm" />
            {t("More actions")}
          </summary>
          <div>
            {currentOpenPeriod ? (
              <a href={`${base}/periods/${currentOpenPeriod.id}`}>
                {t("View current period")}
              </a>
            ) : (
              <span class="menu-disabled">{t("No open period")}</span>
            )}
            {!dwelling.archivedAt && (
              <a
                href={editHref("adjustment")}
                data-editor-open="adjustment"
                aria-controls="editor-adjustment"
              >
                {t("Create adjustment")}
              </a>
            )}
            {!dwelling.archivedAt && (
              <button
                type="button"
                data-open-archive-dialog
                class="menu-danger"
              >
                {t("Archive dwelling")}
              </button>
            )}
          </div>
        </details>
      </div>
    </header>

    {archiveResult?.error && (
      <p class="notice notice-danger" role="alert">
        {friendlyActionErrorMessage(archiveResult.error, locale)}
      </p>
    )}

    <section class="dwelling-summary" aria-label={t("Summary")}>
      <div class="summary-stat" data-tone={balanceKpiTone}>
        <span class="summary-label">
          {isCredit ? t("Account credit") : t("Outstanding balance")}
        </span>
        <strong class="summary-value">
          {formatMoney(balanceForDisplay, organization.currency, locale)}
        </strong>
      </div>
      <div class="summary-stat" data-kpi="area">
        <span class="summary-label">{t("Area")}</span>
        <p class="summary-value">{dwelling.areaM2} m²</p>
      </div>
      <div class="summary-stat" data-kpi="resident-count">
        <span class="summary-label">{t("Resident count")}</span>
        <p class="summary-value">{dwelling.residentCount}</p>
      </div>
      <div class="summary-stat" data-kpi="invoice-delivery">
        <span class="summary-label">{t("Invoice delivery")}</span>
        <p class="summary-value summary-value-text">
          {deliveryMethods.length > 0 ? deliveryMethods.join(", ") : t("None")}
        </p>
      </div>
    </section>

    <nav class="dwelling-tabs" role="tablist" aria-label={t("Sections")}>
      {(
        [
          ["overview", t("Overview"), null],
          ["account-balance", t("Account balance"), null],
          ["meters", t("Meters"), activeMeterCount],
          ["tariffs", t("Recurring tariffs"), currentTariffs.length],
          ["messages", t("Messages"), null],
          ["history", t("History"), null],
        ] as const
      ).map(([tab, label, count]) => (
        <a
          href={tabHref(tab)}
          role="tab"
          id={`tab-${tab}`}
          data-tab={tab}
          aria-controls={`panel-${tab}`}
          aria-selected={activeTab === tab ? "true" : "false"}
        >
          {label}
          {count !== null && (
            <span
              class="tab-count"
              data-tab-count={tab === "meters" ? "meters" : undefined}
            >
              {count}
            </span>
          )}
        </a>
      ))}
    </nav>

    <!-- Overview: who the dwelling bills, how, and who can see it. -->
    <div
      class="tab-panel overview-grid"
      role="tabpanel"
      id="panel-overview"
      aria-labelledby="tab-overview"
      data-tabpanel="overview"
      hidden={activeTab !== "overview"}
    >
      <section
        id="basic-info"
        class="panel p-6"
        aria-labelledby="basic-info-title"
      >
        <div class="card-header">
          <h2 id="basic-info-title">{t("Basic information")}</h2>
          <a
            class="btn-secondary"
            href={editHref("basic")}
            data-editor-open="basic"
            aria-controls="editor-basic"
            hidden={isOpen("basic")}
          >
            <Icon name="pencil" size="sm" />
            {t("Edit")}
          </a>
        </div>
        <div
          id="editor-basic"
          class="inline-editor"
          data-editor="basic"
          hidden={!isOpen("basic")}
        >
          {updateResult?.error && (
            <p class="notice notice-danger" role="alert">
              {friendlyActionErrorMessage(updateResult.error, locale)}
            </p>
          )}
          <form
            method="POST"
            action={actions.dwellings.update}
            id="basic-info-form"
            class="editor-grid"
            data-saving-label={t("Saving…")}
            data-pending-label={t("Saving dwelling information…")}
            data-success-label={t("Changes saved")}
            data-error-label={t("Could not save dwelling information")}
            data-generic-error={t("Something went wrong. Please try again.")}
            data-reconcile-error={t("Saved, but the view could not be updated")}
          >
            <input type="hidden" name="organizationId" value={organizationId} />
            <input type="hidden" name="dwellingId" value={dwellingId} />
            <div>
              <label class="field-label" for="occupantName">
                {t("Occupant name")}
              </label>
              <input
                id="occupantName"
                name="occupantName"
                maxlength="200"
                value={dwelling.occupantName ?? ""}
                class="mt-1 w-full"
              />
            </div>
            <div>
              <label class="field-label" for="billingName">
                {t("Billing name")}
              </label>
              <input
                id="billingName"
                name="billingName"
                maxlength="200"
                value={dwelling.billingName ?? ""}
                class="mt-1 w-full"
              />
            </div>
            <div>
              <label class="field-label" for="billingEmail">
                {t("Billing email")}
              </label>
              <input
                id="billingEmail"
                name="billingEmail"
                maxlength="320"
                type="email"
                value={dwelling.billingEmail ?? ""}
                class="mt-1 w-full"
              />
            </div>
            <div>
              <label class="field-label" for="billingAddress">
                {t("Billing address")}
              </label>
              <input
                id="billingAddress"
                name="billingAddress"
                maxlength="300"
                value={dwelling.billingAddress ?? ""}
                class="mt-1 w-full"
              />
            </div>
            <div>
              <label class="field-label" for="areaM2">
                {t("Area (m²)")}
              </label>
              <input
                id="areaM2"
                name="areaM2"
                type="number"
                step="0.01"
                min="0"
                value={dwelling.areaM2}
                class="mt-1 w-full"
              />
            </div>
            <div>
              <label class="field-label" for="residentCount">
                {t("Resident count")}
              </label>
              <input
                id="residentCount"
                name="residentCount"
                type="number"
                min="0"
                value={dwelling.residentCount}
                class="mt-1 w-full"
              />
            </div>
            <div>
              <label class="field-label" for="dwelling-type">
                {t("Type")}
              </label>
              <select id="dwelling-type" name="type" class="mt-1 w-full">
                {dwellingTypeOptions.map((dt) => (
                  <option value={dt} selected={dwelling.type === dt}>
                    {entityLabel(dt, locale)}
                  </option>
                ))}
              </select>
            </div>
            <div class="editor-wide">
              <label class="field-label" for="notes">
                {t("Notes")}
              </label>
              <textarea
                id="notes"
                name="notes"
                maxlength="2000"
                rows="3"
                class="mt-1 w-full"
              >{dwelling.notes ?? ""}</textarea>
            </div>
            <div class="editor-actions">
              <button type="submit" class="btn-primary">
                {t("Save")}
              </button>
              <a
                class="btn-secondary"
                href={tabHref("overview")}
                data-editor-cancel
              >
                {t("Cancel")}
              </a>
            </div>
          </form>
        </div>
        <dl
          class="detail-list"
          data-editor-view="basic"
          hidden={isOpen("basic")}
        >
          <div>
            <dt>{t("Occupant name")}</dt>
            <dd data-field="occupantName">{dwelling.occupantName ?? "—"}</dd>
          </div>
          <div>
            <dt>{t("Billing name")}</dt>
            <dd data-field="billingName">{dwelling.billingName ?? "—"}</dd>
          </div>
          <div>
            <dt>{t("Billing email")}</dt>
            <dd data-field="billingEmail">{dwelling.billingEmail ?? "—"}</dd>
          </div>
          <div>
            <dt>{t("Billing address")}</dt>
            <dd data-field="billingAddress">
              {dwelling.billingAddress ?? "—"}
            </dd>
          </div>
          <div>
            <dt>{t("Area (m²)")}</dt>
            <dd data-field="areaM2">{dwelling.areaM2}</dd>
          </div>
          <div>
            <dt>{t("Resident count")}</dt>
            <dd data-field="residentCount">{dwelling.residentCount}</dd>
          </div>
          <div>
            <dt>{t("Type")}</dt>
            <dd data-field="type">{entityLabel(dwelling.type, locale)}</dd>
          </div>
          <div class="detail-wide">
            <dt>{t("Notes")}</dt>
            <dd data-field="notes">{dwelling.notes ?? "—"}</dd>
          </div>
          <div>
            <dt>{t("Created")}</dt>
            <dd>
              {formatDate(dwelling.createdAt, locale, organization.timezone)}
            </dd>
          </div>
          <div>
            <dt>{t("Last updated")}</dt>
            <dd data-field="updatedAt">
              {formatDate(dwelling.updatedAt, locale, organization.timezone)}
            </dd>
          </div>
        </dl>
      </section>

      <div class="overview-side">
        <section
          id="invoice-delivery"
          class="panel p-6"
          aria-labelledby="invoice-delivery-title"
        >
          <h2 id="invoice-delivery-title">{t("Invoice delivery")}</h2>
          {deliveryResult?.error && (
            <p class="notice notice-danger mt-3" role="alert">
              {friendlyActionErrorMessage(deliveryResult.error, locale)}
            </p>
          )}
          <form
            method="POST"
            action={actions.dwellings.updateInvoiceDelivery}
            class="delivery-form"
            data-delivery-form
            data-saving-label={t("Saving…")}
            data-pending-label={t("Saving delivery preferences…")}
            data-success-label={t("Delivery preferences saved")}
            data-error-label={t("Could not save delivery preferences")}
            data-generic-error={t("Something went wrong. Please try again.")}
            data-reconcile-error={t("Saved, but the view could not be updated")}
            data-email-label={t("Email")}
            data-paper-label={t("Paper")}
            data-none-label={t("None")}
            data-send-to-label={t("Send invoices to")}
            data-no-email-label={t("No billing email on file")}
          >
            <input type="hidden" name="organizationId" value={organizationId} />
            <input type="hidden" name="dwellingId" value={dwellingId} />
            <ul class="delivery-list">
              <li>
                <label class="delivery-option">
                  <span class="check-toggle">
                    <input
                      type="checkbox"
                      name="invoiceByEmail"
                      checked={dwelling.invoiceByEmail}
                    />
                    <span class="check-icon" aria-hidden="true">
                      <Icon name="check" size="sm" />
                    </span>
                  </span>
                  <span class="delivery-option-text">
                    <strong>{t("Email")}</strong>
                    <span data-email-destination>
                      {dwelling.billingEmail
                        ? `${t("Send invoices to")} ${dwelling.billingEmail}`
                        : t("No billing email on file")}
                    </span>
                  </span>
                </label>
              </li>
              <li>
