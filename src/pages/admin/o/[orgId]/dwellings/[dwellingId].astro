    <!-- Account balance -->
    <div
      class="tab-panel"
      role="tabpanel"
      id="panel-account-balance"
      aria-labelledby="tab-account-balance"
      data-tabpanel="account-balance"
      hidden={activeTab !== "account-balance"}
    >
      <section
        id="account-balance"
        class="panel p-6"
        aria-labelledby="account-balance-title"
      >
        <div class="card-header">
          <h2 id="account-balance-title">{t("Account balance")}</h2>
          <div class="card-actions">
            <a
              class="btn-secondary"
              href={`${base}/payments/ledger?dwelling=${dwellingId}`}
            >
              {t("Full statement")}
            </a>
            {!dwelling.archivedAt && (
              <a
                class="btn-secondary"
                href={editHref("payment")}
                data-editor-open="payment"
                aria-controls="editor-payment"
                hidden={isOpen("payment")}
              >
                <Icon name="plus" size="sm" />
                {t("Record a payment")}
              </a>
            )}
            {!dwelling.archivedAt && (
              <a
                class="btn-secondary"
                href={editHref("adjustment")}
                data-editor-open="adjustment"
                aria-controls="editor-adjustment"
                hidden={isOpen("adjustment")}
              >
                <Icon name="plus" size="sm" />
                {t("Add adjustment")}
              </a>
            )}
          </div>
        </div>
        {recordPaymentResult?.data && (
          <p class="notice mt-3" role="status">
            {t("Payment recorded.")}
          </p>
        )}
        {adjustmentResult?.data && (
          <p class="notice mt-3" role="status">
            {t("Adjustment added.")}
          </p>
        )}
        <div
          id="editor-payment"
          class="inline-editor"
          data-editor="payment"
          hidden={!isOpen("payment")}
          data-saving-label={t("Saving…")}
          data-pending-label={t("Recording payment…")}
          data-success-label={t("Payment recorded.")}
          data-error-label={t("Could not record the payment")}
          data-generic-error={t("Something went wrong. Please try again.")}
          data-reconcile-error={t("Saved, but the view could not be updated")}
        >
          {recordPaymentResult?.error && (
            <p class="notice notice-danger" role="alert">
              {friendlyActionErrorMessage(recordPaymentResult.error, locale)}
            </p>
          )}
          <ManualPaymentForm
            organizationId={organizationId}
            invoices={openInvoices}
            dwellings={paymentAccountTargets}
            today={todayInOrg}
            error={recordPaymentResult?.error}
            idPrefix="dwelling-payment"
            currency={organization.currency}
          />
          <a
            class="btn-secondary editor-cancel-below"
            href={tabHref("account-balance")}
            data-editor-cancel
          >
            {t("Cancel")}
          </a>
        </div>
        <div
          id="editor-adjustment"
          class="inline-editor"
          data-editor="adjustment"
          hidden={!isOpen("adjustment")}
        >
          {adjustmentResult?.error && (
            <p class="notice notice-danger" role="alert">
              {friendlyActionErrorMessage(adjustmentResult.error, locale)}
            </p>
          )}
          <form
            method="POST"
            action={actions.accounts.createAdjustment}
            id="adjustment-form"
            class="editor-grid"
            data-currency={organization.currency}
            data-saving-label={t("Saving…")}
            data-pending-label={t("Adding adjustment…")}
            data-success-label={t("Adjustment added.")}
            data-error-label={t("Could not add the adjustment")}
            data-unknown-outcome={t(
              "It is not certain the adjustment was saved. Reload the page and check the account entries before adding it again."
            )}
            data-generic-error={t("Something went wrong. Please try again.")}
            data-reconcile-error={t("Saved, but the view could not be updated")}
          >
            <input type="hidden" name="organizationId" value={organizationId} />
            <input type="hidden" name="dwellingId" value={dwellingId} />
            <input
              type="hidden"
              name="currency"
              value={organization.currency}
            />
            <div>
              <label class="field-label" for="adjustment-direction">
                {t("Type")}
              </label>
              <select
                id="adjustment-direction"
                name="direction"
                class="mt-1 w-full"
              >
                <option value="CHARGE">{t("Charge adjustment")}</option>
                <option value="CREDIT">{t("Credit adjustment")}</option>
              </select>
            </div>
            <div>
              <label class="field-label" for="adjustment-amount">
                {t("Amount")}
              </label>
              <input
                id="adjustment-amount"
                name="amount"
                inputmode="decimal"
                required
                class="mt-1 w-full"
              />
            </div>
            <div>
              <label class="field-label" for="adjustment-date">
                {t("Date")}
              </label>
              <input
                id="adjustment-date"
                name="effectiveDate"
                type="date"
                required
                value={todayInOrg}
                class="mt-1 w-full"
              />
            </div>
            <div>
              <label class="field-label" for="adjustment-reason">
                {t("Reason")}
              </label>
              <input
                id="adjustment-reason"
                name="reason"
                required
                maxlength="200"
                class="mt-1 w-full"
              />
            </div>
            <div class="editor-wide">
              <label class="field-label" for="adjustment-note">
                {t("Note")}
              </label>
              <textarea
                id="adjustment-note"
                name="note"
                rows="2"
                maxlength="1000"
                class="mt-1 w-full"
              ></textarea>
            </div>
            <div class="editor-actions">
              <button
                class="btn-primary"
                type="submit"
                data-confirm={t(
                  "Add this adjustment? The balance changes right away."
                )}
                data-confirm-template={t(
                  "{direction}: {amount}. Add it? The balance changes right away."
                )}
              >
                {t("Add adjustment")}
              </button>
              <a
                class="btn-secondary"
                href={tabHref("account-balance")}
                data-editor-cancel
              >
                {t("Cancel")}
              </a>
            </div>
          </form>
        </div>
        <dl class="balance-summary">
          <div>
            <dt>{t("Total debits")}</dt>
            <dd>
              {formatMoney(String(totals.debit), organization.currency, locale)}
            </dd>
          </div>
          <div>
            <dt>{t("Total credits")}</dt>
            <dd>
              {formatMoney(
                String(totals.credit),
                organization.currency,
                locale
              )}
            </dd>
          </div>
        </dl>
        {accountActivity.length > 0 ? (
          <div
            class="table-wrap mt-4"
            role="region"
            aria-label={t("Account activity")}
            tabindex="0"
          >
            <table class="ledger-table">
              <caption class="sr-only">{t("Account activity")}</caption>
              <thead>
                <tr>
                  <th scope="col">{t("Date")}</th>
                  <th scope="col">{t("Description")}</th>
                  <th scope="col" class="text-right">
                    {t("Debit")}
                  </th>
                  <th scope="col" class="text-right">
                    {t("Credit")}
                  </th>
                  <th scope="col" class="text-right">
                    {t("Balance")}
                  </th>
                </tr>
              </thead>
              <tbody>
                {accountActivity
                  .slice(-10)
                  .reverse()
                  .map((entry) => (
                    <tr>
                      <td class="ledger-date">
                        {formatDate(entry.effectiveDate, locale)}
                      </td>
                      <td class="ledger-description">
                        {ledgerDescriptionText(entry.description, locale)}
                      </td>
                      <td class="text-right" data-label={t("Debit")}>
                        {entry.debit === "0.00"
                          ? "—"
                          : formatMoney(
                              entry.debit,
                              organization.currency,
                              locale
                            )}
                      </td>
                      <td class="text-right" data-label={t("Credit")}>
                        {entry.credit === "0.00"
                          ? "—"
                          : formatMoney(
                              entry.credit,
                              organization.currency,
                              locale
                            )}
                      </td>
                      <td class="text-right" data-label={t("Balance")}>
                        {formatMoney(
                          entry.balance,
                          organization.currency,
                          locale
                        )}
                      </td>
                    </tr>
                  ))}
              </tbody>
            </table>
          </div>
        ) : (
          <EmptyState class="mt-4" title={t("No account entries yet")} />
        )}
      </section>
    </div>

    <!-- Meters -->
