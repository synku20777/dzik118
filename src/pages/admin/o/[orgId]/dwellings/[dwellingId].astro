---
// Phase D (Organizations/dwellings) - dwelling detail (spec Section 9.2, 27
// "Dwellings: Detail").
import StatusBadge from "../../../../../components/ui/StatusBadge.astro";
import KpiCard from "../../../../../components/ui/KpiCard.astro";
import Icon from "../../../../../components/ui/Icon.astro";
import EmptyState from "../../../../../components/ui/EmptyState.astro";
import {
  translate,
  uiLocale,
  entityLabel,
  formatDate,
  formatMoney,
} from "../../../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import { actions } from "astro:actions";
import {
  ForbiddenError,
  requireOrganizationAccess,
} from "../../../../../domain/authorization/guards";
import { getOrganization } from "../../../../../domain/organizations/organizations";
import {
  getDwelling,
  listDwellingResidents,
} from "../../../../../domain/organizations/dwellings";
import { listMeters } from "../../../../../domain/organizations/meters";
import { withRequestDb } from "../../../../../lib/db-request";
import {
  getDwellingAccountBalance,
  listDwellingAccountActivity,
} from "../../../../../domain/accounts/ledger";
import { listCasesForDwelling } from "../../../../../domain/periods/cases";
import { getCurrentOpenPeriod } from "../../../../../domain/periods/periods";
import { listAuditLogs } from "../../../../../domain/audit/audit-log";
import { listConversationsWithMessagesForDwelling } from "../../../../../domain/messaging/conversations";

const organizationId = Astro.params.orgId!;
const dwellingId = Astro.params.dwellingId!;
try {
  requireOrganizationAccess(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const updateResult = Astro.getActionResult(actions.dwellings.update);
const additionalInfoResult = updateResult; // shares the same action/form shape
const deliveryResult = Astro.getActionResult(
  actions.dwellings.updateInvoiceDelivery
);
const assignResult = Astro.getActionResult(actions.dwellings.assignResident);
const removeResult = Astro.getActionResult(actions.dwellings.removeResident);
const meterResult =
  Astro.getActionResult(actions.meters.create) ??
  Astro.getActionResult(actions.meters.archive);
const adjustmentResult = Astro.getActionResult(
  actions.accounts.createAdjustment
);
const archiveResult = Astro.getActionResult(actions.dwellings.archive);

let organization,
  dwelling,
  residents,
  meterList,
  accountBalance,
  accountActivity,
  caseHistory,
  currentOpenPeriod,
  auditEntries,
  conversationsWithMessages;
try {
  ({
    organization,
    dwelling,
    residents,
    meterList,
    accountBalance,
    accountActivity,
    caseHistory,
    currentOpenPeriod,
    auditEntries,
    conversationsWithMessages,
  } = await withRequestDb(async (db) => {
    const organization = await getOrganization(db, organizationId);
    return {
      organization,
      dwelling: await getDwelling(db, organizationId, dwellingId),
      residents: await listDwellingResidents(db, dwellingId),
      meterList: await listMeters(db, organizationId, dwellingId),
      accountBalance: await getDwellingAccountBalance(
        db,
        organizationId,
        dwellingId,
        organization.currency
      ),
      accountActivity: await listDwellingAccountActivity(
        db,
        organizationId,
        dwellingId,
        organization.currency
      ),
      caseHistory: await listCasesForDwelling(db, organizationId, dwellingId),
      currentOpenPeriod: await getCurrentOpenPeriod(db, organizationId),
      auditEntries: await listAuditLogs(db, organizationId, {
        entityType: "dwelling",
        entityId: dwellingId,
        limit: 20,
      }),
      conversationsWithMessages: await listConversationsWithMessagesForDwelling(
        db,
        dwellingId
      ),
    };
  }));
} catch {
  return Astro.redirect(`/admin/o/${organizationId}/dwellings`);
}

const dwellingTypeOptions = [
  "APARTMENT",
  "COMMERCIAL_UNIT",
  "PARKING",
  "STORAGE",
  "OTHER",
] as const;
const meterTypeOptions = [
  "COLD_WATER",
  "HOT_WATER",
  "ELECTRICITY",
  "GAS",
  "HEAT",
  "OTHER",
] as const;

const base = `/admin/o/${organizationId}`;
const dwellingStatus = dwelling.archivedAt ? "ARCHIVED" : "ACTIVE";
const subtitle = [organization.addressLine1, entityLabel(dwelling.type, locale)]
  .filter(Boolean)
  .join(" · ");

const isCredit = accountBalance.startsWith("-");
const balanceForDisplay = isCredit ? accountBalance.slice(1) : accountBalance;
const balanceKpiTone =
  isCredit || accountBalance === "0.00" ? "success" : "warning";

const totals = accountActivity.reduce(
  (acc, entry) => ({
    debit: acc.debit + Number(entry.debit),
    credit: acc.credit + Number(entry.credit),
  }),
  { debit: 0, credit: 0 }
);

const deliveryMethods = [
  dwelling.invoiceByEmail && t("Email"),
  dwelling.invoiceByPaper && t("Paper"),
].filter(Boolean) as string[];

const recentMessages = conversationsWithMessages
  .flatMap((c) => c.messages)
  .sort((a, b) => b.createdAt.getTime() - a.createdAt.getTime())
  .slice(0, 4);

const meterTypeIcons: Record<string, string> = {
  COLD_WATER: "💧",
  HOT_WATER: "🔥",
  ELECTRICITY: "⚡",
  GAS: "🔥",
  HEAT: "🌡️",
  OTHER: "⚙️",
};
---

<AdminLayout
  title={`Dwelling ${dwelling.number} - ${organization.name}`}
  organizationId={organizationId}
  organizationName={organization.name}
>
  <div class="space-y-6">
    <a href={`${base}/dwellings`} class="back-link">
      <span aria-hidden="true">←</span>
      {t("Dwellings")}
    </a>

    <header class="page-header">
      <div>
        <div class="dwelling-title-row">
          <h1 class="font-display">{t("Dwelling")} {dwelling.number}</h1>
          <StatusBadge status={dwellingStatus} />
        </div>
        {subtitle && <p class="page-description">{subtitle}</p>}
      </div>
      <div class="page-actions">
        <details class="more-menu">
          <summary class="btn-secondary">
            <span aria-hidden="true">⋮</span>
            {t("More actions")}
          </summary>
          <div>
            {
              currentOpenPeriod ? (
                <a href={`${base}/periods/${currentOpenPeriod.id}`}>
                  {t("View current period")} →
                </a>
              ) : (
                <span class="menu-disabled">{t("No open period")}</span>
              )
            }
            <button type="button" data-goto-panel="account-balance">
              {t("Create adjustment")} →
            </button>
            {
              !dwelling.archivedAt && (
                <button
                  type="button"
                  data-open-archive-dialog
                  class="menu-danger"
                >
                  {t("Archive dwelling")} →
                </button>
              )
            }
          </div>
        </details>
      </div>
    </header>

    {
      archiveResult?.error && (
        <p class="notice notice-danger" role="alert">
          {archiveResult.error.message}
        </p>
      )
    }

    <div class="stat-grid">
      <KpiCard label={t("Area")} value={`${dwelling.areaM2} m²`} />
      <KpiCard label={t("Resident count")} value={dwelling.residentCount} />
      <KpiCard
        label={isCredit ? t("Account credit") : t("Outstanding balance")}
        value={formatMoney(balanceForDisplay, organization.currency, locale)}
        tone={balanceKpiTone}
      />
      <KpiCard
        label={t("Invoice delivery")}
        value={deliveryMethods.length > 0
          ? deliveryMethods.join(", ")
          : t("None")}
      />
    </div>

    <div class="dwelling-tabs" role="tablist" aria-label={t("Sections")}>
      <button
        type="button"
        role="tab"
        data-filter="overview"
        aria-selected="true"
      >
        {t("Overview")}
      </button>
      <button
        type="button"
        role="tab"
        data-filter="account-balance"
        aria-selected="false"
      >
        {t("Account balance")}
      </button>
      <button
        type="button"
        role="tab"
        data-filter="meters"
        aria-selected="false"
      >
        {t("Meters")}
      </button>
      <button
        type="button"
        role="tab"
        data-filter="residents"
        aria-selected="false"
      >
        {t("Residents")}
      </button>
      <button
        type="button"
        role="tab"
        data-filter="messages"
        aria-selected="false"
      >
        {t("Messages")}
      </button>
      <button
        type="button"
        role="tab"
        data-filter="history"
        aria-selected="false"
      >
        {t("History")}
      </button>
    </div>

    <div class="dwelling-grid" data-panel-group>
      <div class="dwelling-main">
        <section class="panel p-6" data-panel="overview">
          <div class="card-header">
            <div>
              <h2>{t("Basic information")}</h2>
              <p class="text-body-sm text-muted">
                {t("Core information about this dwelling.")}
              </p>
            </div>
            <details class="edit-disclosure" open={!!updateResult?.error}>
              <summary class="btn-secondary">
                <Icon name="pencil" size="sm" />
                {t("Edit")}
              </summary>
              <div class="edit-disclosure-panel">
                {
                  updateResult?.error && (
                    <p class="notice notice-danger" role="alert">
                      {updateResult.error.message}
                    </p>
                  )
                }
                <form
                  method="POST"
                  action={actions.dwellings.update}
                  class="mt-4 grid grid-cols-2 gap-3"
                >
                  <input
                    type="hidden"
                    name="organizationId"
                    value={organizationId}
                  />
                  <input type="hidden" name="dwellingId" value={dwellingId} />
                  <div class="col-span-2">
                    <label class="block text-label" for="billingName"
                      >{t("Billing name")}</label
                    >
                    <input
                      id="billingName"
                      name="billingName"
                      value={dwelling.billingName ?? ""}
                      class="mt-1 w-full rounded-control border border-border px-3 py-2 text-body-sm"
                    />
                  </div>
                  <div>
                    <label
                      class="block text-label text-foreground"
                      for="occupantName">{t("Occupant name")}</label
                    >
                    <input
                      id="occupantName"
                      name="occupantName"
                      value={dwelling.occupantName ?? ""}
                      class="mt-1 w-full rounded-control border border-border px-3 py-2 text-body-sm"
                    />
                  </div>
                  <div>
                    <label
                      class="block text-label text-foreground"
                      for="areaM2">{t("Area (m²)")}</label
                    >
                    <input
                      id="areaM2"
                      name="areaM2"
                      type="number"
                      step="0.01"
                      min="0"
                      value={dwelling.areaM2}
                      class="mt-1 w-full rounded-control border border-border px-3 py-2 text-body-sm"
                    />
                  </div>
                  <div>
                    <label
                      class="block text-label text-foreground"
                      for="residentCount">{t("Resident count")}</label
                    >
                    <input
                      id="residentCount"
                      name="residentCount"
                      type="number"
                      min="0"
                      value={dwelling.residentCount}
                      class="mt-1 w-full rounded-control border border-border px-3 py-2 text-body-sm"
                    />
                  </div>
                  <div>
                    <label
                      class="block text-label text-foreground"
                      for="billingEmail">{t("Billing email")}</label
                    >
                    <input
                      id="billingEmail"
                      name="billingEmail"
                      type="email"
                      value={dwelling.billingEmail ?? ""}
                      class="mt-1 w-full rounded-control border border-border px-3 py-2 text-body-sm"
                    />
                  </div>
                  <div class="col-span-2">
                    <label
                      class="block text-label text-foreground"
                      for="billingAddress">{t("Billing address")}</label
                    >
                    <input
                      id="billingAddress"
                      name="billingAddress"
                      value={dwelling.billingAddress ?? ""}
                      class="mt-1 w-full rounded-control border border-border px-3 py-2 text-body-sm"
                    />
                  </div>
                  <div class="col-span-2 flex gap-2">
                    <button type="submit" class="btn-primary">
                      {t("Save")}
                    </button>
                  </div>
                </form>
              </div>
            </details>
          </div>
          <dl class="detail-list">
            <div>
              <dt>{t("Occupant name")}</dt>
              <dd>{dwelling.occupantName ?? "—"}</dd>
            </div>
            <div>
              <dt>{t("Billing name")}</dt>
              <dd>{dwelling.billingName ?? "—"}</dd>
            </div>
            <div>
              <dt>{t("Billing email")}</dt>
              <dd>{dwelling.billingEmail ?? "—"}</dd>
            </div>
            <div>
              <dt>{t("Billing address")}</dt>
              <dd>{dwelling.billingAddress ?? "—"}</dd>
            </div>
            <div>
              <dt>{t("Area (m²)")}</dt>
              <dd>{dwelling.areaM2}</dd>
            </div>
            <div>
              <dt>{t("Resident count")}</dt>
              <dd>{dwelling.residentCount}</dd>
            </div>
          </dl>
        </section>

        <section
          id="account-balance"
          class="panel p-6"
          data-panel="account-balance"
        >
          <div class="card-header">
            <div>
              <h2>{t("Account balance")}</h2>
              <p class="text-body-sm text-muted">
                {t("All adjustments and balance history.")}
              </p>
            </div>
            <details class="edit-disclosure" open={!!adjustmentResult?.error}>
              <summary class="btn-secondary">
                <Icon name="plus" size="sm" />
                {t("Add adjustment")}
              </summary>
              <div class="edit-disclosure-panel">
                {
                  adjustmentResult?.error && (
                    <p class="notice notice-danger" role="alert">
                      {adjustmentResult.error.message}
                    </p>
                  )
                }
                <form
                  method="POST"
                  action={actions.accounts.createAdjustment}
                  class="mt-4 grid grid-cols-2 gap-3"
                >
                  <input
                    type="hidden"
                    name="organizationId"
                    value={organizationId}
                  />
                  <input type="hidden" name="dwellingId" value={dwellingId} />
                  <input
                    type="hidden"
                    name="currency"
                    value={organization.currency}
                  />
                  <div>
                    <label class="block text-label" for="adjustment-direction"
                      >{t("Type")}</label
                    >
                    <select
                      id="adjustment-direction"
                      name="direction"
                      class="mt-1 w-full"
                    >
                      <option value="CHARGE">{t("Charge adjustment")}</option>
                      <option value="CREDIT">{t("Credit adjustment")}</option>
                    </select>
                  </div>
                  <div>
                    <label class="block text-label" for="adjustment-amount"
                      >{t("Amount")}</label
                    >
                    <input
                      id="adjustment-amount"
                      name="amount"
                      inputmode="decimal"
                      required
                      class="mt-1 w-full"
                    />
                  </div>
                  <div>
                    <label class="block text-label" for="adjustment-date"
                      >{t("Date")}</label
                    >
                    <input
                      id="adjustment-date"
                      name="effectiveDate"
                      type="date"
                      required
                      class="mt-1 w-full"
                    />
                  </div>
                  <div>
                    <label class="block text-label" for="adjustment-reason"
                      >{t("Reason")}</label
                    >
                    <input
                      id="adjustment-reason"
                      name="reason"
                      required
                      class="mt-1 w-full"
                    />
                  </div>
                  <div class="col-span-2">
                    <label class="block text-label" for="adjustment-note"
                      >{t("Note")}</label
                    >
                    <textarea
                      id="adjustment-note"
                      name="note"
                      class="mt-1 w-full"></textarea>
                  </div>
                  <div class="col-span-2">
                    <button class="btn-secondary" type="submit"
                      >{t("Add adjustment")}</button
                    >
                  </div>
                </form>
              </div>
            </details>
          </div>
          <div class="balance-summary">
            <div class="balance-highlight" data-tone={balanceKpiTone}>
              <span>
                {isCredit ? t("Account credit") : t("Outstanding balance")}
              </span>
              <strong>
                {formatMoney(balanceForDisplay, organization.currency, locale)}
              </strong>
            </div>
            <div>
              <span>{t("Total debits")}</span>
              <strong>
                {
                  formatMoney(
                    String(totals.debit),
                    organization.currency,
                    locale
                  )
                }
              </strong>
            </div>
            <div>
              <span>{t("Total credits")}</span>
              <strong>
                {
                  formatMoney(
                    String(totals.credit),
                    organization.currency,
                    locale
                  )
                }
              </strong>
            </div>
          </div>
          {
            accountActivity.length > 0 ? (
              <div
                class="table-wrap mt-4"
                role="region"
                aria-label={t("Account activity")}
                tabindex="0"
              >
                <table class="w-full text-body-sm">
                  <thead>
                    <tr>
                      <th>{t("Date")}</th>
                      <th>{t("Description")}</th>
                      <th class="text-right">{t("Debit")}</th>
                      <th class="text-right">{t("Credit")}</th>
                      <th class="text-right">{t("Balance")}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {accountActivity
                      .slice(-10)
                      .reverse()
                      .map((entry) => (
                        <tr>
                          <td>{formatDate(entry.effectiveDate, locale)}</td>
                          <td>{entry.description ?? entry.type}</td>
                          <td class="text-right">
                            {entry.debit === "0.00"
                              ? "—"
                              : formatMoney(
                                  entry.debit,
                                  organization.currency,
                                  locale
                                )}
                          </td>
                          <td class="text-right">
                            {entry.credit === "0.00"
                              ? "—"
                              : formatMoney(
                                  entry.credit,
                                  organization.currency,
                                  locale
                                )}
                          </td>
                          <td class="text-right">
                            {formatMoney(
                              entry.balance,
                              organization.currency,
                              locale
                            )}
                          </td>
                        </tr>
                      ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <EmptyState
                class="mt-4"
                title={t("No account entries yet")}
                description={t("Adjustments will appear here.")}
              />
            )
          }
        </section>

        <section id="messages" class="panel p-6" data-panel="messages">
          <div class="card-header">
            <div>
              <h2>{t("Recent messages")}</h2>
              <p class="text-body-sm text-muted">
                {t("Latest messages with this dwelling.")}
              </p>
            </div>
            <a
              class="btn-secondary"
              href={`${base}/messages?dwellingId=${dwellingId}`}
            >
              {t("View all")}
            </a>
          </div>
          {
            recentMessages.length > 0 ? (
              <ul class="message-preview-list">
                {recentMessages.map((m) => (
                  <li>
                    <p>{m.body}</p>
                    <span>
                      {formatDate(m.createdAt, locale, organization.timezone)}
                    </span>
                  </li>
                ))}
              </ul>
            ) : (
              <EmptyState
                class="mt-5"
                title={t("No messages yet")}
                description={t(
                  "Conversations with residents will appear here."
                )}
              />
            )
          }
        </section>
      </div>

      <div class="dwelling-sidebar">
        <section class="panel p-6" data-panel="overview">
          <div class="card-header">
            <div>
              <h2>{t("Invoice delivery")}</h2>
              <p class="text-body-sm text-muted">
                {t("How this dwelling receives its invoices.")}
              </p>
            </div>
          </div>
          {
            deliveryResult?.error && (
              <p class="notice notice-danger" role="alert">
                {deliveryResult.error.message}
              </p>
            )
          }
          <form
            method="POST"
            action={actions.dwellings.updateInvoiceDelivery}
            class="delivery-form"
            data-delivery-form
          >
            <input type="hidden" name="organizationId" value={organizationId} />
            <input type="hidden" name="dwellingId" value={dwellingId} />
            <ul class="delivery-list">
              <li>
                <label class="delivery-option">
                  <span class="check-toggle">
                    <input
                      type="checkbox"
                      name="invoiceByEmail"
                      checked={dwelling.invoiceByEmail}
                    />
                    <span class="check-icon" aria-hidden="true">
                      <Icon name="check" size="sm" />
                    </span>
                  </span>
                  <span class="delivery-option-text">
                    <strong>{t("Email")}</strong>
                    <p>
                      {
                        dwelling.billingEmail
                          ? `${t("Send invoices to")} ${dwelling.billingEmail}`
                          : t("No billing email on file")
                      }
                    </p>
                  </span>
                </label>
              </li>
              <li>
                <label class="delivery-option">
                  <span class="check-toggle">
                    <input
                      type="checkbox"
                      name="invoiceByPaper"
                      checked={dwelling.invoiceByPaper}
                    />
                    <span class="check-icon" aria-hidden="true">
                      <Icon name="check" size="sm" />
                    </span>
                  </span>
                  <span class="delivery-option-text">
                    <strong>{t("Paper")}</strong>
                    <p>{t("Send a printed copy by mail")}</p>
                  </span>
                </label>
              </li>
            </ul>
            <div class="pt-2">
              <button
                type="submit"
                class="btn-primary"
                disabled={!deliveryResult?.error}
                data-delivery-save
              >
                {t("Save")}
              </button>
            </div>
          </form>
        </section>

        <section id="residents" class="panel p-6" data-panel="residents">
          <div class="card-header">
            <div>
              <h2>{t("Resident access")}</h2>
              <p class="text-body-sm text-muted">
                {t("People who can access their invoices and messages.")}
              </p>
            </div>
            <details
              class="edit-disclosure"
              open={!!assignResult?.error || !!removeResult?.error}
            >
              <summary class="btn-secondary">
                <Icon name="plus" size="sm" />
                {t("Add resident")}
              </summary>
              <div class="edit-disclosure-panel">
                {
                  (assignResult?.error || removeResult?.error) && (
                    <p class="notice notice-danger" role="alert">
                      {assignResult?.error?.message ??
                        removeResult?.error?.message}
                    </p>
                  )
                }
                <form
                  method="POST"
                  action={actions.dwellings.assignResident}
                  class="mt-4 flex gap-2"
                >
                  <input
                    type="hidden"
                    name="organizationId"
                    value={organizationId}
                  />
                  <input type="hidden" name="dwellingId" value={dwellingId} />
                  <input
                    aria-label={t("Email")}
                    name="email"
                    type="email"
                    required
                    placeholder="resident@example.com"
                    class="flex-1 rounded-control border border-border px-3 py-2 text-body-sm"
                  />
                  <button type="submit" class="btn-primary">
                    {t("Assign")}
                  </button>
                </form>
              </div>
            </details>
          </div>
          {
            residents.length > 0 ? (
              <ul class="sidebar-item-list">
                {residents.map((r) => (
                  <li>
                    <div class="sidebar-item-avatar" aria-hidden="true">
                      {(r.displayName ?? r.email).charAt(0).toUpperCase()}
                    </div>
                    <div class="sidebar-item-body">
                      <strong>{r.displayName ?? r.email}</strong>
                      <p>{r.email}</p>
                    </div>
                    <form
                      method="POST"
                      action={actions.dwellings.removeResident}
                    >
                      <input
                        type="hidden"
                        name="organizationId"
                        value={organizationId}
                      />
                      <input
                        type="hidden"
                        name="dwellingId"
                        value={dwellingId}
                      />
                      <input type="hidden" name="userId" value={r.userId} />
                      <button type="submit" class="sidebar-item-remove">
                        {t("Remove")}
                      </button>
                    </form>
                  </li>
                ))}
