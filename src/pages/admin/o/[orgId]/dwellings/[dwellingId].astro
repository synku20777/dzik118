<script>
  const archiveDialog =
    document.querySelector<HTMLDialogElement>("#archive-dialog");
  document
    .querySelector<HTMLButtonElement>("[data-open-archive-dialog]")
    ?.addEventListener("click", () => {
      document.querySelector(".more-menu")?.removeAttribute("open");
      archiveDialog?.showModal();
    });
  archiveDialog?.addEventListener("click", (event) => {
    if (event.target === archiveDialog) archiveDialog.close();
  });

  // Tabs filter which panels are visible -- "overview" (the default) shows
  // every panel; any other tab shows only the one panel that declares a
  // matching data-panel, hiding the rest (including panels like "Basic
  // information"/"Invoice delivery" that only ever appear under Overview,
  // since they have no tab of their own).
  const tabs = [
    ...document.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
  ];
  const panels = [...document.querySelectorAll<HTMLElement>("[data-panel]")];
  const panelGroup = document.querySelector<HTMLElement>("[data-panel-group]");

  function setFilter(filter: string) {
    for (const panel of panels) {
      panel.hidden = filter !== "overview" && panel.dataset.panel !== filter;
    }
    for (const tab of tabs) {
      tab.setAttribute(
        "aria-selected",
        tab.dataset.filter === filter ? "true" : "false"
      );
    }
    panelGroup?.classList.toggle("is-filtered", filter !== "overview");
  }

  for (const tab of tabs) {
    tab.addEventListener("click", () => {
      const filter = tab.dataset.filter;
      if (filter) setFilter(filter);
    });
  }

  document
    .querySelectorAll<HTMLButtonElement>("[data-goto-panel]")
    ?.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.gotoPanel;
        if (!filter) return;
        setFilter(filter);
        document.querySelector(".more-menu")?.removeAttribute("open");
        const reduceMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;
        document
          .querySelector(`[data-panel="${filter}"]`)
          ?.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth" });
      });
    });

  // Invoice delivery: no separate edit mode -- the checkboxes are always
  // live, and Save only becomes active once they actually differ from the
  // saved state (rather than always being submittable).
  const deliveryForm = document.querySelector<HTMLFormElement>(
    "[data-delivery-form]"
  );
  const deliverySave = deliveryForm?.querySelector<HTMLButtonElement>(
    "[data-delivery-save]"
  );
  if (deliveryForm && deliverySave) {
    const deliveryCheckboxes = [
      ...deliveryForm.querySelectorAll<HTMLInputElement>(
        'input[type="checkbox"]'
      ),
    ];
    const initialState = deliveryCheckboxes.map((box) => box.checked);
    const updateSaveState = () => {
      const isDirty = deliveryCheckboxes.some(
        (box, index) => box.checked !== initialState[index]
      );
      deliverySave.disabled = !isDirty;
    };
    for (const box of deliveryCheckboxes) {
      box.addEventListener("change", updateSaveState);
    }
  }
</script>

