                      <div class="editor-actions">
                        <button type="submit" class="btn-primary">
                          {t("Save changes")}
                        </button>
                        <a
                          class="btn-secondary"
                          href={tabHref("meters")}
                          data-editor-cancel
                        >
                          {t("Cancel")}
                        </a>
                      </div>
                    </form>
                  </div>
