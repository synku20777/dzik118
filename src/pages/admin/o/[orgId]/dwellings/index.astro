---
// Phase D (Organizations/dwellings) - dwelling list/import (spec Section
// 9.2, 27 "Dwellings: List"). Every route performs independent server
// authorization (spec Section 9.2's closing line) -- this doesn't rely on
// middleware alone.
import PageHeader from "../../../../../components/ui/PageHeader.astro";
import StatusBadge from "../../../../../components/ui/StatusBadge.astro";
import Icon from "../../../../../components/ui/Icon.astro";
import type { IconName } from "../../../../../lib/ui/icons";
import {
  translate,
  uiLocale,
  entityLabel,
  formatNumber,
} from "../../../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
import FieldError from "../../../../../components/ui/FieldError.astro";
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import { actions } from "astro:actions";
import {
  ForbiddenError,
  requireOrganizationAccess,
} from "../../../../../domain/authorization/guards";
import { getOrganization } from "../../../../../domain/organizations/organizations";
import { listDwellings } from "../../../../../domain/organizations/dwellings";
import { withRequestDb } from "../../../../../lib/db-request";

const organizationId = Astro.params.orgId!;
try {
  requireOrganizationAccess(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const createResult = Astro.getActionResult(actions.dwellings.create);
const archiveResult = Astro.getActionResult(actions.dwellings.archive);

const search = Astro.url.searchParams.get("search") ?? "";
const includeArchived = Astro.url.searchParams.get("includeArchived") === "1";
const requestedPage = Math.max(
  1,
  Number(Astro.url.searchParams.get("page") ?? "1") || 1
);
const pageSize = 25;

const { organization, allDwellings } = await withRequestDb(async (db) => ({
  organization: await getOrganization(db, organizationId),
  allDwellings: await listDwellings(db, organizationId, {
    search: search || undefined,
    includeArchived,
    // ponytail: organization-sized directory (~1,000 users); move sorting/filtering into the query if scale grows.
    limit: 2147483647,
  }),
}));
const typeFilter = Astro.url.searchParams.get("type") ?? "";
const statusFilter = Astro.url.searchParams.get("status") ?? "";
const types = ["APARTMENT", "COMMERCIAL_UNIT", "PARKING", "STORAGE", "OTHER"];
const listPath = `/admin/o/${organizationId}/dwellings`;
const filtered = allDwellings
  .filter((d) => !types.includes(typeFilter) || d.type === typeFilter)
  .filter((d) => {
    if (statusFilter === "ACTIVE") return !d.archivedAt;
    if (statusFilter === "ARCHIVED") return !!d.archivedAt;
    return true;
  })
  .sort((a, b) => a.number.localeCompare(b.number, locale, { numeric: true }));
const page = Math.min(
  Math.floor(requestedPage),
  Math.max(1, Math.ceil(filtered.length / pageSize))
);
const dwellings = filtered.slice((page - 1) * pageSize, page * pageSize);

const DWELLING_TYPE_ICONS: Record<string, IconName> = {
  APARTMENT: "building",
  COMMERCIAL_UNIT: "building",
  PARKING: "car",
  STORAGE: "box",
  OTHER: "building-community",
};
---

<AdminLayout
  title={`Dwellings - ${organization.name}`}
  organizationId={organizationId}
  organizationName={organization.name}
>
  <div class="space-y-6">
    <nav class="breadcrumb" aria-label={t("Breadcrumb")}>
      <a href={`/admin/o/${organizationId}/dashboard`}>{t("Dashboard")}</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{t("Dwellings")}</span>
    </nav>
    <PageHeader
      title={t("Dwellings")}
      description={t("Manage dwelling details, occupants and resident access.")}
      display
    >
      <a
        class="btn-secondary"
        href={"/api/v1/admin/o/" + organizationId + "/dwellings/export"}
        >{t("Export CSV")}</a
      ><a
        class="btn-secondary"
        href={"/admin/o/" + organizationId + "/dwellings/import"}
        >{t("Import CSV")}</a
      ><a
        class="btn-primary"
        href="#create-dwelling"
        data-open-details="create-dwelling">{t("Create dwelling")}</a
      ></PageHeader
    >
    <form method="GET" class="filter-bar" data-instant-filter>
      <div>
        <label class="block text-label text-foreground" for="search"
          >{t("Search")}</label
        >
        <input
          id="search"
          name="search"
          value={search}
          placeholder={t("Number, occupant, address...")}
          autocomplete="off"
          class="mt-1 rounded-control border border-border px-3 py-1.5 text-body-sm"
        />
      </div>
      <div>
        <label class="block text-label" for="type-filter">{t("Type")}</label
        ><select
          id="type-filter"
          name="type"
          class="mt-1 rounded-control border border-border px-3 py-2 text-body-sm"
          ><option value="">{t("All types")}</option>{
            types.map((type) => (
              <option value={type} selected={type === typeFilter}>
                {entityLabel(type, locale)}
              </option>
            ))
          }</select
        >
      </div>
      <div>
        <label class="block text-label" for="status-filter">{t("Status")}</label
        >
        <select
          id="status-filter"
          name="status"
          class="mt-1 rounded-control border border-border px-3 py-2 text-body-sm"
        >
          <option value="">{t("All statuses")}</option>
          <option value="ACTIVE" selected={statusFilter === "ACTIVE"}>
            {t("Active")}
          </option>
          <option value="ARCHIVED" selected={statusFilter === "ARCHIVED"}>
            {t("Archived")}
          </option>
        </select>
      </div>
      <label class="flex items-center gap-2 pb-2 text-body-sm text-foreground">
        <input
          type="checkbox"
          name="includeArchived"
          value="1"
          checked={includeArchived}
        />
        {t("Show archived")}
      </label>
      {
        (search || typeFilter || statusFilter || includeArchived) && (
          <a href={listPath} class="clear-filters">
            {t("Clear filters")}
          </a>
        )
      }
    </form>

    {
      (createResult?.error || archiveResult?.error) && (
        <p class="rounded-control bg-danger-surface p-3 text-body-sm text-destructive">
          {createResult?.error?.message ?? archiveResult?.error?.message}
        </p>
      )
    }

    <div class="table-wrap stack-table">
      <table class="w-full text-left text-body-sm">
        <thead class="border-b border-border bg-surface-hover text-muted">
          <tr>
            <th class="px-4 py-2">
              {t("Number")}
              <span aria-hidden="true">↑</span>
            </th>
            <th class="px-4 py-2">{t("Type")}</th>
            <th class="px-4 py-2">{t("Occupant")}</th>
            <th class="px-4 py-2">{t("Address")}</th>
            <th class="px-4 py-2 text-right">{t("Area (m²)")}</th>
            <th class="px-4 py-2 text-right">{t("Residents")}</th>
            <th class="px-4 py-2">{t("Status")}</th>
            <th class="px-4 py-2 text-right">{t("Actions")}</th>
          </tr>
        </thead>
        <tbody
          class="divide-y divide-border"
          id="dwellings-list"
          data-address={organization.addressLine1}
          data-active-label={t("Active")}
          data-saving-label={t("Saving…")}
        >
          {
            dwellings.map((d) => (
              <tr class="row-link">
                <td class="px-4 py-2 font-medium">
                  <a
                    class="row-link-target hover:underline"
                    href={"/admin/o/" + organizationId + "/dwellings/" + d.id}
                  >
                    {d.number}
                  </a>
                </td>
                <td class="px-4 py-2">
                  <span class="dwelling-type">
                    <Icon
                      name={DWELLING_TYPE_ICONS[d.type] ?? "building"}
                      class="dwelling-type-icon"
                    />
                    {entityLabel(d.type, locale)}
                  </span>
                </td>
                <td class="px-4 py-2">{d.occupantName ?? "—"}</td>
                <td class="px-4 py-2">
                  {d.type === "APARTMENT" || d.type === "COMMERCIAL_UNIT"
                    ? `${organization.addressLine1} – ${d.number}`
                    : organization.addressLine1}
                </td>
                <td class="px-4 py-2 text-right">
                  {formatNumber(d.areaM2, locale, 2)}
                </td>
                <td class="px-4 py-2 text-right">{d.residentCount}</td>
                <td class="px-4 py-2">
                  <StatusBadge status={d.archivedAt ? "ARCHIVED" : "ACTIVE"} />
                </td>
                <td class="row-link-above px-4 py-2 text-right">
                  {!d.archivedAt && (
                    <details class="row-menu">
                      <summary aria-label={`${t("More actions")}: ${d.number}`}>
                        •••
                      </summary>
                      <div>
                        <form method="POST" action={actions.dwellings.archive}>
                          <input
                            type="hidden"
                            name="organizationId"
                            value={organizationId}
                          />
                          <input type="hidden" name="dwellingId" value={d.id} />
                          <button
                            type="submit"
                            data-confirm={`${t("Archive dwelling")} ${d.number}?`}
                          >
                            {t("Archive")}
                          </button>
                        </form>
                      </div>
                    </details>
                  )}
                </td>
              </tr>
            ))
          }
          {
            dwellings.length === 0 && (
              <tr data-empty-row>
                <td colspan="8" class="px-4 py-8 text-center text-muted">
                  {t("No dwellings match this filter.")}
                </td>
              </tr>
            )
          }
        </tbody>
      </table>
    </div>

    <div class="pagination-bar">
      <a
        href={`?search=${encodeURIComponent(search)}&includeArchived=${includeArchived ? "1" : "0"}&type=${encodeURIComponent(typeFilter)}&status=${encodeURIComponent(statusFilter)}&page=${Math.max(1, page - 1)}`}
        class="btn-secondary btn-sm"
        aria-disabled={page <= 1}
        class:list={{ "pointer-events-none opacity-40": page <= 1 }}
      >
        <Icon name="arrow-left" size="sm" />
        {t("Previous")}
      </a>
      <span class="pagination-page">{t("Page")} {page}</span>
      <a
        href={`?search=${encodeURIComponent(search)}&includeArchived=${includeArchived ? "1" : "0"}&type=${encodeURIComponent(typeFilter)}&status=${encodeURIComponent(statusFilter)}&page=${page + 1}`}
        class="btn-secondary btn-sm"
        aria-disabled={page * pageSize >= filtered.length}
        class:list={{
          "pointer-events-none opacity-40": page * pageSize >= filtered.length,
        }}
      >
        {t("Next")}
        <Icon name="arrow-right" size="sm" />
      </a>
    </div>

    <details
      id="create-dwelling"
      class="disclosure max-w-2xl"
      open={!!createResult?.error}
    >
      <summary>{t("Add dwelling")}</summary><p class="text-sm text-muted">
        {
          t(
            "New dwellings are included in future periods. Archive historically billed dwellings to preserve their invoices."
          )
        }
      </p>
      <form
        method="POST"
        action={actions.dwellings.create}
        id="dwelling-form"
        class="mt-4 grid grid-cols-2 gap-3"
        data-saving-label={t("Saving…")}
        data-pending-label={t("Creating dwelling…")}
        data-created-label={t("Dwelling created")}
        data-error-label={t("Could not create dwelling")}
        data-checking-label={t("Checking save status…")}
        data-unknown-label={t("Outcome not confirmed")}
        data-committed-missing={t(
          "The original change was saved, but the item is no longer present. The page has been refreshed."
        )}
        data-generic-error={t("Something went wrong. Please try again.")}
        data-reconcile-error={t("Saved, but the view could not be updated")}
      >
        <input type="hidden" name="organizationId" value={organizationId} />
        <div class="col-span-2">
          <label class="block text-sm font-medium text-foreground" for="number"
            >{t("Number")}</label
          >
          <input
            id="number"
            name="number"
            aria-describedby="number-error"
            required
            class="mt-1 w-full rounded-control border border-border px-3 py-2 text-sm"
          /><FieldError name="number" error={createResult?.error} />
        </div>
        <div>
          <label class="block text-sm font-medium text-foreground" for="type"
            >{t("Type")}</label
          >
          <select
            id="type"
            name="type"
            aria-describedby="type-error"
            class="mt-1 w-full rounded-control border border-border px-3 py-2 text-sm"
          >
            <option value="APARTMENT">{t("Apartment")}</option>
            <option value="COMMERCIAL_UNIT">{t("Commercial unit")}</option>
            <option value="PARKING">{t("Parking")}</option>
            <option value="STORAGE">{t("Storage")}</option>
            <option value="OTHER">{t("Other")}</option>
          </select><FieldError name="type" error={createResult?.error} />
        </div>
        <div>
          <label class="block text-sm font-medium text-foreground" for="areaM2"
            >{t("Area (m²)")}</label
          >
          <input
            id="areaM2"
            name="areaM2"
            aria-describedby="areaM2-error"
            type="number"
            step="0.01"
            min="0"
            class="mt-1 w-full rounded-control border border-border px-3 py-2 text-sm"
          /><FieldError name="areaM2" error={createResult?.error} />
        </div>
        <div class="col-span-2">
          <button type="submit" class="btn-primary">
            {t("Create")}
          </button>
        </div>
      </form>
    </details>
  </div>
</AdminLayout>

<script>
  import { actions } from "astro:actions";
  import { navigate } from "astro:transitions/client";
  import {
    bindMutationForm,
    copyAstroScope,
  } from "../../../../../lib/ui/mutate-form";
  import { onPageLoad } from "../../../../../lib/ui/page-lifecycle";

  interface CreatedDwelling {
    id: string;
    number: string;
    type: string;
    occupantName: string | null;
    areaM2: string | null;
    residentCount: number;
  }

  onPageLoad(() => {
    if (!document.querySelector("#dwelling-form")) return;
    const initializedPath = `${location.pathname}${location.search}`;
    const filterForm = document.querySelector<HTMLFormElement>(
      "[data-instant-filter]"
    );
    if (!filterForm) return;
    const searchInput = document.querySelector<HTMLInputElement>("#search");
    const typeSelect = document.querySelector("#type-filter");
    const statusSelect = document.querySelector("#status-filter");
    const archivedCheckbox = document.querySelector(
      'input[name="includeArchived"]'
    );
    let searchTimer: number | undefined;
    searchInput?.addEventListener("input", () => {
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(() => filterForm.requestSubmit(), 300);
    });
    typeSelect?.addEventListener("change", () => filterForm.requestSubmit());
    statusSelect?.addEventListener("change", () => filterForm.requestSubmit());
    archivedCheckbox?.addEventListener("change", () =>
      filterForm.requestSubmit()
    );

    const form = document.querySelector<HTMLFormElement>("#dwelling-form");
    const list =
      document.querySelector<HTMLTableSectionElement>("#dwellings-list");
    if (!form || !list) return () => window.clearTimeout(searchTimer);

    const reconcileEmpty = () => {
      const emptyRow =
        list.querySelector<HTMLTableRowElement>("[data-empty-row]");
      if (emptyRow) {
        emptyRow.hidden = !!list.querySelector("tr:not([data-empty-row])");
      }
    };

    const buildRow = (
      dwelling: CreatedDwelling,
      pending = false
    ): HTMLTableRowElement => {
      const row = document.createElement("tr");
      row.className = "row-link";
      row.dataset.dwellingId = dwelling.id;
      if (pending) row.dataset.pending = "true";
      const typeOption = form.querySelector<HTMLOptionElement>(
        `option[value="${dwelling.type}"]`
      );
      const href = `/admin/o/${
        form.querySelector<HTMLInputElement>('input[name="organizationId"]')
          ?.value ?? ""
      }/dwellings/${dwelling.id}`;
      const numberCell = document.createElement("td");
      numberCell.className = "px-4 py-2 font-medium";
      if (pending) {
        numberCell.textContent = dwelling.number;
      } else {
        const link = document.createElement("a");
        link.className = "row-link-target hover:underline";
        link.href = href;
        link.textContent = dwelling.number;
        numberCell.appendChild(link);
      }
      const values = [
        typeOption?.textContent?.trim() ?? dwelling.type,
        dwelling.occupantName ?? "—",
        list.dataset.address ?? "",
        dwelling.areaM2 ?? "—",
        String(dwelling.residentCount ?? 0),
        pending
          ? (list.dataset.savingLabel ?? "Saving…")
          : (list.dataset.activeLabel ?? "Active"),
        "",
      ];
      row.appendChild(numberCell);
      values.forEach((value, index) => {
        const cell = document.createElement("td");
        cell.className = `px-4 py-2${index === 3 || index === 4 || index === 6 ? " text-right" : ""}`;
        cell.textContent = value;
        row.appendChild(cell);
      });
      copyAstroScope(form, row, ...Array.from(row.querySelectorAll("*")));
      return row;
    };

    bindMutationForm<CreatedDwelling, HTMLTableRowElement>({
      form,
      action: (formData) => actions.dwellings.create(formData),
      savingLabel: form.dataset.savingLabel ?? "Saving…",
      fallbackErrorMessage:
        form.dataset.genericError ?? "Something went wrong. Please try again.",
      mutation: (formData) => ({
        entity: "dwelling",
        operation: "create",
        idempotentCreate: true,
        messageKey: "Creating dwelling…",
        successMessageKey: "Dwelling created",
        pendingLabel:
          `${form.dataset.pendingLabel ?? "Creating dwelling…"} ${String(formData.get("number") ?? "")}`.trim(),
        successLabel: form.dataset.createdLabel ?? "Dwelling created",
        errorLabel: form.dataset.errorLabel ?? "Could not create dwelling",
        reconciliationErrorLabel: form.dataset.reconcileError,
        committedMissingLabel: form.dataset.committedMissing,
      }),
      recover: async (clientMutationId) => {
        const organizationId =
          form.querySelector<HTMLInputElement>('input[name="organizationId"]')
            ?.value ?? "";
        const { data, error } = await actions.mutations.lookup({
          organizationId,
          clientMutationId,
        });
        if (error || !data) throw error ?? new Error("Lookup failed");
        return data;
      },
      onVerifying: (optimisticRow, unknown) => {
        const status = optimisticRow?.querySelector<HTMLTableCellElement>(
          "td:nth-last-child(2)"
        );
        if (status) {
          status.textContent = unknown
            ? (form.dataset.unknownLabel ?? "Outcome not confirmed")
            : (form.dataset.checkingLabel ?? "Checking save status…");
        }
      },
      onCommittedMissing: async (_form, optimisticRow) => {
        optimisticRow?.remove();
        reconcileEmpty();
        if (`${location.pathname}${location.search}` === initializedPath) {
          await navigate(initializedPath, { history: "replace" });
        }
      },
      optimistic: (formData, mutationId) => {
        const row = buildRow(
          {
            id: `client:dwelling:${mutationId.split(":").at(-1)}`,
            number: String(formData.get("number") ?? ""),
            type: String(formData.get("type") ?? "APARTMENT"),
            occupantName: null,
            areaM2: String(formData.get("areaM2") || "") || null,
            residentCount: 0,
          },
          true
        );
        list.appendChild(row);
        reconcileEmpty();
        return row;
      },
      onError: (_error, _form, optimisticRow) => {
        if (!optimisticRow?.isConnected) return;
        optimisticRow?.remove();
        reconcileEmpty();
      },
      onSuccess: async (dwelling, _form, optimisticRow) => {
        if (optimisticRow?.isConnected) {
          optimisticRow.replaceWith(buildRow(dwelling));
        }
        if (form.isConnected) {
          reconcileEmpty();
          form.reset();
          const details =
            document.querySelector<HTMLDetailsElement>("#create-dwelling");
          if (details) details.open = false;
          // Not a stale-read/Hyperdrive-caching workaround (Hyperdrive query
          // caching is disabled -- see docs/decisions/0005-admin-mutation-
          // feedback.md): this list is server-sorted by dwelling number
          // (listDwellings: `ORDER BY number ASC LIMIT/OFFSET`) and can be
          // search/type/status-filtered. The optimistic row above is always
          // appended at the end of the current view, which is only correct
          // by coincidence -- the new dwelling's real sort position, page,
          // or even membership in the active filter can't be reconstructed
          // client-side from the returned entity alone. This re-navigation
          // re-renders the list from the server's actual, authoritative
          // ordering/pagination/filtering. Do not remove this as if it were
          // leftover cache-staleness compensation.
          await navigate(window.location.href, { history: "replace" });
        } else if (
          `${location.pathname}${location.search}` === initializedPath
        ) {
          await navigate(initializedPath, { history: "replace" });
        }
      },
    });

    return () => window.clearTimeout(searchTimer);
  });
</script>

<style>
  .dwelling-type {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .dwelling-type-icon {
    width: 1.15rem;
    height: 1.15rem;
    flex-shrink: 0;
    color: var(--color-muted);
  }
  #dwellings-list tr[data-pending="true"] td:last-of-type {
    color: var(--color-primary);
    font-weight: 650;
  }
  .pagination-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .pagination-page {
    font-weight: 600;
  }
  /* .row-link-above (below) gives each row's actions cell z-index:1 so its
     button/menu clears the row-wide invisible link overlay -- but that
     makes every row's actions cell its OWN stacking context at the same
     z-index, so a later row's cell always paints over an earlier row's
     open menu regardless of the menu's own z-index (a child z-index can
     never escape its parent's stacking context). Promoting the whole
     <tr> only while ITS menu is open fixes that without giving every row
     a competing z-index. */
  .row-link:has(.row-menu[open]) {
    z-index: 2;
  }
  .row-menu {
    position: relative;
    display: inline-block;
  }
  .row-menu summary {
    display: grid;
    min-width: 2rem;
    min-height: 2rem;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-surface);
    color: var(--color-muted);
    list-style: none;
    cursor: pointer;
  }
  .row-menu summary::-webkit-details-marker {
    display: none;
  }
  .row-menu > div {
    position: absolute;
    z-index: 100;
    top: calc(100% + 0.35rem);
    right: 0;
    min-width: 9rem;
    padding: 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-surface);
    box-shadow: var(--elevation-1);
  }
  .row-menu button {
    display: block;
    width: 100%;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-badge);
    color: var(--color-foreground);
    font-size: 0.875rem;
    text-align: left;
  }
  .row-menu button:hover {
    background: var(--color-surface-hover);
  }
</style>
