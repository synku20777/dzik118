  /* Astro scopes component styles by adding a data-astro-cid attribute
     that only elements written directly in this template receive --
     the live preview built by the <script> above creates elements via
     document.createElement/innerHTML at runtime, so .rule-summary-preview*
     and .rule-icon must be styled globally, not in the scoped <style>
     block below (same reasoning as the messages inbox page's .message-*
     classes). */
  /* Table-row icon -- bare, no badge container (per the icon system's
     container rule: table rows/buttons/chips stay bare; only category
     cards, empty states, and summary/KPI cards keep the badge treatment). */
  .rule-icon {
    display: grid;
