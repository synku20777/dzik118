<script
  is:inline
  define:vars={{
    calculationTypeLabels,
    ongoingLabel: t("ongoing"),
    iconBodies: RULE_ICON_BODIES,
  }}
>
  const filterForm = document.querySelector("[data-instant-filter]");
  const searchInput = document.querySelector("#search");
  const typeSelect = document.querySelector("#type-filter");
  const statusSelect = document.querySelector("#status-filter");
  const archivedCheckbox = document.querySelector("#show-archived");
  let searchTimer;
  searchInput?.addEventListener("input", () => {
    window.clearTimeout(searchTimer);
    searchTimer = window.setTimeout(() => filterForm?.requestSubmit(), 300);
  });
  typeSelect?.addEventListener("change", () => filterForm?.requestSubmit());
  statusSelect?.addEventListener("change", () => filterForm?.requestSubmit());
  archivedCheckbox?.addEventListener("change", () =>
    filterForm?.requestSubmit()
  );

  // Pure client-side preview of the create-rule form -- no backend call,
  // just reflects the form's own current field values. Icon selection
  // mirrors the server-rendered table rows' ruleIcon() logic above.
  const form = document.querySelector("#create-rule-form");
  const summaryBody = document.querySelector("#rule-summary-body");
  if (form && summaryBody) {
    // Captured once, before any mutation, so restoring the empty state
    // below reuses the server-rendered (correctly localized) markup
    // instead of a separately hard-coded copy that could drift out of
    // sync with translations.
    const emptyStateHtml = summaryBody.innerHTML;
    const ICONS = iconBodies;
    const iconKeyFor = (meterType, calculationType) => {
      if (meterType && ICONS[meterType]) return meterType;
      if (ICONS[calculationType]) return calculationType;
      return "DEFAULT";
    };

    const render = () => {
      const data = new FormData(form);
      const name = String(data.get("name") || "").trim();
      const code = String(data.get("code") || "").trim();
      if (!name && !code) {
        summaryBody.innerHTML = emptyStateHtml;
        return;
      }
      const calculationType = String(data.get("calculationType") || "FIXED");
      const meterType = String(data.get("meterType") || "");
      const unit = String(data.get("unit") || "");
      const unitPrice = String(data.get("unitPrice") || "").trim();
      const vatRate = String(data.get("vatRate") || "").trim();
      const effectiveFrom = String(data.get("effectiveFrom") || "");
      const effectiveUntil = String(data.get("effectiveUntil") || "");
      const iconKey = iconKeyFor(meterType, calculationType);
      const typeLabel =
        calculationTypeLabels[calculationType] ?? calculationType;

      const wrap = document.createElement("div");
      wrap.className = "rule-summary-preview";

      const head = document.createElement("div");
      head.className = "rule-summary-preview-head";
      const icon = document.createElement("span");
      icon.className = "rule-icon";
      icon.dataset.icon = iconKey.toLowerCase();
      icon.setAttribute("aria-hidden", "true");
      icon.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">${ICONS[iconKey]}</svg>`;
      const text = document.createElement("div");
      const nameEl = document.createElement("p");
      nameEl.className = "rule-summary-preview-name";
      nameEl.textContent = name || "—";
      const codeEl = document.createElement("p");
      codeEl.className = "rule-summary-preview-code";
      codeEl.textContent = code || "—";
      text.appendChild(nameEl);
      text.appendChild(codeEl);
      head.appendChild(icon);
      head.appendChild(text);

      const typeLine = document.createElement("p");
      typeLine.className = "rule-summary-preview-line";
      typeLine.textContent = unit ? `${typeLabel} · ${unit}` : typeLabel;

      const priceLine = document.createElement("p");
      priceLine.className = "rule-summary-preview-line";
      const priceText = unitPrice ? unitPrice : "0.0000";
      const vatText = vatRate ? vatRate : "0.0000";
      priceLine.textContent = unit
        ? `${priceText} / ${unit} + ${vatText}% VAT`
        : `${priceText} + ${vatText}% VAT`;

      const periodLine = document.createElement("p");
      periodLine.className = "rule-summary-preview-line";
      periodLine.textContent = `${effectiveFrom || "—"} → ${effectiveUntil || ongoingLabel}`;

      wrap.appendChild(head);
      wrap.appendChild(typeLine);
      wrap.appendChild(priceLine);
      wrap.appendChild(periodLine);
      summaryBody.replaceChildren(wrap);
    };

    form.addEventListener("input", render);
    form.addEventListener("change", render);
  }
</script>

