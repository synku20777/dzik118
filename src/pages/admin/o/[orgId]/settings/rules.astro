---
import {
  translate,
  uiLocale,
  friendlyActionErrorMessage,
} from "../../../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
// Phase F (Billing configuration) - tariffs/rules settings (spec Section
// 9.2, 27, BILL-RULE-001/002/003).
import PageHeader from "../../../../../components/ui/PageHeader.astro";
import Icon from "../../../../../components/ui/Icon.astro";
import type { IconName } from "../../../../../lib/ui/icons";
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import {
  ForbiddenError,
  requireOrganizationAccess,
} from "../../../../../domain/authorization/guards";

const organizationId = Astro.params.orgId!;
try {
  requireOrganizationAccess(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

import { actions } from "astro:actions";
import { getOrganization } from "../../../../../domain/organizations/organizations";
import {
  listRules,
  listRuleAssignmentsWithDwellingNumbers,
} from "../../../../../domain/billing/rules";
import { listDwellings } from "../../../../../domain/organizations/dwellings";
import { withRequestDb } from "../../../../../lib/db-request";

const createResult = Astro.getActionResult(actions.billing.createRule);
const updateResult = Astro.getActionResult(actions.billing.updateRule);
const archiveResult = Astro.getActionResult(actions.billing.archiveRule);

const base = `/admin/o/${organizationId}`;
const settingsHref = `${base}/settings`;

const search = Astro.url.searchParams.get("search")?.trim().toLowerCase() ?? "";
const typeFilter = Astro.url.searchParams.get("type") ?? "";
const rawStatus = Astro.url.searchParams.get("status");
const statusFilter =
  rawStatus === "ACTIVE" || rawStatus === "DISABLED" || rawStatus === "ARCHIVED"
    ? rawStatus
    : "";
const showArchivedChecked =
  Astro.url.searchParams.get("includeArchived") === "1";
const includeArchived = showArchivedChecked || statusFilter === "ARCHIVED";

const { organization, allRules, assignmentsByRule, dwellingOptions } =
  await withRequestDb(async (db) => ({
    organization: await getOrganization(db, organizationId),
    allRules: await listRules(db, organizationId, { includeArchived }),
    assignmentsByRule: await listRuleAssignmentsWithDwellingNumbers(
      db,
      organizationId
    ),
    dwellingOptions: await listDwellings(db, organizationId, { limit: 1000 }),
  }));

function appliesToSummary(rule: {
  applicationScope: string;
  id: string;
}): string {
  if (rule.applicationScope === "ONE_TO_ALL") return t("All dwellings");
  const targets = assignmentsByRule.get(rule.id) ?? [];
  if (targets.length === 0) return t("Not assigned yet");
  if (rule.applicationScope === "ONE_TO_ONE") {
    return `${t("Dwelling")} ${targets[0].number}`;
  }
  return `${targets.length} ${t("dwellings")}`;
}

const filtered = allRules
  .filter((r) => !typeFilter || r.calculationType === typeFilter)
  .filter((r) => {
    if (statusFilter === "ACTIVE") return !r.archivedAt && r.enabled;
    if (statusFilter === "DISABLED") return !r.archivedAt && !r.enabled;
    if (statusFilter === "ARCHIVED") return !!r.archivedAt;
    return true;
  })
  .filter((r) => {
    if (!search) return true;
    return (
      r.name.toLowerCase().includes(search) ||
      r.code.toLowerCase().includes(search)
    );
  });

const calculationTypes = [
  "FIXED",
  "AREA",
  "RESIDENT_COUNT",
  "METER_CONSUMPTION",
  "MANUAL_QUANTITY",
  "MANUAL_AMOUNT",
] as const;
const calculationTypeLabels: Record<string, string> = {
  FIXED: t("Fixed"),
  AREA: t("Area"),
  RESIDENT_COUNT: t("Resident count"),
  METER_CONSUMPTION: t("Meter consumption"),
  MANUAL_QUANTITY: t("Manual quantity"),
  MANUAL_AMOUNT: t("Manual amount"),
};

function filterHref(overrides: Record<string, string | undefined> = {}) {
  const params = new URLSearchParams();
  if (search) params.set("search", search);
  if (typeFilter) params.set("type", typeFilter);
  if (statusFilter) params.set("status", statusFilter);
  if (showArchivedChecked) params.set("includeArchived", "1");
  for (const [key, value] of Object.entries(overrides)) {
    if (value === undefined) params.delete(key);
    else params.set(key, value);
  }
  const query = params.toString();
  return query ? `${Astro.url.pathname}?${query}` : Astro.url.pathname;
}

// Icon selection: meter-typed rules get a droplet/flame/bolt/thermometer
// icon; everything else falls back to an icon keyed by calculation type.
// Purely decorative -- same convention as the dwellings list's type icons
// and the readings drawer's meter icons elsewhere in this app.
type RuleIcon =
  | "cold_water"
  | "hot_water"
  | "electricity"
  | "gas"
  | "heat"
  | "generic"
  | "fixed"
  | "area"
  | "users"
  | "document";

function ruleIcon(rule: {
  calculationType: string;
  meterType: string | null;
}): RuleIcon {
  if (rule.meterType === "COLD_WATER") return "cold_water";
  if (rule.meterType === "HOT_WATER") return "hot_water";
  if (rule.meterType === "ELECTRICITY") return "electricity";
  if (rule.meterType === "GAS") return "gas";
  if (rule.meterType === "HEAT") return "heat";
  if (rule.meterType === "OTHER") return "generic";
  if (rule.calculationType === "FIXED") return "fixed";
  if (rule.calculationType === "AREA") return "area";
  if (rule.calculationType === "RESIDENT_COUNT") return "users";
  return "document";
}

const RULE_ICON_NAMES: Record<RuleIcon, IconName> = {
  cold_water: "droplet",
  hot_water: "droplet-hot",
  electricity: "bolt",
  gas: "flame",
  heat: "thermometer",
  generic: "tool",
  fixed: "tool",
  area: "ruler-2",
  users: "users",
  document: "file-description",
};
---

<AdminLayout
  title="Tariffs & rules"
  organizationId={organizationId}
  organizationName={organization.name}
>
  <div class="rules-page">
    <a href={settingsHref} class="back-link">
      <span aria-hidden="true">←</span>
      {t("Settings")}
    </a>

    <PageHeader
      title={t("Tariffs and rules")}
      description={t(
        "Manage utility rates, billing formulas, and effective periods."
      )}
      display
    >
      <a href={`${base}/guide`} class="btn-secondary settings-help">
        <span class="settings-help-icon" aria-hidden="true">?</span>
        {t("Help & guidance")}
      </a>
    </PageHeader>

    {
      (createResult?.error || updateResult?.error || archiveResult?.error) && (
        <p class="notice notice-danger" role="alert">
          {friendlyActionErrorMessage(
            createResult?.error ?? updateResult?.error ?? archiveResult?.error,
            locale
          )}
        </p>
      )
    }

    <form method="GET" class="filter-bar rules-filter-bar" data-instant-filter>
      <div>
        <label class="block text-label text-foreground" for="search">
          {t("Search")}
        </label>
        <input
          id="search"
          name="search"
          value={search}
          placeholder={t("Search rules by name or code...")}
          autocomplete="off"
          class="mt-1 rounded-control border border-border px-3 py-1.5 text-body-sm"
        />
      </div>
      <div>
        <label class="block text-label" for="type-filter">{t("Type")}</label>
        <select
          id="type-filter"
          name="type"
          class="mt-1 rounded-control border border-border px-3 py-2 text-body-sm"
        >
          <option value="">{t("All types")}</option>
          {
            calculationTypes.map((type) => (
              <option value={type} selected={typeFilter === type}>
                {calculationTypeLabels[type]}
              </option>
            ))
          }
        </select>
      </div>
      <div>
        <label class="block text-label" for="status-filter">{t("Status")}</label
        >
        <select
          id="status-filter"
          name="status"
          class="mt-1 rounded-control border border-border px-3 py-2 text-body-sm"
        >
          <option value="">{t("All statuses")}</option>
          <option value="ACTIVE" selected={statusFilter === "ACTIVE"}>
            {t("Active")}
          </option>
          <option value="DISABLED" selected={statusFilter === "DISABLED"}>
            {t("Disabled")}
          </option>
          <option value="ARCHIVED" selected={statusFilter === "ARCHIVED"}>
            {t("Archived")}
          </option>
        </select>
      </div>
      <label class="flex items-center gap-2 pb-2 text-body-sm text-foreground">
        <input
          id="show-archived"
          type="checkbox"
          name="includeArchived"
          value="1"
          checked={showArchivedChecked}
        />
        {t("Show archived")}
      </label>
      {
        (search || typeFilter || statusFilter || showArchivedChecked) && (
          <a
            href={filterHref({
              search: undefined,
              type: undefined,
              status: undefined,
              includeArchived: undefined,
            })}
            class="clear-filters"
          >
            {t("Clear filters")}
          </a>
        )
      }
      <button
        type="button"
        class="btn-primary rules-create-link"
        data-open-tariff-drawer="create"
      >
        <span aria-hidden="true">+</span>
        {t("Create tariff")}
      </button>
    </form>

    <div class="table-wrap">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-border bg-surface-hover text-muted">
          <tr>
            <th class="px-4 py-2">{t("Name")}</th>
            <th class="px-4 py-2">{t("Code")}</th>
            <th class="px-4 py-2">{t("Type")}</th>
            <th class="px-4 py-2">{t("Unit")}</th>
            <th class="px-4 py-2 text-right">{t("Unit price")}</th>
            <th class="px-4 py-2">{t("VAT")}</th>
            <th class="px-4 py-2">{t("Effective period")}</th>
            <th class="px-4 py-2">{t("Applies to")}</th>
            <th class="px-4 py-2">{t("Status")}</th>
            <th class="px-4 py-2 text-right">{t("Actions")}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          {
            filtered.map((rule) => (
              <tr>
                <td class="px-4 py-2">
                  <div class="rule-name-cell">
                    <span
                      class="rule-icon"
                      data-icon={ruleIcon(rule)}
                      aria-hidden="true"
                    >
                      <Icon name={RULE_ICON_NAMES[ruleIcon(rule)]} />
                    </span>
                    <div>
                      <span class="font-medium text-foreground block">
                        {rule.name}
                      </span>
                      <span class="block text-xs text-muted">{rule.code}</span>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-2 font-mono text-xs text-muted">
                  {rule.code}
                </td>
                <td class="px-4 py-2">
                  {calculationTypeLabels[rule.calculationType] ??
                    rule.calculationType}
                </td>
                <td class="px-4 py-2">{rule.unit}</td>
                <td class="px-4 py-2 text-right tabular-nums">
                  {rule.unitPrice ?? "—"}
                </td>
                <td class="px-4 py-2 tabular-nums">{rule.vatRate}%</td>
                <td class="px-4 py-2">
                  {rule.effectiveFrom} → {rule.effectiveUntil ?? t("ongoing")}
                </td>
                <td class="px-4 py-2 text-muted">{appliesToSummary(rule)}</td>
                <td class="px-4 py-2">
                  <span
                    class="rule-status"
                    data-tone={
                      rule.archivedAt
                        ? "archived"
                        : rule.enabled
                          ? "active"
                          : "disabled"
                    }
                  >
                    <span class="rule-status-dot" aria-hidden="true" />
                    {rule.archivedAt
                      ? t("Archived")
                      : rule.enabled
                        ? t("Active")
                        : t("Disabled")}
                  </span>
                </td>
                <td class="px-4 py-2 text-right">
                  {!rule.archivedAt && (
                    <div class="rule-actions">
                      <button
                        type="button"
                        class="btn-secondary btn-sm"
                        data-open-tariff-drawer="edit"
                        data-rule={JSON.stringify({
                          id: rule.id,
                          name: rule.name,
                          nameEn: rule.nameEn,
                          nameRu: rule.nameRu,
                          code: rule.code,
                          description: rule.description,
                          calculationType: rule.calculationType,
                          meterType: rule.meterType,
                          unit: rule.unit,
                          unitPrice: rule.unitPrice,
                          vatRate: rule.vatRate,
                          effectiveFrom: rule.effectiveFrom,
                          effectiveUntil: rule.effectiveUntil,
                          applicationScope: rule.applicationScope,
                          sortOrder: rule.sortOrder,
                          enabled: rule.enabled,
                          dwellingIds: (
                            assignmentsByRule.get(rule.id) ?? []
                          ).map((a) => a.dwellingId),
                        })}
                      >
                        <Icon name="pencil" size="sm" />
                        {t("Edit")}
                      </button>
                      <details class="row-menu">
                        <summary
                          aria-label={`${t("More actions")}: ${rule.name}`}
                        >
                          •••
                        </summary>
                        <div>
                          <form
                            method="POST"
                            action={actions.billing.archiveRule}
                          >
                            <input
                              type="hidden"
                              name="organizationId"
                              value={organizationId}
                            />
                            <input
                              type="hidden"
                              name="ruleId"
                              value={rule.id}
                            />
                            <button type="submit">{t("Archive")}</button>
                          </form>
                        </div>
                      </details>
                    </div>
                  )}
                </td>
              </tr>
            ))
          }
          {
            filtered.length === 0 && (
              <tr>
                <td colspan="10" class="px-4 py-8 text-center text-muted">
                  {t("No billing rules match this filter.")}
                </td>
              </tr>
            )
          }
        </tbody>
      </table>
    </div>

    <div class="rules-tips-row">
      <aside class="rules-sidebar">
        <div class="rule-info-banner">
          <span class="rule-info-icon" aria-hidden="true">i</span>
          <div>
            <p class="rule-info-title">{t("How tariffs are applied")}</p>
            <p>
              {
                t(
                  "Tariffs define how charges are calculated for each billing period."
                )
              }
              {" "}
              {
                t(
                  "Each rule has an effective period and can be archived when no longer in use."
                )
              }
            </p>
          </div>
        </div>

        <div class="rule-tips">
          <h3>{t("Good to know")}</h3>
          <div class="rule-tip">
            <span
              class="rule-tip-icon"
              data-icon="cold_water"
              aria-hidden="true"
            >
              <Icon name="droplet" size="lg" />
            </span>
            <div>
              <p class="rule-tip-title">{t("Meter-based rules")}</p>
              <p>
                {
                  t(
                    "Use meter consumption for utilities like water, heat, or electricity. Charges are calculated from the difference in meter readings."
                  )
                }
              </p>
            </div>
          </div>
          <div class="rule-tip">
            <span class="rule-tip-icon" data-icon="area" aria-hidden="true">
              <Icon name="tool" size="lg" />
            </span>
            <div>
              <p class="rule-tip-title">{t("Fixed rules")}</p>
              <p>
                {
                  t(
                    "Use fixed rules for regular charges like maintenance fees. The amount is the same each period (per unit)."
                  )
                }
              </p>
            </div>
          </div>
          <div class="rule-tip">
            <span class="rule-tip-icon" data-icon="calendar" aria-hidden="true">
              <Icon name="calendar-month" size="lg" />
            </span>
            <div>
              <p class="rule-tip-title">{t("Effective periods")}</p>
              <p>
                {
                  t(
                    "Avoid overlapping rules of the same type. When a new rate applies, create a new rule with a later effective date."
                  )
                }
              </p>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <dialog
    id="tariff-drawer"
    class="context-drawer tariff-drawer"
    aria-labelledby="tariff-drawer-title"
    data-strings={JSON.stringify({
      createTitle: t("Create tariff"),
      createLabel: t("Create tariff"),
      saveLabel: t("Save changes"),
      savingLabel: t("Saving…"),
      active: t("Active"),
      disabled: t("Disabled"),
      dwellingsSelected: t("dwellings selected"),
      dwellingSelected: t("dwelling selected"),
      genericError: t("Something went wrong. Please try again."),
    })}
  >
    <header class="context-drawer-header">
      <div class="context-drawer-heading">
        <p class="context-drawer-eyebrow">{t("TARIFF")}</p>
        <div class="context-drawer-title-row">
          <h2 class="context-drawer-title" id="tariff-drawer-title"></h2>
          <span
            class="status-badge"
            id="tariff-drawer-status"
            data-tone="neutral"
            hidden></span>
        </div>
      </div>
      <button
        type="button"
        class="context-drawer-close"
        data-close-tariff-drawer
        aria-label={t("Close")}
      >
        <span aria-hidden="true">×</span>
      </button>
    </header>
    <div class="context-drawer-body">
      {
        (createResult?.error || updateResult?.error) && (
          <p class="notice notice-danger" role="alert" data-tariff-drawer-error>
            {friendlyActionErrorMessage(
              createResult?.error ?? updateResult?.error,
              locale
            )}
          </p>
        )
      }
      <form id="tariff-form" novalidate>
        <input type="hidden" name="organizationId" value={organizationId} />
        <input type="hidden" name="ruleId" id="tariff-ruleId" />

        <h3 class="drawer-section-heading">{t("General")}</h3>
        <div class="rule-field-row">
          <div class="rule-field">
            <label for="tariff-name">{t("Name")} *</label>
            <input id="tariff-name" name="name" type="text" required />
          </div>
          <div class="rule-field">
            <label for="tariff-code">{t("Code")} *</label>
            <input id="tariff-code" name="code" type="text" required />
            <p class="rule-field-hint">
              {t("Unique identifier (e.g. cold_water).")}
            </p>
          </div>
        </div>
        <div class="rule-field-row">
          <div class="rule-field">
            <label for="tariff-nameEn">{t("English invoice label")}</label>
            <input
              id="tariff-nameEn"
              name="nameEn"
              type="text"
              maxlength="200"
            />
          </div>
          <div class="rule-field">
            <label for="tariff-nameRu">{t("Russian invoice label")}</label>
            <input
              id="tariff-nameRu"
              name="nameRu"
              type="text"
              maxlength="200"
            />
          </div>
        </div>
        <div class="rule-field">
          <label for="tariff-description">{t("Description")}</label>
          <textarea
            id="tariff-description"
            name="description"
            class="drawer-textarea-box"
            rows="2"></textarea>
        </div>

        <h3 class="drawer-section-heading">{t("Calculation")}</h3>
        <div class="rule-field-row rule-field-row-3">
          <div class="rule-field">
            <label for="tariff-calculationType">{t("Type")} *</label>
            <select id="tariff-calculationType" name="calculationType">
              {
                calculationTypes.map((type) => (
                  <option value={type}>{calculationTypeLabels[type]}</option>
                ))
              }
            </select>
          </div>
          <div class="rule-field">
            <label for="tariff-unit">{t("Unit")} *</label>
            <input
              id="tariff-unit"
              name="unit"
              type="text"
              required
              placeholder={t("e.g. m3, month, person")}
            />
          </div>
          <div class="rule-field" data-meter-type-field>
            <label for="tariff-meterType">{t("Meter type")}</label>
            <select id="tariff-meterType" name="meterType">
              <option value="">{t("-- none --")}</option>
              <option value="COLD_WATER">{t("Cold water")}</option>
              <option value="HOT_WATER">{t("Hot water")}</option>
              <option value="ELECTRICITY">{t("Electricity")}</option>
              <option value="GAS">{t("Gas")}</option>
              <option value="HEAT">{t("Heat")}</option>
              <option value="OTHER">{t("Other")}</option>
            </select>
          </div>
        </div>
        <div class="rule-field-row">
          <div class="rule-field" data-unit-price-field>
            <label for="tariff-unitPrice">{t("Unit price")} *</label>
            <input
              id="tariff-unitPrice"
              name="unitPrice"
              type="text"
              placeholder="0.0000"
            />
            <p class="rule-field-hint">
              {t("A price of 0.00 is valid and will show on the invoice.")}
            </p>
          </div>
          <div class="rule-field">
            <label for="tariff-vatRate">{t("VAT %")}</label>
            <input
              id="tariff-vatRate"
              name="vatRate"
              type="text"
              placeholder="21.0000"
            />
          </div>
        </div>

        <h3 class="drawer-section-heading">{t("Applies to")}</h3>
        <div class="rule-field">
          <div class="tariff-scope-options" role="radiogroup">
            <label class="tariff-scope-option">
              <input
                type="radio"
                name="applicationScope"
                value="ONE_TO_ALL"
                checked
              />
              <span>
                <strong>{t("All dwellings")}</strong>
                <p>
                  {t("Applies to every current and future dwelling.")} (1:All)
                </p>
              </span>
            </label>
            <label class="tariff-scope-option">
              <input type="radio" name="applicationScope" value="ONE_TO_MANY" />
              <span>
                <strong>{t("Selected dwellings")}</strong>
                <p>
                  {
                    t(
                      "Applies only to the dwellings you choose. New dwellings are not included automatically."
                    )
                  }{" "}
                  (1:N)
                </p>
              </span>
            </label>
            <label class="tariff-scope-option">
              <input type="radio" name="applicationScope" value="ONE_TO_ONE" />
              <span>
                <strong>{t("One dwelling")}</strong>
                <p>{t("Applies to exactly one dwelling.")} (1:1)</p>
              </span>
            </label>
          </div>
        </div>
        <div class="rule-field" data-scope-panel="ONE_TO_MANY" hidden>
          <label for="tariff-dwelling-search">
            {t("Search dwellings")}
          </label>
          <input
            id="tariff-dwelling-search"
            type="text"
            data-dwelling-search
            placeholder={t("Filter by dwelling number...")}
          />
          <div class="tariff-dwelling-actions">
            <button
              type="button"
              class="btn-secondary btn-sm"
              data-select-all-visible
            >
              {t("Select all visible")}
            </button>
            <button
              type="button"
              class="btn-secondary btn-sm"
              data-clear-selection
            >
              {t("Clear selection")}
            </button>
            <span data-dwelling-count-label>{t("0 dwellings selected")}</span>
          </div>
          <div class="tariff-dwelling-list" data-dwelling-checklist>
            {
              dwellingOptions.map((d) => (
                <label
                  class="tariff-dwelling-row"
                  data-dwelling-number={d.number.toLowerCase()}
                >
                  <input type="checkbox" name="dwellingIds" value={d.id} />
                  {t("Dwelling")} {d.number}
                </label>
              ))
            }
          </div>
        </div>
        <div class="rule-field" data-scope-panel="ONE_TO_ONE" hidden>
          <label for="tariff-dwelling-single">{t("Dwelling")} *</label>
          <select id="tariff-dwelling-single" name="dwellingIdSingle">
            <option value="">{t("-- select a dwelling --")}</option>
            {
              dwellingOptions.map((d) => (
                <option value={d.id}>
                  {t("Dwelling")} {d.number}
                </option>
              ))
            }
          </select>
        </div>

        <h3 class="drawer-section-heading">{t("Validity")}</h3>
        <div class="rule-field-row">
          <div class="rule-field">
            <label for="tariff-effectiveFrom">{t("Effective from")} *</label>
            <input
              id="tariff-effectiveFrom"
              name="effectiveFrom"
              type="date"
              required
            />
          </div>
          <div class="rule-field">
            <label for="tariff-effectiveUntil">{t("Effective until")}</label>
            <input
              id="tariff-effectiveUntil"
              name="effectiveUntil"
              type="date"
            />
            <p class="rule-field-hint">{t("Leave empty for ongoing.")}</p>
          </div>
        </div>
        <label class="rule-edit-checkbox">
          <input
            type="checkbox"
            id="tariff-enabled"
            name="enabled"
            value="1"
            checked
          />
          {t("Enabled")}
        </label>

        <h3 class="drawer-section-heading">{t("Advanced")}</h3>
        <div class="rule-field">
          <label for="tariff-sortOrder">{t("Sort order")}</label>
          <input
            id="tariff-sortOrder"
            name="sortOrder"
            type="number"
            step="1"
          />
        </div>
      </form>
    </div>
    <footer class="context-drawer-footer">
      <button
        type="button"
        class="btn-secondary"
        id="tariff-drawer-archive"
        hidden
      >
        {t("Archive")}
      </button>
      <button type="button" class="btn-secondary" data-close-tariff-drawer>
        {t("Cancel")}
      </button>
      <button
        type="submit"
        form="tariff-form"
        class="btn-primary"
        id="tariff-drawer-save"
      >
        {t("Save changes")}
      </button>
    </footer>
  </dialog>

  <form
    method="POST"
    action={actions.billing.archiveRule}
    id="archive-tariff-form"
    hidden
  >
    <input type="hidden" name="organizationId" value={organizationId} />
    <input type="hidden" name="ruleId" id="archive-tariff-ruleId" />
  </form>
</AdminLayout>

<script is:inline data-astro-rerun>
  const filterForm = document.querySelector("[data-instant-filter]");
  const searchInput = document.querySelector("#search");
  const typeSelect = document.querySelector("#type-filter");
  const statusSelect = document.querySelector("#status-filter");
  const archivedCheckbox = document.querySelector("#show-archived");
  let searchTimer;
  document.addEventListener(
    "astro:before-swap",
    () => window.clearTimeout(searchTimer),
    { once: true }
  );
  searchInput?.addEventListener("input", () => {
    window.clearTimeout(searchTimer);
    searchTimer = window.setTimeout(() => filterForm?.requestSubmit(), 300);
  });
  typeSelect?.addEventListener("change", () => filterForm?.requestSubmit());
  statusSelect?.addEventListener("change", () => filterForm?.requestSubmit());
  archivedCheckbox?.addEventListener("change", () =>
    filterForm?.requestSubmit()
  );
</script>

<script>
  import { actions, isInputError } from "astro:actions";
  import { navigate } from "astro:transitions/client";
  import { onPageLoad } from "../../../../../lib/ui/page-lifecycle";

  interface TariffRule {
    id: string;
    name: string;
    nameEn: string | null;
    nameRu: string | null;
    code: string;
    description: string | null;
    calculationType: string;
    meterType: string | null;
    unit: string;
    unitPrice: string | null;
    vatRate: string;
    effectiveFrom: string;
    effectiveUntil: string | null;
    applicationScope: "ONE_TO_ALL" | "ONE_TO_MANY" | "ONE_TO_ONE";
    sortOrder: number;
    enabled: boolean;
    dwellingIds: string[];
  }

  onPageLoad(() => {
    const dialogEl =
      document.querySelector<HTMLDialogElement>("#tariff-drawer");
    const formEl = document.querySelector<HTMLFormElement>("#tariff-form");
    if (!dialogEl || !formEl) return;
    // Rebinding to a fresh const (rather than relying on control-flow
    // narrowing of the original binding) is required for TS to carry the
    // non-null type into the closures defined below -- same trick as
    // workbench-drawer.ts's dialogEl/dialog pair.
    const dialog = dialogEl;
    const form = formEl;
    const controller = new AbortController();
    const strings: Record<string, string> = JSON.parse(
      dialog.dataset.strings ?? "{}"
    );

    const titleEl = document.querySelector<HTMLElement>(
      "#tariff-drawer-title"
    )!;
    const statusEl = document.querySelector<HTMLElement>(
      "#tariff-drawer-status"
    )!;
    const ruleIdField =
      document.querySelector<HTMLInputElement>("#tariff-ruleId")!;
    const archiveButton = document.querySelector<HTMLButtonElement>(
      "#tariff-drawer-archive"
    )!;
    const saveButton = document.querySelector<HTMLButtonElement>(
      "#tariff-drawer-save"
    )!;
    const errorBanner = document.querySelector<HTMLElement>(
      "[data-tariff-drawer-error]"
    );
    const meterTypeField = form.querySelector<HTMLElement>(
      "[data-meter-type-field]"
    )!;
    const unitPriceField = form.querySelector<HTMLElement>(
      "[data-unit-price-field]"
    )!;
    // Plain querySelector + cast, not querySelector<HTMLSelectElement>: the
    // generic overload's `T extends Element` constraint fails to resolve
    // for HTMLSelectElement under this project's workers-types/lib.dom.d.ts
    // collision (see invoice-template-editor.ts's identical workaround).
    const calculationTypeSelect = form.querySelector(
      "#tariff-calculationType"
    ) as unknown as HTMLSelectElement;
    const scopeRadios = [
      ...form.querySelectorAll<HTMLInputElement>(
        'input[name="applicationScope"]'
      ),
    ];
    const scopePanels = new Map(
      [...form.querySelectorAll<HTMLElement>("[data-scope-panel]")].map(
        (el) => [el.dataset.scopePanel, el]
      )
    );
    const dwellingChecklist = form.querySelector<HTMLElement>(
      "[data-dwelling-checklist]"
    )!;
    const dwellingCheckboxes = [
      ...dwellingChecklist.querySelectorAll<HTMLInputElement>(
        'input[name="dwellingIds"]'
      ),
    ];
    const dwellingSearch = form.querySelector<HTMLInputElement>(
      "[data-dwelling-search]"
    )!;
    const dwellingCountLabel = form.querySelector<HTMLElement>(
      "[data-dwelling-count-label]"
    )!;
    const dwellingSingleSelect = form.querySelector(
      "#tariff-dwelling-single"
    ) as unknown as HTMLSelectElement;

    let mode: "create" | "edit" = "create";
    let returnFocusTo: HTMLElement | null = null;

    const meterTypeSelect = form.querySelector(
      "#tariff-meterType"
    ) as unknown as HTMLSelectElement;
    const unitPriceInput =
      form.querySelector<HTMLInputElement>("#tariff-unitPrice")!;

    function updateMeterTypeVisibility() {
      const isMeter = calculationTypeSelect.value === "METER_CONSUMPTION";
      meterTypeField.hidden = !isMeter;
      // Hiding the field must also clear its value -- a hidden (but not
      // disabled) form control still submits, so a leftover meterType from
      // a previous METER_CONSUMPTION selection would otherwise be saved
      // alongside a FIXED/AREA/etc calculation type (wrong icon on the
      // list, and stale metadata on the row).
      if (!isMeter) meterTypeSelect.value = "";
      const isManualAmount = calculationTypeSelect.value === "MANUAL_AMOUNT";
      unitPriceField.hidden = isManualAmount;
      if (isManualAmount) unitPriceInput.value = "";
    }

    function updateDwellingCount() {
      const count = dwellingCheckboxes.filter((c) => c.checked).length;
      const suffix =
        count === 1
          ? (strings.dwellingSelected ?? "dwelling selected")
          : (strings.dwellingsSelected ?? "dwellings selected");
      dwellingCountLabel.textContent = `${count} ${suffix}`;
    }

    function updateScopeVisibility() {
      const selected =
        scopeRadios.find((r) => r.checked)?.value ?? "ONE_TO_ALL";
      for (const [key, panel] of scopePanels) {
        panel.hidden = key !== selected;
      }
    }

    for (const radio of scopeRadios) {
      radio.addEventListener("change", updateScopeVisibility, {
        signal: controller.signal,
      });
    }
    calculationTypeSelect.addEventListener(
      "change",
      updateMeterTypeVisibility,
      { signal: controller.signal }
    );
    for (const checkbox of dwellingCheckboxes) {
      checkbox.addEventListener("change", updateDwellingCount, {
        signal: controller.signal,
      });
    }
    dwellingSearch.addEventListener(
      "input",
      () => {
        const q = dwellingSearch.value.trim().toLowerCase();
        for (const row of dwellingChecklist.querySelectorAll<HTMLElement>(
          "[data-dwelling-number]"
        )) {
          row.hidden = q.length > 0 && !row.dataset.dwellingNumber?.includes(q);
        }
      },
      { signal: controller.signal }
    );
    form.querySelector("[data-select-all-visible]")?.addEventListener(
      "click",
      () => {
        for (const row of dwellingChecklist.querySelectorAll<HTMLElement>(
          "[data-dwelling-number]"
        )) {
          if (!row.hidden) {
            row.querySelector<HTMLInputElement>("input")!.checked = true;
          }
        }
        updateDwellingCount();
      },
      { signal: controller.signal }
    );
    form.querySelector("[data-clear-selection]")?.addEventListener(
      "click",
      () => {
        for (const checkbox of dwellingCheckboxes) checkbox.checked = false;
        updateDwellingCount();
      },
      { signal: controller.signal }
    );

    function resetForm() {
      form.reset();
      for (const checkbox of dwellingCheckboxes) checkbox.checked = false;
      updateMeterTypeVisibility();
      updateScopeVisibility();
      updateDwellingCount();
      if (errorBanner) errorBanner.hidden = true;
    }

    function openCreate() {
      mode = "create";
      ruleIdField.value = "";
      resetForm();
      titleEl.textContent = strings.createTitle ?? "Create tariff";
      statusEl.hidden = true;
      archiveButton.hidden = true;
      saveButton.textContent = strings.createLabel ?? "Create tariff";
      returnFocusTo = document.activeElement as HTMLElement;
      dialog.showModal();
      form.querySelector<HTMLInputElement>("#tariff-name")?.focus();
    }

    function openEdit(rule: TariffRule) {
      mode = "edit";
      resetForm();
      ruleIdField.value = rule.id;
      (form.elements.namedItem("name") as HTMLInputElement).value = rule.name;
      (form.elements.namedItem("nameEn") as HTMLInputElement).value =
        rule.nameEn ?? "";
      (form.elements.namedItem("nameRu") as HTMLInputElement).value =
        rule.nameRu ?? "";
      (form.elements.namedItem("code") as HTMLInputElement).value = rule.code;
      (form.elements.namedItem("description") as HTMLTextAreaElement).value =
        rule.description ?? "";
      calculationTypeSelect.value = rule.calculationType;
      (
        form.elements.namedItem("meterType") as unknown as HTMLSelectElement
      ).value = rule.meterType ?? "";
      (form.elements.namedItem("unit") as HTMLInputElement).value = rule.unit;
      (form.elements.namedItem("unitPrice") as HTMLInputElement).value =
        rule.unitPrice ?? "";
      (form.elements.namedItem("vatRate") as HTMLInputElement).value =
        rule.vatRate;
      (form.elements.namedItem("effectiveFrom") as HTMLInputElement).value =
        rule.effectiveFrom;
      (form.elements.namedItem("effectiveUntil") as HTMLInputElement).value =
        rule.effectiveUntil ?? "";
      (form.elements.namedItem("sortOrder") as HTMLInputElement).value = String(
        rule.sortOrder
      );
      (form.elements.namedItem("enabled") as HTMLInputElement).checked =
        rule.enabled;
      for (const radio of scopeRadios) {
        radio.checked = radio.value === rule.applicationScope;
      }
      if (rule.applicationScope === "ONE_TO_MANY") {
        for (const checkbox of dwellingCheckboxes) {
          checkbox.checked = rule.dwellingIds.includes(checkbox.value);
        }
      } else if (rule.applicationScope === "ONE_TO_ONE") {
        dwellingSingleSelect.value = rule.dwellingIds[0] ?? "";
      }
      updateMeterTypeVisibility();
      updateScopeVisibility();
      updateDwellingCount();

      titleEl.textContent = rule.name;
      statusEl.hidden = false;
      statusEl.dataset.tone = rule.enabled ? "success" : "neutral";
      statusEl.textContent = rule.enabled
        ? (strings.active ?? "Active")
        : (strings.disabled ?? "Disabled");
      archiveButton.hidden = false;
      saveButton.textContent = strings.saveLabel ?? "Save changes";
      returnFocusTo = document.activeElement as HTMLElement;
      dialog.showModal();
    }

    function closeDrawer() {
      if (!dialog.open) return;
      dialog.close();
      if (returnFocusTo && document.contains(returnFocusTo)) {
        returnFocusTo.focus();
      }
      returnFocusTo = null;
    }

    document.addEventListener(
      "click",
      (event) => {
        const trigger = (event.target as HTMLElement).closest<HTMLElement>(
          "[data-open-tariff-drawer]"
        );
        if (!trigger) return;
        if (trigger.dataset.openTariffDrawer === "create") {
          openCreate();
        } else {
          const rule = JSON.parse(trigger.dataset.rule || "{}") as TariffRule;
          openEdit(rule);
        }
      },
      { signal: controller.signal }
    );

    for (const closeTrigger of document.querySelectorAll<HTMLElement>(
      "[data-close-tariff-drawer]"
    )) {
      closeTrigger.addEventListener("click", () => closeDrawer(), {
        signal: controller.signal,
      });
    }
    dialog.addEventListener(
      "cancel",
      (event) => {
        event.preventDefault();
        closeDrawer();
      },
      { signal: controller.signal }
    );

    archiveButton.addEventListener(
      "click",
      () => {
        const archiveForm = document.querySelector<HTMLFormElement>(
          "#archive-tariff-form"
        )!;
        (
          archiveForm.querySelector(
            "#archive-tariff-ruleId"
          ) as HTMLInputElement
        ).value = ruleIdField.value;
        archiveForm.requestSubmit();
      },
      { signal: controller.signal }
    );

    form.addEventListener(
      "submit",
      async (event) => {
        event.preventDefault();
        const scope = scopeRadios.find((r) => r.checked)?.value ?? "ONE_TO_ALL";
        const fd = new FormData(form);
        fd.delete("dwellingIds");
        if (scope === "ONE_TO_MANY") {
          for (const checkbox of dwellingCheckboxes) {
            if (checkbox.checked) fd.append("dwellingIds", checkbox.value);
          }
        } else if (scope === "ONE_TO_ONE") {
          if (dwellingSingleSelect.value) {
            fd.append("dwellingIds", dwellingSingleSelect.value);
          }
        }
        // A checkbox omits itself from FormData entirely when unchecked --
        // z.coerce.boolean().optional() needs a present-but-empty value to
        // actually coerce to false; an absent key parses as undefined,
        // which updateRule then reads as "don't touch this column" (the
        // usual .optional() convention), silently failing to re-enable a
        // disabled rule's toggle.
        fd.set(
          "enabled",
          form.querySelector<HTMLInputElement>("#tariff-enabled")!.checked
            ? "1"
            : ""
        );

        saveButton.disabled = true;
        const originalLabel = saveButton.textContent;
        saveButton.textContent = strings.savingLabel ?? "Saving…";
        const { error } =
          mode === "create"
            ? await actions.billing.createRule(fd)
            : await actions.billing.updateRule(fd);
        saveButton.disabled = false;
        saveButton.textContent = originalLabel;

        if (error) {
          if (errorBanner) {
            errorBanner.textContent = isInputError(error)
              ? (Object.values(error.fields).flat()[0] ?? error.message)
              : error.message;
            errorBanner.hidden = false;
          }
          return;
        }
        closeDrawer();
        await navigate(window.location.pathname + window.location.search);
      },
      { signal: controller.signal }
    );

    updateMeterTypeVisibility();
    updateScopeVisibility();
    updateDwellingCount();

    return () => controller.abort();
  });
</script>

