---
import {
  translate,
  uiLocale,
  friendlyActionErrorMessage,
  formatTrimmed,
  formatDate,
  entityLabel,
  fill,
  plural,
  formatPeriod,
} from "../../../../../lib/ui/i18n";
import { errorTranslations } from "../../../../../lib/ui/error-translations";
import { unitLabel } from "../../../../../lib/ui/units";
import rulesDomain from "../../../../../domain/billing/rules.ts?raw";
import billingActions from "../../../../../actions/billing.ts?raw";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
const pluralRules = new Intl.PluralRules(locale);
function pluralStrings(key: string, one: string, other: string) {
  return Object.fromEntries(
    pluralRules.resolvedOptions().pluralCategories.map((category) => {
      const translated = t(`${other}|${category}`);
      const fallback = t(`${other}|other`);
      return [
        `${key}|${category}`,
        locale === "en"
          ? category === "one"
            ? one
            : other
          : translated !== `${other}|${category}`
            ? translated
            : fallback !== `${other}|other`
              ? fallback
              : t(other),
      ];
    })
  );
}
const errorMapJson = JSON.stringify(
  errorTranslations([rulesDomain, billingActions], locale, [
    "Enter a valid unit price, for example 0.35 or 12.50. Use up to 4 decimal places.",
    "Enter a valid VAT percentage, for example 21 or 21.5.",
  ])
).replace(/</g, "\\u003c");
const normalizeSearch = (value: string) =>
  value.normalize("NFD").replace(/\p{M}/gu, "").toLowerCase();
// Phase F (Billing configuration) - tariffs/rules settings (spec Section
// 9.2, 27, BILL-RULE-001/002/003).
import PageHeader from "../../../../../components/ui/PageHeader.astro";
import Icon from "../../../../../components/ui/Icon.astro";
import StatusBadge from "../../../../../components/ui/StatusBadge.astro";
import { orgLocalDateString } from "../../../../../lib/org-time";
import { listPeriods } from "../../../../../domain/periods/periods";
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import {
  ForbiddenError,
  requireOrganizationAccess,
} from "../../../../../domain/authorization/guards";

const organizationId = Astro.params.orgId!;
try {
  requireOrganizationAccess(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

import { actions } from "astro:actions";
import { getOrganization } from "../../../../../domain/organizations/organizations";
import {
  listRules,
  listRuleAssignmentsWithDwellingNumbers,
} from "../../../../../domain/billing/rules";
import { listDwellings } from "../../../../../domain/organizations/dwellings";
import { withRequestDb } from "../../../../../lib/db-request";

const createResult = Astro.getActionResult(actions.billing.createRule);
const updateResult = Astro.getActionResult(actions.billing.updateRule);
const archiveResult = Astro.getActionResult(actions.billing.archiveRule);

const base = `/admin/o/${organizationId}`;

const search = Astro.url.searchParams.get("search") ?? "";
const typeFilter = Astro.url.searchParams.get("type") ?? "";
const rawStatus = Astro.url.searchParams.get("status") ?? "";
// Same filter shape as the Dwellings list: a status select for live tariffs
// plus a separate "Show archived" box. Old ?status=ARCHIVED / ?status=all
// links (before the box existed) map onto the box.
const includeArchived =
  Astro.url.searchParams.get("includeArchived") === "1" ||
  rawStatus === "ARCHIVED" ||
  rawStatus === "all";
const statusFilter = ["ACTIVE", "DISABLED"].includes(rawStatus)
  ? rawStatus
  : "";
const { organization, allRules, assignmentsByRule, dwellingOptions, periods } =
  await withRequestDb(async (db) => ({
    organization: await getOrganization(db, organizationId),
    allRules: await listRules(db, organizationId, { includeArchived: true }),
    assignmentsByRule: await listRuleAssignmentsWithDwellingNumbers(
      db,
      organizationId
    ),
    dwellingOptions: await listDwellings(db, organizationId, { limit: 1000 }),
    periods: await listPeriods(db, organizationId),
  }));
const dwellingCollator = new Intl.Collator(locale, { numeric: true });
dwellingOptions.sort((a, b) => dwellingCollator.compare(a.number, b.number));
const openPeriods = periods
  .filter((p) => p.status === "OPEN" && !p.openingReadings)
  .map(({ id, year, month, startsOn, endsOn }) => ({
    id,
    year,
    month,
    startsOn,
    endsOn,
    label: formatPeriod(year, month, locale),
  }));
const today = orgLocalDateString(new Date(), organization.timezone);
const priceFormat = new Intl.NumberFormat(locale, {
  style: "currency",
  currency: organization.currency,
  minimumFractionDigits: 2,
  maximumFractionDigits: 4,
});
function matchesFilters(rule: RuleRow) {
  return (
    (!typeFilter || rule.calculationType === typeFilter) &&
    (rule.archivedAt
      ? includeArchived && !statusFilter
      : !statusFilter ||
        (statusFilter === "ACTIVE" ? rule.enabled : !rule.enabled)) &&
    (!search.trim() ||
      [rule.name, rule.code, rule.nameEn, rule.nameRu].some((value) =>
        normalizeSearch(value ?? "").includes(normalizeSearch(search.trim()))
      ))
  );
}
const filtered = allRules.filter(matchesFilters);
const hasFilters = !!(search || typeFilter || statusFilter || includeArchived);
const ruleStatus = (rule: RuleRow) =>
  rule.archivedAt ? "ARCHIVED" : rule.enabled ? "ACTIVE" : "DISABLED";

function appliesToSummary(rule: {
  applicationScope: string;
  id: string;
}): string {
  if (rule.applicationScope === "ONE_TO_ALL") return t("All dwellings");
  const targets = assignmentsByRule.get(rule.id) ?? [];
  if (targets.length === 0) return t("Not assigned yet");
  if (rule.applicationScope === "ONE_TO_ONE") {
    return `${t("Dwelling")} ${targets[0].number}`;
  }
  return `${targets.length} ${t("dwellings")}`;
}

type RuleRow = (typeof allRules)[number];

// Shared shape for both the row link's data-rule payload and the
// `?edit=<ruleId>` deep-link's auto-open payload -- one place defining what
// the client-side drawer needs, so the two entry points can never drift.
function ruleToDrawerJson(rule: RuleRow) {
  return {
    id: rule.id,
    name: rule.name,
    nameEn: rule.nameEn,
    nameRu: rule.nameRu,
    code: rule.code,
    description: rule.description,
    calculationType: rule.calculationType,
    meterType: rule.meterType,
    unit: rule.unit,
    unitPrice: rule.unitPrice,
    vatRate: rule.vatRate,
    unitPriceDisplay:
      rule.unitPrice === null ? "" : formatTrimmed(rule.unitPrice, locale, 2),
    vatRateDisplay: formatTrimmed(rule.vatRate, locale, 0),
    effectiveFrom: rule.effectiveFrom,
    effectiveUntil: rule.effectiveUntil,
    applicationScope: rule.applicationScope,
    sortOrder: rule.sortOrder,
    enabled: rule.enabled,
    archivedAt: rule.archivedAt,
    dwellingIds: (assignmentsByRule.get(rule.id) ?? []).map(
      (a) => a.dwellingId
    ),
  };
}

const editRuleId = Astro.url.searchParams.get("edit");
const editRule = allRules.find((r) => r.id === editRuleId);

const calculationTypes = [
  "FIXED",
  "AREA",
  "RESIDENT_COUNT",
  "METER_CONSUMPTION",
  "MANUAL_QUANTITY",
  "MANUAL_AMOUNT",
] as const;
const calculationTypeLabels: Record<string, string> = {
  FIXED: t("Fixed"),
  AREA: t("Area"),
  RESIDENT_COUNT: t("Resident count"),
  METER_CONSUMPTION: t("Meter consumption"),
  MANUAL_QUANTITY: t("Manual quantity"),
  MANUAL_AMOUNT: t("Manual amount"),
};
const unitOptions = [
  { value: "m3", label: "m³" },
  { value: "m2", label: "m²" },
  { value: "kWh", label: "kWh" },
  {
    value: "month",
    label: locale === "lv" ? "mēnesis" : locale === "ru" ? "месяц" : "month",
  },
  {
    value: "person",
    label: locale === "lv" ? "persona" : locale === "ru" ? "человек" : "person",
  },
  { value: "dwelling", label: t("Dwelling").toLowerCase() },
];
---

<AdminLayout
  title={t("Tariffs & rules")}
  organizationId={organizationId}
  organizationName={organization.name}
  breadcrumbs={[
    { label: t("Settings"), href: `/admin/o/${organizationId}/settings` },
    { label: t("Tariffs & rules") },
  ]}
>
  <div class="rules-page">
    <PageHeader
      title={t("Tariffs & rules")}
      description={t("The tariffs invoices are calculated from.")}
      display
    >
      <a href={`${base}/guide`} class="btn-secondary rules-help-link">
        <span class="rules-help-icon" aria-hidden="true">
          ?
        </span>
        {t("Need help?")}
      </a>
      <button
        type="button"
        class="btn-primary rules-create-link"
        data-open-tariff-drawer="create"
      >
        {t("New tariff")}
      </button>
    </PageHeader>

    {(createResult?.error || updateResult?.error || archiveResult?.error) && (
      <p class="notice notice-danger" role="alert">
        {friendlyActionErrorMessage(
          createResult?.error ?? updateResult?.error ?? archiveResult?.error,
          locale
        )}
      </p>
    )}

    <form method="GET" class="filter-bar" id="tariff-filters">
      <div>
        <label class="field-label" for="search">
          {t("Search")}
        </label>
        <input
          id="search"
          name="search"
          value={search}
          placeholder={t("Name or code")}
          autocomplete="off"
          class="mt-1"
        />
      </div>
      <div>
        <label class="field-label" for="type-filter">
          {t("Type")}
        </label>
        <select id="type-filter" name="type" class="mt-1">
          <option value="">{t("All types")}</option>
          {calculationTypes.map((type) => (
            <option value={type} selected={typeFilter === type}>
              {calculationTypeLabels[type]}
            </option>
          ))}
        </select>
      </div>
      <div>
        <label class="field-label" for="status-filter">
          {t("Status")}
        </label>
        <select id="status-filter" name="status" class="mt-1">
          <option value="">{t("All statuses")}</option>
          <option value="ACTIVE" selected={statusFilter === "ACTIVE"}>
            {t("Active")}
          </option>
          <option value="DISABLED" selected={statusFilter === "DISABLED"}>
            {t("Disabled")}
          </option>
        </select>
      </div>
      <label class="rules-archived-toggle">
        <input
          type="checkbox"
          id="archived-filter"
          name="includeArchived"
          value="1"
          checked={includeArchived}
        />
        {t("Show archived")}
      </label>
      <button type="submit" class="btn-secondary" data-apply-filters>
        {t("Apply")}
      </button>
    </form>
    <p id="tariff-results" class="text-body-sm text-muted" hidden={!hasFilters}>
      <span data-result-count>
        {fill(
          plural(
            locale,
            allRules.length,
            "Showing {shown} of {total} tariff",
            "Showing {shown} of {total} tariffs"
          ),
          {
            shown: filtered.length,
            total: allRules.length,
          }
        )}
      </span>
      <a href={Astro.url.pathname} class="btn-ghost btn-sm" data-clear-filters>
        {t("Clear filters")}
      </a>
    </p>
    <p
      id="tariff-announcer"
      class="sr-only"
      aria-live="polite"
      role="status"
    ></p>
    <p
      id="tariff-page-error"
      class="notice notice-danger"
      role="alert"
      tabindex="-1"
      hidden
    ></p>
    <p id="tariff-operation-status" role="status" hidden></p>
    <div class="table-wrap rules-table-wrap">
      <table class="rules-table w-full text-left text-sm">
        <caption class="sr-only">{t("Billing rules")}</caption>
        <thead>
          <tr>
            <th scope="col">{t("Tariff")}</th>
            <th scope="col">{t("Calculation")}</th>
            <th scope="col" class="text-right">
              {t("VAT")}
            </th>
            <th scope="col">{t("Valid")}</th>
            <th scope="col">{t("Applies to")}</th>
            <th scope="col">{t("Status")}</th>
            <th scope="col" class="text-right">
              {t("Actions")}
            </th>
          </tr>
        </thead>
        <tbody id="tariff-rows">
          {allRules.map((rule) => (
            <tr
              class="row-link"
              data-tariff-row
              data-rule-id={rule.id}
              data-search={normalizeSearch(
                [rule.name, rule.code, rule.nameEn, rule.nameRu].join(" ")
              )}
              data-type={rule.calculationType}
              data-status={ruleStatus(rule)}
              hidden={!matchesFilters(rule)}
            >
              <td class="tariff-name">
                <a
                  href={`?edit=${rule.id}`}
                  class="row-link-target hover:underline"
                  data-open-tariff-drawer="edit"
                  data-rule={JSON.stringify(ruleToDrawerJson(rule))}
                >
                  {rule.name}
                </a>
                <span class="tariff-code">{rule.code}</span>
              </td>
              <td class="tariff-calculation">
                {calculationTypeLabels[rule.calculationType]}
                {rule.calculationType === "METER_CONSUMPTION" &&
                  rule.meterType &&
                  ` · ${entityLabel(rule.meterType, locale)}`}
                <span class="tariff-secondary">
                  {rule.calculationType === "MANUAL_AMOUNT"
                    ? t("Amount set per period")
                    : `${priceFormat.format(Number(rule.unitPrice))} / ${unitLabel(rule.unit, locale)}`}
                </span>
              </td>
              <td class="tariff-vat text-right tabular-nums">
                {formatTrimmed(rule.vatRate, locale, 0)} %
              </td>
              <td class="tariff-validity">
                <span class="tariff-date-range">
                  {formatDate(rule.effectiveFrom, locale)} –{" "}
                  {rule.effectiveUntil
                    ? formatDate(rule.effectiveUntil, locale)
                    : t("ongoing")}
                </span>
                {rule.effectiveUntil && rule.effectiveUntil < today ? (
                  <span class="tariff-secondary">{t("Ended")}</span>
                ) : rule.effectiveFrom > today ? (
                  <span class="tariff-secondary">
                    {fill(t("Starts {date}"), {
                      date: formatDate(rule.effectiveFrom, locale),
                    })}
                  </span>
                ) : null}
              </td>
              <td class="tariff-scope text-muted">{appliesToSummary(rule)}</td>
              <td class="tariff-status">
                <StatusBadge status={ruleStatus(rule)} />
              </td>
              <td class="tariff-menu text-right">
                <details class="row-menu row-link-above">
                  <summary aria-label={`${t("More actions")}: ${rule.name}`}>
                    •••
                  </summary>
                  <div>
                    {!rule.archivedAt && (
                      <button
                        type="button"
                        data-rule-operation="toggle"
                        data-rule-enabled={rule.enabled ? "" : "1"}
                        data-rule-id={rule.id}
                        data-rule-name={rule.name}
                      >
                        {rule.enabled ? t("Turn off") : t("Turn on")}
                      </button>
                    )}
                    <button
                      type="button"
                      data-rule-operation={
                        rule.archivedAt ? "restore" : "archive"
                      }
                      data-rule-id={rule.id}
                      data-rule-name={rule.name}
                    >
                      {rule.archivedAt ? t("Restore") : t("Archive")}
                    </button>
                  </div>
                </details>
              </td>
            </tr>
          ))}
          <tr id="tariff-empty" hidden={filtered.length !== 0}>
            <td colspan="7" class="text-center text-muted">
              {t("No tariffs match these filters.")}{" "}
              <a
                href={Astro.url.pathname}
                class="btn-ghost btn-sm"
                data-clear-filters
              >
                {t("Clear filters")}
              </a>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <details class="disclosure max-w-2xl">
      <summary>{t("How tariffs work")}</summary>
      <div class="rules-help">
        <p>
          <strong>{t("Meter-based rules")}</strong>{" "}
          {t(
            "Tariffs define how charges are calculated for each billing period."
          )}{" "}
          {t(
            "Use meter consumption for utilities like water, heat, or electricity. Charges are calculated from the difference in meter readings."
          )}
        </p>
        <p>
          <strong>{t("Fixed rules")}</strong>{" "}
          {t(
            "Use fixed rules for regular charges like maintenance fees. The amount is the same each period (per unit)."
          )}
        </p>
        <p>
          <strong>{t("Effective periods")}</strong>{" "}
          {t(
            "Edit the existing tariff when its price changes. The effective dates determine which months use it; prepared and sent invoices keep their saved amounts."
          )}
        </p>
      </div>
    </details>
  </div>

  <dialog
    id="tariff-drawer"
    class="context-drawer tariff-drawer"
    aria-labelledby="tariff-drawer-title"
    data-deep-link-rule={
      editRule ? JSON.stringify(ruleToDrawerJson(editRule)) : ""
    }
    data-locale={locale}
    data-open-periods={JSON.stringify(openPeriods)}
    data-currency={organization.currency}
    data-strings={JSON.stringify({
      refreshError: t(
        "The tariff was saved, but the list could not be refreshed. Reload the page to see the latest tariffs."
      ),
      ...pluralStrings(
        "resultCount",
        "Showing {shown} of {total} tariff",
        "Showing {shown} of {total} tariffs"
      ),
      ...pluralStrings(
        "dwellingCount",
        "{n} dwelling selected",
        "{n} dwellings selected"
      ),
      archiveConfirm: t(
        "Archive {name}? It will no longer be used for new invoices."
      ),
      saved: t("Tariff saved"),
      created: t("Tariff created"),
      archived: t("Tariff archived"),
      restored: t("Tariff restored. It is disabled until you enable it."),
      turnedOff: t("«{name}» turned off."),
      turnedOn: t("«{name}» turned on."),
      undo: t("Undo"),
      archivedStatus: t("Archived"),
      priceWarning: t(
        "Saving changes what open months bill: {months}. Draft invoices there change when they are generated again; prepared and sent invoices do not change."
      ),
      createTitle: t("New tariff"),
      discardConfirm: t(
        "Discard unsaved changes? Your edits have not been saved."
      ),
      createLabel: t("Create tariff"),
      saveLabel: t("Save changes"),
      savingLabel: t("Saving…"),
      active: t("Active"),
      disabled: t("Disabled"),
      genericError: t("Something went wrong. Please try again."),
      withVat: t("With VAT: {amount}"),
    })}
  >
    <header class="context-drawer-header">
      <div class="context-drawer-heading">
        <div class="context-drawer-title-row">
          <h2 class="context-drawer-title" id="tariff-drawer-title"></h2>
          <span
            class="status-badge"
            id="tariff-drawer-status"
            data-tone="neutral"
            hidden
          ></span>
        </div>
      </div>
      <button
        type="button"
        class="icon-btn context-drawer-close"
        data-close-tariff-drawer
        aria-label={t("Close")}
      >
        <Icon name="x" size="sm" />
      </button>
    </header>
    <div class="context-drawer-body">
      <p
        class="notice notice-danger"
        role="alert"
        tabindex="-1"
        data-tariff-drawer-error
        hidden
      ></p>
      <form id="tariff-form" novalidate>
        <div>
          <label class="check-row">
            <input
              type="checkbox"
              id="tariff-enabled"
              name="enabled"
              value="1"
              aria-describedby="tariff-enabled-hint"
              checked
            />
            {t("Enabled")}
          </label>
          <p class="rule-field-hint" id="tariff-enabled-hint">
            {t("A tariff that is off is not added to invoices.")}
          </p>
        </div>
        <input type="hidden" name="organizationId" value={organizationId} />
        <input type="hidden" name="ruleId" id="tariff-ruleId" />

        <div class="rule-field-row">
          <div class="rule-field">
            <label for="tariff-name">{t("Name")} *</label>
            <input id="tariff-name" name="name" type="text" required />
          </div>
          <div class="rule-field">
            <label for="tariff-code">{t("Code")}</label>
            <input
              id="tariff-code"
              name="code"
              type="text"
              maxlength="50"
              required
              aria-describedby="tariff-code-hint"
            />
            <p id="tariff-code-readonly" class="font-mono" hidden></p>
            <p class="rule-field-hint" id="tariff-code-hint">
              {t(
                "Used to match invoice row styling. It cannot be changed after the tariff is created."
              )}
            </p>
          </div>
        </div>
        <div class="rule-field">
          <label for="tariff-description">{t("Description")}</label>
          <textarea
            id="tariff-description"
            name="description"
            class="drawer-textarea-box"
            rows="2"
          ></textarea>
        </div>

        <h3 class="drawer-section-heading">{t("Calculation")}</h3>
        <div class="rule-field-row">
          <div class="rule-field">
            <label for="tariff-calculationType">{t("Type")} *</label>
            <select id="tariff-calculationType" name="calculationType">
              {calculationTypes.map((type) => (
                <option value={type}>{calculationTypeLabels[type]}</option>
              ))}
            </select>
          </div>
          <div class="rule-field" data-meter-type-field>
            <label for="tariff-meterType">{t("Meter type")}</label>
            <select id="tariff-meterType" name="meterType">
              <option value="">{t("-- none --")}</option>
              <option value="COLD_WATER">{t("Cold water")}</option>
              <option value="HOT_WATER">{t("Hot water")}</option>
              <option value="ELECTRICITY">{t("Electricity")}</option>
              <option value="GAS">{t("Gas")}</option>
              <option value="HEAT">{t("Heat")}</option>
              <option value="OTHER">{t("Other")}</option>
            </select>
          </div>
          <div class="rule-field">
            <label for="tariff-unit">{t("Unit")} *</label>
            <input
              id="tariff-unit"
              name="unit"
              type="text"
              required
              list="tariff-unit-options"
              placeholder={unitOptions
                .slice(0, 4)
                .map(({ label }) => label)
                .join(", ")}
            />
            <datalist id="tariff-unit-options">
              {unitOptions.map(({ value, label }) => (
                <option value={value} label={label} />
              ))}
            </datalist>
          </div>

          <div class="rule-field" data-unit-price-field>
            <label for="tariff-unitPrice">{t("Unit price")} *</label>
            <input
              id="tariff-unitPrice"
              name="unitPrice"
              type="text"
              placeholder={locale === "en" ? "0.00" : "0,00"}
              inputmode="decimal"
              aria-describedby="tariff-price-hint"
            />
            <p class="rule-field-hint" id="tariff-price-hint">
              {t("A price of 0.00 is valid and will show on the invoice.")}
            </p>
          </div>
          <div class="rule-field">
            <label for="tariff-vatRate">{t("VAT %")}</label>
            <input
              id="tariff-vatRate"
              name="vatRate"
              type="text"
              value={formatTrimmed("21", locale, 0)}
              inputmode="decimal"
            />
          </div>
        </div>
        <p class="rule-field-hint tariff-gross" data-gross-preview hidden></p>

        <p
          class="notice notice-warning"
          data-price-warning
          role="status"
          hidden
        ></p>
        <h3 class="drawer-section-heading">{t("Applies to")}</h3>
        <div class="rule-field">
          <div
            class="tariff-scope-options"
            role="radiogroup"
            aria-label={t("Applies to")}
          >
            <label class="tariff-scope-option">
              <input
                type="radio"
                name="applicationScope"
                value="ONE_TO_ALL"
                checked
              />
              <span>
                <strong>{t("All dwellings")}</strong>
                <p>{t("Applies to every current and future dwelling.")}</p>
              </span>
            </label>
            <label class="tariff-scope-option">
              <input type="radio" name="applicationScope" value="ONE_TO_MANY" />
              <span>
                <strong>{t("Selected dwellings")}</strong>
                <p>
                  {t(
                    "Applies only to the dwellings you choose. New dwellings are not included automatically."
                  )}{" "}
                </p>
              </span>
            </label>
            <label class="tariff-scope-option">
              <input type="radio" name="applicationScope" value="ONE_TO_ONE" />
              <span>
                <strong>{t("One dwelling")}</strong>
                <p>{t("Applies to exactly one dwelling.")}</p>
              </span>
            </label>
          </div>
        </div>
        <div class="rule-field" data-scope-panel="ONE_TO_MANY" hidden>
          <label for="tariff-dwelling-search">{t("Search dwellings")}</label>
          <input
            id="tariff-dwelling-search"
            type="text"
            data-dwelling-search
            placeholder={t("Filter by dwelling number...")}
          />
          <div class="tariff-dwelling-actions">
            <button
              type="button"
              class="btn-secondary btn-sm"
              data-select-all-visible
            >
              {t("Select all visible")}
            </button>
            <button
              type="button"
              class="btn-secondary btn-sm"
              data-clear-selection
            >
              {t("Clear selection")}
            </button>
            <span data-dwelling-count-label>{t("0 dwellings selected")}</span>
          </div>
          <div class="tariff-dwelling-list" data-dwelling-checklist>
            {dwellingOptions.map((d) => (
              <label
                class="tariff-dwelling-row"
                data-dwelling-number={d.number.toLowerCase()}
              >
                <input type="checkbox" name="dwellingIds" value={d.id} />
                {t("Dwelling")} {d.number}
              </label>
            ))}
          </div>
        </div>
        <div class="rule-field" data-scope-panel="ONE_TO_ONE" hidden>
          <label for="tariff-dwelling-single">{t("Dwelling")} *</label>
          <select id="tariff-dwelling-single" name="dwellingIdSingle">
            <option value="">{t("-- select a dwelling --")}</option>
            {dwellingOptions.map((d) => (
              <option value={d.id}>
                {t("Dwelling")} {d.number}
              </option>
            ))}
          </select>
        </div>

        <h3 class="drawer-section-heading">{t("Validity")}</h3>
        <div class="rule-field-row">
          <div class="rule-field">
            <label for="tariff-effectiveFrom">{t("Effective from")} *</label>
            <input
              id="tariff-effectiveFrom"
              name="effectiveFrom"
              type="date"
              required
            />
          </div>
          <div class="rule-field">
            <label for="tariff-effectiveUntil">{t("Effective until")}</label>
            <input
              id="tariff-effectiveUntil"
              name="effectiveUntil"
              type="date"
              aria-describedby="tariff-until-hint"
            />
            <p class="rule-field-hint" id="tariff-until-hint">
              {t("Leave empty for ongoing.")}
            </p>
          </div>
        </div>

        <h3 class="drawer-section-heading">{t("On the invoice")}</h3>
        <div class="rule-field-row">
          <div class="rule-field">
            <label for="tariff-nameEn">{t("English invoice label")}</label>
            <input
              id="tariff-nameEn"
              name="nameEn"
              type="text"
              maxlength="200"
            />
          </div>
          <div class="rule-field">
            <label for="tariff-nameRu">{t("Russian invoice label")}</label>
            <input
              id="tariff-nameRu"
              name="nameRu"
              type="text"
              maxlength="200"
            />
          </div>
        </div>

        <div class="rule-field">
          <label for="tariff-sortOrder">{t("Order on the invoice")}</label>
          <input
            id="tariff-sortOrder"
            name="sortOrder"
            type="number"
            step="1"
            aria-describedby="tariff-order-hint"
          />
          <p class="field-hint" id="tariff-order-hint">
            {t("Lower numbers come first on the invoice.")}
          </p>
        </div>
      </form>
    </div>
    <footer class="context-drawer-footer">
      <button
        type="button"
        class="btn-secondary"
        id="tariff-drawer-archive"
        hidden
      >
        {t("Archive")}
      </button>
      <button
        type="button"
        class="btn-secondary"
        id="tariff-drawer-restore"
        hidden
      >
        {t("Restore")}
      </button>
      <button type="button" class="btn-secondary" data-close-tariff-drawer>
        {t("Close")}
      </button>
      <button
        type="submit"
        form="tariff-form"
        class="btn-primary"
        id="tariff-drawer-save"
      >
        {t("Save changes")}
      </button>
    </footer>
  </dialog>
</AdminLayout>

<script
  type="application/json"
  id="tariff-error-translations"
  set:html={errorMapJson}
/>
<script>
  import { actions, isInputError } from "astro:actions";
  import { onPageLoad } from "../../../../../lib/ui/page-lifecycle";
  import { unitLabel } from "../../../../../lib/ui/units";
  type UnitLocale = Parameters<typeof unitLabel>[1];

  const fill = (text: string, values: Record<string, string | number>) =>
    text.replace(/\{(\w+)\}/g, (match, key) =>
      key in values ? String(values[key]) : match
    );
  const normalizeSearch = (value: string) =>
    value.normalize("NFD").replace(/\p{M}/gu, "").toLowerCase();

  interface TariffRule {
    id: string;
    name: string;
    nameEn: string | null;
    nameRu: string | null;
    code: string;
    description: string | null;
    calculationType: string;
    meterType: string | null;
    unit: string;
    unitPrice: string | null;
    vatRate: string;
    unitPriceDisplay: string;
    vatRateDisplay: string;
    effectiveFrom: string;
    effectiveUntil: string | null;
    applicationScope: "ONE_TO_ALL" | "ONE_TO_MANY" | "ONE_TO_ONE";
    sortOrder: number;
    enabled: boolean;
    dwellingIds: string[];
    archivedAt: string | null;
  }

  onPageLoad(() => {
    const dialogEl =
      document.querySelector<HTMLDialogElement>("#tariff-drawer");
    const formEl = document.querySelector<HTMLFormElement>("#tariff-form");
    if (!dialogEl || !formEl) return;
    // Rebinding to a fresh const (rather than relying on control-flow
    // narrowing of the original binding) is required for TS to carry the
    // non-null type into the closures defined below -- same trick as
    // workbench-drawer.ts's dialogEl/dialog pair.
    const dialog = dialogEl;
    const form = formEl;
    const controller = new AbortController();
    const strings: Record<string, string> = JSON.parse(
      dialog.dataset.strings ?? "{}"
    );
    const errorMessages: Record<string, string> = JSON.parse(
      document.querySelector("#tariff-error-translations")?.textContent ?? "{}"
    );
    const pluralRules = new Intl.PluralRules(document.documentElement.lang);
    const numberFormat = new Intl.NumberFormat(document.documentElement.lang);

    const titleEl = document.querySelector<HTMLElement>(
      "#tariff-drawer-title"
    )!;
    const statusEl = document.querySelector<HTMLElement>(
      "#tariff-drawer-status"
    )!;
    const ruleIdField =
      document.querySelector<HTMLInputElement>("#tariff-ruleId")!;
    const archiveButton = document.querySelector<HTMLButtonElement>(
      "#tariff-drawer-archive"
    )!;
    const saveButton = document.querySelector<HTMLButtonElement>(
      "#tariff-drawer-save"
    )!;
    const errorBanner = document.querySelector<HTMLElement>(
      "[data-tariff-drawer-error]"
    );
    const meterTypeField = form.querySelector<HTMLElement>(
      "[data-meter-type-field]"
    )!;
    const unitPriceField = form.querySelector<HTMLElement>(
      "[data-unit-price-field]"
    )!;
    // Plain querySelector + cast, not querySelector<HTMLSelectElement>: the
    // generic overload's `T extends Element` constraint fails to resolve
    // for HTMLSelectElement under this project's workers-types/lib.dom.d.ts
    // collision (see invoice-template-editor.ts's identical workaround).
    const calculationTypeSelect = form.querySelector(
      "#tariff-calculationType"
    ) as unknown as HTMLSelectElement;
    const scopeRadios = [
      ...form.querySelectorAll<HTMLInputElement>(
        'input[name="applicationScope"]'
      ),
    ];
    const scopePanels = new Map(
      [...form.querySelectorAll<HTMLElement>("[data-scope-panel]")].map(
        (el) => [el.dataset.scopePanel, el]
      )
    );
    const dwellingChecklist = form.querySelector<HTMLElement>(
      "[data-dwelling-checklist]"
    )!;
    const dwellingCheckboxes = [
      ...dwellingChecklist.querySelectorAll<HTMLInputElement>(
        'input[name="dwellingIds"]'
      ),
    ];
    const dwellingSearch = form.querySelector<HTMLInputElement>(
      "[data-dwelling-search]"
    )!;
    const dwellingCountLabel = form.querySelector<HTMLElement>(
      "[data-dwelling-count-label]"
    )!;
    const dwellingSingleSelect = form.querySelector(
      "#tariff-dwelling-single"
    ) as unknown as HTMLSelectElement;

    const locale = dialog.dataset.locale;
    const openPeriods: {
      id: string;
      year: number;
      month: number;
      startsOn: string;
      endsOn: string;
      label: string;
    }[] = JSON.parse(dialog.dataset.openPeriods ?? "[]");
    const restoreButton = document.querySelector<HTMLButtonElement>(
      "#tariff-drawer-restore"
    )!;
    const codeInput = form.querySelector<HTMLInputElement>("#tariff-code")!;
    const codeText = form.querySelector<HTMLElement>("#tariff-code-readonly")!;
    const nameInput = form.querySelector<HTMLInputElement>("#tariff-name")!;
    const priceWarning = form.querySelector<HTMLElement>(
      "[data-price-warning]"
    )!;
    let loadedRule: TariffRule | null = null;
    let codeEdited = false;
    let busy = false;
    let mode: "create" | "edit" = "create";
    const searchInput = document.querySelector<HTMLInputElement>("#search")!;
    const filterForm =
      document.querySelector<HTMLFormElement>("#tariff-filters")!;
    const typeFilter = document.querySelector(
      "#type-filter"
    ) as unknown as HTMLSelectElement;
    const statusFilter = document.querySelector(
      "#status-filter"
    ) as unknown as HTMLSelectElement;
    const operationStatus = document.querySelector<HTMLElement>(
      "#tariff-operation-status"
    )!;
    let operationStatusTimer: ReturnType<typeof setTimeout> | undefined;
    function clearOperationStatus() {
      clearTimeout(operationStatusTimer);
      operationStatus.replaceChildren();
      operationStatus.hidden = true;
    }
    function showOperationStatus(message: string, undo?: () => void) {
      operationStatus.textContent = message;
      if (undo) {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "tariff-undo";
        button.textContent = strings.undo;
        button.onclick = undo;
        operationStatus.appendChild(document.createTextNode(" "));
        operationStatus.appendChild(button);
      }
      operationStatus.hidden = false;
      operationStatusTimer = setTimeout(clearOperationStatus, 10_000);
    }
    const archivedFilter =
      document.querySelector<HTMLInputElement>("#archived-filter")!;
    filterForm.querySelector<HTMLElement>("[data-apply-filters]")!.hidden =
      true;

    function applyFilters() {
      const query = normalizeSearch(searchInput.value.trim());
      const rows = [
        ...document.querySelectorAll<HTMLElement>("[data-tariff-row]"),
      ];
      let shown = 0;
      for (const row of rows) {
        const status = row.dataset.status;
        row.hidden = !!(
          (query &&
            !normalizeSearch(row.dataset.search ?? "").includes(query)) ||
          (typeFilter.value && row.dataset.type !== typeFilter.value) ||
          (status === "ARCHIVED"
            ? !archivedFilter.checked || statusFilter.value !== ""
            : statusFilter.value !== "" && status !== statusFilter.value)
        );
        if (!row.hidden) shown++;
      }
      const results = document.querySelector<HTMLElement>("#tariff-results")!;
      results.hidden = !(
        searchInput.value ||
        typeFilter.value ||
        statusFilter.value ||
        archivedFilter.checked
      );
      results.querySelector<HTMLElement>("[data-result-count]")!.textContent =
        fill(strings[`resultCount|${pluralRules.select(rows.length)}`], {
          shown,
          total: rows.length,
        });
      document.querySelector<HTMLElement>("#tariff-empty")!.hidden =
        shown !== 0;
      const url = new URL(location.href);
      for (const [key, value] of [
        ["search", searchInput.value],
        ["type", typeFilter.value],
        ["status", statusFilter.value],
        ["includeArchived", archivedFilter.checked ? "1" : ""],
      ]) {
        if (value) url.searchParams.set(key, value);
        else url.searchParams.delete(key);
      }
      url.searchParams.delete("edit");
      history.replaceState(null, "", url);
    }
    filterForm.addEventListener("input", applyFilters, {
      signal: controller.signal,
    });
    filterForm.addEventListener("change", applyFilters, {
      signal: controller.signal,
    });
    filterForm.addEventListener(
      "submit",
      (event) => {
        event.preventDefault();
        applyFilters();
      },
      { signal: controller.signal }
    );
    document.addEventListener(
      "click",
      (event) => {
        if (!(event.target as HTMLElement).closest("[data-clear-filters]"))
          return;
        event.preventDefault();
        searchInput.value = typeFilter.value = statusFilter.value = "";
        archivedFilter.checked = false;
        applyFilters();
        searchInput.focus();
      },
      { capture: true, signal: controller.signal }
    );
    searchInput.addEventListener(
      "keydown",
      (event) => {
        if (event.key !== "Escape" || !searchInput.value) return;
        event.preventDefault();
        searchInput.value = "";
        applyFilters();
      },
      { signal: controller.signal }
    );

    async function refreshRules(ruleId: string, message: string) {
      const url = new URL(location.href);
      url.searchParams.delete("edit");
      const response = await fetch(url);
      if (!response.ok) throw new Error(strings.refreshError);
      const html = new DOMParser().parseFromString(
        await response.text(),
        "text/html"
      );
      for (const selector of ["#tariff-rows", "#tariff-results"]) {
        const current = document.querySelector(selector);
        const next = html.querySelector(selector);
        if (!current || !next) throw new Error(strings.refreshError);
        current.replaceWith(next);
      }
      applyFilters();
      const row = document.querySelector<HTMLElement>(
        `[data-tariff-row][data-rule-id="${ruleId}"]`
      );
      if (row && !row.hidden) {
        row.querySelector<HTMLAnchorElement>(".row-link-target")?.focus();
        // Mark the changed row: a fading tint, or under reduced motion (where
        // global.css cuts every animation to 0.01ms) a tint that just goes.
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
          row.classList.add("row-changed-still");
          setTimeout(() => row.classList.remove("row-changed-still"), 1500);
        } else {
          row.classList.add("row-changed");
          row.addEventListener(
            "animationend",
            () => row.classList.remove("row-changed"),
            { once: true }
          );
        }
      } else searchInput.focus();
      document.querySelector<HTMLElement>("#tariff-announcer")!.textContent =
        message;
    }

    function clearErrors() {
      for (const error of form.querySelectorAll(".field-error")) error.remove();
      for (const field of form.querySelectorAll<HTMLElement>(
        '[aria-invalid="true"]'
      )) {
        field.removeAttribute("aria-invalid");
        const descriptions = (field.getAttribute("aria-describedby") ?? "")
          .split(" ")
          .filter((id) => !id.endsWith("-error"));
        if (descriptions.length)
          field.setAttribute("aria-describedby", descriptions.join(" "));
        else field.removeAttribute("aria-describedby");
      }
      if (errorBanner) errorBanner.hidden = true;
    }
    function showError(message: string) {
      if (!errorBanner) return;
      errorBanner.textContent = errorMessages[message] ?? message;
      errorBanner.hidden = false;
      dialog.querySelector<HTMLElement>(".context-drawer-body")!.scrollTop = 0;
      errorBanner.focus();
    }
    function showPageError(message: string) {
      const banner = document.querySelector<HTMLElement>("#tariff-page-error")!;
      banner.textContent = errorMessages[message] ?? message;
      banner.hidden = false;
      banner.focus();
    }
    function decimalValue(value: string) {
      return value
        .replace(/\s/g, "")
        .replace(
          locale === "en" ? /,/g : /,(?=\d)/g,
          locale === "en" ? "" : "."
        );
    }
    function updatePriceWarning() {
      const rule = loadedRule;
      const value = (name: string) =>
        (form.elements.namedItem(name) as HTMLInputElement).value;
      const changed =
        rule &&
        !rule.archivedAt &&
        (Number(decimalValue(value("unitPrice"))) !== Number(rule.unitPrice) ||
          Number(decimalValue(value("vatRate"))) !== Number(rule.vatRate) ||
          value("calculationType") !== rule.calculationType ||
          value("unit") !== rule.unit);
      const months = changed
        ? openPeriods.filter(
            (period) =>
              value("effectiveFrom") <= period.endsOn &&
              (!value("effectiveUntil") ||
                value("effectiveUntil") >= period.startsOn)
          )
        : [];
      priceWarning.hidden = months.length === 0;
      priceWarning.textContent = months.length
        ? fill(strings.priceWarning, {
            months: months.map((period) => period.label).join(", "),
          })
        : "";
    }
    nameInput.addEventListener(
      "input",
      () => {
        if (mode !== "create" || codeEdited) return;
        codeInput.value = nameInput.value
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .replace(/\p{Script=Cyrillic}/gu, "")
          .toUpperCase()
          .replace(/[^A-Z0-9]+/g, "_")
          .replace(/^_+|_+$/g, "")
          .slice(0, 50)
          .replace(/_+$/g, "");
      },
      { signal: controller.signal }
    );
    codeInput.addEventListener(
      "input",
      () => {
        codeEdited = true;
      },
      { signal: controller.signal }
    );
    form.addEventListener("input", updatePriceWarning, {
      signal: controller.signal,
    });
    form.addEventListener("change", updatePriceWarning, {
      signal: controller.signal,
    });
    let returnFocusTo: HTMLElement | null = null;
    // Form state right after the drawer opened; a differing snapshot on
    // close means unsaved edits.
    let openSnapshot = "";
    const snapshotForm = () =>
      JSON.stringify([...new FormData(form).entries()]);
    // Save is only offered once the form differs from how it opened.
    function updateSaveState() {
      if (!busy) saveButton.disabled = snapshotForm() === openSnapshot;
    }

    const grossPreview = form.querySelector<HTMLElement>(
      "[data-gross-preview]"
    )!;
    const moneyFormat = new Intl.NumberFormat(document.documentElement.lang, {
      style: "currency",
      currency: dialog.dataset.currency || "EUR",
      minimumFractionDigits: 2,
      maximumFractionDigits: 4,
    });
    // What a resident pays per unit; hidden until both numbers are valid.
    function updateGrossPreview() {
      const field = (name: string) =>
        (form.elements.namedItem(name) as HTMLInputElement).value.trim();
      const price = decimalValue(field("unitPrice"));
      const vat = decimalValue(field("vatRate")) || "0";
      const valid =
        calculationTypeSelect.value !== "MANUAL_AMOUNT" &&
        /^\d{1,10}(\.\d{1,4})?$/.test(price) &&
        /^\d{1,3}(\.\d{1,4})?$/.test(vat);
      grossPreview.hidden = !valid;
      if (!valid) return;
      const unit = unitLabel(field("unit"), (locale ?? "lv") as UnitLocale);
      grossPreview.textContent = fill(strings.withVat, {
        amount:
          moneyFormat.format(Number(price) * (1 + Number(vat) / 100)) +
          (unit ? ` / ${unit}` : ""),
      });
    }
    for (const type of ["input", "change"]) {
      form.addEventListener(
        type,
        () => {
          updateGrossPreview();
          updateSaveState();
        },
        { signal: controller.signal }
      );
    }

    const meterTypeSelect = form.querySelector(
      "#tariff-meterType"
    ) as unknown as HTMLSelectElement;
    const unitPriceInput =
      form.querySelector<HTMLInputElement>("#tariff-unitPrice")!;

    function updateMeterTypeVisibility() {
      const isMeter = calculationTypeSelect.value === "METER_CONSUMPTION";
      meterTypeField.hidden = !isMeter;
      // Hiding the field must also clear its value -- a hidden (but not
      // disabled) form control still submits, so a leftover meterType from
      // a previous METER_CONSUMPTION selection would otherwise be saved
      // alongside a FIXED/AREA/etc calculation type (wrong icon on the
      // list, and stale metadata on the row).
      if (!isMeter) meterTypeSelect.value = "";
      const isManualAmount = calculationTypeSelect.value === "MANUAL_AMOUNT";
      unitPriceField.hidden = isManualAmount;
      if (isManualAmount) unitPriceInput.value = "";
    }

    function updateDwellingCount() {
      const count = dwellingCheckboxes.filter((c) => c.checked).length;
      dwellingCountLabel.textContent = fill(
        strings[`dwellingCount|${pluralRules.select(count)}`],
        { n: numberFormat.format(count) }
      );
      // "Select all visible" / "Clear selection" change boxes without events.
      updateSaveState();
    }

    function updateScopeVisibility() {
      const selected =
        scopeRadios.find((r) => r.checked)?.value ?? "ONE_TO_ALL";
      for (const [key, panel] of scopePanels) {
        panel.hidden = key !== selected;
      }
    }

    for (const radio of scopeRadios) {
      radio.addEventListener("change", updateScopeVisibility, {
        signal: controller.signal,
      });
    }
    calculationTypeSelect.addEventListener(
      "change",
      updateMeterTypeVisibility,
      { signal: controller.signal }
    );
    for (const checkbox of dwellingCheckboxes) {
      checkbox.addEventListener("change", updateDwellingCount, {
        signal: controller.signal,
      });
    }
    dwellingSearch.addEventListener(
      "input",
      () => {
        const q = dwellingSearch.value.trim().toLowerCase();
        for (const row of dwellingChecklist.querySelectorAll<HTMLElement>(
          "[data-dwelling-number]"
        )) {
          row.hidden = q.length > 0 && !row.dataset.dwellingNumber?.includes(q);
        }
      },
      { signal: controller.signal }
    );
    form.querySelector("[data-select-all-visible]")?.addEventListener(
      "click",
      () => {
        for (const row of dwellingChecklist.querySelectorAll<HTMLElement>(
          "[data-dwelling-number]"
        )) {
          if (!row.hidden) {
            row.querySelector<HTMLInputElement>("input")!.checked = true;
          }
        }
        updateDwellingCount();
      },
      { signal: controller.signal }
    );
    form.querySelector("[data-clear-selection]")?.addEventListener(
      "click",
      () => {
        for (const checkbox of dwellingCheckboxes) checkbox.checked = false;
        updateDwellingCount();
      },
      { signal: controller.signal }
    );

    function resetForm() {
      for (const control of form.querySelectorAll<
        HTMLInputElement | HTMLButtonElement
      >("input, select, textarea, button"))
        control.disabled = false;
      form.reset();
      loadedRule = null;
      codeEdited = false;
      clearErrors();
      codeInput.hidden = false;
      codeText.hidden = true;
      restoreButton.hidden = true;
      saveButton.hidden = false;
      priceWarning.hidden = true;
      for (const checkbox of dwellingCheckboxes) checkbox.checked = false;
      updateMeterTypeVisibility();
      updateScopeVisibility();
      updateDwellingCount();
      if (errorBanner) errorBanner.hidden = true;
    }

    function openCreate() {
      if (busy) return;
      mode = "create";
      ruleIdField.value = "";
      resetForm();
      titleEl.textContent = strings.createTitle;
      statusEl.hidden = true;
      archiveButton.hidden = true;
      saveButton.textContent = strings.createLabel ?? "Create tariff";
      returnFocusTo = document.activeElement as HTMLElement;
      dialog.showModal();
      openSnapshot = snapshotForm();
      updateSaveState();
      updateGrossPreview();
      form.querySelector<HTMLInputElement>("#tariff-name")?.focus();
    }

    function openEdit(rule: TariffRule) {
      if (busy) return;
      mode = "edit";
      resetForm();
      loadedRule = rule;
      ruleIdField.value = rule.id;
      (form.elements.namedItem("name") as HTMLInputElement).value = rule.name;
      (form.elements.namedItem("nameEn") as HTMLInputElement).value =
        rule.nameEn ?? "";
      (form.elements.namedItem("nameRu") as HTMLInputElement).value =
        rule.nameRu ?? "";
      codeInput.value = rule.code;
      codeInput.hidden = true;
      codeInput.disabled = true;
      codeText.hidden = false;
      codeText.textContent = rule.code;
      (form.elements.namedItem("description") as HTMLTextAreaElement).value =
        rule.description ?? "";
      calculationTypeSelect.value = rule.calculationType;
      (
        form.elements.namedItem("meterType") as unknown as HTMLSelectElement
      ).value = rule.meterType ?? "";
      (form.elements.namedItem("unit") as HTMLInputElement).value = rule.unit;
      (form.elements.namedItem("unitPrice") as HTMLInputElement).value =
        rule.unitPriceDisplay;
      (form.elements.namedItem("vatRate") as HTMLInputElement).value =
        rule.vatRateDisplay;
      (form.elements.namedItem("effectiveFrom") as HTMLInputElement).value =
        rule.effectiveFrom;
      (form.elements.namedItem("effectiveUntil") as HTMLInputElement).value =
        rule.effectiveUntil ?? "";
      (form.elements.namedItem("sortOrder") as HTMLInputElement).value = String(
        rule.sortOrder
      );
      (form.elements.namedItem("enabled") as HTMLInputElement).checked =
        rule.enabled;
      for (const radio of scopeRadios) {
        radio.checked = radio.value === rule.applicationScope;
      }
      if (rule.applicationScope === "ONE_TO_MANY") {
        for (const checkbox of dwellingCheckboxes) {
          checkbox.checked = rule.dwellingIds.includes(checkbox.value);
        }
      } else if (rule.applicationScope === "ONE_TO_ONE") {
        dwellingSingleSelect.value = rule.dwellingIds[0] ?? "";
      }
      updateMeterTypeVisibility();
      updateScopeVisibility();
      updateDwellingCount();

      titleEl.textContent = rule.name;
      statusEl.hidden = false;
      // Same badge (icon, tone, label) as the tariff's row.
      const rowBadge = document.querySelector<HTMLElement>(
        `[data-tariff-row][data-rule-id="${rule.id}"] .status-badge`
      );
      if (rowBadge) {
        statusEl.innerHTML = rowBadge.innerHTML;
        statusEl.dataset.tone = rowBadge.dataset.tone ?? "neutral";
      } else {
        statusEl.dataset.tone = rule.enabled ? "success" : "neutral";
        statusEl.textContent = rule.archivedAt
          ? strings.archivedStatus
          : rule.enabled
            ? (strings.active ?? "Active")
            : (strings.disabled ?? "Disabled");
      }
      archiveButton.hidden = !!rule.archivedAt;
      restoreButton.hidden = !rule.archivedAt;
      saveButton.hidden = !!rule.archivedAt;
      if (rule.archivedAt) {
        for (const control of form.querySelectorAll<
          HTMLInputElement | HTMLButtonElement
        >("input, select, textarea, button"))
          control.disabled = true;
      }
      saveButton.textContent = strings.saveLabel ?? "Save changes";
      returnFocusTo = document.activeElement as HTMLElement;
      dialog.showModal();
      openSnapshot = snapshotForm();
      updateSaveState();
      updateGrossPreview();
    }

    // User-initiated close (X, Cancel, Esc): confirm before dropping edits.
    function requestClose() {
      if (busy) return;
      if (
        snapshotForm() !== openSnapshot &&
        !window.confirm(
          strings.discardConfirm ??
            "Discard unsaved changes? Your edits have not been saved."
        )
      )
        return;
      closeDrawer();
    }

    function closeDrawer() {
      if (!dialog.open) return;
      dialog.close();
      clearErrors();
      if (returnFocusTo && document.contains(returnFocusTo)) {
        returnFocusTo.focus();
      }
      returnFocusTo = null;
      // Deep-linked opens land on ?edit=<ruleId>; once closed, that id no
      // longer describes anything open, so drop it -- replaceState (not
      // pushState) so closing never creates its own extra Back stop, and
      // Back from here goes straight to wherever the deep link was
      // followed from (e.g. the dwelling page), not to a "closed" state.
      const url = new URL(window.location.href);
      if (url.searchParams.has("edit")) {
        url.searchParams.delete("edit");
        history.replaceState(null, "", url);
      }
    }

    document.addEventListener(
      "click",
      (event) => {
        const trigger = (event.target as HTMLElement).closest<HTMLElement>(
          "[data-open-tariff-drawer]"
        );
        if (!trigger) return;
        if (
          event instanceof MouseEvent &&
          (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey)
        )
          return;
        event.preventDefault();
        if (trigger.dataset.openTariffDrawer === "create") {
          openCreate();
        } else {
          const rule = JSON.parse(trigger.dataset.rule || "{}") as TariffRule;
          openEdit(rule);
          const url = new URL(location.href);
          url.searchParams.set("edit", rule.id);
          history.replaceState(null, "", url);
        }
      },
      { capture: true, signal: controller.signal }
    );

    for (const closeTrigger of document.querySelectorAll<HTMLElement>(
      "[data-close-tariff-drawer]"
    )) {
      closeTrigger.addEventListener("click", () => requestClose(), {
        signal: controller.signal,
      });
    }
    dialog.addEventListener(
      "cancel",
      (event) => {
        event.preventDefault();
        requestClose();
      },
      { signal: controller.signal }
    );

    async function operateRule(
      operation: "archive" | "restore",
      ruleId: string,
      name: string,
      button: HTMLButtonElement
    ) {
      if (
        busy ||
        (operation === "archive" &&
          !window.confirm(fill(strings.archiveConfirm, { name })))
      )
        return;
      clearOperationStatus();
      busy = true;
      button.disabled = true;
      document.querySelector<HTMLElement>("#tariff-page-error")!.hidden = true;
      const fd = new FormData();
      fd.set(
        "organizationId",
        (form.elements.namedItem("organizationId") as HTMLInputElement).value
      );
      fd.set("ruleId", ruleId);
      let saved = false;
      try {
        const result =
          operation === "archive"
            ? await actions.billing.archiveRule(fd)
            : await actions.billing.restoreRule(fd);
        if (result.error) {
          if (dialog.open) showError(result.error.message);
          else showPageError(result.error.message);
          return;
        }
        saved = true;
        closeDrawer();
        await refreshRules(
          ruleId,
          operation === "archive" ? strings.archived : strings.restored
        );
      } catch {
        const message = saved ? strings.refreshError : strings.genericError;
        if (dialog.open) showError(message);
        else showPageError(message);
      } finally {
        busy = false;
        button.disabled = false;
      }
    }
    async function toggleRule(
      ruleId: string,
      name: string,
      enabled: boolean,
      button: HTMLButtonElement,
      allowUndo = true
    ) {
      if (busy) return;
      clearOperationStatus();
      busy = true;
      button.disabled = true;
      const row = document.querySelector<HTMLElement>(
        `[data-tariff-row][data-rule-id="${ruleId}"]`
      );
      row?.setAttribute("aria-busy", "true");
      document.querySelector<HTMLElement>("#tariff-page-error")!.hidden = true;
      const fd = new FormData();
      fd.set(
        "organizationId",
        (form.elements.namedItem("organizationId") as HTMLInputElement).value
      );
      fd.set("ruleId", ruleId);
      fd.set("enabled", enabled ? "1" : "");
      let saved = false;
      try {
        const { error } = await actions.billing.setRuleEnabled(fd);
        if (error) {
          showPageError(error.message);
          return;
        }
        saved = true;
        const message = fill(enabled ? strings.turnedOn : strings.turnedOff, {
          name,
        });
        await refreshRules(ruleId, message);
        showOperationStatus(
          message,
          allowUndo
            ? () => {
                void toggleRule(
                  ruleId,
                  name,
                  !enabled,
                  operationStatus.querySelector("button") as HTMLButtonElement,
                  false
                );
              }
            : undefined
        );
      } catch {
        showPageError(saved ? strings.refreshError : strings.genericError);
      } finally {
        busy = false;
        button.disabled = false;
        row?.removeAttribute("aria-busy");
      }
    }
    archiveButton.addEventListener(
      "click",
      () => {
        if (loadedRule)
          void operateRule(
            "archive",
            loadedRule.id,
            loadedRule.name,
            archiveButton
          );
      },
      { signal: controller.signal }
    );
    restoreButton.addEventListener(
      "click",
      () => {
        if (loadedRule)
          void operateRule(
            "restore",
            loadedRule.id,
            loadedRule.name,
            restoreButton
          );
      },
      { signal: controller.signal }
    );
    document.addEventListener(
      "click",
      (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
          "[data-rule-operation]"
        );
        if (!button) return;
        const menu = button.closest("details");
        if (menu) menu.open = false;
        if (button.dataset.ruleOperation === "toggle") {
          void toggleRule(
            button.dataset.ruleId!,
            button.dataset.ruleName!,
            button.dataset.ruleEnabled === "1",
            button
          );
          return;
        }
        void operateRule(
          button.dataset.ruleOperation as "archive" | "restore",
          button.dataset.ruleId!,
          button.dataset.ruleName!,
          button
        );
      },
      { signal: controller.signal }
    );

    form.addEventListener(
      "submit",
      async (event) => {
        event.preventDefault();
        if (busy || loadedRule?.archivedAt) return;
        clearOperationStatus();
        clearErrors();
        document.querySelector<HTMLElement>("#tariff-page-error")!.hidden =
          true;
        const scope = scopeRadios.find((r) => r.checked)?.value ?? "ONE_TO_ALL";
        const fd = new FormData(form);
        fd.delete("dwellingIds");
        if (scope === "ONE_TO_MANY") {
          for (const checkbox of dwellingCheckboxes) {
            if (checkbox.checked) fd.append("dwellingIds", checkbox.value);
          }
        } else if (scope === "ONE_TO_ONE") {
          if (dwellingSingleSelect.value) {
            fd.append("dwellingIds", dwellingSingleSelect.value);
          }
        }
        // A checkbox omits itself from FormData entirely when unchecked --
        // z.coerce.boolean().optional() needs a present-but-empty value to
        // actually coerce to false; an absent key parses as undefined,
        // which updateRule then reads as "don't touch this column" (the
        // usual .optional() convention), silently failing to re-enable a
        // disabled rule's toggle.
        fd.set(
          "enabled",
          form.querySelector<HTMLInputElement>("#tariff-enabled")!.checked
            ? "1"
            : ""
        );

        for (const key of ["unitPrice", "vatRate"]) {
          const value = fd.get(key);
          if (typeof value === "string") fd.set(key, decimalValue(value));
        }
        busy = true;
        saveButton.disabled = true;
        const originalLabel = saveButton.textContent;
        saveButton.textContent = strings.savingLabel ?? "Saving…";
        let saved = false;
        try {
          const { data, error } =
            mode === "create"
              ? await actions.billing.createRule(fd)
              : await actions.billing.updateRule(fd);
          if (error) {
            if (isInputError(error)) {
              for (const [name, messages] of Object.entries(error.fields)) {
                const field = form.elements.namedItem(name);
                if (!(field instanceof HTMLElement) || !messages?.length)
                  continue;
                const paragraph = document.createElement("p");
                paragraph.className = "field-error";
                paragraph.id = `${field.id}-error`;
                paragraph.textContent = messages
                  .map((message) => errorMessages[message] ?? message)
                  .join(" ");
                field.setAttribute("aria-invalid", "true");
                field.setAttribute(
                  "aria-describedby",
                  [field.getAttribute("aria-describedby"), paragraph.id]
                    .filter(Boolean)
                    .join(" ")
                );
                field.insertAdjacentElement("afterend", paragraph);
              }
            }
            showError(
              isInputError(error)
                ? (Object.values(error.fields).flat()[0] ??
                    strings.genericError)
                : error.message
            );
            return;
          }
          saved = true;
          closeDrawer();
          await refreshRules(
            data?.id ?? String(fd.get("ruleId") ?? ""),
            mode === "create" ? strings.created : strings.saved
          );
        } catch {
          if (saved) showPageError(strings.refreshError);
          else showError(strings.genericError);
        } finally {
          busy = false;
          saveButton.textContent = originalLabel;
          updateSaveState();
        }
      },
      { signal: controller.signal }
    );

    updateMeterTypeVisibility();
    updateScopeVisibility();
    updateDwellingCount();

    // Deep link (?edit=<ruleId>, e.g. the dwelling page's "Edit tariff"
    // shortcut): the server already validated the id (belongs to this org,
    // including archived rules) and embedded its data on the dialog --
    // runs on every onPageLoad firing (direct load AND ClientRouter
    // navigation to this URL), so no separate one-time-init path is
    // needed. Nothing to do if the param was missing/invalid -- the
    // dataset is empty and the page just renders normally.
    const deepLinkRuleJson = dialog.dataset.deepLinkRule;
    if (deepLinkRuleJson) {
      openEdit(JSON.parse(deepLinkRuleJson) as TariffRule);
    }

    return () => {
      controller.abort();
      clearTimeout(operationStatusTimer);
    };
  });
</script>

