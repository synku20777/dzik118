---
import { translate, uiLocale } from "../../../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
// Phase D (Organizations/dwellings) - legal/bank/contact settings (spec
// Section 9.2, 27, ORG-002).
import PageHeader from "../../../../../components/ui/PageHeader.astro";
import FieldError from "../../../../../components/ui/FieldError.astro";
import Icon from "../../../../../components/ui/Icon.astro";
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import { actions } from "astro:actions";
import { z } from "astro/zod";
import { getOrganization } from "../../../../../domain/organizations/organizations";
import { friendlyActionErrorMessage } from "../../../../../lib/ui/i18n";
import { withRequestDb } from "../../../../../lib/db-request";
import { fieldErrorAttrs } from "../../../../../lib/ui/field-error-attrs";

const organizationId = Astro.params.orgId!;

const updateResult = Astro.getActionResult(actions.organizations.update);
const archiveResult =
  Astro.getActionResult(actions.organizations.archive) ??
  Astro.getActionResult(actions.organizations.restore);
const organization = await withRequestDb((db) =>
  getOrganization(db, organizationId)
);

const base = `/admin/o/${organizationId}`;
const settingsHref = `${base}/settings`;
const billingPeriod = z
  .uuid()
  .safeParse(Astro.url.searchParams.get("billingPeriod"));
const billingInvoice = z
  .uuid()
  .safeParse(Astro.url.searchParams.get("billingInvoice"));
const billingHref = billingPeriod.success
  ? `${base}/periods/${billingPeriod.data}` +
    (billingInvoice.success ? `/invoices/${billingInvoice.data}` : "")
  : null;
const updateAction = new URL(String(actions.organizations.update), Astro.url);
if (billingPeriod.success) {
  updateAction.searchParams.set("billingPeriod", billingPeriod.data);
  if (billingInvoice.success)
    updateAction.searchParams.set("billingInvoice", billingInvoice.data);
}
const cityLine = [organization.city, organization.postalCode]
  .filter(Boolean)
  .join(", ");
---

<AdminLayout
  title={`${t("Organization")} – ${organization.name}`}
  organizationId={organizationId}
  organizationName={organization.name}
  archived={!!organization.archivedAt}
  breadcrumbs={[
    { label: t("Settings"), href: `/admin/o/${organizationId}/settings` },
    { label: t("Organization") },
  ]}
>
  <div class="org-settings-page">
    <PageHeader
      title={t("Organization")}
      description={t(
        "Manage legal, contact, and bank details for this organization."
      )}
      display
    >
      {billingHref && (
        <a href={billingHref} data-astro-reload class="btn-secondary">
          {t(billingInvoice.success ? "Back to invoice" : "Back to the period")}
        </a>
      )}
      <a href={`${base}/guide`} class="btn-secondary">
        <Icon name="help-circle" size="sm" />
        {t("Need help?")}
      </a>
    </PageHeader>

    {updateResult?.error && (
      <p class="notice notice-danger" role="alert">
        {friendlyActionErrorMessage(updateResult.error, locale)}
      </p>
    )}
    {updateResult?.data && (
      <p class="notice" role="status">
        {t("Saved successfully.")}
      </p>
    )}

    <div class="org-settings-split">
      <form
        method="POST"
        action={updateAction.search}
        class="org-settings-form box"
      >
        <input type="hidden" name="organizationId" value={organizationId} />
        {
          // A form action reads a boolean field that is absent as false. These
          // toggles live on the billing settings page, so send their current
          // values or this form would switch them off.
          (
            [
              "autoGenerateEnabled",
              "autoSendEnabled",
              "carryForwardReadingsEnabled",
            ] as const
          ).map((name) => (
            <input
              type="hidden"
              name={name}
              value={String(organization[name])}
            />
          ))
        }

        <div class="org-info-banner notice">
          <span
            class="icon-tile icon-tile-sm"
            data-tone="info"
            aria-hidden="true"
          >
            <Icon name="info-circle" />
          </span>
          <p>
            {t(
              "Keep your organization details up to date to ensure correct invoicing and communication."
            )}
          </p>
        </div>

        <div class="org-settings-section">
          <h2>{t("Legal and contact details")}</h2>
          <p class="org-settings-section-desc">
            {t(
              "This information is used on invoices and for official communication."
            )}
          </p>

          <div class="org-field">
            <label class="field-label" for="name">
              {t("Name")}
            </label>
            <input
              id="name"
              name="name"
              value={organization.name}
              required
              {...fieldErrorAttrs(updateResult?.error, "name")}
            />
            <FieldError name="name" error={updateResult?.error} />
          </div>

          <div class="org-field-row">
            <div class="org-field">
              <label class="field-label" for="registrationNumber">
                {t("Registration number")}
              </label>
              <input
                id="registrationNumber"
                name="registrationNumber"
                value={organization.registrationNumber ?? ""}
                {...fieldErrorAttrs(updateResult?.error, "registrationNumber")}
              />
              <FieldError
                name="registrationNumber"
                error={updateResult?.error}
              />
            </div>
            <div class="org-field">
              <label class="field-label" for="vatNumber">
                {t("VAT number")}
              </label>
              <input
                id="vatNumber"
                name="vatNumber"
                value={organization.vatNumber ?? ""}
                {...fieldErrorAttrs(updateResult?.error, "vatNumber")}
              />
              <FieldError name="vatNumber" error={updateResult?.error} />
            </div>
          </div>
          <div class="org-field">
            <label class="field-label" for="addressLine1">
              {t("Address")}
            </label>
            <input
              id="addressLine1"
              name="addressLine1"
              value={organization.addressLine1}
              required
              {...fieldErrorAttrs(updateResult?.error, "addressLine1")}
            />
            <FieldError name="addressLine1" error={updateResult?.error} />
          </div>

          <div class="org-field-row">
            <div class="org-field">
              <label class="field-label" for="city">
                {t("City")}
              </label>
              <input
                id="city"
                name="city"
                value={organization.city ?? ""}
                {...fieldErrorAttrs(updateResult?.error, "city")}
              />
              <FieldError name="city" error={updateResult?.error} />
            </div>
            <div class="org-field">
              <label class="field-label" for="postalCode">
                {t("Postal code")}
              </label>
              <input
                id="postalCode"
                name="postalCode"
                value={organization.postalCode ?? ""}
                {...fieldErrorAttrs(updateResult?.error, "postalCode")}
              />
              <FieldError name="postalCode" error={updateResult?.error} />
            </div>
          </div>

          <div class="org-field-row">
            <div class="org-field">
              <label class="field-label" for="email">
                {t("Email")}
              </label>
              <div class="input-icon">
                <Icon name="mail" size="sm" />
                <input
                  spellcheck="false"
                  id="email"
                  name="email"
                  type="email"
                  value={organization.email ?? ""}
                  {...fieldErrorAttrs(updateResult?.error, "email")}
                />
              </div>
              <FieldError name="email" error={updateResult?.error} />
            </div>
            <div class="org-field">
              <label class="field-label" for="phone">
                {t("Phone")}
              </label>
              <input
                id="phone"
                name="phone"
                value={organization.phone ?? ""}
                {...fieldErrorAttrs(updateResult?.error, "phone")}
              />
              <FieldError name="phone" error={updateResult?.error} />
            </div>
          </div>
        </div>

        <div class="org-settings-section">
          <h2>{t("Bank details")}</h2>
          <p class="org-settings-section-desc">
            {t("This information is used for receiving payments.")}
          </p>

          <div class="org-field-row">
            <div class="org-field">
              <label class="field-label" for="bankName">
                {t("Bank name")}
              </label>
              <input
                id="bankName"
                name="bankName"
                value={organization.bankName ?? ""}
                {...fieldErrorAttrs(updateResult?.error, "bankName")}
              />
              <FieldError name="bankName" error={updateResult?.error} />
            </div>
            <div class="org-field">
              <label class="field-label" for="iban">
                IBAN
              </label>
              <div class="input-icon">
                <Icon name="building-bank" size="sm" />
                <input
                  spellcheck="false"
                  id="iban"
                  name="iban"
                  value={organization.iban ?? ""}
                  {...fieldErrorAttrs(updateResult?.error, "iban")}
                />
              </div>
              <FieldError name="iban" error={updateResult?.error} />
            </div>
          </div>

          <div class="org-field">
            <label class="field-label" for="bic">
              BIC
            </label>
            <input
              spellcheck="false"
              id="bic"
              name="bic"
              value={organization.bic ?? ""}
              {...fieldErrorAttrs(updateResult?.error, "bic")}
            />
            <FieldError name="bic" error={updateResult?.error} />
          </div>
        </div>

        <div class="org-settings-actions">
          <a href={settingsHref} class="btn-secondary">
            {t("Cancel")}
          </a>
          <button type="submit" class="btn-primary">
            {t("Save changes")}
          </button>
        </div>
      </form>

      <aside class="org-settings-sidebar">
        <div class="org-summary-card box">
          <div class="org-summary-head">
            <span class="icon-tile" aria-hidden="true">
              <Icon name="building" />
            </span>
            <div>
              <h2>{t("Organization summary")}</h2>
              <p>
                {t("This is how your organization details appear on invoices.")}
              </p>
            </div>
          </div>
          <dl class="org-summary-list">
            <div>
              <dt>{t("Name")}</dt>
              <dd>{organization.name}</dd>
            </div>
            <div>
              <dt>{t("Address")}</dt>
              <dd>
                {organization.addressLine1}
                {cityLine && (
                  <>
                    <br />
                    {cityLine}
                  </>
                )}
              </dd>
            </div>
            <div>
              <dt>{t("Registration number")}</dt>
              <dd>{organization.registrationNumber ?? "—"}</dd>
            </div>
            <div>
              <dt>{t("VAT number")}</dt>
              <dd>{organization.vatNumber ?? "—"}</dd>
            </div>
            <div>
              <dt>{t("Email")}</dt>
              <dd>{organization.email ?? "—"}</dd>
            </div>
            <div>
              <dt>{t("Phone")}</dt>
              <dd>{organization.phone ?? "—"}</dd>
            </div>
          </dl>
        </div>

        <div class="org-summary-card box">
          <h2>{t("Archive organization")}</h2>
          {archiveResult?.error && (
            <p class="notice notice-danger mt-3" role="alert">
              {friendlyActionErrorMessage(archiveResult.error, locale)}
            </p>
          )}
          {organization.archivedAt ? (
            <>
              <p class="mt-2 text-sm text-muted">
                {t(
                  "This organization is archived. Restore it to make changes and to let residents sign in again."
                )}
              </p>
              <form
                method="POST"
                action={actions.organizations.restore}
                class="mt-4"
              >
                <input
                  type="hidden"
                  name="organizationId"
                  value={organizationId}
                />
                <button type="submit" class="btn-primary">
                  {t("Restore organization")}
                </button>
              </form>
            </>
          ) : (
            <>
              <p class="mt-2 text-sm text-muted">
                {t(
                  "Archiving makes this organization read-only. Residents cannot sign in and their invoice links stop working. You can restore it later."
                )}
              </p>
              <form
                method="POST"
                action={actions.organizations.archive}
                class="mt-4 grid gap-3"
              >
                <input
                  type="hidden"
                  name="organizationId"
                  value={organizationId}
                />
                <div class="org-field">
                  <label class="field-label" for="archive-reason">
                    {t("Reason")}
                  </label>
                  <input
                    id="archive-reason"
                    name="reason"
                    maxlength="500"
                    required
                  />
                </div>
                <button
                  type="submit"
                  class="btn-secondary"
                  data-confirm-tone="danger"
                  data-confirm={t(
                    "Archive this organization? Residents cannot sign in until you restore it."
                  )}
                >
                  {t("Archive organization")}
                </button>
              </form>
            </>
          )}
        </div>

        <div class="org-tip-card notice">
          <span class="icon-tile" data-tone="info" aria-hidden="true">
            <Icon name="bulb" />
          </span>
          <div>
            <h3>{t("Good to know")}</h3>
            <p>
              {t(
                "Keep your details current so that invoices, payments, and official communication are processed without delays."
              )}
            </p>
          </div>
        </div>
      </aside>
    </div>
  </div>
</AdminLayout>

<style>
  .org-settings-page {
    display: grid;
    gap: 1.25rem;
  }
  .org-settings-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 320px);
    gap: 1.25rem;
    align-items: start;
  }
  .org-settings-form {
    display: grid;
    gap: 1.5rem;
  }
  .org-info-banner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .org-settings-section {
    display: grid;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }
  .org-settings-section:first-of-type {
    padding-top: 0;
    border-top: 0;
  }
  .org-settings-section h2 {
    font-size: var(--text-base);
    font-weight: 700;
  }
  .org-settings-section-desc {
    margin-top: -0.75rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .org-field-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  /* Border, radius, padding and the state fills come from the base layer. */
  .org-field input {
    width: 100%;
    font: inherit;
    font-size: var(--text-sm);
  }
  .org-settings-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }
  .org-settings-sidebar {
    display: grid;
    gap: 1.25rem;
  }
  .org-summary-head {
    display: flex;
    gap: 0.75rem;
  }
  .org-summary-head h2 {
    font-size: var(--text-base);
    font-weight: 700;
  }
  .org-summary-head p {
    margin-top: 0.25rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .org-summary-list {
    display: grid;
    gap: 1rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }
  .org-summary-list dt {
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: 600;
  }
  .org-summary-list dd {
    margin-top: 0.25rem;
    font-size: var(--text-sm);
    line-height: 1.45;
  }
  .org-tip-card {
    display: flex;
    gap: 0.75rem;
  }
  .org-tip-card h3 {
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .org-tip-card p {
    margin-top: 0.25rem;
  }

  @media (width < 48rem) {
    .org-settings-split {
      grid-template-columns: 1fr;
    }
  }
  @media (width < 40rem) {
    .org-field-row {
      grid-template-columns: 1fr;
    }
  }
</style>
