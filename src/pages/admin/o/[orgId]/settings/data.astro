---
import { translate, uiLocale } from "../../../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
// Phase D (Organizations/dwellings) / Phase K (Messaging/data) - data
// import/export index (spec Section 9.2, 11, 27 "Settings:
// data/import/export").
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import {
  ForbiddenError,
  requireOrganizationAccess,
} from "../../../../../domain/authorization/guards";

import { getOrganization } from "../../../../../domain/organizations/organizations";
import { withRequestDb } from "../../../../../lib/db-request";
const organizationId = Astro.params.orgId!;
try {
  requireOrganizationAccess(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}
const organization = await withRequestDb((db) =>
  getOrganization(db, organizationId)
);
---

<AdminLayout
  title="Data import/export"
  organizationId={organizationId}
  organizationName={organization.name}
>
  <a
    href={`/admin/o/${organizationId}/settings`}
    class="text-body-sm text-muted hover:underline"
  >
    ← {t("Settings")}
  </a>
  <h1 class="mt-4 text-h2 text-foreground">{t("Data")}</h1>
  <ul class="mt-6 grid gap-4 sm:grid-cols-2">
    <li>
      <a
        href={`/admin/o/${organizationId}/dwellings/import`}
        class="panel block p-5 font-medium text-primary hover:underline"
      >
        {t("Import dwellings (CSV)")}
      </a>
    </li>
    <li>
      <a
        href={`/api/v1/admin/o/${organizationId}/dwellings/export`}
        class="panel block p-5 font-medium text-primary hover:underline"
      >
        {t("Export dwellings (CSV)")}
      </a>
    </li>
    <li>
      <a
        href={`/api/v1/admin/o/${organizationId}/readings/export`}
        class="panel block p-5 font-medium text-primary hover:underline"
      >
        {t("Export meter readings (CSV)")}
      </a>
    </li>
    <li>
      <a
        href={`/admin/o/${organizationId}/payments/import`}
        class="panel block p-5 font-medium text-primary hover:underline"
      >
        {t("Import bank statement (CSV)")}
      </a>
    </li>
  </ul>
</AdminLayout>
