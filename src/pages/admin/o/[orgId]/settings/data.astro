---
// Phase D (Organizations/dwellings) - data import/export index (spec
// Section 9.2, 27 "Settings: data/import/export"). Dwelling CSV import/
// export is real (this phase); other data types arrive with the phases
// that own them.
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import {
  ForbiddenError,
  requireOrganizationAccess,
} from "../../../../../domain/authorization/guards";

const organizationId = Astro.params.orgId!;
try {
  requireOrganizationAccess(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}
---

<AdminLayout title="Data import/export" organizationId={organizationId}>
  <a
    href={`/admin/o/${organizationId}/settings`}
    class="text-sm text-neutral-600 hover:underline"
  >
    ← Settings
  </a>
  <h1 class="mt-4 text-xl font-bold text-neutral-900">Data</h1>
  <ul class="mt-4 space-y-3">
    <li>
      <a
        href={`/admin/o/${organizationId}/dwellings/import`}
        class="text-neutral-900 hover:underline"
      >
        Import dwellings (CSV)
      </a>
    </li>
    <li>
      <a
        href={`/api/v1/admin/o/${organizationId}/dwellings/export`}
        class="text-neutral-900 hover:underline"
      >
        Export dwellings (CSV)
      </a>
    </li>
  </ul>
  <p class="mt-6 text-sm text-neutral-500">
    Bank statement import and reading exports arrive with the phases that own
    them.
  </p>
</AdminLayout>
