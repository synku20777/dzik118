---
import { translate, uiLocale } from "../../../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
// Phase D (Organizations/dwellings) / Phase K (Messaging/data) - data
// import/export index (spec Section 9.2, 11, 27 "Settings:
// data/import/export").
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import PageHeader from "../../../../../components/ui/PageHeader.astro";
import Icon from "../../../../../components/ui/Icon.astro";
import type { IconName } from "../../../../../lib/ui/icons";

import { getOrganization } from "../../../../../domain/organizations/organizations";
import { withRequestDb } from "../../../../../lib/db-request";
const organizationId = Astro.params.orgId!;
const organization = await withRequestDb((db) =>
  getOrganization(db, organizationId)
);

const dataItems: Array<{ href: string; icon: IconName; label: string }> = [
  {
    href: `/admin/o/${organizationId}/migration`,
    icon: "database",
    label: "Migration Center",
  },
  {
    href: `/admin/o/${organizationId}/dwellings/import`,
    icon: "upload",
    label: "Import dwellings (CSV)",
  },
  {
    href: `/api/v1/admin/o/${organizationId}/dwellings/export`,
    icon: "download",
    label: "Export dwellings (CSV)",
  },
  {
    href: `/api/v1/admin/o/${organizationId}/readings/export`,
    icon: "download",
    label: "Export meter readings (CSV)",
  },
  {
    href: `/admin/o/${organizationId}/payments/import`,
    icon: "upload",
    label: "Import bank statement (CSV)",
  },
];
---

<AdminLayout
  title={t("Data")}
  organizationId={organizationId}
  organizationName={organization.name}
  breadcrumbs={[
    { label: t("Settings"), href: `/admin/o/${organizationId}/settings` },
    { label: t("Data") },
  ]}
>
  <div class="space-y-6">
    <PageHeader title={t("Data")} />
    <ul class="settings-grid">
      {dataItems.map((item) => (
        <li>
          <a href={item.href} class="settings-card box">
            <span class="icon-tile" aria-hidden="true">
              <Icon name={item.icon} />
            </span>
            <span class="settings-card-label">{t(item.label)}</span>
            <span class="settings-card-chevron" aria-hidden="true">
              <Icon name="chevron-right" size="sm" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</AdminLayout>

<style>
  .settings-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .settings-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--color-foreground);
    text-decoration: none;
  }
  .settings-card-label {
    min-width: 0;
    flex: 1 1 auto;
    font-size: var(--text-base);
    font-weight: 700;
  }
  .settings-card-chevron {
    flex: 0 0 auto;
    color: var(--color-muted);
    font-size: var(--text-xl);
  }
  .settings-card:hover .settings-card-chevron,
  .settings-card:focus-visible .settings-card-chevron {
    color: var(--color-foreground);
  }
  @media (prefers-reduced-motion: no-preference) {
    .settings-card-chevron {
      transition: color var(--duration-fast) var(--ease-standard);
    }
  }
  @media (width < 48rem) {
    .settings-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
