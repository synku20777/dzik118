---
// Phase D (Organizations/dwellings) - admin + resident access (spec Section
// 9.2, 27 "Settings: users/access"). Resident dwelling access is managed
// per-dwelling (dwellings/[dwellingId]), not repeated here, since access is
// dwelling-scoped, not organization-scoped (spec Section 8).
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import { actions } from "astro:actions";
import {
  ForbiddenError,
  requireOrganizationAccess,
} from "../../../../../domain/authorization/guards";
import {
  getOrganization,
  listAdminMembers,
} from "../../../../../domain/organizations/organizations";
import { withRequestDb } from "../../../../../lib/db-request";

const organizationId = Astro.params.orgId!;
try {
  requireOrganizationAccess(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const addResult = Astro.getActionResult(actions.organizations.addAdminMember);
const removeResult = Astro.getActionResult(
  actions.organizations.removeAdminMember
);

const { organization, members } = await withRequestDb(async (db) => ({
  organization: await getOrganization(db, organizationId),
  members: await listAdminMembers(db, organizationId),
}));

const currentUserId = Astro.locals.auth!.userId;
---

<AdminLayout
  title={`Users - ${organization.name}`}
  organizationId={organizationId}
  organizationName={organization.name}
>
  <div class="max-w-2xl space-y-6">
    <a
      href={`/admin/o/${organizationId}/settings`}
      class="text-sm text-neutral-600 hover:underline"
    >
      ← Settings
    </a>
    <h1 class="text-xl font-bold text-neutral-900">Admin users</h1>
    <p class="text-sm text-neutral-600">
      Resident access is assigned per dwelling, from each dwelling's detail
      page.
    </p>
    {
      (addResult?.error || removeResult?.error) && (
        <p class="rounded-md bg-red-50 p-3 text-sm text-red-800">
          {addResult?.error?.message ?? removeResult?.error?.message}
        </p>
      )
    }
    <div class="rounded-xl border border-neutral-200 bg-white p-6">
      <ul class="divide-y divide-neutral-100">
        {
          members.map((m) => (
            <li class="flex items-center justify-between py-2 text-sm">
              <span>
                {m.displayName ?? m.email}{" "}
                <span class="text-neutral-500">({m.email})</span>
              </span>
              {m.userId !== currentUserId && (
                <form
                  method="POST"
                  action={actions.organizations.removeAdminMember}
                >
                  <input
                    type="hidden"
                    name="organizationId"
                    value={organizationId}
                  />
                  <input type="hidden" name="userId" value={m.userId} />
                  <button type="submit" class="text-red-700 hover:underline">
                    Remove
                  </button>
                </form>
              )}
            </li>
          ))
        }
      </ul>
      <form
        method="POST"
        action={actions.organizations.addAdminMember}
        class="mt-4 flex gap-2"
      >
        <input type="hidden" name="organizationId" value={organizationId} />
        <input
          name="email"
          type="email"
          required
          placeholder="admin@example.com"
          class="flex-1 rounded-md border border-neutral-300 px-3 py-2 text-sm"
        />
        <button
          type="submit"
          class="rounded-md bg-neutral-900 px-4 py-2 text-sm font-medium text-white"
        >
          Add admin
        </button>
      </form>
    </div>
  </div>
</AdminLayout>
