---
// Phase G (Invoices/delivery) - invoice template editor (spec Section 22,
// 27 "invoice template"). A visual, document-style editor rather than a
// plain settings form: the admin controls which invoice sections appear,
// their order, per-row visibility/emphasis, spacing, and custom text
// blocks, with a live preview that reuses the exact same renderer the real
// PDF/portal pages use (src/domain/billing/invoice-html.ts) -- see
// src/lib/ui/invoice-template-editor.ts for the client-side half.
import { translate, uiLocale, formatPeriod } from "../../../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
import PageHeader from "../../../../../components/ui/PageHeader.astro";
import Icon from "../../../../../components/ui/Icon.astro";
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import { actions } from "astro:actions";
import {
  ForbiddenError,
  requireOrganizationAccess,
} from "../../../../../domain/authorization/guards";
import { getOrganization } from "../../../../../domain/organizations/organizations";
import { getResolvedInvoiceTemplate } from "../../../../../domain/billing/invoice-templates";
import { getEffectiveRules } from "../../../../../domain/billing/rules";
import {
  getCurrentOpenPeriod,
  listPeriods,
} from "../../../../../domain/periods/periods";
import {
  buildPreviewLines,
  buildPreviewTotals,
  previewPeriodDateRange,
  resolvePreviewPeriod,
} from "../../../../../domain/billing/invoice-template-preview";
import type { InvoiceHtmlInvoice } from "../../../../../domain/billing/invoice-html";
import { withRequestDb } from "../../../../../lib/db-request";

const organizationId = Astro.params.orgId!;
try {
  requireOrganizationAccess(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const updateResult = Astro.getActionResult(actions.invoiceTemplates.update);
const requestedPeriodId = Astro.url.searchParams.get("previewPeriodId");

const { organization, template, periods, previewPeriod, sampleLines } =
  await withRequestDb(async (db) => {
    const periods = await listPeriods(db, organizationId);
    const currentOpenPeriod = await getCurrentOpenPeriod(db, organizationId);
    const previewPeriod = resolvePreviewPeriod({
      periods,
      requestedPeriodId,
      currentOpenPeriod,
    });
    const rules = await getEffectiveRules(
      db,
      organizationId,
      previewPeriodDateRange(previewPeriod)
    );
    return {
      organization: await getOrganization(db, organizationId),
      template: await getResolvedInvoiceTemplate(db, organizationId),
      periods,
      previewPeriod,
      sampleLines: buildPreviewLines(rules),
    };
  });

const base = `/admin/o/${organizationId}`;

const periodOptions = periods.map((p) => ({
  id: p.id,
  label: formatPeriod(p.year, p.month, locale),
}));
const previewTotals = buildPreviewTotals(sampleLines);

// Deterministic sample invoice for the preview -- issuer/payment come from
// the organization's real settings (so payment details in the preview
// match what a real invoice would show), the recipient is a clearly
// illustrative placeholder, and the charges/totals are derived from the
// live effective-rules-driven sampleLines above, never hardcoded.
const sampleInvoice: InvoiceHtmlInvoice = {
  invoiceNumber: "INV-SAMPLE-00001",
  issueDate: previewPeriod?.invoiceIssueDate ?? "2026-01-01",
  dueDate: previewPeriod?.invoiceDueDate ?? "2026-01-15",
  currency: organization.currency,
  subtotal: previewTotals.subtotal,
  vatTotal: previewTotals.vatTotal,
  currentCharges: previewTotals.currentCharges,
  previousOutstanding: "0.00",
  previousCreditApplied: "0.00",
  lateFeeApplied: "0.00",
  manualAdjustment: "0.00",
  amountDue: previewTotals.currentCharges,
  issuerSnapshot: {
    name: organization.name,
    addressLine1: organization.addressLine1,
    addressLine2: organization.addressLine2,
    city: organization.city,
    postalCode: organization.postalCode,
  },
  recipientSnapshot: {
    billingName: t("Sample resident"),
    dwellingNumber: "1",
    billingAddress: t("Sample Street 1, Riga, LV-1010"),
  },
  paymentSnapshot: {
    bankName: organization.bankName,
    iban: organization.iban,
    bic: organization.bic,
    currency: organization.currency,
  },
  templateSnapshot: null,
};

const bootstrap = {
  headerText: template.headerText,
  footerText: template.footerText,
  paymentInstructions: template.paymentInstructions,
  defaultNote: template.defaultNote,
  config: template.config,
  sampleInvoice,
  sampleLines,
  strings: {
    "Template structure": t("Template structure"),
    "Live preview": t("Live preview"),
    "Line items": t("Line items"),
    "Zoom level": t("Zoom level"),
    "Expand section": t("Expand section"),
    "Collapse section": t("Collapse section"),
    "More options": t("More options"),
    "Invoice details": t("Invoice details"),
    "Sender and recipient": t("Sender and recipient"),
    "Charges table": t("Charges table"),
    "Payment details": t("Payment details"),
    "Default note": t("Default note"),
    Footer: t("Footer"),
    "Custom text": t("Custom text"),
    Show: t("Show"),
    Bold: t("Bold"),
    Spacing: t("Spacing"),
    Align: t("Align"),
    "Move up": t("Move up"),
    "Move down": t("Move down"),
    Duplicate: t("Duplicate"),
    Delete: t("Delete"),
    "Save changes": t("Save changes"),
    "Saving…": t("Saving…"),
    Undo: t("Undo"),
    Edit: t("Edit"),
    Preview: t("Preview"),
    None: t("None"),
    Small: t("Small"),
    Medium: t("Medium"),
    Large: t("Large"),
    "Extra large": t("Extra large"),
    Left: t("Left"),
    Center: t("Center"),
    Right: t("Right"),
    "Fit to width": t("Fit to width"),
    "Unsaved changes": t("Unsaved changes"),
    "Discard changes": t("Discard changes"),
    "Template saved.": t("Template saved."),
    "Could not save the template. Your changes are still here.": t(
      "Could not save the template. Your changes are still here."
    ),
    "Could not load the sample charges. Try again.": t(
      "Could not load the sample charges. Try again."
    ),
    "Discard unsaved changes? Your edits have not been saved.": t(
      "Discard unsaved changes? Your edits have not been saved."
    ),
    "Without translation: {n}": t("Without translation: {n}"),
    "An empty field uses the Latvian text.": t(
      "An empty field uses the Latvian text."
    ),
    "Latvian is the main invoice language.": t(
      "Latvian is the main invoice language."
    ),
    "Layout reset to the default.": t("Layout reset to the default."),
    "Reset undone.": t("Reset undone."),
    "This invoice layout has reached the maximum of 30 sections.": t(
      "This invoice layout has reached the maximum of 30 sections."
    ),
  },
};
---

<AdminLayout
  title={`${t("Invoice template")} - ${organization.name}`}
  organizationId={organizationId}
  organizationName={organization.name}
  breadcrumbs={[
    { label: t("Settings"), href: `/admin/o/${organizationId}/settings` },
    { label: t("Invoice template") },
  ]}
>
  <div class="space-y-6">
    <PageHeader
      title={t("Invoice template")}
      description={t(
        "Control what appears on generated invoices, in what order, and how each section looks."
      )}
      display
    >
      <a href={`${base}/guide`} class="btn-secondary settings-help">
        <span class="settings-help-icon" aria-hidden="true">
          ?
        </span>
        {t("Need help?")}
      </a>
    </PageHeader>

    {/* Without JavaScript the editor cannot run at all (the section list and
        the preview are built by the script), so these two notices only show
        the result of a plain form post. */}
    {updateResult?.error && (
      <p class="notice notice-danger" role="alert">
        {updateResult.error.message}
      </p>
    )}
    {updateResult?.data && (
      <p class="notice" role="status">
        {t("Saved successfully.")}
      </p>
    )}

    <form
      method="POST"
      action={actions.invoiceTemplates.update}
      id="template-editor-form"
    >
      <input type="hidden" name="organizationId" value={organizationId} />
      <input type="hidden" name="headerText" />
      <input type="hidden" name="footerText" />
      <input type="hidden" name="paymentInstructions" />
      <input type="hidden" name="defaultNote" />
      <input type="hidden" name="config" />

      <div id="template-editor" class="tpl-editor" data-view="edit">
        <script
          is:inline
          type="application/json"
          id="template-editor-bootstrap"
          set:html={JSON.stringify(bootstrap).replace(/</g, "\u003c")}
        />
        <div class="tpl-toolbar">
          <fieldset class="tpl-lang">
            <legend class="sr-only">{t("Editing language")}</legend>
            {[
              ["lv", "Latviešu"],
              ["en", "English"],
              ["ru", "Русский"],
            ].map(([code, name]) => (
              <label class="tpl-lang-option" lang={code}>
                <input
                  type="radio"
                  name="tpl-locale"
                  value={code}
                  checked={code === "lv"}
                />
                <span>{name}</span>
                <span class="tpl-lang-missing" data-missing-for={code} hidden />
              </label>
            ))}
          </fieldset>
          <p id="tpl-lang-hint" class="tpl-lang-hint" aria-live="polite"></p>
          <div
            class="tpl-view-switch"
            role="group"
            aria-label={t("Editor view")}
          >
            <button type="button" data-tpl-view="edit" aria-pressed="true">
              {t("Edit")}
            </button>
            <button type="button" data-tpl-view="preview" aria-pressed="false">
              {t("Preview")}
            </button>
          </div>
        </div>

        <div class="tpl-editor-layout">
          <section class="tpl-editor-column tpl-structure-column">
            <h2 class="tpl-column-title">{t("Template structure")}</h2>

            <div class="tpl-editor-toolbar">
              <button
                type="button"
                id="tpl-add-text"
                class="btn-secondary btn-sm"
              >
                <Icon name="plus" size="sm" />
                <span>{t("Add text block")}</span>
              </button>
              <button
                type="button"
                id="tpl-reset-layout"
                class="btn-secondary btn-sm"
              >
                {t("Reset layout")}
              </button>
            </div>
            <p id="tpl-status" class="tpl-status" role="status" hidden></p>

            <ul
              id="tpl-blocks"
              class="tpl-blocks"
              aria-label={t("Invoice sections")}
            ></ul>
          </section>

          <section class="tpl-editor-column tpl-preview-column">
            <div class="tpl-column-header tpl-preview-header">
              <div>
                <h2 class="tpl-column-title">{t("Live preview")}</h2>
                <p class="tpl-column-subtitle">
                  {t("Quantities are illustrative (always 1).")}
                </p>
              </div>
              <div class="tpl-preview-controls">
                {periodOptions.length > 0 ? (
                  <label class="tpl-period" for="tpl-preview-period">
                    <span>{t("Sample charges for")}</span>
                    <select id="tpl-preview-period" class="tpl-zoom-select">
                      {periodOptions.map((p) => (
                        <option
                          value={p.id}
                          selected={p.id === previewPeriod?.id}
                        >
                          {p.label}
                        </option>
                      ))}
                    </select>
                  </label>
                ) : null}
                <select
                  id="tpl-zoom-select"
                  class="tpl-zoom-select"
                  aria-label={t("Zoom level")}
                >
                  <option value="fit" selected>
                    {t("Fit to width")}
                  </option>
                  <option value="1">100%</option>
                  <option value="1.25">125%</option>
                </select>
              </div>
            </div>
            {periodOptions.length === 0 && (
              <p class="tpl-period-note">
                {t("No billing periods yet — showing tariffs effective today.")}
              </p>
            )}
            <p
              id="tpl-period-error"
              class="notice notice-danger"
              role="alert"
              hidden
            ></p>

            <div id="tpl-preview-container" class="tpl-editor-canvas">
              <div id="tpl-preview-zoom-wrap" class="tpl-preview-zoom-wrap">
                <iframe
                  id="tpl-preview"
                  class="tpl-preview"
                  title={t("Invoice preview")}
                ></iframe>
              </div>
            </div>
          </section>
        </div>

        <div id="tpl-savebar" class="tpl-savebar" hidden>
          <p id="tpl-savebar-text" class="tpl-savebar-text" role="status"></p>
          <button type="button" id="tpl-discard" class="btn-secondary">
            {t("Discard changes")}
          </button>
          <button type="submit" id="tpl-save" class="btn-primary">
            {t("Save changes")}
          </button>
        </div>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  import "../../../../../lib/ui/invoice-template-editor";
</script>

<style is:global>
  /* is:global, not Astro's default scoped style: almost everything below
     (.tpl-block, .tpl-toggle, .tpl-popover, etc.) is created client-side
     by invoice-template-editor.ts via document.createElement, which never
     receives Astro's scoping attribute -- a scoped style would silently
     fail to match any of it. Same reasoning as
     src/components/ui/AdminContextDrawer.astro's own is:global, which has
     the identical DOM-API-built-content shape. Every selector below uses
     this page's own tpl- prefix, so there is no collision risk with other
     pages' global styles. */
  .tpl-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-bottom: 1rem;
  }
  /* Segmented control, built like the sidebar's language switch. */
  .tpl-lang {
    display: inline-flex;
    min-width: 0;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: var(--radius-control);
    background: var(--color-surface);
    box-shadow: 0 0 0 1px var(--color-border);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .tpl-lang-option {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: var(--control-size-md);
    padding-inline: var(--space-4);
    color: var(--color-muted);
    cursor: pointer;
  }
  .tpl-lang-option + .tpl-lang-option {
    border-left: 1px solid var(--color-border);
  }
  .tpl-lang-option input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .tpl-lang-option:hover {
    background: var(--color-hover);
    color: var(--color-foreground);
  }
  .tpl-lang-option:has(input:checked) {
    background: var(--color-nav-active-bg);
    color: var(--color-primary);
  }
  .tpl-lang-option:has(input:focus-visible) {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: -3px;
  }
  .tpl-lang-missing {
    color: var(--color-muted);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .tpl-lang-hint {
    flex: 1 1 14rem;
    min-width: 0;
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .tpl-view-switch {
    display: none;
  }
  .tpl-editor-layout {
    display: grid;
    grid-template-columns: minmax(0, 24rem) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }
  .tpl-column-header {
    margin-bottom: 0.75rem;
  }
  .tpl-column-title {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-foreground);
  }
  .tpl-structure-column .tpl-column-title {
    margin-bottom: 0.75rem;
  }
  .tpl-column-subtitle {
    margin: 0.25rem 0 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .tpl-preview-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem 1rem;
  }
  .tpl-preview-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }
  .tpl-period {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .tpl-period-note {
    margin: 0 0 0.75rem;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .tpl-zoom-select {
    padding: 0.25rem 2.25rem 0.25rem 0.5rem;
    font-size: var(--text-sm);
    font-weight: 500;
    border-radius: var(--radius-control);
    background-color: var(--color-surface);
    color: var(--color-foreground);
    cursor: pointer;
  }
  .tpl-zoom-select:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  .tpl-editor-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .tpl-editor-toolbar button {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .tpl-status {
    margin: 0 0 0.75rem;
    font-size: var(--text-sm);
  }
  .tpl-undo {
    min-height: 1.5rem;
    padding-inline: var(--space-2);
    color: var(--color-primary);
    text-decoration: underline;
  }
  .tpl-blocks {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tpl-block {
    display: flex;
    flex-direction: column;
    border: var(--panel-border);
    border-radius: var(--radius-panel);
    background: var(--color-surface);
  }
  .tpl-block-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 0.75rem;
    border-radius: var(--radius-panel);
    cursor: pointer;
    user-select: none;
  }
  .tpl-block-header:hover {
    background: var(--color-hover);
  }
  .tpl-drag-handle {
    flex: 0 0 auto;
    cursor: grab;
    color: var(--color-muted);
    padding: 0.125rem 0.25rem;
    user-select: none;
  }
  .tpl-drag-handle:active {
    cursor: grabbing;
  }
  .tpl-block-num {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-muted);
    flex: 0 0 auto;
  }
  .tpl-block-name {
    flex: 1 1 auto;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-foreground);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tpl-block-header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 0 0 auto;
    margin-left: auto;
  }
  .tpl-accordion-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    padding: 0.25rem;
    color: var(--color-muted);
    cursor: pointer;
    border-radius: var(--radius-control);
    flex: 0 0 auto;
  }
  .tpl-accordion-btn:hover {
    color: var(--color-foreground);
    background: var(--color-hover);
  }
  .tpl-chevron-icon {
    transition: transform 0.2s ease;
  }
  .tpl-accordion-btn[aria-expanded="true"] .tpl-chevron-icon {
    transform: rotate(90deg);
  }
  .tpl-block-detail {
    padding: 0 0.75rem 0.75rem;
    border-top: 1px solid var(--color-border);
  }
  .tpl-block-detail[hidden] {
    display: none !important;
  }
  .tpl-field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 0.75rem;
  }
  .tpl-field label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-foreground);
  }
  .tpl-input,
  .tpl-select {
    width: 100%;
    padding: 0.4rem 0.5rem;
    border-radius: var(--radius-control);
    background-color: var(--color-surface);
    color: var(--color-foreground);
    font: inherit;
    font-size: var(--text-sm);
    box-sizing: border-box;
  }
  .tpl-select {
    padding-inline-end: 2.25rem;
  }
  .tpl-input:focus,
  .tpl-select:focus,
  .tpl-textarea:focus {
    outline: 2px solid var(--color-primary);
    outline-offset: 1px;
  }
  .tpl-textarea {
    width: 100%;
    padding: 0.5rem;
    border-radius: var(--radius-control);
    background-color: var(--color-surface);
    color: var(--color-foreground);
    font: inherit;
    font-size: var(--text-sm);
    box-sizing: border-box;
    resize: vertical;
  }
  .tpl-sub-label {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-foreground);
    margin: 0.75rem 0 0.25rem;
  }
  .tpl-block-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-border);
  }
  .tpl-icon-button {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-surface);
    color: var(--color-foreground);
    font-size: var(--text-xs);
    padding: 0.2rem 0.45rem;
    cursor: pointer;
  }
  .tpl-icon-button:hover {
    background: var(--color-hover);
  }
  .tpl-rows {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding: 0;
    list-style: none;
  }
  .tpl-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.625rem;
    border: var(--panel-border);
    border-radius: var(--radius-control);
    background: var(--color-surface);
  }
  .tpl-row-title {
    flex: 1 1 auto;
    font-size: var(--text-sm);
    font-weight: 500;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tpl-row-controls {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex: 0 0 auto;
    margin-left: auto;
  }
  .tpl-control {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .tpl-row-overflow {
    position: relative;
    display: inline-flex;
  }
  .tpl-overflow-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.2rem 0.35rem;
    cursor: pointer;
    list-style: none;
  }
  .tpl-overflow-btn::-webkit-details-marker,
  .tpl-overflow-btn::marker {
    display: none;
  }
  .tpl-popover {
    position: absolute;
    right: 0;
    top: calc(100% + 4px);
    z-index: 30;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
    box-shadow: var(--elevation-overlay);
    padding: 0.5rem;
    min-width: 7rem;
  }
