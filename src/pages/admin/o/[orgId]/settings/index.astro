---
import PageHeader from "../../../../../components/ui/PageHeader.astro";
import Icon from "../../../../../components/ui/Icon.astro";
import type { IconName } from "../../../../../lib/ui/icons";
import { translate, uiLocale } from "../../../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import { getOrganization } from "../../../../../domain/organizations/organizations";
import { withRequestDb } from "../../../../../lib/db-request";

const organizationId = Astro.params.orgId!;

const organization = await withRequestDb((db) =>
  getOrganization(db, organizationId)
);

const base = `/admin/o/${organizationId}`;

interface SettingsCardData {
  href: string;
  icon: IconName;
  label: string;
  desc: string;
}

const settingsGroups: Array<{ label: string; items: SettingsCardData[] }> = [
  {
    label: "Core settings",
    items: [
      {
        href: `${base}/settings/organization`,
        icon: "building",
        label: "Organization",
        desc: "Legal, bank, and contact details.",
      },
      {
        href: `${base}/settings/users`,
        icon: "users",
        label: "Users & access",
        desc: "Admin membership and resident access.",
      },
      {
        href: `${base}/settings/billing`,
        icon: "receipt-euro",
        label: "Billing",
        desc: "Automation, due dates, numbering, and defaults.",
      },
      {
        href: `${base}/settings/rules`,
        icon: "percentage",
        label: "Tariffs & rules",
        desc: "Utility rates and billing calculation rules.",
      },
      {
        href: `${base}/settings/invoice-template`,
        icon: "file-description",
        label: "Invoice template",
        desc: "Invoice appearance and document settings.",
      },
      {
        href: `${base}/settings/data`,
        icon: "database",
        label: "Data",
        desc: "Import, export, and bulk updates.",
      },
    ],
  },
  {
    label: "Administration tools",
    items: [
      {
        href: `${base}/setup`,
        icon: "circle-check",
        label: "Setup wizard",
        desc: "Set up your organization",
      },
      {
        href: `${base}/audit`,
        icon: "clock",
        label: "Audit history",
        desc: "Track important changes in your organization.",
      },
      {
        href: `${base}/settings/suppressed-emails`,
        icon: "alert-triangle",
        label: "Suppressed email addresses",
        desc: "Addresses that bounced or reported a complaint.",
      },
    ],
  },
];
---

<AdminLayout
  title={`${t("Settings")} - ${organization.name}`}
  organizationId={organizationId}
  organizationName={organization.name}
  breadcrumbs={[{ label: t("Settings") }]}
>
  <div class="space-y-6">
    <PageHeader
      title={t("Settings")}
      description={t("Configure your organization, billing and access.")}
      display
    >
      <a href={`${base}/guide`} class="btn-secondary">
        <Icon name="help-circle" size="sm" />
        {t("Need help?")}
      </a>
    </PageHeader>

    <div class="settings-groups">
      {settingsGroups.map((group) => (
        <section class="settings-group">
          <h2 class="eyebrow">{t(group.label)}</h2>
          <div class="settings-grid">
            {group.items.map((s) => (
              <a href={s.href} class="settings-card box">
                <span class="icon-tile" aria-hidden="true">
                  <Icon name={s.icon} />
                </span>
                <div class="settings-card-text">
                  <h3>{t(s.label)}</h3>
                  <p>{t(s.desc)}</p>
                </div>
                <span class="settings-card-chevron" aria-hidden="true">
                  <Icon name="chevron-right" size="sm" />
                </span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</AdminLayout>

<style>
  .settings-groups {
    display: grid;
    gap: 2rem;
    margin-top: 1.5rem;
  }
  .settings-group .eyebrow {
    margin-bottom: 0.75rem;
  }
  .settings-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .settings-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--color-foreground);
  }
  .settings-card-text {
    min-width: 0;
    flex: 1 1 auto;
  }
  .settings-card-text h3 {
    font-size: var(--text-base);
    font-weight: 700;
  }
  .settings-card-text p {
    margin-top: 0.25rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .settings-card-chevron {
    flex: 0 0 auto;
    color: var(--color-muted);
    font-size: var(--text-xl);
  }
  .settings-card:hover .settings-card-chevron,
  .settings-card:focus-visible .settings-card-chevron {
    color: var(--color-foreground);
  }
  @media (prefers-reduced-motion: no-preference) {
    .settings-card-chevron {
      transition: color var(--duration-fast) var(--ease-standard);
    }
  }

  @media (width < 48rem) {
    .settings-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
