---
// Phase D (Organizations/dwellings) - settings index (spec Section 9.2, 27
// "Settings"). Billing/rules/invoice-template/data are later phases (F/G) --
// linked here as stubs so the nav is complete, not implemented yet.
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import {
  ForbiddenError,
  requireOrganizationAccess,
} from "../../../../../domain/authorization/guards";
import { getOrganization } from "../../../../../domain/organizations/organizations";
import { withRequestDb } from "../../../../../lib/db-request";

const organizationId = Astro.params.orgId!;
try {
  requireOrganizationAccess(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const organization = await withRequestDb((db) =>
  getOrganization(db, organizationId)
);

const sections = [
  {
    href: "organization",
    label: "Organization",
    desc: "Legal, bank, and contact details.",
    ready: true,
  },
  {
    href: "users",
    label: "Users & access",
    desc: "Admin membership and resident access.",
    ready: true,
  },
  {
    href: "billing",
    label: "Billing",
    desc: "Automation and due-date defaults.",
    ready: false,
  },
  {
    href: "rules",
    label: "Tariffs & rules",
    desc: "Billing calculation rules.",
    ready: false,
  },
  {
    href: "invoice-template",
    label: "Invoice template",
    desc: "Invoice appearance.",
    ready: false,
  },
  { href: "data", label: "Data", desc: "Import and export.", ready: false },
];
---

<AdminLayout
  title={`Settings - ${organization.name}`}
  organizationId={organizationId}
  organizationName={organization.name}
>
  <h1 class="text-xl font-bold text-neutral-900">Settings</h1>
  <ul class="mt-4 grid gap-4 sm:grid-cols-2">
    {
      sections.map((s) => (
        <li>
          <a
            href={s.ready ? s.href : "#"}
            class:list={[
              "block rounded-xl border border-neutral-200 bg-white p-5",
              s.ready
                ? "hover:border-neutral-400"
                : "cursor-not-allowed opacity-50",
            ]}
          >
            <p class="font-medium text-neutral-900">
              {s.label}{" "}
              {!s.ready && (
                <span class="text-xs text-neutral-500">(later phase)</span>
              )}
            </p>
            <p class="mt-1 text-sm text-neutral-600">{s.desc}</p>
          </a>
        </li>
      ))
    }
  </ul>
</AdminLayout>
