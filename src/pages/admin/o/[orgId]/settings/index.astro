---
// Phase D (Organizations/dwellings) - settings index (spec Section 9.2, 27
// "Settings"). Billing/rules/invoice-template/data were later phases (F/G),
// originally linked here as stubs so the nav was complete before they
// shipped -- all are implemented now; each card's `ready` flag must flip to
// true once its page actually works, or the link stays disabled forever.
import PageHeader from "../../../../../components/ui/PageHeader.astro";
import Icon from "../../../../../components/ui/Icon.astro";
import type { IconName } from "../../../../../lib/ui/icons";
import { translate, uiLocale } from "../../../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import {
  ForbiddenError,
  requireOrganizationAccess,
} from "../../../../../domain/authorization/guards";
import { getOrganization } from "../../../../../domain/organizations/organizations";
import { withRequestDb } from "../../../../../lib/db-request";

const organizationId = Astro.params.orgId!;
try {
  requireOrganizationAccess(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const organization = await withRequestDb((db) =>
  getOrganization(db, organizationId)
);

const base = `/admin/o/${organizationId}`;

interface SettingsCardData {
  href: string;
  icon: IconName;
  label: string;
  desc: string;
  ready: boolean;
}

const settingsGroups: Array<{ label: string; items: SettingsCardData[] }> = [
  {
    label: "Core settings",
    items: [
      {
        href: `${base}/settings/organization`,
        icon: "building",
        label: "Organization",
        desc: "Legal, bank, and contact details.",
        ready: true,
      },
      {
        href: `${base}/settings/users`,
        icon: "users",
        label: "Users & access",
        desc: "Admin membership and resident access.",
        ready: true,
      },
      {
        href: `${base}/settings/billing`,
        icon: "receipt-euro",
        label: "Billing",
        desc: "Automation, due dates, numbering, and defaults.",
        ready: true,
      },
      {
        href: `${base}/settings/rules`,
        icon: "percentage",
        label: "Tariffs & rules",
        desc: "Utility rates and billing calculation rules.",
        ready: true,
      },
      {
        href: `${base}/settings/invoice-template`,
        icon: "file-description",
        label: "Invoice template",
        desc: "Invoice appearance and document settings.",
        ready: true,
      },
      {
        href: `${base}/settings/data`,
        icon: "database",
        label: "Data",
        desc: "Import, export, and bulk updates.",
        ready: true,
      },
    ],
  },
  {
    label: "Administration tools",
    items: [
      {
        href: `${base}/audit`,
        icon: "clock",
        label: "Audit history",
        desc: "Track important changes in your organization.",
        ready: true,
      },
    ],
  },
];
---

<AdminLayout
  title={`Settings - ${organization.name}`}
  organizationId={organizationId}
  organizationName={organization.name}
>
  <div class="space-y-6">
    <nav class="breadcrumb" aria-label={t("Breadcrumb")}>
      <a href={`/admin/o/${organizationId}/dashboard`}>{t("Dashboard")}</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{t("Settings")}</span>
    </nav>
    <PageHeader
      title={t("Settings")}
      description={t("Configure your organization, billing and access.")}
      display
    >
      <a href={`${base}/guide`} class="btn-secondary settings-help">
        <span class="settings-help-icon" aria-hidden="true">?</span>
        {t("Need help?")}
      </a>
    </PageHeader>

    <div class="settings-groups">
      {
        settingsGroups.map((group) => (
          <section class="settings-group">
            <h2 class="eyebrow">{t(group.label)}</h2>
            <div class="settings-grid">
              {group.items.map((s) => (
                <a
                  href={s.ready ? s.href : undefined}
                  aria-disabled={!s.ready || undefined}
                  class="settings-card"
                  data-disabled={!s.ready ? "true" : undefined}
                >
                  <span class="settings-card-icon" aria-hidden="true">
                    <Icon name={s.icon} size="lg" />
                  </span>
                  <div class="settings-card-text">
                    <h3>{t(s.label)}</h3>
                    <p>{t(s.desc)}</p>
                    {!s.ready && (
                      <p class="settings-card-note">{t("Not available yet")}</p>
                    )}
                  </div>
                  {s.ready && (
                    <span class="settings-card-chevron" aria-hidden="true">
                      ›
                    </span>
                  )}
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</AdminLayout>

<style>
  .settings-help {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .settings-help-icon {
    display: grid;
    width: 1.1rem;
    height: 1.1rem;
    place-items: center;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
  }
  .settings-groups {
    display: grid;
    gap: 2rem;
    margin-top: 1.5rem;
  }
  .settings-group .eyebrow {
    margin-bottom: 0.75rem;
  }
  .settings-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .settings-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
    background: var(--color-surface);
    box-shadow: var(--shadow-panel);
    color: var(--color-foreground);
  }
  .settings-card:not([data-disabled]):hover {
    border-color: var(--color-muted);
  }
  .settings-card[data-disabled] {
    cursor: not-allowed;
    opacity: 0.55;
  }
  .settings-card-icon {
    display: grid;
    width: 3rem;
    height: 3rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 50%;
    background: var(--color-badge-neutral-bg);
    color: var(--color-foreground);
  }
  .settings-card-icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }
  .settings-card-text {
    min-width: 0;
    flex: 1 1 auto;
  }
  .settings-card-text h3 {
    font-size: 1rem;
    font-weight: 700;
  }
  .settings-card-text p {
    margin-top: 0.25rem;
    color: var(--color-muted);
    font-size: 0.875rem;
  }
  .settings-card-note {
    margin-top: 0.25rem;
    font-size: 0.75rem;
    font-style: italic;
  }
  .settings-card-chevron {
    flex: 0 0 auto;
    color: var(--color-muted);
    font-size: 1.25rem;
  }

  @media (max-width: 767px) {
    .settings-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
