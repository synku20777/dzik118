---
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import {
  ForbiddenError,
  requireOrganizationAccess,
} from "../../../../../domain/authorization/guards";
import { getOrganization } from "../../../../../domain/organizations/organizations";
import {
  getCurrentOpenPeriod,
  listPeriods,
  NotFoundError,
} from "../../../../../domain/periods/periods";
import {
  getDashboardSummary,
  type DashboardSummary,
} from "../../../../../domain/periods/dashboard";
import {
  getSetupStatus,
  type SetupProgress,
} from "../../../../../domain/onboarding/progress";
import { withRequestDb } from "../../../../../lib/db-request";
import { subtractExact, sumExact } from "../../../../../lib/decimal2";
import StatusBadge from "../../../../../components/ui/StatusBadge.astro";
import EmptyState from "../../../../../components/ui/EmptyState.astro";
import AdminContextDrawer from "../../../../../components/ui/AdminContextDrawer.astro";
import Icon from "../../../../../components/ui/Icon.astro";
import {
  collectionShare,
  formatCollectionShare,
} from "../../../../../lib/ui/dashboard-collection";
import type { IconName } from "../../../../../lib/ui/icons";
import {
  entityLabel,
  fill,
  formatMoney as baseFormatMoney,
  formatNumber,
  formatDate,
  formatPeriod,
  plural,
  translate,
  uiLocale,
} from "../../../../../lib/ui/i18n";

const organizationId = Astro.params.orgId!;
try {
  requireOrganizationAccess(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
const base = "/admin/o/" + organizationId;
const requestedPeriodId = Astro.url.searchParams.get("periodId");

// The `as` casts stop TypeScript narrowing these to `null`: they are assigned
// inside the withRequestDb callback, which its control-flow analysis ignores.
let organization = null as Awaited<ReturnType<typeof getOrganization>> | null;
let allPeriods: Awaited<ReturnType<typeof listPeriods>> = [];
let summary = null as DashboardSummary | null;
let setupComplete = true;
let setupProgress = null as SetupProgress | null;
let loadError = false;

try {
  summary = await withRequestDb(async (db) => {
    const org = await getOrganization(db, organizationId);
    const periods = (await listPeriods(db, organizationId)).filter(
      (period) => !period.openingReadings
    );
    const { complete, progress } = await getSetupStatus(
      db,
      organizationId,
      org
    );

    // Keep the organization and setup shell available if only the summary fails.
    organization = org;
    allPeriods = periods;
    setupComplete = complete;
    setupProgress = progress;

    let periodId: string | undefined = requestedPeriodId || undefined;
    if (!periodId) {
      const openPeriod = await getCurrentOpenPeriod(db, organizationId);
      if (openPeriod && !openPeriod.openingReadings) {
        periodId = openPeriod.id;
      } else if (periods.length > 0) {
        periodId = periods[0].id;
      }
    }

    return periodId
      ? await getDashboardSummary(db, organizationId, periodId)
      : null;
  });
} catch (err) {
  if (err instanceof NotFoundError || err instanceof ForbiddenError) {
    return Astro.redirect(`${base}/periods`);
  }
  loadError = true;
}

const currentIndex = summary
  ? allPeriods.findIndex((period) => period.id === summary!.period.id)
  : -1;
const previousPeriod =
  currentIndex >= 0 && currentIndex < allPeriods.length - 1
    ? allPeriods[currentIndex + 1]
    : null;
const nextPeriod = currentIndex > 0 ? allPeriods[currentIndex - 1] : null;

const statuses = [
  "MISSING_DATA",
  "READY",
  "DRAFT",
  "PREPARED",
  "OVERDUE",
  "SENT",
  "PAID",
] as const;

const setupSteps = setupProgress
  ? [
      {
        title: t("Organization details"),
        done: setupProgress.steps.organization,
        href: `${base}/setup/organization`,
      },
      {
        title: t("Dwellings"),
        done: setupProgress.steps.dwellings,
        href: `${base}/setup/dwellings`,
      },
      {
        title: t("First billing period"),
        done: setupProgress.steps.period,
        href: `${base}/setup/period`,
      },
      {
        title: t("Charges"),
        done: setupProgress.steps.charges,
        href: `${base}/setup/charges`,
      },
      {
        title: t("Meters and starting readings"),
        done: setupProgress.steps.meters,
        href: `${base}/setup/meters`,
      },
    ]
  : [];
const completedSetupSteps = setupSteps.filter((step) => step.done).length;
const nextSetupStep = setupSteps.find((step) => !step.done);

const workbenchPath = summary
  ? `${base}/periods/${summary.period.id}`
  : `${base}/periods`;
const firstMissingItem = summary?.needsAttention.find(
  (item) => item.status === "MISSING_DATA"
);
const readingsUrl = firstMissingItem ? new URL(Astro.url) : null;
if (readingsUrl && firstMissingItem) {
  readingsUrl.searchParams.set("drawer", "readings");
  readingsUrl.searchParams.set("dwelling", firstMissingItem.dwellingId);
  readingsUrl.searchParams.delete("focus");
}

function nextActionSentence(value: DashboardSummary): string {
  const { key, count } = value.nextAction;
  if (key === "ENTER_READINGS")
    return plural(
      locale,
      count,
      "{n} dwelling still needs a reading.",
      "{n} dwellings still need readings."
    );
  if (key === "GENERATE_INVOICES")
    return plural(
      locale,
      count,
      "{n} invoice can be created.",
      "{n} invoices can be created."
    );
  if (key === "SEND_INVOICES")
    return plural(
      locale,
      count,
      "{n} invoice is ready to send.",
      "{n} invoices are ready to send."
    );
  if (key === "REVIEW_PAYMENTS")
    return plural(
      locale,
      count,
      "{n} invoice is waiting for payment.",
      "{n} invoices are waiting for payment."
    );
  return t(
    key === "CREATE_NEXT_PERIOD"
      ? "This month is closed. Create the next month to continue."
      : "Everything for this month is done."
  );
}

const actionLabel = summary
  ? {
      ENTER_READINGS: "Enter readings",
      GENERATE_INVOICES: "Generate invoices",
      SEND_INVOICES: "Send invoices",
      REVIEW_PAYMENTS: "Review payments",
      CREATE_NEXT_PERIOD: "Create next month",
      ALL_DONE: "Open workbench",
    }[summary.nextAction.key]
  : null;
const actionHref = summary
  ? {
      ENTER_READINGS: readingsUrl
        ? readingsUrl.pathname + readingsUrl.search
        : `${workbenchPath}?status=MISSING_DATA`,
      GENERATE_INVOICES: `${workbenchPath}?status=READY`,
      SEND_INVOICES: `${workbenchPath}?status=UNSENT`,
      REVIEW_PAYMENTS: `${base}/payments`,
      CREATE_NEXT_PERIOD: `${base}/periods#create-period`,
      ALL_DONE: workbenchPath,
    }[summary.nextAction.key]
  : null;

type ProgressState = "done" | "current" | "in-progress" | "unavailable";
const currentProgressIndex = summary
  ? {
      ENTER_READINGS: 0,
      GENERATE_INVOICES: 1,
      SEND_INVOICES: 2,
      REVIEW_PAYMENTS: 3,
      CREATE_NEXT_PERIOD: -1,
      ALL_DONE: -1,
    }[summary.nextAction.key]
  : -1;
const progressSteps = summary
  ? [
      {
        label: t("Readings"),
        done: summary.progress.readingsDone,
        total: summary.progress.dwellingsTotal,
        date: summary.deadlines.readingDeadline,
      },
      {
        // The shorter existing label avoids breaking the long Russian word in
        // the two-column mobile strip without reducing the text size.
        label: t("Invoices"),
        done: summary.progress.invoicesGenerated,
        total: summary.progress.dwellingsTotal,
        date: summary.deadlines.invoiceIssueDate,
      },
      {
        label: t("Sent invoices"),
        done: summary.progress.invoicesSent,
        total: summary.progress.dwellingsTotal,
        date: null,
      },
      {
        label: t("Paid invoices"),
        done: summary.progress.invoicesPaid,
        total: summary.progress.dwellingsTotal,
        date: summary.deadlines.invoiceDueDate,
      },
    ].map((step, index) => ({
      ...step,
      state: (step.total > 0 && step.done >= step.total
        ? "done"
        : index === currentProgressIndex
          ? "current"
          : step.done > 0
            ? "in-progress"
            : "unavailable") as ProgressState,
    }))
  : [];
const progressStateText: Record<ProgressState, string> = {
  done: t("Done"),
  current: t("Now"),
  unavailable: t("Waiting"),
  "in-progress": t("In progress"),
};
const progressStateIcon: Record<ProgressState, IconName> = {
  done: "check",
  current: "clock",
  unavailable: "dots",
  "in-progress": "clock",
};

const shortDate = (value: string) => formatDate(value, locale);
const dayMonth = (value: string) =>
  new Intl.DateTimeFormat(locale, {
    day: "2-digit",
    month: "short",
    timeZone: "UTC",
  }).format(new Date(value));

const manualAdjustment = summary
  ? subtractExact(
      summary.amountDue,
      subtractExact(
        sumExact([
          summary.currentCharges,
          summary.carriedOutstanding,
          summary.lateFees,
        ]),
        summary.creditsApplied
      )
    )
  : "0.00";
const hasManualAdjustment = Number(manualAdjustment) !== 0;

function formatMoney(value: string, currency: string): string {
  return baseFormatMoney(value, currency, locale, true);
}

const collectionRatio = summary
  ? collectionShare(summary.totalPaid, summary.amountDue)
  : null;

type MissingItem =
  | { label: string | null; meterType: string; reason?: "NO_READING" }
  | { billingRuleId: string; ruleName: string; reason?: "NO_MANUAL_INPUT" }
  | {
      billingRuleId: string;
      ruleName: string;
      meterType: string;
      reason: "NO_ACTIVE_METER_FOR_RULE";
    }
  | { reason: "NO_APPLICABLE_RULES" }
  | string;

function missingReasons(items: unknown[], limit?: number): string {
  const labels = (items as MissingItem[])
    .map((item) => {
      if (typeof item === "string") {
        const legacyReading = item.match(
          /^Missing current-period meter reading for dwelling (.+?)\.?$/
        );
        return legacyReading
          ? fill(
              t("Missing current-period meter reading for dwelling {number}"),
              {
                number: legacyReading[1],
              }
            )
          : item;
      }
      if (!item || typeof item !== "object") return "";
      if (item.reason === "NO_APPLICABLE_RULES")
        return t("No billing rule applies");
      if (item.reason === "NO_ACTIVE_METER_FOR_RULE")
        return `${item.ruleName} — ${t("no active meter")}`;
      if ("billingRuleId" in item) return item.ruleName;
      return item.label ?? entityLabel(item.meterType, locale);
    })
    .filter(Boolean);
  const visible = limit ? labels.slice(0, limit) : labels;
  const remaining = labels.length - visible.length;
  return `${visible.join(", ")}${remaining > 0 ? `, +${remaining}` : ""}`;
}

type AttentionRow =
  | { kind: "case"; item: DashboardSummary["needsAttention"][number] }
  | {
      kind: "summary";
      key: string;
      label: string;
      href: string;
      actionLabel: string;
      tone: "info" | "warning" | "danger";
      icon: IconName;
    };

const attentionRows: AttentionRow[] = summary
  ? summary.needsAttention.map((item) => ({ kind: "case" as const, item }))
  : [];
if (summary?.unmatchedPaymentCount) {
  attentionRows.push({
    kind: "summary",
    key: "unmatched",
    label: plural(
      locale,
      summary.unmatchedPaymentCount,
      "{n} bank payment is not matched to an invoice yet.",
      "{n} bank payments are not matched to an invoice yet."
    ),
    href: `${base}/payments?view=UNMATCHED`,
    actionLabel: "Review payments",
    tone: "warning",
    icon: "alert-triangle",
  });
}
if (summary?.proposedPaymentCount) {
  attentionRows.push({
    kind: "summary",
    key: "proposed",
    label: plural(
      locale,
      summary.proposedPaymentCount,
      "{n} suggested payment match is waiting for your check.",
      "{n} suggested payment matches are waiting for your check."
    ),
    href: `${base}/payments?view=PROPOSED`,
    actionLabel: "Review payments",
    tone: "info",
    icon: "clock",
  });
}
if (summary?.deliveryFailureCount) {
  attentionRows.push({
    kind: "summary",
    key: "delivery",
    label: plural(
      locale,
      summary.deliveryFailureCount,
      "{n} invoice could not be delivered.",
      "{n} invoices could not be delivered."
    ),
    href: `${workbenchPath}?status=PREPARED`,
    actionLabel: "Review failed deliveries",
    tone: "danger",
    icon: "alert-triangle",
  });
}
if (
  summary?.caseStatusCounts.READY &&
  summary.nextAction.key !== "GENERATE_INVOICES"
) {
  attentionRows.push({
    kind: "summary",
    key: "ready",
    label: plural(
      locale,
      summary.caseStatusCounts.READY,
      "{n} invoice can be created.",
      "{n} invoices can be created."
    ),
    href: `${workbenchPath}?status=READY`,
    actionLabel: "Generate invoices",
    tone: "info",
    icon: "receipt-euro",
  });
}
const readyToSendCount = summary
  ? summary.caseStatusCounts.DRAFT + summary.caseStatusCounts.PREPARED
  : 0;
if (readyToSendCount && summary?.nextAction.key !== "SEND_INVOICES") {
  attentionRows.push({
    kind: "summary",
    key: "send",
    label: plural(
      locale,
      readyToSendCount,
      "{n} invoice is ready to send.",
      "{n} invoices are ready to send."
    ),
    href: `${workbenchPath}?status=UNSENT`,
    actionLabel: "Send invoices",
    tone: "info",
    icon: "send",
  });
}
if (
  summary?.caseStatusCounts.SENT &&
  summary.nextAction.key !== "REVIEW_PAYMENTS"
) {
  attentionRows.push({
    kind: "summary",
    key: "waiting",
    label: plural(
      locale,
      summary.caseStatusCounts.SENT,
      "{n} invoice is waiting for payment.",
      "{n} invoices are waiting for payment."
    ),
    href: `${base}/payments`,
    actionLabel: "Review payments",
    tone: "info",
    icon: "clock",
  });
}

function attentionPriority(row: AttentionRow): number {
  if (row.kind === "case") return row.item.status === "OVERDUE" ? 2 : 3;
  if (row.key === "delivery") return 0;
  if (row.key === "unmatched" || row.key === "proposed") return 1;
  return 4;
}

attentionRows.sort((a, b) => attentionPriority(a) - attentionPriority(b));

const showAllAttention = Astro.url.searchParams.get("all") === "1";
const visibleAttentionRows = showAllAttention
  ? attentionRows
  : attentionRows.slice(0, 5);
const attentionItemCount = attentionRows.length;
const hiddenAttentionCount = Math.max(
  0,
  attentionItemCount - visibleAttentionRows.length
);

// One quiet heading per kind replaces the badge each row repeated. Immediate
// failures stay first; routine work is separated as the next-steps group.
type GroupKey = "urgent" | "overdue" | "missing" | "next";
const nextStepKeys = new Set(["ready", "send", "waiting"]);
const groupKey = (row: AttentionRow): GroupKey =>
  row.kind !== "case"
    ? nextStepKeys.has(row.key)
      ? "next"
      : "urgent"
    : row.item.status === "OVERDUE"
      ? "overdue"
      : "missing";
const groupHeading: Record<
  "overdue" | "missing" | "next",
  {
    label: string;
    icon?: IconName;
    tone?: "danger" | "warning";
  }
> = {
  overdue: {
    label: t("Overdue payments"),
    icon: "alert-triangle",
    tone: "danger",
  },
  missing: { label: t("Missing data"), icon: "clock", tone: "warning" },
  next: { label: t("Next steps") },
};
const groupTotal = (key: GroupKey) =>
  attentionRows.filter((row) => groupKey(row) === key).length;
const hiddenInGroup = (key: GroupKey, visible: number) =>
  Math.max(0, groupTotal(key) - visible);
const attentionGroups: {
  key: GroupKey;
  rows: AttentionRow[];
  start: number;
}[] = [];
visibleAttentionRows.forEach((row, index) => {
  const key = groupKey(row);
  const last = attentionGroups[attentionGroups.length - 1];
  if (last?.key === key) last.rows.push(row);
  else attentionGroups.push({ key, rows: [row], start: index });
});
const attentionAllUrl = new URL(Astro.url);
attentionAllUrl.searchParams.set("all", "1");
const attentionAllHref = attentionAllUrl.pathname + attentionAllUrl.search;

function readingsHref(
  item: DashboardSummary["needsAttention"][number]
): string {
  const url = new URL(Astro.url);
  url.searchParams.set("drawer", "readings");
  url.searchParams.set("dwelling", item.dwellingId);
  url.searchParams.delete("focus");
  return url.pathname + url.search;
}
---

<AdminLayout
  title={t("Dashboard") + (organization ? " - " + organization.name : "")}
  organizationId={organizationId}
  organizationName={organization?.name}
  breadcrumbs={[]}
>
  {loadError || !organization ? (
    <section class="dashboard-error panel" role="alert">
      <Icon name="alert-triangle" size="lg" />
      <div>
        <h1>{t("The overview could not be loaded.")}</h1>
        <p>{t("Try again in a moment, or open the billing periods.")}</p>
        <a class="btn-secondary" href={Astro.url.pathname + Astro.url.search}>
          {t("Try again")}
        </a>
        <a class="btn-secondary" href={`${base}/periods`}>
          {t("Billing periods")}
        </a>
      </div>
    </section>
  ) : (
    <>
      {!setupComplete && setupProgress && (
        <section
          class="dashboard-setup panel"
          aria-labelledby="dashboard-setup-title"
        >
          <h2 id="dashboard-setup-title" class="sr-only">
            {t("Finish setting up")}
          </h2>
          <div class="month-status-lead">
            <div>
              <p class="next-step-label">{t("Next step")}</p>
              <p class="month-status-sentence">{nextSetupStep?.title}</p>
            </div>
            <a
              class="btn-primary"
              href={nextSetupStep?.href ?? `${base}/setup`}
            >
              {t("Continue setup")}
              <Icon name="arrow-right" size="sm" />
            </a>
          </div>
          <ol
            class="month-progress setup-progress-steps"
            aria-label={fill(t("Setup steps done: {done} of {total}"), {
              done: completedSetupSteps,
              total: setupSteps.length,
            })}
          >
            {setupSteps.map((step, index) => (
              <li
                data-state={
                  step.done
                    ? "done"
                    : step === nextSetupStep
                      ? "current"
                      : "upcoming"
                }
                style={`--step-progress:${step.done ? 100 : 0}%`}
              >
                <span class="progress-marker" aria-hidden="true">
                  {step.done ? <Icon name="check" size="xs" /> : index + 1}
                </span>
                <p class="progress-label">
                  <a
                    href={step.href}
                    aria-current={step === nextSetupStep ? "step" : undefined}
                  >
                    {step.title}
                  </a>
                </p>
                <p class="progress-detail">{t(step.done ? "Done" : "To do")}</p>
              </li>
            ))}
          </ol>
        </section>
      )}

      {!summary ? (
        <div class="space-y-6">
          <header class="page-header">
            <div>
              <h1>{t("Dashboard")}</h1>
              <p class="page-description">
                {t("Monitor billing, payments and work requiring attention.")}
              </p>
            </div>
          </header>
          {setupComplete && (
            <EmptyState
              ornament
              title={t("No billing periods yet.")}
              description={t(
                "Create a period to start the monthly billing workflow."
              )}
            >
              <a class="btn-primary" href={`${base}/periods#create-period`}>
                {t("Create period")}
              </a>
            </EmptyState>
          )}
        </div>
      ) : (
        <div class="dashboard-page">
          <AdminContextDrawer
            organizationId={organizationId}
            periodId={summary.period.id}
            periodStatus={summary.period.status}
            periodName={formatPeriod(
              summary.period.year,
              summary.period.month,
              locale
            )}
            workbenchPath={workbenchPath}
            refreshSelectors={[
              ".dashboard-metrics",
              ".dashboard-month-status",
              ".dashboard-attention",
              ".dashboard-more",
            ]}
          />

          <header class="dashboard-header">
            <div class="dashboard-heading">
              <div class="dashboard-title-row">
                <h1 class="font-display">
                  {formatPeriod(
                    summary.period.year,
                    summary.period.month,
                    locale
                  )}
                </h1>
                <StatusBadge status={summary.period.status} />
                {(summary.period.status === "LOCKED" ||
                  !summary.isNewestPeriod) && (
                  <p class="dashboard-period-context">
                    <Icon
                      name={
                        summary.period.status === "LOCKED" ? "lock" : "clock"
                      }
                      size="xs"
                    />
                    {t(
                      !summary.isNewestPeriod
                        ? "You are viewing an earlier month."
                        : "This month is closed."
                    )}
                  </p>
                )}
              </div>
            </div>
            <nav
              class="dashboard-period-nav"
              aria-label={t("Period navigation")}
            >
              {previousPeriod ? (
                <a href={`${base}/dashboard?periodId=${previousPeriod.id}`}>
                  <Icon name="arrow-left" size="xs" />
                  <span class="sr-only">{t("Previous period")}: </span>
                  {formatPeriod(
                    previousPeriod.year,
                    previousPeriod.month,
                    locale
                  )}
                </a>
              ) : (
                <span
                  class:list={{
                    "period-context-compact": !summary.isNewestPeriod,
                  }}
                  aria-disabled="true"
                >
                  <Icon
                    name={!summary.isNewestPeriod ? "clock" : "arrow-left"}
                    size="xs"
                  />
                  {t(
                    !summary.isNewestPeriod
                      ? "Earlier month"
                      : "Previous period"
                  )}
                </span>
              )}
              {nextPeriod ? (
                <a href={`${base}/dashboard?periodId=${nextPeriod.id}`}>
                  <span class="sr-only">{t("Next period")}: </span>
                  {formatPeriod(nextPeriod.year, nextPeriod.month, locale)}
                  <Icon name="arrow-right" size="xs" />
                </a>
              ) : (
                <span aria-disabled="true">
                  <span class="sr-only">{t("Next period")}</span>
                  <span class="period-label-full" aria-hidden="true">
                    {t("Next period")}
                  </span>
                  <span class="period-label-mobile" aria-hidden="true">
                    {t("Next")}
                  </span>
                  <Icon name="arrow-right" size="xs" />
                </span>
              )}
            </nav>
          </header>

          <section class="dashboard-metrics" aria-label={t("Overview")}>
            <div
              class="dashboard-metric dashboard-collection panel"
              data-metric="collection"
            >
              <div class="collection-head">
                <span class="metric-label">{t("Received in payments")}</span>
                <details class="info-tip money-breakdown" data-dismiss>
                  <summary
                    class="icon-btn icon-btn-sm"
                    aria-label={t("Invoice breakdown")}
                  >
                    <Icon name="info-circle" size="sm" />
                  </summary>
                  <div class="info-tip-panel">
                    <dl aria-label={t("Money this month")}>
                      <div>
                        <dt>
                          <span class="money-operator" aria-hidden="true" />
                          <span>{t("This month's invoices")}</span>
                        </dt>
                        <dd>
                          {formatMoney(
                            summary.currentCharges,
                            organization.currency
                          )}
                        </dd>
                      </div>
                      <div>
                        <dt>
                          <span class="money-operator" aria-hidden="true">
                            +
                          </span>
                          <span>{t("Previous debt")}</span>
                        </dt>
                        <dd>
                          {formatMoney(
                            summary.carriedOutstanding,
                            organization.currency
                          )}
                        </dd>
                      </div>
                      <div>
                        <dt>
                          <span class="money-operator" aria-hidden="true">
                            −
                          </span>
                          <span>{t("Previous overpayment")}</span>
                        </dt>
                        <dd>
                          {formatMoney(
                            summary.creditsApplied,
                            organization.currency
                          )}
                        </dd>
                      </div>
                      <div>
                        <dt>
                          <span class="money-operator" aria-hidden="true">
                            +
                          </span>
                          <span>{t("Late fees")}</span>
                        </dt>
                        <dd>
                          {formatMoney(summary.lateFees, organization.currency)}
                        </dd>
                      </div>
                      {hasManualAdjustment && (
                        <div>
                          <dt>
                            <span class="money-operator" aria-hidden="true" />
                            <span>{t("Manual adjustment")}</span>
                          </dt>
                          <dd>
                            {formatMoney(
                              manualAdjustment,
                              organization.currency
                            )}
                          </dd>
                        </div>
                      )}
                      <div class="money-total">
                        <dt>
                          <span class="money-operator" aria-hidden="true">
                            =
                          </span>
                          <span>{t("Total to pay")}</span>
                        </dt>
                        <dd>
                          {formatMoney(
                            summary.amountDue,
                            organization.currency
                          )}
                        </dd>
                      </div>
                      <div class="money-split">
                        <dt>
                          <span class="money-operator" aria-hidden="true" />
                          <span>{t("Received in payments")}</span>
                        </dt>
                        <dd class="money-received">
                          {formatMoney(
                            summary.totalPaid,
                            organization.currency
                          )}
                        </dd>
                      </div>
                      <div
                        class="money-split"
                        data-tone={
                          summary.caseStatusCounts.OVERDUE > 0
                            ? "danger"
                            : undefined
                        }
                      >
                        <dt>
                          <span class="money-operator" aria-hidden="true" />
                          <span>
                            {summary.caseStatusCounts.OVERDUE > 0 && (
                              <Icon name="alert-triangle" size="xs" />
                            )}
                            {t("Still unpaid")}
                          </span>
                        </dt>
                        <dd>
                          {formatMoney(
                            summary.totalOutstanding,
                            organization.currency
                          )}
                        </dd>
                      </div>
                    </dl>
                  </div>
                </details>
              </div>
              <figure class="collection-overview">
                <div class="collection-hero">
                  <a
                    class="collection-link"
                    href={`${base}/payments?view=CONFIRMED`}
                  >
                    <strong class="collection-received">
                      {formatMoney(summary.totalPaid, organization.currency)}
                    </strong>
                  </a>
                  <span
                    class="collection-share"
                    data-complete={
                      collectionRatio !== null && collectionRatio >= 1
                        ? ""
                        : undefined
                    }
                  >
                    {formatCollectionShare(collectionRatio, locale)}
                  </span>
                </div>
                <div
                  class="collection-bar"
                  role="img"
                  aria-label={
                    collectionRatio === null
                      ? t("No amount due")
                      : fill(t("{share} of {total} received"), {
                          share: formatCollectionShare(collectionRatio, locale),
                          total: formatMoney(
                            summary.amountDue,
                            organization.currency
                          ),
                        })
                  }
                >
                  <span style={`width:${(collectionRatio ?? 0) * 100}%`} />
                </div>
                <figcaption class="collection-foot">
                  {collectionRatio === null ? (
                    <span>{t("No amount due")}</span>
                  ) : (
                    <span>
                      {t("of total to pay")}{" "}
                      <span class="collection-total">
                        {formatMoney(summary.amountDue, organization.currency)}
                      </span>
                    </span>
                  )}
                  {Number(summary.totalOutstanding) > 0 && (
                    <a
                      class="collection-unpaid"
                      data-metric="unpaid"
                      data-tone={
                        summary.caseStatusCounts.OVERDUE ? "danger" : undefined
                      }
                      href={workbenchPath}
                    >
                      {summary.caseStatusCounts.OVERDUE > 0 && (
                        <Icon name="alert-triangle" size="xs" />
                      )}
                      {t("Still unpaid")}
                      {summary.caseStatusCounts.OVERDUE > 0 && (
                        <span class="sr-only"> ({t("Overdue")})</span>
                      )}
                      <strong>
                        {formatMoney(
                          summary.totalOutstanding,
                          organization.currency
                        )}
                      </strong>
                    </a>
                  )}
                </figcaption>
              </figure>
              {readyToSendCount > 0 && (
                <p class="collection-note">
                  {t("Includes invoices that are not sent yet.")}
                </p>
              )}
            </div>
            <a
              class="dashboard-metric dashboard-collection panel"
              data-metric="readings"
              href={`${workbenchPath}?status=MISSING_DATA`}
            >
              <span class="metric-label">{t("Readings")}</span>
              <div class="collection-hero">
                <strong class="collection-received">
                  {formatNumber(String(summary.progress.readingsDone), locale)}
                  <span class="metric-denominator">
                    {" "}
                    /{" "}
                    {formatNumber(
                      String(summary.progress.dwellingsTotal),
                      locale
                    )}
                  </span>
                </strong>
                <span class="collection-share">
                  {formatCollectionShare(
                    summary.progress.dwellingsTotal
                      ? summary.progress.readingsDone /
                          summary.progress.dwellingsTotal
                      : null,
                    locale
                  )}
                </span>
              </div>
              <div class="metric-bar" aria-hidden="true">
                <span
                  style={`width:${
                    summary.progress.dwellingsTotal
                      ? (summary.progress.readingsDone /
                          summary.progress.dwellingsTotal) *
                        100
                      : 0
                  }%`}
                />
              </div>
              <span class="metric-foot">
                {summary.progress.dwellingsTotal -
                  summary.progress.readingsDone >
                0
                  ? fill(t("{count} still to enter"), {
                      count: String(
                        summary.progress.dwellingsTotal -
                          summary.progress.readingsDone
                      ),
                    })
                  : t("All readings are in")}
                <Icon name="arrow-right" size="xs" />
              </span>
            </a>
          </section>

          <section
            class="dashboard-month-status panel"
            aria-labelledby="month-progress-title"
          >
            <h2 id="month-progress-title" class="sr-only">
              {t("Month progress")}
            </h2>
            <div class="month-status-lead">
              <div>
                <p class="next-step-label">{t("Next step")}</p>
                <p class="month-status-sentence">
                  {nextActionSentence(summary)}
                </p>
              </div>
              {summary.nextAction.key === "ALL_DONE" ? (
                <a class="month-status-link" href={actionHref!}>
                  {t(actionLabel!)}
                  <Icon name="arrow-right" size="sm" />
                </a>
              ) : (
                <a
                  class="btn-primary"
                  href={actionHref!}
                  data-open-drawer={
                    summary.nextAction.key === "ENTER_READINGS" &&
                    firstMissingItem
                      ? "readings"
                      : undefined
                  }
                  data-dwelling-id={
                    summary.nextAction.key === "ENTER_READINGS"
                      ? firstMissingItem?.dwellingId
                      : undefined
                  }
                  aria-haspopup={
                    summary.nextAction.key === "ENTER_READINGS" &&
                    firstMissingItem
                      ? "dialog"
                      : undefined
                  }
                  aria-controls={
                    summary.nextAction.key === "ENTER_READINGS" &&
                    firstMissingItem
                      ? "admin-context-drawer"
                      : undefined
                  }
                >
                  {t(actionLabel!)}
                  <Icon name="arrow-right" size="sm" />
                </a>
              )}
            </div>

            <ol class="month-progress" aria-label={t("Month progress")}>
              {progressSteps.map((step) => (
                <li
                  data-state={step.state}
                  style={`--step-progress:${step.total ? Math.min(100, (step.done / step.total) * 100) : 0}%`}
                >
                  <span class="progress-marker" aria-hidden="true">
                    <Icon name={progressStateIcon[step.state]} size="xs" />
                  </span>
                  <p class="progress-label">
                    {step.label}
                    {step.state === "current" ? (
                      <span class="progress-now">
                        {progressStateText.current}
                      </span>
                    ) : (
                      <span class="sr-only">
                        , {progressStateText[step.state]}
                      </span>
                    )}
                  </p>
                  <p class="progress-detail">
                    <span class="progress-count">
                      {fill(t("{done} of {total}"), {
                        done: step.done,
                        total: step.total,
                      })}
                    </span>
                    {step.date && (
                      <time class="progress-deadline" datetime={step.date}>
                        {fill(t("by {date}"), { date: dayMonth(step.date) })}
                      </time>
                    )}
                  </p>
                </li>
              ))}
            </ol>
          </section>

          <div class="dashboard-body">
            <section
              class="dashboard-attention panel"
              aria-labelledby="dashboard-attention-title"
            >
              <div class="dashboard-section-heading">
                <div>
                  <h2 id="dashboard-attention-title">{t("Needs attention")}</h2>
                  <p>{attentionItemCount}</p>
                </div>
              </div>

              {visibleAttentionRows.length === 0 ? (
                <EmptyState title={t("Nothing needs attention right now.")} />
              ) : (
                <div
                  class:list={[
                    "attention-list",
                    { "is-expanded": showAllAttention },
                  ]}
                >
                  {attentionGroups.map((group, groupIndex) => {
                    const heading =
                      group.key === "urgent" ? null : groupHeading[group.key];
                    const hiddenCount = hiddenInGroup(
                      group.key,
                      group.rows.length
                    );
                    return (
                      <div
                        class:list={[
                          "attention-group",
                          { "attention-extra": group.start >= 3 },
                        ]}
                      >
                        {heading && (
                          <h3
                            class="attention-group-heading"
                            id={`attention-group-${group.key}`}
                            data-tone={heading.tone}
                          >
                            {heading.icon && (
                              <span
                                class="attention-group-icon"
                                aria-hidden="true"
                              >
                                <Icon name={heading.icon} size="xs" />
                              </span>
                            )}
                            {heading.label}
                            {hiddenCount === 0 && (
                              <span class="attention-group-count">
                                {groupTotal(group.key)}
                              </span>
                            )}
                          </h3>
                        )}
                        <div
                          role="list"
                          aria-labelledby={
                            heading
                              ? `attention-group-${group.key}`
                              : "dashboard-attention-title"
                          }
                        >
                          {group.rows.map((row) =>
                            row.kind === "case" ? (
                              <article class="attention-row" role="listitem">
                                <div class="attention-row-main">
                                  <div class="attention-heading">
                                    <a
                                      href={`${base}/dwellings/${row.item.dwellingId}`}
                                    >
                                      {t("Dwelling")} {row.item.dwellingNumber}
                                    </a>
                                  </div>
                                  {row.item.status === "OVERDUE" ? (
                                    <p class="attention-details">
                                      <strong>
                                        {formatMoney(
                                          row.item.overdueAmount ?? "0.00",
                                          organization!.currency
                                        )}
                                      </strong>
                                      {row.item.dueDate && (
                                        <span>
                                          {fill(t("Due {date}"), {
                                            date: shortDate(row.item.dueDate),
                                          })}
                                        </span>
                                      )}
                                      {row.item.daysLate !== null && (
                                        <span>
                                          {plural(
                                            locale,
                                            row.item.daysLate,
                                            "{n} day late",
                                            "{n} days late"
                                          )}
                                        </span>
                                      )}
                                    </p>
                                  ) : (
                                    <p
                                      class="attention-reason"
                                      data-tip={
                                        missingReasons(row.item.missingData) ||
                                        undefined
                                      }
                                      data-tip-clipped={
                                        missingReasons(row.item.missingData) ===
                                        missingReasons(row.item.missingData, 2)
                                          ? ""
                                          : undefined
                                      }
                                    >
                                      {missingReasons(
                                        row.item.missingData,
                                        2
                                      ) ||
                                        t(
                                          "Readings are required before generating an invoice."
                                        )}
                                      {missingReasons(row.item.missingData) !==
                                        missingReasons(
                                          row.item.missingData,
                                          2
                                        ) && (
                                        <span class="sr-only">
                                          {" "}
                                          {missingReasons(row.item.missingData)}
                                        </span>
                                      )}
                                    </p>
                                  )}
                                </div>
                                {row.item.status === "MISSING_DATA" &&
                                summary.period.status !== "LOCKED" ? (
                                  <a
                                    class="attention-action"
                                    href={readingsHref(row.item)}
                                    data-open-drawer="readings"
                                    data-dwelling-id={row.item.dwellingId}
                                    aria-haspopup="dialog"
                                    aria-controls="admin-context-drawer"
                                  >
                                    {t("Enter readings")}
                                    <Icon name="arrow-right" size="xs" />
                                  </a>
                                ) : row.item.status === "OVERDUE" ? (
                                  <a
                                    class="attention-action"
                                    href={`${base}/payments?q=${encodeURIComponent(row.item.dwellingNumber)}`}
                                  >
                                    {t("Review payments")}
                                    <Icon name="arrow-right" size="xs" />
                                  </a>
                                ) : (
                                  <a
                                    class="attention-action"
                                    href={`${workbenchPath}?status=MISSING_DATA`}
                                  >
                                    {t("Open workbench")}
                                    <Icon name="arrow-right" size="xs" />
                                  </a>
                                )}
                              </article>
                            ) : (
                              <article
                                class="attention-row attention-summary-row"
                                data-tone={row.tone}
                                role="listitem"
                              >
                                <span
                                  class="attention-summary-icon"
                                  aria-hidden="true"
                                >
                                  <Icon name={row.icon} size="sm" />
                                </span>
                                <p>{row.label}</p>
                                <a class="attention-action" href={row.href}>
                                  {t(row.actionLabel)}
                                  <Icon name="arrow-right" size="xs" />
                                </a>
                              </article>
                            )
                          )}
                          {groupIndex === attentionGroups.length - 1 &&
                            hiddenAttentionCount > 0 && (
                              <div class="attention-more-row" role="listitem">
                                <span>
                                  {fill(t("+{n} more"), {
                                    n: hiddenAttentionCount,
                                  })}
                                </span>
                                <a href={attentionAllHref}>
                                  {fill(t("Show all ({n})"), {
                                    n: attentionItemCount,
                                  })}
                                  <Icon name="arrow-right" size="xs" />
                                </a>
                              </div>
                            )}
                        </div>
                      </div>
                    );
                  })}
                </div>
              )}
            </section>
          </div>

          <details class="dashboard-more panel">
            <summary class="chevron-toggle chevron-toggle-end">
              {t("Additional information")}
            </summary>
            <div class="dashboard-more-grid">
              {setupComplete && (
                <section
                  class="dashboard-readiness"
                  aria-labelledby="readiness-title"
                >
                  <h2 id="readiness-title">{t("Billing readiness")}</h2>
                  <ul>
                    <li data-ready="true">
                      <Icon name="check" size="xs" />
                      {t("Setup complete")}
                    </li>
                    <li data-ready={String(summary.readiness.billingReady)}>
                      <Icon
                        name={
                          summary.readiness.billingReady ? "check" : "clock"
                        }
                        size="xs"
                      />
                      {t("All readings entered")}:{" "}
                      {t(summary.readiness.billingReady ? "Done" : "To do")}
                    </li>
                    <li data-ready={String(summary.readiness.readyToSend)}>
                      <Icon
                        name={summary.readiness.readyToSend ? "check" : "clock"}
                        size="xs"
                      />
                      {t("Ready to send")}:{" "}
                      {t(summary.readiness.readyToSend ? "Done" : "To do")}
                    </li>
                  </ul>
                </section>
              )}
              <section aria-labelledby="case-status-title">
                <h2 id="case-status-title">{t("Case status")}</h2>
                <div class="dashboard-status-list">
                  {statuses.map((status) => (
                    <a href={`${workbenchPath}?status=${status}`}>
                      <StatusBadge status={status} />
                      <span>
                        {summary.caseStatusCounts[status]}
                        <Icon name="arrow-right" size="xs" />
                      </span>
                    </a>
                  ))}
                </div>
              </section>
              <section aria-labelledby="consumption-title">
                <h2 id="consumption-title">
                  <Icon name="droplet" size="sm" />
                  {t("Consumption")}
                </h2>
                <dl class="consumption-list">
                  <div>
                    <dt>{t("Cold water")}</dt>
                    <dd>
                      {formatNumber(summary.coldWaterConsumption, locale)} m³
                    </dd>
                  </div>
                  <div>
                    <dt>{t("Hot water")}</dt>
                    <dd>
                      {formatNumber(summary.hotWaterConsumption, locale)} m³
                    </dd>
                  </div>
                </dl>
                {summary.carriedForwardReadingCount > 0 && (
                  <p class="carried-readings-note">
                    {plural(
                      locale,
                      summary.carriedForwardReadingCount,
                      "Includes {n} reading carried over from the previous month.",
                      "Includes {n} readings carried over from the previous month."
                    )}
                  </p>
                )}
              </section>
            </div>
          </details>
        </div>
      )}
    </>
  )}
</AdminLayout>

<style>
  .dashboard-error {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    max-width: 48rem;
    padding: 1.5rem;
    border-color: var(--color-destructive);
  }
  .dashboard-error > :global(svg) {
    flex: 0 0 auto;
    color: var(--color-destructive);
  }
  .dashboard-error h1 {
    font-size: var(--text-2xl);
    line-height: 1.3;
    font-weight: 650;
  }
  .dashboard-error p {
    margin: 0.5rem 0 1rem;
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--color-muted);
  }

  /* The setup card is the month card's twin: same panel, lead and steps. */
  .dashboard-setup {
    /* The same width as the dashboard below it, also on wide screens. */
    max-width: var(--width-content);
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
  }
  .month-progress.setup-progress-steps {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  .setup-progress-steps .progress-detail {
    grid-column: 2;
  }
  @media (width < 70rem) {
    .month-progress.setup-progress-steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .setup-progress-steps .progress-marker {
    font-size: var(--text-xs);
    font-weight: 650;
  }
  .setup-progress-steps [data-state="current"] .progress-label {
    color: var(--color-primary);
  }
  /* The whole step is the link; hovering tints it with room around the text. */
  .setup-progress-steps li {
    isolation: isolate;
  }
  .setup-progress-steps .progress-marker,
  .setup-progress-steps .progress-detail {
    pointer-events: none;
  }
  .setup-progress-steps .progress-label a::after {
    content: "";
    position: absolute;
    inset: 0 -0.5rem -0.75rem;
    z-index: -1;
    border-radius: 0 0 var(--radius-control) var(--radius-control);
  }
  .setup-progress-steps .progress-label a:hover::after {
    background: var(--color-nav-active-bg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .setup-progress-steps .progress-label a::after {
      transition: background-color var(--duration-fast) ease;
    }
  }

  .dashboard-page {
    display: grid;
    gap: 1.5rem;
    /* Starts on the breadcrumbs' left edge, like every other page. */
    max-width: var(--width-content);
  }
  .dashboard-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .dashboard-heading {
    min-width: 0;
  }
  .dashboard-title-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    min-width: 0;
  }
  .dashboard-title-row h1 {
    font-size: var(--text-display-md);
    line-height: 1.2;
    overflow-wrap: break-word;
  }
  .dashboard-period-context {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    flex-basis: 100%;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .dashboard-period-nav {
    display: flex;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-surface);
  }
  .dashboard-period-nav > * {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    font-size: var(--text-sm);
  }
  .dashboard-period-nav > * + * {
    border-inline-start: 1px solid var(--color-border);
  }
  .dashboard-period-nav > :first-child {
    border-start-start-radius: var(--radius-control);
    border-end-start-radius: var(--radius-control);
  }
  .dashboard-period-nav > :last-child {
    border-start-end-radius: var(--radius-control);
    border-end-end-radius: var(--radius-control);
  }
  .dashboard-attention :global(.empty-state) {
    border: 0;
  }
  .dashboard-period-nav a {
    color: var(--color-primary);
    font-weight: 600;
  }
  .dashboard-period-nav a:hover {
    background: var(--color-surface-hover);
  }
  .dashboard-period-nav [aria-disabled] {
    color: var(--color-muted);
    background: var(--color-canvas);
    cursor: default;
  }
  .period-label-mobile {
    display: none;
  }
  .dashboard-metrics {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 1rem;
  }
  /* Collection: what has come in, as one figure and one bar. Received leads;
     what is still unpaid is the rest of the same bar, so it is not a card. */
  .dashboard-metric.dashboard-collection {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
  }
  .collection-head {
    padding-right: 2.5rem;
  }
  .collection-overview {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }
  .collection-hero {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .collection-link {
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }
  .collection-link:hover strong {
    text-decoration: underline;
  }
  .dashboard-collection .collection-received {
    font-size: var(--text-display-lg);
    line-height: 1.1;
    white-space: nowrap;
  }
  /* A share is neutral until it is complete; only then is it good news. */
  .collection-share {
    color: var(--color-foreground);
    font-size: var(--text-xl);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .collection-share[data-complete] {
    color: var(--color-success);
  }
  .metric-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .collection-bar {
    height: 0.625rem;
    overflow: hidden;
    border-radius: 999px;
    background: var(--color-surface-hover);
  }
  .collection-bar > span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--color-success);
  }
  /* The same bar on the Readings card, in the primary colour: progress, not
     money. */
  .metric-bar {
    grid-column: 1 / -1;
    height: 0.625rem;
    overflow: hidden;
    border-radius: 999px;
    background: var(--color-surface-hover);
  }
  .metric-bar > span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--color-primary);
  }
  .collection-foot {
    display: flex;
