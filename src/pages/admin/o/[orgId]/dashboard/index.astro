      row-gap: 0.75rem;
    }
    .month-progress li {
      padding: 0.875rem 0.5rem 0.375rem 0;
    }
    .month-progress li + li {
      padding-left: 0;
    }
    .month-progress li:nth-child(even) {
      padding-left: 0.75rem;
    }
    .progress-detail {
      grid-column: 1 / -1;
    }
  }
  .progress-marker {
    display: grid;
    place-items: center;
    width: 1.5rem;
