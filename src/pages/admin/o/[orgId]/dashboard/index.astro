---
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import {
  ForbiddenError,
  requireOrganizationAccess,
} from "../../../../../domain/authorization/guards";
import { getOrganization } from "../../../../../domain/organizations/organizations";
import {
  getCurrentOpenPeriod,
  listPeriods,
} from "../../../../../domain/periods/periods";
import {
  getDashboardSummary,
  type DashboardSummary,
} from "../../../../../domain/periods/dashboard";
import { withRequestDb } from "../../../../../lib/db-request";

const organizationId = Astro.params.orgId!;
try {
  requireOrganizationAccess(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const requestedPeriodId = Astro.url.searchParams.get("periodId");

let organization: Awaited<ReturnType<typeof getOrganization>>;
let allPeriods: Awaited<ReturnType<typeof listPeriods>>;
let summary: DashboardSummary | null = null;
let attentionCases: Awaited<ReturnType<typeof listCasesForPeriod>> = [];
try {
  ({ organization, allPeriods, summary } = await withRequestDb(async (db) => {
    const org = await getOrganization(db, organizationId);
    const periods = await listPeriods(db, organizationId);

    let periodId: string | undefined = requestedPeriodId || undefined;
    if (!periodId) {
      const openPeriod = await getCurrentOpenPeriod(db, organizationId);
      if (openPeriod) {
        periodId = openPeriod.id;
      } else if (periods.length > 0) {
        periodId = periods[0].id;
      }
    }

    const summary = periodId
      ? await getDashboardSummary(db, organizationId, periodId)
      : null;

    if (periodId)
      attentionCases = await listCasesForPeriod(db, organizationId, periodId);
    return { organization: org, allPeriods: periods, summary };
  }));
} catch {
  return Astro.redirect(`/admin/o/${organizationId}/periods`);
}

const currentIndex = summary
  ? allPeriods.findIndex((p) => p.id === summary.period.id)
  : -1;
const previousPeriod =
  currentIndex >= 0 && currentIndex < allPeriods.length - 1
    ? allPeriods[currentIndex + 1]
    : null;
const nextPeriod = currentIndex > 0 ? allPeriods[currentIndex - 1] : null;

import PageHeader from "../../../../../components/ui/PageHeader.astro";
import FacadeAccent from "../../../../../components/ui/FacadeAccent.astro";
import KpiCard from "../../../../../components/ui/KpiCard.astro";
import StatusBadge from "../../../../../components/ui/StatusBadge.astro";
import EmptyState from "../../../../../components/ui/EmptyState.astro";
import AdminContextDrawer from "../../../../../components/ui/AdminContextDrawer.astro";
import Icon from "../../../../../components/ui/Icon.astro";
import { listCasesForPeriod } from "../../../../../domain/periods/cases";
import {
  translate,
  uiLocale,
  formatMoney,
  formatNumber,
  formatPeriod,
  entityLabel,
} from "../../../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
const base = "/admin/o/" + organizationId;
const statuses = [
  "MISSING_DATA",
  "READY",
  "DRAFT",
  "PREPARED",
  "OVERDUE",
  "SENT",
  "PAID",
] as const;
---

<AdminLayout
  title={t("Dashboard") + " - " + organization.name}
  organizationId={organizationId}
  organizationName={organization.name}
>
  {
    !summary ? (
      <div class="space-y-6">
        <PageHeader
          title={t("Dashboard")}
          eyebrow={organization.name}
          description={t(
            "Monitor billing, payments and work requiring attention."
          )}
          display
        />
        <EmptyState
          ornament
          title={t("No billing periods yet.")}
          description={t(
            "Create a period to start the monthly billing workflow."
          )}
        >
          <a class="btn-primary" href={base + "/periods"}>
            {t("Create period")}
          </a>
        </EmptyState>
      </div>
    ) : (
      <div class="space-y-6">
        <AdminContextDrawer
          organizationId={organizationId}
          periodId={summary.period.id}
          periodStatus={summary.period.status}
          periodName={formatPeriod(
            summary.period.year,
            summary.period.month,
            locale
          )}
          workbenchPath={base + "/periods/" + summary.period.id}
          refreshSelectors={[".dashboard-attention", ".dashboard-case-status"]}
        />
        <header class="page-header">
          <div>
            <p class="eyebrow">{organization.name}</p>
            <div class="flex flex-wrap items-center gap-3">
              <h1 class="font-display">
                {formatPeriod(
                  summary.period.year,
                  summary.period.month,
                  locale
                )}
              </h1>
              <StatusBadge status={summary.period.status} />
            </div>
            <FacadeAccent />
          </div>
          <div class="page-actions">
            <a
              class="btn-primary"
              href={base + "/periods/" + summary.period.id}
            >
              {t("Open workbench")}
              <Icon name="arrow-right" size="sm" />
            </a>
          </div>
        </header>
        <nav
          class="dashboard-period-nav text-body-sm text-muted"
          aria-label={t("Period navigation")}
        >
          {previousPeriod ? (
            <a
              href={base + "/dashboard?periodId=" + previousPeriod.id}
              class="flex items-center gap-1 hover:text-foreground hover:underline"
            >
              <Icon name="arrow-left" size="xs" />
              {formatPeriod(previousPeriod.year, previousPeriod.month, locale)}
            </a>
          ) : (
            <span class="flex items-center gap-1" aria-disabled="true">
              <Icon name="arrow-left" size="xs" />
              {t("Previous period")}
            </span>
          )}
          {nextPeriod ? (
            <a
              href={base + "/dashboard?periodId=" + nextPeriod.id}
              class="flex items-center gap-1 hover:text-foreground hover:underline"
            >
              {formatPeriod(nextPeriod.year, nextPeriod.month, locale)}
              <Icon name="arrow-right" size="xs" />
            </a>
          ) : (
            <span class="flex items-center gap-1" aria-disabled="true">
              {t("Next period")}
              <Icon name="arrow-right" size="xs" />
            </span>
          )}
        </nav>
        <div class="grid gap-4 sm:grid-cols-3">
          <>
            <KpiCard
              icon="invoice"
              label={t("Total invoiced")}
              value={formatMoney(
                summary.totalInvoiced,
                organization.currency,
                locale
              )}
            />
            <KpiCard
              icon="coins"
              label={t("Paid")}
              tone="success"
              value={formatMoney(
                summary.totalPaid,
                organization.currency,
                locale
              )}
            />
            <KpiCard
              icon="clock"
              label={t("Outstanding")}
              tone="warning"
              value={formatMoney(
                summary.totalOutstanding,
                organization.currency,
                locale
              )}
            />
          </>
        </div>
        <div class="grid items-start gap-6 xl:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
          <section class="dashboard-attention">
            <div class="mb-4 flex items-center justify-between">
              <>
                <h2 class="font-semibold">{t("Needs attention")}</h2>
                <span class="text-body-sm text-muted">
                  {summary.needsAttention.length}
                </span>
              </>
            </div>
            {summary.needsAttention.length === 0 ? (
              <EmptyState title={t("Nothing needs attention right now.")} />
            ) : (
              <div class="panel divide-y divide-border">
                {attentionCases
                  .filter(
                    (c) => c.status === "MISSING_DATA" || c.status === "OVERDUE"
                  )
                  .map((c) => {
                    // missingData is a JSONB column with no schema
                    // enforcement: cases whose readiness was last computed by
                    // an older app version can still carry a legacy
                    // plain-string shape instead of today's {meterType,
                    // label, reason} object (see the same fix in
                    // periods/[periodId]/index.astro).
                    const missing = c.missingData as (
                      | { label: string | null; meterType: string }
                      | { billingRuleId: string; ruleName: string }
                      | string
                    )[];
                    const overdue = c.status === "OVERDUE";
                    const href = overdue
                      ? base + "/payments"
                      : base + "/periods/" + summary.period.id;
                    return (
                      <div
                        class="dashboard-attention-row flex flex-wrap items-start justify-between gap-3 p-4"
                        data-overdue={overdue}
                      >
                        <div class="min-w-0">
                          <div class="mb-2 flex flex-wrap items-center gap-3">
                            <a
                              class="btn-secondary btn-sm"
                              href={base + "/dwellings/" + c.dwellingId}
                            >
                              <Icon name="building" size="sm" />
                              {t("Dwelling")} {c.dwellingNumber}
                            </a>
                            <StatusBadge status={c.status} />
                          </div>
                          <p class="text-body-sm text-muted">
                            {overdue
                              ? t(
                                  "Payment is past its due date. Review reconciliation."
                                )
                              : missing.length
                                ? missing
                                    .map((m) =>
                                      typeof m === "string"
                                        ? m
                                        : "billingRuleId" in m
                                          ? m.ruleName
                                          : (m.label ??
                                            entityLabel(m.meterType, locale))
                                    )
                                    .join(", ")
                                : t(
                                    "All readings are present. Generate the invoice in the workbench."
                                  )}
                          </p>
                          {missing.length > 0 && (
                            <p class="mt-1 text-caption text-muted">
                              {t(
                                "Readings are required before generating an invoice."
                              )}
                            </p>
                          )}
                        </div>
                        {missing.length > 0 &&
                        !overdue &&
                        summary.period.status !== "LOCKED" ? (
                          <button
                            type="button"
                            class="btn-secondary btn-sm"
                            data-open-drawer="readings"
                            data-dwelling-id={c.dwellingId}
                          >
                            {t("Add readings")}
                            <Icon name="arrow-right" size="sm" />
                          </button>
                        ) : (
                          <a class="btn-secondary btn-sm" href={href}>
                            {t(overdue ? "Review payments" : "Open workbench")}
                            <Icon name="arrow-right" size="sm" />
                          </a>
                        )}
                      </div>
                    );
                  })}
              </div>
            )}
          </section>
          <div class="space-y-6">
            <>
              <section class="dashboard-case-status panel p-5">
                <>
                  <h2 class="section-title">{t("Case status")}</h2>
                  <div class="space-y-1">
                    {statuses.map((status) => (
                      <a
                        class="dashboard-status-link text-body-sm"
                        href={
                          base +
                          "/periods/" +
                          summary.period.id +
                          "?status=" +
                          status
                        }
                      >
                        <StatusBadge status={status} />
                        <span class="dashboard-status-count font-semibold tabular-nums">
                          {summary.caseStatusCounts[status]}
                          <Icon name="arrow-right" size="xs" />
                        </span>
                      </a>
                    ))}
                  </div>
                </>
              </section>
              <section class="panel p-5">
                <>
                  <h2 class="section-title flex items-center gap-2">
                    <Icon name="droplet" size="sm" class="text-muted" />
                    {t("Consumption")}
                  </h2>
                  <dl class="space-y-3 text-body-sm">
                    <>
                      <div class="flex justify-between gap-3">
                        <>
                          <dt class="text-muted">{t("Cold water")}</dt>
                          <dd class="font-semibold tabular-nums">
                            {formatNumber(summary.coldWaterConsumption, locale)}{" "}
                            m³
                          </dd>
                        </>
                      </div>
                      <div class="flex justify-between gap-3">
                        <>
                          <dt class="text-muted">{t("Hot water")}</dt>
                          <dd class="font-semibold tabular-nums">
                            {formatNumber(summary.hotWaterConsumption, locale)}{" "}
                            m³
                          </dd>
                        </>
                      </div>
                    </>
                  </dl>
                </>
              </section>
            </>
          </div>
        </div>
      </div>
    )
  }
</AdminLayout>

<style>
  .dashboard-period-nav {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.25rem;
  }
  .dashboard-period-nav > a,
  .dashboard-period-nav > span {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    border-radius: var(--radius-control);
  }
  .dashboard-period-nav > :last-child {
    justify-content: flex-end;
    text-align: end;
  }
  .dashboard-period-nav > a:hover {
    color: var(--color-primary);
    background: var(--color-surface-hover);
  }
  .dashboard-period-list {
    padding-inline: 0.75rem;
    font-weight: 600;
  }

  .dashboard-totals :global(.kpi[data-tone="success"] .kpi-icon) {
    color: var(--color-success);
    background: var(--color-badge-success-bg);
  }
  .dashboard-totals :global(.kpi[data-tone="warning"] .kpi-icon) {
    color: var(--color-warning);
    background: var(--color-badge-warning-bg);
  }

  .dashboard-attention-row {
    position: relative;
  }
  .dashboard-attention-row[data-overdue="true"]::before {
    background: var(--color-destructive);
  }
  .dashboard-status-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding-inline: 0.5rem;
    border-radius: var(--radius-control);
  }

  .dashboard-status-count {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .dashboard-status-count :global(svg) {
    color: var(--color-muted);
  }
</style>
