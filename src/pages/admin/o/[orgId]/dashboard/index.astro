  }
  .month-status-lead .btn-primary {
    flex: 0 0 auto;
    min-width: max-content;
    white-space: nowrap;
  }
  .dashboard-section-heading h2,
  .dashboard-more h2,
  .money-reconciliation h2 {
    font-size: 1.25rem;
    line-height: 1.4;
    font-weight: 650;
  }
  /* The one focal point of the band. */
  .month-status-sentence {
    min-width: 0;
    font-size: 1.375rem;
    line-height: 1.25;
    font-weight: 600;
    color: var(--color-foreground);
  }
  .month-status-link,
  .dashboard-section-heading > a,
  .attention-action {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
