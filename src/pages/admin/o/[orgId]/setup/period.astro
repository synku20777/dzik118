---
import {
  formatDate,
  formatPeriod,
  friendlyActionErrorMessage,
  translate,
  uiLocale,
} from "../../../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);

import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import FieldError from "../../../../../components/ui/FieldError.astro";
import SetupSteps from "../../../../../components/ui/SetupSteps.astro";
import PageHeader from "../../../../../components/ui/PageHeader.astro";
import { actions } from "astro:actions";
import {
  ForbiddenError,
  requireActiveOrganization,
} from "../../../../../domain/authorization/guards";
import { ConflictError } from "../../../../../domain/errors";
import { getOrganization } from "../../../../../domain/organizations/organizations";
import { getSetupProgress } from "../../../../../domain/onboarding/progress";
import { getFirstBillingPeriod } from "../../../../../domain/periods/periods";
import { withRequestDb } from "../../../../../lib/db-request";
import { orgLocalDateString } from "../../../../../lib/org-time";

const organizationId = Astro.params.orgId!;
try {
  requireActiveOrganization(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  if (err instanceof ConflictError)
    return Astro.redirect(`/admin/o/${organizationId}/dashboard`);
  throw err;
}

const result = Astro.getActionResult(actions.periods.create);
if (result?.data) {
  return Astro.redirect(`/admin/o/${organizationId}/setup/charges`);
}

const { organization, progress, firstPeriod } = await withRequestDb(
  async (db) => {
    const organization = await getOrganization(db, organizationId);
    return {
      organization,
      progress: await getSetupProgress(db, organizationId, organization),
      firstPeriod: await getFirstBillingPeriod(db, organizationId),
    };
  }
);

const localDate = orgLocalDateString(new Date(), organization.timezone);
const [yearStr, monthStr] = localDate.split("-");
const defaultYear = Number(yearStr);
const defaultMonth = Number(monthStr);

const lastDay = new Date(Date.UTC(defaultYear, defaultMonth, 0)).getUTCDate();
const defaultStartsOn = `${defaultYear}-${String(defaultMonth).padStart(2, "0")}-01`;
const defaultEndsOn = `${defaultYear}-${String(defaultMonth).padStart(2, "0")}-${String(lastDay).padStart(2, "0")}`;

const defaultInvoiceIssueDate = defaultEndsOn;
const issueDateUtc = new Date(Date.UTC(defaultYear, defaultMonth - 1, lastDay));
const defaultDueDays = organization.defaultDueDays ?? 14;
const dueDateUtc = new Date(
  issueDateUtc.getTime() + defaultDueDays * 86_400_000
);
const defaultInvoiceDueDate = dueDateUtc.toISOString().slice(0, 10);
---

<AdminLayout
  title={`${t("First billing period")} - ${organization.name}`}
  organizationId={organizationId}
  organizationName={organization.name}
>
  <div class="setup-page space-y-6">
    <PageHeader
      title={t("First billing period")}
      description={t(
        "This is the first month you bill in Namkopa. Meter starting readings are stored for the month before it."
      )}
    />
    <SetupSteps
      organizationId={organizationId}
      current="period"
      steps={progress.steps}
    />

    {
      firstPeriod ? (
        <div class="space-y-6 max-w-3xl">
          {progress.firstPeriodLocked && (
            <p class="notice notice-warning" role="alert">
              {t(
                "The first billing period is locked. Reopen it on the period page before you change charges or meters."
              )}
            </p>
          )}

          <div class="rounded-panel border border-border bg-surface p-6 space-y-4">
            <h2 class="text-base font-semibold text-foreground">
              {t("Your first billing period")}
            </h2>
            <div class="space-y-2 text-sm">
              <p class="font-medium text-foreground text-lg">
                {formatPeriod(firstPeriod.year, firstPeriod.month, locale)}
              </p>
              <p class="text-muted">
                {formatDate(firstPeriod.startsOn, locale)} →{" "}
                {formatDate(firstPeriod.endsOn, locale)}
              </p>
              <div class="pt-2">
                <a
                  href={`/admin/o/${organizationId}/periods/${firstPeriod.id}`}
                  class="btn-secondary btn-sm inline-flex items-center gap-2"
                >
                  {t("Open period")} →
                </a>
              </div>
            </div>
          </div>

          <div class="setup-actions">
            <a
              href={`/admin/o/${organizationId}/setup/dwellings`}
              class="btn-secondary"
            >
              {t("Back")}
            </a>
            <a
              href={`/admin/o/${organizationId}/setup/charges`}
              class="btn-primary"
            >
              {t("Continue")}
            </a>
          </div>
        </div>
      ) : (
        <div class="space-y-6 max-w-3xl">
          {result?.error && (
            <p class="notice notice-danger" role="alert">
              {friendlyActionErrorMessage(result.error, locale)}
            </p>
          )}

          <form
            method="POST"
            action={actions.periods.create}
            class="rounded-panel border border-border bg-surface p-6 space-y-6"
          >
            <input type="hidden" name="organizationId" value={organizationId} />

            <fieldset class="space-y-4">
              <legend class="text-base font-semibold text-foreground">
                {t("Period")}
              </legend>

              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                  <label
                    for="year"
                    class="block text-sm font-medium text-foreground"
                  >
                    {t("Year")}
                  </label>
                  <input
                    id="year"
                    name="year"
                    type="number"
                    inputmode="decimal"
                    min="2000"
                    max="2200"
                    required
                    value={defaultYear}
                    aria-describedby="year-error"
                    class="mt-1 block w-full rounded-control border border-border bg-surface px-3 py-2 text-sm text-foreground"
                  />
                  <FieldError name="year" error={result?.error} />
                </div>

                <div>
                  <label
                    for="month"
                    class="block text-sm font-medium text-foreground"
                  >
                    {t("Month")}
                  </label>
                  <input
                    id="month"
                    name="month"
                    type="number"
                    inputmode="decimal"
                    min="1"
                    max="12"
                    required
                    value={defaultMonth}
                    aria-describedby="month-error"
                    class="mt-1 block w-full rounded-control border border-border bg-surface px-3 py-2 text-sm text-foreground"
                  />
                  <FieldError name="month" error={result?.error} />
                </div>
              </div>
            </fieldset>

            <fieldset class="space-y-4 pt-4 border-t border-border">
              <legend class="text-base font-semibold text-foreground">
                {t("Billing window")}
              </legend>

              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                  <label
                    for="startsOn"
                    class="block text-sm font-medium text-foreground"
                  >
                    {t("Starts on")}
                  </label>
                  <input
                    id="startsOn"
                    name="startsOn"
                    type="date"
                    required
                    value={defaultStartsOn}
                    aria-describedby="startsOn-error"
                    class="mt-1 block w-full rounded-control border border-border bg-surface px-3 py-2 text-sm text-foreground"
                  />
                  <FieldError name="startsOn" error={result?.error} />
                </div>

                <div>
                  <label
                    for="endsOn"
                    class="block text-sm font-medium text-foreground"
                  >
                    {t("Ends on")}
                  </label>
                  <input
                    id="endsOn"
                    name="endsOn"
                    type="date"
                    required
                    value={defaultEndsOn}
                    aria-describedby="endsOn-error"
                    class="mt-1 block w-full rounded-control border border-border bg-surface px-3 py-2 text-sm text-foreground"
                  />
                  <FieldError name="endsOn" error={result?.error} />
                </div>
              </div>

              <div>
                <label
                  for="readingDeadline"
                  class="block text-sm font-medium text-foreground"
                >
                  {t("Reading deadline")}
                </label>
                <input
                  id="readingDeadline"
                  name="readingDeadline"
                  type="date"
                  value=""
                  aria-describedby="readingDeadline-error"
                  class="mt-1 block w-full rounded-control border border-border bg-surface px-3 py-2 text-sm text-foreground sm:w-1/2"
                />
                <FieldError name="readingDeadline" error={result?.error} />
              </div>
            </fieldset>

            <fieldset class="space-y-4 pt-4 border-t border-border">
              <legend class="text-base font-semibold text-foreground">
                {t("Invoice dates")}
              </legend>

              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                  <label
                    for="invoiceIssueDate"
                    class="block text-sm font-medium text-foreground"
                  >
                    {t("Invoice issue date")}
                  </label>
                  <input
                    id="invoiceIssueDate"
                    name="invoiceIssueDate"
                    type="date"
                    required
                    value={defaultInvoiceIssueDate}
                    aria-describedby="invoiceIssueDate-error"
                    class="mt-1 block w-full rounded-control border border-border bg-surface px-3 py-2 text-sm text-foreground"
                  />
                  <FieldError name="invoiceIssueDate" error={result?.error} />
                </div>

                <div>
                  <label
                    for="invoiceDueDate"
                    class="block text-sm font-medium text-foreground"
                  >
                    {t("Invoice due date")}
                  </label>
                  <input
                    id="invoiceDueDate"
                    name="invoiceDueDate"
                    type="date"
                    required
                    value={defaultInvoiceDueDate}
                    aria-describedby="invoiceDueDate-error"
                    class="mt-1 block w-full rounded-control border border-border bg-surface px-3 py-2 text-sm text-foreground"
                  />
                  <FieldError name="invoiceDueDate" error={result?.error} />
                </div>
              </div>
            </fieldset>

            <div class="setup-actions">
              <a
                href={`/admin/o/${organizationId}/setup/dwellings`}
                class="btn-secondary"
              >
                {t("Back")}
              </a>
              <div class="flex items-center gap-3">
                <a
                  href={`/admin/o/${organizationId}/setup/charges`}
                  class="btn-secondary"
                >
                  {t("Skip for now")}
                </a>
                <button type="submit" class="btn-primary">
                  {t("Create period and continue")}
                </button>
              </div>
            </div>
          </form>
        </div>
      )
    }
  </div>
</AdminLayout>
