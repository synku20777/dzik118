---
import { translate, uiLocale } from "../../../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);

import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import FieldError from "../../../../../components/ui/FieldError.astro";
import SetupLayout from "../../../../../components/ui/SetupLayout.astro";
import { actions } from "astro:actions";
import {
  ForbiddenError,
  requireActiveOrganization,
} from "../../../../../domain/authorization/guards";
import { ConflictError } from "../../../../../domain/errors";
import { getOrganization } from "../../../../../domain/organizations/organizations";
import { getSetupProgress } from "../../../../../domain/onboarding/progress";
import { withRequestDb } from "../../../../../lib/db-request";
import { friendlyActionErrorMessage } from "../../../../../lib/ui/i18n";
import { fieldErrorAttrs } from "../../../../../lib/ui/field-error-attrs";

const organizationId = Astro.params.orgId!;
try {
  requireActiveOrganization(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  if (err instanceof ConflictError)
    return Astro.redirect(`/admin/o/${organizationId}/dashboard`);
  throw err;
}

const result = Astro.getActionResult(actions.organizations.saveSetupDetails);
if (result?.data) {
  return Astro.redirect(`/admin/o/${organizationId}/setup/dwellings`);
}

// After a rejected save, show what was typed, not the stored values.
let submitted: FormData | null = null;
if (result?.error) {
  try {
    submitted = await Astro.request.formData();
  } catch {
    submitted = null;
  }
}
const val = (name: string, fallback: string) =>
  submitted ? String(submitted.get(name) ?? "") : fallback;

const { organization, progress } = await withRequestDb(async (db) => {
  const organization = await getOrganization(db, organizationId);
  return {
    organization,
    progress: await getSetupProgress(db, organizationId, organization),
  };
});

interface SetupField {
  name: string;
  label: string;
  value: string | null;
  type?: "email" | "tel";
  autocomplete?: string;
  spellcheck?: boolean;
  required?: boolean;
  fullWidth?: boolean;
}

const invoiceFields: SetupField[] = [
  {
    name: "bankName",
    label: "Bank name",
    value: organization.bankName,
    required: true,
  },
  { name: "bic", label: "BIC", value: organization.bic, spellcheck: false },
  {
    name: "iban",
    label: "IBAN",
    value: organization.iban,
    spellcheck: false,
    required: true,
    fullWidth: true,
  },
  {
    name: "registrationNumber",
    label: "Registration number",
    value: organization.registrationNumber,
  },
  {
    name: "vatNumber",
    label: "VAT number",
    value: organization.vatNumber,
  },
];

const groups: {
  id: string;
  title: string;
  fields: SetupField[];
}[] = [
  {
    id: "organization-address",
    title: "Name and address",
    fields: [
      {
        name: "name",
        label: "Name",
        value: organization.name,
        autocomplete: "organization",
        required: true,
        fullWidth: true,
      },
      {
        name: "addressLine1",
        label: "Address line 1",
        value: organization.addressLine1,
        autocomplete: "address-line1",
        required: true,
        fullWidth: true,
      },
      {
        name: "addressLine2",
        label: "Address line 2",
        value: organization.addressLine2,
        autocomplete: "address-line2",
        fullWidth: true,
      },
      {
        name: "city",
        label: "City",
        value: organization.city,
        autocomplete: "address-level2",
      },
      {
        name: "postalCode",
        label: "Postal code",
        value: organization.postalCode,
        autocomplete: "postal-code",
      },
    ],
  },
  {
    id: "organization-invoice",
    title: "Invoice details",
    fields: invoiceFields,
  },
  {
    id: "organization-contacts",
    title: "Contact details",
    fields: [
      {
        name: "email",
        label: "Email",
        value: organization.email,
        type: "email",
        autocomplete: "work email",
        spellcheck: false,
      },
      {
        name: "phone",
        label: "Phone",
        value: organization.phone,
        type: "tel",
        autocomplete: "work tel",
      },
    ],
  },
];
---

<AdminLayout
  title={`${t("Organization details")} - ${organization.name}`}
  organizationId={organizationId}
  organizationName={organization.name}
  breadcrumbs={[
    { label: t("Setup"), href: `/admin/o/${organizationId}/setup` },
    { label: t("Organization details") },
  ]}
>
  <SetupLayout
    title={t("Organization details")}
    description={t(
      "This information is used on invoices and for official communication."
    )}
    organizationId={organizationId}
    current="organization"
    steps={progress.steps}
  >
    {result?.error && (
      <p class="notice notice-danger" role="alert">
        {friendlyActionErrorMessage(result.error, locale)}
      </p>
    )}

    <form
      id="organization-form"
      method="POST"
      action={actions.organizations.saveSetupDetails}
      class="organization-form panel"
    >
      <input type="hidden" name="organizationId" value={organizationId} />

      {groups.map((group) => (
        <section class="organization-form-section" aria-labelledby={group.id}>
          <h2 class="text-h3" id={group.id}>
            {t(group.title)}
          </h2>
          {group.id === "organization-address" && (
            <p class="setup-required-note">
              {t("Red dots mark required fields.")}
            </p>
          )}
          <div class="field-group">
            {group.fields.map((field) => (
              <div
                class:list={[
                  "field-box",
                  {
                    "field-span": field.fullWidth,
                    "is-required": field.required,
                  },
                ]}
              >
                <label for={field.name}>{t(field.label)}</label>
                <input
                  id={field.name}
                  name={field.name}
                  type={field.type ?? "text"}
                  autocomplete={
                    field.autocomplete &&
                    `section-organization ${field.autocomplete}`
                  }
                  spellcheck={field.spellcheck}
                  required={field.required}
                  value={val(field.name, field.value ?? "")}
                  {...fieldErrorAttrs(result?.error, field.name)}
                />
              </div>
            ))}
          </div>
          {group.fields.map(({ name, label }) => (
            <FieldError name={name} label={t(label)} error={result?.error} />
          ))}
        </section>
      ))}

      <div class="setup-actions">
        <a href={`/admin/o/${organizationId}/setup`} class="btn-secondary">
          {t("Back")}
        </a>
        <div>
          {progress.steps.organization && (
            <a
              href={`/admin/o/${organizationId}/setup/dwellings`}
              class="btn-secondary"
            >
              {t("Continue without saving")}
            </a>
          )}
          <button type="submit" class="btn-primary">
            {t("Save and continue")}
          </button>
        </div>
      </div>
    </form>
  </SetupLayout>
</AdminLayout>

<style>
  .organization-form {
    display: grid;
    gap: var(--gap-section);
    padding: var(--pad-panel-compact);
  }
  .organization-form-section {
    min-width: 0;
  }
  .organization-form-section > :is(h2, .setup-required-note) {
    margin-block-end: var(--space-2);
  }
  @media (width >= 40rem) {
    .organization-form {
      padding: var(--pad-panel);
    }
  }
</style>
