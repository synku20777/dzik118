---
import { translate, uiLocale } from "../../../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);

import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import FieldError from "../../../../../components/ui/FieldError.astro";
import Icon from "../../../../../components/ui/Icon.astro";
import SetupLayout from "../../../../../components/ui/SetupLayout.astro";
import { actions } from "astro:actions";
import {
  ForbiddenError,
  requireActiveOrganization,
} from "../../../../../domain/authorization/guards";
import { ConflictError } from "../../../../../domain/errors";
import { getOrganization } from "../../../../../domain/organizations/organizations";
import { getSetupProgress } from "../../../../../domain/onboarding/progress";
import { withRequestDb } from "../../../../../lib/db-request";
import { friendlyActionErrorMessage } from "../../../../../lib/ui/i18n";
import { fieldErrorAttrs } from "../../../../../lib/ui/field-error-attrs";

const organizationId = Astro.params.orgId!;
try {
  requireActiveOrganization(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  if (err instanceof ConflictError)
    return Astro.redirect(`/admin/o/${organizationId}/dashboard`);
  throw err;
}

const result = Astro.getActionResult(actions.organizations.update);
if (result?.data) {
  return Astro.redirect(`/admin/o/${organizationId}/setup/dwellings`);
}

// After a rejected save, show what was typed, not the stored values.
let submitted: FormData | null = null;
if (result?.error) {
  try {
    submitted = await Astro.request.formData();
  } catch {
    submitted = null;
  }
}
const val = (name: string, fallback: string | number) =>
  submitted ? String(submitted.get(name) ?? "") : fallback;

const { organization, progress } = await withRequestDb(async (db) => {
  const organization = await getOrganization(db, organizationId);
  return {
    organization,
    progress: await getSetupProgress(db, organizationId, organization),
  };
});
---

<AdminLayout
  title={`${t("Organization details")} - ${organization.name}`}
  organizationId={organizationId}
  organizationName={organization.name}
  breadcrumbs={[
    { label: t("Setup"), href: `/admin/o/${organizationId}/setup` },
    { label: t("Organization details") },
  ]}
>
  <SetupLayout
    title={t("Organization details")}
    description={t(
      "Start with your organization’s name and address. Add payment details now or before preparing invoices."
    )}
    organizationId={organizationId}
    current="organization"
    steps={progress.steps}
  >
    {result?.error && (
      <p class="notice notice-danger" role="alert">
        {friendlyActionErrorMessage(result.error, locale)}
      </p>
    )}

    <form
      method="POST"
      action={actions.organizations.update}
      class="box space-y-6"
    >
      <input type="hidden" name="organizationId" value={organizationId} />
      {(
        [
          "autoGenerateEnabled",
          "autoSendEnabled",
          "carryForwardReadingsEnabled",
        ] as const
      ).map((name) => (
        <input type="hidden" name={name} value={String(organization[name])} />
      ))}

      <p class="setup-required-note">{t("Fields marked * are required.")}</p>

      <fieldset class="space-y-4">
        <legend class="text-base font-semibold text-foreground">
          {t("Organization")}
        </legend>

        <div>
          <label for="name" class="field-label">
            {t("Name")}
          </label>
          <input
            id="name"
            name="name"
            type="text"
            required
            value={val("name", organization.name)}
            class="mt-1 block w-full text-sm"
            {...fieldErrorAttrs(result?.error, "name")}
          />
          <FieldError name="name" error={result?.error} />
        </div>

        <div>
          <label for="addressLine1" class="field-label">
            {t("Address line 1")}
          </label>
          <input
            id="addressLine1"
            name="addressLine1"
            type="text"
            required
            value={val("addressLine1", organization.addressLine1)}
            class="mt-1 block w-full text-sm"
            {...fieldErrorAttrs(result?.error, "addressLine1")}
          />
          <FieldError name="addressLine1" error={result?.error} />
        </div>

        <div>
          <label for="addressLine2" class="field-label">
            {t("Address line 2")}
          </label>
          <input
            id="addressLine2"
            name="addressLine2"
            type="text"
            value={val("addressLine2", organization.addressLine2 ?? "")}
            class="mt-1 block w-full text-sm"
            {...fieldErrorAttrs(result?.error, "addressLine2")}
          />
          <FieldError name="addressLine2" error={result?.error} />
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="city" class="field-label">
              {t("City")}
            </label>
            <input
              id="city"
              name="city"
              type="text"
              value={val("city", organization.city ?? "")}
              class="mt-1 block w-full text-sm"
              {...fieldErrorAttrs(result?.error, "city")}
            />
            <FieldError name="city" error={result?.error} />
          </div>

          <div>
            <label for="postalCode" class="field-label">
              {t("Postal code")}
            </label>
            <input
              id="postalCode"
              name="postalCode"
              type="text"
              value={val("postalCode", organization.postalCode ?? "")}
              class="mt-1 block w-full text-sm"
              {...fieldErrorAttrs(result?.error, "postalCode")}
            />
            <FieldError name="postalCode" error={result?.error} />
          </div>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="email" class="field-label">
              {t("Email")}
            </label>
            <div class="input-icon mt-1">
              <Icon name="mail" size="sm" />
              <input
                spellcheck="false"
                id="email"
                name="email"
                type="email"
                value={val("email", organization.email ?? "")}
                class="block w-full text-sm"
                {...fieldErrorAttrs(result?.error, "email")}
              />
            </div>
            <FieldError name="email" error={result?.error} />
          </div>

          <div>
            <label for="phone" class="field-label">
              {t("Phone")}
            </label>
            <input
              id="phone"
              name="phone"
              type="tel"
              value={val("phone", organization.phone ?? "")}
              class="mt-1 block w-full text-sm"
              {...fieldErrorAttrs(result?.error, "phone")}
            />
            <FieldError name="phone" error={result?.error} />
          </div>
        </div>
      </fieldset>

      <fieldset class="space-y-4 pt-4 border-t border-border">
        <legend class="text-base font-semibold text-foreground">
          {t("Needed before invoices are prepared")}
        </legend>
        <p class="text-muted text-body-sm">
          {t(
            "Invoices show these details. You can add them later, but you cannot prepare an invoice without the bank name and IBAN."
          )}
        </p>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="registrationNumber" class="field-label">
              {t("Registration number")}
            </label>
            <input
              id="registrationNumber"
              name="registrationNumber"
              type="text"
              value={val(
                "registrationNumber",
                organization.registrationNumber ?? ""
              )}
              class="mt-1 block w-full text-sm"
              {...fieldErrorAttrs(result?.error, "registrationNumber")}
            />
            <FieldError name="registrationNumber" error={result?.error} />
          </div>

          <div>
            <label for="vatNumber" class="field-label">
              {t("VAT number")}
            </label>
            <input
              id="vatNumber"
              name="vatNumber"
              type="text"
              value={val("vatNumber", organization.vatNumber ?? "")}
              class="mt-1 block w-full text-sm"
              {...fieldErrorAttrs(result?.error, "vatNumber")}
            />
            <FieldError name="vatNumber" error={result?.error} />
          </div>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="bankName" class="field-label">
              {t("Bank name")}
            </label>
            <input
              id="bankName"
              name="bankName"
              type="text"
              value={val("bankName", organization.bankName ?? "")}
              class="mt-1 block w-full text-sm"
              {...fieldErrorAttrs(result?.error, "bankName")}
            />
            <FieldError name="bankName" error={result?.error} />
          </div>

          <div>
            <label for="iban" class="field-label">
              {t("IBAN")}
            </label>
            <div class="input-icon mt-1">
              <Icon name="building-bank" size="sm" />
              <input
                spellcheck="false"
                id="iban"
                name="iban"
                type="text"
                value={val("iban", organization.iban ?? "")}
                class="block w-full text-sm"
                {...fieldErrorAttrs(result?.error, "iban")}
              />
            </div>
            <FieldError name="iban" error={result?.error} />
          </div>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="bic" class="field-label">
              {t("BIC")}
            </label>
            <input
              spellcheck="false"
              id="bic"
              name="bic"
              type="text"
              value={val("bic", organization.bic ?? "")}
              class="mt-1 block w-full text-sm"
              {...fieldErrorAttrs(result?.error, "bic")}
            />
            <FieldError name="bic" error={result?.error} />
          </div>
        </div>
      </fieldset>

      <div class="setup-actions">
        <a href={`/admin/o/${organizationId}/setup`} class="btn-secondary">
          {t("Back")}
        </a>
        <div class="flex items-center gap-3">
          <a
            href={`/admin/o/${organizationId}/setup/dwellings`}
            class={
              progress.steps.organization ? "btn-primary" : "btn-secondary"
            }
          >
            {t(progress.steps.organization ? "Continue" : "Skip for now")}
          </a>
          <button
            type="submit"
            class={
              progress.steps.organization ? "btn-secondary" : "btn-primary"
            }
          >
            {t("Save and continue")}
          </button>
        </div>
      </div>
    </form>
  </SetupLayout>
</AdminLayout>
