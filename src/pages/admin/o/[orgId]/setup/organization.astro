---
import { translate, uiLocale } from "../../../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);

import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import FieldError from "../../../../../components/ui/FieldError.astro";
import SetupSteps from "../../../../../components/ui/SetupSteps.astro";
import PageHeader from "../../../../../components/ui/PageHeader.astro";
import { actions } from "astro:actions";
import {
  ForbiddenError,
  requireActiveOrganization,
} from "../../../../../domain/authorization/guards";
import { ConflictError } from "../../../../../domain/errors";
import { getOrganization } from "../../../../../domain/organizations/organizations";
import { getSetupProgress } from "../../../../../domain/onboarding/progress";
import { withRequestDb } from "../../../../../lib/db-request";
import { friendlyActionErrorMessage } from "../../../../../lib/ui/i18n";

const organizationId = Astro.params.orgId!;
try {
  requireActiveOrganization(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  if (err instanceof ConflictError)
    return Astro.redirect(`/admin/o/${organizationId}/dashboard`);
  throw err;
}

const result = Astro.getActionResult(actions.organizations.update);
if (result?.data) {
  return Astro.redirect(`/admin/o/${organizationId}/setup/dwellings`);
}

const { organization, progress } = await withRequestDb(async (db) => {
  const organization = await getOrganization(db, organizationId);
  return {
    organization,
    progress: await getSetupProgress(db, organizationId, organization),
  };
});
---

<AdminLayout
  title={`${t("Organization details")} - ${organization.name}`}
  organizationId={organizationId}
  organizationName={organization.name}
>
  <div class="setup-page space-y-6">
    <PageHeader title={t("Organization details")}>
      <a href={`/admin/o/${organizationId}/setup`} class="back-link"
        >{t("Back to review")}</a
      >
    </PageHeader>
    <SetupSteps
      organizationId={organizationId}
      current="organization"
      steps={progress.steps}
    />

    {
      result?.error && (
        <p class="notice notice-danger" role="alert">
          {friendlyActionErrorMessage(result.error, locale)}
        </p>
      )
    }

    <form
      method="POST"
      action={actions.organizations.update}
      class="rounded-panel border border-border bg-surface p-6 space-y-6 max-w-3xl"
    >
      <input type="hidden" name="organizationId" value={organizationId} />
      {
        (
          [
            "autoGenerateEnabled",
            "autoSendEnabled",
            "carryForwardReadingsEnabled",
          ] as const
        ).map((name) => (
          <input type="hidden" name={name} value={String(organization[name])} />
        ))
      }

      <fieldset class="space-y-4">
        <legend class="text-base font-semibold text-foreground">
          {t("Organization")}
        </legend>

        <div>
          <label for="name" class="block text-sm font-medium text-foreground">
            {t("Name")}
          </label>
          <input
            id="name"
            name="name"
            type="text"
            required
            aria-describedby="name-error"
            value={organization.name}
            class="mt-1 block w-full rounded-control border border-border bg-surface px-3 py-2 text-sm text-foreground"
          />
          <FieldError name="name" error={result?.error} />
        </div>

        <div>
          <label
            for="addressLine1"
            class="block text-sm font-medium text-foreground"
          >
            {t("Address line 1")}
          </label>
          <input
            id="addressLine1"
            name="addressLine1"
            type="text"
            required
            aria-describedby="addressLine1-error"
            value={organization.addressLine1}
            class="mt-1 block w-full rounded-control border border-border bg-surface px-3 py-2 text-sm text-foreground"
          />
          <FieldError name="addressLine1" error={result?.error} />
        </div>

        <div>
          <label
            for="addressLine2"
            class="block text-sm font-medium text-foreground"
          >
            {t("Address line 2")}
          </label>
          <input
            id="addressLine2"
            name="addressLine2"
            type="text"
            aria-describedby="addressLine2-error"
            value={organization.addressLine2 ?? ""}
            class="mt-1 block w-full rounded-control border border-border bg-surface px-3 py-2 text-sm text-foreground"
          />
          <FieldError name="addressLine2" error={result?.error} />
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="city" class="block text-sm font-medium text-foreground">
              {t("City")}
            </label>
            <input
              id="city"
              name="city"
              type="text"
              aria-describedby="city-error"
              value={organization.city ?? ""}
              class="mt-1 block w-full rounded-control border border-border bg-surface px-3 py-2 text-sm text-foreground"
            />
            <FieldError name="city" error={result?.error} />
          </div>

          <div>
            <label
              for="postalCode"
              class="block text-sm font-medium text-foreground"
            >
              {t("Postal code")}
            </label>
            <input
              id="postalCode"
              name="postalCode"
              type="text"
              aria-describedby="postalCode-error"
              value={organization.postalCode ?? ""}
              class="mt-1 block w-full rounded-control border border-border bg-surface px-3 py-2 text-sm text-foreground"
            />
            <FieldError name="postalCode" error={result?.error} />
          </div>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label
              for="email"
              class="block text-sm font-medium text-foreground"
            >
              {t("Email")}
            </label>
            <input
              id="email"
              name="email"
              type="email"
              aria-describedby="email-error"
              value={organization.email ?? ""}
              class="mt-1 block w-full rounded-control border border-border bg-surface px-3 py-2 text-sm text-foreground"
            />
            <FieldError name="email" error={result?.error} />
          </div>

          <div>
            <label
              for="phone"
              class="block text-sm font-medium text-foreground"
            >
              {t("Phone")}
            </label>
            <input
              id="phone"
              name="phone"
              type="tel"
              aria-describedby="phone-error"
              value={organization.phone ?? ""}
              class="mt-1 block w-full rounded-control border border-border bg-surface px-3 py-2 text-sm text-foreground"
            />
            <FieldError name="phone" error={result?.error} />
          </div>
        </div>
      </fieldset>

      <fieldset class="space-y-4 pt-4 border-t border-border">
        <legend class="text-base font-semibold text-foreground">
          {t("Needed before invoices are prepared")}
        </legend>
        <p class="text-muted text-body-sm">
          {
            t(
              "Invoices show these details. You can add them later, but you cannot prepare an invoice without the bank name and IBAN."
            )
          }
        </p>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label
              for="registrationNumber"
              class="block text-sm font-medium text-foreground"
            >
              {t("Registration number")}
            </label>
            <input
              id="registrationNumber"
              name="registrationNumber"
              type="text"
              aria-describedby="registrationNumber-error"
              value={organization.registrationNumber ?? ""}
              class="mt-1 block w-full rounded-control border border-border bg-surface px-3 py-2 text-sm text-foreground"
            />
            <FieldError name="registrationNumber" error={result?.error} />
          </div>

          <div>
            <label
              for="vatNumber"
              class="block text-sm font-medium text-foreground"
            >
              {t("VAT number")}
            </label>
            <input
              id="vatNumber"
              name="vatNumber"
              type="text"
              aria-describedby="vatNumber-error"
              value={organization.vatNumber ?? ""}
              class="mt-1 block w-full rounded-control border border-border bg-surface px-3 py-2 text-sm text-foreground"
            />
            <FieldError name="vatNumber" error={result?.error} />
          </div>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label
              for="bankName"
              class="block text-sm font-medium text-foreground"
            >
              {t("Bank name")}
            </label>
            <input
              id="bankName"
              name="bankName"
              type="text"
              aria-describedby="bankName-error"
              value={organization.bankName ?? ""}
              class="mt-1 block w-full rounded-control border border-border bg-surface px-3 py-2 text-sm text-foreground"
            />
            <FieldError name="bankName" error={result?.error} />
          </div>

          <div>
            <label for="iban" class="block text-sm font-medium text-foreground">
              {t("IBAN")}
            </label>
            <input
              id="iban"
              name="iban"
              type="text"
              aria-describedby="iban-error"
              value={organization.iban ?? ""}
              class="mt-1 block w-full rounded-control border border-border bg-surface px-3 py-2 text-sm text-foreground"
            />
            <FieldError name="iban" error={result?.error} />
          </div>
        </div>

        <div>
          <label for="bic" class="block text-sm font-medium text-foreground">
            {t("BIC")}
          </label>
          <input
            id="bic"
            name="bic"
            type="text"
            aria-describedby="bic-error"
            value={organization.bic ?? ""}
            class="mt-1 block w-full rounded-control border border-border bg-surface px-3 py-2 text-sm text-foreground sm:w-1/2"
          />
          <FieldError name="bic" error={result?.error} />
        </div>
      </fieldset>

      <div class="setup-actions">
        <a href={`/admin/o/${organizationId}/setup`} class="btn-secondary">
          {t("Back")}
        </a>
        <div class="flex items-center gap-3">
          <a
            href={`/admin/o/${organizationId}/setup/dwellings`}
            class="btn-secondary"
          >
            {t("Skip for now")}
          </a>
          <button type="submit" class="btn-primary">
            {t("Save and continue")}
          </button>
        </div>
      </div>
    </form>
  </div>
</AdminLayout>
