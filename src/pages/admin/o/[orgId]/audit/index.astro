---
import { translate, uiLocale } from "../../../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import { formatDate } from "../../../../../lib/ui/i18n";
import {
  ForbiddenError,
  requireOrganizationAccess,
} from "../../../../../domain/authorization/guards";
import { getOrganization } from "../../../../../domain/organizations/organizations";
import {
  listAuditLogs,
  listDistinctAuditActions,
} from "../../../../../domain/audit/audit-log";
import { withRequestDb } from "../../../../../lib/db-request";

const organizationId = Astro.params.orgId!;
try {
  requireOrganizationAccess(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const actionFilter = Astro.url.searchParams.get("action") || undefined;
const entityTypeFilter = Astro.url.searchParams.get("entityType") || undefined;
const rawPage = Number(Astro.url.searchParams.get("page") ?? "1");
// Number.isFinite rejects Infinity/NaN from a malformed ?page= value before
// it can reach the SQL offset below.
const page = Number.isFinite(rawPage) ? Math.max(1, Math.floor(rawPage)) : 1;
const pageSize = 50;

const { organization, logs, availableActions } = await withRequestDb(
  async (db) => ({
    organization: await getOrganization(db, organizationId),
    logs: await listAuditLogs(db, organizationId, {
      action: actionFilter,
      entityType: entityTypeFilter,
      limit: pageSize,
      offset: (page - 1) * pageSize,
    }),
    availableActions: await listDistinctAuditActions(db, organizationId),
  })
);
---

<AdminLayout
  title={`Audit log - ${organization.name}`}
  organizationId={organizationId}
  organizationName={organization.name}
>
  <div class="space-y-6">
    <h1 class="text-xl font-bold text-foreground">{t("Audit log")}</h1>

    <form method="GET" class="flex flex-wrap items-end gap-3">
      <div>
        <label class="block text-sm font-medium text-foreground" for="action"
          >{t("Action")}</label
        >
        <select
          id="action"
          name="action"
          class="mt-1 rounded-control border border-border px-3 py-1.5 text-sm"
        >
          <option value="" selected={!actionFilter}>{t("All actions")}</option>
          {
            availableActions.map((action) => (
              <option value={action} selected={action === actionFilter}>
                {action}
              </option>
            ))
          }
        </select>
      </div>
      <div>
        <label
          class="block text-sm font-medium text-foreground"
          for="entityType">{t("Entity type")}</label
        >
        <input
          id="entityType"
          name="entityType"
          value={entityTypeFilter ?? ""}
          placeholder="invoice, conversation, ..."
          class="mt-1 rounded-control border border-border px-3 py-1.5 text-sm"
        />
      </div>
      <button type="submit" class="btn-primary">
        {t("Filter")}
      </button>
    </form>

    <div class="table-wrap">
      <table class="w-full text-left text-sm">
        <thead
          class="border-b border-border bg-surface-hover text-muted"
        >
          <tr>
            <th class="px-4 py-2">{t("Time")}</th>
            <th class="px-4 py-2">{t("Actor")}</th>
            <th class="px-4 py-2">{t("Action")}</th>
            <th class="px-4 py-2">{t("Entity")}</th>
            <th class="px-4 py-2">{t("Details")}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          {
            logs.map((log) => (
              <tr>
                <td class="px-4 py-2">
                  {formatDate(log.createdAt, locale, organization.timezone)}
                </td>
                <td class="px-4 py-2">
                  {log.actorDisplayName ?? log.actorEmail ?? "—"}
                </td>
                <td class="px-4 py-2">{log.action}</td>
                <td class="px-4 py-2">
                  {log.entityType}
                  {log.entityId ? ` (${log.entityId})` : ""}
                </td>
                <td class="px-4 py-2">
                  {log.beforeData != null || log.afterData != null ? (
                    <details>
                      <summary class="cursor-pointer text-muted hover:underline">
                        {t("View")}
                      </summary>
                      <pre class="mt-2 max-w-md overflow-x-auto rounded bg-surface-hover p-2 text-xs">
                        {JSON.stringify(
                          { before: log.beforeData, after: log.afterData },
                          null,
                          2
                        )}
                      </pre>
                    </details>
                  ) : (
                    "—"
                  )}
                </td>
              </tr>
            ))
          }
          {
            logs.length === 0 && (
              <tr>
                <td colspan="5" class="px-4 py-8 text-center text-muted">
                  {t("No audit events match this filter.")}
                </td>
              </tr>
            )
          }
        </tbody>
      </table>
    </div>

    <div class="flex justify-between text-sm text-muted">
      <a
        href={`?action=${encodeURIComponent(actionFilter ?? "")}&entityType=${encodeURIComponent(entityTypeFilter ?? "")}&page=${Math.max(1, page - 1)}`}
        class:list={{ "pointer-events-none opacity-40": page <= 1 }}
      >
        ← {t("Previous")}
      </a>
      <span>{t("Page")} {page}</span>
      <a
        href={`?action=${encodeURIComponent(actionFilter ?? "")}&entityType=${encodeURIComponent(entityTypeFilter ?? "")}&page=${page + 1}`}
        class:list={{
          "pointer-events-none opacity-40": logs.length < pageSize,
        }}
      >
        {t("Next →")}
      </a>
    </div>
  </div>
</AdminLayout>
