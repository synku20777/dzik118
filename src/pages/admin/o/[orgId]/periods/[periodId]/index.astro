---
// Monthly billing workbench. Domain actions remain the workflow authority;
// this page only makes their state and eligibility easier to understand.
import { actions } from "astro:actions";
import WorkbenchReadiness from "../../../../../../components/ui/WorkbenchReadiness.astro";
import type { WorkbenchProblem } from "../../../../../../lib/ui/workbench-problem";
import WorkbenchSearch from "../../../../../../components/ui/WorkbenchSearch.astro";
import WorkbenchBulkToolbar from "../../../../../../components/ui/WorkbenchBulkToolbar.astro";
import WorkbenchBulkOutcome from "../../../../../../components/ui/WorkbenchBulkOutcome.astro";
import AdminContextDrawer from "../../../../../../components/ui/AdminContextDrawer.astro";
import StatusBadge from "../../../../../../components/ui/StatusBadge.astro";
import Icon from "../../../../../../components/ui/Icon.astro";
import AdminLayout from "../../../../../../layouts/AdminLayout.astro";
import LockDialog from "../../../../../../components/ui/LockDialog.astro";
import "../../../../../../styles/workbench.css";
import { getOrganization } from "../../../../../../domain/organizations/organizations";
import {
  listRuleAssignmentsWithDwellingNumbers,
  listRules,
  ruleStatusForPeriod,
} from "../../../../../../domain/billing/rules";
import {
  getPeriod,
  listDwellingsWithoutCase,
  listPeriods,
} from "../../../../../../domain/periods/periods";
import { invoiceDelivery } from "../../../../../../domain/billing/invoice-snapshots";
import {
  listActiveMeterTypesForPeriod,
  listCasesForPeriod,
} from "../../../../../../domain/periods/cases";
import { listSuppressedEmails } from "../../../../../../domain/email/suppression";
import { invoiceStatusBadge } from "../../../../../../lib/ui/invoice-status";
import { getDashboardSummary } from "../../../../../../domain/periods/dashboard";
import { billingCaseStatusEnum } from "../../../../../../db/schema/billing";
import { withRequestDb } from "../../../../../../lib/db-request";
import { orgLocalDateString } from "../../../../../../lib/org-time";
import { rethrowUnexpected } from "../../../../../../domain/errors";
import {
  entityLabel,
  fill,
  formatMoney,
  formatPeriod,
  friendlyActionErrorMessage,
  translate,
  uiLocale,
  workbenchSelectionCopy,
} from "../../../../../../lib/ui/i18n";

type CaseStatus = (typeof billingCaseStatusEnum.enumValues)[number];
type Snapshot = Record<string, string | null>;

const organizationId = Astro.params.orgId!;
const periodId = Astro.params.periodId!;

const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
const lockResult =
  Astro.getActionResult(actions.periods.lock) ??
  Astro.getActionResult(actions.periods.reopen) ??
  Astro.getActionResult(actions.periods.addDwelling);
const generateResult = Astro.getActionResult(actions.billing.generate);
const bulkGenerateResult = Astro.getActionResult(actions.billing.bulkGenerate);
const bulkPrepareResult = Astro.getActionResult(actions.billing.bulkPrepare);
const bulkSendResult = Astro.getActionResult(actions.invoices.bulkSend);
const sendResult = Astro.getActionResult(actions.invoices.send);
// One request carries one action result, so one error and one outcome.
const actionError =
  lockResult?.error ??
  generateResult?.error ??
  sendResult?.error ??
  bulkGenerateResult?.error ??
  bulkPrepareResult?.error ??
  bulkSendResult?.error;
const bulkResult =
  bulkGenerateResult?.data ?? bulkPrepareResult?.data ?? bulkSendResult?.data;
const bulkOutcome = bulkResult && {
  ...bulkResult,
  label: bulkGenerateResult?.data
    ? "invoices generated"
    : bulkPrepareResult?.data
      ? "invoices prepared"
      : "invoices sent",
};

const search = Astro.url.searchParams.get("search")?.trim() || undefined;
const rawStatus = Astro.url.searchParams.get("status");
const statusFilter =
  rawStatus === "UNSENT"
    ? "UNSENT"
    : (billingCaseStatusEnum.enumValues as readonly string[]).includes(
          rawStatus ?? ""
        )
      ? (rawStatus as CaseStatus)
      : undefined;

let organization, period, cases, allPeriods, summary, rules, assignmentsByRule;
let dwellingsWithoutCase, suppressed, meterTypesByDwelling;
try {
  ({
    dwellingsWithoutCase,
    organization,
    period,
    cases,
    allPeriods,
    summary,
    rules,
    assignmentsByRule,
    suppressed,
    meterTypesByDwelling,
  } = await withRequestDb(async (db) => ({
    suppressed: new Set(
      (await listSuppressedEmails(db, organizationId)).map((row) =>
        row.email.toLowerCase()
      )
    ),
    meterTypesByDwelling: await listActiveMeterTypesForPeriod(
      db,
      organizationId,
      await getPeriod(db, organizationId, periodId)
    ),
    dwellingsWithoutCase: await listDwellingsWithoutCase(
      db,
      organizationId,
      periodId
    ),
    rules: await listRules(db, organizationId, { includeArchived: true }),
    assignmentsByRule: await listRuleAssignmentsWithDwellingNumbers(
      db,
      organizationId
    ),
    organization: await getOrganization(db, organizationId),
    period: await getPeriod(db, organizationId, periodId),
    cases: await listCasesForPeriod(db, organizationId, periodId, {
      search,
      statusFilter,
    }),
    allPeriods: await listPeriods(db, organizationId),
    summary: await getDashboardSummary(db, organizationId, periodId),
  })));
} catch (err) {
  rethrowUnexpected(err);
  return Astro.redirect(`/admin/o/${organizationId}/periods`);
}
// The starting-readings month is not a billing workbench; its readings are
// edited in the setup.
if (period.openingReadings) {
  return Astro.redirect(`/admin/o/${organizationId}/setup/meters`);
}

// Why each tariff does or does not apply in this period. The verdict comes
// from the domain (ruleStatusForPeriod); this page only words it.
const rulesPath = `/admin/o/${organizationId}/settings/rules`;
const tariffRows = rules.map((rule) => {
  const status = ruleStatusForPeriod(rule, period);
  const assigned = assignmentsByRule.get(rule.id) ?? [];
  const scoped = rule.applicationScope !== "ONE_TO_ALL";
  // The dwellings this month the tariff could bill: all with a case, or the
  // assigned ones; a meter tariff only where a meter of its type was active.
  const covered = [...meterTypesByDwelling.keys()].filter(
    (id) => !scoped || assigned.some((a) => a.dwellingId === id)
  );
  const billsSomeone =
    rule.calculationType !== "METER_CONSUMPTION" ||
    covered.some((id) =>
      meterTypesByDwelling.get(id)!.has(rule.meterType ?? "")
    );
  let reason: string;
  if (status === "ARCHIVED") {
    reason = t("Does not apply: the tariff is archived.");
  } else if (status === "DISABLED") {
    reason = t("Does not apply: the tariff is disabled.");
  } else if (status === "STARTS_AFTER_PERIOD") {
    reason = t("Does not apply: it starts after this period ends.");
  } else if (status === "ENDED_BEFORE_PERIOD") {
    reason = t("Does not apply: it ended before this period starts.");
  } else if (scoped && assigned.length === 0) {
    reason = t("Applies to no dwelling: none is assigned.");
  } else if (!billsSomeone || covered.length === 0) {
    reason = t("Does not apply: no dwelling this month can be billed by it.");
  } else if (!scoped) {
    reason = t("Applies to all dwellings.");
  } else {
    reason = `${t("Applies only to the assigned dwellings:")} ${assigned
      .map((a) => a.number)
      .join(", ")}`;
  }
  const applies = status === "APPLIES" && covered.length > 0 && billsSomeone;
  return { rule, applies, reason };
});
const applyingTariffs = tariffRows.filter((row) => row.applies).length;

// Bulk generation works on the whole month, whatever filter is open: it
// creates invoices, refreshes every draft and, when the organization allows
// it, first fills readings still missing after the deadline. Say so first.
const counts = summary.caseStatusCounts;
const carriesForward = Boolean(
  organization.carryForwardReadingsEnabled &&
  period.readingDeadline &&
  orgLocalDateString(new Date(), organization.timezone) > period.readingDeadline
);
const showBulkGenerate =
  counts.READY + counts.DRAFT > 0 ||
  (carriesForward && counts.MISSING_DATA > 0);
const bulkGenerateConfirm =
  fill(
    t(
      "For the whole month: create up to {ready} new invoices and refresh {drafts} drafts?"
    ),
    {
      ready: String(counts.READY + counts.MISSING_DATA),
      drafts: String(counts.DRAFT),
    }
  ) +
  (carriesForward
    ? " " +
      t(
        "Readings still missing after the deadline are filled with the previous reading first."
      )
    : "");

// Previous/next skip the starting-readings month.
const navPeriods = allPeriods.filter((item) => !item.openingReadings);
const currentIndex = navPeriods.findIndex((item) => item.id === periodId);
const previousPeriod =
  currentIndex >= 0 && currentIndex < navPeriods.length - 1
    ? navPeriods[currentIndex + 1]
    : null;
const nextPeriod = currentIndex > 0 ? navPeriods[currentIndex - 1] : null;
const periodName = formatPeriod(period.year, period.month, locale);
const workbenchPath = `/admin/o/${organizationId}/periods/${periodId}`;
const totalCases = Object.values(summary.caseStatusCounts).reduce(
  (total, count) => total + count,
  0
);
// Stage, label, and what the stage means (for screen readers).
const workflowFilters = [
  [undefined, "All", "All billing cases"],
  ["MISSING_DATA", "Missing data", "Resolve inputs"],
  ["READY", "Ready to invoice", "Generate the invoice"],
  ["DRAFT", "Draft", "Review and prepare"],
  ["PREPARED", "Prepared", "Ready to send"],
  ["OVERDUE", "Overdue", "Payment needs review"],
  ["SENT", "Sent", "Delivered"],
  ["PAID", "Paid", "Complete"],
] as const;

function filterHref(status?: CaseStatus) {
  const params = new URLSearchParams();
  if (search) params.set("search", search);
  if (status) params.set("status", status);
  const query = params.toString();
  return query ? `${workbenchPath}?${query}` : workbenchPath;
}
// Apple's rule for names that differ at the end: keep the tail visible.
const KEEP_END = 6;
// A name ending in a number (a meter serial) is told apart by its end: keep
// up to KEEP_END of its trailing digits. Digits are 1ch wide in any font, so
// the room they need is exact (0 when the name is not serial-like).
const serialLike = (text: string) => {
  const digits = /[0-9]+$/.exec(text)?.[0].length ?? 0;
  return digits >= 3 && text.length > digits + 2
    ? Math.min(KEEP_END, digits)
    : 0;
};
const dayMonth = (value: string) =>
  new Intl.DateTimeFormat(locale, {
    day: "numeric",
    month: "short",
    timeZone: "UTC",
  }).format(new Date(value));
---

<AdminLayout
  title={`${periodName} - ${organization.name}`}
  organizationId={organizationId}
  organizationName={organization.name}
  breadcrumbs={[
    { label: t("Periods"), href: `/admin/o/${organizationId}/periods` },
    { label: periodName },
  ]}
>
  <div
    class="workbench"
    data-selection-copy={JSON.stringify(workbenchSelectionCopy(locale))}
  >
    <AdminContextDrawer
      organizationId={organizationId}
      periodId={periodId}
      periodStatus={period.status}
      periodName={periodName}
      workbenchPath={workbenchPath}
      refreshSelectors={[
        ".period-actions",
        ".financial-summary",
        ".case-queue",
      ]}
    />
    <header class="workbench-header">
      <div class="period-title">
        <h1 class="font-display">{periodName}</h1>
        <StatusBadge status={period.status} />
      </div>

      <div class="period-actions">
        {/* A period with no neighbour gets no placeholder button. */}
        {(previousPeriod || nextPeriod) && (
          <nav
            class="btn-group period-nav period-navigation"
            aria-label={t("Period navigation")}
          >
            {previousPeriod && (
              <a
                class="btn-secondary"
                href={`/admin/o/${organizationId}/periods/${previousPeriod.id}`}
              >
                <Icon name="arrow-left" size="xs" />
                <span class="sr-only">{t("Previous period")}: </span>
                {formatPeriod(
                  previousPeriod.year,
                  previousPeriod.month,
                  locale
                )}
              </a>
            )}
            {nextPeriod && (
              <a
                class="btn-secondary"
                href={`/admin/o/${organizationId}/periods/${nextPeriod.id}`}
              >
                <span class="sr-only">{t("Next period")}: </span>
                {formatPeriod(nextPeriod.year, nextPeriod.month, locale)}
                <Icon name="arrow-right" size="xs" />
              </a>
            )}
          </nav>
        )}
        {/* A locked month offers no work: its actions are not shown. */}
        {period.status === "OPEN" && (
          <>
            <a
              href={`/admin/o/${organizationId}/periods/${periodId}/readings`}
              class="btn-secondary"
            >
              <Icon name="pencil" size="sm" /> {t("Enter readings")}
            </a>
            {showBulkGenerate && (
              <form method="POST" action={actions.billing.bulkGenerate}>
                <input
                  type="hidden"
                  name="organizationId"
                  value={organizationId}
                />
                <input type="hidden" name="periodId" value={periodId} />
                <button
                  type="submit"
                  class="btn-primary"
                  data-confirm={bulkGenerateConfirm}
                >
                  {t("Generate and refresh drafts")}
                </button>
              </form>
            )}
            <details class="more-menu" data-dismiss>
              <summary class="icon-btn" aria-label={t("More actions")}>
                <Icon name="dots" size="sm" />
              </summary>
              <div>
                <button
                  type="button"
                  aria-haspopup="dialog"
                  data-open-lock-dialog="lock-period-dialog"
                >
                  {t("Lock period")}
                </button>
              </div>
            </details>
          </>
        )}
      </div>
    </header>

    {period.status === "OPEN" && (
      <LockDialog
        id="lock-period-dialog"
        title={t("Lock this period?")}
        description={t(
          "Locking this period prevents normal reading edits and invoice regeneration. Historical data will remain available."
        )}
        cancelLabel={t("Cancel")}
      >
        <Icon slot="icon" name="alert-triangle" size="sm" />
        <form method="POST" action={actions.periods.lock}>
          <input type="hidden" name="organizationId" value={organizationId} />
          <input type="hidden" name="periodId" value={periodId} />
          <button type="submit" class="btn-primary">
            {t("Lock period")}
          </button>
        </form>
      </LockDialog>
    )}

    {period.status === "LOCKED" && (
      <div
        id="locked-notice"
        class="notice flex flex-wrap items-center justify-between gap-3"
      >
        <p>
          {t(
            "This period is locked. Readings and invoice generation cannot be changed."
          )}{" "}
          {t(
            "To bill a dwelling for this period after the fact, reopen the period."
          )}
        </p>
        <form method="POST" action={actions.periods.reopen}>
          <input type="hidden" name="organizationId" value={organizationId} />
          <input type="hidden" name="periodId" value={periodId} />
          <button
            type="submit"
            class="btn-secondary btn-sm"
            data-confirm={t(
              "Reopen this period? Readings and invoices can be changed again."
            )}
          >
            {t("Reopen period")}
          </button>
        </form>
      </div>
    )}

    <section class="financial-summary" aria-labelledby="financial-heading">
      <h2 id="financial-heading" class="sr-only">
        {t("Financial summary")}
      </h2>
      {(
        [
          ["Total to pay", summary.amountDue],
          ["Paid on invoices", summary.totalPaid],
          ["Still unpaid", summary.totalOutstanding],
        ] as const
      ).map(([label, value]) => (
        <div class="financial-stat">
          <span>{t(label)}</span>
          <strong>{formatMoney(value, organization.currency, locale)}</strong>
        </div>
      ))}
      {summary.currentCharges !== summary.amountDue && (
        <p class="financial-note">
          {t("Current charges")}:{" "}
          {formatMoney(summary.currentCharges, organization.currency, locale)}
        </p>
      )}
    </section>

    {actionError && (
      <p class="notice notice-danger" role="alert">
        {friendlyActionErrorMessage(actionError, locale)}
      </p>
    )}
    {sendResult && !sendResult.error && (
      <p class="notice" role="status">
        {sendResult.data?.sentAt
          ? t("Invoice sent.")
          : t("Sending has not finished yet. Check the delivery status.")}
      </p>
    )}
    {bulkOutcome && (
      <WorkbenchBulkOutcome locale={locale} outcome={bulkOutcome} />
    )}

    <p
      id="bulk-selection-status"
      class="sr-only"
      aria-live="polite"
      aria-atomic="true"
    ></p>
    <section class="case-queue" aria-labelledby="queue-heading">
      <WorkbenchSearch
        locale={locale}
        search={search}
        statusFilter={statusFilter}
      />

      <nav class="workflow-rail" aria-label={t("Filter by workflow stage")}>
        {workflowFilters.map(([status, label, description]) => (
          <a
            href={filterHref(status)}
            class="workflow-filter"
            aria-current={
              (status ? statusFilter === status : !statusFilter)
                ? "page"
                : undefined
            }
          >
            {t(label)}
            <strong>
              {status ? summary.caseStatusCounts[status] : totalCases}
            </strong>
            <span class="sr-only">{t(description)}</span>
          </a>
        ))}
      </nav>

      {(search || statusFilter) && (
        <p class="queue-result" role="status">
          <span>
            {fill(t("Showing {shown} of {total} billing cases"), {
              shown: String(cases.length),
              total: String(totalCases),
            })}
            {statusFilter === "UNSENT" && <> · {t("Unsent invoices")}</>}
          </span>
          <a href={workbenchPath} class="btn-ghost btn-sm clear-filters">
            {t("Clear filters")}
          </a>
        </p>
      )}

      <!-- Per-row forms cannot nest inside the bulk form, so checkboxes target
      this empty form by id. The submitted action still receives the same data. -->
      <form id="bulk-select-form" method="POST"></form>
      <input
        type="hidden"
        name="organizationId"
        value={organizationId}
        form="bulk-select-form"
      />
      <WorkbenchBulkToolbar locale={locale}>
        <button
          type="submit"
          form="bulk-select-form"
          formaction={actions.billing.bulkPrepare}
          data-bulk-status="DRAFT"
          class="btn-secondary"
          disabled
        >
          {t("Prepare eligible")}
        </button>
        <button
          type="submit"
          form="bulk-select-form"
          formaction={actions.invoices.bulkSend}
          data-bulk-status="PREPARED"
          data-confirm={t(
            "Send all selected invoices to residents by email now? Sent invoices cannot be edited."
          )}
          class="btn-primary"
          disabled
        >
          {t("Send eligible")}
        </button>
      </WorkbenchBulkToolbar>

      <div class="table-wrap case-table-wrap">
        <table class="case-table table-compact" role="table">
          <caption class="sr-only">{t("Billing cases")}</caption>
          <thead>
            <tr>
              <th scope="col" class="select-column">
                <label class="check-target">
                  <input
                    type="checkbox"
                    id="select-all"
                    aria-label={t("Select all eligible invoices")}
                  />
                </label>
              </th>
              <th scope="col">{t("Dwelling")}</th>
              <th scope="col">{t("Status")}</th>
              <th scope="col" class="numeric-column">
                {t("Invoice")}
              </th>
              <th scope="col">{t("Next action")}</th>
              <th scope="col" aria-label={t("More actions")}></th>
            </tr>
          </thead>
          <tbody role="rowgroup">
            {cases.map((billingCase) => {
              const missing = billingCase.missingData as (
                | {
                    label: string | null;
                    meterType: string;
                    meterId?: string;
                    reason?: "NO_READING";
                  }
                | {
                    billingRuleId: string;
                    ruleName: string;
                    reason?: "NO_MANUAL_INPUT";
                  }
                | {
                    billingRuleId: string;
                    ruleName: string;
                    meterType: string;
                    reason: "NO_ACTIVE_METER_FOR_RULE";
                  }
                | { reason: "NO_APPLICABLE_RULES" }
                | string
              )[];
              const isRuleLevel = (item: (typeof missing)[number]) =>
                typeof item === "object" &&
                (item.reason === "NO_APPLICABLE_RULES" ||
                  item.reason === "NO_ACTIVE_METER_FOR_RULE");
              const issuer = (billingCase.invoiceIssuerSnapshot ??
                {}) as Snapshot;
              const recipient = (billingCase.invoiceRecipientSnapshot ??
                {}) as Snapshot & {
                invoiceByEmail?: boolean;
                invoiceByPaper?: boolean;
              };
              const payment = (billingCase.invoicePaymentSnapshot ??
                {}) as Snapshot;
              const recipientIncomplete =
                Boolean(billingCase.invoiceId) &&
                ((!recipient.billingName && !recipient.occupantName) ||
                  !recipient.billingAddress);
              const organizationIncomplete =
                Boolean(billingCase.invoiceId) &&
                (!issuer.name ||
                  !issuer.addressLine1 ||
                  !payment.iban ||
                  !payment.bankName);
              const billingEmail = billingCase.invoiceId
                ? recipient.billingEmail
                : billingCase.billingEmail;
              const { invoiceByEmail, invoiceByPaper } = billingCase.invoiceId
                ? invoiceDelivery(billingCase.invoiceRecipientSnapshot)
                : billingCase;
              const prepareEligible =
                billingCase.status === "DRAFT" &&
                !recipientIncomplete &&
                !organizationIncomplete;
              // Send here is email only; paper goes through the invoice page.
              const paperOnly = Boolean(invoiceByPaper && !invoiceByEmail);
              // Facts that make an email send fail or repeat: a suppressed
              // address, or an earlier attempt whose outcome is unknown.
              const emailSuppressed = Boolean(
                billingEmail && suppressed.has(billingEmail.toLowerCase())
              );
              const deliveryUnknown = Boolean(
                billingCase.invoiceId &&
                summary.deliveryUnknownIds.includes(billingCase.invoiceId)
              );
              const sendEligible =
                billingCase.status === "PREPARED" &&
                Boolean(invoiceByEmail && billingEmail) &&
                !emailSuppressed &&
                !deliveryUnknown;
              // The invoice froze the dwelling's details when it was made: an
              // email added to the dwelling since then is not on it.
              // Only an invoice that can still be regenerated: an open month,
              // never sent or paid (a status set back by hand does not count,
              // generation.ts refuses those), and a draft or prepared case.
              const emailAddedSince = Boolean(
                period.status === "OPEN" &&
                missing.length === 0 &&
                billingCase.invoiceSentAt === null &&
                billingCase.invoicePaidAt === null &&
                (billingCase.status === "DRAFT" ||
                  billingCase.status === "PREPARED") &&
                billingCase.invoiceId &&
                invoiceByEmail &&
                !billingEmail &&
                billingCase.billingEmail
              );
              const unsentPaid =
                billingCase.status === "PAID" &&
                Boolean(billingCase.invoiceId) &&
                billingCase.invoiceSentAt === null;
              const overdue =
                billingCase.status === "OVERDUE"
                  ? summary.needsAttention.find(
                      (item) => item.caseId === billingCase.id
                    )
                  : undefined;
              // A blocker readings cannot fix: no tariff, or no meter for one.
              const configOnly =
                missing.length > 0 && missing.every(isRuleLevel);
              const noRule = missing.some(
                (item) =>
                  typeof item === "object" &&
                  item.reason === "NO_APPLICABLE_RULES"
              );
              // Before an invoice exists the blockers decide the action; after,
              // the invoice's own stage does.
              const blockedBeforeInvoice =
                missing.length > 0 &&
                (!billingCase.invoiceId ||
                  billingCase.status === "MISSING_DATA" ||
                  billingCase.status === "READY");
              // Problems and delivery notes sit under the status. A case with
              // none shows the status alone.
              const invoiceHref = billingCase.invoiceId
                ? `${workbenchPath}/invoices/${billingCase.invoiceId}`
                : null;
              const readingsHref = `${workbenchPath}/dwellings/${billingCase.dwellingId}`;
              const dwellingHref = `/admin/o/${organizationId}/dwellings/${billingCase.dwellingId}`;
              // Everything that needs work on this case, most urgent first,
              // shown as one line under the status (see the status cell).
              const problems: WorkbenchProblem[] = [];
              if (overdue?.dueDate && overdue.overdueAmount)
                problems.push({
                  text: `${t("Still unpaid")} ${formatMoney(overdue.overdueAmount, organization.currency, locale)} · ${fill(t("Due {date}"), { date: dayMonth(overdue.dueDate) })}`,
                  tone: "danger",
                });
              if (unsentPaid)
                problems.push({ text: t("Not sent yet"), tone: "warning" });
              if (emailSuppressed && invoiceHref)
                problems.push({
                  text: t("Billing email is on the suppressed list"),
                  tone: "danger",
                  href: invoiceHref,
                });
              if (deliveryUnknown && invoiceHref)
                problems.push({
                  text: t("Outcome not confirmed"),
                  tone: "warning",
                  href: invoiceHref,
                });
              for (const item of missing) {
                if (typeof item === "string") {
                  problems.push({
                    text: item.replace(
                      /^Missing current-period meter reading for dwelling (.+?)\.?$/,
                      (_match, number) =>
                        fill(
                          t(
                            "Missing current-period meter reading for dwelling {number}"
                          ),
                          { number }
                        )
                    ),
                    tone: "danger",
                  });
                } else if (item.reason === "NO_APPLICABLE_RULES") {
                  problems.push({
                    text: t("No billing rule applies"),
                    tone: "danger",
                    href: "#period-tariffs",
                    config: true,
                  });
                } else if (item.reason === "NO_ACTIVE_METER_FOR_RULE") {
                  problems.push({
                    text: `${item.ruleName} — ${t("no active meter")}`,
                    tone: "danger",
                    href: dwellingHref,
                    config: true,
                  });
                } else if ("meterType" in item) {
                  // The status already says "Missing data": the name is enough.
                  problems.push({
                    text: item.label ?? entityLabel(item.meterType, locale),
                    tone: "danger",
                    drawer: "readings",
                    focus: item.meterId
                      ? `meter-${item.meterId}`
                      : item.meterType.toLowerCase().replace(/_/g, "-"),
                    keepEnd: serialLike(
                      item.label ?? entityLabel(item.meterType, locale)
                    ),
                  });
                } else {
                  problems.push({
                    text: item.ruleName,
                    tone: "danger",
                    drawer: "readings",
                    focus: `rule-${item.billingRuleId}`,
                    keepEnd: serialLike(item.ruleName),
                  });
                }
              }
              if (emailAddedSince && invoiceHref)
                problems.push({
                  text: t("New email not on this invoice"),
                  tone: "warning",
                  href: invoiceHref,
                  detail: t(
                    billingCase.status === "DRAFT"
                      ? "Saved to the dwelling. Regenerate this draft to use the new details."
                      : "Saved to the dwelling. This invoice keeps its old details: return it to Draft and regenerate it."
                  ),
                });
              else if (invoiceByEmail && !billingEmail)
                problems.push({
                  text: t("Billing email missing"),
                  tone: "warning",
                  drawer: "billing-details",
                  focus: "billing-email",
                });
              if (recipientIncomplete)
                problems.push({
                  text: t("Recipient details incomplete"),
                  tone: "danger",
                  drawer: "billing-details",
                  focus: "recipient",
                });
              if (organizationIncomplete)
                problems.push({
                  text: t("Issuer or payment details incomplete"),
                  tone: "danger",
                  href: `/admin/o/${organizationId}/settings/organization`,
                });
              // Configuration blockers first: the readings drawer cannot fix
              // them. The rest are behind "+N", whose menu links each one.
              const ordered = [
                ...problems.filter((p) => p.config),
                ...problems.filter((p) => !p.config),
              ];

              return (
                <tr
                  data-status={billingCase.status}
                  data-dwelling-id={billingCase.dwellingId}
                  role="row"
                >
                  <td class="select-column">
                    {billingCase.invoiceId &&
                      (billingCase.status === "DRAFT" ||
                        billingCase.status === "PREPARED") && (
                        // The label widens the tap area; the input keeps its
                        // own accessible name.
                        <label class="check-target">
                          <input
                            type="checkbox"
                            name="invoiceIds"
                            data-prepare-eligible={
                              prepareEligible ? "true" : "false"
                            }
                            data-send-eligible={sendEligible ? "true" : "false"}
                            aria-label={`${t("Select invoice")} ${billingCase.invoiceNumber}`}
                            value={billingCase.invoiceId}
                            form="bulk-select-form"
                          />
                        </label>
                      )}
                  </td>
                  <td class="dwelling-cell">
                    <a href={readingsHref} class="link link-ghost">
                      {billingCase.dwellingNumber}
                    </a>
                    {/* Paper delivery is a setting of the dwelling, not a
                        problem: it sits with the name. */}
                    {(billingCase.occupantName || invoiceByPaper) && (
                      <span>
                        {[
                          billingCase.occupantName,
                          invoiceByPaper && t("Paper delivery"),
                        ]
                          .filter(Boolean)
                          .join(" · ")}
                      </span>
                    )}
                  </td>
                  <td class="status-cell">
                    {/* A tinted tag only where something needs work; a
                        routine stage is plain text, so exceptions stand out. */}
                    {billingCase.status === "MISSING_DATA" ||
                    billingCase.status === "OVERDUE" ? (
                      <StatusBadge status={billingCase.status} />
                    ) : (
                      <span class="status-text">
                        <Icon
                          name={invoiceStatusBadge(billingCase.status).icon}
                          size="xs"
                        />
                        {t(invoiceStatusBadge(billingCase.status).label)}
                      </span>
                    )}
                    <WorkbenchReadiness
                      caseId={billingCase.id}
                      dwellingId={billingCase.dwellingId}
                      problems={ordered}
                      locale={locale}
                    />
                  </td>
                  <td class="invoice-cell numeric-column">
                    {invoiceHref ? (
                      <a href={invoiceHref}>
                        <span>{billingCase.invoiceNumber}</span>
                        <strong>
                          {billingCase.invoiceAmountDue &&
                            formatMoney(
                              billingCase.invoiceAmountDue,
                              organization.currency,
                              locale
                            )}
                        </strong>
                        {billingCase.invoiceCurrentCharges &&
                          billingCase.invoiceCurrentCharges !==
                            billingCase.invoiceAmountDue && (
                            <small>
                              {t("Current charges")}:{" "}
                              {formatMoney(
                                billingCase.invoiceCurrentCharges,
                                organization.currency,
                                locale
                              )}
                            </small>
                          )}
                        {billingCase.invoicePreviousOutstanding &&
                          billingCase.invoicePreviousOutstanding !== "0.00" && (
                            <small>
                              +{" "}
                              {formatMoney(
                                billingCase.invoicePreviousOutstanding,
                                organization.currency,
                                locale
                              )}{" "}
                              {t("carried balance")}
                            </small>
                          )}
                        {billingCase.invoicePreviousCreditApplied &&
                          billingCase.invoicePreviousCreditApplied !==
                            "0.00" && (
                            <small>
                              −{" "}
                              {formatMoney(
                                billingCase.invoicePreviousCreditApplied,
                                organization.currency,
                                locale
                              )}{" "}
                              {t("credit applied")}
                            </small>
                          )}
                      </a>
                    ) : (
                      <span aria-label={t("No invoice")}>—</span>
                    )}
                  </td>
                  <td class="next-action">
                    {billingCase.status === "OVERDUE" ? (
                      <a
                        class="btn-secondary btn-sm"
                        href={`/admin/o/${organizationId}/payments/ledger?dwelling=${billingCase.dwellingId}`}
                      >
                        {t("Account statement")}
                      </a>
                    ) : billingCase.status === "PAID" &&
                      !unsentPaid ? null : period.status === "LOCKED" ? (
                      <a
                        class="btn-secondary btn-sm"
                        href={invoiceHref ?? readingsHref}
                      >
                        {t(invoiceHref ? "View invoice" : "View readings")}
                      </a>
                    ) : blockedBeforeInvoice && configOnly ? (
                      <a
                        class="btn-secondary btn-sm"
                        href={noRule ? "#period-tariffs" : dwellingHref}
                      >
                        {t(noRule ? "Check tariffs" : "View dwelling")}
                      </a>
                    ) : blockedBeforeInvoice ? (
                      <button
                        type="button"
                        class="btn-secondary btn-sm"
                        data-open-drawer="readings"
                        data-dwelling-id={billingCase.dwellingId}
                      >
                        {t("Enter readings")}
                      </button>
                    ) : !billingCase.invoiceId ||
                      billingCase.status === "MISSING_DATA" ||
                      billingCase.status === "READY" ? (
                      <form method="POST" action={actions.billing.generate}>
                        <input
                          type="hidden"
                          name="organizationId"
                          value={organizationId}
                        />
                        <input type="hidden" name="periodId" value={periodId} />
                        <input
                          type="hidden"
                          name="dwellingId"
                          value={billingCase.dwellingId}
                        />
                        <button type="submit" class="btn-secondary btn-sm">
                          {t("Generate invoice")}
                        </button>
                      </form>
                    ) : billingCase.status === "DRAFT" &&
                      recipientIncomplete ? (
                      <button
                        type="button"
                        class="btn-secondary btn-sm"
                        data-open-drawer="billing-details"
                        data-dwelling-id={billingCase.dwellingId}
                      >
                        {t("Fix dwelling details")}
                      </button>
                    ) : billingCase.status === "DRAFT" &&
                      organizationIncomplete ? (
                      <a
                        class="btn-secondary btn-sm"
                        href={`/admin/o/${organizationId}/settings/organization`}
                      >
                        {t("Fix organization details")}
                      </a>
                    ) : billingCase.status === "DRAFT" ? (
                      <a class="btn-secondary btn-sm" href={invoiceHref!}>
                        {t("Review invoice")}
                      </a>
                    ) : billingCase.status === "PREPARED" && paperOnly ? (
                      <a class="btn-secondary btn-sm" href={invoiceHref!}>
                        {t("Record paper dispatch")}
                      </a>
                    ) : billingCase.status === "PREPARED" &&
                      (emailSuppressed || deliveryUnknown) ? (
                      <a class="btn-secondary btn-sm" href={invoiceHref!}>
                        {t("Check delivery")}
                      </a>
                    ) : billingCase.status === "PREPARED" && emailAddedSince ? (
                      <a class="btn-secondary btn-sm" href={invoiceHref!}>
                        {t("Review invoice")}
                      </a>
                    ) : billingCase.status === "PREPARED" && !sendEligible ? (
                      <button
                        type="button"
                        class="btn-secondary btn-sm"
                        data-open-drawer="billing-details"
                        data-dwelling-id={billingCase.dwellingId}
                        data-focus="billing-email"
                      >
                        {t("Add billing email")}
                      </button>
                    ) : billingCase.status === "PREPARED" ? (
                      <form method="POST" action={actions.invoices.send}>
                        <input
                          type="hidden"
                          name="organizationId"
                          value={organizationId}
                        />
                        <input
                          type="hidden"
                          name="invoiceId"
                          value={billingCase.invoiceId!}
                        />
                        <button
                          type="submit"
                          class="btn-secondary btn-sm"
                          data-confirm={t(
                            "Send this invoice to the resident by email now? Sent invoices cannot be edited."
                          )}
                        >
                          {t("Send invoice")}
                        </button>
                      </form>
                    ) : unsentPaid ? (
                      <a class="btn-secondary btn-sm" href={invoiceHref!}>
                        {t("Review invoice")}
                      </a>
                    ) : (
                      <a class="btn-secondary btn-sm" href={invoiceHref!}>
                        {t("View invoice")}
                      </a>
                    )}
                  </td>
                  <td class="menu-cell">
                    <button
                      type="button"
                      class="case-menu-trigger icon-btn icon-btn-sm"
                      popovertarget={`case-menu-${billingCase.id}`}
                      aria-label={`${t("More actions")}: ${billingCase.dwellingNumber}`}
                    >
                      <Icon name="dots" size="sm" />
                    </button>
                    <div
                      class="case-menu"
                      id={`case-menu-${billingCase.id}`}
                      popover="auto"
                    >
                      <a href={readingsHref}>{t("View readings")}</a>
                      <a href={dwellingHref}>{t("View dwelling")}</a>
                      {invoiceHref && (
                        <a href={invoiceHref}>{t("View invoice")}</a>
                      )}
                      {period.status === "OPEN" &&
                        missing.length === 0 &&
                        billingCase.status === "DRAFT" && (
                          <form method="POST" action={actions.billing.generate}>
                            <input
                              type="hidden"
                              name="organizationId"
                              value={organizationId}
                            />
                            <input
                              type="hidden"
                              name="periodId"
                              value={periodId}
                            />
                            <input
                              type="hidden"
                              name="dwellingId"
                              value={billingCase.dwellingId}
                            />
                            <button type="submit">
                              {t("Regenerate invoice")}
                            </button>
                          </form>
                        )}
                    </div>
                  </td>
                </tr>
              );
            })}
            {cases.length === 0 && (
              <tr>
                <td colspan="6" class="empty-queue">
                  <strong>
                    {t(
                      search
                        ? "No billing cases match these filters."
                        : statusFilter === "MISSING_DATA"
                          ? "No dwellings are missing required billing data."
                          : statusFilter
                            ? "No billing cases match these filters."
                            : "No billing cases for this period."
                    )}
                  </strong>
                  <span>{periodName}</span>
                  {(search || statusFilter) && (
                    <a class="btn-secondary" href={workbenchPath}>
                      {t("Clear filters")}
                    </a>
                  )}
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </section>
    <div class="period-resources">
      {!period.openingReadings &&
        period.status === "OPEN" &&
        dwellingsWithoutCase.length > 0 && (
          <details id="add-dwelling" class="disclosure">
            <summary>
              {t("Dwellings not in this period")}
              <span class="ml-2 font-normal text-muted">
                {dwellingsWithoutCase.length}
              </span>
            </summary>
            <p class="text-body-sm text-muted">
              {t(
                "These dwellings have no billing case in this period, so they get no invoice for it. Add a dwelling to bill it for this period. The invoice uses the issue and due dates of this period."
              )}
            </p>
            <form
              method="POST"
              action={actions.periods.addDwelling}
              class="mt-3 flex flex-wrap items-end gap-3"
            >
              <input
                type="hidden"
                name="organizationId"
                value={organizationId}
              />
              <input type="hidden" name="periodId" value={periodId} />
              <label class="text-body-sm">
                <span class="field-label">{t("Dwelling")}</span>
                <select name="dwellingId" required class="mt-1">
                  {dwellingsWithoutCase.map((dwelling) => (
                    <option value={dwelling.id}>{dwelling.number}</option>
                  ))}
                </select>
              </label>
              <button type="submit" class="btn-secondary">
                {t("Add to period")}
              </button>
            </form>
          </details>
        )}

      <details id="period-tariffs" class="disclosure">
        <summary>
          {t("Tariffs in this period")}
          <span class="ml-2 font-normal text-muted">
            {t("Applying:")} {applyingTariffs} / {tariffRows.length}
          </span>
        </summary>
        <p class="text-body-sm text-muted">
          {t(
            "A tariff applies when its effective dates overlap the period. To bill an earlier period, give the tariff an earlier Effective from date."
          )}{" "}
          <a class="link link-underlined" href={rulesPath}>
            {t("Edit tariffs")}
          </a>
        </p>
        {tariffRows.length === 0 ? (
          <p class="text-body-sm mt-3">{t("No tariffs exist yet.")}</p>
        ) : (
          <ul class="mt-3 divide-y divide-border">
            {tariffRows.map(({ rule, applies, reason }) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-2">
                <span class="min-w-0">
                  <a
                    class="link link-underlined font-medium"
                    href={`${rulesPath}?edit=${rule.id}`}
                  >
                    {rule.name}
                  </a>
                  <span class="text-body-sm block text-muted">
                    {rule.effectiveFrom}
                    <Icon
                      name="arrow-right"
                      size="xs"
                      class="inline-block align-middle"
                    />
                    {rule.effectiveUntil ?? t("ongoing")}
                  </span>
                </span>
                <span
                  class="readiness-item"
                  data-tone={applies ? "success" : "danger"}
                >
                  <Icon name={applies ? "check" : "alert-triangle"} size="xs" />
                  {reason}
                </span>
              </li>
            ))}
          </ul>
        )}
      </details>
    </div>
  </div>
</AdminLayout>

<script>
  import { onPageLoad } from "../../../../../../lib/ui/page-lifecycle";
  import { initWorkbenchSelection } from "../../../../../../lib/ui/workbench-selection";
  import { initCaseMenus } from "../../../../../../lib/ui/case-menu";

  onPageLoad(() => {
    const root = document.querySelector<HTMLElement>(".workbench");
    if (!root) return;
    const controller = new AbortController();
    const options = { signal: controller.signal };
    initCaseMenus({ signal: controller.signal });
    const disposeSelection = initWorkbenchSelection(root);
    document.addEventListener(
      "click",
      (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        // A link to the tariffs opens their disclosure, not just scrolls to it.
        if (target.closest('a[href="#period-tariffs"]')) {
          const tariffs =
            document.querySelector<HTMLDetailsElement>("#period-tariffs");
          if (tariffs) tariffs.open = true;
        }
      },
      options
    );
    return () => {
      disposeSelection();
      controller.abort();
    };
  });
</script>

<style>
  /* Title on the left, navigation and actions on the right; the right group
     drops to its own row when the two do not fit. */
  .workbench-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }
  .period-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    min-width: 0;
  }
  .period-title h1 {
    font-size: var(--text-display-md);
    line-height: 1.2;
  }
  .period-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-inline-start: auto;
  }
  @media (width < 40rem) {
    .period-actions {
      width: 100%;
    }
    .period-actions > :is(a, form, nav) {
      flex: 1 1 auto;
    }
    .period-actions form .btn-primary {
      width: 100%;
    }
  }
</style>
