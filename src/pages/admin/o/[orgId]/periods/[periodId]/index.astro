---
// Monthly billing workbench. Domain actions remain the workflow authority;
// this page only makes their state and eligibility easier to understand.
import { actions } from "astro:actions";
import AdminContextDrawer from "../../../../../../components/ui/AdminContextDrawer.astro";
import KpiCard from "../../../../../../components/ui/KpiCard.astro";
import StatusBadge from "../../../../../../components/ui/StatusBadge.astro";
import Icon from "../../../../../../components/ui/Icon.astro";
import AdminLayout from "../../../../../../layouts/AdminLayout.astro";
import {
  ForbiddenError,
  requireOrganizationAccess,
} from "../../../../../../domain/authorization/guards";
import { getOrganization } from "../../../../../../domain/organizations/organizations";
import {
  getPeriod,
  listPeriods,
} from "../../../../../../domain/periods/periods";
import { listCasesForPeriod } from "../../../../../../domain/periods/cases";
import { getDashboardSummary } from "../../../../../../domain/periods/dashboard";
import { billingCaseStatusEnum } from "../../../../../../db/schema/billing";
import { withRequestDb } from "../../../../../../lib/db-request";
import {
  entityLabel,
  formatMoney,
  formatPeriod,
  translate,
  uiLocale,
} from "../../../../../../lib/ui/i18n";

type CaseStatus = (typeof billingCaseStatusEnum.enumValues)[number];
type Snapshot = Record<string, string | null>;

const organizationId = Astro.params.orgId!;
const periodId = Astro.params.periodId!;
try {
  requireOrganizationAccess(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
const lockResult = Astro.getActionResult(actions.periods.lock);
const generateResult = Astro.getActionResult(actions.billing.generate);
const bulkGenerateResult = Astro.getActionResult(actions.billing.bulkGenerate);
const bulkPrepareResult = Astro.getActionResult(actions.billing.bulkPrepare);
const bulkSendResult = Astro.getActionResult(actions.invoices.bulkSend);
const sendResult = Astro.getActionResult(actions.invoices.send);

const search = Astro.url.searchParams.get("search")?.trim() || undefined;
const rawStatus = Astro.url.searchParams.get("status");
const statusFilter = (
  billingCaseStatusEnum.enumValues as readonly string[]
).includes(rawStatus ?? "")
  ? (rawStatus as CaseStatus)
  : undefined;

let organization, period, cases, allPeriods, summary;
try {
  ({ organization, period, cases, allPeriods, summary } = await withRequestDb(
    async (db) => ({
      organization: await getOrganization(db, organizationId),
      period: await getPeriod(db, organizationId, periodId),
      cases: await listCasesForPeriod(db, organizationId, periodId, {
        search,
        statusFilter,
      }),
      allPeriods: await listPeriods(db, organizationId),
      summary: await getDashboardSummary(db, organizationId, periodId),
    })
  ));
} catch {
  return Astro.redirect(`/admin/o/${organizationId}/periods`);
}

const currentIndex = allPeriods.findIndex((item) => item.id === periodId);
const previousPeriod =
  currentIndex >= 0 && currentIndex < allPeriods.length - 1
    ? allPeriods[currentIndex + 1]
    : null;
const nextPeriod = currentIndex > 0 ? allPeriods[currentIndex - 1] : null;
const periodName = formatPeriod(period.year, period.month, locale);
const periodCode = `${period.year}-${String(period.month).padStart(2, "0")}`;
const workbenchPath = `/admin/o/${organizationId}/periods/${periodId}`;
const totalCases = Object.values(summary.caseStatusCounts).reduce(
  (total, count) => total + count,
  0
);
const workflowFilters = [
  [undefined, "All", "All billing cases", "neutral", "●"],
  ["MISSING_DATA", "Missing data", "Resolve inputs", "danger", "!"],
  ["READY", "Ready to invoice", "Generate the invoice", "warning", "✓"],
  ["DRAFT", "Draft", "Review and prepare", "neutral", "✎"],
  ["PREPARED", "Prepared", "Ready to send", "info", "✓"],
  ["OVERDUE", "Overdue", "Payment needs review", "warning", "!"],
  ["SENT", "Sent", "Delivered", "info", "↗"],
  ["PAID", "Paid", "Complete", "success", "✓"],
] as const;

function filterHref(status?: CaseStatus) {
  const params = new URLSearchParams();
  if (search) params.set("search", search);
  if (status) params.set("status", status);
  const query = params.toString();
  return query ? `${workbenchPath}?${query}` : workbenchPath;
}
---

<AdminLayout
  title={`${periodName} - ${organization.name}`}
  organizationId={organizationId}
  organizationName={organization.name}
>
  <div class="workbench">
    <AdminContextDrawer
      organizationId={organizationId}
      periodId={periodId}
      periodStatus={period.status}
      periodName={periodName}
      workbenchPath={workbenchPath}
    />
    <a href={`/admin/o/${organizationId}/periods`} class="back-link">
      <span aria-hidden="true">←</span>
      {t("Periods")}
    </a>

    <header class="workbench-header">
      <div>
        <p class="eyebrow">{t("Monthly workbench")}</p>
        <div class="period-title">
          <h1 class="font-display">{periodName}</h1>
          <StatusBadge status={period.status} />
        </div>
        <p class="period-description">
          {t("Collect readings, generate invoices, then prepare and send.")}
        </p>
        <p class="period-code">{t("Period")} {periodCode}</p>
      </div>

      <div class="period-actions">
        <form method="POST" action={actions.billing.bulkGenerate}>
          <input type="hidden" name="organizationId" value={organizationId} />
          <input type="hidden" name="periodId" value={periodId} />
          <button
            type="submit"
            disabled={period.status === "LOCKED"}
            aria-describedby={period.status === "LOCKED"
              ? "locked-notice"
              : undefined}
            class="btn-primary"
          >
            {t("Generate all eligible")}
          </button>
        </form>
        {
          period.status === "OPEN" && (
            <details class="more-menu">
              <summary aria-label={t("More actions")}>•••</summary>
              <div>
                <button type="button" data-open-lock-dialog>
                  {t("Lock period")}
                </button>
              </div>
            </details>
          )
        }
      </div>
    </header>

    <nav class="period-navigation" aria-label={t("Period navigation")}>
      {
        previousPeriod ? (
          <a href={`/admin/o/${organizationId}/periods/${previousPeriod.id}`}>
            <span aria-hidden="true">←</span>
            <span>
              {formatPeriod(previousPeriod.year, previousPeriod.month, locale)}
            </span>
          </a>
        ) : (
          <span aria-disabled="true">← {t("Previous period")}</span>
        )
      }
      {
        nextPeriod ? (
          <a href={`/admin/o/${organizationId}/periods/${nextPeriod.id}`}>
            <span>
              {formatPeriod(nextPeriod.year, nextPeriod.month, locale)}
            </span>
            <span aria-hidden="true">→</span>
          </a>
        ) : (
          <span aria-disabled="true">{t("Next period")} →</span>
        )
      }
    </nav>

    {
      period.status === "OPEN" && (
        <dialog class="lock-dialog" id="lock-period-dialog">
          <div class="dialog-body">
            <div class="dialog-icon" aria-hidden="true">
              !
            </div>
            <div>
              <h2>{t("Lock this period?")}</h2>
              <p>
                {t(
                  "Locking this period prevents normal reading edits and invoice regeneration. Historical data will remain available."
                )}
              </p>
            </div>
          </div>
          <div class="dialog-actions">
            <form method="dialog">
              <button class="btn-secondary" value="cancel">
                {t("Cancel")}
              </button>
            </form>
            <form method="POST" action={actions.periods.lock}>
              <input
                type="hidden"
                name="organizationId"
                value={organizationId}
              />
              <input type="hidden" name="periodId" value={periodId} />
              <button type="submit" class="btn-danger">
                {t("Lock period")}
              </button>
            </form>
          </div>
        </dialog>
      )
    }

    {
      period.status === "LOCKED" && (
        <p id="locked-notice" class="notice">
          {t(
            "This period is locked. Readings and invoice generation cannot be changed."
          )}
        </p>
      )
    }

    <section class="workflow-overview" aria-labelledby="workflow-heading">
      <div class="section-heading">
        <div>
          <h2 id="workflow-heading">{t("Billing workflow")}</h2>
          <p>{totalCases} {t("billing cases in this period")}</p>
        </div>
        <span>{t("Select a stage to filter the queue")}</span>
      </div>
      <div class="workflow-scroll">
        <nav class="workflow-rail" aria-label={t("Filter by workflow stage")}>
          {
            workflowFilters.map(([status, label, description, tone, icon]) => {
              const count = status
                ? summary.caseStatusCounts[status]
                : totalCases;
              const active = status ? statusFilter === status : !statusFilter;
              return (
                <a
                  href={filterHref(status)}
                  class="workflow-filter"
                  data-tone={tone}
                  aria-current={active ? "page" : undefined}
                >
                  <span class="workflow-label">
                    <span class="workflow-icon" aria-hidden="true">
                      {icon}
                    </span>
                    {t(label)}
                    <strong>{count}</strong>
                  </span>
                  <span>{t(description)}</span>
                </a>
              );
            })
          }
        </nav>
      </div>
    </section>

    <section
      class="grid gap-4 sm:grid-cols-3"
      aria-labelledby="financial-heading"
    >
      <h2 id="financial-heading" class="sr-only">{t("Financial summary")}</h2>
      <KpiCard
        icon="invoice"
        label={t("Invoiced")}
        value={formatMoney(
          summary.totalInvoiced,
          organization.currency,
          locale
        )}
      />
      <KpiCard
        icon="coins"
        label={t("Paid")}
        tone="success"
        value={formatMoney(summary.totalPaid, organization.currency, locale)}
      />
      <KpiCard
        icon="clock"
        label={t("Outstanding")}
        tone="warning"
        value={formatMoney(
          summary.totalOutstanding,
          organization.currency,
          locale
        )}
      />
    </section>

    {
      (lockResult?.error || generateResult?.error || sendResult?.error) && (
        <p class="notice notice-danger" role="alert">
          {lockResult?.error?.message ??
            generateResult?.error?.message ??
            sendResult?.error?.message}
        </p>
      )
    }
    {
      bulkGenerateResult?.data && (
        <p class="notice" role="status">
          {bulkGenerateResult.data.generated.length} {t("invoices generated")}.
          {bulkGenerateResult.data.skipped.length > 0 && (
            <>
              {" "}
              {bulkGenerateResult.data.skipped.length} {t("skipped")}:{" "}
              {bulkGenerateResult.data.skipped
                .map((item) => item.reason)
                .join("; ")}
            </>
          )}
        </p>
      )
    }
    {
      bulkGenerateResult?.error && (
        <p class="notice notice-danger" role="alert">
          {bulkGenerateResult.error.message}
        </p>
      )
    }
    {
      bulkPrepareResult?.data && (
        <p class="notice" role="status">
          {bulkPrepareResult.data.prepared.length} {t("invoices prepared")}.
          {bulkPrepareResult.data.skipped.length > 0 && (
            <>
              {" "}
              {bulkPrepareResult.data.skipped.length} {t("skipped")}:{" "}
              {bulkPrepareResult.data.skipped
                .map((item) => item.reason)
                .join("; ")}
            </>
          )}
        </p>
      )
    }
    {
      bulkPrepareResult?.error && (
        <p class="notice notice-danger" role="alert">
          {bulkPrepareResult.error.message}
        </p>
      )
    }
    {
      bulkSendResult?.data && (
        <p class="notice" role="status">
          {bulkSendResult.data.sent.length} {t("invoices sent")}.
          {bulkSendResult.data.skipped.length > 0 && (
            <>
              {" "}
              {bulkSendResult.data.skipped.length} {t("skipped")}:{" "}
              {bulkSendResult.data.skipped
                .map((item) => item.reason)
                .join("; ")}
            </>
          )}
        </p>
      )
    }
    {
      bulkSendResult?.error && (
        <p class="notice notice-danger" role="alert">
          {bulkSendResult.error.message}
        </p>
      )
    }

    <section class="case-queue" aria-labelledby="queue-heading">
      <div class="queue-heading">
        <div>
          <h2 id="queue-heading">{t("Billing cases")}</h2>
          <p>
            {t("Resolve blockers, then move each invoice to its next stage.")}
          </p>
        </div>
        <form method="GET" class="queue-filters" data-instant-filter>
          <label class="sr-only" for="search">{t("Search dwelling")}</label>
          <input
            id="search"
            name="search"
            type="search"
            value={search ?? ""}
            placeholder={t("Search dwelling…")}
            autocomplete="off"
          />
          <label class="sr-only" for="status">{t("Status")}</label>
          <select id="status" name="status">
            <option value="" selected={!statusFilter}
              >{t("All statuses")}</option
            >
            {
              workflowFilters.slice(1).map(([status, label]) => (
                <option value={status} selected={statusFilter === status}>
                  {t(label)}
                </option>
              ))
            }
          </select>
          {
            (search || statusFilter) && (
              <a href={workbenchPath} class="clear-filters">
                {t("Clear filters")}
              </a>
            )
          }
        </form>
      </div>

      <!-- Per-row forms cannot nest inside the bulk form, so checkboxes target
      this empty form by id. The submitted action still receives the same data. -->
      <form id="bulk-select-form" method="POST"></form>
      <input
        type="hidden"
        name="organizationId"
        value={organizationId}
        form="bulk-select-form"
      />
      <div id="bulk-toolbar" class="bulk-toolbar" hidden aria-live="polite">
        <div class="selection-summary">
          <strong><span id="selected-count">0</span> {t("selected")}</strong>
          <span
            ><span id="prepare-count">0</span> {t("eligible to prepare")}</span
          >
          <span><span id="send-count">0</span> {t("eligible to send")}</span>
        </div>
        <div class="bulk-actions">
          <button
            type="submit"
            form="bulk-select-form"
            formaction={actions.billing.bulkPrepare}
            data-bulk-status="DRAFT"
            class="btn-secondary"
            disabled
          >
            {t("Prepare eligible")}
          </button>
          <button
            type="submit"
            form="bulk-select-form"
            formaction={actions.invoices.bulkSend}
            data-bulk-status="PREPARED"
            class="btn-primary"
            disabled
          >
            {t("Send eligible")}
          </button>
          <button type="button" id="clear-selection" class="clear-selection">
            {t("Clear selection")}
          </button>
        </div>
      </div>

      <div class="table-wrap case-table-wrap">
        <table class="case-table">
          <thead>
            <tr>
              <th class="select-column">
                <input
                  type="checkbox"
                  id="select-all"
                  aria-label={t("Select all eligible invoices")}
                />
              </th>
              <th>{t("Dwelling")}</th>
              <th>{t("Billing inputs")}</th>
              <th>{t("Status")}</th>
              <th class="numeric-column">{t("Invoice")}</th>
              <th>{t("Next action")}</th>
              <th aria-label={t("More actions")}></th>
            </tr>
          </thead>
          <tbody>
            {
              cases.map((billingCase) => {
                const missing = billingCase.missingData as (
                  { label: string | null; meterType: string } | string
                )[];
                const issuer = (billingCase.invoiceIssuerSnapshot ??
                  {}) as Snapshot;
                const recipient = (billingCase.invoiceRecipientSnapshot ??
                  {}) as Snapshot & {
                  invoiceByEmail?: boolean;
                  invoiceByPaper?: boolean;
                };
                const payment = (billingCase.invoicePaymentSnapshot ??
                  {}) as Snapshot;
                const recipientIncomplete =
                  Boolean(billingCase.invoiceId) &&
                  ((!recipient.billingName && !recipient.occupantName) ||
                    !recipient.billingAddress);
                const organizationIncomplete =
                  Boolean(billingCase.invoiceId) &&
                  (!issuer.name ||
                    !issuer.addressLine1 ||
                    !payment.iban ||
                    !payment.bankName);
                const billingEmail = billingCase.invoiceId
                  ? recipient.billingEmail
                  : billingCase.billingEmail;
                // A snapshot taken before per-dwelling delivery preferences
                // existed has neither key -- same email-only fallback as
                // sending.ts's deliver().
                const invoiceByEmail = billingCase.invoiceId
                  ? (recipient.invoiceByEmail ?? true)
                  : billingCase.invoiceByEmail;
                const invoiceByPaper = billingCase.invoiceId
                  ? (recipient.invoiceByPaper ?? false)
                  : billingCase.invoiceByPaper;
                const prepareEligible =
                  billingCase.status === "DRAFT" &&
                  !recipientIncomplete &&
                  !organizationIncomplete;
                const sendEligible =
                  billingCase.status === "PREPARED" &&
                  ((invoiceByEmail && Boolean(billingEmail)) || invoiceByPaper);
                const invoiceHref = billingCase.invoiceId
                  ? `${workbenchPath}/invoices/${billingCase.invoiceId}`
                  : null;
                const readingsHref = `${workbenchPath}/dwellings/${billingCase.dwellingId}`;
                const dwellingHref = `/admin/o/${organizationId}/dwellings/${billingCase.dwellingId}`;

                return (
                  <tr data-status={billingCase.status}>
                    <td class="select-column">
                      {billingCase.invoiceId &&
                        (billingCase.status === "DRAFT" ||
                          billingCase.status === "PREPARED") && (
                          <input
                            type="checkbox"
                            name="invoiceIds"
                            data-prepare-eligible={
                              prepareEligible ? "true" : "false"
                            }
                            data-send-eligible={sendEligible ? "true" : "false"}
                            aria-label={`${t("Select invoice")} ${billingCase.invoiceNumber}`}
                            value={billingCase.invoiceId}
                            form="bulk-select-form"
                          />
                        )}
                    </td>
                    <td class="dwelling-cell">
                      <a href={readingsHref}>{billingCase.dwellingNumber}</a>
                      {billingCase.occupantName && (
                        <span>{billingCase.occupantName}</span>
                      )}
                    </td>
                    <td>
                      <div class="readiness-list">
                        {missing.length > 0 ? (
                          missing.map((item) =>
                            // missingData is a JSONB column with no schema
                            // enforcement: cases whose readiness was last
                            // computed by an older app version can still
                            // carry the legacy plain-string shape instead of
                            // today's {meterType, label, reason} object, so
                            // render those as a non-actionable badge instead
                            // of crashing on a missing meterType.
                            item &&
                            typeof item === "object" &&
                            item.meterType ? (
                              <button
                                type="button"
                                class="readiness-item"
                                data-tone="danger"
                                data-open-drawer="readings"
                                data-dwelling-id={billingCase.dwellingId}
                                data-focus={item.meterType
                                  .toLowerCase()
                                  .replace(/_/g, "-")}
                              >
                                <Icon name="alert-triangle" size="xs" />
                                {item.label ??
                                  entityLabel(item.meterType, locale)}{" "}
                                — {t("missing")}
                              </button>
                            ) : (
                              <span class="readiness-item" data-tone="danger">
                                <Icon name="alert-triangle" size="xs" />{" "}
                                {typeof item === "string"
                                  ? item
                                  : t("Missing data")}
                              </span>
                            )
                          )
                        ) : (
                          <span class="readiness-item" data-tone="success">
                            <Icon name="check" size="xs" />
                            {t("Required readings complete")}
                          </span>
                        )}
                        {invoiceByEmail &&
                          (billingEmail ? (
                            <span class="readiness-item">
                              <Icon name="check" size="xs" />{" "}
                              {t("Billing email ready")}
                            </span>
                          ) : (
                            <button
                              type="button"
                              class="readiness-item"
                              data-tone="warning"
                              data-open-drawer="billing-details"
                              data-dwelling-id={billingCase.dwellingId}
                              data-focus="billing-email"
                            >
                              <Icon name="alert-triangle" size="xs" />{" "}
                              {t("Billing email missing")}
                            </button>
                          ))}
                        {invoiceByPaper && (
                          <span class="readiness-item" data-tone="neutral">
                            <Icon name="file-description" size="xs" />{" "}
                            {t("Paper delivery")}
                          </span>
                        )}
                        {recipientIncomplete && (
                          <button
                            type="button"
                            class="readiness-item"
                            data-tone="danger"
                            data-open-drawer="billing-details"
                            data-dwelling-id={billingCase.dwellingId}
                            data-focus="recipient"
                          >
                            <Icon name="alert-triangle" size="xs" />{" "}
                            {t("Recipient details incomplete")}
                          </button>
                        )}
                        {organizationIncomplete && (
                          <span class="readiness-item" data-tone="danger">
                            <Icon name="alert-triangle" size="xs" />{" "}
                            {t("Issuer or payment details incomplete")}
                          </span>
                        )}
                      </div>
                    </td>
                    <td>
                      <StatusBadge status={billingCase.status} />
                    </td>
                    <td class="invoice-cell numeric-column">
                      {invoiceHref ? (
                        <a href={invoiceHref}>
                          <span>{billingCase.invoiceNumber}</span>
                          <strong>
                            {billingCase.invoiceAmountDue &&
                              formatMoney(
                                billingCase.invoiceAmountDue,
                                organization.currency,
                                locale
                              )}
                          </strong>
                          {billingCase.invoiceCurrentCharges &&
                            billingCase.invoiceCurrentCharges !==
                              billingCase.invoiceAmountDue && (
                              <small>
                                {t("Current charges")}:{" "}
                                {formatMoney(
                                  billingCase.invoiceCurrentCharges,
                                  organization.currency,
                                  locale
                                )}
                              </small>
                            )}
                          {billingCase.invoicePreviousOutstanding &&
                            billingCase.invoicePreviousOutstanding !==
                              "0.00" && (
                              <small>
                                +{" "}
                                {formatMoney(
                                  billingCase.invoicePreviousOutstanding,
                                  organization.currency,
                                  locale
                                )}{" "}
                                {t("carried balance")}
                              </small>
                            )}
                          {billingCase.invoicePreviousCreditApplied &&
                            billingCase.invoicePreviousCreditApplied !==
                              "0.00" && (
                              <small>
                                −{" "}
                                {formatMoney(
                                  billingCase.invoicePreviousCreditApplied,
                                  organization.currency,
                                  locale
                                )}{" "}
                                {t("credit applied")}
                              </small>
                            )}
                        </a>
                      ) : (
                        <span aria-label={t("No invoice")}>—</span>
                      )}
                    </td>
                    <td class="next-action">
                      {period.status === "LOCKED" ? (
                        <a
                          class="btn-secondary btn-sm"
                          href={invoiceHref ?? readingsHref}
                        >
                          {t(invoiceHref ? "View invoice" : "View readings")}
                        </a>
                      ) : missing.length > 0 ? (
                        <button
                          type="button"
                          class="btn-secondary btn-sm"
                          data-open-drawer="readings"
                          data-dwelling-id={billingCase.dwellingId}
                        >
                          {t("Enter readings")}
                        </button>
                      ) : !billingCase.invoiceId ||
                        billingCase.status === "MISSING_DATA" ||
                        billingCase.status === "READY" ? (
                        <form method="POST" action={actions.billing.generate}>
                          <input
                            type="hidden"
                            name="organizationId"
                            value={organizationId}
                          />
                          <input
                            type="hidden"
                            name="periodId"
                            value={periodId}
                          />
                          <input
                            type="hidden"
                            name="dwellingId"
                            value={billingCase.dwellingId}
                          />
                          <button type="submit" class="btn-primary btn-sm">
                            {t("Generate invoice")}
                          </button>
                        </form>
                      ) : billingCase.status === "DRAFT" &&
                        recipientIncomplete ? (
                        <button
                          type="button"
                          class="btn-secondary btn-sm"
                          data-open-drawer="billing-details"
                          data-dwelling-id={billingCase.dwellingId}
                        >
                          {t("Fix dwelling details")}
                        </button>
                      ) : billingCase.status === "DRAFT" &&
                        organizationIncomplete ? (
                        <a
                          class="btn-secondary btn-sm"
                          href={`/admin/o/${organizationId}/settings/organization`}
                        >
                          {t("Fix organization details")}
                        </a>
                      ) : billingCase.status === "DRAFT" ? (
                        <a class="btn-secondary btn-sm" href={invoiceHref!}>
                          {t("Review invoice")}
                        </a>
                      ) : billingCase.status === "PREPARED" && !sendEligible ? (
                        <button
                          type="button"
                          class="btn-secondary btn-sm"
                          data-open-drawer="billing-details"
                          data-dwelling-id={billingCase.dwellingId}
                          data-focus="billing-email"
                        >
                          {t("Add billing email")}
                        </button>
                      ) : billingCase.status === "PREPARED" ? (
                        <form method="POST" action={actions.invoices.send}>
                          <input
                            type="hidden"
                            name="organizationId"
                            value={organizationId}
                          />
                          <input
                            type="hidden"
                            name="invoiceId"
                            value={billingCase.invoiceId!}
                          />
                          <button type="submit" class="btn-primary btn-sm">
                            {t("Send invoice")}
                          </button>
                        </form>
                      ) : (
                        <a class="btn-secondary btn-sm" href={invoiceHref!}>
                          {t(
                            billingCase.status === "OVERDUE"
                              ? "Review invoice"
                              : "View invoice"
                          )}
                        </a>
                      )}
                    </td>
                    <td class="menu-cell">
                      <details class="case-menu">
                        <summary
                          aria-label={`${t("More actions")}: ${billingCase.dwellingNumber}`}
                        >
                          •••
                        </summary>
                        <div>
                          <a href={readingsHref}>{t("View readings")}</a>
                          <a href={dwellingHref}>{t("View dwelling")}</a>
                          {invoiceHref && (
                            <a href={invoiceHref}>{t("View invoice")}</a>
                          )}
                          {period.status === "OPEN" &&
                            missing.length === 0 &&
                            billingCase.status === "DRAFT" && (
                              <form
                                method="POST"
                                action={actions.billing.generate}
                              >
                                <input
                                  type="hidden"
                                  name="organizationId"
                                  value={organizationId}
                                />
                                <input
                                  type="hidden"
                                  name="periodId"
                                  value={periodId}
                                />
                                <input
                                  type="hidden"
                                  name="dwellingId"
                                  value={billingCase.dwellingId}
                                />
                                <button type="submit">
                                  {t("Regenerate invoice")}
                                </button>
                              </form>
                            )}
                        </div>
                      </details>
                    </td>
                  </tr>
                );
              })
            }
            {
              cases.length === 0 && (
                <tr>
                  <td colspan="7" class="empty-queue">
                    <strong>
                      {t(
                        statusFilter === "MISSING_DATA"
                          ? "No dwellings are missing required billing data."
                          : search || statusFilter
                            ? "No billing cases match these filters."
                            : "No billing cases for this period."
                      )}
                    </strong>
                    <span>{periodName}</span>
                    {(search || statusFilter) && (
                      <a class="btn-secondary" href={workbenchPath}>
                        {t("Clear filters")}
                      </a>
                    )}
                  </td>
                </tr>
              )
            }
          </tbody>
        </table>
      </div>
    </section>
  </div>
</AdminLayout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>(
    "[data-instant-filter]"
  );
  const searchInput = document.querySelector<HTMLInputElement>("#search");
  const statusSelect = document.querySelector("#status");
  let searchTimer: number | undefined;
  searchInput?.addEventListener("input", () => {
    window.clearTimeout(searchTimer);
    searchTimer = window.setTimeout(() => filterForm?.requestSubmit(), 300);
  });
  statusSelect?.addEventListener("change", () => filterForm?.requestSubmit());

  const lockDialog = document.querySelector<HTMLDialogElement>(
    "#lock-period-dialog"
  );
  const lockButton = document.querySelector<HTMLButtonElement>(
    "[data-open-lock-dialog]"
  );
  lockButton?.addEventListener("click", () => {
    lockButton.closest("details")?.removeAttribute("open");
    lockDialog?.showModal();
  });
  lockDialog?.addEventListener("click", (event) => {
    if (event.target === lockDialog) lockDialog.close();
  });

  const boxes = [
    ...document.querySelectorAll<HTMLInputElement>('input[name="invoiceIds"]'),
  ];
  const selectAll = document.querySelector<HTMLInputElement>("#select-all");
  const toolbar = document.querySelector<HTMLElement>("#bulk-toolbar");
  const selectedCount = document.querySelector<HTMLElement>("#selected-count");
  const prepareCount = document.querySelector<HTMLElement>("#prepare-count");
  const sendCount = document.querySelector<HTMLElement>("#send-count");

  const updateSelection = () => {
    const selected = boxes.filter((box) => box.checked);
    const prepareEligible = selected.filter(
      (box) => box.dataset.prepareEligible === "true"
    ).length;
    const sendEligible = selected.filter(
      (box) => box.dataset.sendEligible === "true"
    ).length;
    if (toolbar) toolbar.hidden = selected.length === 0;
    if (selectedCount) selectedCount.textContent = String(selected.length);
    if (prepareCount) prepareCount.textContent = String(prepareEligible);
    if (sendCount) sendCount.textContent = String(sendEligible);
    document
      .querySelectorAll<HTMLButtonElement>("[data-bulk-status]")
      .forEach((button) => {
        button.disabled =
          button.dataset.bulkStatus === "DRAFT"
            ? prepareEligible === 0
            : sendEligible === 0;
      });
    if (selectAll) {
      selectAll.checked = boxes.length > 0 && selected.length === boxes.length;
      selectAll.indeterminate =
        selected.length > 0 && selected.length < boxes.length;
      selectAll.disabled = boxes.length === 0;
    }
  };

  boxes.forEach((box) => box.addEventListener("change", updateSelection));
  selectAll?.addEventListener("change", () => {
    boxes.forEach((box) => (box.checked = selectAll.checked));
    updateSelection();
  });
  document.querySelector("#clear-selection")?.addEventListener("click", () => {
    boxes.forEach((box) => (box.checked = false));
    updateSelection();
  });
  updateSelection();
</script>

