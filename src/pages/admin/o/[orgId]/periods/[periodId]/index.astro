---
// Phase E (Periods/meters/readings) / Phase F (Billing) - monthly billing
// workbench (spec Section 9.2, 27 "Periods: Workbench", PER-002, INV-001/002).
import AdminLayout from "../../../../../../layouts/AdminLayout.astro";
import { actions } from "astro:actions";
import {
  ForbiddenError,
  requireOrganizationAccess,
} from "../../../../../../domain/authorization/guards";
import { getOrganization } from "../../../../../../domain/organizations/organizations";
import {
  getPeriod,
  listPeriods,
} from "../../../../../../domain/periods/periods";
import { listCasesForPeriod } from "../../../../../../domain/periods/cases";
import { getDashboardSummary } from "../../../../../../domain/periods/dashboard";
import { billingCaseStatusEnum } from "../../../../../../db/schema/billing";
import { withRequestDb } from "../../../../../../lib/db-request";

type CaseStatus = (typeof billingCaseStatusEnum.enumValues)[number];

const organizationId = Astro.params.orgId!;
const periodId = Astro.params.periodId!;
try {
  requireOrganizationAccess(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const lockResult = Astro.getActionResult(actions.periods.lock);
const generateResult = Astro.getActionResult(actions.billing.generate);
const bulkGenerateResult = Astro.getActionResult(actions.billing.bulkGenerate);
const bulkPrepareResult = Astro.getActionResult(actions.billing.bulkPrepare);
const bulkSendResult = Astro.getActionResult(actions.invoices.bulkSend);

const search = Astro.url.searchParams.get("search") ?? undefined;
const rawStatus = Astro.url.searchParams.get("status");
const statusFilter = (
  billingCaseStatusEnum.enumValues as readonly string[]
).includes(rawStatus ?? "")
  ? (rawStatus as CaseStatus)
  : undefined;

let organization, period, cases, allPeriods, summary;
try {
  ({ organization, period, cases, allPeriods, summary } = await withRequestDb(
    async (db) => ({
      organization: await getOrganization(db, organizationId),
      period: await getPeriod(db, organizationId, periodId),
      cases: await listCasesForPeriod(db, organizationId, periodId, {
        search,
        statusFilter,
      }),
      allPeriods: await listPeriods(db, organizationId),
      summary: await getDashboardSummary(db, organizationId, periodId),
    })
  ));
} catch {
  return Astro.redirect(`/admin/o/${organizationId}/periods`);
}

const currentIndex = allPeriods.findIndex((p) => p.id === periodId);
const previousPeriod =
  currentIndex >= 0 && currentIndex < allPeriods.length - 1
    ? allPeriods[currentIndex + 1]
    : null;
const nextPeriod = currentIndex > 0 ? allPeriods[currentIndex - 1] : null;
---

<AdminLayout
  title={`${period.year}-${String(period.month).padStart(2, "0")} - ${organization.name}`}
  organizationId={organizationId}
  organizationName={organization.name}
>
  <div class="space-y-6">
    <a
      href={`/admin/o/${organizationId}/periods`}
      class="text-sm text-neutral-600 hover:underline"
    >
      ← Periods
    </a>
    <div class="flex items-center justify-between">
      <h1 class="text-xl font-bold text-neutral-900">
        Period {period.year}-{String(period.month).padStart(2, "0")}
        <span class="ml-2 text-sm font-normal text-neutral-500">
          ({period.status === "LOCKED" ? "Locked" : "Open"})
        </span>
      </h1>
      <div class="flex gap-3">
        <form method="POST" action={actions.billing.bulkGenerate}>
          <input type="hidden" name="organizationId" value={organizationId} />
          <input type="hidden" name="periodId" value={periodId} />
          <button
            type="submit"
            class="rounded-md border border-neutral-300 px-3 py-1.5 text-sm text-neutral-700 hover:bg-neutral-50"
          >
            Generate all eligible
          </button>
        </form>
        {
          period.status === "OPEN" && (
            <form method="POST" action={actions.periods.lock}>
              <input
                type="hidden"
                name="organizationId"
                value={organizationId}
              />
              <input type="hidden" name="periodId" value={periodId} />
              <button
                type="submit"
                class="rounded-md border border-neutral-300 px-3 py-1.5 text-sm text-neutral-700 hover:bg-neutral-50"
              >
                Lock period
              </button>
            </form>
          )
        }
      </div>
    </div>

    <div class="flex items-center gap-4 text-sm">
      {
        previousPeriod ? (
          <a
            href={`/admin/o/${organizationId}/periods/${previousPeriod.id}`}
            class="text-neutral-600 hover:underline"
          >
            ← Previous period
          </a>
        ) : (
          <span class="text-neutral-300">← Previous period</span>
        )
      }
      {
        nextPeriod ? (
          <a
            href={`/admin/o/${organizationId}/periods/${nextPeriod.id}`}
            class="text-neutral-600 hover:underline"
          >
            Next period →
          </a>
        ) : (
          <span class="text-neutral-300">Next period →</span>
        )
      }
    </div>

    <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
      <section class="rounded-xl border border-neutral-200 bg-white p-4">
        <h2 class="text-sm font-bold text-neutral-900">Invoiced</h2>
        <p class="mt-1 text-lg font-semibold text-neutral-900">
          {summary.totalInvoiced}
          {organization.currency}
        </p>
      </section>
      <section class="rounded-xl border border-neutral-200 bg-white p-4">
        <h2 class="text-sm font-bold text-neutral-900">Paid</h2>
        <p class="mt-1 text-lg font-semibold text-neutral-900">
          {summary.totalPaid}
          {organization.currency}
        </p>
      </section>
      <section class="rounded-xl border border-neutral-200 bg-white p-4">
        <h2 class="text-sm font-bold text-neutral-900">Outstanding</h2>
        <p class="mt-1 text-lg font-semibold text-neutral-900">
          {summary.totalOutstanding}
          {organization.currency}
        </p>
      </section>
      <section class="rounded-xl border border-neutral-200 bg-white p-4">
        <h2 class="text-sm font-bold text-neutral-900">Needs attention</h2>
        <p class="mt-1 text-lg font-semibold text-neutral-900">
          {summary.needsAttention.length}
        </p>
      </section>
    </div>

    <form method="GET" class="flex flex-wrap items-end gap-3">
      <div>
        <label class="block text-sm font-medium text-neutral-700" for="search">
          Search dwelling
        </label>
        <input
          id="search"
          name="search"
          value={search ?? ""}
          class="mt-1 rounded-md border border-neutral-300 px-3 py-1.5 text-sm"
        />
      </div>
      <div>
        <label class="block text-sm font-medium text-neutral-700" for="status">
          Status
        </label>
        <select
          id="status"
          name="status"
          class="mt-1 rounded-md border border-neutral-300 px-3 py-1.5 text-sm"
        >
          <option value="" selected={!statusFilter}>All statuses</option>
          <option
            value="MISSING_DATA"
            selected={statusFilter === "MISSING_DATA"}
          >
            Missing data
          </option>
          <option value="DRAFT" selected={statusFilter === "DRAFT"}>
            Draft
          </option>
          <option value="PREPARED" selected={statusFilter === "PREPARED"}>
            Prepared
          </option>
          <option value="OVERDUE" selected={statusFilter === "OVERDUE"}>
            Overdue
          </option>
          <option value="SENT" selected={statusFilter === "SENT"}>
            Sent
          </option>
          <option value="PAID" selected={statusFilter === "PAID"}>
            Paid
          </option>
        </select>
      </div>
      <button
        type="submit"
        class="rounded-md border border-neutral-300 px-3 py-1.5 text-sm text-neutral-700 hover:bg-neutral-50"
      >
        Apply
      </button>
      {
        (search || statusFilter) && (
          <a
            href={`/admin/o/${organizationId}/periods/${periodId}`}
            class="text-sm text-neutral-600 hover:underline"
          >
            Clear
          </a>
        )
      }
    </form>

    {
      (lockResult?.error || generateResult?.error) && (
        <p class="rounded-md bg-red-50 p-3 text-sm text-red-800">
          {lockResult?.error?.message ?? generateResult?.error?.message}
        </p>
      )
    }
    {
      bulkGenerateResult?.data && (
        <p class="rounded-md bg-neutral-100 p-3 text-sm text-neutral-700">
          Generated {bulkGenerateResult.data.generated.length} invoice(s).
          {bulkGenerateResult.data.skipped.length > 0 && (
            <>
              {" "}
              Skipped {bulkGenerateResult.data.skipped.length}:{" "}
              {bulkGenerateResult.data.skipped.map((s) => s.reason).join("; ")}
            </>
          )}
        </p>
      )
    }
    {
      bulkGenerateResult?.error && (
        <p class="rounded-md bg-red-50 p-3 text-sm text-red-800">
          {bulkGenerateResult.error.message}
        </p>
      )
    }
    {
      bulkPrepareResult?.data && (
        <p class="rounded-md bg-neutral-100 p-3 text-sm text-neutral-700">
          Prepared {bulkPrepareResult.data.prepared.length} invoice(s).
          {bulkPrepareResult.data.skipped.length > 0 && (
            <>
              {" "}
              Skipped {bulkPrepareResult.data.skipped.length}:{" "}
              {bulkPrepareResult.data.skipped.map((s) => s.reason).join("; ")}
            </>
          )}
        </p>
      )
    }
    {
      bulkPrepareResult?.error && (
        <p class="rounded-md bg-red-50 p-3 text-sm text-red-800">
          {bulkPrepareResult.error.message}
        </p>
      )
    }
    {
      bulkSendResult?.data && (
        <p class="rounded-md bg-neutral-100 p-3 text-sm text-neutral-700">
          Sent {bulkSendResult.data.sent.length} invoice(s).
          {bulkSendResult.data.skipped.length > 0 && (
            <>
              {" "}
              Skipped {bulkSendResult.data.skipped.length}:{" "}
              {bulkSendResult.data.skipped.map((s) => s.reason).join("; ")}
            </>
          )}
        </p>
      )
    }
    {
      bulkSendResult?.error && (
        <p class="rounded-md bg-red-50 p-3 text-sm text-red-800">
          {bulkSendResult.error.message}
        </p>
      )
    }

    <!-- Not wrapped around the table: the per-row Generate/Regenerate forms
    below live inside the table too, and HTML forms cannot nest. Every bulk
    control instead points at this empty form by id via the `form`
    attribute, which is valid anywhere in the document. -->
    <form id="bulk-select-form" method="POST"></form>
    <div class="mb-4 flex gap-3">
      <input
        type="hidden"
        name="organizationId"
        value={organizationId}
        form="bulk-select-form"
      />
      <button
        type="submit"
        form="bulk-select-form"
        formaction={actions.billing.bulkPrepare}
        class="rounded-md border border-neutral-300 px-3 py-1.5 text-sm text-neutral-700 hover:bg-neutral-50"
      >
        Prepare selected
      </button>
      <button
        type="submit"
        form="bulk-select-form"
        formaction={actions.invoices.bulkSend}
        class="rounded-md border border-neutral-300 px-3 py-1.5 text-sm text-neutral-700 hover:bg-neutral-50"
      >
        Send selected
      </button>
    </div>

    <div class="overflow-x-auto rounded-lg border border-neutral-200 bg-white">
      <table class="w-full text-left text-sm">
        <thead
          class="border-b border-neutral-200 bg-neutral-50 text-neutral-600"
        >
          <tr>
            <th class="w-8 px-4 py-2"></th>
            <th class="px-4 py-2">Dwelling</th>
            <th class="px-4 py-2">Status</th>
            <th class="px-4 py-2">Missing readings</th>
            <th class="px-4 py-2">Invoice</th>
            <th class="px-4 py-2"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-100">
          {
            cases.map((c) => {
              const missing = c.missingData as {
                label: string | null;
                meterType: string;
              }[];
              return (
                <tr>
                  <td class="px-4 py-2">
                    {c.invoiceId && (
                      <input
                        type="checkbox"
                        name="invoiceIds"
                        value={c.invoiceId}
                        form="bulk-select-form"
                      />
                    )}
                  </td>
                  <td class="px-4 py-2 font-medium">{c.dwellingNumber}</td>
                  <td class="px-4 py-2">{c.status}</td>
                  <td class="px-4 py-2">
                    {missing.length === 0
                      ? "None"
                      : missing.map((m) => m.label ?? m.meterType).join(", ")}
                  </td>
                  <td class="px-4 py-2">
                    {c.invoiceId ? (
                      <a
                        href={`/admin/o/${organizationId}/periods/${periodId}/invoices/${c.invoiceId}`}
                        class="hover:underline"
                      >
                        {c.invoiceNumber} ({c.invoiceTotal})
                      </a>
                    ) : (
                      "—"
                    )}
                  </td>
                  <td class="px-4 py-2 text-right whitespace-nowrap">
                    <a
                      href={`/admin/o/${organizationId}/periods/${periodId}/dwellings/${c.dwellingId}`}
                      class="text-neutral-700 hover:underline"
                    >
                      Enter readings
                    </a>
                    {missing.length === 0 &&
                      (c.status === "MISSING_DATA" || c.status === "DRAFT") && (
                        <form
                          method="POST"
                          action={actions.billing.generate}
                          class="ml-3 inline"
                        >
                          <input
                            type="hidden"
                            name="organizationId"
                            value={organizationId}
                          />
                          <input
                            type="hidden"
                            name="periodId"
                            value={periodId}
                          />
                          <input
                            type="hidden"
                            name="dwellingId"
                            value={c.dwellingId}
                          />
                          <button
                            type="submit"
                            class="text-neutral-700 hover:underline"
                          >
                            {c.invoiceId ? "Regenerate" : "Generate"}
                          </button>
                        </form>
                      )}
                  </td>
                </tr>
              );
            })
          }
          {
            cases.length === 0 && (
              <tr>
                <td colspan="6" class="px-4 py-8 text-center text-neutral-500">
                  No billing cases for this period.
                </td>
              </tr>
            )
          }
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>
