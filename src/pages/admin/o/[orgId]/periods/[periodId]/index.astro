---
// Monthly billing workbench. Domain actions remain the workflow authority;
// this page only makes their state and eligibility easier to understand.
import { actions } from "astro:actions";
import AdminContextDrawer from "../../../../../../components/ui/AdminContextDrawer.astro";
import StatusBadge from "../../../../../../components/ui/StatusBadge.astro";
import Icon from "../../../../../../components/ui/Icon.astro";
import AdminLayout from "../../../../../../layouts/AdminLayout.astro";
import {
  ForbiddenError,
  requireOrganizationAccess,
} from "../../../../../../domain/authorization/guards";
import { getOrganization } from "../../../../../../domain/organizations/organizations";
import {
  listRuleAssignmentsWithDwellingNumbers,
  listRules,
  ruleStatusForPeriod,
} from "../../../../../../domain/billing/rules";
import {
  getPeriod,
  listDwellingsWithoutCase,
  listPeriods,
} from "../../../../../../domain/periods/periods";
import { listCasesForPeriod } from "../../../../../../domain/periods/cases";
import { getDashboardSummary } from "../../../../../../domain/periods/dashboard";
import { billingCaseStatusEnum } from "../../../../../../db/schema/billing";
import { withRequestDb } from "../../../../../../lib/db-request";
import {
  entityLabel,
  fill,
  formatMoney,
  formatPeriod,
  translate,
  uiLocale,
} from "../../../../../../lib/ui/i18n";

type CaseStatus = (typeof billingCaseStatusEnum.enumValues)[number];
type Snapshot = Record<string, string | null>;

const organizationId = Astro.params.orgId!;
const periodId = Astro.params.periodId!;
try {
  requireOrganizationAccess(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
const lockResult =
  Astro.getActionResult(actions.periods.lock) ??
  Astro.getActionResult(actions.periods.reopen) ??
  Astro.getActionResult(actions.periods.addDwelling);
const generateResult = Astro.getActionResult(actions.billing.generate);
const bulkGenerateResult = Astro.getActionResult(actions.billing.bulkGenerate);
const bulkPrepareResult = Astro.getActionResult(actions.billing.bulkPrepare);
const bulkSendResult = Astro.getActionResult(actions.invoices.bulkSend);
const sendResult = Astro.getActionResult(actions.invoices.send);

const search = Astro.url.searchParams.get("search")?.trim() || undefined;
const rawStatus = Astro.url.searchParams.get("status");
const statusFilter =
  rawStatus === "UNSENT"
    ? "UNSENT"
    : (billingCaseStatusEnum.enumValues as readonly string[]).includes(
          rawStatus ?? ""
        )
      ? (rawStatus as CaseStatus)
      : undefined;

let organization, period, cases, allPeriods, summary, rules, assignmentsByRule;
let dwellingsWithoutCase;
try {
  ({
    dwellingsWithoutCase,
    organization,
    period,
    cases,
    allPeriods,
    summary,
    rules,
    assignmentsByRule,
  } = await withRequestDb(async (db) => ({
    dwellingsWithoutCase: await listDwellingsWithoutCase(
      db,
      organizationId,
      periodId
    ),
    rules: await listRules(db, organizationId, { includeArchived: true }),
    assignmentsByRule: await listRuleAssignmentsWithDwellingNumbers(
      db,
      organizationId
    ),
    organization: await getOrganization(db, organizationId),
    period: await getPeriod(db, organizationId, periodId),
    cases: await listCasesForPeriod(db, organizationId, periodId, {
      search,
      statusFilter,
    }),
    allPeriods: await listPeriods(db, organizationId),
    summary: await getDashboardSummary(db, organizationId, periodId),
  })));
} catch {
  return Astro.redirect(`/admin/o/${organizationId}/periods`);
}
// The starting-readings month is not a billing workbench; its readings are
// edited in the setup.
if (period.openingReadings) {
  return Astro.redirect(`/admin/o/${organizationId}/setup/meters`);
}

// Why each tariff does or does not apply in this period. The verdict comes
// from the domain (ruleStatusForPeriod); this page only words it.
const rulesPath = `/admin/o/${organizationId}/settings/rules`;
const tariffRows = rules.map((rule) => {
  const status = ruleStatusForPeriod(rule, period);
  const assigned = assignmentsByRule.get(rule.id) ?? [];
  const scoped = rule.applicationScope !== "ONE_TO_ALL";
  let reason: string;
  if (status === "ARCHIVED") {
    reason = t("Does not apply: the tariff is archived.");
  } else if (status === "DISABLED") {
    reason = t("Does not apply: the tariff is disabled.");
  } else if (status === "STARTS_AFTER_PERIOD") {
    reason = t("Does not apply: it starts after this period ends.");
  } else if (status === "ENDED_BEFORE_PERIOD") {
    reason = t("Does not apply: it ended before this period starts.");
  } else if (!scoped) {
    reason = t("Applies to all dwellings.");
  } else if (assigned.length === 0) {
    reason = t("Applies to no dwelling: none is assigned.");
  } else {
    reason = `${t("Applies only to the assigned dwellings:")} ${assigned
      .map((a) => a.number)
      .join(", ")}`;
  }
  const applies = status === "APPLIES" && (!scoped || assigned.length > 0);
  return { rule, applies, reason };
});
const applyingTariffs = tariffRows.filter((row) => row.applies).length;

// Previous/next skip the starting-readings month.
const navPeriods = allPeriods.filter((item) => !item.openingReadings);
const currentIndex = navPeriods.findIndex((item) => item.id === periodId);
const previousPeriod =
  currentIndex >= 0 && currentIndex < navPeriods.length - 1
    ? navPeriods[currentIndex + 1]
    : null;
const nextPeriod = currentIndex > 0 ? navPeriods[currentIndex - 1] : null;
const periodName = formatPeriod(period.year, period.month, locale);
const workbenchPath = `/admin/o/${organizationId}/periods/${periodId}`;
const totalCases = Object.values(summary.caseStatusCounts).reduce(
  (total, count) => total + count,
  0
);
const workflowFilters = [
  [undefined, "All", "All billing cases", "neutral", "layout-dashboard"],
  [
    "MISSING_DATA",
    "Missing data",
    "Resolve inputs",
    "danger",
    "alert-triangle",
  ],
  [
    "READY",
    "Ready to invoice",
    "Generate the invoice",
    "warning",
    "receipt-euro",
  ],
  ["DRAFT", "Draft", "Review and prepare", "neutral", "pencil"],
  ["PREPARED", "Prepared", "Ready to send", "info", "file-description"],
  [
    "OVERDUE",
    "Overdue",
    "Payment needs review",
    "warning",
    "clock-exclamation",
  ],
  ["SENT", "Sent", "Delivered", "info", "send"],
  ["PAID", "Paid", "Complete", "success", "circle-check"],
] as const;

function filterHref(status?: CaseStatus) {
  const params = new URLSearchParams();
  if (search) params.set("search", search);
  if (status) params.set("status", status);
  const query = params.toString();
  return query ? `${workbenchPath}?${query}` : workbenchPath;
}
// Missing-data tags: show this many, then +N more (opens the readings
// drawer, which lists every one). A dwelling can lack many meters at once.
const MAX_MISSING = 2;
---

<AdminLayout
  title={`${periodName} - ${organization.name}`}
  organizationId={organizationId}
  organizationName={organization.name}
  breadcrumbs={[
    { label: t("Periods"), href: `/admin/o/${organizationId}/periods` },
    { label: periodName },
  ]}
>
  <div class="workbench">
    <AdminContextDrawer
      organizationId={organizationId}
      periodId={periodId}
      periodStatus={period.status}
      periodName={periodName}
      workbenchPath={workbenchPath}
      refreshSelectors={[".financial-summary", ".case-queue"]}
    />
    <header class="workbench-header">
      <div>
        <div class="period-title">
          <h1 class="font-display">{periodName}</h1>
          <StatusBadge status={period.status} />
        </div>
        <p class="period-description">
          {t("Collect readings, generate invoices, then prepare and send.")}
        </p>
      </div>

      <div class="period-actions">
        {!period.openingReadings && (
          <>
            <a
              href={`/admin/o/${organizationId}/periods/${periodId}/readings`}
              class="btn-secondary"
            >
              <Icon name="pencil" size="sm" /> {t("Enter readings")}
            </a>
            <form method="POST" action={actions.billing.bulkGenerate}>
              <input
                type="hidden"
                name="organizationId"
                value={organizationId}
              />
              <input type="hidden" name="periodId" value={periodId} />
              <button
                type="submit"
                disabled={period.status === "LOCKED"}
                aria-describedby={
                  period.status === "LOCKED" ? "locked-notice" : undefined
                }
                class="btn-primary"
              >
                {t("Generate all eligible")}
              </button>
            </form>
          </>
        )}
        {period.status === "OPEN" && (
          <details class="more-menu">
            <summary aria-label={t("More actions")}>
              <Icon name="dots" size="sm" />
            </summary>
            <div>
              <button type="button" data-open-lock-dialog>
                {t("Lock period")}
              </button>
            </div>
          </details>
        )}
      </div>
    </header>

    <nav class="period-navigation" aria-label={t("Period navigation")}>
      {previousPeriod ? (
        <a href={`/admin/o/${organizationId}/periods/${previousPeriod.id}`}>
          <span aria-hidden="true">←</span>
          <span>
            {formatPeriod(previousPeriod.year, previousPeriod.month, locale)}
          </span>
        </a>
      ) : (
        <span aria-disabled="true">← {t("Previous period")}</span>
      )}
      {nextPeriod ? (
        <a href={`/admin/o/${organizationId}/periods/${nextPeriod.id}`}>
          <span>{formatPeriod(nextPeriod.year, nextPeriod.month, locale)}</span>
          <span aria-hidden="true">→</span>
        </a>
      ) : (
        <span aria-disabled="true">{t("Next period")} →</span>
      )}
    </nav>

    {period.status === "OPEN" && (
      <dialog
        class="lock-dialog"
        id="lock-period-dialog"
        aria-labelledby="lock-dialog-title"
        aria-describedby="lock-dialog-description"
      >
        <div class="dialog-body">
          <div class="dialog-icon" aria-hidden="true">
            !
          </div>
          <div>
            <h2 id="lock-dialog-title">{t("Lock this period?")}</h2>
            <p id="lock-dialog-description">
              {t(
                "Locking this period prevents normal reading edits and invoice regeneration. Historical data will remain available."
              )}
            </p>
          </div>
        </div>
        <div class="dialog-actions">
          <form method="dialog">
            <button class="btn-secondary" value="cancel">
              {t("Cancel")}
            </button>
          </form>
          <form method="POST" action={actions.periods.lock}>
            <input type="hidden" name="organizationId" value={organizationId} />
            <input type="hidden" name="periodId" value={periodId} />
            <button type="submit" class="btn-danger">
              {t("Lock period")}
            </button>
          </form>
        </div>
      </dialog>
    )}

    {period.status === "LOCKED" && !period.openingReadings && (
      <div
        id="locked-notice"
        class="notice flex flex-wrap items-center justify-between gap-3"
      >
        <p>
          {t(
            "This period is locked. Readings and invoice generation cannot be changed."
          )}{" "}
          {t(
            "To bill a dwelling for this period after the fact, reopen the period."
          )}
        </p>
        <form method="POST" action={actions.periods.reopen}>
          <input type="hidden" name="organizationId" value={organizationId} />
          <input type="hidden" name="periodId" value={periodId} />
          <button type="submit" class="btn-secondary btn-sm">
            {t("Reopen period")}
          </button>
        </form>
      </div>
    )}

    <section class="financial-summary" aria-labelledby="financial-heading">
      <h2 id="financial-heading" class="sr-only">
        {t("Financial summary")}
      </h2>
      <div class="financial-stat">
        <span class="financial-label">
          <Icon name="receipt-euro" size="sm" />
          {t("Total to pay")}
        </span>
        <strong class="font-display">
          {formatMoney(summary.amountDue, organization.currency, locale)}
        </strong>
        <span>
          {t("Current charges")}:{" "}
          {formatMoney(summary.currentCharges, organization.currency, locale)}
        </span>
      </div>
      <div class="financial-stat">
        <span class="financial-label">
          <Icon name="coin" size="sm" />
          {t("Received in payments")}
        </span>
        <strong class="font-display">
          {formatMoney(summary.totalPaid, organization.currency, locale)}
        </strong>
        <span>{t("of total to pay")}</span>
      </div>
      <div class="financial-stat">
        <span class="financial-label">
          <Icon name="clock" size="sm" />
          {t("Still unpaid")}
        </span>
        <strong class="font-display">
          {formatMoney(summary.totalOutstanding, organization.currency, locale)}
        </strong>
        <span>{t("of total to pay")}</span>
      </div>
    </section>

    {(lockResult?.error || generateResult?.error || sendResult?.error) && (
      <p class="notice notice-danger" role="alert">
        {lockResult?.error?.message ??
          generateResult?.error?.message ??
          sendResult?.error?.message}
      </p>
    )}
    {sendResult && !sendResult.error && (
      <p class="notice" role="status">
        {sendResult.data?.sentAt
          ? t("Invoice sent.")
          : t("Sending has not finished yet. Check the delivery status.")}
      </p>
    )}
    {bulkGenerateResult?.data && (
      <p class="notice" role="status">
        {bulkGenerateResult.data.generated.length} {t("invoices generated")}.
        {bulkGenerateResult.data.skipped.length > 0 && (
          <>
            {" "}
            {bulkGenerateResult.data.skipped.length} {t("skipped")}:{" "}
            {bulkGenerateResult.data.skipped
              .map((item) => item.reason)
              .join("; ")}
          </>
        )}
      </p>
    )}
    {bulkGenerateResult?.error && (
      <p class="notice notice-danger" role="alert">
        {bulkGenerateResult.error.message}
      </p>
    )}
    {bulkPrepareResult?.data && (
      <p class="notice" role="status">
        {bulkPrepareResult.data.prepared.length} {t("invoices prepared")}.
        {bulkPrepareResult.data.skipped.length > 0 && (
          <>
            {" "}
            {bulkPrepareResult.data.skipped.length} {t("skipped")}:{" "}
            {bulkPrepareResult.data.skipped
              .map((item) => item.reason)
              .join("; ")}
          </>
        )}
      </p>
    )}
    {bulkPrepareResult?.error && (
      <p class="notice notice-danger" role="alert">
        {bulkPrepareResult.error.message}
      </p>
    )}
    {bulkSendResult?.data && (
      <p class="notice" role="status">
        {bulkSendResult.data.sent.length} {t("invoices sent")}.
        {bulkSendResult.data.skipped.length > 0 && (
          <>
            {" "}
            {bulkSendResult.data.skipped.length} {t("skipped")}:{" "}
            {bulkSendResult.data.skipped.map((item) => item.reason).join("; ")}
          </>
        )}
      </p>
    )}
    {bulkSendResult?.error && (
      <p class="notice notice-danger" role="alert">
        {bulkSendResult.error.message}
      </p>
    )}

    <section class="case-queue" aria-labelledby="queue-heading">
      <div class="queue-heading">
        <div>
          <h2 id="queue-heading">
            {t("Billing cases")} <span class="queue-count">{totalCases}</span>
          </h2>
          <p>
            {t("Resolve blockers, then move each invoice to its next stage.")}
          </p>
        </div>
        <form method="GET" class="queue-filters">
          <div class="queue-search">
            <Icon name="search" size="sm" />
            <label class="sr-only" for="search">
              {t("Search dwelling")}
            </label>
            <input
              id="search"
              name="search"
              type="search"
              value={search ?? ""}
              placeholder={t("Search dwelling…")}
              autocomplete="off"
            />
          </div>
          <label class="sr-only" for="status">
            {t("Status")}
          </label>
          <select id="status" name="status">
            <option value="" selected={!statusFilter}>
              {t("All statuses")}
            </option>
            <option value="UNSENT" selected={statusFilter === "UNSENT"}>
              {t("Not sent yet")}
            </option>
            {workflowFilters.slice(1).map(([status, label]) => (
              <option value={status} selected={statusFilter === status}>
                {t(label)}
              </option>
            ))}
          </select>
          <button type="submit" class="btn-secondary btn-sm filter-submit">
            {t("Apply filters")}
          </button>
          {(search || statusFilter) && (
            <a href={workbenchPath} class="clear-filters">
              {t("Clear filters")}
            </a>
          )}
        </form>
      </div>

      <section class="workflow-overview" aria-labelledby="workflow-heading">
        <h3 id="workflow-heading" class="sr-only">
          {t("Filter by workflow stage")}
        </h3>
        <div class="workflow-scroll">
          <nav class="workflow-rail" aria-label={t("Filter by workflow stage")}>
            {workflowFilters.map(([status, label, description, tone, icon]) => {
              const count = status
                ? summary.caseStatusCounts[status]
                : totalCases;
              const active = status ? statusFilter === status : !statusFilter;
              return (
                <a
                  href={filterHref(status)}
                  class="workflow-filter"
                  data-tone={tone}
                  aria-current={active ? "page" : undefined}
                >
                  <span class="workflow-label">
                    <span class="workflow-icon" aria-hidden="true">
                      <Icon name={icon} size="sm" />
                    </span>
                    <span>{t(label)}</span>
                    <strong>{count}</strong>
                  </span>
                  <span class="sr-only">{t(description)}</span>
                </a>
              );
            })}
          </nav>
        </div>
      </section>

      <p class="queue-result" role="status">
        {fill(t("Showing {shown} of {total} billing cases"), {
          shown: String(cases.length),
          total: String(totalCases),
        })}
        {statusFilter === "UNSENT" && (
          <> · {t("Draft and prepared invoices")}</>
        )}
      </p>

      <!-- Per-row forms cannot nest inside the bulk form, so checkboxes target
      this empty form by id. The submitted action still receives the same data. -->
      <form id="bulk-select-form" method="POST"></form>
      <input
        type="hidden"
        name="organizationId"
        value={organizationId}
        form="bulk-select-form"
      />
      <div id="bulk-toolbar" class="bulk-toolbar" hidden aria-live="polite">
        <div class="selection-summary">
          <strong>
            <span id="selected-count">0</span> {t("selected")}
          </strong>
          <span>
            <span id="prepare-count">0</span> {t("eligible to prepare")}
          </span>
          <span>
            <span id="send-count">0</span> {t("eligible to send")}
          </span>
        </div>
        <div class="bulk-actions">
          <button
            type="submit"
            form="bulk-select-form"
            formaction={actions.billing.bulkPrepare}
            data-bulk-status="DRAFT"
            class="btn-secondary"
            disabled
          >
            {t("Prepare eligible")}
          </button>
          <button
            type="submit"
            form="bulk-select-form"
            formaction={actions.invoices.bulkSend}
            data-bulk-status="PREPARED"
            data-confirm={t(
              "Send all selected invoices to residents by email now? Sent invoices cannot be edited."
            )}
            class="btn-primary"
            disabled
          >
            {t("Send eligible")}
          </button>
          <button type="button" id="clear-selection" class="clear-selection">
            {t("Clear selection")}
          </button>
        </div>
      </div>

      <div class="table-wrap case-table-wrap stack-table">
        <table class="case-table" role="table">
          <caption class="sr-only">{t("Billing cases")}</caption>
          <thead>
            <tr>
              <th scope="col" class="select-column">
                <input
                  type="checkbox"
                  id="select-all"
                  aria-label={t("Select all eligible invoices")}
                />
              </th>
              <th scope="col">{t("Dwelling")}</th>
              <th scope="col">{t("Billing inputs")}</th>
              <th scope="col">{t("Status")}</th>
              <th scope="col" class="numeric-column">
                {t("Invoice")}
              </th>
              <th scope="col">{t("Next action")}</th>
              <th scope="col" aria-label={t("More actions")}></th>
            </tr>
          </thead>
          <tbody role="rowgroup">
            {cases.map((billingCase) => {
              const missing = billingCase.missingData as (
                | {
                    label: string | null;
                    meterType: string;
                    reason?: "NO_READING";
                  }
                | {
                    billingRuleId: string;
                    ruleName: string;
                    reason?: "NO_MANUAL_INPUT";
                  }
                | {
                    billingRuleId: string;
                    ruleName: string;
                    meterType: string;
                    reason: "NO_ACTIVE_METER_FOR_RULE";
                  }
                | { reason: "NO_APPLICABLE_RULES" }
                | string
              )[];
              const isRuleLevel = (item: (typeof missing)[number]) =>
                typeof item === "object" &&
                (item.reason === "NO_APPLICABLE_RULES" ||
                  item.reason === "NO_ACTIVE_METER_FOR_RULE");
              // A configuration blocker (no rule, no meter for a rule) links to
              // tariffs or the dwelling and is not in the readings drawer, so it
              // is never hidden behind "+N more". Reading-type items are capped.
              const readingItems = missing.filter((item) => !isRuleLevel(item));
              const shownMissing = [
                ...missing.filter(isRuleLevel),
                ...readingItems.slice(0, MAX_MISSING),
              ];
              const hiddenMissing = Math.max(
                0,
                readingItems.length - MAX_MISSING
              );
              const issuer = (billingCase.invoiceIssuerSnapshot ??
                {}) as Snapshot;
              const recipient = (billingCase.invoiceRecipientSnapshot ??
                {}) as Snapshot & {
                invoiceByEmail?: boolean;
                invoiceByPaper?: boolean;
              };
              const payment = (billingCase.invoicePaymentSnapshot ??
                {}) as Snapshot;
              const recipientIncomplete =
                Boolean(billingCase.invoiceId) &&
                ((!recipient.billingName && !recipient.occupantName) ||
                  !recipient.billingAddress);
              const organizationIncomplete =
                Boolean(billingCase.invoiceId) &&
                (!issuer.name ||
                  !issuer.addressLine1 ||
                  !payment.iban ||
                  !payment.bankName);
              const billingEmail = billingCase.invoiceId
                ? recipient.billingEmail
                : billingCase.billingEmail;
              // A snapshot taken before per-dwelling delivery preferences
              // existed has neither key -- same email-only fallback as
              // sending.ts's deliver().
              const invoiceByEmail = billingCase.invoiceId
                ? (recipient.invoiceByEmail ?? true)
                : billingCase.invoiceByEmail;
              const invoiceByPaper = billingCase.invoiceId
                ? (recipient.invoiceByPaper ?? false)
                : billingCase.invoiceByPaper;
              const prepareEligible =
                billingCase.status === "DRAFT" &&
                !recipientIncomplete &&
                !organizationIncomplete;
              const sendEligible =
                billingCase.status === "PREPARED" &&
                ((invoiceByEmail && Boolean(billingEmail)) || invoiceByPaper);
              const invoiceHref = billingCase.invoiceId
                ? `${workbenchPath}/invoices/${billingCase.invoiceId}`
                : null;
              const readingsHref = `${workbenchPath}/dwellings/${billingCase.dwellingId}`;
              const dwellingHref = `/admin/o/${organizationId}/dwellings/${billingCase.dwellingId}`;

              return (
                <tr
                  data-status={billingCase.status}
                  data-dwelling-id={billingCase.dwellingId}
                  role="row"
                >
                  <td class="select-column">
                    {billingCase.invoiceId &&
                      (billingCase.status === "DRAFT" ||
                        billingCase.status === "PREPARED") && (
                        <input
                          type="checkbox"
                          name="invoiceIds"
                          data-prepare-eligible={
                            prepareEligible ? "true" : "false"
                          }
                          data-send-eligible={sendEligible ? "true" : "false"}
                          aria-label={`${t("Select invoice")} ${billingCase.invoiceNumber}`}
                          value={billingCase.invoiceId}
                          form="bulk-select-form"
                        />
                      )}
                  </td>
                  <td class="dwelling-cell">
                    <a href={readingsHref}>{billingCase.dwellingNumber}</a>
                    {billingCase.occupantName && (
                      <span>{billingCase.occupantName}</span>
                    )}
                  </td>
                  <td>
                    <div class="readiness-list">
                      {missing.length > 0 ? (
                        shownMissing.map((item) =>
                          // missingData is a JSONB column with no schema
                          // enforcement: cases whose readiness was last
                          // computed by an older app version can still
                          // carry the legacy plain-string shape instead of
                          // today's {meterType, label, reason} object, so
                          // render those as a non-actionable badge instead
                          // of crashing on a missing meterType.
                          item &&
                          typeof item === "object" &&
                          item.reason === "NO_APPLICABLE_RULES" ? (
                            <a
                              class="readiness-item"
                              data-tone="danger"
                              href="#period-tariffs"
                            >
                              <Icon name="alert-triangle" size="xs" />{" "}
                              {t("No billing rule applies")}
                            </a>
                          ) : item &&
                            typeof item === "object" &&
                            item.reason === "NO_ACTIVE_METER_FOR_RULE" ? (
                            <a
                              class="readiness-item"
                              data-tone="danger"
                              href={dwellingHref}
                              data-tip={`${item.ruleName} — ${t("no active meter")}`}
                              data-tip-clipped
                            >
                              <Icon name="alert-triangle" size="xs" />{" "}
                              {item.ruleName} — {t("no active meter")}
                            </a>
                          ) : item &&
                            typeof item === "object" &&
                            "meterType" in item ? (
                            <button
                              type="button"
                              class="readiness-item"
                              data-tone="danger"
                              data-open-drawer="readings"
                              data-dwelling-id={billingCase.dwellingId}
                              data-focus={item.meterType
                                .toLowerCase()
                                .replace(/_/g, "-")}
                              data-tip={`${item.label ?? entityLabel(item.meterType, locale)} — ${t("missing")}`}
                              data-tip-clipped
                            >
                              <Icon name="alert-triangle" size="xs" />
                              {item.label ??
                                entityLabel(item.meterType, locale)}{" "}
                              — {t("missing")}
                            </button>
                          ) : item &&
                            typeof item === "object" &&
                            "billingRuleId" in item ? (
                            <button
                              type="button"
                              class="readiness-item"
                              data-tone="danger"
                              data-open-drawer="readings"
                              data-dwelling-id={billingCase.dwellingId}
                              data-focus={`rule-${item.billingRuleId}`}
                              data-tip={`${item.ruleName} — ${t("missing")}`}
                              data-tip-clipped
                            >
                              <Icon name="alert-triangle" size="xs" />
                              {item.ruleName} — {t("missing")}
                            </button>
                          ) : (
                            <span class="readiness-item" data-tone="danger">
                              <Icon name="alert-triangle" size="xs" />{" "}
                              {typeof item === "string"
                                ? item.replace(
                                    /^Missing current-period meter reading for dwelling (.+?)\.?$/,
                                    (_match, number) =>
                                      fill(
                                        t(
                                          "Missing current-period meter reading for dwelling {number}"
                                        ),
                                        { number }
                                      )
                                  )
                                : t("Missing data")}
                            </span>
                          )
                        )
                      ) : (
                        <span class="readiness-ok">
                          <Icon name="check" size="xs" />
                          {t("Required readings complete")}
                        </span>
                      )}
                      {hiddenMissing > 0 && (
                        <button
                          type="button"
                          class="readiness-more"
                          data-open-drawer="readings"
                          data-dwelling-id={billingCase.dwellingId}
                          data-tip={t(
                            "Open readings to see every missing item"
                          )}
                          aria-label={fill(t("{count} more missing items"), {
                            count: String(hiddenMissing),
                          })}
                        >
                          {fill(t("+{count} more"), {
                            count: String(hiddenMissing),
                          })}
                        </button>
                      )}
                      {invoiceByEmail &&
                        (billingEmail ? (
                          <span class="sr-only">
                            {t("Billing email ready")}
                          </span>
                        ) : (
                          <button
                            type="button"
                            class="readiness-item"
                            data-tone="warning"
                            data-open-drawer="billing-details"
                            data-dwelling-id={billingCase.dwellingId}
                            data-focus="billing-email"
                          >
                            <Icon name="alert-triangle" size="xs" />{" "}
                            {t("Billing email missing")}
                          </button>
                        ))}
                      {invoiceByPaper && (
                        <span class="readiness-item" data-tone="neutral">
                          <Icon name="file-description" size="xs" />{" "}
                          {t("Paper delivery")}
                        </span>
                      )}
                      {recipientIncomplete && (
                        <button
                          type="button"
                          class="readiness-item"
                          data-tone="danger"
                          data-open-drawer="billing-details"
                          data-dwelling-id={billingCase.dwellingId}
                          data-focus="recipient"
                        >
                          <Icon name="alert-triangle" size="xs" />{" "}
                          {t("Recipient details incomplete")}
                        </button>
                      )}
                      {organizationIncomplete && (
                        <span class="readiness-item" data-tone="danger">
                          <Icon name="alert-triangle" size="xs" />{" "}
                          {t("Issuer or payment details incomplete")}
                        </span>
                      )}
                    </div>
                  </td>
                  <td>
                    <StatusBadge status={billingCase.status} />
                  </td>
                  <td class="invoice-cell numeric-column">
                    {invoiceHref ? (
                      <a href={invoiceHref}>
                        <span>{billingCase.invoiceNumber}</span>
                        <strong>
                          {billingCase.invoiceAmountDue &&
                            formatMoney(
                              billingCase.invoiceAmountDue,
                              organization.currency,
                              locale
                            )}
                        </strong>
                        {billingCase.invoiceCurrentCharges &&
                          billingCase.invoiceCurrentCharges !==
                            billingCase.invoiceAmountDue && (
                            <small>
                              {t("Current charges")}:{" "}
                              {formatMoney(
                                billingCase.invoiceCurrentCharges,
                                organization.currency,
                                locale
                              )}
                            </small>
                          )}
                        {billingCase.invoicePreviousOutstanding &&
                          billingCase.invoicePreviousOutstanding !== "0.00" && (
                            <small>
                              +{" "}
                              {formatMoney(
                                billingCase.invoicePreviousOutstanding,
                                organization.currency,
                                locale
                              )}{" "}
                              {t("carried balance")}
                            </small>
                          )}
                        {billingCase.invoicePreviousCreditApplied &&
                          billingCase.invoicePreviousCreditApplied !==
                            "0.00" && (
                            <small>
                              −{" "}
                              {formatMoney(
                                billingCase.invoicePreviousCreditApplied,
                                organization.currency,
                                locale
                              )}{" "}
                              {t("credit applied")}
                            </small>
                          )}
                      </a>
                    ) : (
                      <span aria-label={t("No invoice")}>—</span>
                    )}
                  </td>
                  <td class="next-action">
                    {period.status === "LOCKED" ? (
                      <a
                        class="btn-secondary btn-sm"
                        href={invoiceHref ?? readingsHref}
                      >
                        {t(invoiceHref ? "View invoice" : "View readings")}
                      </a>
                    ) : missing.length > 0 ? (
                      <button
                        type="button"
                        class="btn-secondary btn-sm"
                        data-open-drawer="readings"
                        data-dwelling-id={billingCase.dwellingId}
                      >
                        {t("Enter readings")}
                      </button>
                    ) : !billingCase.invoiceId ||
                      billingCase.status === "MISSING_DATA" ||
                      billingCase.status === "READY" ? (
                      <form method="POST" action={actions.billing.generate}>
                        <input
                          type="hidden"
                          name="organizationId"
                          value={organizationId}
                        />
                        <input type="hidden" name="periodId" value={periodId} />
                        <input
                          type="hidden"
                          name="dwellingId"
                          value={billingCase.dwellingId}
                        />
                        <button type="submit" class="btn-primary btn-sm">
                          {t("Generate invoice")}
                        </button>
                      </form>
                    ) : billingCase.status === "DRAFT" &&
                      recipientIncomplete ? (
                      <button
                        type="button"
                        class="btn-secondary btn-sm"
                        data-open-drawer="billing-details"
                        data-dwelling-id={billingCase.dwellingId}
                      >
                        {t("Fix dwelling details")}
                      </button>
                    ) : billingCase.status === "DRAFT" &&
                      organizationIncomplete ? (
                      <a
                        class="btn-secondary btn-sm"
                        href={`/admin/o/${organizationId}/settings/organization`}
                      >
                        {t("Fix organization details")}
                      </a>
                    ) : billingCase.status === "DRAFT" ? (
                      <a class="btn-secondary btn-sm" href={invoiceHref!}>
                        {t("Review invoice")}
                      </a>
                    ) : billingCase.status === "PREPARED" && !sendEligible ? (
                      <button
                        type="button"
                        class="btn-secondary btn-sm"
                        data-open-drawer="billing-details"
                        data-dwelling-id={billingCase.dwellingId}
                        data-focus="billing-email"
                      >
                        {t("Add billing email")}
                      </button>
                    ) : billingCase.status === "PREPARED" ? (
                      <form method="POST" action={actions.invoices.send}>
                        <input
                          type="hidden"
                          name="organizationId"
                          value={organizationId}
                        />
                        <input
                          type="hidden"
                          name="invoiceId"
                          value={billingCase.invoiceId!}
                        />
                        <button
                          type="submit"
                          class="btn-primary btn-sm"
                          data-confirm={t(
                            "Send this invoice to the resident by email now? Sent invoices cannot be edited."
                          )}
                        >
                          {t("Send invoice")}
                        </button>
                      </form>
                    ) : (
                      <a class="btn-secondary btn-sm" href={invoiceHref!}>
                        {t(
                          billingCase.status === "OVERDUE"
                            ? "Review invoice"
                            : "View invoice"
                        )}
                      </a>
                    )}
                  </td>
                  <td class="menu-cell">
                    <button
                      type="button"
                      class="case-menu-trigger icon-btn icon-btn-sm"
                      popovertarget={`case-menu-${billingCase.id}`}
                      aria-label={`${t("More actions")}: ${billingCase.dwellingNumber}`}
                    >
                      <Icon name="dots" size="sm" />
                    </button>
                    <div
                      class="case-menu"
                      id={`case-menu-${billingCase.id}`}
                      popover="auto"
                    >
                      <a href={readingsHref}>{t("View readings")}</a>
                      <a href={dwellingHref}>{t("View dwelling")}</a>
                      {invoiceHref && (
                        <a href={invoiceHref}>{t("View invoice")}</a>
                      )}
                      {period.status === "OPEN" &&
                        missing.length === 0 &&
                        billingCase.status === "DRAFT" && (
                          <form method="POST" action={actions.billing.generate}>
                            <input
                              type="hidden"
                              name="organizationId"
                              value={organizationId}
                            />
                            <input
                              type="hidden"
                              name="periodId"
                              value={periodId}
                            />
                            <input
                              type="hidden"
                              name="dwellingId"
                              value={billingCase.dwellingId}
                            />
                            <button type="submit">
                              {t("Regenerate invoice")}
                            </button>
                          </form>
                        )}
                    </div>
                  </td>
                </tr>
              );
            })}
            {cases.length === 0 && (
              <tr>
                <td colspan="7" class="empty-queue">
                  <strong>
                    {t(
                      statusFilter === "MISSING_DATA"
                        ? "No dwellings are missing required billing data."
                        : search || statusFilter
                          ? "No billing cases match these filters."
                          : "No billing cases for this period."
                    )}
                  </strong>
                  <span>{periodName}</span>
                  {(search || statusFilter) && (
                    <a class="btn-secondary" href={workbenchPath}>
                      {t("Clear filters")}
                    </a>
                  )}
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </section>
    <div class="period-resources">
      {!period.openingReadings &&
        period.status === "OPEN" &&
        dwellingsWithoutCase.length > 0 && (
          <details id="add-dwelling" class="period-resource">
            <summary class="chevron-toggle chevron-toggle-end font-semibold">
              {t("Dwellings not in this period")}
              <span class="ml-2 font-normal text-muted">
                {dwellingsWithoutCase.length}
              </span>
            </summary>
            <p class="text-body-sm mt-2 text-muted">
              {t(
                "These dwellings have no billing case in this period, so they get no invoice for it. Add a dwelling to bill it for this period. The invoice uses the issue and due dates of this period."
              )}
            </p>
            <form
              method="POST"
              action={actions.periods.addDwelling}
              class="mt-3 flex flex-wrap items-end gap-3"
            >
              <input
                type="hidden"
                name="organizationId"
                value={organizationId}
              />
              <input type="hidden" name="periodId" value={periodId} />
              <label class="text-body-sm">
                <span class="block font-medium">{t("Dwelling")}</span>
                <select name="dwellingId" required class="mt-1">
                  {dwellingsWithoutCase.map((dwelling) => (
                    <option value={dwelling.id}>{dwelling.number}</option>
                  ))}
                </select>
              </label>
              <button type="submit" class="btn-secondary">
                {t("Add to period")}
              </button>
            </form>
          </details>
        )}

      <details id="period-tariffs" class="period-resource">
        <summary class="chevron-toggle chevron-toggle-end font-semibold">
          {t("Tariffs in this period")}
          <span class="ml-2 font-normal text-muted">
            {t("Applying:")} {applyingTariffs} / {tariffRows.length}
          </span>
        </summary>
        <p class="text-body-sm mt-2 text-muted">
          {t(
            "A tariff applies when its effective dates overlap the period. To bill an earlier period, give the tariff an earlier Effective from date."
          )}{" "}
          <a class="underline" href={rulesPath}>
            {t("Edit tariffs")}
          </a>
        </p>
        {tariffRows.length === 0 ? (
          <p class="text-body-sm mt-3">{t("No tariffs exist yet.")}</p>
        ) : (
          <ul class="mt-3 divide-y divide-border">
            {tariffRows.map(({ rule, applies, reason }) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-2">
                <span class="min-w-0">
                  <a
                    class="font-medium underline"
                    href={`${rulesPath}?edit=${rule.id}`}
                  >
                    {rule.name}
                  </a>
                  <span class="text-body-sm block text-muted">
                    {rule.effectiveFrom} → {rule.effectiveUntil ?? t("ongoing")}
                  </span>
                </span>
                <span
                  class="readiness-item"
                  data-tone={applies ? "success" : "danger"}
                >
                  <Icon name={applies ? "check" : "alert-triangle"} size="xs" />
                  {reason}
                </span>
              </li>
            ))}
          </ul>
        )}
      </details>
    </div>
  </div>
</AdminLayout>

<script>
  import { onPageLoad } from "../../../../../../lib/ui/page-lifecycle";
  import { labelStackTables } from "../../../../../../lib/ui/stack-tables";

  onPageLoad(() => {
    if (!document.querySelector(".workbench")) return;
    const controller = new AbortController();
    const options = { signal: controller.signal };
    const boxes = () => [
      ...document.querySelectorAll<HTMLInputElement>(
        'input[name="invoiceIds"]'
      ),
    ];
    const updateSelection = () => {
      const all = boxes();
      const selected = all.filter((box) => box.checked);
      const prepareEligible = selected.filter(
        (box) => box.dataset.prepareEligible === "true"
      ).length;
      const sendEligible = selected.filter(
        (box) => box.dataset.sendEligible === "true"
      ).length;
      const toolbar = document.querySelector<HTMLElement>("#bulk-toolbar");
      if (toolbar) toolbar.hidden = selected.length === 0;
      for (const [id, value] of [
        ["selected-count", selected.length],
        ["prepare-count", prepareEligible],
        ["send-count", sendEligible],
      ] as const) {
        const el = document.getElementById(id);
        if (el) el.textContent = String(value);
      }
      document
        .querySelectorAll<HTMLButtonElement>("[data-bulk-status]")
        .forEach((button) => {
          button.disabled =
            button.dataset.bulkStatus === "DRAFT"
              ? prepareEligible === 0
              : sendEligible === 0;
        });
      all.forEach((box) =>
        box.closest("tr")?.toggleAttribute("data-selected", box.checked)
      );
      const selectAll = document.querySelector<HTMLInputElement>("#select-all");
      if (selectAll) {
        selectAll.checked = all.length > 0 && selected.length === all.length;
        selectAll.indeterminate =
          selected.length > 0 && selected.length < all.length;
        selectAll.disabled = all.length === 0;
      }
    };
    document.addEventListener(
      "change",
      (event) => {
        const target = event.target;
        if (!(target instanceof HTMLInputElement)) return;
        if (target.id === "select-all")
          boxes().forEach((box) => {
            box.checked = target.checked;
          });
        if (target.id === "select-all" || target.name === "invoiceIds")
          updateSelection();
      },
      options
    );
    document.addEventListener(
      "click",
      (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (target.closest("#clear-selection")) {
          boxes().forEach((box) => {
            box.checked = false;
          });
          updateSelection();
          // Select-all is not shown below sm; fall back to the first case.
          const selectAll = document.querySelector<HTMLInputElement>("#select-all");
          (selectAll?.checkVisibility() ? selectAll : boxes()[0])?.focus();
        }
        if (target.closest("[data-open-lock-dialog]")) {
          target.closest("details")?.removeAttribute("open");
          document
            .querySelector<HTMLDialogElement>("#lock-period-dialog")
            ?.showModal();
        }
        document
          .querySelectorAll<HTMLDetailsElement>(".more-menu[open]")
          .forEach((menu) => {
            if (!menu.contains(target)) menu.open = false;
          });
      },
      options
    );
    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key !== "Escape") return;
        document
          .querySelectorAll<HTMLDetailsElement>(".more-menu[open]")
          .forEach((menu) => {
            menu.open = false;
            menu.querySelector<HTMLElement>("summary")?.focus();
          });
      },
      options
    );
    const positionRowMenu = (menu: HTMLElement) => {
      const trigger = document.querySelector<HTMLElement>(
        `[popovertarget="${CSS.escape(menu.id)}"]`
      );
      if (!trigger) return;
      const anchor = trigger.getBoundingClientRect();
      if (
        anchor.bottom < 0 ||
        anchor.top > innerHeight ||
        anchor.right < 0 ||
        anchor.left > innerWidth
      ) {
        menu.hidePopover();
        return;
      }
      menu.style.inset = "auto";
      menu.style.margin = "0";
      const box = menu.getBoundingClientRect();
      const gap = 6;
      const margin = 8;
      menu.style.left = `${Math.max(margin, Math.min(anchor.right - box.width, innerWidth - box.width - margin))}px`;
      const below = anchor.bottom + gap;
      const top =
        below + box.height <= innerHeight - margin
          ? below
          : anchor.top - box.height - gap;
      menu.style.top = `${Math.max(margin, Math.min(top, innerHeight - box.height - margin))}px`;
    };
    const positionRowMenus = () =>
      document
        .querySelectorAll<HTMLElement>(".case-menu:popover-open")
        .forEach(positionRowMenu);
    document.addEventListener(
      "toggle",
      (event) => {
        const menu = event.target;
        if (
          menu instanceof HTMLElement &&
          menu.matches(".case-menu:popover-open")
        )
          positionRowMenu(menu);
      },
      { ...options, capture: true }
    );
    // Follow visible rows during viewport/table scroll; dismiss when the
    // invoker leaves the viewport. Ignore the menu's own internal scrolling.
    document.addEventListener(
      "scroll",
      (event) => {
        if (
          !(event.target instanceof Element) ||
          !event.target.closest(".case-menu")
        )
          positionRowMenus();
      },
      { ...options, capture: true }
    );
    window.addEventListener("resize", positionRowMenus, options);
    const lockDialog = document.querySelector<HTMLDialogElement>(
      "#lock-period-dialog"
    );
    lockDialog?.addEventListener(
      "click",
      (event) => {
        if (event.target === lockDialog) lockDialog.close();
      },
      options
    );
    // Drawer saves replace the queue. Delegated controls and freshly applied
    // mobile labels keep the new rows fully usable without a page navigation.
    document.addEventListener(
      "workbench:refreshed",
      () => {
        labelStackTables();
        updateSelection();
      },
      options
    );
    updateSelection();
    return () => {
      controller.abort();
    };
  });
</script>

<style>
  .workbench {
    display: grid;
    gap: 1.5rem;
    min-width: 0;
  }
  .workbench-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .workbench-header > div {
    min-width: 0;
  }
  .eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-muted);
    font-size: var(--text-xs);
  }
  .period-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.375rem;
  }
  .period-title h1 {
    font-size: var(--text-display-lg);
    font-weight: 700;
    line-height: 1.12;
  }
  .period-description {
    margin-top: 0.625rem;
    max-width: 36rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .period-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
  }
  .more-menu {
    position: relative;
  }
  .more-menu summary {
    display: grid;
    width: var(--control-size-md);
    min-height: var(--control-size-md);
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-surface);
    color: var(--color-muted);
    list-style: none;
    cursor: pointer;
  }
  .more-menu summary:hover {
    color: var(--color-foreground);
    background: var(--color-surface-hover);
  }
  .more-menu summary::-webkit-details-marker {
    display: none;
  }
  .more-menu > div,
  .case-menu {
    z-index: 20;
    min-width: 11rem;
    padding: 0.375rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-surface-raised);
    box-shadow: var(--elevation-raised);
  }
  .more-menu > div {
    position: absolute;
    top: calc(100% + 0.375rem);
    right: 0;
  }
  /* Native top-layer popovers clear table clipping without changing columns. */
  .case-menu {
    position: fixed;
    inset: 0;
    margin: auto;
    width: max-content;
    height: fit-content;
    max-width: calc(100vw - 1rem);
    max-height: calc(100dvh - 1rem);
    overflow: auto;
    color: var(--color-foreground);
  }
  .more-menu button,
  .case-menu a,
  .case-menu button {
    display: block;
    width: 100%;
    padding: 0.625rem 0.75rem;
    border-radius: var(--radius-badge);
    color: var(--color-foreground);
    font-size: var(--text-sm);
    text-align: left;
  }
  .more-menu button:hover,
  .case-menu a:hover,
  .case-menu button:hover {
    background: var(--color-surface-hover);
  }
  .period-navigation {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--text-xs);
  }
  .period-navigation a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 550;
    min-height: 2rem;
