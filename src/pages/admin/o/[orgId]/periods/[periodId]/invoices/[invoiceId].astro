---
// Phase F (Billing) - invoice detail (spec Section 9.2, INV-001/003/004).
// Renders through the same renderInvoiceHtml() the PDF and the public
// token link use (Phase G, invoice template editor) -- so what an admin
// sees here always matches what actually gets sent, including the org's
// invoice template layout, and never a live join back to the org's
// *current* template (spec Section 21: an already-generated invoice's
// snapshot stays frozen even after the template is edited later).
import StatusBadge from "../../../../../../../components/ui/StatusBadge.astro";
import { renderInvoiceHtml } from "../../../../../../../domain/billing/invoice-html";
import {
  translate,
  uiLocale,
  formatDate,
  formatMoney,
} from "../../../../../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
import AdminLayout from "../../../../../../../layouts/AdminLayout.astro";
import { actions } from "astro:actions";
import {
  ForbiddenError,
  requireOrganizationAccess,
} from "../../../../../../../domain/authorization/guards";
import { getOrganization } from "../../../../../../../domain/organizations/organizations";
import { getPeriod } from "../../../../../../../domain/periods/periods";
import { getInvoice } from "../../../../../../../domain/billing/generation";
import { listDeliveries } from "../../../../../../../domain/billing/sending";
import { withRequestDb } from "../../../../../../../lib/db-request";

const organizationId = Astro.params.orgId!;
const periodId = Astro.params.periodId!;
const invoiceId = Astro.params.invoiceId!;
try {
  requireOrganizationAccess(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const prepareResult = Astro.getActionResult(actions.billing.prepare);
const sendResult = Astro.getActionResult(actions.invoices.send);
const resendResult = Astro.getActionResult(actions.invoices.resend);
const revokeResult = Astro.getActionResult(actions.invoices.revokeAccess);

let organization, period, invoice, lines, caseStatus, deliveries;
try {
  ({ organization, period, invoice, lines, caseStatus, deliveries } =
    await withRequestDb(async (db) => {
      const { invoice, lines, caseStatus } = await getInvoice(
        db,
        organizationId,
        invoiceId
      );
      return {
        organization: await getOrganization(db, organizationId),
        period: await getPeriod(db, organizationId, periodId),
        invoice,
        lines,
        caseStatus,
        deliveries: await listDeliveries(db, organizationId, invoiceId),
      };
    }));
} catch {
  return Astro.redirect(`/admin/o/${organizationId}/periods/${periodId}`);
}

const issuer = invoice.issuerSnapshot as Record<string, string | null>;
const recipient = invoice.recipientSnapshot as Record<string, string | null>;
const payment = invoice.paymentSnapshot as Record<string, string | null>;
const recipientIncomplete =
  (!recipient.billingName && !recipient.occupantName) ||
  !recipient.billingAddress;
const organizationIncomplete =
  !issuer.name || !issuer.addressLine1 || !payment.iban || !payment.bankName;
const invoiceHtml = renderInvoiceHtml(invoice, lines);
---

<AdminLayout
  title={`${invoice.invoiceNumber} - ${organization.name}`}
  organizationId={organizationId}
  organizationName={organization.name}
>
  <div class="space-y-6">
    <a
      href={`/admin/o/${organizationId}/periods/${periodId}`}
      class="text-sm text-muted hover:underline"
    >
      ← {t("Period")}
      {period.year}-{String(period.month).padStart(2, "0")}
    </a>

    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-sm font-semibold text-muted">{t("Invoice")}</p>
        <h1 class="text-xl font-bold text-foreground">
          {invoice.invoiceNumber}
          <span class="ml-2 text-sm font-normal text-muted">
            <StatusBadge status={caseStatus} />
          </span>
        </h1>
        <p class="mt-2 text-sm text-muted">
          {t("Amount due")}: <strong class="text-lg text-foreground"
            >{formatMoney(invoice.amountDue, invoice.currency, locale)}</strong
          > · {t("Due date")}
          {formatDate(invoice.dueDate, locale)}
        </p>
      </div>
      <div class="page-actions">
        {
          invoice.pdfObjectKey && (
            <a
              href={`/api/v1/admin/o/${organizationId}/invoices/${invoice.id}/pdf`}
              target="_blank"
              class="rounded-control border border-border px-4 py-2 text-sm text-foreground hover:bg-surface-hover"
            >
              {t("Download PDF")}
            </a>
          )
        }
        {
          caseStatus === "DRAFT" && (
            <form method="POST" action={actions.billing.prepare}>
              <input
                type="hidden"
                name="organizationId"
                value={organizationId}
              />
              <input type="hidden" name="invoiceId" value={invoice.id} />
              <button
                type="submit"
                disabled={recipientIncomplete || organizationIncomplete}
                aria-describedby={
                  recipientIncomplete || organizationIncomplete
                    ? "invoice-validation"
                    : undefined
                }
                class="btn-primary "
              >
                {t("Prepare")}
              </button>
            </form>
          )
        }
        {
          caseStatus === "PREPARED" && !invoice.sentAt && (
            <form method="POST" action={actions.invoices.send}>
              <input
                type="hidden"
                name="organizationId"
                value={organizationId}
              />
              <input type="hidden" name="invoiceId" value={invoice.id} />
              <button
                type="submit"
                disabled={!recipient.billingEmail}
                aria-describedby={
                  !recipient.billingEmail ? "email-validation" : undefined
                }
                class="btn-primary "
              >
                {t("Send")}
              </button>
            </form>
          )
        }
        {
          invoice.sentAt && (
            <form method="POST" action={actions.invoices.resend}>
              <input
                type="hidden"
                name="organizationId"
                value={organizationId}
              />
              <input type="hidden" name="invoiceId" value={invoice.id} />
              <button
                type="submit"
                class="rounded-control border border-border px-4 py-2 text-sm text-foreground hover:bg-surface-hover"
              >
                {t("Resend")}
              </button>
            </form>
          )
        }
        {
          invoice.sentAt && (
            <form method="POST" action={actions.invoices.revokeAccess}>
              <input
                type="hidden"
                name="organizationId"
                value={organizationId}
              />
              <input type="hidden" name="invoiceId" value={invoice.id} />
              <button
                type="submit"
                class="rounded-control border border-destructive px-4 py-2 text-sm text-destructive hover:bg-danger-surface"
              >
                {t("Revoke access link")}
              </button>
            </form>
          )
        }
      </div>
    </div>
    {
      (prepareResult?.error ||
        sendResult?.error ||
        resendResult?.error ||
        revokeResult?.error) && (
        <p class="rounded-control bg-danger-surface p-3 text-sm text-destructive">
          {prepareResult?.error?.message ??
            sendResult?.error?.message ??
            resendResult?.error?.message ??
            revokeResult?.error?.message}
        </p>
      )
    }

    {
      caseStatus === "DRAFT" &&
        (recipientIncomplete || organizationIncomplete) && (
          <section
            id="invoice-validation"
            class="notice notice-danger"
            role="alert"
          >
            {recipientIncomplete && (
              <p>
                {t(
                  "Recipient information is incomplete. Add a billing name or occupant name and billing address."
                )}{" "}
                <a
                  class="font-semibold underline"
                  href={
                    "/admin/o/" +
                    organizationId +
                    "/dwellings/" +
                    invoice.dwellingId
                  }
                >
                  {t("Fix dwelling details")}
                </a>
              </p>
            )}
            {organizationIncomplete && (
              <p>
                {t(
                  "Issuer or payment information is incomplete. Add the organization name, address, bank name and IBAN."
                )}{" "}
                <a
                  class="font-semibold underline"
                  href={"/admin/o/" + organizationId + "/settings/organization"}
                >
                  {t("Fix organization details")}
                </a>
              </p>
            )}
            <p class="mt-2">
              {t(
                "After correcting the details, regenerate this draft in the workbench to refresh its snapshot."
              )}
            </p>
          </section>
        )
    }
    {
      caseStatus === "PREPARED" && !recipient.billingEmail && (
        <p id="email-validation" class="notice notice-danger" role="alert">
          {t("Invoice email is missing. Add a billing email before sending.")}
        </p>
      )
    }
    {
      caseStatus === "DRAFT" && (
        <section class="panel p-4" aria-labelledby="preparation-checks">
          <>
            <h2 id="preparation-checks" class="section-title">
              {t("Preparation checks")}
            </h2>
            <ul class="mt-3 space-y-2 text-sm">
              <>
                <li>
                  {recipientIncomplete ? "!" : "✓"}{" "}
                  {t("Recipient details complete")}
                </li>
                <li>
                  {organizationIncomplete ? "!" : "✓"}{" "}
                  {t("Issuer and payment details complete")}
                </li>
                <li>✓ {t("Current charges calculated")}</li>
                <li>✓ {t("Account balance resolved")}</li>
              </>
            </ul>
          </>
        </section>
      )
    }
    <div class="invoice-preview-frame-wrap">
      <iframe
        class="invoice-preview-frame"
        title={t("Invoice")}
        srcdoc={invoiceHtml}></iframe>
    </div>

    {
      deliveries.length > 0 && (
        <section>
          <h2 class="section-title mb-3">{t("Delivery history")}</h2>
          <div class="table-wrap">
            <table class="w-full text-left text-sm">
              <thead class="border-b border-border bg-surface-hover text-muted">
                <tr>
                  <th class="px-4 py-2">{t("When")}</th>
                  <th class="px-4 py-2">{t("Method")}</th>
                  <th class="px-4 py-2">{t("To")}</th>
                  <th class="px-4 py-2">{t("Status")}</th>
                  <th class="px-4 py-2">{t("Error")}</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                {deliveries.map((d) => (
                  <tr>
                    <td class="px-4 py-2">
                      {formatDate(d.createdAt, locale, organization.timezone)}
                    </td>
                    <td class="px-4 py-2">
                      {d.method === "PAPER" ? t("Paper") : t("Email")}
                    </td>
                    <td class="px-4 py-2">{d.destinationEmail ?? "—"}</td>
                    <td class="px-4 py-2">
                      {d.status === "SENT" ? (
                        <span class="text-success">{t("Sent")}</span>
                      ) : (
                        <span class="text-destructive">{t("Failed")}</span>
                      )}
                    </td>
                    <td class="px-4 py-2 text-muted">{d.errorCode ?? "—"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }
  </div>
</AdminLayout>

<style>
  .invoice-preview-frame-wrap {
    background: var(--color-surface-hover);
    border-radius: var(--radius-panel);
    padding: 1rem;
  }
  .invoice-preview-frame {
    display: block;
    width: min(210mm, 100%);
    height: 70vh;
    margin-inline: auto;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
  }
</style>
