---
// Phase F (Billing) - invoice detail (spec Section 9.2, INV-001/003/004).
// Full formatted/branded preview + PDF is Phase G; this shows the raw
// persisted snapshot/line data, which is exactly what spec Section 21
// requires stay unchanged after SENT -- a useful thing to see directly.
import AdminLayout from "../../../../../../../layouts/AdminLayout.astro";
import { actions } from "astro:actions";
import {
  ForbiddenError,
  requireOrganizationAccess,
} from "../../../../../../../domain/authorization/guards";
import { getOrganization } from "../../../../../../../domain/organizations/organizations";
import { getPeriod } from "../../../../../../../domain/periods/periods";
import { getInvoice } from "../../../../../../../domain/billing/generation";
import { withRequestDb } from "../../../../../../../lib/db-request";

const organizationId = Astro.params.orgId!;
const periodId = Astro.params.periodId!;
const invoiceId = Astro.params.invoiceId!;
try {
  requireOrganizationAccess(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const prepareResult = Astro.getActionResult(actions.billing.prepare);

let organization, period, invoice, lines, caseStatus;
try {
  ({ organization, period, invoice, lines, caseStatus } = await withRequestDb(
    async (db) => {
      const { invoice, lines, caseStatus } = await getInvoice(
        db,
        organizationId,
        invoiceId
      );
      return {
        organization: await getOrganization(db, organizationId),
        period: await getPeriod(db, organizationId, periodId),
        invoice,
        lines,
        caseStatus,
      };
    }
  ));
} catch {
  return Astro.redirect(`/admin/o/${organizationId}/periods/${periodId}`);
}

const issuer = invoice.issuerSnapshot as Record<string, string | null>;
const recipient = invoice.recipientSnapshot as Record<string, string | null>;
const payment = invoice.paymentSnapshot as Record<string, string | null>;
---

<AdminLayout
  title={`${invoice.invoiceNumber} - ${organization.name}`}
  organizationId={organizationId}
  organizationName={organization.name}
>
  <div class="max-w-3xl space-y-6">
    <a
      href={`/admin/o/${organizationId}/periods/${periodId}`}
      class="text-sm text-neutral-600 hover:underline"
    >
      ← Period {period.year}-{String(period.month).padStart(2, "0")}
    </a>

    <div class="flex items-center justify-between">
      <h1 class="text-xl font-bold text-neutral-900">
        {invoice.invoiceNumber}
        <span class="ml-2 text-sm font-normal text-neutral-500">
          ({caseStatus})
        </span>
      </h1>
      {
        caseStatus === "DRAFT" && (
          <form method="POST" action={actions.billing.prepare}>
            <input type="hidden" name="organizationId" value={organizationId} />
            <input type="hidden" name="invoiceId" value={invoice.id} />
            <button
              type="submit"
              class="rounded-md bg-neutral-900 px-4 py-2 text-sm font-medium text-white"
            >
              Prepare
            </button>
          </form>
        )
      }
    </div>
    {
      prepareResult?.error && (
        <p class="rounded-md bg-red-50 p-3 text-sm text-red-800">
          {prepareResult.error.message}
        </p>
      )
    }

    <div class="grid grid-cols-2 gap-4">
      <section class="rounded-xl border border-neutral-200 bg-white p-4">
        <h2 class="text-sm font-bold text-neutral-900">Issuer</h2>
        <p class="mt-2 text-sm text-neutral-700">
          {issuer.name}
          <br />
          {issuer.addressLine1}
          {issuer.city && <>, {issuer.city}</>}
        </p>
      </section>
      <section class="rounded-xl border border-neutral-200 bg-white p-4">
        <h2 class="text-sm font-bold text-neutral-900">Recipient</h2>
        <p class="mt-2 text-sm text-neutral-700">
          Dwelling {recipient.dwellingNumber}
          <br />
          {recipient.billingName ?? recipient.occupantName ?? "—"}
          <br />
          {recipient.billingEmail ?? "—"}
        </p>
      </section>
      <section class="rounded-xl border border-neutral-200 bg-white p-4">
        <h2 class="text-sm font-bold text-neutral-900">Payment</h2>
        <p class="mt-2 text-sm text-neutral-700">
          {payment.bankName ?? "—"}
          <br />
          {payment.iban ?? "—"}
        </p>
      </section>
      <section class="rounded-xl border border-neutral-200 bg-white p-4">
        <h2 class="text-sm font-bold text-neutral-900">Dates</h2>
        <p class="mt-2 text-sm text-neutral-700">
          Issued {invoice.issueDate}
          <br />
          Due {invoice.dueDate}
        </p>
      </section>
    </div>

    <div class="overflow-x-auto rounded-lg border border-neutral-200 bg-white">
      <table class="w-full text-left text-sm">
        <thead
          class="border-b border-neutral-200 bg-neutral-50 text-neutral-600"
        >
          <tr>
            <th class="px-4 py-2">Description</th>
            <th class="px-4 py-2">Quantity</th>
            <th class="px-4 py-2">Unit price</th>
            <th class="px-4 py-2">Net</th>
            <th class="px-4 py-2">VAT</th>
            <th class="px-4 py-2">Gross</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-100">
          {
            lines.map((line) => (
              <tr>
                <td class="px-4 py-2">{line.description}</td>
                <td class="px-4 py-2">
                  {line.quantity} {line.unit}
                </td>
                <td class="px-4 py-2">{line.unitPrice ?? "—"}</td>
                <td class="px-4 py-2">{line.netAmount}</td>
                <td class="px-4 py-2">{line.vatAmount}</td>
                <td class="px-4 py-2 font-medium">{line.grossAmount}</td>
              </tr>
            ))
          }
        </tbody>
        <tfoot class="border-t border-neutral-200 font-medium">
          <tr>
            <td colspan="3" class="px-4 py-2 text-right"> Totals </td>
            <td class="px-4 py-2">{invoice.subtotal}</td>
            <td class="px-4 py-2">{invoice.vatTotal}</td>
            <td class="px-4 py-2">
              {invoice.total}
              {invoice.currency}
            </td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
</AdminLayout>
