---
// Phase E (Periods/meters/readings) - admin reading entry for one
// dwelling/period (spec Section 9.2, MTR-002).
import {
  translate,
  uiLocale,
  entityLabel,
  friendlyActionErrorMessage,
} from "../../../../../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
import AdminLayout from "../../../../../../../layouts/AdminLayout.astro";
import { actions } from "astro:actions";
import {
  ForbiddenError,
  requireOrganizationAccess,
} from "../../../../../../../domain/authorization/guards";
import { getOrganization } from "../../../../../../../domain/organizations/organizations";
import { getDwelling } from "../../../../../../../domain/organizations/dwellings";
import { getPeriod } from "../../../../../../../domain/periods/periods";
import { listMetersWithReadingForPeriod } from "../../../../../../../domain/periods/cases";
import { withRequestDb } from "../../../../../../../lib/db-request";

const organizationId = Astro.params.orgId!;
const periodId = Astro.params.periodId!;
const dwellingId = Astro.params.dwellingId!;
try {
  requireOrganizationAccess(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const submitResult = Astro.getActionResult(actions.readings.adminSubmit);

let organization, period, dwelling, meters;
try {
  ({ organization, period, dwelling, meters } = await withRequestDb(
    async (db) => ({
      organization: await getOrganization(db, organizationId),
      period: await getPeriod(db, organizationId, periodId),
      dwelling: await getDwelling(db, organizationId, dwellingId),
      meters: await listMetersWithReadingForPeriod(
        db,
        organizationId,
        dwellingId,
        periodId
      ),
    })
  ));
} catch {
  return Astro.redirect(`/admin/o/${organizationId}/periods/${periodId}`);
}
---

<AdminLayout
  title={`${dwelling.number} readings - ${organization.name}`}
  organizationId={organizationId}
  organizationName={organization.name}
>
  <div class="space-y-6">
    <a
      href={`/admin/o/${organizationId}/periods/${periodId}`}
      class="text-body-sm text-muted hover:underline"
    >
      ← {t("Period")}{" "}
      {period.year}-{String(period.month).padStart(2, "0")}
    </a>
    <h1 class="text-h2 text-foreground">
      Dwelling {dwelling.number} readings
    </h1>
    {
      submitResult?.error && (
        <p class="rounded-control bg-danger-surface p-3 text-body-sm text-destructive">
          {friendlyActionErrorMessage(submitResult.error, locale)}
        </p>
      )
    }
    {
      period.status === "LOCKED" && (
        <p class="rounded-control bg-canvas p-3 text-body-sm text-foreground">
          {t("This period is locked; readings can no longer be edited.")}
        </p>
      )
    }

    <div class="space-y-4">
      {
        meters
          .filter((m) => !m.archivedAt)
          .map((m) => (
            <section class="rounded-panel border border-border bg-surface p-4">
              <h2 class="font-medium text-foreground">
                {m.label ?? entityLabel(m.type, locale)}{" "}
                <span class="text-body-sm text-muted">
                  ({entityLabel(m.type, locale)}
                  {m.serialNumber ? ` · ${m.serialNumber}` : ""} · {m.unit})
                </span>
              </h2>
              {m.currentValue !== null && (
                <p class="mt-2 text-body-sm text-muted">
                  Previous: {m.previousValue ?? "—"} · Current: {m.currentValue}{" "}
                  · Consumption: {m.consumption} ({m.source})
                </p>
              )}
              {period.status === "OPEN" && (
                <form
                  method="POST"
                  action={actions.readings.adminSubmit}
                  class="mt-3 flex flex-wrap items-end gap-3"
                >
                  <input
                    type="hidden"
                    name="organizationId"
                    value={organizationId}
                  />
                  <input type="hidden" name="periodId" value={periodId} />
                  <input type="hidden" name="meterId" value={m.meterId} />
                  <div>
                    <label
                      for={"reading-" + m.meterId}
                      class="block text-label text-foreground"
                    >
                      {t("Current value")}
                    </label>
                    <input
                      id={"reading-" + m.meterId}
                      name="currentValue"
                      type="text"
                      inputmode="decimal"
                      pattern="\d+(\.\d{1,3})?"
                      required
                      value={m.currentValue ?? ""}
                      class="mt-1 w-40 rounded-control border border-border px-3 py-2 text-body-sm"
                    />
                  </div>
                  {m.currentValue !== null && (
                    <label class="flex items-center gap-2 pb-2 text-body-sm text-foreground">
                      <input type="checkbox" name="force" value="true" />
                      {t("Confirm even if lower than previous")}
                    </label>
                  )}
                  <button type="submit" class="btn-primary ">
                    {t("Save")}
                  </button>
                </form>
              )}
            </section>
          ))
      }
      {
        meters.filter((m) => !m.archivedAt).length === 0 && (
          <p class="text-body-sm text-muted">
            {t("This dwelling has no active meters.")}
          </p>
        )
      }
    </div>
  </div>
</AdminLayout>
