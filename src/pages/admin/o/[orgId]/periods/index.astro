---
// Phase E (Periods/meters/readings) - period history/create (spec Section
// 9.2, 27 "Periods: History", PER-001).
import PageHeader from "../../../../../components/ui/PageHeader.astro";
import KpiCard from "../../../../../components/ui/KpiCard.astro";
import StatusBadge from "../../../../../components/ui/StatusBadge.astro";
import {
  translate,
  uiLocale,
  formatDate,
  formatPeriod,
} from "../../../../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
import FieldError from "../../../../../components/ui/FieldError.astro";
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import { actions } from "astro:actions";
import {
  ForbiddenError,
  requireOrganizationAccess,
} from "../../../../../domain/authorization/guards";
import { getOrganization } from "../../../../../domain/organizations/organizations";
import { listPeriods } from "../../../../../domain/periods/periods";
import { withRequestDb } from "../../../../../lib/db-request";

const organizationId = Astro.params.orgId!;
try {
  requireOrganizationAccess(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const createResult = Astro.getActionResult(actions.periods.create);

const { organization, periods } = await withRequestDb(async (db) => ({
  organization: await getOrganization(db, organizationId),
  periods: await listPeriods(db, organizationId),
}));
---

<AdminLayout
  title={`Periods - ${organization.name}`}
  organizationId={organizationId}
  organizationName={organization.name}
>
  <div class="space-y-6">
    <nav class="breadcrumb" aria-label={t("Breadcrumb")}>
      <a href={`/admin/o/${organizationId}/dashboard`}>{t("Dashboard")}</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{t("Periods")}</span>
    </nav>
    <PageHeader
      title={t("Periods")}
      description={t(
        "Review past periods or open a monthly billing workbench."
      )}
      display
      ><a
        href="#create-period"
        class="btn-primary"
        data-open-details="create-period">{t("Create period")} →</a
      ></PageHeader
    >
    <div class="grid gap-4 sm:grid-cols-3">
      <KpiCard
        icon="invoice"
        label={t("Total periods")}
        value={periods.length}
      /><KpiCard
        icon="open"
        label={t("Open")}
        value={periods.filter((p) => p.status === "OPEN").length}
      /><KpiCard
        icon="lock"
        label={t("Locked")}
        value={periods.filter((p) => p.status === "LOCKED").length}
      />
    </div>

    <div class="table-wrap">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-border bg-surface-hover text-muted">
          <tr>
            <th class="px-4 py-2">{t("Period")}</th>
            <th class="px-4 py-2">{t("Dates")}</th>
            <th class="px-4 py-2">{t("Reading deadline")}</th>
            <th class="px-4 py-2">{t("Issue date")}</th><th class="px-4 py-2"
              >{t("Due date")}</th
            ><th class="px-4 py-2">{t("Status")}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          {
            periods.map((p) => (
              <tr class="row-link">
                <td class="px-4 py-2 font-medium">
                  <a
                    href={`/admin/o/${organizationId}/periods/${p.id}`}
                    class="row-link-target hover:underline"
                  >
                    {formatPeriod(p.year, p.month, locale)}
                  </a>
                </td>
                <td class="px-4 py-2">
                  {formatDate(p.startsOn, locale)} →{" "}
                  {formatDate(p.endsOn, locale)}
                </td>
                <td class="px-4 py-2">
                  {formatDate(p.readingDeadline, locale)}
                </td>
                <>
                  <td class="px-4 py-2">
                    {formatDate(p.invoiceIssueDate, locale)}
                  </td>
                  <td class="px-4 py-2">
                    {formatDate(p.invoiceDueDate, locale)}
                  </td>
                  <td class="px-4 py-2">
                    <StatusBadge status={p.status} />
                  </td>
                </>
              </tr>
            ))
          }
          {
            periods.length === 0 && (
              <tr>
                <td colspan="6" class="px-4 py-8 text-center text-muted">
                  {t("No billing periods yet.")}
                </td>
              </tr>
            )
          }
        </tbody>
      </table>
    </div>

    <details
      id="create-period"
      class="disclosure max-w-2xl"
      open={!!createResult?.error}
    >
      <summary>{t("Create period")}</summary>
      {
        createResult?.error && (
          <p class="mt-3 rounded-control bg-danger-surface p-3 text-sm text-destructive">
            {createResult.error.message}
          </p>
        )
      }
      <form
        method="POST"
        action={actions.periods.create}
        class="mt-4 grid grid-cols-2 gap-3"
      >
        <input type="hidden" name="organizationId" value={organizationId} />
        <div>
          <label class="block text-sm font-medium text-foreground" for="year"
            >{t("Year")}</label
          >
          <input
            id="year"
            name="year"
            aria-describedby="year-error"
            type="number"
            required
            class="mt-1 w-full rounded-control border border-border px-3 py-2 text-sm"
          /><FieldError name="year" error={createResult?.error} />
        </div>
        <div>
          <label class="block text-sm font-medium text-foreground" for="month"
            >{t("Month")}</label
          >
          <input
            id="month"
            name="month"
            aria-describedby="month-error"
            type="number"
            min="1"
            max="12"
            required
            class="mt-1 w-full rounded-control border border-border px-3 py-2 text-sm"
          /><FieldError name="month" error={createResult?.error} />
        </div>
        <h3 class="col-span-2 mt-3 font-semibold text-sm">
          {t("Billing window")}
        </h3>
        <div>
          <label
            class="block text-sm font-medium text-foreground"
            for="startsOn">{t("Starts on")}</label
          >
          <input
            id="startsOn"
            name="startsOn"
            aria-describedby="startsOn-error"
            type="date"
            required
            class="mt-1 w-full rounded-control border border-border px-3 py-2 text-sm"
          /><FieldError name="startsOn" error={createResult?.error} />
        </div>
        <div>
          <label class="block text-sm font-medium text-foreground" for="endsOn"
            >{t("Ends on")}</label
          >
          <input
            id="endsOn"
            name="endsOn"
            aria-describedby="endsOn-error"
            type="date"
            required
            class="mt-1 w-full rounded-control border border-border px-3 py-2 text-sm"
          /><FieldError name="endsOn" error={createResult?.error} />
        </div>
        <div>
          <label
            class="block text-sm font-medium text-foreground"
            for="readingDeadline">{t("Reading deadline")}</label
          >
          <input
            id="readingDeadline"
            name="readingDeadline"
            aria-describedby="readingDeadline-error"
            type="date"
            class="mt-1 w-full rounded-control border border-border px-3 py-2 text-sm"
          /><FieldError name="readingDeadline" error={createResult?.error} />
        </div>
        <div></div><h3 class="col-span-2 mt-3 font-semibold text-sm">
          {t("Invoice dates")}
        </h3>
        <div>
          <label
            class="block text-sm font-medium text-foreground"
            for="invoiceIssueDate">{t("Invoice issue date")}</label
          >
          <input
            id="invoiceIssueDate"
            name="invoiceIssueDate"
            aria-describedby="invoiceIssueDate-error"
            type="date"
            required
            class="mt-1 w-full rounded-control border border-border px-3 py-2 text-sm"
          /><FieldError name="invoiceIssueDate" error={createResult?.error} />
        </div>
        <div>
          <label
            class="block text-sm font-medium text-foreground"
            for="invoiceDueDate">{t("Invoice due date")}</label
          >
          <input
            id="invoiceDueDate"
            name="invoiceDueDate"
            aria-describedby="invoiceDueDate-error"
            type="date"
            required
            class="mt-1 w-full rounded-control border border-border px-3 py-2 text-sm"
          /><FieldError name="invoiceDueDate" error={createResult?.error} />
        </div>
        <div class="col-span-2">
          <button type="submit" class="btn-primary">
            {t("Create period")}
          </button>
        </div>
      </form>
    </details>
  </div>
</AdminLayout>
