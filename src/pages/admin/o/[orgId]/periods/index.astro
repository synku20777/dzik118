---
// Phase E (Periods/meters/readings) - period history/create (spec Section
// 9.2, 27 "Periods: History", PER-001).
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import { actions } from "astro:actions";
import {
  ForbiddenError,
  requireOrganizationAccess,
} from "../../../../../domain/authorization/guards";
import { getOrganization } from "../../../../../domain/organizations/organizations";
import { listPeriods } from "../../../../../domain/periods/periods";
import { withRequestDb } from "../../../../../lib/db-request";

const organizationId = Astro.params.orgId!;
try {
  requireOrganizationAccess(Astro.locals.auth, organizationId);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const createResult = Astro.getActionResult(actions.periods.create);

const { organization, periods } = await withRequestDb(async (db) => ({
  organization: await getOrganization(db, organizationId),
  periods: await listPeriods(db, organizationId),
}));
---

<AdminLayout
  title={`Periods - ${organization.name}`}
  organizationId={organizationId}
  organizationName={organization.name}
>
  <div class="space-y-6">
    <h1 class="text-xl font-bold text-neutral-900">Billing periods</h1>

    <div class="overflow-x-auto rounded-lg border border-neutral-200 bg-white">
      <table class="w-full text-left text-sm">
        <thead
          class="border-b border-neutral-200 bg-neutral-50 text-neutral-600"
        >
          <tr>
            <th class="px-4 py-2">Period</th>
            <th class="px-4 py-2">Dates</th>
            <th class="px-4 py-2">Reading deadline</th>
            <th class="px-4 py-2">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-100">
          {
            periods.map((p) => (
              <tr>
                <td class="px-4 py-2 font-medium">
                  <a
                    href={`/admin/o/${organizationId}/periods/${p.id}`}
                    class="hover:underline"
                  >
                    {p.year}-{String(p.month).padStart(2, "0")}
                  </a>
                </td>
                <td class="px-4 py-2">
                  {p.startsOn} → {p.endsOn}
                </td>
                <td class="px-4 py-2">{p.readingDeadline ?? "—"}</td>
                <td class="px-4 py-2">
                  {p.status === "LOCKED" ? "Locked" : "Open"}
                </td>
              </tr>
            ))
          }
          {
            periods.length === 0 && (
              <tr>
                <td colspan="4" class="px-4 py-8 text-center text-neutral-500">
                  No billing periods yet.
                </td>
              </tr>
            )
          }
        </tbody>
      </table>
    </div>

    <section class="max-w-lg rounded-xl border border-neutral-200 bg-white p-6">
      <h2 class="text-lg font-bold text-neutral-900">Create period</h2>
      {
        createResult?.error && (
          <p class="mt-3 rounded-md bg-red-50 p-3 text-sm text-red-800">
            {createResult.error.message}
          </p>
        )
      }
      <form
        method="POST"
        action={actions.periods.create}
        class="mt-4 grid grid-cols-2 gap-3"
      >
        <input type="hidden" name="organizationId" value={organizationId} />
        <div>
          <label class="block text-sm font-medium text-neutral-700" for="year"
            >Year</label
          >
          <input
            id="year"
            name="year"
            type="number"
            required
            class="mt-1 w-full rounded-md border border-neutral-300 px-3 py-2 text-sm"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-neutral-700" for="month"
            >Month</label
          >
          <input
            id="month"
            name="month"
            type="number"
            min="1"
            max="12"
            required
            class="mt-1 w-full rounded-md border border-neutral-300 px-3 py-2 text-sm"
          />
        </div>
        <div>
          <label
            class="block text-sm font-medium text-neutral-700"
            for="startsOn">Starts on</label
          >
          <input
            id="startsOn"
            name="startsOn"
            type="date"
            required
            class="mt-1 w-full rounded-md border border-neutral-300 px-3 py-2 text-sm"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-neutral-700" for="endsOn"
            >Ends on</label
          >
          <input
            id="endsOn"
            name="endsOn"
            type="date"
            required
            class="mt-1 w-full rounded-md border border-neutral-300 px-3 py-2 text-sm"
          />
        </div>
        <div>
          <label
            class="block text-sm font-medium text-neutral-700"
            for="readingDeadline">Reading deadline</label
          >
          <input
            id="readingDeadline"
            name="readingDeadline"
            type="date"
            class="mt-1 w-full rounded-md border border-neutral-300 px-3 py-2 text-sm"
          />
        </div>
        <div></div>
        <div>
          <label
            class="block text-sm font-medium text-neutral-700"
            for="invoiceIssueDate">Invoice issue date</label
          >
          <input
            id="invoiceIssueDate"
            name="invoiceIssueDate"
            type="date"
            required
            class="mt-1 w-full rounded-md border border-neutral-300 px-3 py-2 text-sm"
          />
        </div>
        <div>
          <label
            class="block text-sm font-medium text-neutral-700"
            for="invoiceDueDate">Invoice due date</label
          >
          <input
            id="invoiceDueDate"
            name="invoiceDueDate"
            type="date"
            required
            class="mt-1 w-full rounded-md border border-neutral-300 px-3 py-2 text-sm"
          />
        </div>
        <div class="col-span-2">
          <button
            type="submit"
            class="rounded-md bg-neutral-900 px-4 py-2 text-sm font-medium text-white"
          >
            Create period
          </button>
        </div>
      </form>
    </section>
  </div>
</AdminLayout>
