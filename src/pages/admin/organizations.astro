---
// Phase D (Organizations/dwellings) - organization selector/create (spec
// Section 9.2, ORG-001).
import AdminLayout from "../../layouts/AdminLayout.astro";
import { actions } from "astro:actions";
import { withRequestDb } from "../../lib/db-request";
import { listOrganizations } from "../../domain/organizations/organizations";
import {
  ForbiddenError,
  requireAdminRole,
} from "../../domain/authorization/guards";

const auth = Astro.locals.auth;
try {
  requireAdminRole(auth);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const createResult = Astro.getActionResult(actions.organizations.create);
if (createResult && !createResult.error) {
  return Astro.redirect(`/admin/o/${createResult.data.id}/dwellings`);
}

const organizations = await withRequestDb((db) =>
  listOrganizations(db, auth.organizationIds)
);
---

<AdminLayout title="Organizations - Property Billing">
  <div class="space-y-8">
    <section>
      <h1 class="text-xl font-bold text-neutral-900">Your organizations</h1>
      {
        organizations.length === 0 ? (
          <p class="mt-2 text-sm text-neutral-600">
            You don't belong to any organization yet. Create one below.
          </p>
        ) : (
          <ul class="mt-4 divide-y divide-neutral-200 rounded-lg border border-neutral-200 bg-white">
            {organizations.map((org) => (
              <li>
                <a
                  href={`/admin/o/${org.id}/dashboard`}
                  class="flex items-center justify-between px-4 py-3 hover:bg-neutral-50"
                >
                  <span class="font-medium text-neutral-900">{org.name}</span>
                  <span class="text-sm text-neutral-500">
                    {org.addressLine1}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section class="max-w-lg rounded-xl border border-neutral-200 bg-white p-6">
      <h2 class="text-lg font-bold text-neutral-900">Create organization</h2>
      {
        createResult?.error && (
          <p class="mt-3 rounded-md bg-red-50 p-3 text-sm text-red-800">
            {createResult.error.message}
          </p>
        )
      }
      <form
        method="POST"
        action={actions.organizations.create}
        class="mt-4 space-y-3"
      >
        <div>
          <label class="block text-sm font-medium text-neutral-700" for="name"
            >Name</label
          >
          <input
            id="name"
            name="name"
            required
            class="mt-1 w-full rounded-md border border-neutral-300 px-3 py-2 text-sm"
          />
        </div>
        <div>
          <label
            class="block text-sm font-medium text-neutral-700"
            for="addressLine1">Address</label
          >
          <input
            id="addressLine1"
            name="addressLine1"
            required
            class="mt-1 w-full rounded-md border border-neutral-300 px-3 py-2 text-sm"
          />
        </div>
        <button
          type="submit"
          class="rounded-md bg-neutral-900 px-4 py-2 text-sm font-medium text-white"
        >
          Create
        </button>
      </form>
    </section>
  </div>
</AdminLayout>
