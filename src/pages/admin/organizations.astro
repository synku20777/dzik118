---
import { translate, uiLocale } from "../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
// Phase D (Organizations/dwellings) - organization selector/create (spec
// Section 9.2, ORG-001).
import AdminLayout from "../../layouts/AdminLayout.astro";
import { actions } from "astro:actions";
import { withRequestDb } from "../../lib/db-request";
import { listOrganizations } from "../../domain/organizations/organizations";
import {
  ForbiddenError,
  requireAdminRole,
} from "../../domain/authorization/guards";

const auth = Astro.locals.auth;
try {
  requireAdminRole(auth);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const createResult = Astro.getActionResult(actions.organizations.create);
if (createResult && !createResult.error) {
  return Astro.redirect(`/admin/o/${createResult.data.id}/dwellings`);
}

const organizations = await withRequestDb((db) =>
  listOrganizations(db, auth.organizationIds)
);
---

<AdminLayout title="Organizations - Property Billing">
  <div class="space-y-8">
    <section>
      <h1 class="text-h2 text-foreground">
        {t("Your organizations")}
      </h1>
      {
        organizations.length === 0 ? (
          <p class="mt-2 text-body-sm text-muted">
            {t("You don't belong to any organization yet. Create one below.")}
          </p>
        ) : (
          <ul class="mt-4 divide-y divide-border rounded-control border border-border bg-surface">
            {organizations.map((org) => (
              <li>
                <a
                  href={`/admin/o/${org.id}/dashboard`}
                  class="flex items-center justify-between px-4 py-3 hover:bg-surface-hover"
                >
                  <span class="font-medium text-foreground">{org.name}</span>
                  <span class="text-body-sm text-muted">
                    {org.addressLine1}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section class="max-w-lg rounded-panel border border-border bg-surface p-6">
      <h2 class="text-h3 text-foreground">
        {t("Create organization")}
      </h2>
      {
        createResult?.error && (
          <p class="mt-3 rounded-control bg-danger-surface p-3 text-body-sm text-destructive">
            {createResult.error.message}
          </p>
        )
      }
      <form
        method="POST"
        action={actions.organizations.create}
        class="mt-4 space-y-3"
      >
        <div>
          <label class="block text-label text-foreground" for="name"
            >{t("Name")}</label
          >
          <input
            id="name"
            name="name"
            required
            class="mt-1 w-full rounded-control border border-border px-3 py-2 text-body-sm"
          />
        </div>
        <div>
          <label class="block text-label text-foreground" for="addressLine1"
            >{t("Address")}</label
          >
          <input
            id="addressLine1"
            name="addressLine1"
            required
            class="mt-1 w-full rounded-control border border-border px-3 py-2 text-body-sm"
          />
        </div>
        <button type="submit" class="btn-primary">
          {t("Create")}
        </button>
      </form>
    </section>
  </div>
</AdminLayout>
