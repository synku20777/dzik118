---
import { translate, uiLocale } from "../../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
// Phase D (Organizations/dwellings) - organization selector/create (spec
// Section 9.2, ORG-001).
import AdminLayout from "../../layouts/AdminLayout.astro";
import StatusBadge from "../../components/ui/StatusBadge.astro";
import { actions } from "astro:actions";
import { withRequestDb } from "../../lib/db-request";
import { listOrganizations } from "../../domain/organizations/organizations";
import {
  ForbiddenError,
  requireAdminRole,
} from "../../domain/authorization/guards";

const auth = Astro.locals.auth;
try {
  requireAdminRole(auth);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

const createResult = Astro.getActionResult(actions.organizations.create);
if (createResult && !createResult.error) {
  return Astro.redirect(`/admin/o/${createResult.data.id}/setup/organization`);
}

const organizations = await withRequestDb((db) =>
  listOrganizations(db, auth.organizationIds)
);
// Archived organizations are listed last (ADR 0009).
const active = organizations.filter((o) => !o.archivedAt);
const archived = organizations.filter((o) => o.archivedAt);
---

<AdminLayout
  title={`${t("Your organizations")} – Namkopa`}
  breadcrumbs={[{ label: t("Your organizations") }]}
>
  <div class="space-y-8">
    <section>
      <h1 class="text-h2 text-foreground">{t("Your organizations")}</h1>
      {organizations.length === 0 ? (
        <p class="mt-2 text-body-sm text-muted">
          {t("You don't belong to any organization yet. Create one below.")}
        </p>
      ) : (
        <ul class="menu-list mt-4 rounded-panel contained bg-surface p-1 [corner-shape:squircle]">
          {[...active, ...archived].map((org) => (
            <li>
              <a
                href={`/admin/o/${org.id}/dashboard`}
                class="justify-between gap-3 px-4 py-3"
              >
                <span class="min-w-0 font-medium text-foreground [overflow-wrap:anywhere]">
                  {org.name}
                  {org.archivedAt && (
                    <span class="ml-2">
                      <StatusBadge status="ARCHIVED" />
                    </span>
                  )}
                </span>
                <span class="min-w-0 text-right text-body-sm text-muted [overflow-wrap:anywhere]">
                  {org.addressLine1}
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="box max-w-lg">
      <h2 class="text-h3 text-foreground">{t("Create organization")}</h2>
      {createResult?.error && (
        <p class="notice notice-danger mt-3" role="alert">
          {createResult.error.message}
        </p>
      )}
      <form
        method="POST"
        action={actions.organizations.create}
        class="mt-4 space-y-3"
      >
        <div>
          <label class="field-label" for="name">
            {t("Name")}
          </label>
          <input
            id="name"
            name="name"
            required
            class="mt-1 w-full text-body-sm"
          />
        </div>
        <div>
          <label class="field-label" for="addressLine1">
            {t("Address")}
          </label>
          <input
            id="addressLine1"
            name="addressLine1"
            required
            class="mt-1 w-full text-body-sm"
          />
        </div>
        <button type="submit" class="btn-primary">
          {t("Create")}
        </button>
      </form>
    </section>
  </div>
</AdminLayout>
