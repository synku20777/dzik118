---
// Phase D (Organizations/dwellings) / Phase H (Admin UX) -
// organization redirect/selector (spec Section 9.2).
import {
  ForbiddenError,
  requireAdminRole,
} from "../../domain/authorization/guards";

const auth = Astro.locals.auth;
try {
  requireAdminRole(auth);
} catch (err) {
  if (err instanceof ForbiddenError) return Astro.redirect("/unauthorized");
  throw err;
}

if (auth.organizationIds.length === 1) {
  return Astro.redirect(`/admin/o/${auth.organizationIds[0]}/dashboard`);
}
return Astro.redirect("/admin/organizations");
---
