---
import AuthLayout from "../layouts/AuthLayout.astro";
import Ornament from "../components/ui/Ornament.astro";
import { translate, uiLocale } from "../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);
const sent = Astro.url.searchParams.get("sent") === "1";
const expired = Astro.url.searchParams.get("error") === "1";
---

<AuthLayout title={t("Forgot password") + " - " + t("Property Billing")}>
  <div class="w-full max-w-md space-y-6">
    <div class="space-y-3 text-center">
      <p class="font-display text-2xl font-semibold">{t("Property Billing")}</p>
      <Ornament />
    </div>
    <div class="rounded-panel border border-border bg-surface p-8">
      <h1 class="text-xl font-bold text-foreground">{t("Forgot password")}</h1>
      {
        !sent && (
          <p class="mt-1 text-sm text-muted">
            {t(
              "Enter your admin email and we'll send you a link to choose a new password."
            )}
          </p>
        )
      }
      {
        sent && (
          <p
            class="mt-4 rounded-control bg-success-surface p-3 text-sm text-success"
            role="status"
          >
            {t(
              "If that email belongs to an admin account, a reset link is on its way."
            )}
          </p>
        )
      }
      {
        expired && (
          <p
            class="mt-4 rounded-control bg-danger-surface p-3 text-sm text-destructive"
            role="alert"
          >
            {t("This reset link is invalid or has expired. Request a new one.")}
          </p>
        )
      }
      {
        !sent && (
          <form
            method="POST"
            action="/api/v1/auth/request-reset"
            class="mt-4 space-y-3"
          >
            <div>
              <label
                class="block text-sm font-medium text-foreground"
                for="email"
              >
                {t("Email")}
              </label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                class="mt-1 w-full rounded-control border border-border px-3 py-2 text-sm"
              />
            </div>
            <button type="submit" class="btn-primary w-full">
              {t("Send reset link")}
            </button>
          </form>
        )
      }
      <p class="mt-4 text-center text-sm">
        <a href="/login" class="text-muted hover:underline"
          >{t("Back to sign in")}</a
        >
      </p>
    </div>
  </div>
</AuthLayout>
