        <section id="table" class="ds-topic" data-component="table">
          <h1 tabindex="-1">Table</h1>
          <p class="ds-lead">
            Column headers (<code>thead th</code>) are uppercase 12px muted
            labels at <code>0.04em</code> tracking over{" "}
            <code>--color-table-th-bg</code>, rows highlight on hover via{" "}
