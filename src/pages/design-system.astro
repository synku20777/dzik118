const emailSnippet = `<label class="field-label" for="email">Billing email</label>
<input id="email" name="email" type="email" autocomplete="email" spellcheck="false" aria-describedby="email-hint" class="mt-1" />
<p id="email-hint" class="field-hint">Invoices are sent here.</p>`;

const boxes = [
  ["box", "The default: a flat group with a hairline"],
  ["box box-well", "Set back: secondary detail inside a page"],
  ["box box-raised", "One step forward: a card that can be picked"],
  ["box box-floating", "Floats over the page: a panel that stays in view"],
] as const;
const links = [
  ["link", "A link outside running text, such as a table cell"],
  ["link link-ghost", "A quiet link that takes the text colour"],
  ["link link-underlined", "A link inside running text"],
  ["link link-ghost link-underlined", "A quiet link inside running text"],
] as const;

const dropdownSnippet = `<details class="dropdown" data-dismiss>
  <summary class="btn-secondary">
    Export <Icon name="chevron-right" size="xs" class="dropdown-chevron" />
  </summary>
  <div class="dropdown-panel">
    <a class="dropdown-item" href="…"><Icon name="download" size="sm" /> Invoices as PDF</a>
    <hr class="dropdown-divider" />
    <a class="dropdown-item" href="…">
      <span>Bank statement <span class="dropdown-item-note">ISO 20022 camt.053</span></span>
