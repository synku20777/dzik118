const stackingTokens = [
  ["--z-raised", "1", "Above a sibling overlay"],
  ["--z-sticky", "10", "Sticky bars"],
  ["--z-popover", "20", "Menus, popovers and the sidebar"],
  ["--z-overlay", "30", "Floating panels"],
  ["--z-toast", "90", "Save-status toasts"],
