    <script is:inline>
      // One topic at a time, like a page per topic: the URL fragment picks it.
      // Inline so the other topics hide before first paint. Without script
      // every topic stays visible.
      (() => {
        const topics = [...document.querySelectorAll(".ds-main > .ds-topic")];
        const links = [...document.querySelectorAll(".ds-nav nav a")];
        const menu = document.querySelector(".ds-nav");
        const wide = matchMedia("(width >= 70rem)");
        // Fragments of the earlier single-page layout.
        const aliases = {
          colors: "color",
          geometry: "layout",
          components: "button",
        };
        const baseTitle = document.title;
        const show = (moved) => {
          let id = location.hash.slice(1);
          try {
            id = decodeURIComponent(id);
          } catch {
            /* A malformed fragment is looked up as written. */
          }
          const target = id ? document.getElementById(aliases[id] ?? id) : null;
          const topic = target?.closest(".ds-topic");
          // A jump to a target outside every topic (the skip link's
          // #main-content) keeps the open topic. On load, or for an unknown
          // fragment, show Overview.
          if (moved && target && !topic) return;
          const shown = topic ?? topics[0];
          for (const section of topics) section.hidden = section !== shown;
          for (const link of links) {
            if (link.hash === `#${shown.id}`)
              link.setAttribute("aria-current", "page");
            else link.removeAttribute("aria-current");
          }
          const heading = shown.querySelector("h1");
          document.title =
            shown === topics[0]
              ? baseTitle
              : `${heading.textContent.trim()} – ${baseTitle}`;
          if (!moved) return;
          if (target && target !== shown) target.scrollIntoView();
          else {
            window.scrollTo(0, 0);
            heading.focus({ preventScroll: true });
          }
        };
        const syncMenu = () => {
          menu.open = wide.matches;
        };
        syncMenu();
        wide.addEventListener("change", syncMenu);
        const closeMenu = () => {
          if (!wide.matches) menu.open = false;
        };
        // A link to the open fragment changes no hash, so clicks close it too.
        document.addEventListener("click", (event) => {
          if (event.target.closest('a[href^="#"]')) closeMenu();
        });
        show(false);
        addEventListener("hashchange", () => {
          closeMenu();
          show(true);
        });
      })();
    </script>

    <div id="copy-status" class="sr-only" aria-live="polite"></div>
    <script>
      import { initTheme } from "../lib/ui/theme";
      import { labelStackTables } from "../lib/ui/stack-tables";
      import { installDismissableDetails } from "../lib/ui/dismissable-details";
      import "../lib/ui/forms";
      initTheme();
      labelStackTables();
      installDismissableDetails();

      // Specimens: open the example dialogs, and show the mixed checkbox state
      // (indeterminate has no HTML attribute).
      for (const button of document.querySelectorAll<HTMLButtonElement>(
        "[data-open-dialog]"
      )) {
        button.addEventListener("click", () =>
          document
            .querySelector<HTMLDialogElement>(`#${button.dataset.openDialog}`)
            ?.showModal()
        );
      }
      for (const box of document.querySelectorAll<HTMLInputElement>(
        "[data-indeterminate]"
      )) {
        box.indeterminate = true;
      }
      document.addEventListener("astro:page-load", initTheme);

      function updateTokenReadout() {
        const rootStyle = getComputedStyle(document.documentElement);
        document
          .querySelectorAll<HTMLElement>("[data-token-value]")
          .forEach((el) => {
            el.textContent =
              rootStyle.getPropertyValue(el.dataset.tokenValue!).trim() ||
              "Not emitted in this build";
          });
        const probe = document.createElement("span");
        probe.hidden = true;
        document.body.appendChild(probe);
        const resolve = (token: string) => {
          probe.style.backgroundColor = `var(${token})`;
          return getComputedStyle(probe).backgroundColor;
        };
        const luminance = (color: string) => {
          const channels = color
            .match(/[\d.]+/g)!
            .slice(0, 3)
            .map(Number)
            .map((n) => {
              const v = n / 255;
              return v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4;
            });
          return (
            channels[0] * 0.2126 + channels[1] * 0.7152 + channels[2] * 0.0722
          );
        };
        const ratio = (a: string, b: string) => {
          const values = [luminance(a), luminance(b)];
          return (
            (Math.max(...values) + 0.05) /
            (Math.min(...values) + 0.05)
          ).toFixed(2);
        };
        const canvas = resolve("--color-canvas");
        const surface = resolve("--color-surface");
        document
          .querySelectorAll<HTMLElement>("[data-color-value]")
          .forEach((el) => {
            const token = el.dataset.colorValue!;
            const value = resolve(token);
            el.textContent = value;
            const swatch = el.closest(".swatch")!;
            swatch.querySelector("[data-contrast-canvas]")!.textContent =
              `C ${ratio(value, canvas)}:1`;
            swatch.querySelector("[data-contrast-surface]")!.textContent =
              `S ${ratio(value, surface)}:1`;
          });
        probe.remove();
      }
      updateTokenReadout();
      new MutationObserver(updateTokenReadout).observe(
        document.documentElement,
        {
          attributes: true,
          attributeFilter: ["data-theme"],
        }
      );
      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", updateTokenReadout);

      document
        .querySelectorAll<HTMLButtonElement>("[data-copy]")
        .forEach((button) => {
          button.addEventListener("click", async () => {
            const status = document.querySelector<HTMLElement>("#copy-status")!;
            try {
              await navigator.clipboard.writeText(button.dataset.copy!);
              status.textContent = "Snippet copied";
            } catch {
              status.textContent =
                "Clipboard unavailable. Copy the example from the page.";
            }
          });
        });
    </script>
    <Tooltips />
  </body>
</html>

