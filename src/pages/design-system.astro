// The --space-1 to --space-16 steps (global.css); the step is the value / 4.
const spacing = [4, 8, 12, 16, 20, 24, 28, 32, 40, 48, 64];
const layoutSpacing = [
  ["--gap-label", "4px", "Label to its control"],
  ["space-y-4, gap-4", "16px", "Between form fields"],
  ["space-y-6", "24px", "Between panels and sections"],
  ["p-6, p-4", "24px, 16px", "Inside a panel; 16px when compact"],
  ["--gutter", "16px to fluid", "Page edge: 16px, 24px from sm, fluid from lg"],
