---
import "../styles/global.css";
import tokenSource from "../styles/global.css?raw";
import AppNavigation from "../components/ui/AppNavigation.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import Icon from "../components/ui/Icon.astro";
import KpiCard from "../components/ui/KpiCard.astro";
import LanguageSwitch from "../components/ui/LanguageSwitch.astro";
import Ornament from "../components/ui/Ornament.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import BrandMark from "../components/ui/BrandMark.astro";
import StatusBadge from "../components/ui/StatusBadge.astro";
import ThemeToggle from "../components/ui/ThemeToggle.astro";
import Tooltips from "../components/ui/Tooltips.astro";
import OrganizationSwitcher from "../components/ui/OrganizationSwitcher.astro";

Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");

// Build-time inventories come from the repository, not a hand-maintained total.
const routes = Object.keys(import.meta.glob("./**/*.astro"))
  .map((path) => path.replace(/^\.\//, "/").replace(/(?:\/index)?\.astro$/, ""))
  .map((path) => path || "/")
  .sort();
const components = Object.keys(import.meta.glob("../components/ui/*.astro"))
  .map((path) => path.split("/").pop()!.replace(".astro", ""))
  .sort();

const colors = [
  ["Canvas", "--color-canvas"],
  ["Surface", "--color-surface"],
  ["Surface hover", "--color-surface-hover"],
  ["Foreground", "--color-foreground"],
  ["Muted", "--color-muted"],
  ["Border", "--color-border"],
  ["Input border", "--color-input-border"],
  ["Primary", "--color-primary"],
  ["Primary hover", "--color-primary-hover"],
  ["Secondary", "--color-secondary"],
  ["Success", "--color-success"],
  ["Warning", "--color-warning"],
  ["Destructive", "--color-destructive"],
  ["Positive secondary", "--color-positive-secondary"],
  ["Info", "--color-info"],
  ["Chart 1", "--chart-1"],
  ["Chart 2", "--chart-2"],
  ["Chart 3", "--chart-3"],
  ["Chart 4", "--chart-4"],
  ["Chart 5", "--chart-5"],
  ["Chart 6", "--chart-6"],
] as const;

const typeScale = [
  ["Caption", "text-caption", "12px", "16px", "500"],
  ["Label", "text-label", "14px", "18px", "600"],
  ["Body small", "text-body-sm", "14px", "20px", "400"],
  ["Body", "text-body", "16px", "24px", "400"],
  ["UI strong", "text-ui-strong", "16px", "22px", "600"],
  ["Heading 3", "text-h3", "20px", "26px", "600"],
  ["Heading 2", "text-h2", "24–32px", "34px", "600"],
] as const;

const spacing = [0, 4, 8, 12, 16, 24, 32, 48, 64, 96];
const radii = [
  ["Badge", "5px"],
  ["Input", "7px"],
  ["Control", "8px"],
  ["Panel", "10px"],
] as const;
const elevations = [
  ["Flat · panels, tables", "--elevation-flat"],
  ["Raised · toolbars, toasts", "--elevation-raised"],
  ["Overlay · menus, tooltips", "--elevation-overlay"],
  ["Modal · dialogs, drawers", "--elevation-modal"],
] as const;
const textTokens = [
  ["xs", "Captions, counters, fine print"],
  ["sm", "Labels, table cells, dense UI"],
  ["base", "Body, buttons, inputs"],
  ["lg", "Subheads, drawer titles"],
  ["xl", "Section titles"],
  ["2xl", "Large section titles"],
  ["display-sm", "Page titles, key figures"],
  ["display-md", "Feature figures"],
  ["display-lg", "Fraunces headlines, amount due"],
] as const;
const tones = ["neutral", "info", "success", "warning", "danger", "positive"];
const breakpoints = [
  ["sm", "40rem", "Tables stop stacking; page gutter grows to 24px"],
  ["md", "48rem", "Two-up layouts; drawers stop being full width"],
  ["lg", "70rem", "Persistent sidebar; fluid gutter; wide tables"],
] as const;

const states = [
  "Default",
  "Hover",
  "Active",
  "Focus-visible",
  "Disabled",
  "Loading",
];
const sourceTokens = [
  ...new Set(
    [...tokenSource.matchAll(/^\s*(--[\w-]+)\s*:/gm)]
      .map((match) => match[1])
      .filter((token) => !token.startsWith("--lightningcss-"))
  ),
].sort();
const palette = sourceTokens.filter((token) => token.startsWith("--palette-"));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F7F4EE" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      try {
        const theme = localStorage.getItem("color-scheme");
        if (theme === "dark" || theme === "light") {
          document.documentElement.dataset.theme = theme;
          document.querySelector('meta[name="color-scheme"]').content = theme;
        }
      } catch {
        /* Storage is optional. */
      }
    </script>
    <title>Namkopa Design System</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <header class="ds-topbar">
      <a class="brand" href="#overview">
        <BrandMark />
        Namkopa
      </a>
      <div class="ds-top-actions">
        <span class="status-badge" data-tone="success">
          Internal artifact
        </span>
        <LanguageSwitch />
        <ThemeToggle />
      </div>
    </header>

    <div class="ds-shell">
      <aside class="ds-sidebar" aria-label="Design system sections">
        <p class="eyebrow">Reference</p>
        <nav>
          <a href="#overview">Overview</a>
          <a href="#colors">Colors</a>
          <a href="#typography">Typography</a>
          <a href="#geometry">Geometry</a>
          <a href="#elevation">Elevation</a>
          <a href="#components">Components</a>
          <a href="#shells">Shell patterns</a>
          <a href="#audit">Audit</a>
        </nav>
        <p class="ds-side-note">
          Inventories are derived from repository source. Specimens use the same
          CSS contract as the product.
        </p>
      </aside>

      <main id="main-content" tabindex="-1" class="ds-main">
        <section id="overview" class="ds-hero">
          <div>
            <p class="eyebrow">Namkopa · Riga</p>
            <h1 class="font-display">The interface, in working order.</h1>
            <p>
              Live repository components, source tokens, route inventory, and
              the state contract used by the administration and resident
              experiences.
            </p>
          </div>
          <dl class="ds-stats">
            <div>
              <dt>Page routes</dt>
              <dd>{routes.length}</dd>
            </div>
            <div>
              <dt>Source tokens</dt>
              <dd>{sourceTokens.length}</dd>
            </div>
            <div>
              <dt>UI components</dt>
              <dd>{components.length}</dd>
            </div>
            <div>
              <dt>External UI deps</dt>
              <dd>0</dd>
            </div>
          </dl>
        </section>

        <section id="colors" class="ds-section">
          <header>
            <p class="eyebrow">Foundation</p>
            <h2>Color ledger</h2>
            <p>
              Values and contrast ratios resolve from the rendered CSS and
              update with the theme. Decorative borders are not text colors.
            </p>
          </header>
          <div class="color-grid">
            {colors.map(([name, variable]) => (
              <article class="swatch">
                <div
                  class="swatch-color"
                  data-swatch={variable}
                  style={`background:var(${variable})`}
                  aria-label={`${name} color swatch`}
                />
                <div class="swatch-copy">
                  <>
                    <h3>{name}</h3>
                    <code>{variable}</code>
                    <p data-color-value={variable}>Resolving current theme…</p>
                  </>
                  <div class="contrast-row">
                    <>
                      <span title="Contrast against canvas">
                        <span data-contrast-canvas={variable}>—</span>
                      </span>
                      <span title="Contrast against surface">
                        <span data-contrast-surface={variable}>—</span>
                      </span>
                    </>
                  </div>
                </div>
              </article>
            ))}
          </div>
          <h3 class="ds-subhead">Tones</h3>
          <p>
            One background and text pair per meaning, shared by badges, notices
            and meter chips. Components reference <code>--tone-*</code>.
          </p>
          <div class="tone-grid">
            {tones.map((tone) => (
              <span
                class="tone-chip"
                style={`background:var(--tone-${tone}-bg);color:var(--tone-${tone}-text)`}
              >
                {tone}
              </span>
            ))}
          </div>
          <h3 class="ds-subhead">Palette</h3>
          <p>
            Tier 1 primitives. Semantic tokens reference these; components never
            do.
          </p>
          <div class="palette-grid">
            {palette.map((variable) => (
              <div class="palette-chip">
                <span
                  style={`background:var(${variable})`}
                  data-palette={variable}
                />
                <code>{variable.replace("--palette-", "")}</code>
              </div>
            ))}
          </div>
        </section>

        <section id="typography" class="ds-section">
          <header>
            <p class="eyebrow">Voice</p>
            <h2>Typography ladder</h2>
            <p>
              Edit any specimen. Switzer handles UI; Fraunces is reserved for
              selected display moments.
            </p>
          </header>
          <div class="type-stack">
            {typeScale.map(([name, className, size, lineHeight, weight]) => (
              <article class="type-row">
                <>
                  <div>
                    <>
                      <strong>{name}</strong>
                      <code>
                        {size} / {lineHeight} · {weight}
                      </code>
                    </>
                  </div>
                  <p
                    class={className}
                    contenteditable="true"
                    spellcheck="true"
                    aria-label={`Editable ${name} specimen`}
                  >
                    Residents can review clear, accurate monthly charges.
                  </p>
                </>
              </article>
            ))}
            <article class="type-row type-display">
              <div>
                <strong>Display</strong>
                <code>40px / 46px · 700</code>
              </div>
              <p
                class="font-display"
                contenteditable="true"
                spellcheck="true"
                aria-label="Editable display specimen"
              >
                September 2026
              </p>
            </article>
          </div>
          <h3 class="ds-subhead">Size tokens</h3>
          <p>
            Use a <code>--text-*</code> step; do not write a font-size literal.
            The display steps are fluid.
          </p>
          <div class="type-stack">
            {textTokens.map(([step, use]) => (
              <article class="type-row" data-text-token={step}>
                <div>
                  <strong>{step}</strong>
                  <code>--text-{step}</code>
                </div>
                <p style={`font-size:var(--text-${step})`}>{use}</p>
              </article>
            ))}
          </div>
        </section>

        <section id="geometry" class="ds-section">
          <header>
            <p class="eyebrow">Rhythm</p>
            <h2>Metrics & geometry</h2>
            <p>
              The system uses an 8px base rhythm, with 4px and 12px intermediate
              steps for compact UI.
            </p>
          </header>
          <div class="geometry-grid">
            <article class="ds-panel">
              <h3>Breakpoints</h3>
              <dl class="bp-list">
                {breakpoints.map(([name, width, use]) => (
                  <div>
                    <dt>
                      <code>
                        {name} · {width}
                      </code>
                    </dt>
                    <dd>{use}</dd>
                  </div>
                ))}
              </dl>
            </article>
            <article class="ds-panel">
              <h3>Layout spacing</h3>
              <dl class="bp-list">
                <div>
                  <dt>
                    <code>--gap-label</code>
                  </dt>
                  <dd>Label to its control · 4px</dd>
                </div>
                <div>
                  <dt>
                    <code>--gap-field</code>
                  </dt>
                  <dd>Between form fields · 16px</dd>
                </div>
                <div>
                  <dt>
                    <code>--gap-section</code>
                  </dt>
                  <dd>Between panels and sections · 24px</dd>
                </div>
                <div>
                  <dt>
                    <code>--pad-panel</code>
                  </dt>
                  <dd>Inside a panel · 24px (compact 16px)</dd>
                </div>
                <div>
                  <dt>
                    <code>--gutter</code>
                  </dt>
                  <dd>Page edge · 16px, 24px from sm, fluid from lg</dd>
                </div>
              </dl>
            </article>
            <article class="ds-panel">
              <h3>Page widths</h3>
              <dl class="bp-list">
                <div>
                  <dt><code>--width-narrow · 28rem</code></dt>
                  <dd>Auth card, single-purpose forms</dd>
                </div>
                <div>
                  <dt><code>--width-reading · 50rem</code></dt>
                  <dd>Resident column, prose pages</dd>
                </div>
                <div>
                  <dt><code>--width-wizard · 76rem</code></dt>
                  <dd>Guided setup</dd>
                </div>
                <div>
                  <dt><code>--width-content · 94rem</code></dt>
                  <dd>Dashboard and standard admin pages</dd>
                </div>
                <div>
                  <dt><code>--width-shell · 110rem</code></dt>
                  <dd>Outer cap of the admin content area</dd>
                </div>
              </dl>
            </article>
            <article class="ds-panel">
              <h3>Spacing</h3>
              <div class="space-scale">
                {spacing.map((value) => (
                  <div>
                    <>
                      <span
                        style={`width:${Math.max(value, 1)}px;height:${Math.max(value, 1)}px`}
                      />
                      <code>{value}px</code>
                    </>
                  </div>
                ))}
              </div>
            </article>
            <article class="ds-panel">
              <h3>Radius</h3>
              <div class="radius-scale">
                {radii.map(([name, value]) => (
                  <div>
                    <>
                      <span style={`border-radius:${value}`} />
                      <code>
                        {name} · {value}
                      </code>
                    </>
                  </div>
                ))}
              </div>
            </article>
          </div>
        </section>

        <section id="elevation" class="ds-section">
          <header>
            <p class="eyebrow">Depth</p>
            <h2>Elevation</h2>
            <p>
              Ordinary panels remain flat. Shadow appears only when hierarchy or
              overlap requires it. In dark mode shadows give way to a hairline
              border on a lighter surface.
            </p>
          </header>
          <div class="elevation-grid">
            {elevations.map(([name, variable]) => (
              <article style={`box-shadow:var(${variable})`}>
                <>
                  <strong>{name}</strong>
                  <code>{variable}</code>
                </>
              </article>
            ))}
          </div>
        </section>

        <section id="components" class="ds-section">
          <header>
            <p class="eyebrow">Living inventory</p>
            <h2>Component matrix</h2>
            <p>
              Specimens use repository classes and imported Astro components.
              Hover and focus columns are also checked with real browser input.
            </p>
          </header>

          <article class="component-block" data-component="buttons">
            <div class="component-heading">
              <div>
                <h3>Button</h3>
                <p>Primary, secondary, and destructive actions.</p>
              </div>
              <button
                class="copy-button"
                type="button"
                data-copy={`<button class="btn-primary">Save changes</button>`}
              >
                Copy snippet
              </button>
            </div>
            <div class="state-grid">
              {states.map((state) => (
                <div class="state-cell">
                  <>
                    <span>{state}</span>
                    <button
                      type="button"
                      class="btn-primary"
                      data-preview-state={state.toLowerCase()}
                      disabled={state === "Disabled"}
                      aria-busy={state === "Loading"}
                    >
                      {state === "Loading" ? "Saving…" : "Save changes"}
                    </button>
                  </>
                </div>
              ))}
            </div>
            <div
              class="component-row button-variants"
              aria-label="Button variants and sizes"
            >
              <button type="button" class="btn-secondary">
                Cancel changes
              </button>
              <button type="button" class="btn-danger">
                Remove resident
              </button>
              <button type="button" class="btn-ghost">
                View details
              </button>
              <button type="button" class="btn-secondary btn-sm">
                Compact action
              </button>
              <button type="button" class="btn-primary btn-lg">
                Create billing period
              </button>
              <button
                type="button"
                class="icon-btn icon-btn-danger"
                aria-label="Remove example"
              >
                <Icon name="trash" size="sm" />
              </button>
              <button
                type="button"
                class="icon-btn icon-btn-sm"
                aria-label="Compact icon action"
              >
                <Icon name="plus" size="sm" />
              </button>
              <button
                type="button"
                class="icon-btn"
                aria-label="Unavailable action"
                disabled
              >
                <Icon name="plus" size="sm" />
              </button>
            </div>
          </article>

          <article class="component-block" data-component="inputs">
            <div class="component-heading">
              <div>
                <h3>Input</h3>
                <p>Labeled controls, select, checkbox, and error treatment.</p>
              </div>
              <button
                class="copy-button"
                type="button"
                data-copy={`<label class="field-label" for="email">Billing email</label>\n<input id="email" name="email" type="email" autocomplete="email" aria-describedby="email-hint" class="mt-1" />\n<p id="email-hint" class="field-hint">Invoices are sent here.</p>`}
              >
                Copy snippet
              </button>
            </div>
            <div class="form-grid">
              <div>
                <label class="field-label" for="specimen-email">
                  Billing email
                </label>
                <input
                  id="specimen-email"
                  name="specimen-email"
                  type="email"
                  autocomplete="email"
                  placeholder="name@example.com"
                  aria-describedby="specimen-email-hint"
                  class="mt-1"
                />
                <p id="specimen-email-hint" class="field-hint">
                  Invoices are sent here.
                </p>
              </div>
              <div>
                <label class="field-label" for="specimen-cycle">
                  Billing cycle
                </label>
                <select id="specimen-cycle" name="cycle" class="mt-1">
                  <option>Monthly</option>
                  <option>Quarterly</option>
                </select>
              </div>
              <label class="check-row">
                <input type="checkbox" name="reminders" checked /> Send
                reminders
              </label>
              <div>
                <label class="field-label" for="specimen-reference">
                  Invoice reference
                </label>
                <input
                  id="specimen-reference"
                  class="mt-1"
                  name="reference"
                  aria-invalid="true"
                  aria-describedby="specimen-reference-error"
                  value="PB-"
                />
                <p id="specimen-reference-error" class="field-error">
                  Use a complete invoice reference.
                </p>
              </div>
            </div>
          </article>

          <article class="component-block" data-component="status-badges">
            <div class="component-heading">
              <div>
                <h3>StatusBadge</h3>
                <p>Actual repository status mapping and icon renderer.</p>
              </div>
              <button
                class="copy-button"
                type="button"
                data-copy={`<StatusBadge status="PAID" />`}
              >
                Copy snippet
              </button>
            </div>
            <div class="component-row">
              <StatusBadge status="MISSING_DATA" />
              <StatusBadge status="DRAFT" />
              <StatusBadge status="SENT" />
              <StatusBadge status="PAID" />
              <StatusBadge status="OVERDUE" />
            </div>
          </article>

          <div class="component-pair">
            <article class="component-block">
              <div class="component-heading">
                <h3>KpiCard</h3>
                <code>&lt;KpiCard label="Collected" value="€48,920" /&gt;</code>
              </div>
              <div class="kpi-grid">
                <KpiCard
                  label="Collected"
                  value="€48,920"
                  tone="success"
                  icon="coins"
                />
                <KpiCard
                  label="Due soon"
                  value="14"
                  tone="warning"
                  icon="clock"
                />
              </div>
            </article>
            <article class="component-block">
              <div class="component-heading">
                <h3>Notices</h3>
                <code>class="notice notice-warning"</code>
              </div>
              <div class="notice-stack">
                <p class="notice">Invoices are ready for review.</p>
                <p class="notice notice-warning">
                  3 readings still need attention.
                </p>
                <p class="notice notice-danger">
                  Payment import failed. Check the CSV columns.
                </p>
              </div>
            </article>
          </div>

          <article class="component-block">
            <div class="component-heading">
              <div>
                <h3>PageHeader, EmptyState & Icon</h3>
                <p>Composed from the actual repository components.</p>
              </div>
              <code>src/components/ui</code>
            </div>
            <div class="embedded-panel">
              <PageHeader
                headingLevel="h3"
                accent
                title="Billing periods"
                description="Prepare, issue, and reconcile monthly invoices."
                eyebrow="September 2026"
              >
                <button class="btn-primary">
                  <Icon name="plus" size="sm" />
                  New period
                </button>
              </PageHeader>
              <EmptyState
                title="No billing periods yet"
                description="Create the first period to start collecting readings."
                ornament
              >
                <button class="btn-secondary">Create period</button>
              </EmptyState>
            </div>
          </article>

          <article class="component-block">
            <div class="component-heading">
              <div>
                <h3>Disclosure</h3>
                <p>Native details/summary behavior.</p>
              </div>
              <code>&lt;details class="disclosure"&gt;</code>
            </div>
            <details class="disclosure">
              <summary>Why is this invoice blocked?</summary>
              <p class="text-body-sm text-muted">
                The billing email is missing. Add it to the dwelling record,
                then prepare the invoice again.
              </p>
            </details>
          </article>
          <article class="component-block">
            <div class="component-heading">
              <div>
                <h3>OrganizationSwitcher</h3>
                <p>
                  In-flow disclosure remains usable inside a narrow scrolling
                  sidebar.
                </p>
              </div>
            </div>
            <div class="organization-specimen">
              <OrganizationSwitcher
                organizationId="example-1"
                organizationName="Brīvības ielas namu biedrība"
                organizations={[
                  {
                    id: "example-1",
                    name: "Brīvības ielas namu biedrība",
                    archivedAt: null,
                  },
                  {
                    id: "example-2",
                    name: "Товарищество собственников жилого дома",
                    archivedAt: null,
                  },
                ]}
                residentAccess={true}
              />
            </div>
          </article>
        </section>

        <section id="shells" class="ds-section">
          <header>
            <p class="eyebrow">Structure</p>
            <h2>Shell patterns</h2>
            <p>
              Scaled maps of the 2 recurring authenticated layouts and the
              authentication card.
            </p>
          </header>
          <div class="shell-grid">
            <article>
              <h3>Admin workspace</h3>
              <div class="wireframe admin-wire" inert aria-hidden="true">
                <aside>
                  <span></span>
                  <AppNavigation organizationId="specimen" />
                </aside>
                <div class="wire-content">
                  <i></i>
                  <i></i>
                  <i></i>
                  <b></b>
                </div>
              </div>
            </article>
            <article>
              <h3>Resident portal</h3>
              <div class="wireframe resident-wire" inert aria-hidden="true">
                <header>
                  <span></span>
                  <span></span>
                </header>
                <nav></nav>
                <div class="wire-content">
                  <i></i>
                  <b></b>
                  <b></b>
                </div>
              </div>
            </article>
            <article>
              <h3>Authentication</h3>
              <div class="wireframe auth-wire" inert aria-hidden="true">
                <div>
                  <Ornament />
                  <i></i>
                  <i></i>
                  <b></b>
                </div>
              </div>
            </article>
          </div>
