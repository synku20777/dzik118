            <article>
              <strong>Source token inventory</strong>
              <span>{sourceTokens.length} declared</span>
              <p>
                Names are extracted from global.css at build time. A declaration
                count is an inventory, not an accessibility certification.
              </p>
            </article>
            <article>
              <strong>Component inventory</strong>
              <span>{components.length} files</span>
              <p>
                The source inventory includes data-bound components. Only the
                specimens above are rendered; live workflows need separate
                tests.
              </p>
            </article>
            <article>
              <strong>Layout fidelity</strong>
              <span>See automated checks</span>
              <p>
                Desktop, tablet, and 320px overflow plus sticky navigation are
                checked by Playwright.
              </p>
            </article>
            <article>
              <strong>Leakage prevention</strong>
              <span>Tag + header</span>
              <p>
                <code>robots=noindex,nofollow</code> and{" "}
                <code>X-Robots-Tag</code> are both emitted.
              </p>
            </article>
          </div>
          <details class="disclosure">
            <summary>Route inventory ({routes.length})</summary>
            <ul class="route-list">
              {routes.map((route) => (
                <li>
                  <code>{route}</code>
                </li>
              ))}
            </ul>
          </details>
          <details class="disclosure">
            <summary>Source token registry ({sourceTokens.length})</summary>
            <ul class="token-list">
              {sourceTokens.map((token) => (
                <li>
                  <>
                    <code>{token}</code>
                    <span data-token-value={token} />
                  </>
                </li>
              ))}
            </ul>
          </details>
          <details class="disclosure">
            <summary>Component source inventory ({components.length})</summary>
            <ul class="route-list">
              {components.map((name) => (
                <li>
                  <code>{name}.astro</code>
                </li>
              ))}
            </ul>
          </details>
          <div class="drift-panel">
            <h3>Drift status</h3>
            <ul>
              <li>
                <strong>Resolved:</strong> meter categories now use shared,
                muted Riga tokens.
              </li>
              <li>
                <strong>Resolved:</strong> page templates use semantic palette
                utilities directly.
              </li>
              <li>
                <strong>Contract:</strong> shared controls use semantic color,
                geometry, feedback, and sizing tokens. Page-specific styles
                still require review.
              </li>
              <li>
                <strong>Expected:</strong> printable invoice/email HTML uses
                self-contained colors because global CSS is unavailable.
              </li>
            </ul>
          </div>
        </section>
      </main>
    </div>

    <div id="copy-status" class="sr-only" aria-live="polite"></div>
    <script>
      import { initTheme } from "../lib/ui/theme";
      initTheme();
      document.addEventListener("astro:page-load", initTheme);

      function updateTokenReadout() {
        const rootStyle = getComputedStyle(document.documentElement);
        document
          .querySelectorAll<HTMLElement>("[data-token-value]")
          .forEach((el) => {
            el.textContent =
              rootStyle.getPropertyValue(el.dataset.tokenValue!).trim() ||
              "Not emitted in this build";
          });
        const probe = document.createElement("span");
        probe.hidden = true;
        document.body.appendChild(probe);
        const resolve = (token: string) => {
          probe.style.backgroundColor = `var(${token})`;
          return getComputedStyle(probe).backgroundColor;
        };
        const luminance = (color: string) => {
          const channels = color
            .match(/[\d.]+/g)!
            .slice(0, 3)
            .map(Number)
            .map((n) => {
              const v = n / 255;
              return v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4;
            });
          return (
            channels[0] * 0.2126 + channels[1] * 0.7152 + channels[2] * 0.0722
          );
        };
        const ratio = (a: string, b: string) => {
          const values = [luminance(a), luminance(b)];
          return (
            (Math.max(...values) + 0.05) /
            (Math.min(...values) + 0.05)
          ).toFixed(2);
        };
        const canvas = resolve("--color-canvas");
        const surface = resolve("--color-surface");
        document
          .querySelectorAll<HTMLElement>("[data-color-value]")
          .forEach((el) => {
            const token = el.dataset.colorValue!;
            const value = resolve(token);
            el.textContent = value;
            const swatch = el.closest(".swatch")!;
            swatch.querySelector("[data-contrast-canvas]")!.textContent =
              `C ${ratio(value, canvas)}:1`;
            swatch.querySelector("[data-contrast-surface]")!.textContent =
              `S ${ratio(value, surface)}:1`;
          });
        probe.remove();
      }
      updateTokenReadout();
      new MutationObserver(updateTokenReadout).observe(
        document.documentElement,
        {
          attributes: true,
          attributeFilter: ["data-theme"],
        }
      );
      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", updateTokenReadout);

      document
        .querySelectorAll<HTMLButtonElement>("[data-copy]")
        .forEach((button) => {
          button.addEventListener("click", async () => {
            const status = document.querySelector<HTMLElement>("#copy-status")!;
            try {
              await navigator.clipboard.writeText(button.dataset.copy!);
              status.textContent = "Snippet copied";
            } catch {
              status.textContent =
                "Clipboard unavailable. Copy the example from the page.";
            }
          });
        });
    </script>
