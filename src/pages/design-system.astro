const sourceTokens = [
  ...new Set(
    [...tokenSource.matchAll(/^\s*(--[\w-]+)\s*:/gm)]
      .map((match) => match[1])
      .filter((token) => !token.startsWith("--lightningcss-"))
  ),
].sort();
const palette = sourceTokens.filter((token) => token.startsWith("--palette-"));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <!-- --color-canvas per theme; theme.ts keeps these in step with a stored theme. -->
    <meta
      name="theme-color"
      content="#f7f4ee"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0e1517"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      try {
        const theme = localStorage.getItem("color-scheme");
        if (theme === "dark" || theme === "light") {
          document.documentElement.dataset.theme = theme;
          document.querySelector('meta[name="color-scheme"]').content = theme;
          document.querySelectorAll('meta[name="theme-color"]').forEach((m) => {
            m.content = theme === "dark" ? "#0e1517" : "#f7f4ee";
          });
        }
      } catch {
        /* Storage is optional. */
      }
    </script>
    <title>Namkopa Design System</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <header class="ds-topbar">
      <a class="brand" href="#overview">
        <BrandMark />
        Namkopa
      </a>
      <div class="ds-top-actions">
        <span class="status-badge" data-tone="success">
          <Icon name="lock" size="xs" />
          Internal artifact
        </span>
        <LanguageSwitch />
        <ThemeToggle />
      </div>
    </header>

    <div class="ds-shell">
      <aside class="ds-sidebar">
        <!-- Always open from 70rem (the summary is hidden there); a menu below. -->
        <details class="ds-nav" open>
          <summary class="btn-secondary">
            <Icon name="menu" size="sm" />
            Contents
          </summary>
          <nav aria-label="Design system sections">
            <a href="#overview">Overview</a>
            {nav.map(([group, items]) => (
              <>
                <p class="ds-nav-group" id={`nav-${group.toLowerCase()}`}>
                  {group}
                </p>
                <ul aria-labelledby={`nav-${group.toLowerCase()}`}>
                  {items.map(([id, label]) => (
                    <li>
                      <a href={`#${id}`}>{label}</a>
                    </li>
                  ))}
                </ul>
              </>
            ))}
          </nav>
        </details>
      </aside>

      <main id="main-content" tabindex="-1" class="ds-main">
        <section id="overview" class="ds-topic ds-overview">
          <h1 class="font-display" tabindex="-1">
            Namkopa design system
          </h1>
          <p class="ds-lead">
            Tokens, components and patterns for the administration and resident
            apps. Every specimen here uses the same CSS as the product.
          </p>
          <div class="ds-entry">
            <a href="#color">
              <strong>Foundation</strong>
              <span>
                Color, type, icons, layout, radius, elevation and motion.
              </span>
            </a>
            <a href="#button">
              <strong>Components</strong>
              <span>Building blocks, from Button to Table.</span>
            </a>
          </div>
          <p class="ds-source">
            Tokens and classes live in <code>src/styles/global.css</code>,
            components in <code>src/components/ui</code>, and the rules in{" "}
            <code>docs/product/DESIGN_SYSTEM.md</code>.
          </p>
        </section>

        <!-- Foundation -->
        <section id="color" class="ds-topic">
          <h1 tabindex="-1">Color</h1>
          <p class="ds-lead">
            Semantic colors resolve from the rendered CSS and follow the theme.
            C and S give the contrast against the canvas and the surface.
          </p>
          <h2>Semantic colors</h2>
          <div class="color-grid">
            {colors.map(([name, variable]) => (
              <article class="swatch">
                <div
                  class="swatch-color"
                  data-swatch={variable}
                  style={`background:var(${variable})`}
                />
                <div class="swatch-copy">
                  <>
                    <h3>{name}</h3>
                    <code>{variable}</code>
                    <p data-color-value={variable}>Resolving current theme…</p>
                  </>
                  <div class="contrast-row">
                    <>
                      <span title="Contrast against canvas">
                        <span data-contrast-canvas={variable}>—</span>
                      </span>
                      <span title="Contrast against surface">
                        <span data-contrast-surface={variable}>—</span>
                      </span>
                    </>
                  </div>
                </div>
              </article>
            ))}
          </div>
          <h2>Tones</h2>
          <p>
            One background and text pair per meaning, shared by badges, notices
            and meter chips.
          </p>
          <div class="table-wrap">
            <table class="ds-spec">
              <caption class="sr-only">Tones</caption>
              <thead>
                <tr>
                  <th scope="col">Example</th>
                  <th scope="col">Code</th>
                  <th scope="col">Use</th>
                </tr>
              </thead>
              <tbody>
                {tones.map(([tone, use]) => (
                  <tr>
                    <td>
                      <span
                        class="tone-chip"
                        style={`background:var(--tone-${tone}-bg);color:var(--tone-${tone}-text)`}
                      >
                        {tone}
                      </span>
                    </td>
                    <td>
                      <code>--tone-{tone}-bg, -text</code>
                    </td>
                    <td>{use}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <h2>Palette</h2>
          <p>
            Primitives. Semantic tokens reference these; components never do.
          </p>
          <div class="palette-grid">
            {palette.map((variable) => (
              <div class="palette-chip">
                <span
                  style={`background:var(${variable})`}
                  data-palette={variable}
                />
                <code>{variable.replace("--palette-", "")}</code>
              </div>
            ))}
          </div>
        </section>

        <section id="typography" class="ds-topic">
          <h1 tabindex="-1">Typography</h1>
          <p class="ds-lead">
            Switzer sets the interface. Fraunces is kept for a few display
            moments. Edit any specimen to try real copy.
          </p>
          <h2>Roles</h2>
          <div class="type-stack">
            {typeScale.map(([name, className, size, lineHeight, weight]) => (
              <article class="type-row">
                <>
                  <div>
                    <>
                      <strong>{name}</strong>
                      <code>
                        {size} / {lineHeight}, {weight}
                      </code>
                    </>
                  </div>
                  <p
                    class={className}
                    contenteditable="true"
                    spellcheck="true"
                    aria-label={`Editable ${name} specimen`}
                  >
                    Residents can review clear, accurate monthly charges.
                  </p>
                </>
              </article>
            ))}
            <article class="type-row">
              <div>
                <strong>Display</strong>
                <code>--text-display-lg, 600</code>
              </div>
              <p
                class="font-display ds-display-specimen"
                contenteditable="true"
                spellcheck="true"
                aria-label="Editable display specimen"
              >
                September 2026
              </p>
            </article>
          </div>
          <h2>Size tokens</h2>
          <p>
            Use a <code>--text-*</code> step, never a font-size literal. The
            display steps are fluid.
          </p>
          <div class="type-stack">
            {textTokens.map(([step, use]) => (
              <article class="type-row" data-text-token={step}>
                <div>
                  <strong>{step}</strong>
                  <code>--text-{step}</code>
                </div>
                <p style={`font-size:var(--text-${step})`}>{use}</p>
              </article>
            ))}
          </div>
        </section>

        <section id="iconography" class="ds-topic">
          <h1 tabindex="-1">Iconography</h1>
          <p class="ds-lead">
            Tabler outline icons drawn by <code>Icon</code>, at four sizes with
            one stroke width. An icon supports a label; it never replaces one.
          </p>
          <h2>Sizes</h2>
          <div class="table-wrap">
            <table class="ds-spec ds-spec-4">
              <caption class="sr-only">Icon sizes</caption>
              <thead>
                <tr>
                  <th scope="col">Example</th>
                  <th scope="col">Code</th>
                  <th scope="col">Value</th>
                  <th scope="col">Use</th>
                </tr>
              </thead>
              <tbody>
                {iconSizes.map(([size, value, use]) => (
                  <tr>
                    <td>
                      <Icon name="receipt-euro" size={size} />
                    </td>
                    <td>
                      <code>size="{size}"</code>
                    </td>
                    <td>{value}</td>
                    <td>{use}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <h2>Set</h2>
          <p>
            Every icon in <code>src/lib/ui/icons.ts</code>. Stroke is{" "}
            <code>--icon-stroke</code>.
          </p>
          <ul class="icon-grid">
            {iconNames.map((name) => (
              <li>
                <Icon name={name} size="lg" />
                <code>{name}</code>
              </li>
            ))}
          </ul>
          <pre class="ds-code"><code>{`<Icon name="receipt-euro" size="sm" />`}</code></pre>
        </section>

        <section id="layout" class="ds-topic">
          <h1 tabindex="-1">Layout</h1>
          <p class="ds-lead">
            An 8px rhythm with 4px and 12px steps for dense UI, five page widths
            and three breakpoints.
          </p>
          <h2>Spacing</h2>
          <div class="table-wrap">
            <table class="ds-spec">
              <caption class="sr-only">Spacing steps</caption>
              <thead>
                <tr>
                  <th scope="col">Example</th>
                  <th scope="col">Code</th>
                  <th scope="col">Value</th>
                </tr>
              </thead>
              <tbody>
                {spacing.map((value) => (
                  <tr>
                    <td>
                      <span
                        class="space-sample"
                        style={`width:var(--space-${value / 4})`}
                      />
                    </td>
                    <td>
                      <code>--space-{value / 4}</code>
                    </td>
                    <td>{value}px</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <h2>Layout spacing</h2>
          <div class="table-wrap">
            <table class="ds-spec ds-spec-tokens">
              <caption class="sr-only">Layout spacing</caption>
              <thead>
                <tr>
                  <th scope="col">Code</th>
                  <th scope="col">Value</th>
                  <th scope="col">Use</th>
                </tr>
              </thead>
              <tbody>
                {layoutSpacing.map(([code, value, use]) => (
                  <tr>
                    <td>
                      <code>{code}</code>
                    </td>
                    <td>{value}</td>
                    <td>{use}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <h2>Page widths</h2>
          <div class="table-wrap">
            <table class="ds-spec ds-spec-tokens">
              <caption class="sr-only">Page widths</caption>
              <thead>
                <tr>
                  <th scope="col">Code</th>
                  <th scope="col">Value</th>
                  <th scope="col">Use</th>
                </tr>
              </thead>
              <tbody>
                {widths.map(([code, value, use]) => (
                  <tr>
                    <td>
                      <code>{code}</code>
                    </td>
                    <td>{value}</td>
                    <td>{use}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <h2>Breakpoints</h2>
          <div class="table-wrap">
            <table class="ds-spec ds-spec-tokens">
              <caption class="sr-only">Breakpoints</caption>
              <thead>
                <tr>
                  <th scope="col">Code</th>
                  <th scope="col">Width</th>
                  <th scope="col">What changes</th>
                </tr>
              </thead>
              <tbody>
                {breakpoints.map(([code, value, use]) => (
                  <tr>
                    <td>
                      <code>{code}</code>
                    </td>
                    <td>{value}</td>
                    <td>{use}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <h2 id="shells">Shells</h2>
          <p>Scaled maps of the two signed-in layouts and the sign-in card.</p>
          <div class="shell-grid">
            <article>
              <h3>Admin workspace</h3>
              <div class="wireframe admin-wire" inert aria-hidden="true">
                <aside>
                  <span></span>
                  <AppNavigation organizationId="specimen" />
                </aside>
                <div class="wire-content">
                  <i></i>
                  <i></i>
                  <i></i>
                  <b></b>
                </div>
              </div>
            </article>
            <article>
              <h3>Resident portal</h3>
              <div class="wireframe resident-wire" inert aria-hidden="true">
                <header>
                  <span></span>
                  <span></span>
                </header>
                <nav></nav>
                <div class="wire-content">
                  <i></i>
                  <b></b>
                  <b></b>
                </div>
              </div>
            </article>
            <article>
              <h3>Authentication</h3>
              <div class="wireframe auth-wire" inert aria-hidden="true">
                <div>
                  <Ornament />
                  <i></i>
                  <i></i>
                  <b></b>
                </div>
              </div>
            </article>
          </div>
          <h2 id="dividers">Divider and spacer</h2>
          <p>
            A break between groups of content. The spacer keeps the gap without
            a line; the soft divider fades out at both ends.
          </p>
          <div class="ds-specimen divider-specimen">
            <code>divider</code>
            <hr class="divider" />
            <code>divider-soft</code>
            <hr class="divider-soft" />
            <code>spacer</code>
            <hr class="spacer" />
          </div>
        </section>

        <section id="radius" class="ds-topic">
          <h1 tabindex="-1">Radius</h1>
          <p class="ds-lead">
            Corners follow the size of the element. Panels use squircle corners;
            everything else is round.
          </p>
          <div class="table-wrap">
            <table class="ds-spec ds-spec-4">
              <caption class="sr-only">Radius tokens</caption>
              <thead>
                <tr>
                  <th scope="col">Example</th>
                  <th scope="col">Code</th>
                  <th scope="col">Value</th>
                  <th scope="col">Use</th>
                </tr>
              </thead>
              <tbody>
                {radii.map(([token, value, use]) => (
                  <tr>
                    <td>
                      <span
                        class="radius-sample"
                        data-squircle={token === "--radius-panel" || undefined}
                        style={`border-radius:var(${token})`}
                      />
                    </td>
                    <td>
                      <code>{token}</code>
                    </td>
                    <td>{value}</td>
                    <td>{use}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section id="elevation" class="ds-topic">
          <h1 tabindex="-1">Elevation</h1>
          <p class="ds-lead">
            Panels stay flat. Shadow appears only when something overlaps the
            page. In dark mode a hairline border on a lighter surface replaces
            it.
          </p>
          <div class="table-wrap">
            <table class="ds-spec">
              <caption class="sr-only">Elevation tokens</caption>
              <thead>
                <tr>
                  <th scope="col">Example</th>
                  <th scope="col">Code</th>
                  <th scope="col">Use</th>
                </tr>
              </thead>
              <tbody>
                {elevations.map(([token, use]) => (
                  <tr>
                    <td>
                      <span
                        class="elevation-sample"
                        data-raised={token !== "--elevation-flat" || undefined}
                        style={`box-shadow:var(${token})`}
                      />
                    </td>
                    <td>
                      <code>{token}</code>
                    </td>
                    <td>{use}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section id="motion" class="ds-topic">
          <h1 tabindex="-1">Motion & stacking</h1>
          <p class="ds-lead">
            Short transitions on one easing curve, and a named scale for
            layering. Never write a bare duration or z-index.
          </p>
          <h2>Motion</h2>
          <div class="table-wrap">
            <table class="ds-spec ds-spec-tokens">
              <caption class="sr-only">Motion tokens</caption>
              <thead>
                <tr>
                  <th scope="col">Code</th>
                  <th scope="col">Value</th>
                  <th scope="col">Use</th>
                </tr>
              </thead>
              <tbody>
                {motionTokens.map(([code, value, use]) => (
                  <tr>
                    <td>
                      <code>{code}</code>
                    </td>
                    <td>{value}</td>
                    <td>{use}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <h2>Stacking</h2>
          <div class="table-wrap">
            <table class="ds-spec ds-spec-tokens">
              <caption class="sr-only">Stacking tokens</caption>
              <thead>
                <tr>
                  <th scope="col">Code</th>
                  <th scope="col">Value</th>
                  <th scope="col">Use</th>
                </tr>
              </thead>
              <tbody>
                {stackingTokens.map(([code, value, use]) => (
                  <tr>
                    <td>
                      <code>{code}</code>
                    </td>
                    <td>{value}</td>
                    <td>{use}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <!-- Components, alphabetical -->
        <section id="avatar" class="ds-topic" data-component="avatar">
          <h1 tabindex="-1">Avatar</h1>
          <p class="ds-lead">
            The initials of who is signed in, in a hairline circle. It always
            sits beside the person's name or email, so screen readers skip it.
          </p>
          <div class="table-wrap">
            <table class="ds-spec">
              <caption class="sr-only">Avatar sizes</caption>
              <thead>
                <tr>
                  <th scope="col">Example</th>
                  <th scope="col">Code</th>
                  <th scope="col">Use</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>
                    <span class="avatar avatar-sm" aria-hidden="true">
                      AB
                    </span>
                  </td>
                  <td>
                    <code>avatar avatar-sm</code>
                  </td>
                  <td>24px. Dense lists and table rows</td>
                </tr>
                <tr>
                  <td>
                    <span class="avatar" aria-hidden="true">
                      AB
                    </span>
                  </td>
                  <td>
                    <code>avatar</code>
                  </td>
                  <td>28px. The signed-in account in the sidebar</td>
                </tr>
                <tr>
                  <td>
                    <span class="avatar avatar-lg" aria-hidden="true">
                      AB
                    </span>
                  </td>
                  <td>
                    <code>avatar avatar-lg</code>
                  </td>
                  <td>36px. Account pages and larger cards</td>
                </tr>
              </tbody>
            </table>
          </div>
          <h2>With a name</h2>
          <div class="ds-specimen">
            <p class="ds-inline">
              <span class="avatar" aria-hidden="true">
                AB
              </span>
              <span>anna.berzina@example.lv</span>
            </p>
          </div>
          <pre class="ds-code"><code>{`<span class="avatar" aria-hidden="true">AB</span>\n<span>anna.berzina@example.lv</span>`}</code></pre>
        </section>

        <section id="box" class="ds-topic" data-component="box">
          <h1 tabindex="-1">Box</h1>
          <p class="ds-lead">
            A padded group of content about one subject. The default sits flat
            with a hairline; the others step back or forward on the elevation
            scale. Depth does not change on hover.
          </p>
          <div class="table-wrap">
            <table class="ds-spec">
              <caption class="sr-only">Box depths</caption>
              <thead>
                <tr>
                  <th scope="col">Example</th>
                  <th scope="col">Code</th>
                  <th scope="col">Use</th>
                </tr>
              </thead>
              <tbody>
                {boxes.map(([className, use]) => (
                  <tr>
                    <td>
                      <div class={className}>Water meters</div>
                    </td>
                    <td>
                      <code>{className}</code>
                    </td>
                    <td>{use}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <pre class="ds-code"><code>{`<div class="box box-raised">…</div>`}</code></pre>
        </section>

        <section id="button" class="ds-topic" data-component="button">
          <div class="ds-topic-head">
            <h1 tabindex="-1">Button</h1>
            <button
              class="copy-button"
              type="button"
              data-copy={`<button class="btn-primary">Save changes</button>`}
            >
              Copy snippet
            </button>
          </div>
          <p class="ds-lead">
            Primary for the main action of a view, secondary for the rest, and
            danger for actions that remove something.
          </p>
          <h2>Variants</h2>
          <div class="table-wrap">
            <table class="ds-spec button-variants">
              <caption class="sr-only">Button variants</caption>
              <thead>
                <tr>
                  <th scope="col">Example</th>
                  <th scope="col">Code</th>
                  <th scope="col">Use</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>
                    <button type="button" class="btn-primary">
                      Save changes
                    </button>
                  </td>
                  <td>
                    <code>btn-primary</code>
                  </td>
                  <td>The main action of a view</td>
                </tr>
                <tr>
                  <td>
                    <button type="button" class="btn-secondary">
                      Cancel changes
                    </button>
                  </td>
                  <td>
                    <code>btn-secondary</code>
                  </td>
                  <td>Every other action</td>
                </tr>
                <tr>
                  <td>
                    <button type="button" class="btn-danger">
                      Remove resident
                    </button>
                  </td>
                  <td>
                    <code>btn-danger</code>
                  </td>
                  <td>Removes or revokes something</td>
                </tr>
                <tr>
                  <td>
                    <button type="button" class="btn-ghost">
                      Skip for now
                    </button>
                  </td>
                  <td>
                    <code>btn-ghost</code>
                  </td>
                  <td>The quiet way out of a dialog or an optional step</td>
                </tr>
                <tr>
                  <td>
                    <button type="button" class="btn-secondary btn-sm">
                      Compact action
                    </button>
                  </td>
                  <td>
                    <code>btn-sm</code>
                  </td>
                  <td>Dense rows and toolbars; 44px on touch screens</td>
                </tr>
                <tr>
                  <td>
                    <span class="ds-inline">
                      <button
                        type="button"
                        class="icon-btn"
                        aria-label="Remove example"
                      >
                        <Icon name="trash" size="sm" />
                      </button>
                      <button
                        type="button"
                        class="icon-btn icon-btn-sm"
                        aria-label="Compact icon action"
                      >
                        <Icon name="plus" size="sm" />
                      </button>
                    </span>
                  </td>
                  <td>
                    <code>icon-btn, icon-btn-sm</code>
                  </td>
                  <td>An icon-only action; always give it an aria-label</td>
                </tr>
                <tr>
                  <td>
                    <span class="ds-inline">
                      <button
                        type="button"
                        class="icon-btn icon-btn-danger"
                        aria-label="Delete reading"
                      >
                        <Icon name="trash" size="sm" />
                      </button>
                      <button
                        type="button"
                        class="icon-btn icon-btn-ghost"
                        aria-label="More actions"
                      >
                        <Icon name="dots" size="sm" />
                      </button>
                    </span>
                  </td>
                  <td>
                    <code>icon-btn-danger, icon-btn-ghost</code>
                  </td>
                  <td>
                    Delete turns red under the pointer; ghost has no border
                    until hovered
                  </td>
                </tr>
                <tr>
                  <td>
                    <button
                      type="button"
                      class="icon-btn"
                      aria-label="Unavailable action"
                      disabled
                    >
                      <Icon name="plus" size="sm" />
                    </button>
                  </td>
                  <td>
                    <code>disabled</code>
                  </td>
                  <td>An action that is not available yet</td>
                </tr>
              </tbody>
            </table>
          </div>
          <h2>States</h2>
          <p>
            On hover a button grows a 4px ring in its own colour instead of
            moving. Hover and focus are also checked with real browser input.
          </p>
          <div class="state-grid">
            {states.map((state) => (
              <div class="state-cell">
                <>
                  <span>{state}</span>
                  <button
                    type="button"
                    class="btn-primary"
                    data-preview-state={state.toLowerCase()}
                    disabled={state === "Disabled"}
                    aria-busy={state === "Loading"}
                  >
                    {state === "Loading" ? "Saving…" : "Save changes"}
                  </button>
                </>
              </div>
            ))}
          </div>
        </section>

        <section
          id="button-group"
          class="ds-topic"
          data-component="button-group"
        >
          <h1 tabindex="-1">Button group</h1>
          <p class="ds-lead">
            Related buttons, links or a menu joined into one control. Name the
            group when its purpose is not clear from the buttons.
          </p>
          <div class="ds-specimen">
            <ButtonGroup label="Payment actions">
              <a class="btn-secondary" href="#button-group">
                Account ledger
              </a>
              <a class="btn-primary" href="#button-group">
                Import bank statement
              </a>
            </ButtonGroup>
          </div>
          <pre class="ds-code"><code>{`<ButtonGroup label="Payment actions">\n  <a class="btn-secondary" href="…">Account ledger</a>\n  <a class="btn-primary" href="…">Import bank statement</a>\n</ButtonGroup>`}</code></pre>
        </section>

        <section id="checkbox" class="ds-topic" data-component="checkbox">
          <h1 tabindex="-1">Checkbox and radio</h1>
          <p class="ds-lead">
            Checkboxes pick any number of options; radios pick exactly one, with
            the usual choice already selected. The label sits beside the box and
            the whole row toggles it.
          </p>
          <h2>Checkbox states</h2>
          <div class="ds-specimen">
            <div class="check-list" role="group" aria-label="Checkbox states">
              <label class="check-row">
                <input type="checkbox" name="specimen-check-off" /> Email the
                invoice
              </label>
              <label class="check-row">
                <input type="checkbox" name="specimen-check-on" checked /> Print
                a paper copy
              </label>
              <label class="check-row">
                <input
                  type="checkbox"
                  name="specimen-check-mixed"
                  data-indeterminate
                />
                Some dwellings selected
              </label>
              <label class="check-row">
                <input
                  type="checkbox"
                  name="specimen-check-disabled"
                  disabled
                />
                Send by post
              </label>
              <label class="check-row">
                <input
                  type="checkbox"
                  name="specimen-check-locked"
                  checked
                  disabled
                />
                Keep a copy in the archive
              </label>
            </div>
          </div>
          <pre class="ds-code"><code>{`<label class="check-row">\n  <input type="checkbox" name="email" /> Email the invoice\n</label>`}</code></pre>
          <h2>Radio group</h2>
          <div class="ds-specimen">
            <fieldset class="check-list">
              <legend class="field-label">Delivery</legend>
              <label class="check-row">
                <input type="radio" name="specimen-delivery" checked /> Email
              </label>
              <label class="check-row">
                <input type="radio" name="specimen-delivery" /> Paper
              </label>
              <label class="check-row">
                <input type="radio" name="specimen-delivery" disabled /> Portal
                only
              </label>
            </fieldset>
          </div>
          <pre class="ds-code"><code>{`<fieldset>\n  <legend class="field-label">Delivery</legend>\n  <label class="check-row">\n    <input type="radio" name="delivery" checked /> Email\n  </label>\n  …\n</fieldset>`}</code></pre>
        </section>

        <section id="disclosure" class="ds-topic" data-component="disclosure">
          <h1 tabindex="-1">Disclosure</h1>
          <p class="ds-lead">
            Native details and summary, for detail that most readers can skip.
          </p>
          <div class="ds-specimen">
            <details class="disclosure">
              <summary>Why is this invoice blocked?</summary>
              <p class="text-body-sm text-muted">
                The billing email is missing. Add it to the dwelling record,
                then prepare the invoice again.
              </p>
            </details>
          </div>
          <pre class="ds-code"><code>{`<details class="disclosure">\n  <summary>Why is this invoice blocked?</summary>\n  <p>…</p>\n</details>`}</code></pre>
        </section>

        <section id="dropdown" class="ds-topic" data-component="dropdown">
          <h1 tabindex="-1">Dropdown</h1>
          <p class="ds-lead">
            A list of actions or choices that opens from a button. It closes on
            a pick, an outside click or Escape. Destructive items come last.
          </p>
          <h2>Dropdown</h2>
          <div class="ds-specimen">
            <details class="dropdown" data-dismiss>
              <summary class="btn-secondary">
                Export
                <Icon name="chevron-right" size="xs" class="dropdown-chevron" />
              </summary>
              <div class="dropdown-panel">
                <a class="dropdown-item" href="#dropdown">
                  <Icon name="download" size="sm" />
                  Invoices as PDF
                </a>
                <a class="dropdown-item" href="#dropdown">
                  <Icon name="download" size="sm" />
                  Ledger as CSV
                </a>
                <hr class="dropdown-divider" />
                <a class="dropdown-item" href="#dropdown">
                  <Icon name="file-description" size="sm" />
                  <span>
                    Bank statement
                    <span class="dropdown-item-note">ISO 20022 camt.053</span>
                  </span>
                </a>
                <button
                  type="button"
                  class="dropdown-item dropdown-item-danger"
                >
                  <Icon name="trash" size="sm" />
                  Clear export history
                </button>
              </div>
            </details>
          </div>
          <pre class="ds-code"><code>{dropdownSnippet}</code></pre>
          <h2>Dropdown menu</h2>
          <p>
            When a dropdown is more than a list: quick actions as tiles, then
            labelled groups of menu items. The organization switcher is one.
          </p>
          <div class="ds-specimen">
            <details class="dropdown" data-dismiss>
              <summary class="btn-primary">
                Period actions
                <Icon name="chevron-right" size="xs" class="dropdown-chevron" />
              </summary>
              <nav class="dropdown-panel" aria-label="Period actions">
                <div class="dropdown-tiles">
                  <a class="dropdown-tile" href="#dropdown">
                    <Icon name="lock" />
                    Lock period
                  </a>
                  <a class="dropdown-tile" href="#dropdown">
                    <Icon name="send" />
                    Send invoices
                  </a>
                </div>
                <p class="menu-label" id="specimen-other-actions">
                  Other actions
                </p>
                <ul class="menu-list" aria-labelledby="specimen-other-actions">
                  <li>
                    <a href="#dropdown">
                      <Icon name="circle-check" size="sm" />
                      Check readings
                    </a>
                  </li>
                  <li>
                    <a href="#dropdown">
                      <Icon name="archive" size="sm" />
                      Archive period
                    </a>
                  </li>
                </ul>
              </nav>
            </details>
          </div>
          <pre class="ds-code"><code>{dropdownMenuSnippet}</code></pre>
        </section>

        <section id="empty-state" class="ds-topic" data-component="empty-state">
          <h1 tabindex="-1">Empty state</h1>
          <p class="ds-lead">
            Shown when a list or page has nothing in it yet. It says what is
            missing and offers the next action.
          </p>
          <div class="ds-specimen">
            <EmptyState
              title="No billing periods yet"
              description="Create the first period to start collecting readings."
              ornament
            >
              <button class="btn-secondary">Create period</button>
            </EmptyState>
          </div>
          <pre class="ds-code"><code>{`<EmptyState title="No billing periods yet" description="…" ornament>\n  <button class="btn-secondary">Create period</button>\n</EmptyState>`}</code></pre>
        </section>

        <section id="form-field" class="ds-topic" data-component="form-field">
          <div class="ds-topic-head">
            <h1 tabindex="-1">Form field</h1>
            <button class="copy-button" type="button" data-copy={emailSnippet}>
              Copy snippet
            </button>
          </div>
          <p class="ds-lead">
            Every control has a visible label. Text fields and selects put it
            above, with an optional hint or error below, linked by{" "}
            <code>aria-describedby</code>. Checkboxes and switches put it
            beside.
          </p>
          <h2>Text, select, checkbox and error</h2>
          <div class="ds-specimen">
            <div class="form-grid">
              <div>
                <label class="field-label" for="specimen-email">
                  Billing email
                </label>
                <input
                  id="specimen-email"
                  name="specimen-email"
                  type="email"
                  autocomplete="email"
                  spellcheck="false"
                  placeholder="name@example.com"
                  aria-describedby="specimen-email-hint"
                  class="mt-1"
                />
                <p id="specimen-email-hint" class="field-hint">
                  Invoices are sent here.
                </p>
              </div>
              <div>
                <label class="field-label" for="specimen-cycle">
                  Billing cycle
                </label>
                <select id="specimen-cycle" name="cycle" class="mt-1">
                  <option>Monthly</option>
                  <option>Quarterly</option>
                </select>
              </div>
              <label class="check-row">
                <input type="checkbox" name="reminders" checked /> Send
                reminders
              </label>
              <div>
                <label class="field-label" for="specimen-reference">
                  Invoice reference
                </label>
                <input
                  id="specimen-reference"
                  class="mt-1"
                  name="reference"
                  aria-invalid="true"
                  aria-describedby="specimen-reference-error"
                  value="PB-"
                />
                <p id="specimen-reference-error" class="field-error">
                  Use a complete invoice reference.
                </p>
              </div>
            </div>
          </div>
          <pre class="ds-code"><code>{emailSnippet}</code></pre>
          <h2>Boxed field</h2>
          <p>
            The label sits inside the frame, over the control, and the frame
            takes the field's state; a hint or error goes under the frame. Mark
            the optional fields; give a field that must not be missed{" "}
            <code>is-required</code> (a red dot by its label) as well as the{" "}
            <code>required</code> attribute.
          </p>
          <div class="ds-specimen">
            <div class="form-grid">
              <div class="field-box">
                <label for="specimen-box-phone">
                  Phone <span class="field-optional">· optional</span>
                </label>
                <input
                  id="specimen-box-phone"
                  name="specimen-box-phone"
                  type="tel"
                  autocomplete="tel"
                  placeholder="+371 2000 0000"
                />
              </div>
              <div class="field-box is-required">
                <label for="specimen-box-owner">Owner's name</label>
                <input
                  id="specimen-box-owner"
                  name="specimen-box-owner"
                  autocomplete="name"
                  required
                />
              </div>
              <div>
                <div class="field-box is-required">
                  <label for="specimen-box-area">Floor area</label>
                  <input
                    id="specimen-box-area"
                    name="specimen-box-area"
                    inputmode="decimal"
                    data-tone="warning"
                    aria-describedby="specimen-box-area-hint"
                    required
                  />
                </div>
                <p id="specimen-box-area-hint" class="field-hint">
                  Needed to split the heating bill.
                </p>
              </div>
              <div>
                <div class="field-box">
                  <label for="specimen-box-iban">IBAN</label>
                  <input
                    id="specimen-box-iban"
                    name="specimen-box-iban"
                    value="LV80 BANK 0000"
                    aria-invalid="true"
                    aria-describedby="specimen-box-iban-error"
                  />
                </div>
                <p id="specimen-box-iban-error" class="field-error">
                  The IBAN is too short.
                </p>
              </div>
            </div>
          </div>
          <pre class="ds-code"><code>{boxedSnippet}</code></pre>
          <h2>Compact form</h2>
          <p>
            Boxed fields that belong together share one frame. Two columns from
            640px; <code>--cols</code> sets more and <code>field-span</code>{" "}
            takes a whole row.
          </p>
          <div class="ds-specimen">
            <div class="field-group" role="group" aria-label="Resident">
              <div class="field-box is-required">
                <label for="specimen-compact-name">Full name</label>
                <input
                  id="specimen-compact-name"
                  name="specimen-compact-name"
                  autocomplete="name"
                  required
                />
              </div>
              <div class="field-box">
                <label for="specimen-compact-flat">Dwelling</label>
                <select id="specimen-compact-flat" name="specimen-compact-flat">
                  <option>12</option>
                  <option>14</option>
                </select>
              </div>
              <div class="field-box field-span">
                <label for="specimen-compact-email">Billing email</label>
                <input
                  id="specimen-compact-email"
                  name="specimen-compact-email"
                  type="email"
                  autocomplete="email"
                  spellcheck="false"
                  value="anna@"
                  aria-invalid="true"
                  aria-describedby="specimen-compact-email-error"
                />
              </div>
              <label class="check-row field-span">
                <input type="checkbox" name="specimen-compact-paper" /> Also
                send a paper copy
              </label>
            </div>
            <p id="specimen-compact-email-error" class="field-error">
              Billing email: add the part after the @.
            </p>
          </div>
          <pre class="ds-code"><code>{compactSnippet}</code></pre>
          <h2>Icons and colour grading</h2>
          <p>
            A leading icon says what goes in; a trailing one shows the state.
            Errors (<code>aria-invalid</code>) and <code>data-tone</code>{" "}
            warning or success tint the border and the fill.
          </p>
          <div class="ds-specimen">
            <div class="form-grid">
              <div>
                <label class="field-label" for="specimen-search">
                  Find a dwelling
                </label>
                <div class="input-icon mt-1">
                  <Icon name="search" size="sm" />
                  <input
                    id="specimen-search"
                    name="specimen-search"
                    type="search"
                    placeholder="Number or owner"
                  />
                </div>
              </div>
              <div>
                <label class="field-label" for="specimen-reading">
                  Meter reading
                </label>
                <div class="input-icon mt-1">
                  <input
                    id="specimen-reading"
                    name="specimen-reading"
                    inputmode="decimal"
                    value="1 204.5"
                    data-tone="warning"
                    aria-describedby="specimen-reading-note"
                  />
                  <Icon
                    name="alert-triangle"
                    size="sm"
                    class="input-icon-end"
                  />
                </div>
                <p id="specimen-reading-note" class="field-hint">
                  Lower than last month's 1 310.0. Check the meter.
                </p>
              </div>
              <div>
                <label class="field-label" for="specimen-saved">
                  Bank reference
                </label>
                <div class="input-icon mt-1">
                  <input
                    id="specimen-saved"
                    name="specimen-saved"
                    value="RF18 5390 0754 7034"
                    data-tone="success"
                    aria-describedby="specimen-saved-note"
                  />
                  <Icon name="circle-check" size="sm" class="input-icon-end" />
                </div>
                <p id="specimen-saved-note" class="field-hint">
                  Saved.
                </p>
              </div>
            </div>
          </div>
          <pre class="ds-code"><code>{iconFieldSnippet}</code></pre>
          <h2>Switch</h2>
          <div class="ds-specimen">
            <div
              class="component-row toggle-specimen"
              role="group"
              aria-label="Switch states"
            >
              <label class="check-row">
                <span class="toggle-switch">
                  <input
                    type="checkbox"
                    role="switch"
                    name="specimen-switch-off"
                  />
                  <span class="toggle-switch-track" aria-hidden="true">
                    <span class="toggle-switch-thumb"></span>
                  </span>
                </span>
                Automatic reminders
              </label>
              <label class="check-row">
                <span class="toggle-switch">
                  <input
                    type="checkbox"
                    role="switch"
                    name="specimen-switch-on"
                    checked
                  />
                  <span class="toggle-switch-track" aria-hidden="true">
                    <span class="toggle-switch-thumb"></span>
                  </span>
                </span>
                Auto-generate invoices
              </label>
              <label class="check-row">
                <span class="toggle-switch">
                  <input
                    type="checkbox"
                    role="switch"
                    name="specimen-switch-disabled"
                    checked
                    disabled
                  />
                  <span class="toggle-switch-track" aria-hidden="true">
                    <span class="toggle-switch-thumb"></span>
                  </span>
                </span>
                Locked billing option
              </label>
            </div>
          </div>
          <pre class="ds-code"><code>{`<label class="check-row">\n  <span class="toggle-switch">\n    <input type="checkbox" role="switch" name="reminders" />\n    <span class="toggle-switch-track" aria-hidden="true">\n      <span class="toggle-switch-thumb"></span>\n    </span>\n  </span>\n  Automatic reminders\n</label>`}</code></pre>
        </section>

        <section id="kpi-card" class="ds-topic" data-component="kpi-card">
          <h1 tabindex="-1">KPI card</h1>
          <p class="ds-lead">
            One figure with its label and icon. For several related figures, use
            a metric strip.
          </p>
          <div class="ds-specimen kpi-grid">
            <KpiCard
              label="Collected"
              value="€48,920"
              tone="success"
              icon="coins"
            />
            <KpiCard label="Due soon" value="14" tone="warning" icon="clock" />
          </div>
          <pre class="ds-code"><code>{`<KpiCard label="Collected" value="€48,920" tone="success" icon="coins" />`}</code></pre>
        </section>

        <section id="link" class="ds-topic" data-component="link">
          <h1 tabindex="-1">Link</h1>
          <p class="ds-lead">
            For moving somewhere, or an action that is not the main one. Inside
            running text use an underlined link so it does not rely on colour.
          </p>
          <div class="table-wrap">
            <table class="ds-spec">
              <caption class="sr-only">Link variants</caption>
              <thead>
                <tr>
                  <th scope="col">Example</th>
                  <th scope="col">Code</th>
                  <th scope="col">Use</th>
                </tr>
              </thead>
              <tbody>
                {links.map(([className, use]) => (
                  <tr>
                    <td>
                      <a class={className} href="#link">
                        Account ledger
                      </a>
                    </td>
                    <td>
                      <code>{className}</code>
                    </td>
                    <td>{use}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <h2>Block link</h2>
          <p>
            The one link in a card stretches over the whole card, so the card is
            the target. Mark the card <code>has-block-link</code>; it shows the
            focus ring.
          </p>
          <div class="ds-specimen">
            <div class="box has-block-link block-link-specimen">
              <h3 class="text-label">
                <a class="block-link" href="#link">
                  Dwelling 12
                </a>
              </h3>
              <p class="text-body-sm text-muted">3 residents, 64.2 m²</p>
            </div>
          </div>
          <pre class="ds-code"><code>{`<div class="box has-block-link">\n  <h3><a class="block-link" href="…">Dwelling 12</a></h3>\n  <p>3 residents, 64.2 m²</p>\n</div>`}</code></pre>
        </section>

        <section id="menu" class="ds-topic" data-component="menu">
          <h1 tabindex="-1">Menu</h1>
          <p class="ds-lead">
            A list of links for moving around content. The selected item takes a
            stronger wash; section labels stay in sentence case. A tree folds a
            group open under its own item.
          </p>
          <div class="ds-specimen">
            <nav class="menu menu-specimen" aria-label="Settings">
              <ul class="menu-list">
                <li>
                  <a href="#menu">
                    <Icon name="building" size="sm" />
                    Organization
                  </a>
                </li>
                <li>
                  <a href="#menu" aria-current="page">
                    <Icon name="receipt-euro" size="sm" />
                    Invoices
                  </a>
                </li>
              </ul>
              <p class="menu-label">Billing</p>
              <ul class="menu-list">
                <li>
                  <details class="menu-tree" open>
                    <summary>
                      <Icon name="droplet" size="sm" />
                      Meters
                    </summary>
                    <ul class="menu-list">
                      <li>
                        <a href="#menu">Cold water</a>
                      </li>
                      <li>
                        <a href="#menu">Hot water</a>
                      </li>
                      <li>
                        <a href="#menu">Heat</a>
                      </li>
                    </ul>
                  </details>
                </li>
                <li>
                  <a href="#menu">
                    <Icon name="percentage" size="sm" />
                    Tariffs
                  </a>
                </li>
              </ul>
            </nav>
          </div>
          <pre class="ds-code"><code>{menuSnippet}</code></pre>
        </section>

        <section
          id="metric-strip"
          class="ds-topic"
          data-component="metric-strip"
        >
          <h1 tabindex="-1">Metric strip</h1>
          <p class="ds-lead">
            Related figures on one surface, divided by rules. Set the column
            count with <code>--metrics</code>.
          </p>
          <div class="ds-specimen">
            <section
              class="metric-strip"
              style="--metrics: 3"
              aria-label="Metric strip example"
            >
              <div class="metric">
                <span class="metric-label">Total to pay</span>
                <strong class="metric-value">4 218.40 €</strong>
                <span class="metric-note">Current charges: 3 902.10 €</span>
              </div>
              <div class="metric" data-tone="success">
                <span class="metric-label">Received</span>
                <strong class="metric-value">3 110.00 €</strong>
                <span class="metric-note">of total to pay</span>
              </div>
              <div class="metric" data-tone="warning">
                <span class="metric-label">Still unpaid</span>
                <strong class="metric-value">1 108.40 €</strong>
                <span class="metric-note">of total to pay</span>
              </div>
            </section>
          </div>
          <pre class="ds-code"><code>{`<section class="metric-strip" style="--metrics: 3">\n  <div class="metric" data-tone="success">\n    <span class="metric-label">Received</span>\n    <strong class="metric-value">3 110.00 €</strong>\n    <span class="metric-note">of total to pay</span>\n  </div>\n  …\n</section>`}</code></pre>
        </section>

        <section id="modal" class="ds-topic" data-component="modal">
          <h1 tabindex="-1">Modal</h1>
          <p class="ds-lead">
            A dialog that stops the page until it is answered, so use it
            sparingly. Open it with <code>showModal()</code>; Escape and the
            close button end it.
          </p>
          <h2>Modal card</h2>
          <p>
            For a form or a longer read: a head with the title and close, a body
            that scrolls, and the actions at the foot.
          </p>
          <div class="ds-specimen ds-inline">
            <button
              type="button"
              class="btn-secondary"
              data-open-dialog="specimen-modal-card"
            >
              Open modal card
            </button>
            <button
              type="button"
              class="btn-secondary"
              data-open-dialog="specimen-modal-centered"
            >
              Open centered card
            </button>
          </div>
          <dialog
            id="specimen-modal-card"
            class="modal-card"
            aria-labelledby="specimen-modal-card-title"
          >
            <header class="modal-card-head">
              <Icon name="calendar-month" />
              <h2 id="specimen-modal-card-title">New billing period</h2>
              <form method="dialog">
                <button class="icon-btn icon-btn-ghost" aria-label="Close">
                  <Icon name="x" size="sm" />
                </button>
              </form>
            </header>
            <div class="modal-card-body">
              <p>
                The period starts on the first day of the month after the last
                one. Readings and charges carry over from September.
              </p>
            </div>
            <form method="dialog" class="modal-card-foot">
              <button class="btn-primary">Create period</button>
              <button class="btn-ghost">Cancel</button>
            </form>
          </dialog>
          <dialog
            id="specimen-modal-centered"
            class="modal-card modal-card-centered"
            aria-labelledby="specimen-modal-centered-title"
          >
            <form method="dialog">
              <button class="icon-btn icon-btn-ghost" aria-label="Close">
                <Icon name="x" size="sm" />
              </button>
            </form>
            <div class="modal-card-body">
              <Icon name="send" size="lg" />
              <h2 id="specimen-modal-centered-title" class="font-display">
                Send 48 invoices?
              </h2>
              <p>
                Residents with an email address get theirs now. The rest are
                ready to print.
              </p>
            </div>
            <form method="dialog" class="modal-card-foot">
              <button class="btn-primary">Send invoices</button>
              <button class="btn-ghost">Not now</button>
            </form>
          </dialog>
          <pre class="ds-code"><code>{modalCardSnippet}</code></pre>
          <h2>Full-screen modal</h2>
          <p>
            One message over the whole screen, with the page blurred out behind
            it: for a moment that deserves the full stop, such as finishing set
            up.
          </p>
          <div class="ds-specimen">
            <button
              type="button"
              class="btn-secondary"
              data-open-dialog="specimen-modal-full"
            >
              Open full-screen modal
            </button>
          </div>
          <dialog
            id="specimen-modal-full"
            class="modal-full"
            aria-labelledby="specimen-modal-full-title"
          >
            <form method="dialog">
              <button class="icon-btn icon-btn-ghost" aria-label="Close">
                <Icon name="x" size="sm" />
              </button>
            </form>
            <div class="modal-full-body">
              <h2
                id="specimen-modal-full-title"
                class="font-display text-display-lg"
              >
                Your building is set up
              </h2>
              <p>
                Dwellings, meters and tariffs are in place. The first billing
                period opens on 1 October.
              </p>
              <form method="dialog">
                <button class="btn-primary">Go to the dashboard</button>
              </form>
            </div>
          </dialog>
          <pre class="ds-code"><code>{modalFullSnippet}</code></pre>
          <h2>Confirmation</h2>
          <p>
            A form or its submit button with <code>data-confirm</code> asks in a
            modal card before it submits. The first sentence is the title; the
            confirm button repeats the button's own label and is a danger button
            when the action removes something.
          </p>
          <div class="ds-specimen">
            <form method="dialog" class="confirm-specimen">
              <button
                class="btn-danger"
                data-confirm="Remove anna.berzina@example.lv? They lose access to the dwelling's invoices and messages."
              >
                Remove resident
              </button>
            </form>
          </div>
          <pre class="ds-code"><code>{`<button
  class="btn-danger"
  data-confirm="Remove anna.berzina@example.lv? They lose access to …"
>
  Remove resident
</button>`}</code></pre>
        </section>

        <section id="notice" class="ds-topic" data-component="notice">
          <h1 tabindex="-1">Notice</h1>
          <p class="ds-lead">
            A message about the page or a recent action. The class sets the
            tone; the text says what happened and what to do.
          </p>
          <div class="table-wrap">
            <table class="ds-spec">
              <caption class="sr-only">Notice variants</caption>
              <thead>
                <tr>
                  <th scope="col">Example</th>
                  <th scope="col">Code</th>
                  <th scope="col">Use</th>
                </tr>
              </thead>
              <tbody>
                {notices.map(([className, text, use]) => (
                  <tr>
                    <td>
                      <p class={className}>{text}</p>
                    </td>
                    <td>
                      <code>{className}</code>
                    </td>
                    <td>{use}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section
          id="organization-switcher"
          class="ds-topic"
          data-component="organization-switcher"
        >
          <h1 tabindex="-1">Organization switcher</h1>
          <p class="ds-lead">
            A dropdown menu that stays usable inside a narrow scrolling sidebar:
            quick actions as tiles, then the organizations.
          </p>
          <div class="ds-specimen organization-specimen">
            <OrganizationSwitcher
              organizationId="example-1"
              organizationName="Brīvības ielas namu biedrība"
              organizations={[
                {
                  id: "example-1",
                  name: "Brīvības ielas namu biedrība",
                  archivedAt: null,
                },
                {
                  id: "example-2",
                  name: "Товарищество собственников жилого дома",
                  archivedAt: null,
                },
              ]}
              residentAccess={true}
            />
          </div>
          <pre class="ds-code"><code>{`<OrganizationSwitcher\n  organizationId={organizationId}\n  organizationName={organizationName}\n  organizations={organizations}\n  residentAccess\n/>`}</code></pre>
        </section>

        <section id="page-header" class="ds-topic" data-component="page-header">
          <h1 tabindex="-1">Page header</h1>
          <p class="ds-lead">
            The page title, an optional period or context line, a description
            and the page's main actions.
          </p>
          <div class="ds-specimen">
            <PageHeader
              headingLevel="h2"
              accent
              title="Billing periods"
              description="Prepare, issue, and reconcile monthly invoices."
              eyebrow="September 2026"
            >
              <button class="btn-primary">
                <Icon name="plus" size="sm" />
                New period
              </button>
            </PageHeader>
          </div>
          <pre class="ds-code"><code>{`<PageHeader title="Billing periods" description="…" eyebrow="September 2026" accent>\n  <button class="btn-primary">New period</button>\n</PageHeader>`}</code></pre>
        </section>

        <section id="row-menu" class="ds-topic" data-component="row-menu">
          <h1 tabindex="-1">Row menu</h1>
          <p class="ds-lead">
            Actions for one row in a floating menu at the row's end. Destructive
            items come last and use <code>menu-danger</code>.
          </p>
          <div class="ds-specimen component-row">
            <span>Dwelling 12</span>
            <details class="row-menu ml-auto">
              <summary aria-label="More actions: Dwelling 12">
                <Icon name="dots" size="sm" />
              </summary>
              <div>
                <button type="button">Edit</button>
                <button type="button" class="menu-danger">
                  Archive
                </button>
              </div>
            </details>
          </div>
          <pre class="ds-code"><code>{`<details class="row-menu">\n  <summary aria-label="More actions: Dwelling 12">…</summary>\n  <div>\n    <button type="button">Edit</button>\n    <button type="button" class="menu-danger">Archive</button>\n  </div>\n</details>`}</code></pre>
        </section>

        <section
          id="status-badge"
          class="ds-topic"
          data-component="status-badge"
        >
          <div class="ds-topic-head">
            <h1 tabindex="-1">Status badge</h1>
            <button
              class="copy-button"
              type="button"
              data-copy={`<StatusBadge status="PAID" />`}
            >
              Copy snippet
            </button>
          </div>
          <p class="ds-lead">
            The status of a record, shown by icon and text, never by color
            alone.
          </p>
          <div class="table-wrap">
            <table class="ds-spec">
              <caption class="sr-only">Status badges</caption>
              <thead>
                <tr>
                  <th scope="col">Example</th>
                  <th scope="col">Code</th>
                  <th scope="col">Meaning</th>
                </tr>
              </thead>
              <tbody>
                {statuses.map(([status, meaning]) => (
                  <tr>
                    <td>
                      <StatusBadge status={status} />
                    </td>
                    <td>
                      <code>status="{status}"</code>
                    </td>
                    <td>{meaning}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section id="table" class="ds-topic" data-component="table">
          <h1 tabindex="-1">Table</h1>
          <p class="ds-lead">
            Column headers are small capitals. Below 640px each row of a{" "}
            <code>stack-table</code> becomes a card labelled with its column
            headers. The layout script copies each header into its cells as{" "}
            <code>data-label</code>.
          </p>
          <!-- Product table styles are scoped to .app-content. -->
          <div class="app-content">
            <div class="table-wrap stack-table">
              <table class="w-full text-left text-body-sm">
                <caption class="sr-only">Stack table example</caption>
                <thead>
                  <tr>
                    <th scope="col">Dwelling</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-right">
                      Amount
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>12</td>
                    <td>
                      <StatusBadge status="SENT" />
                    </td>
                    <td class="text-right tabular-nums">84.20 €</td>
                  </tr>
                  <tr>
                    <td>14</td>
                    <td>
                      <StatusBadge status="OVERDUE" />
                    </td>
                    <td class="text-right tabular-nums">112.75 €</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
          <pre class="ds-code"><code>{`<div class="table-wrap stack-table">\n  <table>\n    <thead>…</thead>\n    <tbody>…</tbody>\n  </table>\n</div>`}</code></pre>
        </section>

        <section id="tabs" class="ds-topic" data-component="tabs">
          <h1 tabindex="-1">Tabs</h1>
          <p class="ds-lead">
            Views of the same thing, side by side. Tabs are links to those
            views; toggle tabs switch a state in place.
          </p>
          <h2>Tabs</h2>
          <div class="ds-specimen">
            <nav class="tabs" aria-label="Readings">
              <a href="#tabs" aria-current="page">
                All
              </a>
              <a href="#tabs">Missing</a>
              <a href="#tabs">Estimated</a>
              <a href="#tabs">Confirmed</a>
            </nav>
          </div>
          <pre class="ds-code"><code>{`<nav class="tabs" aria-label="Readings">\n  <a href="…" aria-current="page">All</a>\n  <a href="…">Missing</a>\n</nav>`}</code></pre>
