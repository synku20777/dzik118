---
import "../styles/global.css";
import tokenSource from "../styles/global.css?raw";
import { ICONS, type IconName } from "../lib/ui/icons";
import AppNavigation from "../components/ui/AppNavigation.astro";
import ButtonGroup from "../components/ui/ButtonGroup.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import Icon from "../components/ui/Icon.astro";
import KpiCard from "../components/ui/KpiCard.astro";
import LanguageSwitch from "../components/ui/LanguageSwitch.astro";
import Ornament from "../components/ui/Ornament.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import BrandMark from "../components/ui/BrandMark.astro";
import StatusBadge from "../components/ui/StatusBadge.astro";
import ThemeToggle from "../components/ui/ThemeToggle.astro";
import Tooltips from "../components/ui/Tooltips.astro";
import OrganizationSwitcher from "../components/ui/OrganizationSwitcher.astro";

Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");

// Build-time inventories come from the repository, not a hand-maintained total.
const routes = Object.keys(import.meta.glob("./**/*.astro"))
  .map((path) => path.replace(/^\.\//, "/").replace(/(?:\/index)?\.astro$/, ""))
  .map((path) => path || "/")
  .sort();
const components = Object.keys(import.meta.glob("../components/ui/*.astro"))
  .map((path) => path.split("/").pop()!.replace(".astro", ""))
  .sort();

// Sidebar: foundations, then components in alphabetical order. Each entry is
// one topic; the URL fragment picks which topic is shown.
const nav = [
  [
    "Foundation",
    [
      ["color", "Color"],
      ["typography", "Typography"],
      ["iconography", "Iconography"],
      ["layout", "Layout"],
      ["radius", "Radius"],
      ["elevation", "Elevation"],
      ["motion", "Motion & stacking"],
    ],
  ],
  [
    "Components",
    [
      ["avatar", "Avatar"],
      ["box", "Box"],
      ["button", "Button"],
      ["button-group", "Button group"],
      ["checkbox", "Checkbox and radio"],
      ["disclosure", "Disclosure"],
      ["dropdown", "Dropdown"],
      ["empty-state", "Empty state"],
      ["form-field", "Form field"],
      ["kpi-card", "KPI card"],
      ["link", "Link"],
      ["menu", "Menu"],
      ["metric-strip", "Metric strip"],
      ["modal", "Modal"],
      ["notice", "Notice"],
      ["organization-switcher", "Organization switcher"],
      ["page-header", "Page header"],
      ["row-menu", "Row menu"],
      ["status-badge", "Status badge"],
      ["table", "Table"],
      ["tabs", "Tabs"],
      ["tooltip", "Tooltip"],
    ],
  ],
  ["Reference", [["audit", "Audit"]]],
] as const;

const colors = [
  ["Canvas", "--color-canvas"],
  ["Surface", "--color-surface"],
  ["Surface hover", "--color-surface-hover"],
  ["Surface raised", "--color-surface-raised"],
  ["Foreground", "--color-foreground"],
  ["Muted", "--color-muted"],
  ["Border", "--color-border"],
  ["Input border", "--color-input-border"],
  ["Primary", "--color-primary"],
  ["Primary hover", "--color-primary-hover"],
  ["On primary", "--color-on-primary"],
  ["Secondary", "--color-secondary"],
  ["Success", "--color-success"],
  ["Warning", "--color-warning"],
  ["Destructive", "--color-destructive"],
  ["Positive secondary", "--color-positive-secondary"],
  ["Info", "--color-info"],
  ["Chart 1", "--chart-1"],
  ["Chart 2", "--chart-2"],
  ["Chart 3", "--chart-3"],
  ["Chart 4", "--chart-4"],
  ["Chart 5", "--chart-5"],
  ["Chart 6", "--chart-6"],
] as const;
const tones = [
  ["neutral", "Drafts, inactive and default states"],
  ["info", "Sent, in progress, information"],
  ["success", "Paid, complete"],
  ["warning", "Needs attention, missing data"],
  ["danger", "Overdue, failed, destructive"],
  ["positive", "A second positive meaning, such as meter categories"],
