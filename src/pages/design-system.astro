    <script is:inline>
      // One topic at a time, like a page per topic: the URL fragment picks it.
      // Inline so the other topics hide before first paint. Without script
      // every topic stays visible.
      (() => {
        const topics = [...document.querySelectorAll(".ds-main > .ds-topic")];
        const links = [...document.querySelectorAll(".ds-nav nav a")];
        const menu = document.querySelector(".ds-nav");
        const wide = matchMedia("(width >= 70rem)");
        // Fragments of the earlier single-page layout.
        const aliases = {
          colors: "color",
          geometry: "layout",
          components: "button",
        };
        const baseTitle = document.title;
        const show = (moved) => {
          let id = location.hash.slice(1);
          try {
            id = decodeURIComponent(id);
          } catch {
            /* A malformed fragment is looked up as written. */
          }
          const normalized = id.startsWith("building-view/")
            ? "building-view"
            : id.startsWith("resident-portal/")
              ? "resident-portal"
              : (aliases[id] ?? id);
          const target = normalized
            ? document.getElementById(normalized)
            : null;
          const topic = target?.closest(".ds-topic");
          // A jump to a target outside every topic (the skip link's
          // #main-content) keeps the open topic. On load, or for an unknown
          // fragment, show Overview.
          if (moved && target && !topic) return;
          const shown = topic ?? topics[0];
          for (const section of topics) {
            const leaving = !section.hidden && section !== shown;
            section.hidden = section !== shown;
            if (leaving) {
              document.querySelector("#confirm-dialog[open]")?.close("cancel");
              section.querySelector("dialog.lock-dialog[open]")?.close();
              section
                .querySelectorAll(
                  ":is(.row-menu, .more-menu, .mutation-activity)[data-dismiss][open]"
                )
                .forEach((details) => details.removeAttribute("open"));
            }
          }
          for (const link of links) {
            if (link.hash === `#${shown.id}`)
              link.setAttribute("aria-current", "page");
            else link.removeAttribute("aria-current");
          }
          const heading = shown.querySelector("h1");
          document.title =
            shown === topics[0]
              ? baseTitle
              : `${heading.textContent.trim()} – ${baseTitle}`;
          if (!moved) return;
          if (target && target !== shown) {
            target.scrollIntoView();
            if (target.matches("[tabindex='-1']")) {
              target.focus({ preventScroll: true });
            }
          } else {
            window.scrollTo(0, 0);
            heading.focus({ preventScroll: true });
          }
        };
        const syncMenu = () => {
          menu.open = wide.matches;
        };
        syncMenu();
        wide.addEventListener("change", syncMenu);
        const closeMenu = () => {
          if (!wide.matches) menu.open = false;
        };
        // A link to the open fragment changes no hash, so clicks close it too.
        document.addEventListener("click", (event) => {
          if (event.target.closest('a[href^="#"]')) closeMenu();
        });
        show(false);
        addEventListener("hashchange", () => {
          closeMenu();
          show(true);
        });
      })();
    </script>

    <div id="copy-status" class="sr-only" aria-live="polite"></div>
    <script>
      import { initTheme } from "../lib/ui/theme";
      import { labelStackTables } from "../lib/ui/stack-tables";
      import { installDismissableDetails } from "../lib/ui/dismissable-details";
      import { initCollectionLedgers } from "../lib/ui/collection-ledger";
      import { getPopoverInvoker, initCaseMenus } from "../lib/ui/case-menu";
      import { updateWorkbenchToolbarSpace } from "../lib/ui/workbench-selection";
      import { initCopyButtons } from "../lib/ui/copy-field";
      import { bindResidentSpecimen } from "../lib/ui/resident-specimen";
      import { confirmAction } from "../lib/ui/forms";
      initTheme();
      labelStackTables();
      installDismissableDetails();
      initCollectionLedgers();
      initCaseMenus();
      initCopyButtons();
      const residentSpecimen = document.querySelector<HTMLElement>(
        "[data-resident-specimen]"
      );
      if (residentSpecimen) bindResidentSpecimen(residentSpecimen);

      const tariffStatus = document.querySelector("#specimen-tariff-status")!;
      const tariffToggle = document.querySelector<HTMLButtonElement>(
        "[data-specimen-tariff-toggle]"
      )!;
      const tariffArchive = document.querySelector<HTMLButtonElement>(
        "[data-specimen-tariff-archive]"
      )!;
      const closeTariffMenu = () => {
        const menu = tariffToggle.closest("details")!;
        menu.open = false;
        menu.querySelector("summary")?.focus();
      };
      let tariffActive = true;
      tariffToggle.addEventListener("click", () => {
        tariffActive = !tariffActive;
        tariffStatus.textContent = tariffActive ? "Active" : "Off";
        tariffToggle.textContent = tariffActive ? "Turn off" : "Turn on";
        closeTariffMenu();
      });
      tariffArchive.addEventListener("click", async () => {
        const restoring = tariffToggle.hidden === true;
        closeTariffMenu();
        if (
          !restoring &&
          !(await confirmAction(
            "Archive Cold water? The sample tariff stops applying to new billing periods.",
            tariffArchive
          ))
        )
          return;
        tariffToggle.hidden = !restoring;
        tariffArchive.classList.toggle("menu-danger", restoring);
        tariffArchive.textContent = restoring ? "Archive" : "Restore";
        const activeStatus = tariffActive ? "Active" : "Off";
        tariffStatus.textContent = restoring ? activeStatus : "Archived";
      });
      document
        .querySelector("[data-specimen-menu-link]")
        ?.addEventListener("click", (event) => {
          const menu = (event.currentTarget as Element).closest("details");
          if (menu) menu.open = false;
        });
      for (const [id, statusId, text] of [
        [
          "specimen-lock-period",
          "specimen-lock-status",
          "Sample period locked",
        ],
        [
          "specimen-archive-dwelling",
          "specimen-archive-status",
          "· Archived (sample)",
        ],
      ]) {
        const dialog = document.querySelector<HTMLDialogElement>(`#${id}`)!;
        dialog.addEventListener("close", () => {
          if (dialog.returnValue === "confirm")
            document.getElementById(statusId)!.textContent = text;
        });
      }

      // Interactive table, tabs, notice undo, and resident portal specimen controls.
      let flashTimer: number | undefined;
      document
        .querySelector<HTMLButtonElement>("[data-flash-row-trigger]")
        ?.addEventListener("click", () => {
          const row = document.querySelector<HTMLElement>(
            "#specimen-flash-row"
          );
          if (!row) return;
          const cls = matchMedia("(prefers-reduced-motion: reduce)").matches
            ? "row-changed-still"
            : "row-changed";
          row.classList.remove("row-changed", "row-changed-still");
          void row.offsetWidth;
          row.classList.add(cls);
          window.clearTimeout(flashTimer);
          flashTimer = window.setTimeout(() => row.classList.remove(cls), 1500);
        });

      for (const nav of document.querySelectorAll<HTMLElement>(
        "[data-specimen-tabs]"
      )) {
        nav.addEventListener("click", (event) => {
          const link = (event.target as Element | null)?.closest("a");
          if (!link || !nav.contains(link)) return;
          event.preventDefault();
          for (const sibling of nav.querySelectorAll("a")) {
            if (sibling === link) sibling.setAttribute("aria-current", "page");
            else sibling.removeAttribute("aria-current");
          }
        });
      }

      for (const group of document.querySelectorAll<HTMLElement>(
        "[data-specimen-view-switch]"
      )) {
        group.addEventListener("change", (event) => {
          const input = event.target;
          if (!(input instanceof HTMLInputElement)) return;
          const scope = group.parentElement;
          for (const panel of scope?.querySelectorAll<HTMLElement>(
            "[data-view-panel]"
          ) ?? []) {
            panel.hidden = panel.dataset.viewPanel !== input.value;
          }
        });
      }

      const focusCaseMenuOpener = (menu: HTMLElement | null) => {
        if (!menu) return;
        queueMicrotask(() => {
          if (!menu.matches(":popover-open")) getPopoverInvoker(menu)?.focus();
        });
      };
      for (const item of document.querySelectorAll<HTMLElement>(
        ".case-menu [data-close-popover], .case-menu [popovertargetaction='hide']"
      )) {
        item.addEventListener("click", (event) => {
          const menu = item.closest<HTMLElement>(".case-menu");
          if (item.hasAttribute("data-close-popover")) {
            event.preventDefault();
            menu?.hidePopover?.();
          }
          focusCaseMenuOpener(menu);
        });
      }

      document
        .querySelector<HTMLButtonElement>("[data-specimen-undo]")
        ?.addEventListener("click", (event) => {
          const btn = event.currentTarget as HTMLButtonElement;
          const textEl = document.querySelector<HTMLElement>(
            "[data-specimen-undo-text]"
          );
          const statusEl = document.querySelector<HTMLElement>(
            "[data-specimen-undo-status]"
          );
          const message = btn.dataset.onText ?? "Cold water tariff restored.";
          if (textEl) textEl.textContent = message;
          if (statusEl) statusEl.textContent = message;
          textEl?.focus();
          btn.hidden = true;
        });

      const bulkToolbar = document.querySelector<HTMLElement>(
        "#specimen-bulk-toolbar"
      );
      const selectedCountEl = document.querySelector<HTMLElement>(
        "#specimen-selected-count"
      );
      const selectionStatusEl = document.querySelector<HTMLElement>(
        "#specimen-selection-status"
      );
      const tableTopic = document.querySelector<HTMLElement>("#table");
      const selectCheckboxes = [
        ...document.querySelectorAll<HTMLInputElement>(
          "[data-specimen-select]"
        ),
      ];
      let lastCheckedBox: HTMLInputElement | null = null;
      const measureSpecimenToolbar = () => {
        if (tableTopic) updateWorkbenchToolbarSpace(tableTopic, bulkToolbar);
      };
      const syncBulkSpecimen = (announce = false) => {
        let count = 0;
        for (const cb of selectCheckboxes) {
          const row = cb.closest("tr");
          if (cb.checked) {
            row?.setAttribute("data-selected", "");
            count++;
          } else {
            row?.removeAttribute("data-selected");
          }
        }
        if (selectedCountEl) selectedCountEl.textContent = String(count);
        if (bulkToolbar) bulkToolbar.hidden = count === 0;
        if (announce && selectionStatusEl) {
          selectionStatusEl.textContent =
            count > 0 ? `${count} selected` : "Selection cleared";
        }
        measureSpecimenToolbar();
      };
      for (const cb of selectCheckboxes) {
        cb.addEventListener("change", () => {
          if (cb.checked) lastCheckedBox = cb;
          syncBulkSpecimen(true);
        });
      }
      document
        .querySelector<HTMLButtonElement>("#specimen-clear-selection")
        ?.addEventListener("click", () => {
          for (const cb of selectCheckboxes) cb.checked = false;
          syncBulkSpecimen(true);
          (lastCheckedBox ?? selectCheckboxes[0])?.focus();
        });
      window.addEventListener("resize", measureSpecimenToolbar);
      window.addEventListener("hashchange", measureSpecimenToolbar);

      // Specimens: open the example dialogs, and show the mixed checkbox state
      // (indeterminate has no HTML attribute).
      for (const button of document.querySelectorAll<HTMLButtonElement>(
        "[data-open-dialog]"
      )) {
        button.addEventListener("click", () =>
          document
            .querySelector<HTMLDialogElement>(`#${button.dataset.openDialog}`)
            ?.showModal()
        );
      }
      for (const box of document.querySelectorAll<HTMLInputElement>(
        "[data-indeterminate]"
      )) {
        box.indeterminate = true;
      }
      document.addEventListener("astro:page-load", initTheme);

      function updateTokenReadout() {
        const rootStyle = getComputedStyle(document.documentElement);
        document
          .querySelectorAll<HTMLElement>("[data-token-value]")
          .forEach((el) => {
            el.textContent =
              rootStyle.getPropertyValue(el.dataset.tokenValue!).trim() ||
              "Not emitted in this build";
          });
        const probe = document.createElement("span");
        probe.hidden = true;
        document.body.appendChild(probe);
        const resolve = (token: string) => {
          probe.style.backgroundColor = `var(${token})`;
          return getComputedStyle(probe).backgroundColor;
        };
        const luminance = (color: string) => {
          const channels = color
            .match(/[\d.]+/g)!
            .slice(0, 3)
            .map(Number)
            .map((n) => {
              const v = n / 255;
              return v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4;
            });
          return (
            channels[0] * 0.2126 + channels[1] * 0.7152 + channels[2] * 0.0722
          );
        };
        const ratio = (a: string, b: string) => {
          const values = [luminance(a), luminance(b)];
          return (
            (Math.max(...values) + 0.05) /
            (Math.min(...values) + 0.05)
          ).toFixed(2);
        };
        const canvas = resolve("--color-canvas");
        const surface = resolve("--color-surface");
        document
          .querySelectorAll<HTMLElement>("[data-color-value]")
          .forEach((el) => {
            const token = el.dataset.colorValue!;
            const value = resolve(token);
            el.textContent = value;
            const swatch = el.closest(".swatch")!;
            swatch.querySelector("[data-contrast-canvas]")!.textContent =
              `C ${ratio(value, canvas)}:1`;
            swatch.querySelector("[data-contrast-surface]")!.textContent =
              `S ${ratio(value, surface)}:1`;
          });
        probe.remove();
      }
      updateTokenReadout();
      new MutationObserver(updateTokenReadout).observe(
        document.documentElement,
        {
          attributes: true,
          attributeFilter: ["data-theme"],
        }
      );
      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", updateTokenReadout);

      document
        .querySelectorAll<HTMLButtonElement>("[data-copy]")
        .forEach((button) => {
          button.addEventListener("click", async () => {
            const status = document.querySelector<HTMLElement>("#copy-status")!;
            try {
              await navigator.clipboard.writeText(button.dataset.copy!);
              status.textContent = "Snippet copied";
            } catch {
              status.textContent =
                "Clipboard unavailable. Copy the example from the page.";
            }
          });
        });
    </script>
    <Tooltips />
  </body>
</html>

