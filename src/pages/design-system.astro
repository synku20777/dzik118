  ["--duration-fast", "140ms", "Hover and color changes"],
  ["--duration-normal", "180ms", "Small moves"],
  ["--duration-panel", "220ms", "Panels and dialogs"],
  [
    "--ease-standard",
    "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "Every transition; no overshoot",
  ],
