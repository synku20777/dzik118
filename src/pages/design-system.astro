const states = [
  "Default",
  "Hover",
  "Active",
  "Focus-visible",
  "Disabled",
  "Loading",
];
const statuses = [
  ["MISSING_DATA", "Readings or details are missing"],
  ["DRAFT", "Prepared, not sent yet"],
  ["SENT", "Sent to the resident"],
  ["PAID", "Paid in full"],
  ["OVERDUE", "Past the due date"],
] as const;
const notices = [
  ["notice", "Invoices are ready for review.", "Information"],
  ["notice notice-success", "Payments imported.", "A completed action"],
  [
    "notice notice-warning",
    "3 readings still need attention.",
    "Something to resolve before continuing",
  ],
  [
    "notice notice-danger",
    "Payment import failed. Check the CSV columns.",
