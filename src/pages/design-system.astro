        </ul>
      </details>
    </li>
  </ul>
</nav>`;
const modalCardSnippet = `<dialog id="new-period" class="modal-card" aria-labelledby="new-period-title">
  <header class="modal-card-head">
    <Icon name="calendar-month" />
