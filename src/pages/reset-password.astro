---
import AuthLayout from "../layouts/AuthLayout.astro";
import Ornament from "../components/ui/Ornament.astro";
import { PASSWORD_MIN_LENGTH } from "../lib/auth/password";
import { hasFreshOtpSession } from "../lib/auth/otp-session";
import { createSupabaseServerClient } from "../lib/supabase/server";
import { translate, uiLocale } from "../lib/ui/i18n";
const locale = uiLocale(Astro.cookies, Astro.url);
const t = (text: string) => translate(locale, text);

// Only reachable in the session created by a verified reset link.
const { supabase } = createSupabaseServerClient(Astro.request, Astro.cookies);
if (
  Astro.locals.auth?.role !== "ADMIN" ||
  !(await hasFreshOtpSession(supabase))
) {
  return Astro.redirect("/forgot-password");
}

const error = Astro.url.searchParams.get("error");
const messages: Record<string, string> = {
  short: t("The password must be at least 8 characters."),
  long: t("The password is too long."),
  mismatch: t("The two passwords do not match."),
  failed: t("The password could not be changed. Try a different password."),
};
---

<AuthLayout title={t("Choose a new password") + " - " + t("Property Billing")}>
  <div class="w-full max-w-md space-y-6">
    <div class="space-y-3 text-center">
      <p class="font-display text-2xl font-semibold">{t("Property Billing")}</p>
      <Ornament />
    </div>
    <div class="rounded-panel border border-border bg-surface p-8">
      <h1 class="text-xl font-bold text-foreground">
        {t("Choose a new password")}
      </h1>
      <p class="mt-1 text-sm text-muted">
        {t("Use at least 8 characters.")}
      </p>
      {
        error && messages[error] && (
          <p
            class="mt-4 rounded-control bg-danger-surface p-3 text-sm text-destructive"
            role="alert"
          >
            {messages[error]}
          </p>
        )
      }
      <form
        method="POST"
        action="/api/v1/auth/set-password"
        class="mt-4 space-y-3"
      >
        <div>
          <label
            class="block text-sm font-medium text-foreground"
            for="new-password">{t("New password")}</label
          >
          <input
            id="new-password"
            name="password"
            type="password"
            required
            minlength={PASSWORD_MIN_LENGTH}
            autocomplete="new-password"
            class="mt-1 w-full rounded-control border border-border px-3 py-2 text-sm"
          />
        </div>
        <div>
          <label
            class="block text-sm font-medium text-foreground"
            for="confirm-password">{t("Repeat new password")}</label
          >
          <input
            id="confirm-password"
            name="confirm"
            type="password"
            required
            minlength={PASSWORD_MIN_LENGTH}
            autocomplete="new-password"
            class="mt-1 w-full rounded-control border border-border px-3 py-2 text-sm"
          />
        </div>
        <button type="submit" class="btn-primary w-full">
          {t("Change password")}
        </button>
      </form>
    </div>
  </div>
</AuthLayout>
